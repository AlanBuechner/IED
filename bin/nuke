#!/bin/sh
# Nuke launcher for POSIX shells (Git Bash, MSYS). Put this folder on PATH (nuke install-ied puts the install's there)
# to run `nuke` anywhere.
root="$(cd "$(dirname "$0")/.." && pwd)"
py="$root/vendor/python/python.exe"
[ -x "$py" ] || py="$(command -v python3 || command -v python)"
[ -n "$py" ] || { echo "nuke: no Python found; run setup.bat in $root" >&2; exit 1; }
exec "$py" "$root/Nuke/nuke" "$@"
