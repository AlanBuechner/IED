include "rewrite.ch"
include "web/json.ch"
include "web/params.ch"

namespace Ied
{
	static bool IsInt(const Serialization::DomNode& node) { return node.Kind() == Serialization::DomKind::Int; }

	static bool IsPosition(const Serialization::DomNode& node) { return IsInt(node.Member("line")) && IsInt(node.Member("character")); }

	static bool IsFoldingRange(const Serialization::DomNode& node) {
		return IsInt(node.Member("startLine")) && (IsInt(node.Member("startCharacter")) || IsInt(node.Member("endCharacter")));
	}

	static bool IsUriKey(Core::StringView key) { return key == "uri" || key == "targetUri" || key == "target"; }

	// The document a member of `node` belongs to: its own URI if it names one, else the one around it.
	static Core::StringView DocumentOf(const Serialization::DomNode& node, Core::StringView around) {
		if (node.Member("uri").Kind() == Serialization::DomKind::String) return node.Member("uri").AsView();
		if (node.Member("targetUri").Kind() == Serialization::DomKind::String) return node.Member("targetUri").AsView();
		Serialization::DomNode document = node.Member("textDocument");
		if (document.Member("uri").Kind() == Serialization::DomKind::String) return document.Member("uri").AsView();
		return around;
	}

	class RewriteWalk
	{
		[operator("create")] public void Init(const Rewrite& rewrite) { this.rewrite = rewrite; }

		public void Value(const Serialization::DomNode& node, Core::StringView uri, JsonWriter& out) {
			if (node.Kind() == Serialization::DomKind::Object) Object(node, uri, out);
			else if (node.Kind() == Serialization::DomKind::Array) {
				out.BeginArray();
				for (int64 i = 0; i < node.Count(); ++i) Value(node.At(i), uri, out);
				out.EndArray();
			}
			else out.Raw(NodeJson(node).View());
		}

		private void Object(const Serialization::DomNode& node, Core::StringView around, JsonWriter& out) {
			Core::StringView uri = DocumentOf(node, around);
			const bool position = IsPosition(node);
			const bool folding = IsFoldingRange(node);
			out.BeginObject();
			for (int64 i = 0; i < node.Count(); ++i) {
				Core::StringView key = node.KeyAt(i);
				Serialization::DomNode value = node.ValueAt(i);
				out.Key(key);
				if (position && key == "character") out.Int(Column(uri, node.Member("line").AsInt(), value.AsInt()));
				else if (folding && key == "startCharacter") out.Int(Column(uri, node.Member("startLine").AsInt(), value.AsInt()));
				else if (folding && key == "endCharacter") out.Int(Column(uri, node.Member("endLine").AsInt(), value.AsInt()));
				else if (IsUriKey(key) && value.Kind() == Serialization::DomKind::String) out.String(rewrite.mapUri(value.AsView()).View());
				else if (key == "originSelectionRange") Value(value, rewrite.uri.View(), out);
				else if (key == "changes" && value.Kind() == Serialization::DomKind::Object) Changes(value, out);
				else if (key == "data") out.Raw(NodeJson(value).View());
				else Value(value, uri, out);
			}
			out.EndObject();
		}

		// A WorkspaceEdit's `changes`: its keys are URIs, its values the edits of each.
		private void Changes(const Serialization::DomNode& changes, JsonWriter& out) {
			out.BeginObject();
			for (int64 i = 0; i < changes.Count(); ++i) {
				out.Key(rewrite.mapUri(changes.KeyAt(i)).View());
				Value(changes.ValueAt(i), changes.KeyAt(i), out);
			}
			out.EndObject();
		}

		private int64 Column(Core::StringView uri, int64 line, int64 character) {
			if (rewrite.from == rewrite.to) return character;
			const LineIndex* lines = rewrite.lines(uri);
			if (!lines) return character;
			return ConvertColumn(lines->Line(line), character, rewrite.from, rewrite.to);
		}

		private Rewrite rewrite;
	}

	Core::String RewriteJson(const Serialization::DomNode& node, const Rewrite& rewrite) {
		JsonWriter out;
		RewriteWalk walk = RewriteWalk(rewrite);
		walk.Value(node, rewrite.uri.View(), out);
		return out.ToString();
	}

	Core::Array<int64> RewriteSemanticTokens(const Core::Array<int64>& data, const LineIndex& lines, PositionEncoding from, PositionEncoding to) {
		Core::Array<int64> out;
		int64 line = 0;
		int64 start = 0;
		int64 previousLine = 0;
		int64 previousStart = 0;
		for (int64 i = 0; i + 4 < data.Count(); i += 5) {
			line += data[i];
			start = data[i] == 0 ? start + data[i + 1] : data[i + 1];
			Core::StringView text = lines.Line(line);
			const int64 newStart = ConvertColumn(text, start, from, to);
			const int64 newEnd = ConvertColumn(text, start + data[i + 2], from, to);
			out.Push(line - previousLine);
			out.Push(line == previousLine ? newStart - previousStart : newStart);
			out.Push(newEnd - newStart);
			out.Push(data[i + 3]);
			out.Push(data[i + 4]);
			previousLine = line;
			previousStart = newStart;
		}
		return out;
	}
}
