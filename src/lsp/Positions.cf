include "Positions.ch"

namespace Ied
{
	bool ParsePositionEncoding(Core::StringView name, PositionEncoding& encoding) {
		if (name == "utf-16") encoding = PositionEncoding::Utf16;
		else if (name == "utf-8" || name == "bytes") encoding = PositionEncoding::Utf8;
		else return false;
		return true;
	}

	const char* PositionEncodingName(PositionEncoding encoding) { return encoding == PositionEncoding::Utf16 ? "utf-16" : "utf-8"; }

	// How many UTF-8 bytes the sequence starting with `lead` takes (1 for a stray continuation byte).
	static int64 SequenceBytes(int32 lead) {
		if (lead < 0x80) return 1;
		if ((lead & 0xE0) == 0xC0) return 2;
		if ((lead & 0xF0) == 0xE0) return 3;
		if ((lead & 0xF8) == 0xF0) return 4;
		return 1;
	}

	// The UTF-16 units a sequence of `bytes` bytes stands for.
	static int64 Utf16Units(int64 bytes) { return bytes == 4 ? 2 : 1; }

	int64 ConvertColumn(Core::StringView line, int64 col, PositionEncoding from, PositionEncoding to) {
		if (from == to || col <= 0) return col;
		int64 bytes = 0;
		int64 units = 0;
		while (bytes < line.ByteLength()) {
			const int64 whole = SequenceBytes(line.ByteAt(bytes) & 0xFF);
			const int64 size = whole < line.ByteLength() - bytes ? whole : line.ByteLength() - bytes;
			const int64 here = from == PositionEncoding::Utf16 ? units : bytes;
			if (here >= col) return to == PositionEncoding::Utf16 ? units : bytes;
			bytes += size;
			units += Utf16Units(size);
		}
		const int64 end = to == PositionEncoding::Utf16 ? units : bytes;
		const int64 past = col - (from == PositionEncoding::Utf16 ? units : bytes);
		return past > 0 ? end + past : end;
	}

	void LineIndex::Init(Core::StringView text) {
		this.m_Text = Core::String(text);
		m_Starts.Push(0);
		for (int64 at = text.IndexOf('\n', 0); at >= 0; at = text.IndexOf('\n', at + 1)) m_Starts.Push(at + 1);
	}

	Core::StringView LineIndex::Line(int64 n) const {
		if (n < 0 || n >= m_Starts.Count()) return Core::StringView();
		const int64 start = m_Starts[n];
		const int64 end = n + 1 < m_Starts.Count() ? m_Starts[n + 1] - 1 : m_Text.ByteLength();
		return m_Text.View().Substring(start, end - start);
	}
}
