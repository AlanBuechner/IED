include "Client.ch"
include "Framing.ch"
include "Uris.ch"
include "host/Server.ch"

namespace Ied
{
	const int64 c_LspReadBytes = 65536;
	const int64 c_LspWaitSliceNs = 50000000;
	const int64 c_LspWriterSliceMs = 200;
	// The capabilities after `general` (ClientCapabilities).
	const char* c_TextDocumentCapabilities =
		"\"textDocument\":{\"synchronization\":{\"didSave\":true},\"completion\":{\"completionItem\":{\"snippetSupport\":true,\"documentationFormat\":[\"markdown\",\"plaintext\"],\"resolveSupport\":{\"properties\":[\"documentation\",\"detail\"]}},\"contextSupport\":true},\"hover\":{\"contentFormat\":[\"markdown\",\"plaintext\"]},\"signatureHelp\":{\"signatureInformation\":{\"documentationFormat\":[\"markdown\",\"plaintext\"],\"parameterInformation\":{\"labelOffsetSupport\":true}}},\"definition\":{\"linkSupport\":true},\"declaration\":{\"linkSupport\":true},\"typeDefinition\":{\"linkSupport\":true},\"implementation\":{\"linkSupport\":true},\"references\":{},\"documentHighlight\":{},\"documentSymbol\":{\"hierarchicalDocumentSymbolSupport\":true},\"codeAction\":{\"codeActionLiteralSupport\":{\"codeActionKind\":{\"valueSet\":[\"\",\"quickfix\",\"refactor\",\"refactor.extract\",\"refactor.inline\",\"refactor.rewrite\",\"source\",\"source.organizeImports\"]}},\"isPreferredSupport\":true},\"formatting\":{},\"rangeFormatting\":{},\"rename\":{\"prepareSupport\":true},\"publishDiagnostics\":{\"relatedInformation\":true,\"tagSupport\":{\"valueSet\":[1,2]},\"versionSupport\":true},\"foldingRange\":{\"lineFoldingOnly\":false},\"semanticTokens\":{\"requests\":{\"full\":true},\"formats\":[\"relative\"],\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"event\",\"function\",\"method\",\"macro\",\"keyword\",\"modifier\",\"comment\",\"string\",\"number\",\"regexp\",\"operator\",\"decorator\"],\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"static\",\"deprecated\",\"abstract\",\"async\",\"modification\",\"documentation\",\"defaultLibrary\"]},\"inlayHint\":{},\"callHierarchy\":{},\"typeHierarchy\":{}},\"workspace\":{\"workspaceFolders\":true,\"configuration\":true,\"applyEdit\":true,\"symbol\":{},\"semanticTokens\":{\"refreshSupport\":true}},\"window\":{\"workDoneProgress\":true}";

	const char* LspStateName(LspState state) {
		if (state == LspState::Starting) return "starting";
		if (state == LspState::Running) return "running";
		if (state == LspState::Failed) return "failed";
		return "stopped";
	}

	// What IED takes from a server (docs/24 "Lifecycle"): the encodings the profile allows, and the features the editor
	// renders.
	static Core::String ClientCapabilities(const LspProfile* profile) {
		Core::StringBuilder json;
		json.Append("{\"general\":{\"positionEncodings\":");
		if (profile->m_Negotiate) json.Append("[\"utf-16\",\"utf-8\"]");
		else {
			json.Append("[\"");
			json.Append(PositionEncodingName(profile->m_Encoding));
			json.Append("\"]");
		}
		json.Append("},");
		json.Append(c_TextDocumentCapabilities);
		json.Append("}");
		return json.ToString();
	}

	// A server's error object as plugin_error {code, message}.
	static RpcError ServerError(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode error = Serialization::ReadJson(json, *doc).root;
		Core::StringView message = error.Member("message").AsView();
		return RpcError(ErrorCode::PluginError, message.IsEmpty() ? Core::StringView("the language server failed") : message, json);
	}

	void LanguageServer::Init(Server* server, Workspace* ws, LspProfile* profile, Core::StringView project, const FS::Path& projectDir) {
		this.m_Server = server;
		this.m_Ws = ws;
		this.m_Profile = profile;
		this.m_Project = Core::String(project);
		this.m_ProjectDir = projectDir;
		this.m_State = LspState::Stopped;
		this.m_Capabilities = Core::String("{}");
		this.m_Encoding = PositionEncoding::Utf16;
		this.m_NextId = 1;
		this.m_Run = 0;
	}

	// --- Starting ----------------------------------------------------------------------------------------------------

	ProfileVariables LanguageServer::Variables() const {
		ProfileVariables variables;
		variables.m_PluginDir = Core::String(m_Profile->m_PluginDir.View());
		variables.m_WorkspaceDir = Core::String(m_Ws->m_Root.View());
		variables.m_SolutionDir = Core::String(m_Ws->m_Root.View());
		variables.m_ProjectName = m_Project;
		variables.m_ProjectDir = Core::String(m_ProjectDir.View());
		Settings* settings = m_Server->m_Settings;
		Workspace* workspace = m_Ws;
		variables.m_Config = [settings, workspace](Core::StringView key) -> Core::String { return settings->Effective(workspace, Core::StringView(""), key); };
		variables.m_IedHome = m_Server->m_Config.m_HomeDir;
		variables.m_PluginState = Core::String((FS::Path(m_Server->m_Config.m_DataDir.View()) / "plugins" / m_Profile->m_PluginId.View()).View());
		Tools* tools = m_Server->m_Tools;
		variables.m_Tool = [tools, workspace](Core::StringView id) -> Core::String { return tools->ProgramFor(workspace, id); };
		return variables;
	}

	Core::String LanguageServer::Source() const { return m_Project.IsEmpty() ? m_Profile->m_Id : (m_Profile->m_Id + "/") + m_Project.View(); }

	// The program to start: the profile's command, or with launchMode staged a copy of its folder (keyed by the
	// program's size and time, so a rebuilt server gets a new copy and the original stays free to rebuild).
	Core::String LanguageServer::ProgramToRun(Core::String& error) const {
		if (m_Server->m_Tools->LacksProgram(m_Ws, m_Profile->m_Command.View(), error)) return Core::String();
		Core::String command = ExpandProfileVariables(m_Profile->m_Command.View(), Variables());
		FS::Path program = FS::AbsolutePath(command.CStr());
		if (!m_Profile->m_Staged) return command;
		FS::FileInfo info;
		if (!FS::GetInfo(program.CStr(), info)) {
			error = Core::String("no program ") + command.View();
			return Core::String();
		}
		Core::StringBuilder key;
		key.AppendInt(info.size);
		key.Append("-");
		key.AppendInt(info.modifiedNs);
		FS::Path stage = FS::Path(m_Server->m_Config.m_StateDir.View()) / "lsp-stage" / m_Profile->m_Id.View() / key.View();
		FS::Path staged = stage / program.FileName();
		if (!FS::FileExists(staged.CStr()) && FS::CopyTree(program.Parent().CStr(), stage.CStr()) < 0) {
			error = Core::String("cannot stage ") + program.Parent().View() + " in " + stage.View();
			return Core::String();
		}
		return Core::String(staged.View());
	}

	Process::StartInfo LanguageServer::StartInfoFor(Core::StringView program) const {
		Process::StartInfo info;
		info.program = Core::String(program);
		ProfileVariables variables = Variables();
		for (const Core::String& arg : m_Profile->m_Args) ExpandProfileArgument(arg.View(), variables, info.arguments);
		for (const Core::String& entry : m_Profile->m_Environment) info.environment.Push(ExpandProfileVariables(entry.View(), variables));
		info.environment = m_Server->m_Tools->EnvironmentFor(m_Ws, info.environment);
		info.workingDirectory = m_Profile->m_Cwd.IsEmpty() ? Core::String(m_Ws->m_Root.View()) : ExpandProfileVariables(m_Profile->m_Cwd.View(), variables);
		info.input = Process::Redirect::Pipe;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::Pipe;
		return info;
	}

	void LanguageServer::Start() {
		Core::String error;
		Core::String program = ProgramToRun(error);
		if (program.IsEmpty()) {
			Fail(error.View());
			return;
		}
		Process::Child started = Process::Child::Start(StartInfoFor(program.View()));
		if (!started.IsOpen()) {
			Fail(((Core::String("cannot start ") + program.View()) + ": " + started.Error()).View());
			return;
		}
		m_Run += 1;
		const int64 thisRun = m_Run;
		m_Child = new Process::Child(take(started));
		m_Pid = m_Child->Id();
		m_Outgoing = new MessageQueue();
		m_State = LspState::Starting;
		m_Problem = Core::String();
		m_Capabilities = Core::String("{}");
		m_Documents.Clear();
		m_Transient.Clear();
		m_Progress.Clear();
		m_Progressed = false;
		m_StartedNs = clock_now_ns();
		m_UsedNs = m_StartedNs;
		LanguageServer* self = this;
		Process::Child* process = m_Child;
		MessageQueue* queue = m_Outgoing;
		Threading::Thread::Run([self, process, queue]() { self->WriteLoop(process, queue); }).Detach();
		Threading::Thread::Run([self, process, thisRun]() { self->ReadLoop(process, thisRun); }).Detach();
		Threading::Thread::Run([self, process, thisRun]() { self->ErrorLoop(process, thisRun); }).Detach();
		m_InitializeId = Ask(Core::StringView("initialize"), InitializeParams().View(), nullptr);
		m_Server->m_Lsp->StateChanged(this);
	}

	Core::String LanguageServer::InitializeParams() {
		JsonWriter json;
		json.BeginObject();
		json.IntField("processId", (int64)Platform::ProcessId());
		json.Key(Core::StringView("clientInfo"));
		json.BeginObject();
		json.Field("name", "IED");
		json.Field("version", m_Server->m_Config.m_Version.View());
		json.EndObject();
		Core::String root = FileUriOf(m_Ws->m_Root.View());
		json.Field("rootUri", root.View());
		json.Field("rootPath", m_Ws->m_Root.View());
		json.Key(Core::StringView("workspaceFolders"));
		json.BeginArray();
		json.BeginObject();
		json.Field("uri", root.View());
		json.Field("name", m_Ws->m_Name.View());
		json.EndObject();
		json.EndArray();
		json.RawField("initializationOptions", m_Server->m_Lsp->InitializationOptions(this).View());
		json.RawField("capabilities", ClientCapabilities(m_Profile).View());
		json.EndObject();
		return json.ToString();
	}

	bool LanguageServer::AwaitRunning(Call& call, int64 timeoutMs) {
		m_UsedNs = clock_now_ns();   // someone needs it
		const int64 deadline = clock_now_ns() + timeoutMs * 1000000;
		while (m_State == LspState::Starting && !call.m_Cancel->IsCancelled() && clock_now_ns() < deadline) call.m_Cancel->m_Wake.WaitFor(m_Server->m_Lock, c_LspWaitSliceNs);
		if (call.m_Cancel->IsCancelled()) throw RpcError(ErrorCode::Cancelled, "request cancelled");
		return m_State == LspState::Running;
	}

	// --- Talking -----------------------------------------------------------------------------------------------------

	void LanguageServer::Send(Core::StringView json) {
		if (m_Outgoing) m_Outgoing->Push(FrameMessage(json).View());
	}

	int64 LanguageServer::Ask(Core::StringView method, Core::StringView params, CancelToken* wake) {
		m_UsedNs = clock_now_ns();
		const int64 id = m_NextId;
		m_NextId += 1;
		LspAnswer* answer = new LspAnswer();
		answer->m_Wake = wake;
		m_Answers.Insert(id, answer);
		JsonWriter json;
		json.BeginObject();
		json.Field("jsonrpc", "2.0");
		json.IntField("id", id);
		json.Field("method", method);
		json.RawField("params", params);
		json.EndObject();
		Send(json.View());
		return id;
	}

	Core::String LanguageServer::Request(Call& call, Core::StringView method, Core::StringView params, int64 timeoutMs) {
		if (m_State != LspState::Running) throw RpcError(ErrorCode::Unavailable, (Core::String("the language server ") + m_Profile->m_Id.View() + " is " + LspStateName(m_State)).View());
		const int64 id = Ask(method, params, call.m_Cancel);
		const int64 deadline = clock_now_ns() + timeoutMs * 1000000;
		LspAnswer* answer = *m_Answers.Find(id);
		while (!answer->m_Done && !call.m_Cancel->IsCancelled() && clock_now_ns() < deadline) call.m_Cancel->m_Wake.WaitFor(m_Server->m_Lock, c_LspWaitSliceNs);
		m_Answers.Remove(id);
		if (answer->m_Done && answer->m_Ok) return answer->m_Json;
		if (answer->m_Done) throw ServerError(answer->m_Json.View());
		JsonWriter cancel;
		cancel.BeginObject();
		cancel.IntField("id", id);
		cancel.EndObject();
		Notify(Core::StringView("$/cancelRequest"), cancel.View());
		if (call.m_Cancel->IsCancelled()) throw RpcError(ErrorCode::Cancelled, "request cancelled");
		throw RpcError(ErrorCode::Timeout, (Core::String(method) + " took longer than the language server's time").View());
	}

	void LanguageServer::Notify(Core::StringView method, Core::StringView params) {
		m_UsedNs = clock_now_ns();
		JsonWriter json;
		json.BeginObject();
		json.Field("jsonrpc", "2.0");
		json.Field("method", method);
		json.RawField("params", params);
		json.EndObject();
		Send(json.View());
	}

	// A running server is asked to shut down and exit, and given kLspExitGraceMs to; any other is killed.
	void LanguageServer::Stop() {
		const bool running = m_State == LspState::Running;
		if (running) {
			Ask(Core::StringView("shutdown"), Core::StringView("null"), nullptr);
			Notify(Core::StringView("exit"), Core::StringView("null"));
		}
		m_State = LspState::Stopped;
		m_Run += 1;
		FailAnswers(Core::StringView("the language server stopped"));   // its threads are no longer heard, so nothing else answers them
		if (m_Outgoing) m_Outgoing->Close();
		Process::Child* process = m_Child;
		if (process && running) Threading::Thread::Run([process]() { if (process->Wait(c_LspExitGraceMs) == Process::kTimedOut) process->Kill(); }).Detach();
		else if (process) process->Kill();
		m_Server->m_Lsp->StateChanged(this);
	}

	void LanguageServer::Relaunch() {
		if (m_State == LspState::Running || m_State == LspState::Starting) Stop();
		m_ExitTimes.Clear();
		Start();
	}

	// --- What the server sends ----------------------------------------------------------------------------------------

	void LanguageServer::Dispatch(Core::StringView body) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(body, *doc);
		if (!read.Ok()) {
			m_Server->m_Lsp->Log(this, (Core::String("a message that is not JSON: ") + body.Substring(0, 200)).View());
			return;
		}
		Serialization::DomNode message = read.root;
		Serialization::DomNode id = message.Member("id");
		Serialization::DomNode method = message.Member("method");
		if (method.Kind() == Serialization::DomKind::String && id.IsValid()) {
			Core::String result = m_Server->m_Lsp->ServerRequest(this, method.AsView(), message.Member("params"));
			JsonWriter json;
			json.BeginObject();
			json.Field("jsonrpc", "2.0");
			json.RawField("id", NodeJson(id).View());
			json.RawField("result", result.View());
			json.EndObject();
			Send(json.View());
		}
		else if (method.Kind() == Serialization::DomKind::String) m_Server->m_Lsp->Notification(this, method.AsView(), message.Member("params"));
		else if (id.Kind() == Serialization::DomKind::Int) Answered(id.AsInt(), message);
	}

	void LanguageServer::Answered(int64 id, const Serialization::DomNode& message) {
		LspAnswer** found = m_Answers.Find(id);
		if (!found) return;
		LspAnswer* answer = *found;
		m_UsedNs = clock_now_ns();   // idle counts from the last answer, not from when a long request was sent
		answer->m_Done = true;
		answer->m_Ok = !message.Member("error").IsValid();
		answer->m_Json = NodeJson(answer->m_Ok ? message.Member("result") : message.Member("error"));
		if (answer->m_Json.IsEmpty()) answer->m_Json = Core::String("null");
		if (id == m_InitializeId) {
			m_Answers.Remove(id);
			Initialized(answer);
		}
		else if (!answer->m_Wake) m_Answers.Remove(id);
		else answer->m_Wake->m_Wake.NotifyAll();
	}

	void LanguageServer::Initialized(const LspAnswer* answer) {
		if (!answer->m_Ok) {
			Fail((Core::String("initialize was refused: ") + answer->m_Json.View()).View());
			return;
		}
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode result = Serialization::ReadJson(answer->m_Json.View(), *doc).root;
		m_Capabilities = NodeJson(result.Member("capabilities"));
		if (m_Capabilities.IsEmpty()) m_Capabilities = Core::String("{}");
		m_Encoding = m_Profile->m_Negotiate ? PositionEncoding::Utf16 : m_Profile->m_Encoding;
		if (m_Profile->m_Negotiate) ParsePositionEncoding(result.Member("capabilities").Member("positionEncoding").AsView(), m_Encoding);
		Notify(Core::StringView("initialized"), Core::StringView("{}"));
		m_State = LspState::Running;
		m_Server->m_Lsp->Running(this);
		m_Server->m_Lsp->StateChanged(this);
	}

	// --- Ending ------------------------------------------------------------------------------------------------------

	void LanguageServer::Fail(Core::StringView why) {
		m_State = LspState::Failed;
		m_Problem = Core::String(why);
		m_Server->m_Lsp->Log(this, why);
		m_Server->m_Lsp->StateChanged(this);
	}

	// The process ended (lock held): pending requests fail; it starts again after a pause, unless it ended too often.
	void LanguageServer::FailAnswers(Core::StringView why) {
		JsonWriter error;
		error.BeginObject();
		error.IntField("code", -32099);
		error.Field("message", why);
		error.EndObject();
		for (const Core::KeyValue<int64, LspAnswer*>& entry : m_Answers) {
			entry.value->m_Done = true;
			entry.value->m_Ok = false;
			entry.value->m_Json = error.ToString();
			if (entry.value->m_Wake) entry.value->m_Wake->m_Wake.NotifyAll();
		}
		m_Answers.Clear();
	}

	void LanguageServer::Exited() {
		FailAnswers(Core::StringView("the language server exited"));
		m_Documents.Clear();
		m_Transient.Clear();
		m_Progress.Clear();
		if (m_Outgoing) m_Outgoing->Close();
		if (m_State == LspState::Stopped) return;
		const int64 now = clock_now_ns();
		m_ExitTimes.Push(now);
		while (!m_ExitTimes.IsEmpty() && now - m_ExitTimes[0] > c_LspRestartWindowNs) m_ExitTimes.RemoveAt(0);
		if (m_ExitTimes.Count() >= c_LspMostRestarts) {
			Fail(Core::StringView("the language server exited three times in five minutes; restart it from the status"));
			return;
		}
		m_Restarts += 1;
		m_State = LspState::Starting;
		m_Problem = Core::String("the language server exited; starting it again");
		m_Server->m_Lsp->Log(this, m_Problem.View());
		m_Server->m_Lsp->StateChanged(this);
		const int64 pauseNs = (int64)1000000000 << (m_ExitTimes.Count() - 1);
		const int64 thisRun = m_Run;
		LanguageServer* self = this;
		Server* host = m_Server;
		Threading::Thread::Run([self, host, pauseNs, thisRun]() {
			Threading::Thread::Sleep(pauseNs);
			Threading::LockGuard guard(host->m_Lock);
			self->Restart(thisRun);
		}).Detach();
	}

	void LanguageServer::Restart(int64 previous) {
		if (m_Run == previous && m_State == LspState::Starting) Start();
	}

	// --- The threads -------------------------------------------------------------------------------------------------

	void LanguageServer::WriteLoop(Process::Child* process, MessageQueue* queue) {
		Core::String message;
		while (queue->Next(message, c_LspWriterSliceMs) || !queue->IsClosed()) {
			if (!message.IsEmpty() && !process->WriteText(message.View())) return;
			message = Core::String();
		}
	}

	void LanguageServer::ReadLoop(Process::Child* process, int64 thisRun) {
		FrameReader frames;
		char[c_LspReadBytes] buffer;
		for (;;) {
			const int64 got = process->Read(Process::Stream::Output, (void*)&buffer[0], c_LspReadBytes);
			if (got <= 0) break;
			frames.Feed(Core::StringView(&buffer[0], got));
			Core::String body;
			while (frames.Next(body)) {
				Threading::LockGuard guard(m_Server->m_Lock);
				if (m_Run == thisRun) Dispatch(body.View());
			}
			if (frames.Failed()) {
				Threading::LockGuard guard(m_Server->m_Lock);
				if (m_Run == thisRun) m_Server->m_Lsp->Log(this, frames.Failure());
				process->Kill();
				break;
			}
		}
		process->Wait();
		Threading::LockGuard guard(m_Server->m_Lock);
		if (m_Run == thisRun) Exited();
	}

	void LanguageServer::ErrorLoop(Process::Child* process, int64 thisRun) {
		char[c_LspReadBytes] buffer;
		Core::String partial;
		for (;;) {
			const int64 got = process->Read(Process::Stream::Errors, (void*)&buffer[0], c_LspReadBytes);
			if (got <= 0) break;
			partial.Append(Core::StringView(&buffer[0], got));
			Core::StringView text = partial.View();
			const int64 end = text.ByteLength() > 0 ? text.ByteLength() - 1 : 0;
			int64 cut = -1;
			for (int64 i = end; i >= 0; --i)
				if (text.ByteAt(i) == '\n') {
					cut = i;
					break;
				}
			if (cut < 0) continue;
			Core::String lines = Core::String(text.Substring(0, cut));
			partial = Core::String(text.Substring(cut + 1, text.ByteLength() - cut - 1));
			Threading::LockGuard guard(m_Server->m_Lock);
			if (m_Run == thisRun) m_Server->m_Lsp->Log(this, lines.View());
		}
	}
}
