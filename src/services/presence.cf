include "presence.ch"
include "host/server.ch"

namespace Ied
{
	static bool IsLevel(Core::StringView level) { return level == "info" || level == "warning" || level == "error" || level == "attention"; }

	Core::String NotificationJson(const Notification& note) {
		JsonWriter json;
		json.BeginObject();
		json.Field("id", note.id.View());
		json.Field("level", note.level.View());
		json.Field("text", note.text.View());
		json.IntField("ts", note.ts);
		json.EndObject();
		return json.ToString();
	}

	void Presence::Init(Server* server) {
		this.server = server;
		nextNote = 1;
		Presence* self = this;
		server->hub.Add(Core::StringView("server"), [self]() -> Core::String { return self->Snapshot(); });
		server->rpc.Register("server.info", [self](Call& call, const Params& params) -> Core::String { return self->Info(call, params); });
		server->rpc.Register("server.notify", [self](Call& call, const Params& params) -> Core::String { return self->Notify(call, params); });
		server->rpc.Register("server.dismiss", [self](Call& call, const Params& params) -> Core::String { return self->Dismiss(call, params); });
	}

	// The master's own methods and topics a client sends it (docs/10 "Routing"); its plugins' code adds theirs.
	static Core::Array<Core::String> MasterMethods() {
		const char*[16] names = {
			"server.info", "server.notify", "server.dismiss", "ws.list", "ws.openRecent", "ws.setFavorite", "ws.forgetRecent",
			"ws.close", "ws.restart", "auth.setPassword", "auth.devices", "auth.revoke", "plugins.setEnabled", "plugins.approve",
			"testhooks.mintToken", "testhooks.relaunch"
		};
		Core::Array<Core::String> methods;
		for (int32 i = 0; i < 16; ++i) methods.Push(Core::String(names[i]));
		return methods;
	}

	Core::String Presence::RoutesJson() const {
		Core::Array<Core::String> methods = MasterMethods();
		Core::Array<Core::String> topics;
		topics.Push(Core::String("server"));
		server->code->Registered(methods, topics);
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("methods"));
		json.BeginArray();
		for (const Core::String& name : methods) json.String(name.View());
		json.EndArray();
		json.Key(Core::StringView("topics"));
		json.BeginArray();
		for (const Core::String& key : topics) json.String(key.View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Presence::RoutesChanged() {
		if (!server->IsMaster()) return;
		Core::String routes = RoutesJson();
		if (routes.View() == published.View()) return;
		published = routes;
		server->hub.Publish(Core::StringView("server"), "routes.changed", (Core::String("{\"routes\":") + routes.View() + "}").View());
	}

	Core::String Presence::Snapshot() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", server->config.version.View());
		if (server->IsMaster()) {
			json.RawField("routes", RoutesJson().View());
			json.Key(Core::StringView("master"));
			json.BeginObject();
			json.IntField("pid", (int64)Platform::ProcessId());
			json.IntField("startedMs", server->startedMs);
			json.EndObject();
		}
		Core::String workspaces = server->workspaces->SummariesJson();
		json.RawField("workspaces", workspaces.View());
		json.RawField("recent", server->recent.Json().View());
		json.Key(Core::StringView("clients"));
		json.BeginArray();
		for (int64 i = 0; i < server->sessions.Count(); ++i) json.Raw(server->sessions[i]->ClientJson().View());
		json.EndArray();
		json.Key(Core::StringView("notifications"));
		json.BeginArray();
		for (int64 i = 0; i < notifications.Count(); ++i) json.Raw(NotificationJson(notifications[i]).View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Presence::Connected(Session* session) { server->hub.Publish(Core::StringView("server"), "device.connected", session->ClientJson().View()); }

	void Presence::Disconnected(Session* session) { server->hub.Publish(Core::StringView("server"), "device.disconnected", session->ClientJson().View()); }

	Core::String Presence::Info(Call& call, const Params& params) {
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", server->config.version.View());
		json.Field("sessionEpoch", server->epoch.View());
		json.IntField("proto", kProtocolVersion);
		json.BoolField("mock", false);
		json.BoolField("testHooks", server->config.testHooks);
		json.EndObject();
		return json.ToString();
	}

	Core::String Presence::Add(Core::StringView level, Core::StringView text) {
		if (!server->IsMaster() && server->master) {
			JsonWriter params;
			params.BeginObject();
			params.Field("level", level);
			params.Field("text", text);
			params.EndObject();
			Core::String result;
			Core::String problem;
			if (!server->master->Call(&server->lock, Core::StringView("master.notify"), params.View(), result, problem))
				server->Log((Core::String("a notification did not reach the master: ") + problem.View()).View());
			return Core::String();
		}
		Notification note;
		note.level = Core::String(level);
		note.text = Core::String(text);
		Core::StringBuilder id;
		id.Append("n");
		id.AppendInt(nextNote);
		nextNote += 1;
		note.id = id.ToString();
		note.ts = Platform::UnixTimeNs() / 1000000;
		Core::String data = NotificationJson(note);
		notifications.Push(note);
		server->hub.Publish(Core::StringView("server"), "notification", data.View());
		return note.id;
	}

	Core::String Presence::Notify(Call& call, const Params& params) {
		Core::String level = params.Str("level", Core::StringView("info"));
		if (!IsLevel(level.View())) throw RpcError(ErrorCode::BadRequest, "level must be one of info, warning, error, attention");
		Core::String id = Add(level.View(), params.Str("text").View());
		JsonWriter json;
		json.BeginObject();
		json.Field("id", id.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String Presence::Dismiss(Call& call, const Params& params) {
		Core::String id = params.Str("id");
		for (int64 i = 0; i < notifications.Count(); ++i) {
			if (notifications[i].id.View() != id.View()) continue;
			notifications.RemoveAt(i);
			JsonWriter data;
			data.BeginObject();
			data.Field("id", id.View());
			data.EndObject();
			server->hub.Publish(Core::StringView("server"), "notification.dismissed", data.View());
			return Core::String("{}");
		}
		throw RpcError(ErrorCode::NotFound, "no such notification");
	}
}
