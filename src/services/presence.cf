include "presence.ch"
include "host/server.ch"

namespace Ied
{
	static bool IsLevel(Core::StringView level) { return level == "info" || level == "warning" || level == "error" || level == "attention"; }

	Core::String NotificationJson(const Notification& note) {
		JsonWriter json;
		json.BeginObject();
		json.Field("id", note.id.View());
		json.Field("level", note.level.View());
		json.Field("text", note.text.View());
		json.IntField("ts", note.ts);
		json.EndObject();
		return json.ToString();
	}

	void Presence::Init(Server* server) {
		this.server = server;
		nextNote = 1;
		Presence* self = this;
		server->hub.Add(Core::StringView("server"), [self]() -> Core::String { return self->Snapshot(); });
		server->rpc.Register("server.info", [self](Call& call, const Params& params) -> Core::String { return self->Info(call, params); });
		server->rpc.Register("server.notify", [self](Call& call, const Params& params) -> Core::String { return self->Notify(call, params); });
		server->rpc.Register("server.dismiss", [self](Call& call, const Params& params) -> Core::String { return self->Dismiss(call, params); });
	}

	Core::String Presence::Snapshot() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", server->config.version.View());
		Core::String workspaces = server->workspaces->SummariesJson();
		json.RawField("workspaces", workspaces.View());
		json.Key(Core::StringView("clients"));
		json.BeginArray();
		for (int64 i = 0; i < server->sessions.Count(); ++i) json.Raw(server->sessions[i]->ClientJson().View());
		json.EndArray();
		json.Key(Core::StringView("notifications"));
		json.BeginArray();
		for (int64 i = 0; i < notifications.Count(); ++i) json.Raw(NotificationJson(notifications[i]).View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Presence::Connected(Session* session) { server->hub.Publish(Core::StringView("server"), "device.connected", session->ClientJson().View()); }

	void Presence::Disconnected(Session* session) { server->hub.Publish(Core::StringView("server"), "device.disconnected", session->ClientJson().View()); }

	Core::String Presence::Info(Call& call, const Params& params) {
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", server->config.version.View());
		json.Field("sessionEpoch", server->epoch.View());
		json.IntField("proto", kProtocolVersion);
		json.BoolField("mock", false);
		json.BoolField("testHooks", server->config.testHooks);
		json.EndObject();
		return json.ToString();
	}

	Core::String Presence::Notify(Call& call, const Params& params) {
		Notification note;
		note.level = params.Str("level", Core::StringView("info"));
		if (!IsLevel(note.level.View())) throw RpcError(ErrorCode::BadRequest, "level must be one of info, warning, error, attention");
		note.text = params.Str("text");
		Core::StringBuilder id;
		id.Append("n");
		id.AppendInt(nextNote);
		nextNote += 1;
		note.id = id.ToString();
		note.ts = Platform::UnixTimeNs() / 1000000;
		Core::String data = NotificationJson(note);
		notifications.Push(note);
		server->hub.Publish(Core::StringView("server"), "notification", data.View());
		JsonWriter json;
		json.BeginObject();
		json.Field("id", note.id.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String Presence::Dismiss(Call& call, const Params& params) {
		Core::String id = params.Str("id");
		for (int64 i = 0; i < notifications.Count(); ++i) {
			if (notifications[i].id.View() != id.View()) continue;
			notifications.RemoveAt(i);
			JsonWriter data;
			data.BeginObject();
			data.Field("id", id.View());
			data.EndObject();
			server->hub.Publish(Core::StringView("server"), "notification.dismissed", data.View());
			return Core::String("{}");
		}
		throw RpcError(ErrorCode::NotFound, "no such notification");
	}
}
