include "blobs.ch"

namespace Ied
{
	Core::String Blobs::Put(Core::StringView contentType, const Core::Array<uint8>& bytes) {
		uint8[8] random;
		Platform::RandomBytes((void*)&random[0], 8);
		Core::StringBuilder id;
		id.Append("b-");
		for (int32 i = 0; i < 8; ++i) id.AppendUIntBase((uint64)random[i], 16, 2);
		Blob* blob = new Blob();
		blob->contentType = Core::String(contentType);
		blob->bytes = bytes;
		Threading::LockGuard guard(mutex);
		while (!order.IsEmpty() && keptBytes + bytes.Count() > limitBytes) DropOldest();
		items.Insert(id.ToString(), blob);
		order.Push(id.ToString());
		keptBytes += bytes.Count();
		return id.ToString();
	}

	Blob* Blobs::Get(Core::StringView id) {
		Threading::LockGuard guard(mutex);
		Blob* blob = nullptr;
		items.TryGet(Core::String(id), blob);
		return blob;
	}

	int64 Blobs::KeptBytes() {
		Threading::LockGuard guard(mutex);
		return keptBytes;
	}

	// With the mutex held.
	void Blobs::DropOldest() {
		Blob* blob = nullptr;
		if (items.TryGet(order[0], blob)) keptBytes -= blob->bytes.Count();
		items.Remove(order[0]);
		order.RemoveAt(0);
	}
}
