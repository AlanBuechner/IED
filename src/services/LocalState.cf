include "LocalState.ch"
include "Workspaces.ch"
include "host/Trust.ch"

namespace Ied
{
	const char*[6] c_IedLocalEntries = { "chats", "breakpoints.json", "selections.json", "browser", "gpu-captures", "captures" };

	FS::Path LocalStateFolder(const FS::Path& root, Core::StringView kind, Core::StringView appData) {
		if (kind == "solution") return root / ".ied" / "local";
		Core::String key = TextDigest(TrustKey(root.View()).View());
		return FS::Path(appData) / "workspaces" / key.View().Substring(0, 16);
	}

	static int32 Folded(int32 c) {
		if (c == '\\') return '/';
		return c >= 'A' && c <= 'Z' ? c + 32 : c;
	}

	// How many bytes of `path` the .ied/local prefix takes (with its separator); -1 when it is not under it.
	static int64 LocalPrefix(Core::StringView path) {
		Core::StringView prefix = Core::StringView(c_LocalStatePath);
		if (path.ByteLength() < prefix.ByteLength()) return -1;
		for (int64 i = 0; i < prefix.ByteLength(); ++i)
			if (Folded(path.ByteAt(i)) != prefix.ByteAt(i)) return -1;
		if (path.ByteLength() == prefix.ByteLength()) return prefix.ByteLength();
		return Folded(path.ByteAt(prefix.ByteLength())) == '/' ? prefix.ByteLength() + 1 : -1;
	}

	bool InLocalState(Core::StringView path) { return LocalPrefix(path) >= 0; }

	FS::Path LocalOrRootFile(const FS::Path& root, const FS::Path& localState, Core::StringView path) {
		const int64 prefix = LocalPrefix(path);
		if (prefix < 0) return path.IsEmpty() ? root : root / path;
		Core::StringView rest = path.Substring(prefix, path.ByteLength() - prefix);
		return rest.IsEmpty() ? localState : localState / rest;
	}

	static bool HoldsSolution(const FS::Path& root) {
		for (FS::DirectoryEntry& entry : FS::Directory(root.CStr()))
			if (entry.kind == FS::EntryKind::File && IsSolutionFile(entry.name.View())) return true;
		return false;
	}

	// A copy of a file or a folder's tree (links left out); false when part of it could not be.
	static bool CopyTree(const FS::Path& from, const FS::Path& to) {
		if (!FS::IsDirectory(from.CStr())) return FS::CopyFile(from.CStr(), to.CStr(), false);
		if (!FS::MakeDirectories(to.CStr())) return false;
		for (FS::DirectoryEntry& entry : FS::Directory(from.CStr()))
			if (entry.kind != FS::EntryKind::Link && !CopyTree(from / entry.name.View(), to / entry.name.View())) return false;
		return true;
	}

	// Moves one entry: a rename, or across volumes a copy and then the original removed.
	static bool MoveEntry(const FS::Path& from, const FS::Path& to) {
		if (FS::Rename(from.CStr(), to.CStr())) return true;
		if (CopyTree(from, to) && FS::RemoveAll(from.CStr()) >= 0) return true;
		FS::RemoveAll(to.CStr());
		return false;
	}

	// Moves `name` from `from` into `to` unless `to` has it: what happened, or "" when `from` had nothing of the name.
	static Core::String MoveNamed(const FS::Path& from, const FS::Path& to, const char* name) {
		FS::Path source = from / name;
		FS::Path target = to / name;
		if (!FS::FileExists(source.CStr()) && !FS::IsDirectory(source.CStr())) return Core::String();
		if (FS::FileExists(target.CStr()) || FS::IsDirectory(target.CStr())) return (((Core::String("kept ") + source.View()) + ": ") + target.View()) + " exists";
		if (MoveEntry(source, target)) return ((Core::String("moved ") + source.View()) + " to ") + target.View();
		return ((Core::String("could not move ") + source.View()) + " to ") + target.View();
	}

	Core::Array<Core::String> AdoptFolderState(const FS::Path& root, const FS::Path& localState, Core::StringView appData) {
		Core::Array<Core::String> said;
		FS::Path folderState = LocalStateFolder(root, Core::StringView("folder"), appData);
		if (!FS::IsDirectory(folderState.CStr())) return said;
		FS::MakeDirectories(localState.CStr());
		for (const char* name : c_IedLocalEntries) {
			Core::String line = MoveNamed(folderState, localState, name);
			if (!line.IsEmpty()) said.Push(line);
		}
		Core::String layout = MoveNamed(folderState, localState, "layout");
		if (!layout.IsEmpty()) said.Push(layout);
		FS::RemoveEmptyDirectory(folderState.CStr());
		return said;
	}

	Core::Array<Core::String> MoveFolderState(const FS::Path& root, const FS::Path& localState) {
		Core::Array<Core::String> said;
		FS::Path legacy = root / ".ied" / "local";
		if (!FS::IsDirectory(legacy.CStr()) || FS::IsLink(legacy.CStr()) || HoldsSolution(root)) return said;
		FS::MakeDirectories(localState.CStr());
		for (const char* name : c_IedLocalEntries) {
			Core::String line = MoveNamed(legacy, localState, name);
			if (!line.IsEmpty()) said.Push(line);
		}
		FS::RemoveEmptyDirectory(legacy.CStr());
		FS::RemoveEmptyDirectory((root / ".ied").CStr());
		return said;
	}
}
