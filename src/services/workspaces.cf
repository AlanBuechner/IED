include "workspaces.ch"
include "host/server.ch"
include "host/trust.ch"

namespace Ied
{
	static RpcError BadPath(Core::StringView path) {
		Core::StringBuilder message;
		message.Append("path must be workspace-relative without '.' or '..': '");
		message.Append(path);
		message.Append("'");
		return RpcError(ErrorCode::BadRequest, message.View());
	}

	static RpcError Missing(const char* what, Core::StringView path) {
		Core::StringBuilder message;
		message.Append("no ");
		message.Append(what);
		message.Append(" '");
		message.Append(path);
		message.Append("'");
		return RpcError(ErrorCode::NotFound, message.View());
	}

	static RpcError Changed(int64 revision) {
		JsonWriter data;
		data.BeginObject();
		data.IntField("revision", revision);
		data.EndObject();
		return RpcError(ErrorCode::Conflict, "the file changed since that revision", data.View());
	}

	Core::String NormalizePath(Core::StringView path) {
		if (path.ByteLength() >= 2 && path.ByteAt(1) == ':') throw BadPath(path);
		Core::StringBuilder clean;
		int64 at = 0;
		while (at < path.ByteLength()) {
			int64 end = at;
			while (end < path.ByteLength() && path.ByteAt(end) != '/' && path.ByteAt(end) != '\\') end += 1;
			Core::StringView part = path.Substring(at, end - at);
			if (part == "." || part == "..") throw BadPath(path);
			if (!part.IsEmpty()) {
				if (!clean.IsEmpty()) clean.AppendByte('/');
				clean.Append(part);
			}
			at = end + 1;
		}
		return clean.ToString();
	}

	FS::Path Workspace::At(Core::StringView path) const { return path.IsEmpty() ? root : root / path; }

	Core::String TextDigest(Core::StringView text) { return Crypto::Sha256((const void*)text.Data(), text.ByteLength()).ToHex(); }

	bool IsHiddenPath(Core::StringView path) {
		return path == ".git" || path.StartsWith(Core::StringView(".git/")) || path.EndsWith(Core::StringView("/.git")) || path.Contains(Core::StringView("/.git/"));
	}

	Core::String Workspace::SummaryJson() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("wsId", wsId.View());
		json.Field("name", name.View());
		json.Field("kind", kind.View());
		json.Field("root", root.View());
		json.BoolField("trusted", trusted);
		json.EndObject();
		return json.ToString();
	}

	void Workspaces::Init(Server* server) {
		this.server = server;
		RegisterMethods();
		Core::String relative;
		for (int64 i = 0; i < server->config.workspaces.Count(); ++i) {
			FS::Path given = FS::CanonicalPath(server->config.workspaces[i].CStr());
			if (given.IsEmpty()) server->Log((Core::String("no such workspace: ") + server->config.workspaces[i].View()).View());
			else OpenFor(given, relative);
		}
		// The test suites' server with no workspace gets an empty one inside its data folder, which goes with it.
		if (items.IsEmpty() && server->config.testHooks) {
			FS::Path scratch = FS::Path(server->config.dataDir.View()) / "scratch-workspace";
			FS::MakeDirectories(scratch.CStr());
			Open(scratch, Core::StringView("folder"));
		}
	}

	static int32 FoldedByte(int32 c) {
		if (c == '\\') return '/';
		return c >= 'A' && c <= 'Z' ? c + 32 : c;
	}

	bool RelativeTo(Core::StringView root, Core::StringView path, Core::String& relative) {
		int64 rootLength = root.ByteLength();
		while (rootLength > 0 && FoldedByte(root.ByteAt(rootLength - 1)) == '/') rootLength -= 1;
		if (path.ByteLength() < rootLength) return false;
		for (int64 i = 0; i < rootLength; ++i)
			if (FoldedByte(root.ByteAt(i)) != FoldedByte(path.ByteAt(i))) return false;
		if (path.ByteLength() > rootLength && FoldedByte(path.ByteAt(rootLength)) != '/') return false;
		Core::StringBuilder inside;
		for (int64 i = rootLength + 1; i < path.ByteLength(); ++i) inside.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		relative = inside.ToString();
		return true;
	}

	Workspace* Workspaces::OpenFor(const FS::Path& target, Core::String& relative) {
		if (IsSolutionFile(target.View())) {
			relative = Core::String(target.FileName());
			for (Workspace* ws : items)
				if (ws->solution && TrustKey(ws->solution->file.View()).View() == TrustKey(target.View()).View()) return ws;
			return OpenSolution(target);
		}
		for (Workspace* ws : items)
			if (RelativeTo(ws->root.View(), target.View(), relative)) return ws;
		const bool folder = FS::IsDirectory(target.CStr());
		Workspace* opened = Open(folder ? target : target.Parent(), Core::StringView(folder ? "folder" : "file"));
		relative = folder ? Core::String() : Core::String(target.FileName());
		server->hub.Publish(Core::StringView("server"), "workspace.opened", opened->SummaryJson().View());
		return opened;
	}

	// Every problem of a solution and its projects goes to the server log too (docs/02, docs/03).
	static void LogProblems(Server* server, const SolutionModel* solution) {
		Core::String prefix = (Core::String("solution ") + solution->name.View()) + ": ";
		for (const Core::String& problem : solution->problems) server->Log((prefix + problem.View()).View());
		for (ProjectModel* project : solution->projects)
			for (const Core::String& problem : project->problems) server->Log((prefix + problem.View()).View());
	}

	Workspace* Workspaces::OpenSolution(const FS::Path& file) {
		Workspace* ws = Open(file.Parent(), Core::StringView("solution"));
		ws->solution = ReadSolution(file, server->schemas);
		ws->name = ws->solution->name;
		LogProblems(server, ws->solution);
		server->settings->SolutionChanged(ws);
		server->hub.Publish(Core::StringView("server"), "workspace.opened", ws->SummaryJson().View());
		return ws;
	}

	// A solution file or a project file changed, appeared or went: the model is read again and told.
	void Workspaces::ReadSolutionAgain(Workspace* ws) {
		ws->solution = ReadSolution(ws->solution->file, server->schemas);
		ws->name = ws->solution->name;
		LogProblems(server, ws->solution);
		server->settings->SolutionChanged(ws);
		JsonWriter data;
		data.BeginObject();
		data.RawField("solution", ws->solution->ToJson().View());
		data.EndObject();
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "solution.changed", data.View());
		server->tasks->ProjectsChanged(ws);
	}

	static bool TouchesSolution(const Workspace* ws, const ChangeBatch& batch) {
		if (!ws->solution) return false;
		for (const TreeChange& change : batch.Changes()) {
			if (change.path.View().EndsWith(Core::StringView(".ied.proj")) || IsSolutionFile(change.path.View())) return true;
			for (const Core::String& watched : ws->solution->watched)
				if (watched.View() == change.path.View()) return true;
		}
		return batch.Overflowed();
	}

	// Whether a change is in the workspace's own plugins (.ied/plugins/, read again on every request): what they
	// contribute then changes.
	static bool TouchesWorkspacePlugins(const ChangeBatch& batch) {
		for (const TreeChange& change : batch.Changes())
			if (change.path.View().StartsWith(Core::StringView(".ied/plugins/"))) return true;
		return batch.Overflowed();
	}

	// The workspace's project plugins' code reconciled, its settings catalog and task offers made again, and its clients
	// told to read the contributions again.
	void Workspaces::PluginsChanged(Workspace* ws) {
		server->code->Reconcile(ws);
		ContributionsChanged(ws);
	}

	void Workspaces::ContributionsChanged(Workspace* ws) {
		server->outputs->PluginsChanged(ws);
		server->settings->PluginsChanged(ws);
		server->tasks->ProjectsChanged(ws);
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "plugins.changed", Core::StringView("{}"));
	}

	Workspace* Workspaces::Open(const FS::Path& folder, Core::StringView kind) {
		Workspace* ws = new Workspace();
		Core::StringBuilder id;
		id.Append("w");
		id.AppendInt(items.Count() + 1);
		ws->wsId = id.ToString();
		FS::Path canonical = FS::CanonicalPath(folder.CStr());
		ws->root = canonical.IsEmpty() ? folder : canonical;
		ws->name = Core::String(ws->root.FileName());
		ws->kind = Core::String(kind);
		ws->trusted = server->trust.IsTrusted(ws->root);
		items.Push(ws);
		Workspaces* self = this;
		Core::String topic = Core::String("ws:") + ws->wsId.View();
		server->hub.Add(topic.View(), [self, ws]() -> Core::String { return self->Snapshot(ws); });
		server->settings->Opened(ws);
		server->outputs->Opened(ws);
		server->layouts->Opened(ws);
		server->diagnostics->WorkspaceOpened(ws);
		server->lsp->WorkspaceOpened(ws);
		server->tasks->WorkspaceOpened(ws);
		server->breakpoints->WorkspaceOpened(ws);
		server->debugger->WorkspaceOpened(ws);
		server->chats->WorkspaceOpened(ws);
		server->code->WorkspaceOpened(ws);
		Watch(ws);
		server->Log((((Core::String("opened ") + ws->wsId.View()) + ": ") + ws->root.View()).View());
		return ws;
	}

	void Workspaces::Watch(Workspace* ws) {
		Server* shared = server;
		Workspaces* self = this;
		Core::String error;
		const bool watching = ws->watch.Start(ws->root, [shared, self, ws](const ChangeBatch& batch) {
			Threading::LockGuard guard(shared->lock);
			self->ApplyExternal(ws, batch);
		}, error);
		if (!watching) server->Log((Core::String("not watching ") + ws->root.View() + ": " + error.View()).View());
	}

	Workspace* Workspaces::Find(Core::StringView wsId) const {
		for (int64 i = 0; i < items.Count(); ++i)
			if (items[i]->wsId.View() == wsId) return items[i];
		return nullptr;
	}

	Workspace* Workspaces::Get(Core::StringView wsId) const {
		Workspace* ws = Find(wsId);
		if (!ws) throw Missing("workspace", wsId);
		return ws;
	}

	Core::String Workspaces::SummariesJson() const {
		JsonWriter json;
		json.BeginArray();
		for (int64 i = 0; i < items.Count(); ++i) json.Raw(items[i]->SummaryJson().View());
		json.EndArray();
		return json.ToString();
	}

	Core::String Workspaces::Snapshot(const Workspace* ws) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("wsId", ws->wsId.View());
		json.Field("name", ws->name.View());
		json.Field("root", ws->root.View());
		json.BoolField("trusted", ws->trusted);
		json.Field("kind", ws->kind.View());
		json.RawField("solution", ws->solution ? ws->solution->ToJson().View() : Core::StringView("null"));
		json.RawField("roots", Core::StringView("[\".\"]"));
		json.RawField("plugins", Core::StringView("[]"));
		json.RawField("chats", Core::StringView("[]"));
		json.EndObject();
		return json.ToString();
	}

	void Workspaces::TreeChanged(Workspace* ws, Core::StringView path, const char* change) {
		JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("changes"));
		data.BeginArray();
		data.BeginObject();
		data.Field("path", path);
		data.Field("change", change);
		data.EndObject();
		data.EndArray();
		data.EndObject();
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "tree.changed", data.View());
	}

	Workspace* Workspaces::ForRoot(const FS::Path& root) const {
		Core::String relative;
		for (Workspace* ws : items)
			if (RelativeTo(ws->root.View(), root.View(), relative) && relative.IsEmpty()) return ws;
		return nullptr;
	}

	void Workspaces::Moved(Workspace* ws, Core::StringView from, Core::StringView to) {
		JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("changes"));
		data.BeginArray();
		data.BeginObject();
		data.Field("path", from);
		data.Field("change", "deleted");
		data.EndObject();
		data.BeginObject();
		data.Field("path", to);
		data.Field("change", "created");
		data.EndObject();
		data.EndArray();
		data.EndObject();
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "tree.changed", data.View());
	}

	// The paths under `folder` ("a/b" holds "a/b/c", not "a/bc") among `paths`.
	static Core::Array<Core::String> Under(const Core::Array<Core::String>& paths, Core::StringView folder) {
		Core::String prefix = Core::String(folder) + "/";
		Core::Array<Core::String> under;
		for (const Core::String& path : paths)
			if (path.View().StartsWith(prefix.View())) under.Push(path);
		return under;
	}

	static Core::Array<Core::String> KnownPaths(const Workspace* ws) {
		Core::Array<Core::String> paths;
		for (const Core::KeyValue<Core::String, int64>& entry : ws->revisions) paths.Push(entry.key);
		return paths;
	}

	Core::String Workspaces::Read(Workspace* ws, Core::StringView path) {
		FS::Path file = ws->At(path);
		if (!FS::FileExists(file.CStr())) throw Missing("file", path);
		FS::File opened = FS::File(file.CStr(), "rb");
		Core::String text = opened.ReadText();
		ws->digests.At(Core::String(path)) = TextDigest(text.View());
		Revision(ws, path);
		return text;
	}

	int64 Workspaces::Revision(Workspace* ws, Core::StringView path) {
		if (!FS::FileExists(ws->At(path).CStr())) return 0;
		int64* known = ws->revisions.Find(Core::String(path));
		if (known) return *known;
		ws->revisions.Insert(Core::String(path), 1);
		return 1;
	}

	int64 Workspaces::Write(Workspace* ws, Core::StringView path, Core::StringView text, int64 expectedRevision) {
		const int64 current = Revision(ws, path);
		if (expectedRevision >= 0 && expectedRevision != current) throw Changed(current);
		FS::Path file = ws->At(path);
		if (FS::IsDirectory(file.CStr())) throw RpcError(ErrorCode::BadRequest, "that path is a directory");
		FS::MakeDirectories(file.Parent().CStr());
		FS::File opened = FS::File(file.CStr(), "wb");
		const bool written = opened.IsOpen() && (text.IsEmpty() || opened.Write((const void*)text.Data(), text.ByteLength()) == text.ByteLength());
		opened.Close();
		if (!written) throw RpcError(ErrorCode::Unavailable, "the file could not be written");
		ws->revisions.At(Core::String(path)) = current + 1;
		ws->digests.At(Core::String(path)) = TextDigest(text);
		TreeChanged(ws, path, current ? "changed" : "created");
		return current + 1;
	}

	// --- Changes made behind the server's back -------------------------------------------------------------------------

	void Workspaces::ApplyExternal(Workspace* ws, const ChangeBatch& batch) {
		Core::Array<TreeChange> published;
		for (const TreeChange& change : batch.Changes()) {
			if (!IsHiddenPath(change.path.View()) && External(ws, change)) published.Push(change);
			server->settings->WorkspaceFileChanged(ws, change.path.View());
		}
		if (batch.Overflowed())
			for (const Core::String& path : server->documents->OpenPaths(ws)) ExternalWrite(ws, path.View());
		if (!published.IsEmpty() || batch.Overflowed()) PublishTree(ws, published, batch.Overflowed());
		if (TouchesSolution(ws, batch)) ReadSolutionAgain(ws);
		if (TouchesWorkspacePlugins(batch)) PluginsChanged(ws);
		server->code->FilesChanged(ws, batch);
	}

	// Whether a change is someone else's; it updates what the server knows of the path either way.
	bool Workspaces::External(Workspace* ws, const TreeChange& change) {
		FS::Path file = ws->At(change.path.View());
		if (FS::IsDirectory(file.CStr())) return change.kind == TreeChangeKind::Created && !ws->ownDirectories.Remove(change.path);
		if (FS::FileExists(file.CStr())) return ExternalWrite(ws, change.path.View());
		return ExternalDelete(ws, change.path.View());
	}

	// Only a file the server read, wrote or holds open is read again, to compare it with what the server knows: any
	// other change cannot be the server's own.
	bool Workspaces::ExternalWrite(Workspace* ws, Core::StringView path) {
		Core::String key = Core::String(path);
		Core::String known;
		const bool tracked = ws->digests.TryGet(key, known);
		int64* revision = ws->revisions.Find(key);
		if (!tracked && !server->documents->IsOpen(ws, path)) {
			if (revision) *revision += 1;
			return true;
		}
		FS::File opened = FS::File(ws->At(path).CStr(), "rb");
		if (!opened.IsOpen()) return false;
		Core::String text = opened.ReadText();
		Core::String digest = TextDigest(text.View());
		if (tracked && known.View() == digest.View()) return false;
		ws->digests.At(key) = digest;
		if (revision) *revision += 1;
		server->documents->OnDiskWrite(ws, path, text.View(), Revision(ws, path));
		return true;
	}

	bool Workspaces::ExternalDelete(Workspace* ws, Core::StringView path) {
		Core::String key = Core::String(path);
		Core::String known;
		const bool own = ws->digests.TryGet(key, known) && known.IsEmpty();
		ws->digests.Remove(key);
		ws->revisions.Remove(key);
		if (own) return false;
		server->documents->OnDiskDeleted(ws, path);
		return true;
	}

	void Workspaces::PublishTree(Workspace* ws, const Core::Array<TreeChange>& changes, bool overflow) {
		JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("changes"));
		data.BeginArray();
		for (const TreeChange& change : changes) {
			data.BeginObject();
			data.Field("path", change.path.View());
			data.Field("change", TreeChangeName(change.kind));
			data.EndObject();
		}
		data.EndArray();
		if (overflow) data.BoolField("overflow", true);
		data.EndObject();
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "tree.changed", data.View());
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	struct ListedEntry
	{
		public Core::String name;
		public bool directory;
	}

	static int32 LowerAscii(int32 c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }

	// Directories first, then by name without regard to ASCII case.
	static bool ListedBefore(const ListedEntry& a, const ListedEntry& b) {
		if (a.directory != b.directory) return a.directory;
		Core::StringView x = a.name.View();
		Core::StringView y = b.name.View();
		for (int64 i = 0; i < x.ByteLength() && i < y.ByteLength(); ++i)
			if (LowerAscii(x.ByteAt(i)) != LowerAscii(y.ByteAt(i))) return LowerAscii(x.ByteAt(i)) < LowerAscii(y.ByteAt(i));
		return x.ByteLength() < y.ByteLength();
	}

	Core::String Workspaces::ListMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path", Core::StringView("")).View());
		FS::Directory folder = FS::Directory(ws->At(path.View()).CStr());
		if (!folder.IsOpen()) throw Missing("directory", path.View());
		Core::Array<ListedEntry> entries;
		for (FS::DirectoryEntry& entry : folder) {
			ListedEntry listed;
			listed.name = entry.name;
			listed.directory = entry.kind == FS::EntryKind::Directory;
			entries.Push(listed);
		}
		entries.SortBy(ListedBefore);
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path.View());
		json.Key(Core::StringView("entries"));
		json.BeginArray();
		for (int64 i = 0; i < entries.Count(); ++i) {
			Core::String full = path.IsEmpty() ? entries[i].name : path + "/" + entries[i].name.View();
			if (IsHiddenPath(full.View())) continue;
			json.BeginObject();
			json.Field("name", entries[i].name.View());
			json.Field("path", full.View());
			json.Field("kind", entries[i].directory ? "dir" : "file");
			if (!entries[i].directory) {
				json.IntField("size", FS::FileSize(ws->At(full.View()).CStr()));
				json.IntField("revision", Revision(ws, full.View()));
			}
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::ReadMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		Core::String text = Read(ws, path.View());
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path.View());
		json.Field("text", text.View());
		json.IntField("revision", Revision(ws, path.View()));
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::WriteMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		Core::String text = params.Str("text");
		const int64 revision = Write(ws, path.View(), text.View(), params.Int("expectedRevision", -1));
		server->documents->OnDiskWrite(ws, path.View(), text.View(), revision);
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path.View());
		json.IntField("revision", revision);
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::DeleteMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		if (!path.IsEmpty() && FS::IsDirectory(ws->At(path.View()).CStr())) return DeleteFolder(ws, path.View(), params.Bool("recursive", false));
		const int64 current = Revision(ws, path.View());
		if (!current) throw Missing("file", path.View());
		const int64 expected = params.Int("expectedRevision", -1);
		if (expected >= 0 && expected != current) throw Changed(current);
		Core::String trashId = server->trash->MoveIn(ws, path.View(), false);
		ws->revisions.Remove(path);
		ws->digests.At(path) = Core::String();
		server->documents->OnDiskDeleted(ws, path.View());
		TreeChanged(ws, path.View(), "deleted");
		return TrashResult(trashId.View());
	}

	static Core::String TrashResult(Core::StringView trashId) {
		JsonWriter json;
		json.BeginObject();
		json.Field("trashId", trashId);
		json.EndObject();
		return json.ToString();
	}

	// A folder with everything in it, when `recursive` says so, to the trash: the files known under it are forgotten
	// and the documents open on them told.
	Core::String Workspaces::DeleteFolder(Workspace* ws, Core::StringView path, bool recursive) {
		if (!recursive) throw RpcError(ErrorCode::BadRequest, "the path is a folder: pass recursive to delete it with everything in it");
		Core::String trashId = server->trash->MoveIn(ws, path, true);
		for (const Core::String& known : Under(KnownPaths(ws), path)) {
			if (FS::FileExists(ws->At(known.View()).CStr())) continue;
			ws->revisions.Remove(known);
			ws->digests.At(known) = Core::String();
		}
		for (const Core::String& open : Under(server->documents->OpenPaths(ws), path))
			if (!FS::FileExists(ws->At(open.View()).CStr())) server->documents->OnDiskDeleted(ws, open.View());
		TreeChanged(ws, path, "deleted");
		return TrashResult(trashId.View());
	}

	// A folder moved with what is in it: revisions and digests follow, and so do the documents open under it.
	Core::String Workspaces::RenameFolder(Workspace* ws, Core::StringView source, Core::StringView target) {
		if (target.StartsWith((Core::String(source) + "/").View())) throw RpcError(ErrorCode::BadRequest, "a folder cannot move into itself");
		FS::Path to = ws->At(target);
		if (FS::FileExists(to.CStr()) || FS::IsDirectory(to.CStr())) throw RpcError(ErrorCode::Conflict, "the target already exists");
		FS::MakeDirectories(to.Parent().CStr());
		if (!FS::Rename(ws->At(source).CStr(), to.CStr())) throw RpcError(ErrorCode::Unavailable, "the folder could not be renamed");
		const int64 cut = source.ByteLength();
		for (const Core::String& known : Under(KnownPaths(ws), source)) {
			Core::String moved = Core::String(target) + known.View().Substring(cut, known.ByteLength() - cut);
			ws->revisions.At(moved) = ws->revisions.Get(known);
			ws->digests.At(moved) = ws->digests.Get(known);
			ws->revisions.Remove(known);
			ws->digests.At(known) = Core::String();
		}
		ws->ownDirectories.At(Core::String(target)) = true;
		for (const Core::String& open : Under(server->documents->OpenPaths(ws), source))
			server->documents->Renamed(ws, open.View(), (Core::String(target) + open.View().Substring(cut, open.ByteLength() - cut)).View());
		Moved(ws, source, target);
		JsonWriter json;
		json.BeginObject();
		json.Field("path", target);
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::MakeDirectoryMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		FS::Path folder = ws->At(path.View());
		if (FS::FileExists(folder.CStr())) throw RpcError(ErrorCode::Conflict, "that path is a file");
		if (!FS::IsDirectory(folder.CStr())) {
			if (!FS::MakeDirectories(folder.CStr())) throw RpcError(ErrorCode::Unavailable, "the directory could not be made");
			ws->ownDirectories.At(path) = true;
			TreeChanged(ws, path.View(), "created");
		}
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::RenameMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		Core::String source = NormalizePath(params.Str("from").View());
		Core::String target = NormalizePath(params.Str("to").View());
		if (source.IsEmpty() || target.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "the workspace's own folder cannot be renamed");
		if (FS::IsDirectory(ws->At(source.View()).CStr())) return RenameFolder(ws, source.View(), target.View());
		const int64 revision = Revision(ws, source.View());
		if (!revision) throw Missing("file", source.View());
		FS::Path to = ws->At(target.View());
		if (FS::FileExists(to.CStr()) || FS::IsDirectory(to.CStr())) throw RpcError(ErrorCode::Conflict, "the target already exists");
		FS::MakeDirectories(to.Parent().CStr());
		if (!FS::Rename(ws->At(source.View()).CStr(), to.CStr())) throw RpcError(ErrorCode::Unavailable, "the file could not be renamed");
		ws->revisions.Remove(source);
		ws->revisions.At(target) = revision;
		ws->digests.At(source) = Core::String();
		FS::File moved = FS::File(to.CStr(), "rb");
		ws->digests.At(target) = TextDigest(moved.ReadText().View());
		server->documents->Renamed(ws, source.View(), target.View());
		Moved(ws, source.View(), target.View());
		JsonWriter json;
		json.BeginObject();
		json.Field("path", target.View());
		json.IntField("revision", revision);
		json.EndObject();
		return json.ToString();
	}

	Core::String Workspaces::SetTrustMethod(Call& call, const Params& params) {
		Workspace* ws = Get(params.Str("wsId").View());
		const bool trusted = params.Bool("trusted", ws->trusted);
		if (!server->trust.Set(ws->root, trusted)) throw RpcError(ErrorCode::Unavailable, "the trust choice could not be saved");
		ws->trusted = trusted;
		server->settings->TrustChanged(ws);
		server->lsp->TrustChanged(ws);
		server->code->Reconcile(ws);
		server->code->TrustChanged(ws);
		server->auth->Record(trusted ? "workspace-trusted" : "workspace-untrusted", (Core::String("\"root\":") + JsonString(ws->root.View()).View()).View());
		JsonWriter data;
		data.BeginObject();
		data.BoolField("trusted", ws->trusted);
		data.EndObject();
		server->hub.Publish((Core::String("ws:") + ws->wsId.View()).View(), "trust.changed", data.View());
		return data.ToString();
	}

	void Workspaces::RegisterMethods() {
		Workspaces* self = this;
		server->rpc.Register("ws.list", [self](Call& call, const Params& params) -> Core::String {
			return (Core::String("{\"workspaces\":") + self->SummariesJson().View()) + "}";
		});
		server->rpc.Register("ws.setTrust", [self](Call& call, const Params& params) -> Core::String { return self->SetTrustMethod(call, params); });
		server->rpc.Register("fs.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->rpc.Register("fs.read", [self](Call& call, const Params& params) -> Core::String { return self->ReadMethod(call, params); });
		server->rpc.Register("fs.write", [self](Call& call, const Params& params) -> Core::String { return self->WriteMethod(call, params); });
		server->rpc.Register("fs.delete", [self](Call& call, const Params& params) -> Core::String { return self->DeleteMethod(call, params); });
		server->rpc.Register("fs.mkdir", [self](Call& call, const Params& params) -> Core::String { return self->MakeDirectoryMethod(call, params); });
		server->rpc.Register("fs.rename", [self](Call& call, const Params& params) -> Core::String { return self->RenameMethod(call, params); });
	}
}
