include "terminals.ch"
include "host/server.ch"

namespace Ied
{
	const int64 kTerminalReadBytes = 65536;
	const int32 kTerminalMostColumns = 1000;
	const int32 kTerminalMostRows = 500;
	const int32 kTerminalPollMs = 250;
	const int32 kTerminalDrainMs = 100;

	Core::String TerminalsTopic(const Workspace* ws) { return Core::String("terms:") + ws->wsId.View(); }

	Core::String Terminal::SummaryJson() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("termId", termId.View());
		json.Field("wsId", ws->wsId.View());
		json.Field("title", title.View());
		json.Field("kind", kind.View());
		json.BoolField("alive", alive);
		json.Key(Core::StringView("exitCode"));
		if (alive) json.Null();
		else json.Int(exitCode);
		json.Field("holder", holder.View());
		json.EndObject();
		return json.ToString();
	}

	void Terminals::Init(Server* server) {
		this.server = server;
		Terminals* self = this;
		server->rpc.Register("term.create", [self](Call& call, const Params& params) -> Core::String { return self->CreateMethod(call, params); });
		server->rpc.Register("term.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->rpc.Register("term.input", [self](Call& call, const Params& params) -> Core::String { return self->InputMethod(call, params); });
		server->rpc.Register("term.takeLease", [self](Call& call, const Params& params) -> Core::String { return self->TakeLeaseMethod(call, params); });
		server->rpc.Register("term.resize", [self](Call& call, const Params& params) -> Core::String { return self->ResizeMethod(call, params); });
		server->rpc.Register("term.rename", [self](Call& call, const Params& params) -> Core::String { return self->RenameMethod(call, params); });
		server->rpc.Register("term.close", [self](Call& call, const Params& params) -> Core::String { return self->CloseMethod(call, params); });
	}

	void Terminals::WorkspaceOpened(Workspace* ws) {
		Terminals* self = this;
		server->hub.Add(TerminalsTopic(ws).View(), [self, ws]() -> Core::String { return self->ListJson(ws); });
	}

	Terminal* Terminals::Find(Core::StringView termId) {
		for (Terminal* terminal : terminals)
			if (terminal->termId.View() == termId) return terminal;
		throw RpcError(ErrorCode::NotFound, (Core::String("no terminal ") + termId).View());
	}

	// --- Starting ----------------------------------------------------------------------------------------------------

	static Core::Array<Core::String> Argv(const char* program, const char* argument) {
		Core::Array<Core::String> argv;
		argv.Push(Core::String(program));
		if (argument) argv.Push(Core::String(argument));
		return argv;
	}

	// The programs to try, in order: the `terminal.shell` setting (a name or path, or an argv), else PowerShell 7, Windows
	// PowerShell and the system's cmd.
	Core::Array<Core::Array<Core::String>> Terminals::ShellsFor(Workspace* ws) {
		Core::Array<Core::Array<Core::String>> shells;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String json = server->settings->Effective(ws, Core::StringView(""), Core::StringView("terminal.shell"));
		Serialization::DomNode setting = json.IsEmpty() ? Serialization::DomNode() : Serialization::ReadJson(json.View(), *doc).root;
		if (setting.Kind() == Serialization::DomKind::String && !setting.AsView().IsEmpty()) shells.Push(Argv(setting.AsString(), nullptr));
		else if (setting.Kind() == Serialization::DomKind::Array && setting.Count() > 0) {
			Core::Array<Core::String> argv;
			for (int64 i = 0; i < setting.Count(); ++i) argv.Push(Core::String(setting.At(i).AsView()));
			shells.Push(argv);
		}
		if (!shells.IsEmpty()) return shells;
		shells.Push(Argv("pwsh", "-NoLogo"));
		shells.Push(Argv("powershell", "-NoLogo"));
		Core::String comspec;
		shells.Push(Argv(Platform::TryGetEnvironmentVariable("ComSpec", comspec) ? comspec.CStr() : "cmd", nullptr));
		return shells;
	}

	Process::Child* Terminals::StartIn(const Core::Array<Core::String>& argv, const FS::Path& cwd, int32 cols, int32 rows, Core::String& error) {
		Process::StartInfo info;
		info.program = argv[0];
		for (int64 i = 1; i < argv.Count(); ++i) info.arguments.Push(argv[i]);
		info.workingDirectory = Core::String(cwd.View());
		info.environment.Push(Core::String("TERM_PROGRAM=IED"));
		info.terminal = true;
		info.columns = cols;
		info.rows = rows;
		info.input = Process::Redirect::Pipe;
		info.output = Process::Redirect::Pipe;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			error = Core::String(started.Error());
			return nullptr;
		}
		return new Process::Child(take(started));
	}

	Terminal* Terminals::Create(Workspace* ws, const Core::Array<Core::String>& argv, const FS::Path& cwd, Core::StringView title, Core::StringView kind, Core::StringView holder, int32 cols, int32 rows) {
		Core::Array<Core::Array<Core::String>> tries;
		if (argv.IsEmpty()) tries = ShellsFor(ws);
		else tries.Push(argv);
		Process::Child* child = nullptr;
		Core::String error;
		Core::String program;
		for (const Core::Array<Core::String>& each : tries) {
			child = StartIn(each, cwd, cols, rows, error);
			program = each[0];
			if (child) break;
		}
		if (!child) throw RpcError(ErrorCode::Unavailable, (Core::String("the terminal could not start: ") + error.View()).View());
		made += 1;
		Terminal* terminal = new Terminal();
		Core::StringBuilder id;
		id.Append("term");
		id.AppendInt(made);
		terminal->termId = id.ToString();
		terminal->ws = ws;
		terminal->title = title.IsEmpty() ? Core::String(FS::Path(program.View()).Stem()) : Core::String(title);
		terminal->kind = Core::String(kind);
		terminal->holder = Core::String(holder);
		terminal->alive = true;
		terminal->cols = cols;
		terminal->rows = rows;
		terminal->child = child;
		terminal->input = new MessageQueue();
		terminals.Push(terminal);
		Terminals* self = this;
		Terminal* shown = terminal;
		server->hub.Add(terminal->Topic().View(), [self, shown]() -> Core::String { return self->Snapshot(shown); });
		Changed(terminal, "term.added");
		MessageQueue* input = terminal->input;
		Threading::Thread::Run([self, shown, child]() { self->ReadLoop(shown, child); }).Detach();
		Threading::Thread::Run([self, child, input]() { self->WriteLoop(child, input); }).Detach();
		return terminal;
	}

	void Terminals::WriteLoop(Process::Child* child, MessageQueue* input) {
		Core::String keys;
		while (input->Next(keys, 200) || !input->IsClosed()) {
			if (!keys.IsEmpty() && !child->WriteText(keys.View())) return;
			keys = Core::String();
		}
	}

	// --- Running -----------------------------------------------------------------------------------------------------

	// A pseudo console's output stays open after its program exits (until the console is closed), so the reader waits in
	// slices and, once the program is gone, takes what is left and closes the console.
	void Terminals::ReadLoop(Terminal* terminal, Process::Child* child) {
		char[kTerminalReadBytes] buffer;
		Core::String carried;
		bool exited = false;
		for (;;) {
			const int64 got = child->Read(Process::Stream::Output, (void*)&buffer[0], kTerminalReadBytes, exited ? kTerminalDrainMs : kTerminalPollMs);
			if (got == Process::kTimedOut && !exited) {
				exited = child->Wait(0) != Process::kTimedOut;
				continue;
			}
			if (got <= 0) break;
			Core::String bytes = carried + Core::StringView((const char*)&buffer[0], got);
			const int64 whole = WholeCharacters(bytes.View());
			carried = Core::String(bytes.View().Substring(whole, bytes.ByteLength() - whole));
			Core::StringView text = bytes.View().Substring(0, whole);
			Threading::LockGuard guard(server->lock);
			JsonWriter json;
			json.BeginObject();
			json.Field("data", text);
			json.EndObject();
			server->hub.Publish(terminal->Topic().View(), "data", json.View());
			terminal->scrollback = Bounded(terminal->scrollback.View(), text, kTerminalScrollbackBytes);
		}
		const int64 code = child->Wait();
		terminal->input->Close();
		child->Close();
		Threading::LockGuard guard(server->lock);
		if (!terminal->alive) return;
		terminal->alive = false;
		terminal->exitCode = code;
		JsonWriter json;
		json.BeginObject();
		json.IntField("code", code);
		json.EndObject();
		server->hub.Publish(terminal->Topic().View(), "exit", json.View());
		Changed(terminal, "term.changed");
	}

	void Terminals::Changed(Terminal* terminal, const char* kind) {
		server->hub.Publish(TerminalsTopic(terminal->ws).View(), kind, terminal->SummaryJson().View());
	}

	Core::String Terminals::ListJson(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("terminals"));
		json.BeginArray();
		for (Terminal* terminal : terminals)
			if (terminal->ws == ws) json.Raw(terminal->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String Terminals::Snapshot(Terminal* terminal) {
		JsonWriter json;
		json.BeginObject();
		json.RawField("terminal", terminal->SummaryJson().View());
		json.IntField("cols", terminal->cols);
		json.IntField("rows", terminal->rows);
		json.Field("scrollback", terminal->scrollback.View());
		json.EndObject();
		return json.ToString();
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	static int32 Clamped(int64 value, int32 fallback, int32 most) {
		if (value <= 0) return fallback;
		return value > most ? most : (int32)value;
	}

	Core::String Terminals::CreateMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		FS::Path cwd = ws->root;
		Core::String within = params.Str("cwd", Core::StringView(""));
		if (!within.IsEmpty()) {
			cwd = ws->At(NormalizePath(within.View()).View());
			if (!FS::IsDirectory(cwd.CStr())) throw RpcError(ErrorCode::NotFound, (Core::String("no folder ") + within.View()).View());
		}
		Core::Array<Core::String> argv;
		Serialization::DomNode given = params.Field("argv");
		for (int64 i = 0; given.Kind() == Serialization::DomKind::Array && i < given.Count(); ++i) argv.Push(Core::String(given.At(i).AsView()));
		const int32 cols = Clamped(params.Int("cols", 0), kTerminalDefaultColumns, kTerminalMostColumns);
		const int32 rows = Clamped(params.Int("rows", 0), kTerminalDefaultRows, kTerminalMostRows);
		Terminal* terminal = Create(ws, argv, cwd, params.Str("title", Core::StringView("")).View(), Core::StringView("shell"), call.ClientId(), cols, rows);
		return terminal->SummaryJson();
	}

	Core::String Terminals::ListMethod(Call& call, const Params& params) {
		return ListJson(server->workspaces->Get(params.Str("wsId").View()));
	}

	Core::String Terminals::InputMethod(Call& call, const Params& params) {
		Terminal* terminal = Find(params.Str("termId").View());
		if (terminal->holder.View() != call.ClientId()) {
			JsonWriter data;
			data.BeginObject();
			data.Field("reason", "lease");
			data.Field("holder", terminal->holder.View());
			data.EndObject();
			throw RpcError(ErrorCode::Forbidden, "another window is typing in this terminal", data.View());
		}
		if (!terminal->alive) throw RpcError(ErrorCode::Conflict, "the terminal's program has exited");
		terminal->input->Push(params.Str("data").View());
		return Core::String("{}");
	}

	Core::String Terminals::TakeLeaseMethod(Call& call, const Params& params) {
		Terminal* terminal = Find(params.Str("termId").View());
		terminal->holder = Core::String(call.ClientId());
		JsonWriter json;
		json.BeginObject();
		json.Field("holder", terminal->holder.View());
		json.EndObject();
		server->hub.Publish(terminal->Topic().View(), "lease", json.View());
		Changed(terminal, "term.changed");
		return json.ToString();
	}

	Core::String Terminals::ResizeMethod(Call& call, const Params& params) {
		Terminal* terminal = Find(params.Str("termId").View());
		if (terminal->holder.View() != call.ClientId() || !terminal->alive) return Core::String("{}");
		const int32 cols = Clamped(params.Int("cols"), terminal->cols, kTerminalMostColumns);
		const int32 rows = Clamped(params.Int("rows"), terminal->rows, kTerminalMostRows);
		if (cols == terminal->cols && rows == terminal->rows) return Core::String("{}");
		terminal->cols = cols;
		terminal->rows = rows;
		terminal->child->Resize(cols, rows);
		JsonWriter json;
		json.BeginObject();
		json.IntField("cols", cols);
		json.IntField("rows", rows);
		json.EndObject();
		server->hub.Publish(terminal->Topic().View(), "resize", json.View());
		return Core::String("{}");
	}

	Core::String Terminals::RenameMethod(Call& call, const Params& params) {
		Terminal* terminal = Find(params.Str("termId").View());
		Core::String title = params.Str("title");
		if (title.View().Trimmed().IsEmpty()) throw RpcError(ErrorCode::BadRequest, "a terminal needs a title");
		terminal->title = Core::String(title.View().Trimmed());
		Changed(terminal, "term.changed");
		return terminal->SummaryJson();
	}

	Core::String Terminals::CloseMethod(Call& call, const Params& params) {
		Terminal* terminal = Find(params.Str("termId").View());
		terminal->alive = false;
		terminal->input->Close();
		terminal->child->Kill();
		for (int64 i = 0; i < terminals.Count(); ++i)
			if (terminals[i] == terminal) {
				terminals.RemoveAt(i);
				break;
			}
		Changed(terminal, "term.removed");
		server->hub.Remove(terminal->Topic().View());
		return Core::String("{}");
	}
}
