include "Blobs.ch"

namespace Ied
{
	Core::String Blobs::Put(Core::StringView contentType, const Core::Array<uint8>& bytes) {
		uint8[8] random;
		Platform::RandomBytes((void*)&random[0], 8);
		Core::StringBuilder id;
		id.Append("b-");
		for (int32 i = 0; i < 8; ++i) id.AppendUIntBase((uint64)random[i], 16, 2);
		Blob* blob = new Blob();
		blob->m_ContentType = Core::String(contentType);
		blob->m_Bytes = bytes;
		Threading::LockGuard guard(m_Mutex);
		while (!m_Order.IsEmpty() && m_KeptBytes + bytes.Count() > m_LimitBytes) DropOldest();
		m_Items.Insert(id.ToString(), blob);
		m_Order.Push(id.ToString());
		m_KeptBytes += bytes.Count();
		return id.ToString();
	}

	Blob* Blobs::Get(Core::StringView id) {
		Threading::LockGuard guard(m_Mutex);
		Blob* blob = nullptr;
		m_Items.TryGet(Core::String(id), blob);
		return blob;
	}

	int64 Blobs::KeptBytes() {
		Threading::LockGuard guard(m_Mutex);
		return m_KeptBytes;
	}

	// With the mutex held.
	void Blobs::DropOldest() {
		Blob* blob = nullptr;
		if (m_Items.TryGet(m_Order[0], blob)) m_KeptBytes -= blob->m_Bytes.Count();
		m_Items.Remove(m_Order[0]);
		m_Order.RemoveAt(0);
	}
}
