include "skilltools.ch"
include "ai/contributed.ch"
include "host/server.ch"

namespace Ied
{
	static Core::Array<Skill*> WorkspaceSkills(const ToolInvocation& call) {
		Threading::LockGuard guard(call.server->lock);
		Core::Array<Core::String> problems;
		return SkillsOf(call.server, call.ws, problems);
	}

	static ToolPlan SkillPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.subject = (Core::String("skill(") + (call.args.Member("name").IsValid() ? call.args.Member("name").AsView() : call.args.Member("query").AsView())) + ")";
		return plan;
	}

	static ToolOutcome SearchRun(const ToolInvocation& call) {
		Core::Array<Skill*> found = SearchSkills(WorkspaceSkills(call), call.args.Member("query").AsView(), kSkillSearchMost);
		Core::StringBuilder out;
		for (Skill* skill : found) {
			out.Append(skill->name.View());
			out.Append(" (");
			out.Append(skill->source.View());
			out.Append("): ");
			out.Append(skill->description.View());
			out.Append("\n");
		}
		if (found.IsEmpty()) out.Append("[no skill matches; try other words]\n");
		Core::StringBuilder preview;
		preview.AppendInt(found.Count());
		preview.Append(found.Count() == 1 ? " skill" : " skills");
		return ToolResult(out.View(), preview.View());
	}

	// The file `relative` of a skill's folder; empty when it leaves the folder.
	static FS::Path SkillFile(const Skill* skill, Core::StringView relative) {
		if (relative.Contains(Core::StringView("..")) || relative.StartsWith(Core::StringView("/")) || relative.IndexOf(':', 0) >= 0) return FS::Path();
		return skill->file.Parent() / relative;
	}

	static ToolOutcome ReadRun(const ToolInvocation& call) {
		Core::Array<Skill*> skills = WorkspaceSkills(call);
		Skill* skill = SkillNamed(skills, call.args.Member("name").AsView());
		if (!skill) {
			Core::StringBuilder names;
			for (Skill* each : skills) {
				if (names.ByteLength() > 0) names.Append(", ");
				names.Append(each->name.View());
			}
			return ToolError(((Core::String("skill_read: there is no skill ") + call.args.Member("name").AsView()) + "; the skills are: " + names.View()).View());
		}
		Core::StringView relative = call.args.Member("file").AsView();
		if (relative.IsEmpty() || relative == "SKILL.md") return ToolResult(SkillBody(skill).View(), skill->description.View());
		FS::Path file = SkillFile(skill, relative);
		if (file.IsEmpty() || !FS::FileExists(file.CStr())) return ToolError(((Core::String("skill_read: the skill ") + skill->name.View()) + " has no file " + relative).View());
		FS::File opened = FS::File(file.CStr(), "rb");
		Core::String text = opened.ReadText();
		return ToolResult(text.View().ByteLength() <= kSkillReadMostBytes ? text.View() : text.View().Substring(0, kSkillReadMostBytes), relative);
	}

	static ToolSpec* SkillSpec(const char* name, const char* description, const char* parameters) {
		ToolSpec* spec = new ToolSpec();
		spec->name = Core::String(name);
		spec->description = Core::String(description);
		spec->parameters = Core::String(parameters);
		spec->toolClass = ToolClass::Read;
		spec->parallelSafe = true;
		spec->inPlan = true;
		spec->plan = SkillPlan;
		return spec;
	}

	void AddSkillTools(ToolRegistry& registry) {
		ToolSpec* search = SkillSpec("skill_search", "Find skills (how-to guides for this workspace's languages, tools and conventions) by words; returns name (source): description. Example: skill_search({\"query\": \"write a unit test\"})",
			"{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"minLength\": 1}}, \"required\": [\"query\"], \"additionalProperties\": false}");
		search->run = SearchRun;
		registry.Add(search);
		ToolSpec* read = SkillSpec("skill_read", "Read a skill's guide (its SKILL.md), or another file of its folder that the guide names. Example: skill_read({\"name\": \"nuke\"})",
			"{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"minLength\": 1}, \"file\": {\"type\": \"string\", \"description\": \"a file of the skill's folder, relative to it\"}}, \"required\": [\"name\"], \"additionalProperties\": false}");
		read->run = ReadRun;
		registry.Add(read);
	}
}
