include "post.ch"

namespace Ied
{
	const int64 kPostReadBytes = 65536;
	const int64 kPostMostHeadBytes = 65536;
	const int64 kPostMostBodyBytes = 256 * 1024 * 1024;

	bool StreamingPost::Send(Core::StringView url, const Core::Array<Core::String>& headers, Core::StringView body, int32 connectMs, Core::String& error) {
		const Http::Url parsed = Http::ParseUrl(url);
		if (!parsed.valid || parsed.webSocket) {
			error = Core::String("not an http://host[:port]/path URL: ") + url;
			return false;
		}
		const Net::Resolution found = Net::Resolve(parsed.host.CStr(), parsed.port);
		if (!found.Found()) {
			error = found.error;
			return false;
		}
		stream = Net::TcpStream::Connect(found.addresses[0], connectMs);
		if (!stream.IsOpen()) {
			error = Core::String(stream.Error());
			return false;
		}
		Core::StringBuilder request;
		request.Append("POST ");
		request.Append(parsed.target.View());
		request.Append(" HTTP/1.1\r\nHost: ");
		request.Append(Http::HostHeader(parsed).View());
		request.Append("\r\nContent-Type: application/json\r\nAccept: text/event-stream\r\nConnection: close\r\nContent-Length: ");
		request.AppendInt(body.ByteLength());
		request.Append("\r\n");
		for (const Core::String& header : headers) {
			request.Append(header.View());
			request.Append("\r\n");
		}
		request.Append("\r\n");
		request.Append(body);
		if (!stream.SendText(request.View(), connectMs)) {
			error = Core::String(stream.Error());
			return false;
		}
		return true;
	}

	PostRead StreamingPost::Receive(int32 waitMs) {
		if (closed) return PostRead::Ended;
		char[kPostReadBytes] buffer;
		const int64 got = stream.Receive((void*)&buffer[0], kPostReadBytes, waitMs);
		if (got > 0) {
			raw.Append(Core::StringView(&buffer[0], got));
			return PostRead::Bytes;
		}
		if (got == 0) {
			closed = true;
			return PostRead::Ended;
		}
		if (stream.TimedOut()) return PostRead::Waiting;
		error = Core::String(stream.Error());
		return PostRead::Failed;
	}

	PostRead StreamingPost::ReadHead(int32 waitMs) {
		for (;;) {
			const Http::HeadParse parse = Http::ParseResponseHead(raw.View(), kPostMostHeadBytes, head);
			if (parse.status == Http::ParseStatus::Complete && head.status >= 200) {
				raw = Core::String(raw.View().Substring(parse.length, raw.ByteLength() - parse.length));
				framing = Http::ResponseFraming(head.headers, head.status, Core::StringView("POST"));
				headIn = true;
				return PostRead::Bytes;
			}
			if (parse.status == Http::ParseStatus::Complete) {
				raw = Core::String(raw.View().Substring(parse.length, raw.ByteLength() - parse.length));
				continue;
			}
			if (parse.status != Http::ParseStatus::Incomplete) {
				error = parse.error;
				return PostRead::Failed;
			}
			const PostRead got = Receive(waitMs);
			if (got == PostRead::Ended) {
				error = Core::String("the connection ended before the response head");
				return PostRead::Failed;
			}
			if (got != PostRead::Bytes) return got;
		}
	}

	// What `raw` holds of the body, decoded as its framing says.
	PostRead StreamingPost::Decode(Core::String& out) {
		if (framing.kind == Http::BodyKind::Chunked) {
			Core::Array<uint8> body;
			const Http::ChunkedStep step = chunks.Feed(raw.View(), kPostMostBodyBytes, body);
			raw = Core::String(raw.View().Substring(step.consumed, raw.ByteLength() - step.consumed));
			out.Append(Core::StringView((const char*)body.Data(), body.Count()));
			if (step.status == Http::ParseStatus::Complete) return PostRead::Ended;
			if (step.status != Http::ParseStatus::Incomplete) {
				error = step.error;
				return PostRead::Failed;
			}
			return body.Count() > 0 ? PostRead::Bytes : PostRead::Waiting;
		}
		const int64 had = raw.ByteLength();
		out.Append(raw.View());
		bodyRead += had;
		raw = Core::String();
		if (framing.kind == Http::BodyKind::Length && bodyRead >= framing.length) return PostRead::Ended;
		if (framing.kind == Http::BodyKind::None) return PostRead::Ended;
		return had > 0 ? PostRead::Bytes : PostRead::Waiting;
	}

	PostRead StreamingPost::Read(Core::String& out, int32 waitMs) {
		if (!headIn) {
			error = Core::String("the response head is not in");
			return PostRead::Failed;
		}
		if (!raw.IsEmpty()) {
			const PostRead decoded = Decode(out);
			if (decoded != PostRead::Waiting) return decoded;
		}
		const PostRead got = Receive(waitMs);
		if (got == PostRead::Ended) {
			const PostRead last = Decode(out);
			if (framing.kind == Http::BodyKind::Chunked && last != PostRead::Ended) {
				error = Core::String("the connection ended inside a chunked body");
				return PostRead::Failed;
			}
			return PostRead::Ended;
		}
		if (got != PostRead::Bytes) return got;
		return Decode(out);
	}
}
