include "service.ch"
include "host/server.ch"
include "plugins/when.ch"
include "fs/glob.ch"

namespace Ied
{
	void Tasks::Init(Server* server) {
		this.server = server;
		Tasks* self = this;
		server->rpc.Register("task.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->rpc.Register("task.select", [self](Call& call, const Params& params) -> Core::String { return self->SelectMethod(call, params); });
		server->rpc.Register("task.setStartup", [self](Call& call, const Params& params) -> Core::String { return self->SetStartupMethod(call, params); });
		server->rpc.Register("task.run", [self](Call& call, const Params& params) -> Core::String { return self->RunMethod(call, params); });
		server->rpc.Register("task.cancel", [self](Call& call, const Params& params) -> Core::String { return self->CancelMethod(call, params); });
		server->rpc.Register("task.runs", [self](Call& call, const Params& params) -> Core::String { return self->RunsMethod(call, params); });
	}

	void Tasks::WorkspaceOpened(Workspace* ws) {
		Tasks* self = this;
		server->hub.Add(TasksTopic(ws).View(), [self, ws]() -> Core::String { return self->Snapshot(ws); });
	}

	void Tasks::ProjectsChanged(Workspace* ws) { server->hub.Publish(TasksTopic(ws).View(), "tasks.changed", Snapshot(ws).View()); }

	// --- Projects and what they offer --------------------------------------------------------------------------------

	Core::Array<TaskProject*> Tasks::ProjectsOf(Workspace* ws) const {
		Core::Array<TaskProject*> projects;
		if (!ws->solution) {
			TaskProject* folder = new TaskProject();
			folder->name = ws->name;
			folder->root = ws->root;
			folder->kind = Core::String("other");
			folder->origin = ws->name;
			projects.Push(folder);
			return projects;
		}
		for (ProjectModel* model : ws->solution->projects) {
			TaskProject* project = new TaskProject();
			project->name = model->name;
			project->root = model->root;
			project->kind = model->kind;
			project->data = model->data;
			project->origin = Core::String(model->file.FileName());
			projects.Push(project);
		}
		return projects;
	}

	TaskProject* Tasks::ProjectNamed(Workspace* ws, Core::StringView name) const {
		for (TaskProject* project : ProjectsOf(ws))
			if (project->name.View() == name) return project;
		return nullptr;
	}

	Core::String Tasks::StartupProject(Workspace* ws) {
		Core::Array<TaskProject*> projects = ProjectsOf(ws);
		TaskSelections* chosen = SelectionsOf(ws);
		for (TaskProject* project : projects)
			if (project->name.View() == chosen->startupProject.View()) return project->name;
		for (TaskProject* project : projects)
			if (project->kind == "executable") return project->name;
		return projects.IsEmpty() ? Core::String() : projects[0]->name;
	}

	// A preset's `detect`: a file or folder in the project's root, or a glob over its entries.
	static bool Detected(const FS::Path& root, Core::StringView detect) {
		if (detect.IndexOf('*', 0) < 0 && detect.IndexOf('?', 0) < 0) {
			FS::Path path = root / detect;
			return FS::FileExists(path.CStr()) || FS::IsDirectory(path.CStr());
		}
		if (!FS::IsDirectory(root.CStr())) return false;
		for (FS::DirectoryEntry& entry : FS::Directory(root.CStr()))
			if (GlobMatch(detect, entry.name.View())) return true;
		return false;
	}

	void Tasks::ReadPresets(Workspace* ws, const TaskProject* project, OfferedTasks& into) {
		Core::Array<Serialization::DomNode> presets;
		for (const Contribution& given : server->plugins->Entries(ws, Core::StringView("taskPresets"))) presets.Push(given.entry);
		Core::Array<Core::String> ids;
		Serialization::DomNode named = project->data.Member("presets");
		for (int64 i = 0; i < named.Count(); ++i) ids.Push(Core::String(named.At(i).AsView()));
		if (ids.IsEmpty())
			for (const Serialization::DomNode& preset : presets)
				if (!preset.Member("detect").AsView().IsEmpty() && Detected(project->root, preset.Member("detect").AsView())) ids.Push(Core::String(preset.Member("id").AsView()));
		for (const Core::String& id : ids) {
			Core::Array<Core::String> chain;
			ReadPreset(presets, id.View(), chain, into);
		}
	}

	// The preset `id` into `into`, after the preset it extends (and that one's base before it); `chain` holds the ids
	// being read, so a preset that extends itself is a problem instead of a loop.
	static void ReadPreset(const Core::Array<Serialization::DomNode>& presets, Core::StringView id, Core::Array<Core::String>& chain, OfferedTasks& into) {
		int64 found = -1;
		for (int64 i = 0; i < presets.Count(); ++i)
			if (presets[i].Member("id").AsView() == id) found = i;
		if (found < 0) {
			into.problems.Push((Core::String("no plugin offers the task preset ") + id));
			return;
		}
		for (const Core::String& reading : chain)
			if (reading.View() == id) {
				into.problems.Push(((Core::String("the task preset ") + id) + " extends itself"));
				return;
			}
		chain.Push(Core::String(id));
		Core::StringView base = presets[found].Member("extends").AsView();
		if (!base.IsEmpty()) ReadPreset(presets, base, chain, into);
		ReadTaskEntries(presets[found], (Core::String("the preset ") + id).View(), into);
	}

	OfferedTasks* Tasks::Offered(Workspace* ws, const TaskProject* project) {
		OfferedTasks* offered = new OfferedTasks();
		ReadPresets(ws, project, *offered);
		if (project->data.Kind() == Serialization::DomKind::Object) ReadTaskEntries(project->data, project->origin.View(), *offered);
		ApplyDefaultMatchers(*offered);
		return offered;
	}

	// --- Selections --------------------------------------------------------------------------------------------------

	static FS::Path SelectionsFile(const Workspace* ws) { return ws->localState / "selections.json"; }

	TaskSelections* Tasks::SelectionsOf(Workspace* ws) {
		TaskSelections* chosen = nullptr;
		if (selections.TryGet(ws->wsId, chosen)) return chosen;
		chosen = new TaskSelections();
		*chosen = ReadTaskSelections(SelectionsFile(ws));
		selections.Insert(ws->wsId, chosen);
		return chosen;
	}

	void Tasks::SaveSelections(Workspace* ws) {
		if (!WriteTaskSelections(SelectionsFile(ws), *SelectionsOf(ws))) server->Log((Core::String("the task selections could not be written: ") + SelectionsFile(ws).View()).View());
	}

	Core::String Tasks::ValueOf(Workspace* ws, const TaskProject* project, const TaskVariable* variable) {
		Core::String value;
		if (SelectionsOf(ws)->Value(project->name.View(), variable->key.View(), variable->solutionScope, value)) return value;
		if (!variable->defaultValue.IsEmpty()) return variable->defaultValue;
		if (!variable->values.IsEmpty()) return variable->values[0];
		return Core::String(variable->kind == "toggle" ? "false" : "");
	}

	// --- Lists -------------------------------------------------------------------------------------------------------

	static void WriteStrings(JsonWriter& json, const char* key, const Core::Array<Core::String>& strings) {
		json.Key(Core::StringView(key));
		json.BeginArray();
		for (const Core::String& text : strings) json.String(text.View());
		json.EndArray();
	}

	// {default, configurations: [name]}: what F5 and the toolbar's Start Debugging start (docs/25).
	static void WriteDebug(JsonWriter& json, const OfferedTasks* offered) {
		Core::Array<Core::String> names;
		for (DebugConfig* config : offered->debugConfigs) names.Push(config->name);
		DebugConfig* chosen = offered->Debug(Core::StringView(""));
		json.Key(Core::StringView("debug"));
		json.BeginObject();
		json.Field("default", chosen ? chosen->name.View() : Core::StringView(""));
		WriteStrings(json, "configurations", names);
		json.EndObject();
	}

	Core::String Tasks::ListJson(Workspace* ws, Core::StringView projectName) {
		Core::String startup = StartupProject(ws);
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? startup.View() : projectName);
		if (!project && !projectName.IsEmpty()) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + projectName).View());
		OfferedTasks* offered = project ? Offered(ws, project) : new OfferedTasks();
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("project"));
		if (project) json.String(project->name.View());
		else json.Null();
		json.Field("startupProject", startup.View());
		Core::Array<Core::String> names;
		for (TaskProject* each : ProjectsOf(ws)) names.Push(each->name);
		WriteStrings(json, "projects", names);
		json.Key(Core::StringView("variables"));
		json.BeginArray();
		for (TaskVariable* variable : offered->variables) {
			json.BeginObject();
			json.Field("key", variable->key.View());
			json.Field("kind", variable->kind.View());
			json.Field("label", variable->label.View());
			WriteStrings(json, "values", variable->values);
			json.Field("value", ValueOf(ws, project, variable).View());
			json.Field("scope", variable->solutionScope ? "solution" : "project");
			json.EndObject();
		}
		json.EndArray();
		json.Key(Core::StringView("tasks"));
		json.BeginArray();
		for (TaskDef* task : offered->tasks) {
			json.BeginObject();
			json.Field("key", task->key.View());
			json.Field("label", task->label.View());
			json.Field("icon", task->icon.View());
			json.Field("tooltip", task->tooltip.View());
			json.Field("slot", task->slot.View());
			json.EndObject();
		}
		json.EndArray();
		WriteStrings(json, "toolbar", offered->toolbar);
		WriteDebug(json, offered);
		WriteStrings(json, "problems", offered->problems);
		json.EndObject();
		return json.ToString();
	}

	Core::String Tasks::Snapshot(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.RawField("offer", ListJson(ws, Core::StringView("")).View());
		json.Key(Core::StringView("runs"));
		json.BeginArray();
		for (TaskRun* run : runs)
			if (run->ws == ws && run->IsActive()) json.Raw(run->SummaryJson().View());
		json.EndArray();
		TaskRun* ended = LastEnded(ws);
		const Core::String endedJson = ended ? ended->SummaryJson() : Core::String("null");
		json.RawField("ended", endedJson.View());
		json.EndObject();
		return json.ToString();
	}

	// The run of `ws` that ended last, so a window that comes back shows how it ended; null before any.
	TaskRun* Tasks::LastEnded(Workspace* ws) {
		TaskRun* last = nullptr;
		for (TaskRun* run : runs)
			if (run->ws == ws && !run->IsActive() && (!last || run->endedMs >= last->endedMs)) last = run;
		return last;
	}

	// --- Planning ----------------------------------------------------------------------------------------------------

	ProblemMatcher* Tasks::MatcherNamed(Workspace* ws, Core::StringView id) {
		Serialization::DomNode found;
		bool any = false;
		for (const Contribution& given : server->plugins->Entries(ws, Core::StringView("problemMatchers")))
			if (given.entry.Member("id").AsView() == id) {
				found = given.entry;
				any = true;
			}
		if (!any) throw RpcError(ErrorCode::BadRequest, (Core::String("no plugin offers the problem matcher ") + id).View());
		Core::String problem;
		ProblemMatcher* matcher = ReadProblemMatcher(found, problem);
		if (!matcher) throw RpcError(ErrorCode::BadRequest, problem.View());
		return matcher;
	}

	static Core::String Expanded(Core::StringView text, const TaskLookup& lookup, Core::StringView task) {
		Core::String out;
		Core::String unknown;
		if (!ExpandTaskText(text, lookup, out, unknown)) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task) + " uses ${") + unknown.View() + "}, which no variable defines").View());
		return out;
	}

	static bool StepWhen(Core::StringView when, const TaskLookup& lookup, Core::StringView task) {
		if (when.IsEmpty()) return true;
		WhenLookup values = [lookup](Core::StringView key) -> WhenValue {
			Core::String value;
			return lookup(key, value) ? WhenText(value.View()) : WhenNone();
		};
		Core::String error;
		const bool holds = WhenHolds(when, values, error);
		if (!error.IsEmpty()) throw RpcError(ErrorCode::BadRequest, (((Core::String("a step of the task ") + task) + " has a when that does not parse: ") + error.View()).View());
		return holds;
	}

	static const char* OutputFor(const TaskDef* task) {
		if (task->slot == "run") return "run";
		if (task->slot == "test" || task->slot == "testSelected") return "test";
		if (task->slot == "debug" || task->slot == "debugTest") return "debug";
		return "build";
	}

	// The step's matchers' roots (`${cwd}`, `${projectRoot}/src`...), absolute.
	static void PlanMatchRoots(PlannedStep* planned, const TaskLookup& lookup, Core::StringView task) {
		const Core::String cwd = planned->cwd;
		TaskLookup inStep = [lookup, cwd](Core::StringView name, Core::String& value) -> bool {
			if (name == "cwd") {
				value = cwd;
				return true;
			}
			return lookup(name, value);
		};
		for (ProblemMatcher* matcher : planned->matchers) {
			for (const Core::String& root : matcher->roots) {
				FS::Path path = FS::Path(Expanded(root.View(), inStep, task).View());
				planned->matchRoots.Push(Core::String((path.IsAbsolute() ? path : FS::Path(cwd.View()) / path.View()).Normalized().View()));
			}
		}
	}

	void Tasks::PlanSteps(TaskRun* run, const TaskDef* task, const OfferedTasks* offered, const TaskLookup& lookup, Core::Array<Core::String>& nesting, OnlyIf entry) {
		bool first = true;
		for (TaskStep* step : task->steps) {
			if (!StepWhen(step->when.View(), lookup, task->key.View())) continue;
			const OnlyIf onlyIf = first && step->onlyIf == OnlyIf::PrevSuccess ? entry : step->onlyIf;
			first = false;
			if (step->kind == StepKind::Task) {
				for (const Core::String& outer : nesting)
					if (outer.View() == step->name.View()) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task->key.View()) + " runs ") + step->name.View() + ", which runs it").View());
				TaskDef* nested = offered->Task(step->name.View());
				if (!nested) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task->key.View()) + " runs ") + step->name.View() + ", which does not exist").View());
				if (nesting.Count() >= kTaskNestingDepth) throw RpcError(ErrorCode::BadRequest, "tasks run each other too deep");
				nesting.Push(nested->key);
				PlanSteps(run, nested, offered, lookup, nesting, onlyIf);
				nesting.Pop();
				continue;
			}
			PlannedStep* planned = new PlannedStep();
			planned->kind = step->kind;
			for (const Core::String& arg : step->argv) planned->argv.Push(Expanded(arg.View(), lookup, task->key.View()));
			if (!step->shell.IsEmpty()) planned->shell = Expanded(step->shell.View(), lookup, task->key.View());
			if (step->kind == StepKind::Run && planned->argv.IsEmpty() && planned->shell.IsEmpty()) throw RpcError(ErrorCode::BadRequest, ((Core::String("a step of the task ") + task->key.View()) + " has nothing to run").View());
			planned->label = !step->label.IsEmpty() ? Expanded(step->label.View(), lookup, task->key.View()) : !planned->shell.IsEmpty() ? planned->shell : planned->argv.IsEmpty() ? step->name : planned->argv[0];
			FS::Path cwd = FS::Path(Expanded(step->cwd.IsEmpty() ? Core::StringView("${projectRoot}") : step->cwd.View(), lookup, task->key.View()).View());
			planned->cwd = Core::String((cwd.IsAbsolute() ? cwd : FS::Path(run->searchRoots[0].View()) / cwd.View()).Normalized().View());
			for (const Core::String& entry : step->env) planned->env.Push(Expanded(entry.View(), lookup, task->key.View()));
			planned->output = step->output.IsEmpty() ? Core::String(OutputFor(task)) : step->output;
			for (const Core::String& id : step->matchers) planned->matchers.Push(MatcherNamed(run->ws, id.View()));
			PlanMatchRoots(planned, lookup, task->key.View());
			planned->onlyIf = onlyIf;
			planned->timeoutSeconds = step->timeoutSeconds;
			planned->status = Core::String("pending");
			run->steps.Push(planned);
		}
	}

	TaskRun* Tasks::Plan(Workspace* ws, const TaskProject* project, const OfferedTasks* offered, const TaskDef* task, const Serialization::DomNode& context) {
		TaskRun* run = new TaskRun();
		started += 1;
		Core::StringBuilder id;
		id.Append("t");
		id.AppendInt(started);
		run->runId = id.ToString();
		run->ws = ws;
		run->project = project->name;
		run->task = task->key;
		run->label = task->label;
		run->concurrency = task->concurrency;
		run->saveFirst = task->saveAll;
		run->status = RunStatus::Queued;
		run->searchRoots.Push(Core::String(project->root.View()));
		run->searchRoots.Push(Core::String(ws->root.View()));
		TaskLookup lookup = LookupFor(ws, project, offered, context);
		Core::Array<Core::String> nesting;
		nesting.Push(task->key);
		PlanSteps(run, task, offered, lookup, nesting, OnlyIf::PrevSuccess);
		return run;
	}

	TaskLookup Tasks::LookupFor(Workspace* ws, const TaskProject* project, const OfferedTasks* offered, const Serialization::DomNode& context) {
		Core::HashMap<Core::String, Core::String>* values = new Core::HashMap<Core::String, Core::String>();
		values->Insert(Core::String("solutionDir"), Core::String(ws->root.View()));
		values->Insert(Core::String("workspaceDir"), Core::String(ws->root.View()));
		values->Insert(Core::String("projectRoot"), Core::String(project->root.View()));
		values->Insert(Core::String("projectDir"), Core::String(project->root.View()));
		values->Insert(Core::String("project"), project->name);
		values->Insert(Core::String("projectName"), project->name);
		values->Insert(Core::String("startupProject"), StartupProject(ws));
		for (TaskVariable* variable : offered->variables) values->Insert(variable->key, ValueOf(ws, project, variable));
		Serialization::DomNode buildSystem = project->data.Member("buildSystem");
		for (int64 i = 0; buildSystem.Kind() == Serialization::DomKind::Object && i < buildSystem.Count(); ++i) values->Insert(Core::String("buildSystem.") + buildSystem.KeyAt(i), Core::String(buildSystem.ValueAt(i).AsView()));
		values->Insert(Core::String("file"), Core::String(context.Member("file").AsView()));
		values->Insert(Core::String("line"), Core::String(context.Member("line").AsView()));
		values->Insert(Core::String("selection"), Core::String(context.Member("selection").AsView()));
		values->Insert(Core::String("testFilter"), Core::String(context.Member("testFilter").AsView()));
		Settings* settings = server->settings;
		Core::HashMap<Core::String, Core::String>* offered = nullptr;
		offeredVariables.TryGet(ws->wsId, offered);
		TaskLookup lookup = [values, offered, settings, ws](Core::StringView name, Core::String& value) -> bool {
			if (values->TryGet(Core::String(name), value)) return true;
			if (offered && offered->TryGet(Core::String(name), value)) return true;
			if (name.StartsWith(Core::StringView("env:"))) {
				Core::String variable = Core::String(name.Substring(4, name.ByteLength() - 4));
				if (!Platform::TryGetEnvironmentVariable(variable.CStr(), value)) value = Core::String();
				return true;
			}
			if (name.StartsWith(Core::StringView("config:"))) {
				Serialization::DomDoc* doc = new Serialization::DomDoc();
				Core::String json = settings->Effective(ws, Core::StringView(""), name.Substring(7, name.ByteLength() - 7));
				Serialization::DomNode setting = json.IsEmpty() ? Serialization::DomNode() : Serialization::ReadJson(json.View(), *doc).root;
				value = setting.Kind() == Serialization::DomKind::String ? Core::String(setting.AsView()) : Core::String(json.View().Trimmed());
				return true;
			}
			return false;
		};
		Core::StringView output = buildSystem.Member("output").AsView();
		Core::String program;
		Core::String unknown;
		if (!output.IsEmpty() && ExpandTaskText(output, lookup, program, unknown)) values->Insert(Core::String("projectOutput"), program);
		return lookup;
	}

	void Tasks::SetVariable(Core::StringView wsId, Core::StringView name, Core::StringView value) {
		Core::HashMap<Core::String, Core::String>* variables = nullptr;
		if (!offeredVariables.TryGet(Core::String(wsId), variables)) {
			variables = new Core::HashMap<Core::String, Core::String>();
			offeredVariables.Insert(Core::String(wsId), variables);
		}
		variables->Remove(Core::String(name));
		if (!value.IsEmpty()) variables->Insert(Core::String(name), Core::String(value));
	}

	// --- Debug configurations ----------------------------------------------------------------------------------------

	// `node` as JSON with every string expanded.
	static void WriteExpanded(JsonWriter& json, const Serialization::DomNode& node, const TaskLookup& lookup, Core::StringView config) {
		if (node.Kind() == Serialization::DomKind::String) json.String(Expanded(node.AsView(), lookup, config).View());
		else if (node.Kind() == Serialization::DomKind::Array) {
			json.BeginArray();
			for (int64 i = 0; i < node.Count(); ++i) WriteExpanded(json, node.At(i), lookup, config);
			json.EndArray();
		}
		else if (node.Kind() == Serialization::DomKind::Object) {
			json.BeginObject();
			for (int64 i = 0; i < node.Count(); ++i) {
				json.Key(node.KeyAt(i));
				WriteExpanded(json, node.ValueAt(i), lookup, config);
			}
			json.EndObject();
		}
		else json.Raw(NodeJson(node).View());
	}

	DebugLaunch Tasks::ResolveDebug(Workspace* ws, Core::StringView projectName, Core::StringView name) {
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? StartupProject(ws).View() : projectName);
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project to debug: ") + projectName).View());
		OfferedTasks* offered = Offered(ws, project);
		DebugConfig* config = offered->Debug(name);
		if (!config) throw RpcError(ErrorCode::NotFound, (name.IsEmpty() ? ((Core::String("the project ") + project->name.View()) + " has no debug configuration") : (Core::String("no debug configuration ") + name)).View());
		TaskLookup lookup = LookupFor(ws, project, offered, Serialization::DomNode());
		JsonWriter json;
		WriteExpanded(json, config->node, lookup, config->name.View());
		DebugLaunch launch;
		launch.project = project->name;
		launch.name = config->name;
		launch.type = Core::String(config->node.Member("type").AsView());
		launch.request = Core::String(config->node.Member("request").AsView());
		launch.preLaunchTask = Expanded(config->node.Member("preLaunchTask").AsView(), lookup, config->name.View());
		launch.arguments = json.ToString();
		return launch;
	}

	// --- Running -----------------------------------------------------------------------------------------------------

	void Tasks::Start(TaskRun* run) {
		runs.Push(run);
		while (runs.Count() > kTaskRunsKept) {
			int64 oldest = -1;
			for (int64 i = 0; i < runs.Count() && oldest < 0; ++i)
				if (!runs[i]->IsActive()) oldest = i;
			if (oldest < 0) break;
			runs.RemoveAt(oldest);
		}
		TaskRun* shown = run;
		server->hub.Add(run->Topic().View(), [shown]() -> Core::String { return shown->SnapshotJson(); });
		server->hub.Publish(TasksTopic(run->ws).View(), "run.started", run->SummaryJson().View());
		Server* host = server;
		Threading::ConditionVariable* signal = &ended;
		Threading::Thread::Run([host, run, signal]() { ExecuteRun(host, run, signal); }).Detach();
	}

	static void CancelRun(TaskRun* run, Threading::ConditionVariable& ended) {
		if (!run->IsActive()) return;
		run->cancelled = true;
		if (run->child) run->child->Kill();
		ended.NotifyAll();
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	Core::String Tasks::ListMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		return ListJson(ws, params.Str("project", Core::StringView("")).View());
	}

	Core::String Tasks::SelectMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		Core::String named = params.Str("project", Core::StringView(""));
		TaskProject* project = ProjectNamed(ws, named.IsEmpty() ? StartupProject(ws).View() : named.View());
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + named.View()).View());
		Core::String key = params.Str("key");
		Core::String value = params.Str("value");
		TaskVariable* variable = Offered(ws, project)->Variable(key.View());
		if (!variable) throw RpcError(ErrorCode::NotFound, (Core::String("no variable ") + key.View()).View());
		bool offeredValue = variable->kind != "dropdown" || variable->values.IsEmpty();
		for (const Core::String& each : variable->values) offeredValue = offeredValue || each.View() == value.View();
		if (variable->kind == "toggle") offeredValue = value == "true" || value == "false";
		if (!offeredValue) throw RpcError(ErrorCode::BadRequest, (((Core::String("the variable ") + key.View()) + " offers no value ") + value.View()).View());
		SelectionsOf(ws)->Set(project->name.View(), key.View(), variable->solutionScope, value.View());
		SaveSelections(ws);
		ProjectsChanged(ws);
		return ListJson(ws, project->name.View());
	}

	Core::String Tasks::SetStartupMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		Core::String named = params.Str("project");
		if (!ProjectNamed(ws, named.View())) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + named.View()).View());
		SelectionsOf(ws)->startupProject = named;
		SaveSelections(ws);
		ProjectsChanged(ws);
		return ListJson(ws, named.View());
	}

	TaskRun* Tasks::RunTask(Workspace* ws, Core::StringView projectName, Core::StringView key, Core::StringView slot, const Serialization::DomNode& context) {
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? StartupProject(ws).View() : projectName);
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project to run tasks of: ") + projectName).View());
		OfferedTasks* offered = Offered(ws, project);
		TaskDef* task = !key.IsEmpty() ? offered->Task(key) : offered->InSlot(slot);
		if (!task) {
			Core::String what = !key.IsEmpty() ? Core::String("no task ") + key : (((Core::String("the project ") + project->name.View()) + " has no ") + slot) + " task";
			throw RpcError(ErrorCode::NotFound, what.View());
		}
		TaskRun* run = Plan(ws, project, offered, task, context);
		for (TaskRun* other : runs) {
			if (other->ws != ws || other->project != run->project || other->task != run->task || !other->IsActive()) continue;
			if (run->concurrency == Concurrency::Single) throw RpcError(ErrorCode::Conflict, ((Core::String("the task ") + run->task.View()) + " is running already").View());
			if (run->concurrency == Concurrency::Restart) CancelRun(other, ended);
			if (run->concurrency != Concurrency::Parallel) run->after = other;
		}
		Start(run);
		return run;
	}

	TaskRun* Tasks::Run(Core::StringView runId) const {
		for (TaskRun* run : runs)
			if (run->runId.View() == runId) return run;
		return nullptr;
	}

	void Tasks::Cancel(TaskRun* run) {
		CancelRun(run, ended);
	}

	bool Tasks::AwaitEnd(TaskRun* run) {
		while (run->IsActive()) ended.Wait(server->lock);
		return run->status == RunStatus::Succeeded;
	}

	Core::String Tasks::RunMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		if (!ws->trusted) throw RpcError(ErrorCode::Forbidden, "tasks run the workspace's code: trust the workspace first");
		TaskRun* run = RunTask(ws, params.Str("project", Core::StringView("")).View(), params.Str("task", Core::StringView("")).View(), params.Str("slot", Core::StringView("")).View(), params.Field("context"));
		JsonWriter json;
		json.BeginObject();
		json.Field("runId", run->runId.View());
		json.Field("topic", run->Topic().View());
		json.Field("output", run->steps.IsEmpty() ? "build" : run->steps[0]->output.CStr());
		json.EndObject();
		return json.ToString();
	}

	Core::String Tasks::CancelMethod(Call& call, const Params& params) {
		Core::String runId = params.Str("runId");
		for (TaskRun* run : runs)
			if (run->runId == runId) {
				CancelRun(run, ended);
				JsonWriter json;
				json.BeginObject();
				json.Field("status", RunStatusName(run->status));
				json.EndObject();
				return json.ToString();
			}
		throw RpcError(ErrorCode::NotFound, (Core::String("no run ") + runId.View()).View());
	}

	Core::String Tasks::RunsMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("runs"));
		json.BeginArray();
		for (int64 i = runs.Count() - 1; i >= 0; --i)
			if (runs[i]->ws == ws) json.Raw(runs[i]->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
