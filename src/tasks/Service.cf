include "Service.ch"
include "Missing.ch"
include "Presets.ch"
include "host/Server.ch"
include "plugins/When.ch"
include "fs/Glob.ch"

namespace Ied
{
	void Tasks::Init(Server* server) {
		this.m_Server = server;
		Tasks* self = this;
		server->m_Rpc.Register("task.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->m_Rpc.Register("task.select", [self](Call& call, const Params& params) -> Core::String { return self->SelectMethod(call, params); });
		server->m_Rpc.Register("task.setStartup", [self](Call& call, const Params& params) -> Core::String { return self->SetStartupMethod(call, params); });
		server->m_Rpc.Register("task.run", [self](Call& call, const Params& params) -> Core::String { return self->RunMethod(call, params); });
		server->m_Rpc.Register("task.cancel", [self](Call& call, const Params& params) -> Core::String { return self->CancelMethod(call, params); });
		server->m_Rpc.Register("task.runs", [self](Call& call, const Params& params) -> Core::String { return self->RunsMethod(call, params); });
	}

	void Tasks::WorkspaceOpened(Workspace* ws) {
		Tasks* self = this;
		m_Server->m_Hub.Add(TasksTopic(ws).View(), [self, ws]() -> Core::String { return self->Snapshot(ws); });
	}

	void Tasks::ProjectsChanged(Workspace* ws) { m_Server->m_Hub.Publish(TasksTopic(ws).View(), "tasks.changed", Snapshot(ws).View()); }

	// --- Projects and what they offer --------------------------------------------------------------------------------

	Core::Array<TaskProject*> Tasks::ProjectsOf(Workspace* ws) const {
		Core::Array<TaskProject*> projects;
		if (!ws->m_Solution) {
			TaskProject* folder = new TaskProject();
			folder->m_Name = ws->m_Name;
			folder->m_Root = ws->m_Root;
			folder->m_Kind = Core::String("other");
			folder->m_Origin = ws->m_Name;
			projects.Push(folder);
			return projects;
		}
		for (ProjectModel* model : ws->m_Solution->m_Projects) {
			TaskProject* project = new TaskProject();
			project->m_Name = model->m_Name;
			project->m_Root = model->m_Root;
			project->m_Kind = model->m_Kind;
			project->m_Data = model->m_Data;
			project->m_Origin = Core::String(model->m_File.FileName());
			projects.Push(project);
		}
		return projects;
	}

	TaskProject* Tasks::ProjectNamed(Workspace* ws, Core::StringView name) const {
		for (TaskProject* project : ProjectsOf(ws))
			if (project->m_Name.View() == name) return project;
		return nullptr;
	}

	// Whether a project can be the startup project: a library or a plugin is not a program to run (docs/03 `kind`).
	static bool Startable(const TaskProject* project) {
		return project->m_Kind != "library" && project->m_Kind != "plugin";
	}

	Core::String Tasks::StartupProject(Workspace* ws) {
		Core::Array<TaskProject*> projects = ProjectsOf(ws);
		TaskSelections* chosen = SelectionsOf(ws);
		for (TaskProject* project : projects)
			if (project->m_Name.View() == chosen->m_StartupProject.View() && Startable(project)) return project->m_Name;
		for (TaskProject* project : projects)
			if (project->m_Kind == "executable") return project->m_Name;
		return projects.IsEmpty() ? Core::String() : projects[0]->m_Name;
	}

	// A preset's `detect`: a file or folder in the project's root, or a glob over its entries.
	static bool Detected(const FS::Path& root, Core::StringView detect) {
		if (detect.IndexOf('*', 0) < 0 && detect.IndexOf('?', 0) < 0) {
			FS::Path path = root / detect;
			return FS::FileExists(path.CStr()) || FS::IsDirectory(path.CStr());
		}
		if (!FS::IsDirectory(root.CStr())) return false;
		for (FS::DirectoryEntry& entry : FS::Directory(root.CStr()))
			if (GlobMatch(detect, entry.name.View())) return true;
		return false;
	}

	void Tasks::ReadPresets(Workspace* ws, const TaskProject* project, OfferedTasks& into) {
		Core::Array<Serialization::DomNode> presets;
		for (const Contribution& given : m_Server->m_Plugins->Entries(ws, Core::StringView("taskPresets"))) presets.Push(given.m_Entry);
		Core::Array<Core::String> ids;
		Serialization::DomNode named = project->m_Data.Member("presets");
		for (int64 i = 0; i < named.Count(); ++i) ids.Push(Core::String(named.At(i).AsView()));
		if (ids.IsEmpty())
			for (const Serialization::DomNode& preset : presets)
				if (!preset.Member("detect").AsView().IsEmpty() && Detected(project->m_Root, preset.Member("detect").AsView())) ids.Push(Core::String(preset.Member("id").AsView()));
		Server* host = m_Server;
		MissingPreset missing = [host, ws](Core::StringView id) -> Core::String { return MissingPresetText(id, PluginsOf(host, ws)); };
		for (const Core::String& id : ids) {
			Core::Array<Core::String> chain;
			ReadPreset(presets, id.View(), chain, into, missing);
		}
	}

	// The workspace's plugins, its own first, then the app's and the built-in ones: any of them may offer a preset.
	static Core::Array<Plugin*> PluginsOf(Server* server, Workspace* ws) {
		Core::Array<Plugin*> plugins = server->m_Plugins->LocalFor(ws);
		for (Plugin* plugin : server->m_Plugins->All()) plugins.Push(plugin);
		return plugins;
	}

	// The preset `id` into `into`, after the preset it extends (and that one's base before it); `chain` holds the ids
	// being read, so a preset that extends itself is a problem instead of a loop. A preset no plugin offers is a problem
	// `missing` words (Presets.ch).
	static void ReadPreset(const Core::Array<Serialization::DomNode>& presets, Core::StringView id, Core::Array<Core::String>& chain, OfferedTasks& into, MissingPreset missing) {
		int64 found = -1;
		for (int64 i = 0; i < presets.Count(); ++i)
			if (presets[i].Member("id").AsView() == id) found = i;
		if (found < 0) {
			into.m_Problems.Push(missing(id));
			return;
		}
		for (const Core::String& reading : chain)
			if (reading.View() == id) {
				into.m_Problems.Push(((Core::String("the task preset ") + id) + " extends itself"));
				return;
			}
		chain.Push(Core::String(id));
		Core::StringView base = presets[found].Member("extends").AsView();
		if (!base.IsEmpty()) ReadPreset(presets, base, chain, into, missing);
		ReadTaskEntries(presets[found], (Core::String("the preset ") + id).View(), into);
	}

	OfferedTasks* Tasks::Offered(Workspace* ws, const TaskProject* project) {
		OfferedTasks* offered = new OfferedTasks();
		ReadPresets(ws, project, *offered);
		if (project->m_Data.Kind() == Serialization::DomKind::Object) ReadTaskEntries(project->m_Data, project->m_Origin.View(), *offered);
		ApplyDefaultMatchers(*offered);
		return offered;
	}

	// --- Selections --------------------------------------------------------------------------------------------------

	static FS::Path SelectionsFile(const Workspace* ws) { return ws->m_LocalState / "selections.json"; }

	TaskSelections* Tasks::SelectionsOf(Workspace* ws) {
		TaskSelections* chosen = nullptr;
		if (m_Selections.TryGet(ws->m_WsId, chosen)) return chosen;
		chosen = new TaskSelections();
		*chosen = ReadTaskSelections(SelectionsFile(ws));
		m_Selections.Insert(ws->m_WsId, chosen);
		return chosen;
	}

	void Tasks::SaveSelections(Workspace* ws) {
		if (!WriteTaskSelections(SelectionsFile(ws), *SelectionsOf(ws))) m_Server->Log((Core::String("the task selections could not be written: ") + SelectionsFile(ws).View()).View());
	}

	Core::String Tasks::ValueOf(Workspace* ws, const TaskProject* project, const TaskVariable* variable) {
		Core::String value;
		if (SelectionsOf(ws)->Value(project->m_Name.View(), variable->m_Key.View(), variable->m_SolutionScope, value)) return value;
		if (!variable->m_DefaultValue.IsEmpty()) return variable->m_DefaultValue;
		if (!variable->m_Values.IsEmpty()) return variable->m_Values[0];
		return Core::String(variable->m_Kind == "toggle" ? "false" : "");
	}

	// --- Lists -------------------------------------------------------------------------------------------------------

	static void WriteStrings(JsonWriter& json, const char* key, const Core::Array<Core::String>& strings) {
		json.Key(Core::StringView(key));
		json.BeginArray();
		for (const Core::String& text : strings) json.String(text.View());
		json.EndArray();
	}

	// {default, configurations: [name]}: what F5 and the toolbar's Start Debugging start (docs/25).
	static void WriteDebug(JsonWriter& json, const OfferedTasks* offered) {
		Core::Array<Core::String> names;
		for (DebugConfig* config : offered->m_DebugConfigs) names.Push(config->m_Name);
		DebugConfig* chosen = offered->Debug(Core::StringView(""));
		json.Key(Core::StringView("debug"));
		json.BeginObject();
		json.Field("default", chosen ? chosen->m_Name.View() : Core::StringView(""));
		WriteStrings(json, "configurations", names);
		json.EndObject();
	}

	Core::String Tasks::ListJson(Workspace* ws, Core::StringView projectName) {
		Core::String startup = StartupProject(ws);
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? startup.View() : projectName);
		if (!project && !projectName.IsEmpty()) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + projectName).View());
		OfferedTasks* offered = project ? Offered(ws, project) : new OfferedTasks();
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("project"));
		if (project) json.String(project->m_Name.View());
		else json.Null();
		json.Field("startupProject", startup.View());
		Core::Array<Core::String> names;
		for (TaskProject* each : ProjectsOf(ws))
			if (Startable(each)) names.Push(each->m_Name);
		WriteStrings(json, "projects", names);
		json.Key(Core::StringView("variables"));
		json.BeginArray();
		for (TaskVariable* variable : offered->m_Variables) {
			json.BeginObject();
			json.Field("key", variable->m_Key.View());
			json.Field("kind", variable->m_Kind.View());
			json.Field("label", variable->m_Label.View());
			WriteStrings(json, "values", variable->m_Values);
			json.Field("value", ValueOf(ws, project, variable).View());
			json.Field("scope", variable->m_SolutionScope ? "solution" : "project");
			json.EndObject();
		}
		json.EndArray();
		json.Key(Core::StringView("tasks"));
		json.BeginArray();
		for (TaskDef* task : offered->m_Tasks) {
			json.BeginObject();
			json.Field("key", task->m_Key.View());
			json.Field("label", task->m_Label.View());
			json.Field("icon", task->m_Icon.View());
			json.Field("tooltip", task->m_Tooltip.View());
			json.Field("slot", task->m_Slot.View());
			json.EndObject();
		}
		json.EndArray();
		WriteStrings(json, "toolbar", offered->m_Toolbar);
		WriteDebug(json, offered);
		WriteStrings(json, "problems", offered->m_Problems);
		json.EndObject();
		return json.ToString();
	}

	Core::String Tasks::Snapshot(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.RawField("offer", ListJson(ws, Core::StringView("")).View());
		json.Key(Core::StringView("runs"));
		json.BeginArray();
		for (TaskRun* run : m_Runs)
			if (run->m_Ws == ws && run->IsActive()) json.Raw(run->SummaryJson().View());
		json.EndArray();
		TaskRun* ended = LastEnded(ws);
		const Core::String endedJson = ended ? ended->SummaryJson() : Core::String("null");
		json.RawField("ended", endedJson.View());
		json.EndObject();
		return json.ToString();
	}

	// The run of `ws` that ended last, so a window that comes back shows how it ended; null before any.
	TaskRun* Tasks::LastEnded(Workspace* ws) {
		TaskRun* last = nullptr;
		for (TaskRun* run : m_Runs)
			if (run->m_Ws == ws && !run->IsActive() && (!last || run->m_EndedMs >= last->m_EndedMs)) last = run;
		return last;
	}

	// --- Planning ----------------------------------------------------------------------------------------------------

	ProblemMatcher* Tasks::MatcherNamed(Workspace* ws, Core::StringView id) {
		Serialization::DomNode found;
		bool any = false;
		for (const Contribution& given : m_Server->m_Plugins->Entries(ws, Core::StringView("problemMatchers")))
			if (given.m_Entry.Member("id").AsView() == id) {
				found = given.m_Entry;
				any = true;
			}
		if (!any) throw RpcError(ErrorCode::BadRequest, (Core::String("no plugin offers the problem matcher ") + id).View());
		Core::String problem;
		ProblemMatcher* matcher = ReadProblemMatcher(found, problem);
		if (!matcher) throw RpcError(ErrorCode::BadRequest, problem.View());
		return matcher;
	}

	static Core::String Expanded(Core::StringView text, const TaskLookup& lookup, Core::StringView task) {
		Core::String out;
		Core::String unknown;
		if (!ExpandTaskText(text, lookup, out, unknown)) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task) + " uses ${") + unknown.View() + "}, which no variable defines").View());
		return out;
	}

	static bool StepWhen(Core::StringView when, const TaskLookup& lookup, Core::StringView task) {
		if (when.IsEmpty()) return true;
		WhenLookup values = [lookup](Core::StringView key) -> WhenValue {
			Core::String value;
			return lookup(key, value) ? WhenText(value.View()) : WhenNone();
		};
		Core::String error;
		const bool holds = WhenHolds(when, values, error);
		if (!error.IsEmpty()) throw RpcError(ErrorCode::BadRequest, (((Core::String("a step of the task ") + task) + " has a when that does not parse: ") + error.View()).View());
		return holds;
	}

	static const char* OutputFor(const TaskDef* task) {
		if (task->m_Slot == "run") return "run";
		if (task->m_Slot == "test" || task->m_Slot == "testSelected") return "test";
		if (task->m_Slot == "debug" || task->m_Slot == "debugTest") return "debug";
		return "build";
	}

	// The step's matchers' roots (`${cwd}`, `${projectRoot}/src`...), absolute.
	static void PlanMatchRoots(PlannedStep* planned, const TaskLookup& lookup, Core::StringView task) {
		const Core::String cwd = planned->m_Cwd;
		TaskLookup inStep = [lookup, cwd](Core::StringView name, Core::String& value) -> bool {
			if (name == "cwd") {
				value = cwd;
				return true;
			}
			return lookup(name, value);
		};
		for (ProblemMatcher* matcher : planned->m_Matchers) {
			for (const Core::String& root : matcher->m_Roots) {
				FS::Path path = FS::Path(Expanded(root.View(), inStep, task).View());
				planned->m_MatchRoots.Push(Core::String((path.IsAbsolute() ? path : FS::Path(cwd.View()) / path.View()).Normalized().View()));
			}
		}
	}

	void Tasks::PlanSteps(TaskRun* run, const TaskDef* task, const OfferedTasks* offered, const TaskLookup& lookup, Core::Array<Core::String>& nesting, OnlyIf entry) {
		bool first = true;
		for (TaskStep* step : task->m_Steps) {
			if (!StepWhen(step->m_When.View(), lookup, task->m_Key.View())) continue;
			const OnlyIf onlyIf = first && step->m_OnlyIf == OnlyIf::PrevSuccess ? entry : step->m_OnlyIf;
			first = false;
			if (step->m_Kind == StepKind::Task) {
				for (const Core::String& outer : nesting)
					if (outer.View() == step->m_Name.View()) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task->m_Key.View()) + " runs ") + step->m_Name.View() + ", which runs it").View());
				TaskDef* nested = offered->Task(step->m_Name.View());
				if (!nested) throw RpcError(ErrorCode::BadRequest, (((Core::String("the task ") + task->m_Key.View()) + " runs ") + step->m_Name.View() + ", which does not exist").View());
				if (nesting.Count() >= c_TaskNestingDepth) throw RpcError(ErrorCode::BadRequest, "tasks run each other too deep");
				nesting.Push(nested->m_Key);
				PlanSteps(run, nested, offered, lookup, nesting, onlyIf);
				nesting.Pop();
				continue;
			}
			PlannedStep* planned = new PlannedStep();
			planned->m_Kind = step->m_Kind;
			for (const Core::String& arg : step->m_Argv) planned->m_Argv.Push(Expanded(arg.View(), lookup, task->m_Key.View()));
			if (!step->m_Shell.IsEmpty()) planned->m_Shell = Expanded(step->m_Shell.View(), lookup, task->m_Key.View());
			planned->m_ProgramSetting = ProgramSetting(!step->m_Shell.IsEmpty() ? step->m_Shell.View() : step->m_Argv.IsEmpty() ? Core::StringView("") : step->m_Argv[0].View());
			if (step->m_Kind == StepKind::Run && planned->m_Argv.IsEmpty() && planned->m_Shell.IsEmpty()) throw RpcError(ErrorCode::BadRequest, ((Core::String("a step of the task ") + task->m_Key.View()) + " has nothing to run").View());
			planned->m_Label = !step->m_Label.IsEmpty() ? Expanded(step->m_Label.View(), lookup, task->m_Key.View()) : !planned->m_Shell.IsEmpty() ? planned->m_Shell : planned->m_Argv.IsEmpty() ? step->m_Name : planned->m_Argv[0];
			FS::Path cwd = FS::Path(Expanded(step->m_Cwd.IsEmpty() ? Core::StringView("${projectRoot}") : step->m_Cwd.View(), lookup, task->m_Key.View()).View());
			planned->m_Cwd = Core::String((cwd.IsAbsolute() ? cwd : FS::Path(run->m_SearchRoots[0].View()) / cwd.View()).Normalized().View());
			for (const Core::String& entry : step->m_Env) planned->m_Env.Push(Expanded(entry.View(), lookup, task->m_Key.View()));
			planned->m_Env = m_Server->m_Tools->EnvironmentFor(run->m_Ws, planned->m_Env);
			planned->m_Output = step->m_Output.IsEmpty() ? Core::String(OutputFor(task)) : step->m_Output;
			for (const Core::String& id : step->m_Matchers) planned->m_Matchers.Push(MatcherNamed(run->m_Ws, id.View()));
			PlanMatchRoots(planned, lookup, task->m_Key.View());
			planned->m_OnlyIf = onlyIf;
			planned->m_TimeoutSeconds = step->m_TimeoutSeconds;
			planned->m_Status = Core::String("pending");
			run->m_Steps.Push(planned);
		}
	}

	TaskRun* Tasks::NewRun(Workspace* ws) {
		TaskRun* run = new TaskRun();
		m_Started += 1;
		Core::StringBuilder id;
		id.Append("t");
		id.AppendInt(m_Started);
		run->m_RunId = id.ToString();
		run->m_Ws = ws;
		run->m_Status = RunStatus::Queued;
		return run;
	}

	// The label of a solution-wide run: "Build Solution".
	static Core::String SolutionLabel(Core::StringView slot) {
		Core::String verb = slot == "rebuild" ? Core::String("Rebuild") : slot == "clean" ? Core::String("Clean") : slot == "test" ? Core::String("Test") : Core::String("Build");
		return verb + " Solution";
	}

	TaskRun* Tasks::PlanSolution(Workspace* ws, Core::StringView slot, const Serialization::DomNode& context) {
		if (slot != "build" && slot != "rebuild" && slot != "clean" && slot != "test") throw RpcError(ErrorCode::BadRequest, (Core::String("a solution runs its projects' build, rebuild, clean or test tasks, not ") + slot).View());
		TaskRun* run = NewRun(ws);
		run->m_Task = Core::String(slot);
		run->m_Label = SolutionLabel(slot);
		run->m_Concurrency = Concurrency::Single;
		Core::Array<Core::String> roots;
		for (TaskProject* project : ProjectsOf(ws)) {
			OfferedTasks* offered = Offered(ws, project);
			TaskDef* task = offered->InSlot(slot);
			if (!task) continue;
			run->m_SaveFirst = run->m_SaveFirst || task->m_SaveAll;
			// A step's relative cwd is read from searchRoots[0]: its own project's root while it is planned.
			run->m_SearchRoots.Clear();
			run->m_SearchRoots.Push(Core::String(project->m_Root.View()));
			roots.Push(Core::String(project->m_Root.View()));
			Core::Array<Core::String> nesting;
			nesting.Push(task->m_Key);
			PlanSteps(run, task, offered, LookupFor(ws, project, offered, context), nesting, OnlyIf::Always);
		}
		if (run->m_Steps.IsEmpty()) throw RpcError(ErrorCode::NotFound, ((Core::String("no project of the workspace has a ") + slot) + " task").View());
		roots.Push(Core::String(ws->m_Root.View()));
		run->m_SearchRoots = roots;
		return run;
	}

	TaskRun* Tasks::Plan(Workspace* ws, const TaskProject* project, const OfferedTasks* offered, const TaskDef* task, const Serialization::DomNode& context) {
		TaskRun* run = NewRun(ws);
		run->m_Project = project->m_Name;
		run->m_Task = task->m_Key;
		run->m_Label = task->m_Label;
		run->m_Concurrency = task->m_Concurrency;
		run->m_SaveFirst = task->m_SaveAll;
		run->m_SearchRoots.Push(Core::String(project->m_Root.View()));
		run->m_SearchRoots.Push(Core::String(ws->m_Root.View()));
		TaskLookup lookup = LookupFor(ws, project, offered, context);
		Core::Array<Core::String> nesting;
		nesting.Push(task->m_Key);
		PlanSteps(run, task, offered, lookup, nesting, OnlyIf::PrevSuccess);
		return run;
	}

	TaskLookup Tasks::LookupFor(Workspace* ws, const TaskProject* project, const OfferedTasks* offered, const Serialization::DomNode& context) {
		Core::HashMap<Core::String, Core::String>* values = new Core::HashMap<Core::String, Core::String>();
		values->Insert(Core::String("solutionDir"), Core::String(ws->m_Root.View()));
		values->Insert(Core::String("workspaceDir"), Core::String(ws->m_Root.View()));
		values->Insert(Core::String("projectRoot"), Core::String(project->m_Root.View()));
		values->Insert(Core::String("projectDir"), Core::String(project->m_Root.View()));
		values->Insert(Core::String("project"), project->m_Name);
		values->Insert(Core::String("projectName"), project->m_Name);
		values->Insert(Core::String("startupProject"), StartupProject(ws));
		for (TaskVariable* variable : offered->m_Variables) values->Insert(variable->m_Key, ValueOf(ws, project, variable));
		Serialization::DomNode buildSystem = project->m_Data.Member("buildSystem");
		for (int64 i = 0; buildSystem.Kind() == Serialization::DomKind::Object && i < buildSystem.Count(); ++i) values->Insert(Core::String("buildSystem.") + buildSystem.KeyAt(i), Core::String(buildSystem.ValueAt(i).AsView()));
		values->Insert(Core::String("file"), Core::String(context.Member("file").AsView()));
		values->Insert(Core::String("line"), Core::String(context.Member("line").AsView()));
		values->Insert(Core::String("selection"), Core::String(context.Member("selection").AsView()));
		values->Insert(Core::String("testFilter"), Core::String(context.Member("testFilter").AsView()));
		Settings* settings = m_Server->m_Settings;
		Core::HashMap<Core::String, Core::String>* offered = nullptr;
		m_OfferedVariables.TryGet(ws->m_WsId, offered);
		Tools* tools = m_Server->m_Tools;
		TaskLookup lookup = [values, offered, settings, tools, ws](Core::StringView name, Core::String& value) -> bool {
			if (values->TryGet(Core::String(name), value)) return true;
			if (name.StartsWith(Core::StringView("tool:"))) {
				value = tools->ProgramFor(ws, name.Substring(5, name.ByteLength() - 5));
				return true;
			}
			if (offered && offered->TryGet(Core::String(name), value)) return true;
			if (name.StartsWith(Core::StringView("env:"))) {
				Core::String variable = Core::String(name.Substring(4, name.ByteLength() - 4));
				if (!Platform::TryGetEnvironmentVariable(variable.CStr(), value)) value = Core::String();
				return true;
			}
			if (name.StartsWith(Core::StringView("config:"))) {
				Serialization::DomDoc* doc = new Serialization::DomDoc();
				Core::String json = settings->Effective(ws, Core::StringView(""), name.Substring(7, name.ByteLength() - 7));
				Serialization::DomNode setting = json.IsEmpty() ? Serialization::DomNode() : Serialization::ReadJson(json.View(), *doc).root;
				value = setting.Kind() == Serialization::DomKind::String ? Core::String(setting.AsView()) : Core::String(json.View().Trimmed());
				return true;
			}
			return false;
		};
		Core::StringView output = buildSystem.Member("output").AsView();
		Core::String program;
		Core::String unknown;
		if (!output.IsEmpty() && ExpandTaskText(output, lookup, program, unknown)) values->Insert(Core::String("projectOutput"), program);
		return lookup;
	}

	void Tasks::SetVariable(Core::StringView wsId, Core::StringView name, Core::StringView value) {
		Core::HashMap<Core::String, Core::String>* variables = nullptr;
		if (!m_OfferedVariables.TryGet(Core::String(wsId), variables)) {
			variables = new Core::HashMap<Core::String, Core::String>();
			m_OfferedVariables.Insert(Core::String(wsId), variables);
		}
		variables->Remove(Core::String(name));
		if (!value.IsEmpty()) variables->Insert(Core::String(name), Core::String(value));
	}

	// --- Debug configurations ----------------------------------------------------------------------------------------

	// `node` as JSON with every string expanded.
	static void WriteExpanded(JsonWriter& json, const Serialization::DomNode& node, const TaskLookup& lookup, Core::StringView config) {
		if (node.Kind() == Serialization::DomKind::String) json.String(Expanded(node.AsView(), lookup, config).View());
		else if (node.Kind() == Serialization::DomKind::Array) {
			json.BeginArray();
			for (int64 i = 0; i < node.Count(); ++i) WriteExpanded(json, node.At(i), lookup, config);
			json.EndArray();
		}
		else if (node.Kind() == Serialization::DomKind::Object) {
			json.BeginObject();
			for (int64 i = 0; i < node.Count(); ++i) {
				json.Key(node.KeyAt(i));
				WriteExpanded(json, node.ValueAt(i), lookup, config);
			}
			json.EndObject();
		}
		else json.Raw(NodeJson(node).View());
	}

	DebugLaunch Tasks::ResolveDebug(Workspace* ws, Core::StringView projectName, Core::StringView name) {
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? StartupProject(ws).View() : projectName);
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project to debug: ") + projectName).View());
		OfferedTasks* offered = Offered(ws, project);
		DebugConfig* config = offered->Debug(name);
		if (!config) throw RpcError(ErrorCode::NotFound, (name.IsEmpty() ? ((Core::String("the project ") + project->m_Name.View()) + " has no debug configuration") : (Core::String("no debug configuration ") + name)).View());
		TaskLookup lookup = LookupFor(ws, project, offered, Serialization::DomNode());
		JsonWriter json;
		WriteExpanded(json, config->m_Node, lookup, config->m_Name.View());
		DebugLaunch launch;
		launch.m_Project = project->m_Name;
		launch.m_Name = config->m_Name;
		launch.m_Type = Core::String(config->m_Node.Member("type").AsView());
		launch.m_Request = Core::String(config->m_Node.Member("request").AsView());
		launch.m_PreLaunchTask = Expanded(config->m_Node.Member("preLaunchTask").AsView(), lookup, config->m_Name.View());
		launch.m_Arguments = json.ToString();
		return launch;
	}

	// --- Running -----------------------------------------------------------------------------------------------------

	void Tasks::Start(TaskRun* run) {
		m_Runs.Push(run);
		while (m_Runs.Count() > c_TaskRunsKept) {
			int64 oldest = -1;
			for (int64 i = 0; i < m_Runs.Count() && oldest < 0; ++i)
				if (!m_Runs[i]->IsActive()) oldest = i;
			if (oldest < 0) break;
			m_Runs.RemoveAt(oldest);
		}
		TaskRun* shown = run;
		m_Server->m_Hub.Add(run->Topic().View(), [shown]() -> Core::String { return shown->SnapshotJson(); });
		m_Server->m_Hub.Publish(TasksTopic(run->m_Ws).View(), "run.started", run->SummaryJson().View());
		Server* host = m_Server;
		Threading::ConditionVariable* signal = &m_Ended;
		Threading::Thread::Run([host, run, signal]() { ExecuteRun(host, run, signal); }).Detach();
	}

	static void CancelRun(TaskRun* run, Threading::ConditionVariable& ended) {
		if (!run->IsActive()) return;
		run->m_Cancelled = true;
		if (run->m_Child) run->m_Child->Kill();
		ended.NotifyAll();
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	Core::String Tasks::ListMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		return ListJson(ws, params.Str("project", Core::StringView("")).View());
	}

	Core::String Tasks::SelectMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		Core::String named = params.Str("project", Core::StringView(""));
		TaskProject* project = ProjectNamed(ws, named.IsEmpty() ? StartupProject(ws).View() : named.View());
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + named.View()).View());
		Core::String key = params.Str("key");
		Core::String value = params.Str("value");
		TaskVariable* variable = Offered(ws, project)->Variable(key.View());
		if (!variable) throw RpcError(ErrorCode::NotFound, (Core::String("no variable ") + key.View()).View());
		bool offeredValue = variable->m_Kind != "dropdown" || variable->m_Values.IsEmpty();
		for (const Core::String& each : variable->m_Values) offeredValue = offeredValue || each.View() == value.View();
		if (variable->m_Kind == "toggle") offeredValue = value == "true" || value == "false";
		if (!offeredValue) throw RpcError(ErrorCode::BadRequest, (((Core::String("the variable ") + key.View()) + " offers no value ") + value.View()).View());
		SelectionsOf(ws)->Set(project->m_Name.View(), key.View(), variable->m_SolutionScope, value.View());
		SaveSelections(ws);
		ProjectsChanged(ws);
		return ListJson(ws, project->m_Name.View());
	}

	Core::String Tasks::SetStartupMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		Core::String named = params.Str("project");
		TaskProject* project = ProjectNamed(ws, named.View());
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project ") + named.View()).View());
		if (!Startable(project)) throw RpcError(ErrorCode::BadRequest, (((named + " is a ") + project->m_Kind.View()) + ", not a program to run: pick an executable project").View());
		SelectionsOf(ws)->m_StartupProject = named;
		SaveSelections(ws);
		ProjectsChanged(ws);
		return ListJson(ws, named.View());
	}

	TaskRun* Tasks::RunTask(Workspace* ws, Core::StringView projectName, Core::StringView key, Core::StringView slot, const Serialization::DomNode& context) {
		TaskProject* project = ProjectNamed(ws, projectName.IsEmpty() ? StartupProject(ws).View() : projectName);
		if (!project) throw RpcError(ErrorCode::NotFound, (Core::String("no project to run tasks of: ") + projectName).View());
		OfferedTasks* offered = Offered(ws, project);
		TaskDef* task = !key.IsEmpty() ? offered->Task(key) : offered->InSlot(slot);
		if (!task) {
			Core::String what = !key.IsEmpty() ? Core::String("no task ") + key : (((Core::String("the project ") + project->m_Name.View()) + " has no ") + slot) + " task";
			throw RpcError(ErrorCode::NotFound, what.View());
		}
		TaskRun* run = Plan(ws, project, offered, task, context);
		Queue(run);
		return run;
	}

	TaskRun* Tasks::RunSolution(Workspace* ws, Core::StringView slot, const Serialization::DomNode& context) {
		TaskRun* run = PlanSolution(ws, slot, context);
		Queue(run);
		return run;
	}

	void Tasks::Queue(TaskRun* run) {
		for (TaskRun* other : m_Runs) {
			if (other->m_Ws != run->m_Ws || other->m_Project != run->m_Project || other->m_Task != run->m_Task || !other->IsActive()) continue;
			if (run->m_Concurrency == Concurrency::Single) throw RpcError(ErrorCode::Conflict, ((Core::String("the task ") + run->m_Label.View()) + " is running already").View());
			if (run->m_Concurrency == Concurrency::Restart) CancelRun(other, m_Ended);
			if (run->m_Concurrency != Concurrency::Parallel) run->m_After = other;
		}
		Start(run);
	}

	TaskRun* Tasks::Run(Core::StringView runId) const {
		for (TaskRun* run : m_Runs)
			if (run->m_RunId.View() == runId) return run;
		return nullptr;
	}

	void Tasks::Cancel(TaskRun* run) {
		CancelRun(run, m_Ended);
	}

	bool Tasks::AwaitEnd(TaskRun* run) {
		while (run->IsActive()) m_Ended.Wait(m_Server->m_Lock);
		return run->m_Status == RunStatus::Succeeded;
	}

	Core::String Tasks::RunMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		if (!ws->m_Trusted) throw RpcError(ErrorCode::Forbidden, "tasks run the workspace's code: trust the workspace first");
		TaskRun* run = params.Bool("solution", false)
			? RunSolution(ws, params.Str("slot").View(), params.Field("context"))
			: RunTask(ws, params.Str("project", Core::StringView("")).View(), params.Str("task", Core::StringView("")).View(), params.Str("slot", Core::StringView("")).View(), params.Field("context"));
		JsonWriter json;
		json.BeginObject();
		json.Field("runId", run->m_RunId.View());
		json.Field("topic", run->Topic().View());
		json.Field("output", run->m_Steps.IsEmpty() ? "build" : run->m_Steps[0]->m_Output.CStr());
		json.EndObject();
		return json.ToString();
	}

	Core::String Tasks::CancelMethod(Call& call, const Params& params) {
		Core::String runId = params.Str("runId");
		for (TaskRun* run : m_Runs)
			if (run->m_RunId == runId) {
				CancelRun(run, m_Ended);
				JsonWriter json;
				json.BeginObject();
				json.Field("status", RunStatusName(run->m_Status));
				json.EndObject();
				return json.ToString();
			}
		throw RpcError(ErrorCode::NotFound, (Core::String("no run ") + runId.View()).View());
	}

	Core::String Tasks::RunsMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("runs"));
		json.BeginArray();
		for (int64 i = m_Runs.Count() - 1; i >= 0; --i)
			if (m_Runs[i]->m_Ws == ws) json.Raw(m_Runs[i]->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
