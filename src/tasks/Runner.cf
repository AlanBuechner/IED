include "Runner.ch"
include "Missing.ch"
include "host/Server.ch"

namespace Ied
{
	const int64 c_RunReadBytes = 16384;

	const char* RunStatusName(RunStatus status) {
		if (status == RunStatus::Queued) return "queued";
		if (status == RunStatus::Running) return "running";
		if (status == RunStatus::Succeeded) return "succeeded";
		if (status == RunStatus::Failed) return "failed";
		return "cancelled";
	}

	Core::String ProblemSource(const ProblemMatcher* matcher, Core::StringView project) {
		return project.IsEmpty() ? matcher->m_Source : (matcher->m_Source + "/") + project;
	}

	Core::String TasksTopic(const Workspace* ws) { return Core::String("tasks:") + ws->m_WsId.View(); }

	static int64 NowMs() { return Platform::UnixTimeNs() / 1000000; }

	static void WriteSummary(JsonWriter& json, const TaskRun* run) {
		json.Field("runId", run->m_RunId.View());
		json.Field("project", run->m_Project.View());
		json.Field("task", run->m_Task.View());
		json.Field("label", run->m_Label.View());
		json.Field("status", RunStatusName(run->m_Status));
		json.Key(Core::StringView("exitCode"));
		if (run->m_Status == RunStatus::Succeeded || run->m_Status == RunStatus::Failed) json.Int(run->m_ExitCode);
		else json.Null();
		json.IntField("startedMs", run->m_StartedMs);
		json.IntField("endedMs", run->m_EndedMs);
	}

	Core::String TaskRun::SummaryJson() const {
		JsonWriter json;
		json.BeginObject();
		WriteSummary(json, this);
		json.EndObject();
		return json.ToString();
	}

	Core::String TaskRun::SnapshotJson() const {
		JsonWriter json;
		json.BeginObject();
		WriteSummary(json, this);
		json.Field("wsId", m_Ws->m_WsId.View());
		json.Key(Core::StringView("steps"));
		json.BeginArray();
		for (int64 i = 0; i < m_Steps.Count(); ++i) {
			json.BeginObject();
			json.IntField("step", i);
			json.Field("label", m_Steps[i]->m_Label.View());
			json.Field("status", m_Steps[i]->m_Status.View());
			json.IntField("exitCode", m_Steps[i]->m_ExitCode);
			json.EndObject();
		}
		json.EndArray();
		json.Field("tail", m_Tail.View());
		json.EndObject();
		return json.ToString();
	}

	// --- Problems ----------------------------------------------------------------------------------------------------

	static Core::String Slashed(Core::StringView path) {
		Core::StringBuilder out;
		for (int64 i = 0; i < path.ByteLength(); ++i) out.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return out.ToString();
	}

	// Where a matched file is, as a workspace path: as written when absolute, else under the step's folder or the
	// run's search roots; empty when it is not in the workspace or nowhere to be found.
	Core::String ResolveProblemFile(Core::StringView file, bool absolute, const Core::Array<Core::String>& roots, Core::StringView workspaceRoot) {
		FS::Path written = FS::Path(Slashed(file).View());
		Core::Array<FS::Path> candidates;
		if (written.IsAbsolute() || absolute) candidates.Push(written);
		else
			for (const Core::String& root : roots) candidates.Push(FS::Path(root.View()) / written.View());
		for (const FS::Path& candidate : candidates) {
			FS::Path normalized = candidate.Normalized();
			Core::String relative;
			if (FS::FileExists(normalized.CStr()) && RelativeTo(workspaceRoot, normalized.View(), relative) && !relative.IsEmpty()) return relative;
		}
		return Core::String();
	}

	Core::Array<Core::String> RunSearchRoots(Core::StringView projectRoot, Core::StringView workspaceRoot, const Core::Array<Core::String>& otherProjects) {
		Core::Array<Core::String> roots;
		roots.Push(Core::String(projectRoot));
		roots.Push(Core::String(workspaceRoot));
		for (const Core::String& other : otherProjects) {
			if (other.View() == projectRoot) continue;
			roots.Push(other);
			roots.Push(Core::String((FS::Path(other.View()) / Core::StringView("src")).View()));
		}
		return roots;
	}

	// The step's folder and its matchers' roots first, then the run's.
	static Core::String ProblemPath(const TaskRun* run, const PlannedStep* step, const ProblemMatcher* matcher, Core::StringView file) {
		Core::Array<Core::String> roots;
		roots.Push(step->m_Cwd);
		for (const Core::String& root : step->m_MatchRoots) roots.Push(root);
		for (const Core::String& root : run->m_SearchRoots) roots.Push(root);
		return ResolveProblemFile(file, matcher->m_FileKind == "absolute", roots, run->m_Ws->m_Root.View());
	}

	static int64 SeverityNumber(Core::StringView severity) {
		if (severity == "warning") return 2;
		if (severity == "info") return 3;
		if (severity == "hint") return 4;
		return 1;
	}

	static Core::String ProblemJson(const ProblemMatcher* matcher, const MatchedProblem& found) {
		const int64 line = found.m_Line > 0 ? found.m_Line - 1 : 0;
		const int64 column = found.m_Column > 0 ? found.m_Column - 1 : 0;
		const int64 endLine = found.m_EndLine > 0 ? found.m_EndLine - 1 : line;
		const int64 endColumn = found.m_EndColumn > 0 ? found.m_EndColumn - 1 : column + 1;
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("range"));
		json.BeginObject();
		json.Key(Core::StringView("start"));
		json.BeginObject();
		json.IntField("line", line);
		json.IntField("character", column);
		json.EndObject();
		json.Key(Core::StringView("end"));
		json.BeginObject();
		json.IntField("line", endLine);
		json.IntField("character", endColumn);
		json.EndObject();
		json.EndObject();
		json.IntField("severity", SeverityNumber(found.m_Severity.View()));
		json.Field("message", found.m_Message.View());
		if (!found.m_Code.IsEmpty()) json.Field("code", found.m_Code.View());
		json.Field("source", matcher->m_Source.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String RunProblemsJson(const TaskRun* run) {
		Core::Array<Core::String> paths;
		for (const Core::KeyValue<Core::String, Core::String>& entry : run->m_Problems) {
			const int64 cut = entry.key.View().IndexOf('\n', 0);
			Core::String path = Core::String(entry.key.View().Substring(cut + 1, entry.key.ByteLength() - cut - 1));
			if (!paths.Contains(path)) paths.Push(path);
		}
		paths.Sort();
		JsonWriter json;
		json.BeginObject();
		for (const Core::String& path : paths) {
			json.Key(path.View());
			json.BeginObject();
			for (const Core::KeyValue<Core::String, Core::String>& entry : run->m_Problems) {
				const int64 cut = entry.key.View().IndexOf('\n', 0);
				if (entry.key.View().Substring(cut + 1, entry.key.ByteLength() - cut - 1) != path.View()) continue;
				json.Key(entry.key.View().Substring(0, cut));
				json.Raw(((Core::String("[") + entry.value.View()) + "]").View());
			}
			json.EndObject();
		}
		json.EndObject();
		return json.ToString();
	}

	// The lock is held: the problem joins its file's diagnostics from this matcher in this project.
	static void AddProblem(Server* server, TaskRun* run, const PlannedStep* step, const ProblemMatcher* matcher, const MatchedProblem& found) {
		Core::String path = ProblemPath(run, step, matcher, found.m_File.View());
		if (path.IsEmpty()) return;
		Core::String source = ProblemSource(matcher, run->m_Project.View());
		Core::String key = (source + "\n") + path.View();
		Core::String items;
		run->m_Problems.TryGet(key, items);
		items = items.IsEmpty() ? ProblemJson(matcher, found) : (items + ",") + ProblemJson(matcher, found).View();
		run->m_Problems.Insert(key, items);
		server->m_Diagnostics->Set(run->m_Ws, path.View(), source.View(), ((Core::String("[") + items.View()) + "]").View());
	}

	// --- Output ------------------------------------------------------------------------------------------------------

	// One stream of a running step: the line it is in the middle of, and its matchers' states.
	class StreamReader
	{
		public Core::String m_Pending;
		public Core::Array<MatcherState*> m_States;
	}

	// The lock is held: one whole line of a step's output through its matchers.
	static void FeedLine(Server* server, TaskRun* run, int64 step, StreamReader* reader, Core::StringView line) {
		if (line.EndsWith(Core::StringView("\r"))) line = line.Substring(0, line.ByteLength() - 1);
		for (int64 m = 0; m < reader->m_States.Count(); ++m) {
			MatchedProblem found;
			if (reader->m_States[m]->Feed(line, found)) AddProblem(server, run, run->m_Steps[step], run->m_Steps[step]->m_Matchers[m], found);
		}
	}

	// The lock is held: text a step printed reaches the run's topic, its output source and its matchers.
	static void Emit(Server* server, TaskRun* run, int64 step, const char* stream, Core::StringView text, StreamReader* reader) {
		JsonWriter event;
		event.BeginObject();
		event.IntField("step", step);
		event.Field("source", stream);
		event.Field("text", text);
		event.EndObject();
		server->m_Hub.Publish(run->Topic().View(), "output", event.View());
		run->m_Tail = Bounded(run->m_Tail.View(), text, c_RunTailBytes);
		server->m_Outputs->Append(run->m_Ws, run->m_Steps[step]->m_Output.View(), text);
		Core::String lines = reader->m_Pending + text;
		int64 at = 0;
		for (int64 end = lines.View().IndexOf('\n', 0); end >= 0; end = lines.View().IndexOf('\n', at)) {
			FeedLine(server, run, step, reader, lines.View().Substring(at, end - at));
			at = end + 1;
		}
		reader->m_Pending = Core::String(lines.View().Substring(at, lines.ByteLength() - at));
	}

	static void ReadStream(Server* server, TaskRun* run, int64 step, Process::Child* child, Process::Stream from, const char* name, StreamReader* reader) {
		char[c_RunReadBytes] buffer;
		Core::String carried;
		while (true) {
			const int64 got = child->Read(from, (void*)&buffer[0], c_RunReadBytes);
			if (got <= 0) break;
			Core::String bytes = carried + Core::StringView((const char*)&buffer[0], got);
			const int64 whole = WholeCharacters(bytes.View());
			carried = Core::String(bytes.View().Substring(whole, bytes.ByteLength() - whole));
			Threading::LockGuard guard(server->m_Lock);
			Emit(server, run, step, name, bytes.View().Substring(0, whole), reader);
		}
		Threading::LockGuard guard(server->m_Lock);
		if (!carried.IsEmpty()) Emit(server, run, step, name, carried.View(), reader);
		if (!reader->m_Pending.IsEmpty()) FeedLine(server, run, step, reader, reader->m_Pending.View());
		reader->m_Pending = Core::String();
	}

	// --- Steps -------------------------------------------------------------------------------------------------------

	static StreamReader* ReaderFor(const PlannedStep* step) {
		StreamReader* reader = new StreamReader();
		for (ProblemMatcher* matcher : step->m_Matchers) reader->m_States.Push(new MatcherState(matcher));
		return reader;
	}

	static void Note(Server* server, TaskRun* run, int64 step, Core::StringView text) {
		StreamReader* none = new StreamReader();
		Emit(server, run, step, "stderr", text, none);
	}

	static void PublishStep(Server* server, TaskRun* run, int64 step, const char* kind) {
		const PlannedStep* planned = run->m_Steps[step];
		JsonWriter event;
		event.BeginObject();
		event.IntField("step", step);
		event.Field("label", planned->m_Label.View());
		event.Field("status", planned->m_Status.View());
		if (Core::StringView(kind) == "step.end") event.IntField("exitCode", planned->m_ExitCode);
		event.EndObject();
		server->m_Hub.Publish(run->Topic().View(), kind, event.View());
	}

	// A failed step whose program a setting names, made plain when that program is not there: cmd only says the name "is
	// not recognized" (and exits 1, as for any failure).
	static void NoteMissingProgram(Server* server, TaskRun* run, int64 index) {
		const PlannedStep* step = run->m_Steps[index];
		Core::String program = ProgramWord(step->m_Shell.View());
		Core::String path;
		Core::String extensions;
		for (const Core::String& entry : step->m_Env)
			if (entry.View().StartsWith(Core::StringView("PATH="))) path = Core::String(entry.View().Substring(5, entry.View().ByteLength() - 5));
		if (path.IsEmpty() && !Platform::TryGetEnvironmentVariable("PATH", path)) path = Core::String();
		if (!Platform::TryGetEnvironmentVariable("PATHEXT", extensions)) extensions = Core::String(".COM;.EXE;.BAT;.CMD");
		if (program.IsEmpty() || FindsProgram(program.View(), step->m_Cwd.View(), path.View(), extensions.View())) return;
		Note(server, run, index, MissingProgramNote(program.View(), step->m_ProgramSetting.View()).View());
	}

	// The step's process, run to its end: its exit code, or -1 when it did not start or ran out of time.
	static int64 RunProcess(Server* server, TaskRun* run, int64 index) {
		PlannedStep* step = run->m_Steps[index];
		Process::StartInfo info;
		if (!step->m_Shell.IsEmpty()) info.shellCommand = step->m_Shell;
		else {
			info.program = step->m_Argv[0];
			for (int64 i = 1; i < step->m_Argv.Count(); ++i) info.arguments.Push(step->m_Argv[i]);
		}
		info.workingDirectory = step->m_Cwd;
		info.environment = step->m_Env;
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::Pipe;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			Threading::LockGuard guard(server->m_Lock);
			Note(server, run, index, ((((Core::String("\x1b[31m") + step->m_Label.View()) + " did not start: ") + started.Error()) + "\x1b[0m\r\n").View());
			if (!step->m_ProgramSetting.IsEmpty()) Note(server, run, index, MissingProgramNote(step->m_Argv[0].View(), step->m_ProgramSetting.View()).View());
			return -1;
		}
		Process::Child* child = new Process::Child(take(started));
		{
			Threading::LockGuard guard(server->m_Lock);
			run->m_Child = child;
			if (run->m_Cancelled) child->Kill();
		}
		StreamReader* out = ReaderFor(step);
		StreamReader* errors = ReaderFor(step);
		Threading::Thread outThread = Threading::Thread::Run([server, run, index, child, out]() { ReadStream(server, run, index, child, Process::Stream::Output, "stdout", out); });
		Threading::Thread errorThread = Threading::Thread::Run([server, run, index, child, errors]() { ReadStream(server, run, index, child, Process::Stream::Errors, "stderr", errors); });
		int64 code = child->Wait(step->m_TimeoutSeconds > 0 ? (int32)(step->m_TimeoutSeconds * 1000) : Process::kWaitForever);
		if (code == Process::kTimedOut) {
			child->Kill();
			child->Wait();
			Threading::LockGuard guard(server->m_Lock);
			Note(server, run, index, Core::StringView("\x1b[31mthe step ran out of time and was stopped\x1b[0m\r\n"));
			code = -1;
		}
		outThread.Join();
		errorThread.Join();
		Threading::LockGuard guard(server->m_Lock);
		run->m_Child = nullptr;
		if (code != 0 && !step->m_Shell.IsEmpty() && !step->m_ProgramSetting.IsEmpty() && !run->m_Cancelled) NoteMissingProgram(server, run, index);
		return code;
	}

	// Whether a step runs after the last step that ran succeeded or failed (docs/06 `onlyIf`).
	static bool ShouldRun(OnlyIf onlyIf, bool previousFailed) {
		if (onlyIf == OnlyIf::Always) return true;
		return onlyIf == OnlyIf::PrevFailure ? previousFailed : !previousFailed;
	}

	// A step whose kind arrives later (docs/25, docs/02) fails, saying so, rather than seeming to do nothing.
	static int64 RunStep(Server* server, TaskRun* run, int64 index) {
		PlannedStep* step = run->m_Steps[index];
		if (step->m_Kind == StepKind::Run) return RunProcess(server, run, index);
		Threading::LockGuard guard(server->m_Lock);
		const char* what = step->m_Kind == StepKind::Debug ? "a debug step needs the debugger (docs/25), which is not built yet" : "a binding step needs plugin bindings (docs/02), which are not built yet";
		Note(server, run, index, (((Core::String("\x1b[31m") + what) + "\x1b[0m") + "\r\n").View());
		return -1;
	}

	// --- The run -----------------------------------------------------------------------------------------------------

	static void Begin(Server* server, TaskRun* run) {
		run->m_Status = RunStatus::Running;
		run->m_StartedMs = NowMs();
		Core::Array<Core::String> cleared;
		for (PlannedStep* step : run->m_Steps) {
			bool seen = false;
			for (const Core::String& output : cleared) seen = seen || output.View() == step->m_Output.View();
			if (!seen) {
				cleared.Push(step->m_Output);
				server->m_Outputs->Clear(run->m_Ws, step->m_Output.View());
			}
			for (ProblemMatcher* matcher : step->m_Matchers) server->m_Diagnostics->ClearSource(run->m_Ws, ProblemSource(matcher, run->m_Project.View()).View());
		}
		if (run->m_SaveFirst) server->m_Documents->SaveAll(run->m_Ws);
		server->m_Hub.Publish(run->Topic().View(), "run.start", run->SummaryJson().View());
	}

	static void End(Server* server, TaskRun* run, bool failed, Threading::ConditionVariable* ended) {
		run->m_Status = run->m_Cancelled ? RunStatus::Cancelled : failed ? RunStatus::Failed : RunStatus::Succeeded;
		run->m_EndedMs = NowMs();
		server->m_Hub.Publish(run->Topic().View(), "run.end", run->SummaryJson().View());
		server->m_Hub.Publish(TasksTopic(run->m_Ws).View(), "run.ended", run->SummaryJson().View());
		ended->NotifyAll();
	}

	void ExecuteRun(Server* server, TaskRun* run, Threading::ConditionVariable* ended) {
		{
			Threading::LockGuard guard(server->m_Lock);
			while (run->m_After && run->m_After->IsActive() && !run->m_Cancelled) ended->Wait(server->m_Lock);
			if (run->m_Cancelled) {
				End(server, run, true, ended);
				return;
			}
			Begin(server, run);
		}
		bool failed = false;
		bool previousFailed = false;
		for (int64 i = 0; i < run->m_Steps.Count(); ++i) {
			{
				Threading::LockGuard guard(server->m_Lock);
				PlannedStep* step = run->m_Steps[i];
				if (run->m_Cancelled || !ShouldRun(step->m_OnlyIf, previousFailed)) {
					step->m_Status = Core::String(run->m_Cancelled ? "cancelled" : "skipped");
					PublishStep(server, run, i, "step.end");
					continue;
				}
				step->m_Status = Core::String("running");
				PublishStep(server, run, i, "step.start");
			}
			const int64 code = RunStep(server, run, i);
			Threading::LockGuard guard(server->m_Lock);
			PlannedStep* step = run->m_Steps[i];
			step->m_ExitCode = code;
			step->m_Status = Core::String(run->m_Cancelled ? "cancelled" : code == 0 ? "ok" : "failed");
			previousFailed = code != 0;
			if (code != 0) {
				failed = true;
				run->m_ExitCode = code;
			}
			PublishStep(server, run, i, "step.end");
		}
		Threading::LockGuard guard(server->m_Lock);
		End(server, run, failed, ended);
	}
}
