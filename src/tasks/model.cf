include "model.ch"

namespace Ied
{
	static Core::Array<Core::String> StringList(const Serialization::DomNode& node) {
		Core::Array<Core::String> strings;
		if (node.Kind() == Serialization::DomKind::String) strings.Push(Core::String(node.AsView()));
		for (int64 i = 0; node.Kind() == Serialization::DomKind::Array && i < node.Count(); ++i) strings.Push(Core::String(node.At(i).AsView()));
		return strings;
	}

	static Core::String Text(const Serialization::DomNode& node, const char* member) { return Core::String(node.Member(member).AsView()); }

	static TaskVariable* ReadVariable(Core::StringView key, const Serialization::DomNode& node) {
		TaskVariable* variable = new TaskVariable();
		variable->key = Core::String(key);
		variable->kind = Text(node, "kind");
		variable->label = Text(node, "label");
		variable->values = StringList(node.Member("values"));
		Serialization::DomNode initial = node.Member("default");
		if (initial.Kind() == Serialization::DomKind::Bool) variable->defaultValue = Core::String(initial.AsBool() ? "true" : "false");
		else variable->defaultValue = Core::String(initial.AsView());
		variable->solutionScope = node.Member("scope").AsView() == "solution";
		return variable;
	}

	static OnlyIf OnlyIfOf(Core::StringView text) {
		if (text == "prevFailure") return OnlyIf::PrevFailure;
		if (text == "always") return OnlyIf::Always;
		return OnlyIf::PrevSuccess;
	}

	static Concurrency ConcurrencyOf(Core::StringView text) {
		if (text == "single") return Concurrency::Single;
		if (text == "restart") return Concurrency::Restart;
		if (text == "parallel") return Concurrency::Parallel;
		return Concurrency::Queue;
	}

	static TaskStep* ReadStep(const Serialization::DomNode& node) {
		TaskStep* step = new TaskStep();
		Serialization::DomNode run = node.Member("run");
		if (run.Kind() == Serialization::DomKind::Array) step->argv = StringList(run);
		else if (run.Kind() == Serialization::DomKind::String) step->shell = Core::String(run.AsView());
		if (node.Member("task").Kind() == Serialization::DomKind::String) step->kind = StepKind::Task;
		else if (node.Member("debug").Kind() == Serialization::DomKind::String) step->kind = StepKind::Debug;
		else if (node.Member("binding").Kind() == Serialization::DomKind::String) step->kind = StepKind::Binding;
		else step->kind = StepKind::Run;
		step->name = Text(node, step->kind == StepKind::Task ? "task" : step->kind == StepKind::Debug ? "debug" : "binding");
		step->label = Text(node, "label");
		step->cwd = Text(node, "cwd");
		Serialization::DomNode env = node.Member("env");
		for (int64 i = 0; env.Kind() == Serialization::DomKind::Object && i < env.Count(); ++i) step->env.Push((Core::String(env.KeyAt(i)) + "=") + env.ValueAt(i).AsView());
		step->output = Text(node, "output");
		step->matchers = StringList(node.Member("problemMatcher"));
		step->onlyIf = OnlyIfOf(node.Member("onlyIf").AsView());
		step->when = Text(node, "when");
		step->timeoutSeconds = node.Member("timeoutSeconds").AsInt();
		return step;
	}

	static TaskDef* ReadTask(Core::StringView key, const Serialization::DomNode& node) {
		TaskDef* task = new TaskDef();
		task->key = Core::String(key);
		task->label = node.Member("label").Kind() == Serialization::DomKind::String ? Text(node, "label") : Core::String(key);
		task->icon = Text(node, "icon");
		task->tooltip = Text(node, "tooltip");
		task->slot = Text(node, "slot");
		task->concurrency = ConcurrencyOf(node.Member("concurrency").AsView());
		task->saveAll = node.Member("saveBefore").AsView() != "none";
		task->when = Text(node, "when");
		Serialization::DomNode steps = node.Member("steps");
		for (int64 i = 0; i < steps.Count(); ++i) task->steps.Push(ReadStep(steps.At(i)));
		return task;
	}

	static void PutVariable(OfferedTasks& into, TaskVariable* variable) {
		for (int64 i = 0; i < into.variables.Count(); ++i)
			if (into.variables[i]->key.View() == variable->key.View()) {
				into.variables[i] = variable;
				return;
			}
		into.variables.Push(variable);
	}

	static void PutTask(OfferedTasks& into, TaskDef* task) {
		for (int64 i = 0; i < into.tasks.Count(); ++i)
			if (into.tasks[i]->key.View() == task->key.View()) {
				into.tasks[i] = task;
				return;
			}
		into.tasks.Push(task);
	}

	void ReadTaskEntries(const Serialization::DomNode& node, Core::StringView origin, OfferedTasks& into) {
		Serialization::DomNode variables = node.Member("variables");
		for (int64 i = 0; variables.Kind() == Serialization::DomKind::Object && i < variables.Count(); ++i) PutVariable(into, ReadVariable(variables.KeyAt(i), variables.ValueAt(i)));
		Serialization::DomNode tasks = node.Member("tasks");
		for (int64 i = 0; tasks.Kind() == Serialization::DomKind::Object && i < tasks.Count(); ++i) {
			TaskDef* task = ReadTask(tasks.KeyAt(i), tasks.ValueAt(i));
			if (task->steps.IsEmpty()) into.problems.Push(((((Core::String(origin) + ": the task ") + task->key.View()) + " has no steps")));
			else PutTask(into, task);
		}
		if (node.Member("toolbar").Kind() == Serialization::DomKind::Array) into.toolbar = StringList(node.Member("toolbar"));
		if (node.Member("problemMatcher").Kind() != Serialization::DomKind::Null) into.defaultMatchers = StringList(node.Member("problemMatcher"));
		ReadDebugEntries(node.Member("debug"), origin, into);
	}

	void ApplyDefaultMatchers(OfferedTasks& offered) {
		if (offered.defaultMatchers.IsEmpty()) return;
		for (TaskDef* task : offered.tasks)
			for (TaskStep* step : task->steps)
				if (step->kind == StepKind::Run && step->matchers.IsEmpty()) step->matchers = offered.defaultMatchers;
	}

	static void ReadDebugEntries(const Serialization::DomNode& debug, Core::StringView origin, OfferedTasks& into) {
		if (debug.Kind() != Serialization::DomKind::Object) return;
		if (debug.Member("default").Kind() == Serialization::DomKind::String) into.debugDefault = Core::String(debug.Member("default").AsView());
		Serialization::DomNode configurations = debug.Member("configurations");
		for (int64 i = 0; configurations.Kind() == Serialization::DomKind::Object && i < configurations.Count(); ++i) {
			Serialization::DomNode node = configurations.ValueAt(i);
			if (node.Member("type").AsView().IsEmpty() || node.Member("request").AsView().IsEmpty()) {
				into.problems.Push((((Core::String(origin) + ": the debug configuration ") + configurations.KeyAt(i)) + " needs a type and a request"));
				continue;
			}
			DebugConfig* config = new DebugConfig();
			config->name = Core::String(configurations.KeyAt(i));
			config->node = node;
			PutDebug(into, config);
		}
	}

	static void PutDebug(OfferedTasks& into, DebugConfig* config) {
		for (int64 i = 0; i < into.debugConfigs.Count(); ++i)
			if (into.debugConfigs[i]->name.View() == config->name.View()) {
				into.debugConfigs[i] = config;
				return;
			}
		into.debugConfigs.Push(config);
	}

	TaskVariable* OfferedTasks::Variable(Core::StringView key) const {
		for (TaskVariable* variable : variables)
			if (variable->key.View() == key) return variable;
		return nullptr;
	}

	TaskDef* OfferedTasks::Task(Core::StringView key) const {
		for (TaskDef* task : tasks)
			if (task->key.View() == key) return task;
		return nullptr;
	}

	TaskDef* OfferedTasks::InSlot(Core::StringView slot) const {
		for (TaskDef* task : tasks)
			if (task->slot.View() == slot) return task;
		return nullptr;
	}

	DebugConfig* OfferedTasks::Debug(Core::StringView name) const {
		Core::StringView wanted = name.IsEmpty() ? debugDefault.View() : name;
		for (DebugConfig* config : debugConfigs)
			if (config->name.View() == wanted) return config;
		return name.IsEmpty() && !debugConfigs.IsEmpty() ? debugConfigs[0] : nullptr;
	}
}
