include "when.ch"

namespace Ied
{
	WhenValue WhenNone() {
		WhenValue value;
		value.kind = WhenKind::None;
		return value;
	}

	WhenValue WhenBool(bool flag) {
		WhenValue value;
		value.kind = WhenKind::Bool;
		value.flag = flag;
		return value;
	}

	WhenValue WhenNumber(double number) {
		WhenValue value;
		value.kind = WhenKind::Number;
		value.number = number;
		return value;
	}

	WhenValue WhenText(Core::StringView text) {
		WhenValue value;
		value.kind = WhenKind::Text;
		value.text = Core::String(text);
		return value;
	}

	WhenValue WhenFromJson(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(json, *doc);
		if (!read.Ok()) return WhenNone();
		Serialization::DomNode node = read.root;
		if (node.Kind() == Serialization::DomKind::Bool) return WhenBool(node.AsBool());
		if (node.Kind() == Serialization::DomKind::Int || node.Kind() == Serialization::DomKind::Float) return WhenNumber(node.AsFloat());
		if (node.Kind() == Serialization::DomKind::String) return WhenText(node.AsView());
		return WhenNone();
	}

	// --- Tokens ------------------------------------------------------------------------------------------------------

	enum class TokenKind { Op, Value, Key, Pattern }

	class WhenToken
	{
		public TokenKind kind;
		public Core::String text;      // an operator, a key's name, a pattern's source
		public WhenValue value;
		public Core::String flags;     // a pattern's
	}

	static const char*[12] kOperators = { "&&", "||", "==", "!=", "<=", ">=", "=~", "<", ">", "!", "(", ")" };

	static bool IsSpace(int32 c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
	static bool IsDigit(int32 c) { return c >= '0' && c <= '9'; }
	static bool IsWordStart(int32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$'; }
	static bool IsWordPart(int32 c) { return IsWordStart(c) || IsDigit(c) || c == '.' || c == '-'; }

	static double NumberOf(Core::StringView text) {
		double value = 0;
		double scale = 0;
		bool negative = false;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			if (c == '-') negative = true;
			else if (c == '.') scale = 1;
			else if (scale > 0) {
				scale /= 10;
				value += (c - '0') * scale;
			}
			else value = value * 10 + (c - '0');
		}
		return negative ? -value : value;
	}

	class WhenTokenizer
	{
		[operator("create")] public void Init(Core::StringView text) { this.text = text; }

		public bool Run(Core::Array<WhenToken>& tokens, Core::String& error) {
			int64 at = 0;
			while (at < text.ByteLength()) {
				const int32 c = text.ByteAt(at);
				if (IsSpace(c)) at += 1;
				else if (!Next(at, tokens, error)) return false;
			}
			return true;
		}

		private bool Next(int64& at, Core::Array<WhenToken>& tokens, Core::String& error) {
			for (const char* op : kOperators) {
				if (!text.Substring(at, text.ByteLength() - at).StartsWith(Core::StringView(op))) continue;
				WhenToken token;
				token.kind = TokenKind::Op;
				token.text = Core::String(op);
				tokens.Push(token);
				at += Core::StringView(op).ByteLength();
				return Core::StringView(op) == "=~" ? PatternToken(at, tokens, error) : true;
			}
			const int32 c = text.ByteAt(at);
			if (c == '\'' || c == '"') return StringToken(at, tokens, error);
			if (IsDigit(c) || (c == '-' && at + 1 < text.ByteLength() && IsDigit(text.ByteAt(at + 1)))) return NumberToken(at, tokens);
			if (IsWordStart(c)) return WordToken(at, tokens);
			error = Fail("unexpected character", at);
			return false;
		}

		private bool StringToken(int64& at, Core::Array<WhenToken>& tokens, Core::String& error) {
			const int32 quote = text.ByteAt(at);
			const int64 start = at;
			Core::StringBuilder value;
			at += 1;
			while (at < text.ByteLength() && text.ByteAt(at) != quote) {
				if (text.ByteAt(at) == '\\' && at + 1 < text.ByteLength()) at += 1;
				value.AppendByte(text.ByteAt(at));
				at += 1;
			}
			if (at >= text.ByteLength()) {
				error = Fail("unterminated string", start);
				return false;
			}
			at += 1;
			WhenToken token;
			token.kind = TokenKind::Value;
			token.value = WhenText(value.View());
			tokens.Push(token);
			return true;
		}

		private bool NumberToken(int64& at, Core::Array<WhenToken>& tokens) {
			const int64 start = at;
			if (text.ByteAt(at) == '-') at += 1;
			while (at < text.ByteLength() && IsDigit(text.ByteAt(at))) at += 1;
			if (at + 1 < text.ByteLength() && text.ByteAt(at) == '.' && IsDigit(text.ByteAt(at + 1))) {
				at += 1;
				while (at < text.ByteLength() && IsDigit(text.ByteAt(at))) at += 1;
			}
			WhenToken token;
			token.kind = TokenKind::Value;
			token.value = WhenNumber(NumberOf(text.Substring(start, at - start)));
			tokens.Push(token);
			return true;
		}

		private bool WordToken(int64& at, Core::Array<WhenToken>& tokens) {
			const int64 start = at;
			while (at < text.ByteLength() && IsWordPart(text.ByteAt(at))) at += 1;
			Core::StringView word = text.Substring(start, at - start);
			WhenToken token;
			if (word == "true" || word == "false") {
				token.kind = TokenKind::Value;
				token.value = WhenBool(word == "true");
			}
			else {
				token.kind = TokenKind::Key;
				token.text = Core::String(word);
			}
			tokens.Push(token);
			return true;
		}

		private bool PatternToken(int64& at, Core::Array<WhenToken>& tokens, Core::String& error) {
			while (at < text.ByteLength() && IsSpace(text.ByteAt(at))) at += 1;
			if (at >= text.ByteLength() || text.ByteAt(at) != '/') {
				error = Fail("=~ needs a /regex/", at);
				return false;
			}
			const int64 start = at;
			int64 end = at + 1;
			while (end < text.ByteLength() && text.ByteAt(end) != '/') end += text.ByteAt(end) == '\\' ? 2 : 1;
			if (end >= text.ByteLength()) {
				error = Fail("unterminated regex", start);
				return false;
			}
			WhenToken token;
			token.kind = TokenKind::Pattern;
			token.text = Core::String(text.Substring(start + 1, end - start - 1));
			at = end + 1;
			while (at < text.ByteLength() && text.ByteAt(at) >= 'a' && text.ByteAt(at) <= 'z') {
				token.flags.Append(text.Substring(at, 1));
				at += 1;
			}
			tokens.Push(token);
			return true;
		}

		private Core::String Fail(const char* what, int64 at) const {
			Core::StringBuilder message;
			message.Append(what);
			message.Append(" at ");
			message.AppendInt(at);
			message.Append(" in '");
			message.Append(text);
			message.Append("'");
			return message.ToString();
		}

		private Core::StringView text;
	}

	// --- Evaluation --------------------------------------------------------------------------------------------------

	static bool Truthy(const WhenValue& value) {
		if (value.kind == WhenKind::Bool) return value.flag;
		if (value.kind == WhenKind::Number) return value.number != 0;
		if (value.kind == WhenKind::Text) return !value.text.IsEmpty();
		return false;
	}

	// A value as JavaScript's String() writes it, for comparing values of different kinds.
	static Core::String TextOf(const WhenValue& value) {
		if (value.kind == WhenKind::Text) return value.text;
		if (value.kind == WhenKind::Bool) return Core::String(value.flag ? "true" : "false");
		Core::StringBuilder out;
		const int64 whole = (int64)value.number;
		if ((double)whole == value.number) out.AppendInt(whole);
		else out.AppendDouble(value.number, 6);
		return out.ToString();
	}

	static bool Equal(const WhenValue& a, const WhenValue& b) {
		if (a.kind == WhenKind::None || b.kind == WhenKind::None) return a.kind == b.kind;
		if (a.kind == WhenKind::Number && b.kind == WhenKind::Number) return a.number == b.number;
		return TextOf(a).View() == TextOf(b).View();
	}

	static double NumericOf(const WhenValue& value) {
		if (value.kind == WhenKind::Number) return value.number;
		if (value.kind == WhenKind::Bool) return value.flag ? 1 : 0;
		if (value.kind == WhenKind::Text) return NumberOf(value.text.View());
		return 0;
	}

	class WhenParser
	{
		[operator("create")] public void Init(const Core::Array<WhenToken>& tokens, const WhenLookup& lookup, Core::StringView clause) {
			this.tokens = tokens;
			this.lookup = lookup;
			this.clause = clause;
			this.at = 0;
		}

		public bool Parse(bool& result, Core::String& error) {
			if (!Or(result)) {
				error = problem;
				return false;
			}
			if (at < tokens.Count()) {
				error = Fail(((Core::String("unexpected '") + tokens[at].text.View()) + "'").View());
				return false;
			}
			return true;
		}

		private bool Peek(const char* op) const { return at < tokens.Count() && tokens[at].kind == TokenKind::Op && tokens[at].text.View() == op; }

		private bool Or(bool& result) {
			if (!And(result)) return false;
			while (Peek("||")) {
				at += 1;
				bool right = false;
				if (!And(right)) return false;
				result = result || right;
			}
			return true;
		}

		private bool And(bool& result) {
			if (!Unary(result)) return false;
			while (Peek("&&")) {
				at += 1;
				bool right = false;
				if (!Unary(right)) return false;
				result = result && right;
			}
			return true;
		}

		private bool Unary(bool& result) {
			if (!Peek("!")) return Primary(result);
			at += 1;
			if (!Unary(result)) return false;
			result = !result;
			return true;
		}

		private bool Primary(bool& result) {
			if (Peek("(")) {
				at += 1;
				if (!Or(result)) return false;
				if (!Peek(")")) return Failed(Core::StringView("missing ')'"));
				at += 1;
				return true;
			}
			WhenValue left;
			if (!Operand(left)) return false;
			if (at < tokens.Count() && tokens[at].kind == TokenKind::Op && IsComparison(tokens[at].text.View())) return Compare(left, result);
			result = Truthy(left);
			return true;
		}

		private static bool IsComparison(Core::StringView op) { return op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "=~"; }

		private bool Compare(const WhenValue& left, bool& result) {
			Core::String op = tokens[at].text;
			at += 1;
			if (op.View() == "=~") return MatchPattern(left, result);
			WhenValue right;
			if (!Operand(right)) return false;
			if (op.View() == "==") result = Equal(left, right);
			else if (op.View() == "!=") result = !Equal(left, right);
			else if (op.View() == "<") result = NumericOf(left) < NumericOf(right);
			else if (op.View() == "<=") result = NumericOf(left) <= NumericOf(right);
			else if (op.View() == ">") result = NumericOf(left) > NumericOf(right);
			else result = NumericOf(left) >= NumericOf(right);
			return true;
		}

		private bool MatchPattern(const WhenValue& left, bool& result) {
			if (at >= tokens.Count() || tokens[at].kind != TokenKind::Pattern) return Failed(Core::StringView("=~ needs a /regex/"));
			Core::StringBuilder source;
			if (!tokens[at].flags.IsEmpty()) {
				source.Append("(?");
				for (int64 i = 0; i < tokens[at].flags.ByteLength(); ++i)
					if (tokens[at].flags.View().ByteAt(i) == 'i' || tokens[at].flags.View().ByteAt(i) == 'm' || tokens[at].flags.View().ByteAt(i) == 's') source.AppendByte(tokens[at].flags.View().ByteAt(i));
				source.Append(")");
			}
			source.Append(tokens[at].text.View());
			at += 1;
			Core::Regex regex = Core::Regex(source.View());
			if (!regex.IsValid()) return Failed(Core::StringView("bad regex"));
			result = regex.Contains(left.kind == WhenKind::None ? Core::StringView("") : TextOf(left).View());
			return true;
		}

		private bool Operand(WhenValue& value) {
			if (at >= tokens.Count()) return Failed(Core::StringView("unexpected end"));
			const WhenToken& token = tokens[at];
			if (token.kind == TokenKind::Op || token.kind == TokenKind::Pattern) return Failed(((Core::String("unexpected '") + token.text.View()) + "'").View());
			at += 1;
			value = token.kind == TokenKind::Key ? lookup(token.text.View()) : token.value;
			return true;
		}

		private bool Failed(Core::StringView message) {
			problem = Fail(message);
			return false;
		}

		private Core::String Fail(Core::StringView message) const { return ((Core::String(message) + " in '") + clause) + "'"; }

		private Core::Array<WhenToken> tokens;
		private WhenLookup lookup;
		private Core::StringView clause;
		private int64 at;
		private Core::String problem;
	}

	bool WhenHolds(Core::StringView clause, const WhenLookup& lookup, Core::String& error) {
		Core::StringView trimmed = clause.Trimmed();
		if (trimmed.IsEmpty()) return true;
		Core::Array<WhenToken> tokens;
		WhenTokenizer tokenizer = WhenTokenizer(trimmed);
		if (!tokenizer.Run(tokens, error)) return false;
		bool result = false;
		WhenParser parser = WhenParser(tokens, lookup, trimmed);
		if (!parser.Parse(result, error)) return false;
		return result;
	}
}
