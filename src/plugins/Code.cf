include "Code.ch"
include "host/Server.ch"
include "Context.ch"
include "CodeDiagnostics.ch"

namespace Ied
{
	thread_local CodeInstance* s_TCode = nullptr;

	static Core::String Number(int64 value) {
		Core::StringBuilder text;
		text.AppendInt(value);
		return text.ToString();
	}

	CodeInstance* CurrentCode() { return s_TCode; }

	void SetCurrentCode(CodeInstance* instance) { s_TCode = instance; }

	const char* CodeStateName(CodeState state) {
		if (state == CodeState::Idle) return "idle";
		if (state == CodeState::Compiling) return "compiling";
		if (state == CodeState::Active) return "active";
		if (state == CodeState::Stopped) return "stopped";
		return "failed";
	}

	bool CodeInstance::May(Core::StringView permission) const {
		for (const Core::String& held : m_Permissions)
			if (held.View() == permission) return true;
		return false;
	}

	void CodeRuntime::Init(Server* server) {
		this.m_Server = server;
		server->m_Rpc.Register("plugins.call", [server](Call& call, const Params& params) -> Core::String { return CallBindingMethod(server, call, params); });
		CodeRuntime* self = this;
		server->m_Hub.Tap([self](Core::StringView topic, Core::StringView kind, Core::StringView data) { self->Published(topic, kind, data); });
	}

	// --- Sources -------------------------------------------------------------------------------------------------------

	// The .cf files under `path` (itself, when it is one), in name order.
	static void CodeFiles(const FS::Path& path, Core::Array<Core::String>& into) {
		if (FS::FileExists(path.CStr())) {
			if (path.View().EndsWith(Core::StringView(".cf"))) into.Push(Core::String(path.View()));
			return;
		}
		if (!FS::IsDirectory(path.CStr())) return;
		Core::Array<Core::String> names;
		FS::Directory listing = FS::Directory(path.CStr());
		for (FS::DirectoryEntry& entry : listing) names.Push(entry.name);
		names.Sort();
		for (const Core::String& name : names) CodeFiles(path / name.View(), into);
	}

	Core::Array<Core::String> CodeFilesOf(CodeInstance* instance) {
		Core::Array<Core::String> files;
		for (const Core::String& source : instance->m_Sources) CodeFiles(instance->m_Folder / source.View(), files);
		return files;
	}

	// What a build is made of: the entry, the sources and their files' digest.
	static Core::String BuildDigest(const FS::Path& folder, Core::StringView entry, const Core::Array<Core::String>& sources) {
		Core::StringBuilder all;
		all.Append(entry);
		for (const Core::String& source : sources) {
			FS::Path path = folder / source.View();
			all.Append("\n");
			all.Append(source.View());
			all.Append("=");
			if (FS::IsDirectory(path.CStr())) all.Append(FolderDigest(path).View());
			else if (FS::FileExists(path.CStr())) {
				FS::File opened = FS::File(path.CStr(), "rb");
				all.Append(TextDigest(opened.ReadText().View()).View());
			}
		}
		return TextDigest(all.View());
	}

	// Whether `plugin` has code that runs in this server (docs/26 "Servers").
	static bool IsCode(Server* server, Plugin* plugin) {
		if (plugin->m_State != PluginState::Loaded) return false;
		if (!plugin->m_Manifest->m_Servers.Contains(Core::String(server->IsMaster() ? "master" : "workspace"))) return false;
		return plugin->m_Manifest->m_Kind.View() == "c4" || (plugin->m_Manifest->m_Kind.View() == "builtin" && !plugin->m_Manifest->m_Entry.IsEmpty());
	}

	static bool SameFolder(const FS::Path& a, const FS::Path& b) { return a.View() == b.View(); }

	// --- Which code runs -----------------------------------------------------------------------------------------------

	CodeInstance* CodeRuntime::For(Plugin* plugin, Workspace* ws) const {
		const bool project = plugin->m_Manifest->m_Source == PluginSource::Project;
		if (project && !ws) return nullptr;
		Core::StringView wsId = project ? ws->m_WsId.View() : Core::StringView("");
		for (CodeInstance* instance : m_Instances)
			if (instance->m_WsId.View() == wsId && instance->m_PluginId.View() == plugin->m_Manifest->m_Id.View() && SameFolder(instance->m_Folder, plugin->m_Manifest->m_Folder))
				return instance;
		return nullptr;
	}

	// Whether `plugin` provides the server binding `name` here: one marked master only in the master.
	static bool ProvidesServerBinding(Server* server, Plugin* plugin, Core::StringView name) {
		Serialization::DomNode provides = plugin->m_Manifest->m_Contributes.Member("bindings").Member("provides");
		for (int64 i = 0; i < provides.Count(); ++i) {
			Serialization::DomNode binding = provides.At(i);
			Core::StringView side = binding.Member("side").IsValid() ? binding.Member("side").AsView() : Core::StringView("server");
			if (binding.Member("name").AsView() != name || side != "server") continue;
			return server->IsMaster() || !binding.Member("master").AsBool();
		}
		return false;
	}

	CodeInstance* CodeRuntime::Provider(Workspace* ws, Core::StringView name) const {
		Core::Array<Plugin*> loaded = ws ? m_Server->m_Plugins->LoadedFor(ws) : Core::Array<Plugin*>();
		if (!ws)
			for (Plugin* plugin : m_Server->m_Plugins->All())
				if (plugin->m_State == PluginState::Loaded) loaded.Push(plugin);
		for (Plugin* plugin : loaded)
			if (IsCode(m_Server, plugin) && ProvidesServerBinding(m_Server, plugin, name)) return For(plugin, ws);
		return nullptr;
	}

	bool CodeRuntime::LoadedIn(CodeInstance* instance, Workspace* ws) const {
		if (instance->IsProject()) return instance->m_WsId.View() == ws->m_WsId.View();
		for (Plugin* plugin : m_Server->m_Plugins->LocalFor(ws))
			if (plugin->m_State == PluginState::Loaded && plugin->m_Manifest->m_Id.View() == instance->m_PluginId.View()) return false;
		return true;
	}

	// The folder of each source: itself for a folder, the one it is in for a file.
	static Core::Array<Core::String> SourceFolders(const FS::Path& folder, const Core::Array<Core::String>& sources) {
		Core::Array<Core::String> folders;
		for (const Core::String& source : sources) {
			FS::Path path = folder / source.View();
			Core::String named = Core::String((FS::IsDirectory(path.CStr()) ? path : path.Parent()).View());
			if (!folders.Contains(named)) folders.Push(named);
		}
		return folders;
	}

	// The c4 plugins `ws` holds, loaded or not: its folder itself when that is a plugin, and each plugins/<name>/ - the
	// layout of the server's home, so an installed server checks the code of the source it was installed from too.
	static Core::Array<Manifest*> HeldPlugins(Server* server, Workspace* ws) {
		Core::Array<FS::Path> candidates;
		candidates.Push(ws->m_Root);
		FS::Path plugins = ws->m_Root / "plugins";
		if (FS::IsDirectory(plugins.CStr())) {
			FS::Directory listing = FS::Directory(plugins.CStr());
			for (FS::DirectoryEntry& entry : listing)
				if (entry.kind == FS::EntryKind::Directory) candidates.Push(plugins / entry.name.View());
		}
		Core::Array<Manifest*> held;
		for (const FS::Path& folder : candidates) {
			if (!FS::FileExists((folder / c_ManifestFile).CStr())) continue;
			Manifest* manifest = ReadManifest(folder, PluginSource::Project, *server->m_Schemas.m_Registry, server->m_Schemas.Name(c_ManifestSchema).View());
			if (manifest->m_Kind.View() == "c4") held.Push(manifest);
		}
		return held;
	}

	static bool AnyListed(const Core::Array<Core::String>& listed, const Core::Array<Core::String>& folders) {
		for (const Core::String& folder : folders)
			if (listed.Contains(TrustKey(folder.View()))) return true;
		return false;
	}

	static void WriteScope(JsonWriter& json, const Core::Array<Core::String>& folders, Core::StringView interfaceFile) {
		json.BeginObject();
		json.Key(Core::StringView("folders"));
		json.BeginArray();
		for (const Core::String& folder : folders) json.String(folder.View());
		json.EndArray();
		json.Field("interface", interfaceFile);
		json.Key(Core::StringView("allow"));
		json.BeginArray();
		json.String(Core::StringView(c_CodeAllowed));
		json.EndArray();
		json.EndObject();
	}

	Core::String CodeRuntime::ScopesJson(Workspace* ws) const {
		const Core::String interfaceFile = Core::String(Platform::ExecutablePath().WithExtension(Core::StringView(".c4i")).View());
		Core::Array<Core::String> listed;
		JsonWriter json;
		json.BeginArray();
		for (CodeInstance* instance : m_Instances) {
			if (instance->m_Builtin || !LoadedIn(instance, ws)) continue;
			Core::Array<Core::String> folders = SourceFolders(instance->m_Folder, instance->m_Sources);
			WriteScope(json, folders, interfaceFile.View());
			for (const Core::String& folder : folders) listed.Push(TrustKey(folder.View()));
		}
		Core::Array<Manifest*> held = ws ? HeldPlugins(m_Server, ws) : Core::Array<Manifest*>();
		for (Manifest* manifest : held) {
			Core::Array<Core::String> folders = SourceFolders(manifest->m_Folder, manifest->m_Sources);
			if (AnyListed(listed, folders)) continue;
			WriteScope(json, folders, interfaceFile.View());
			for (const Core::String& folder : folders) listed.Push(TrustKey(folder.View()));
		}
		json.EndArray();
		return json.ToString();
	}

	bool CodeRuntime::Starting() const {
		for (CodeInstance* instance : m_Instances)
			if (!instance->m_Stopping && instance->m_State == CodeState::Compiling) return true;
		return false;
	}

	void CodeRuntime::Registered(Core::Array<Core::String>& methods, Core::Array<Core::String>& topics) const {
		for (CodeInstance* instance : m_Instances) {
			if (instance->m_Stopping) continue;
			for (const Core::String& method : instance->m_Methods) methods.Push(method);
			for (PluginTopic* topic : instance->m_Topics) topics.Push(topic->m_Key);
		}
	}

	Plugin* CodeRuntime::PluginOf(CodeInstance* instance) const {
		Workspace* ws = instance->IsProject() ? m_Server->m_Workspaces->Find(instance->m_WsId.View()) : nullptr;
		Core::Array<Plugin*> candidates = ws ? m_Server->m_Plugins->LocalFor(ws) : m_Server->m_Plugins->All();
		for (Plugin* plugin : candidates)
			if (IsCode(m_Server, plugin) && plugin->m_Manifest->m_Id.View() == instance->m_PluginId.View() && SameFolder(plugin->m_Manifest->m_Folder, instance->m_Folder)) return plugin;
		return nullptr;
	}

	void CodeRuntime::Reconcile(Workspace* ws) {
		Core::Array<Plugin*> wanted = ws ? m_Server->m_Plugins->LocalFor(ws) : m_Server->m_Plugins->All();
		Core::StringView wsId = ws ? ws->m_WsId.View() : Core::StringView("");
		Core::Array<CodeInstance*> running = m_Instances;
		for (CodeInstance* instance : running) {
			if (instance->m_WsId.View() != wsId) continue;
			Plugin* match = nullptr;
			for (Plugin* plugin : wanted)
				if (IsCode(m_Server, plugin) && plugin->m_Manifest->m_Id.View() == instance->m_PluginId.View() && SameFolder(plugin->m_Manifest->m_Folder, instance->m_Folder)) match = plugin;
			if (!match) {
				Stop(instance);
				continue;
			}
			instance->m_Permissions = match->m_Manifest->m_Permissions;
			instance->m_Activation = match->m_Manifest->m_Activation;
			if (instance->m_Builtin) continue;
			Core::String digest = BuildDigest(match->m_Manifest->m_Folder, match->m_Manifest->m_Entry.View(), match->m_Manifest->m_Sources);
			if (instance->m_BuildQueued || instance->m_State == CodeState::Idle || digest.View() == instance->m_Digest.View()) continue;
			instance->m_Entry = match->m_Manifest->m_Entry;
			instance->m_Sources = match->m_Manifest->m_Sources;
			Activate(instance);
		}
		for (Plugin* plugin : wanted)
			if (IsCode(m_Server, plugin) && !For(plugin, ws)) Start(plugin, ws);
	}

	CodeInstance* CodeRuntime::Start(Plugin* plugin, Workspace* ws) {
		CodeInstance* instance = new CodeInstance();
		instance->m_PluginId = plugin->m_Manifest->m_Id;
		instance->m_WsId = plugin->m_Manifest->m_Source == PluginSource::Project ? ws->m_WsId : Core::String("");
		instance->m_Folder = plugin->m_Manifest->m_Folder;
		instance->m_Entry = plugin->m_Manifest->m_Entry;
		instance->m_Sources = plugin->m_Manifest->m_Sources;
		instance->m_Permissions = plugin->m_Manifest->m_Permissions;
		instance->m_Activation = plugin->m_Manifest->m_Activation;
		instance->m_State = CodeState::Idle;
		instance->m_Builtin = plugin->m_Manifest->m_Kind.View() == "builtin";
		instance->m_Runtime = this;
		m_Instances.Push(instance);
		CodeRuntime* self = this;
		Threading::Thread::Run([self, instance]() { self->Loop(instance); }).Detach();
		bool wanted = Wants(instance, nullptr);
		if (!wanted && !instance->IsProject())
			for (Workspace* open : m_Server->m_Workspaces->All()) wanted = wanted || Wants(instance, open);
		if (!wanted && instance->IsProject()) wanted = Wants(instance, ws);
		if (wanted) Activate(instance);
		return instance;
	}

	// Whether an activation event of `instance` holds: at load (`ws` null) or for the workspace `ws`.
	bool CodeRuntime::Wants(CodeInstance* instance, Workspace* ws) const {
		if (!ws) {
			if (instance->m_Activation.IsEmpty()) return true;
			for (const Core::String& event : instance->m_Activation)
				if (event.View() == "onStartup") return true;
			return false;
		}
		WhenLookup lookup = WorkspaceWhen(m_Server, ws);
		for (const Core::String& event : instance->m_Activation) {
			Core::StringView text = event.View();
			if (text == "onWorkspaceOpen") return true;
			if (text.StartsWith(Core::StringView("onWorkspaceContains:")) && lookup((Core::String("workspaceContains.") + text.Substring(20, text.ByteLength() - 20)).View()).m_Flag) return true;
			if (text.StartsWith(Core::StringView("onLanguage:")) && lookup((Core::String("workspaceLanguage.") + text.Substring(11, text.ByteLength() - 11)).View()).m_Flag) return true;
		}
		return false;
	}

	void CodeRuntime::WorkspaceOpened(Workspace* ws) {
		Reconcile(ws);
		for (CodeInstance* instance : m_Instances) {
			if (instance->IsProject() || instance->m_Stopping) continue;
			if (instance->m_State == CodeState::Idle && Wants(instance, ws)) Activate(instance);
		}
		IED::Workspace shown = PluginWorkspace(m_Server, ws);
		for (CodeInstance* instance : m_Instances) {
			if (instance->IsProject() || instance->m_State != CodeState::Active || !LoadedIn(instance, ws)) continue;
			Queue(instance, [instance, shown]() {
				for (const IED::WorkspaceHandler& handler : instance->m_Handlers.m_WorkspaceHandlers) {
					Core::String problem;
					GuardedCall(instance, [handler, shown]() { handler(shown); }, problem);
				}
			});
		}
	}

	void CodeRuntime::Stop(CodeInstance* instance) {
		instance->m_Stopping = true;
		instance->m_State = CodeState::Stopped;
		instance->m_Contributed.Clear();
		instance->m_Provides.Clear();
		instance->m_Hears.Clear();
		for (int64 i = 0; i < m_Instances.Count(); ++i)
			if (m_Instances[i] == instance) {
				m_Instances.RemoveAt(i);
				break;
			}
		CodeRuntime* self = this;
		Queue(instance, [self, instance]() { self->Retire(instance); });
		m_Server->m_Plugins->CodeChanged(instance);
	}

	// --- The plugin's thread -------------------------------------------------------------------------------------------

	void CodeRuntime::Queue(CodeInstance* instance, func<void()> body) {
		CodeJob* job = new CodeJob();
		job->m_Body = body;
		instance->m_Queue.Push(job);
		instance->m_Wake.NotifyAll();
	}

	void CodeRuntime::Loop(CodeInstance* instance) {
		s_TCode = instance;
		Threading::LockGuard guard(m_Server->m_Lock);
		while (true) {
			while (instance->m_Queue.IsEmpty() && !instance->m_Stopping) instance->m_Wake.Wait(m_Server->m_Lock);
			if (instance->m_Queue.IsEmpty()) break;
			CodeJob* job = instance->m_Queue.Pop();
			{
				CodeUnlocked unlocked(m_Server);
				job->m_Body();
			}
			job->m_Done = true;
			instance->m_Finished.NotifyAll();
		}
	}

	func<bool()> NeverStopped() { return []() -> bool { return false; }; }

	bool CodeRuntime::Run(CodeInstance* instance, func<void(CodeInstance*)> body, int64 ms, func<bool()> stopped, Core::String& problem) {
		Core::String who = Core::String("plugin ") + instance->m_PluginId.View();
		if (instance->m_Stopping) {
			problem = who + ": its code stopped";
			return false;
		}
		if (instance->m_State == CodeState::Failed) {
			problem = (who + ": ") + instance->m_Problem.View();
			return false;
		}
		if (CurrentCode() == instance) {
			CodeUnlocked unlocked(m_Server);
			body(instance);
			return true;
		}
		int64 wait = ms;
		if (instance->m_State != CodeState::Active) wait += c_CodeStartMs;
		if (instance->m_State == CodeState::Idle) Activate(instance);
		Core::String* refused = new Core::String();
		Server* host = m_Server;
		CodeJob* job = new CodeJob();
		job->m_Body = [host, instance, body, refused]() {
			{
				Threading::LockGuard guard(host->m_Lock);
				if (instance->m_State != CodeState::Active) {
					*refused = instance->m_Problem.IsEmpty() ? Core::String("its code did not start") : instance->m_Problem;
					return;
				}
			}
			body(instance);
		};
		instance->m_Queue.Push(job);
		instance->m_Wake.NotifyAll();
		if (!Await(instance, job, wait, stopped, problem)) return false;
		if (!refused->IsEmpty()) {
			problem = (who + ": ") + refused->View();
			return false;
		}
		return true;
	}

	bool CodeRuntime::RunApart(CodeInstance* instance, func<void(CodeInstance*)> body, int64 ms, func<bool()> stopped, Core::String& problem) {
		if (instance->m_State != CodeState::Active && !Run(instance, [](CodeInstance* code) {}, ms, stopped, problem)) return false;
		CodeJob* job = new CodeJob();
		Server* host = m_Server;
		Threading::Thread::Run([host, instance, body, job]() {
			{
				CodeScope scope(instance);
				body(instance);
			}
			Threading::LockGuard guard(host->m_Lock);
			job->m_Done = true;
			instance->m_Finished.NotifyAll();
		}).Detach();
		return Await(instance, job, ms, stopped, problem);
	}

	bool CodeRuntime::Await(CodeInstance* instance, CodeJob* job, int64 wait, func<bool()> stopped, Core::String& problem) {
		Core::String who = Core::String("plugin ") + instance->m_PluginId.View();
		const int64 deadline = clock_now_ns() + wait * 1000000;
		while (!job->m_Done) {
			const int64 left = deadline - clock_now_ns();
			if (left <= 0) {
				problem = ((who + ": no answer within ") + Number(wait / 1000).View()) + " s";
				return false;
			}
			if (stopped()) {
				problem = who + ": cancelled";
				return false;
			}
			instance->m_Finished.WaitFor(m_Server->m_Lock, left < 100000000 ? left : 100000000);
		}
		return true;
	}

	// --- Building and starting -----------------------------------------------------------------------------------------

	Scripting::Host* CodeRuntime::ScriptHost(Core::String& problem) {
		if (!m_HostTried) {
			m_HostTried = true;
			m_Host = Scripting::Host::Open();
			if (!m_Host->IsOpen()) m_HostProblem = Core::String("the server cannot run plugin code: ") + m_Host->Error();
			else {
				if (m_Server->m_Config.m_DebugScripts >= 0) m_Host->SetDebugScripts(m_Server->m_Config.m_DebugScripts == 1);
				UseScriptCache();
			}
		}
		if (!m_HostProblem.IsEmpty()) {
			problem = m_HostProblem;
			return nullptr;
		}
		return m_Host;
	}

	// Compiled scripts are kept in the data folder: a plugin whose code did not change since it last compiled links
	// what was kept (C4/docs/runtime/04 section 4.6).
	void CodeRuntime::UseScriptCache() {
		FS::Path folder = FS::Path(m_Server->m_Config.m_StateDir.View()) / "script-cache";
		FS::MakeDirectories(folder.CStr());
		if (!m_Host->UseCache(folder.CStr())) m_Server->Log(((Core::String("plugin code: the compiled-script cache in ") + folder.View()) + " cannot be used; code compiles on every start").View());
	}

	// A script's name is its reflection tag: unique among the loaded scripts (a new build loads before the running one
	// retires; a project plugin runs once per workspace), and the same for the same build after a restart, which the
	// cache's key includes.
	static Core::String ScriptName(const CodeInstance* instance) {
		Core::String name = instance->m_PluginId;
		if (instance->IsProject()) name = (name + "@") + instance->m_WsId.View();
		return (name + "#") + Number(instance->m_Builds).View();
	}

	void CodeRuntime::RetryFailed() {
		for (CodeInstance* instance : m_Instances)
			if (instance->m_State == CodeState::Failed && !instance->m_BuildQueued) Activate(instance);
	}

	void CodeRuntime::Activate(CodeInstance* instance) {
		if (instance->m_State == CodeState::Idle || instance->m_State == CodeState::Failed) instance->m_State = CodeState::Compiling;
		instance->m_BuildQueued = true;
		CodeRuntime* self = this;
		Queue(instance, [self, instance]() { self->Build(instance); });
	}

	// On the plugin's thread: a built-in's entry runs; a script's sources compile and, when they do, the running build
	// retires and the new one starts.
	void CodeRuntime::Build(CodeInstance* instance) {
		if (!instance->m_Builtin) {
			BuildScript(instance);
			return;
		}
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			if (instance->m_Stopping) return;
			instance->m_BuildQueued = false;
			instance->m_Builds += 1;
		}
		Retire(instance);
		Enter(instance, Core::StringView(""), -1);
	}

	void CodeRuntime::BuildScript(CodeInstance* instance) {
		Scripting::ScriptOptions options;
		Scripting::Host* scripts = nullptr;
		Core::String problem;
		Core::String digest;
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			if (instance->m_Stopping) return;
			instance->m_BuildQueued = false;
			scripts = ScriptHost(problem);
			digest = BuildDigest(instance->m_Folder, instance->m_Entry.View(), instance->m_Sources);
			instance->m_Builds += 1;
			options.name = ScriptName(instance);
			for (const Core::String& file : CodeFilesOf(instance)) options.AddFile(file.CStr());
			if (options.paths.IsEmpty() && problem.IsEmpty()) problem = Core::String("its sources hold no .cf file");
		}
		options.Allow(c_CodeAllowed);
		if (!problem.IsEmpty()) {
			Failed(instance, problem.View(), digest.View());
			return;
		}
		const int64 started = clock_now_ns();
		Scripting::Script* fresh = scripts->Compile(options);
		const int64 compileMs = (clock_now_ns() - started) / 1000000;
		if (!fresh->Ok()) {
			Core::String diagnostics = Core::String("its code did not compile:\n") + fresh->Diagnostics();
			if (instance->m_Script && !instance->m_Script->Faulted()) {
				Threading::LockGuard guard(m_Server->m_Lock);
				instance->m_Problem = Core::String("the new build did not compile, the previous one runs:\n") + fresh->Diagnostics();
				instance->m_Digest = digest;
				PublishCodeDiagnostics(m_Server, instance, Core::StringView(fresh->Diagnostics()));
				m_Server->Log((((Core::String("plugin ") + instance->m_PluginId.View()) + ": ") + instance->m_Problem.View()).View());
				m_Server->m_Plugins->CodeChanged(instance);
				return;
			}
			Retire(instance);
			Failed(instance, diagnostics.View(), digest.View());
			Threading::LockGuard guard(m_Server->m_Lock);
			PublishCodeDiagnostics(m_Server, instance, Core::StringView(fresh->Diagnostics()));
			return;
		}
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			PublishCodeDiagnostics(m_Server, instance, Core::StringView(""));
		}
		Retire(instance);
		instance->m_Script = fresh;
		Enter(instance, digest.View(), compileMs);
	}

	void CodeRuntime::Enter(CodeInstance* instance, Core::StringView digest, int64 compileMs) {
		instance->m_Context = new IED::PluginContext((void*)instance);
		IED::PluginContext* context = instance->m_Context;
		Core::String problem;
		Reflection::Function entry = CodeFunction(instance, instance->m_Entry.View(), Core::StringView("void"), Core::StringView("IED::PluginContext&"), problem);
		if (entry.IsValid()) InvokeCode(instance, entry, nullptr, (void*)context, problem);
		Threading::LockGuard guard(m_Server->m_Lock);
		if (instance->m_Stopping) return;
		instance->m_Digest = Core::String(digest);
		instance->m_State = problem.IsEmpty() ? CodeState::Active : CodeState::Failed;
		instance->m_Problem = problem;
		Core::StringBuilder line;
		line.Append("plugin ");
		line.Append(instance->m_PluginId.View());
		line.Append(problem.IsEmpty() ? ": code started" : ": code did not start");
		if (compileMs >= 0) {
			line.Append(instance->m_Script->Cached() ? " (linked from the cache in " : " (compiled in ");
			line.AppendInt(compileMs);
			line.Append(" ms)");
		}
		if (!problem.IsEmpty()) {
			line.Append(": ");
			line.Append(problem.View());
		}
		m_Server->Log(line.View());
		m_Server->m_Plugins->CodeChanged(instance);
	}

	void CodeRuntime::Failed(CodeInstance* instance, Core::StringView problem, Core::StringView digest) {
		Threading::LockGuard guard(m_Server->m_Lock);
		if (instance->m_Stopping) return;
		instance->m_State = CodeState::Failed;
		instance->m_Problem = Core::String(problem);
		instance->m_Digest = Core::String(digest);
		m_Server->Log((((Core::String("plugin ") + instance->m_PluginId.View()) + ": ") + problem).View());
		m_Server->m_Plugins->CodeChanged(instance);
	}

	// On the plugin's thread: the running build's deactivate handlers run, everything it registered goes, and its script
	// unloads.
	void CodeRuntime::Retire(CodeInstance* instance) {
		if (!instance->m_Context) return;
		for (const func<void()>& handler : instance->m_Handlers.m_DeactivateHandlers) {
			Core::String ignored;
			if (instance->m_Builtin || !instance->m_Script->Faulted()) GuardedCall(instance, handler, ignored);
		}
		instance->m_Handlers.m_Bindings.Clear();
		instance->m_Handlers.m_ListenKinds.Clear();
		instance->m_Handlers.m_Listeners.Clear();
		instance->m_Handlers.m_WorkspaceHandlers.Clear();
		instance->m_Handlers.m_TrustHandlers.Clear();
		instance->m_Handlers.m_FilesHandlers.Clear();
		instance->m_Handlers.m_DeactivateHandlers.Clear();
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			instance->m_Provides.Clear();
			instance->m_Hears.Clear();
			instance->m_Contributed.Clear();
			instance->m_WantsTrust = false;
			instance->m_WantsFiles = false;
			Unregister(instance);
			while (instance->m_Running > 0) instance->m_Idle.Wait(m_Server->m_Lock);
		}
		instance->m_Context = nullptr;
		if (instance->m_Builtin) return;
		const int64 dropped = instance->m_Script->Unload();
		if (dropped > 0) m_Server->Log((((Core::String("plugin ") + instance->m_PluginId.View()) + ": unloaded with live objects, finalizers dropped: ") + Number(dropped).View()).View());
		instance->m_Script = nullptr;
		instance->m_Context = nullptr;
	}

	// --- Guarded calls -------------------------------------------------------------------------------------------------

	class GuardFrame
	{
		public func<void()> m_Body;
		public bool m_Threw;
	}

	static void RunGuardFrame(void* context) {
		GuardFrame* frame = (GuardFrame*)context;
		try {
			frame->m_Body();
		}
		catch (...) {
			frame->m_Threw = true;
		}
	}

	// Runs `body` guarded: 0 when it returned, 1 when it threw, 2 when it faulted (a script's code only; a built-in's
	// fault is the server's).
	static int32 RunGuarded(CodeInstance* instance, func<void()> body) {
		GuardFrame* frame = new GuardFrame();
		frame->m_Body = body;
		if (instance->m_Builtin) RunGuardFrame((void*)frame);
		else if (!instance->m_Script->Call(RunGuardFrame, (void*)frame)) return 2;
		return frame->m_Threw ? 1 : 0;
	}

	static Core::String FaultProblem(CodeInstance* instance) { return Core::String("its code faulted: ") + instance->m_Script->FaultText(); }

	static Core::String ThrowProblem() { return Core::String("its code threw an exception it did not catch"); }

	bool GuardedCall(CodeInstance* instance, func<void()> body, Core::String& problem) {
		const int32 outcome = RunGuarded(instance, body);
		if (outcome == 0) return true;
		problem = outcome == 2 ? FaultProblem(instance) : ThrowProblem();
		if (outcome == 2) instance->m_Runtime->Faulted(instance, problem.View());
		return false;
	}

	bool GuardedCallLocked(CodeInstance* instance, func<void()> body, Core::String& problem) {
		const int32 outcome = RunGuarded(instance, body);
		if (outcome == 0) return true;
		problem = outcome == 2 ? FaultProblem(instance) : ThrowProblem();
		if (outcome == 2) instance->m_Runtime->FaultedLocked(instance, problem.View());
		return false;
	}

	void CodeRuntime::Faulted(CodeInstance* instance, Core::StringView problem) {
		Threading::LockGuard guard(m_Server->m_Lock);
		FaultedLocked(instance, problem);
	}

	void CodeRuntime::FaultedLocked(CodeInstance* instance, Core::StringView problem) {
		instance->m_State = CodeState::Failed;
		instance->m_Problem = Core::String(problem);
		m_Server->Log((((Core::String("plugin ") + instance->m_PluginId.View()) + ": ") + problem).View());
		m_Server->m_Plugins->CodeChanged(instance);
	}

	bool InvokeCode(CodeInstance* instance, const Reflection::Function& function, void* result, void* argument, Core::String& problem) {
		void*[2] arguments = { argument, nullptr };
		bool invoked = false;
		const Reflection::Function* called = &function;
		void** given = &arguments[0];
		if (!GuardedCall(instance, [called, result, given, &invoked]() { invoked = called->Invoke(result, given); }, problem)) return false;
		if (!invoked) problem = (Core::String("reflection could not call ") + function.Name());
		return invoked;
	}

	// A type's name without `const` and spaces: a parameter taken by const reference or by reference fits alike.
	static Core::String BareType(Core::StringView name) {
		Core::StringBuilder bare;
		for (int64 i = 0; i < name.ByteLength(); ++i) {
			const bool starts = i == 0 || name.ByteAt(i - 1) == ' ' || name.ByteAt(i - 1) == '<' || name.ByteAt(i - 1) == ',';
			const bool ends = i + 5 == name.ByteLength() || name.ByteAt(i + 5) == ' ' || name.ByteAt(i + 5) == '&' || name.ByteAt(i + 5) == '*';
			if (starts && ends && name.Substring(i, name.ByteLength() - i).StartsWith(Core::StringView("const"))) {
				i += 4;
				continue;
			}
			if (name.ByteAt(i) != ' ') bare.AppendByte(name.ByteAt(i));
		}
		return bare.ToString();
	}

	static bool SameType(Core::StringView a, Core::StringView b) { return BareType(a).View() == BareType(b).View(); }

	Reflection::Function CodeFunction(CodeInstance* instance, Core::StringView name, Core::StringView returns, Core::StringView parameter, Core::String& problem) {
		Core::String qualified = Core::String(name);
		Reflection::Function function = instance->m_Builtin ? Reflection::FindFunction(qualified.CStr()) : instance->m_Script->FindFunction(qualified.CStr());
		Core::String wanted = ((((Core::String("`") + returns) + " ") + name) + "(") + parameter;
		wanted = wanted + ")`";
		if (!function.IsValid()) {
			problem = ((Core::String("its code has no function '") + name) + "' (wanted: ") + wanted.View();
			problem = problem + ")";
			return Reflection::Function(nullptr);
		}
		const bool fits = function.ParamCount() == 1 && SameType(Core::StringView(function.ReturnTypeName()), returns) && SameType(Core::StringView(function.ParamAt(0).TypeName()), parameter);
		if (!fits) {
			problem = (((Core::String("'") + name) + "' is not ") + wanted.View()) + ": it returns ";
			problem = problem + function.ReturnTypeName();
			if (function.ParamCount() > 0) problem = (problem + " and takes ") + function.ParamAt(0).TypeName();
			return Reflection::Function(nullptr);
		}
		if (!function.IsInvokable()) {
			problem = (Core::String("its function '") + name) + "' cannot be called through reflection";
			return Reflection::Function(nullptr);
		}
		return function;
	}

	// --- What it shows -------------------------------------------------------------------------------------------------

	IED::Workspace PluginWorkspace(Server* server, Workspace* ws) {
		IED::Workspace shown;
		shown.m_Id = ws->m_WsId;
		shown.m_Name = ws->m_Name;
		shown.m_Root = Core::String(ws->m_Root.View());
		shown.m_Kind = ws->m_Kind;
		shown.m_LocalState = Core::String(ws->m_LocalState.View());
		shown.m_Trusted = ws->m_Trusted;
		shown.m_Languages = WorkspaceLanguages(server, ws);
		if (!ws->m_Solution) return shown;
		for (ProjectModel* model : ws->m_Solution->m_Projects) {
			IED::Project project;
			project.m_Name = model->m_Name;
			Core::String folder;
			if (RelativeTo(ws->m_Root.View(), model->m_Root.View(), folder)) project.m_Folder = folder;
			project.m_Kind = model->m_Kind;
			project.m_Language = Core::String(model->m_Data.Member("language").AsView());
			if (!RelativeTo(ws->m_Root.View(), model->m_File.View(), project.m_File)) project.m_File = Core::String(model->m_File.View());
			Serialization::DomNode references = model->m_Data.Member("references");
			for (int64 i = 0; i < references.Count(); ++i) project.m_References.Push(Core::String(references.At(i).AsView()));
			shown.m_Projects.Push(project);
		}
		return shown;
	}

	void CodeRuntime::ComputedFor(CodeInstance* instance, Workspace* ws, Core::StringView point, Core::Array<Serialization::DomNode>& into) const {
		for (Contributed* given : instance->m_Contributed) {
			if (given->m_Point.View() != point) continue;
			if (!given->m_WsId.IsEmpty() && (!ws || given->m_WsId.View() != ws->m_WsId.View())) continue;
			for (int64 i = 0; i < given->m_Entries.Count(); ++i) into.Push(given->m_Entries.At(i));
		}
	}

	Core::String CodeRuntime::SummaryJson(CodeInstance* instance) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("state", CodeStateName(instance->m_State));
		if (!instance->m_Problem.IsEmpty()) json.Field("problem", instance->m_Problem.View());
		json.IntField("builds", instance->m_Builds);
		if (!instance->m_Builtin && instance->m_Script && instance->m_Script->Cached()) json.BoolField("cached", true);
		if (!instance->m_Builtin && instance->m_Script && m_Host != nullptr && m_Host->IsOpen() && m_Host->DebugScripts()) json.BoolField("debug", true);
		json.EndObject();
		return json.ToString();
	}
}
