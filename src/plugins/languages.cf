include "languages.ch"

namespace Ied
{
	static int32 FoldAscii(int32 c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }

	static bool SameIgnoringCase(Core::StringView a, Core::StringView b) {
		if (a.ByteLength() != b.ByteLength()) return false;
		for (int64 i = 0; i < a.ByteLength(); ++i)
			if (FoldAscii(a.ByteAt(i)) != FoldAscii(b.ByteAt(i))) return false;
		return true;
	}

	static bool Names(const Serialization::DomNode& list, Core::StringView value, bool foldCase) {
		for (int64 i = 0; i < list.Count(); ++i) {
			Core::StringView entry = list.At(i).AsView();
			if (foldCase ? SameIgnoringCase(entry, value) : entry == value) return true;
		}
		return false;
	}

	static Core::StringView FileNameOf(Core::StringView path) {
		int64 start = path.ByteLength();
		while (start > 0 && path.ByteAt(start - 1) != '/' && path.ByteAt(start - 1) != '\\') start -= 1;
		return path.Substring(start, path.ByteLength());
	}

	// ".cf" of "main.cf"; empty for "Makefile" and ".gitignore" (a leading dot names the file, not its extension).
	static Core::StringView ExtensionOf(Core::StringView name) {
		for (int64 i = name.ByteLength() - 1; i > 0; --i)
			if (name.ByteAt(i) == '.') return name.Substring(i, name.ByteLength());
		return Core::StringView();
	}

	Core::String LanguageFor(const Core::Array<Serialization::DomNode>& contributes, Core::StringView path) {
		Core::StringView name = FileNameOf(path);
		Core::StringView extension = ExtensionOf(name);
		Core::String byName;
		Core::String byExtension;
		for (const Serialization::DomNode& contribution : contributes) {
			Serialization::DomNode languages = contribution.Member("languages");
			for (int64 i = 0; i < languages.Count(); ++i) {
				Serialization::DomNode language = languages.At(i);
				Core::StringView id = language.Member("id").AsView();
				if (Names(language.Member("fileNames"), name, false)) byName = Core::String(id);
				if (!extension.IsEmpty() && Names(language.Member("extensions"), extension, true)) byExtension = Core::String(id);
			}
		}
		if (!byName.IsEmpty()) return byName;
		return byExtension.IsEmpty() ? Core::String(kPlainText) : byExtension;
	}
}
