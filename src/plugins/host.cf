include "host.ch"
include "../host/server.ch"

namespace Ied
{
	const char* PluginStateName(PluginState state) {
		if (state == PluginState::Loaded) return "loaded";
		if (state == PluginState::Disabled) return "disabled";
		if (state == PluginState::NeedsApproval) return "needsApproval";
		if (state == PluginState::Overridden) return "overridden";
		return "failed";
	}

	static void StringList(JsonWriter& json, const char* key, const Core::Array<Core::String>& items) {
		json.Key(Core::StringView(key));
		json.BeginArray();
		for (const Core::String& item : items) json.String(item.View());
		json.EndArray();
	}

	Core::String Plugin::SummaryJson() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("id", manifest->id.View());
		json.Field("name", manifest->name.View());
		json.Field("version", manifest->version.View());
		json.Field("kind", manifest->kind.View());
		json.Field("source", PluginSourceName(manifest->source));
		json.Field("state", PluginStateName(state));
		if (!overriddenBy.IsEmpty()) json.Field("overriddenBy", overriddenBy.View());
		StringList(json, "problems", manifest->problems);
		StringList(json, "permissions", manifest->permissions);
		Core::Array<Core::String> points;
		for (int64 i = 0; i < manifest->contributes.Count(); ++i) points.Push(Core::String(manifest->contributes.KeyAt(i)));
		StringList(json, "contributes", points);
		json.EndObject();
		return json.ToString();
	}

	void PluginHost::Init(Server* server) {
		this.server = server;
		PluginHost* self = this;
		server->hub.Add(Core::StringView("plugins"), [self]() -> Core::String { return self->Snapshot(); });
		server->rpc.Register("plugins.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->rpc.Register("plugins.setEnabled", [self](Call& call, const Params& params) -> Core::String { return self->SetEnabledMethod(call, params); });
		server->rpc.Register("plugins.approve", [self](Call& call, const Params& params) -> Core::String { return self->ApproveMethod(call, params); });
		server->rpc.Register("plugins.contributions", [self](Call& call, const Params& params) -> Core::String { return self->ContributionsMethod(call, params); });
		server->rpc.Register("plugins.reload", [self](Call& call, const Params& params) -> Core::String { return self->ReloadMethod(call, params); });
	}

	// --- Finding and choosing ------------------------------------------------------------------------------------------

	void PluginHost::Discover(const FS::Path& folder, PluginSource source, Core::Array<Manifest*>& found) {
		if (folder.IsEmpty() || !FS::IsDirectory(folder.CStr())) return;
		FS::Directory listing = FS::Directory(folder.CStr());
		for (FS::DirectoryEntry& entry : listing) {
			FS::Path candidate = folder / entry.name.View();
			if (entry.kind == FS::EntryKind::Directory && FS::FileExists((candidate / kManifestFile).CStr()))
				found.Push(ReadManifest(candidate, source, *schemas, schemaName.View()));
		}
	}

	static int32 Precedence(PluginSource source) { return source == PluginSource::Project ? 3 : source == PluginSource::App ? 2 : 1; }

	// The state a plugin would have on its own: its problems, the owner's approval, the owner's switch.
	static PluginState OwnState(Plugin* plugin, const Core::HashMap<Core::String, Core::String>& approved, const Core::HashMap<Core::String, bool>& disabled) {
		Manifest* manifest = plugin->manifest;
		if (!manifest->problems.IsEmpty()) return PluginState::Failed;
		if (manifest->source == PluginSource::App) {
			plugin->digest = FolderDigest(manifest->folder);
			Core::String allowed;
			if (!approved.TryGet(manifest->id, allowed) || allowed.View() != plugin->digest.View()) return PluginState::NeedsApproval;
		}
		return disabled.Contains(manifest->id) ? PluginState::Disabled : PluginState::Loaded;
	}

	// Of the plugins with one id, the one from the strongest source that can load wins; those under it are overridden.
	void PluginHost::Choose(const Core::Array<Manifest*>& found) {
		plugins.Clear();
		Core::HashMap<Core::String, Plugin*> winners;
		for (Manifest* manifest : found) {
			Plugin* plugin = new Plugin();
			plugin->manifest = manifest;
			plugin->state = OwnState(plugin, approved, disabled);
			plugins.Push(plugin);
		}
		for (Plugin* plugin : plugins) {
			if (plugin->state == PluginState::Failed || plugin->state == PluginState::NeedsApproval) continue;
			Plugin* best = nullptr;
			const bool known = winners.TryGet(plugin->manifest->id, best);
			if (!known || Precedence(plugin->manifest->source) > Precedence(best->manifest->source)) winners.At(plugin->manifest->id) = plugin;
		}
		for (Plugin* plugin : plugins) {
			Plugin* winner = nullptr;
			if (!winners.TryGet(plugin->manifest->id, winner) || winner == plugin) continue;
			if (Precedence(plugin->manifest->source) > Precedence(winner->manifest->source)) continue;
			plugin->state = PluginState::Overridden;
			plugin->overriddenBy = Core::String(PluginSourceName(winner->manifest->source));
		}
	}

	static Plugin* LoadedWithId(const Core::Array<Plugin*>& plugins, Core::StringView id) {
		for (Plugin* plugin : plugins)
			if (plugin->state == PluginState::Loaded && plugin->manifest->id.View() == id) return plugin;
		return nullptr;
	}

	// Whether `plugin` reaches itself through required dependencies on loaded plugins.
	static bool InCycle(const Core::Array<Plugin*>& plugins, Plugin* start, Plugin* at, int32 depth) {
		if (depth > plugins.Count()) return false;
		for (Dependency* dependency : at->manifest->dependencies) {
			Plugin* next = dependency->optional ? nullptr : LoadedWithId(plugins, dependency->id.View());
			if (next == start || (next && InCycle(plugins, start, next, depth + 1))) return true;
		}
		return false;
	}

	static bool Unmet(const Core::Array<Plugin*>& plugins, Plugin* plugin) {
		for (Dependency* dependency : plugin->manifest->dependencies) {
			if (dependency->optional) continue;
			Plugin* needed = LoadedWithId(plugins, dependency->id.View());
			if (needed && VersionInRange(needed->manifest->version.View(), dependency->version.View())) continue;
			Core::String why = (((Core::String("needs ") + dependency->id.View()) + " ") + dependency->version.View());
			plugin->manifest->problems.Push(needed ? (why + ", but " + needed->manifest->version.View() + " is loaded") : (why + ", which is not loaded"));
			return true;
		}
		if (!InCycle(plugins, plugin, plugin, 0)) return false;
		plugin->manifest->problems.Push(Core::String("its dependencies lead back to it"));
		return true;
	}

	// A plugin whose dependency fails fails too, so this repeats until nothing changes.
	void PluginHost::CheckDependencies() {
		bool changed = true;
		while (changed) {
			changed = false;
			for (Plugin* plugin : plugins)
				if (plugin->state == PluginState::Loaded && Unmet(plugins, plugin)) {
					plugin->state = PluginState::Failed;
					changed = true;
				}
		}
	}

	void PluginHost::Load() {
		ReadChoices();
		schemas = new Serialization::SchemaRegistry();
		FS::Path home = FS::Path(HomeFolder(server->config).View());
		FS::Path schema = home / "shared" / "host-api" / "schemas" / "plugin-manifest.v1.schema.json";
		schemaName = Core::String(schema.View());
		Core::String error;
		if (!schemas->Load(schemaName.View(), error)) server->Log((Core::String("plugins cannot be validated: ") + error.View()).View());
		Core::Array<Manifest*> found;
		Discover(home.IsEmpty() ? FS::Path() : home / "plugins", PluginSource::BuiltIn, found);
		Discover(FS::Path(AppDataFolder(server->config).View()) / "plugins", PluginSource::App, found);
		Choose(found);
		CheckDependencies();
		for (Plugin* plugin : plugins)
			for (const Core::String& problem : plugin->manifest->problems)
				server->Log((((Core::String("plugin ") + plugin->manifest->id.View()) + ": ") + problem.View()).View());
		Changed();
	}

	Plugin* PluginHost::Get(Core::StringView id) const {
		for (Plugin* plugin : plugins)
			if (plugin->manifest->id.View() == id && plugin->state == PluginState::Loaded) return plugin;
		for (Plugin* plugin : plugins)
			if (plugin->manifest->id.View() == id) return plugin;
		return nullptr;
	}

	FS::Path PluginHost::FileOf(Core::StringView id, Core::StringView path) const {
		Plugin* plugin = LoadedWithId(plugins, id);
		if (!plugin) return FS::Path();
		Core::String relative;
		try {
			relative = NormalizePath(path);
		}
		catch (RpcError& refused) {
			return FS::Path();
		}
		FS::Path file = plugin->manifest->folder / relative.View();
		return !relative.IsEmpty() && FS::FileExists(file.CStr()) ? file : FS::Path();
	}

	// --- The owner's choices -------------------------------------------------------------------------------------------

	static FS::Path ChoicesFile(const ServerConfig& config) { return FS::Path(AppDataFolder(config).View()) / "plugins.json"; }

	void PluginHost::ReadChoices() {
		disabled.Clear();
		approved.Clear();
		FS::Path file = ChoicesFile(server->config);
		if (!FS::FileExists(file.CStr())) return;
		FS::File opened = FS::File(file.CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJsonc(text.View(), *doc);
		if (!read.Ok()) {
			server->Log((Core::String("ignoring ") + file.View() + ": not JSON").View());
			return;
		}
		Serialization::DomNode off = read.root.Member("disabled");
		for (int64 i = 0; i < off.Count(); ++i) disabled.At(Core::String(off.At(i).AsView())) = true;
		Serialization::DomNode allowed = read.root.Member("approved");
		for (int64 i = 0; i < allowed.Count(); ++i) approved.At(Core::String(allowed.KeyAt(i))) = Core::String(allowed.ValueAt(i).AsView());
	}

	bool PluginHost::SaveChoices() const {
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Key(Core::StringView("disabled"));
		json.BeginArray();
		for (const Core::KeyValue<Core::String, bool>& entry : disabled) json.String(entry.key.View());
		json.EndArray();
		json.Key(Core::StringView("approved"));
		json.BeginObject();
		for (const Core::KeyValue<Core::String, Core::String>& entry : approved) json.Field(entry.key.CStr(), entry.value.View());
		json.EndObject();
		json.EndObject();
		FS::Path file = ChoicesFile(server->config);
		FS::MakeDirectories(file.Parent().CStr());
		return FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength());
	}

	// --- The topic and the methods -------------------------------------------------------------------------------------

	Core::String PluginHost::Snapshot() const {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("plugins"));
		json.BeginArray();
		for (Plugin* plugin : plugins) json.Raw(plugin->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void PluginHost::Changed() { server->hub.Publish(Core::StringView("plugins"), "plugins.changed", Snapshot().View()); }

	Core::String PluginHost::ListMethod(Call& call, const Params& params) { return Snapshot(); }

	static Plugin* Known(PluginHost* host, Core::StringView id) {
		Plugin* plugin = host->Get(id);
		if (!plugin) throw RpcError(ErrorCode::NotFound, (Core::String("no plugin ") + id).View());
		return plugin;
	}

	Core::String PluginHost::SetEnabledMethod(Call& call, const Params& params) {
		Core::String id = params.Str("id");
		Known(this, id.View());
		if (params.Bool("enabled", true)) disabled.Remove(id);
		else disabled.At(id) = true;
		if (!SaveChoices()) throw RpcError(ErrorCode::Unavailable, "the plugin choices could not be saved");
		Load();
		return Get(id.View())->SummaryJson();
	}

	Core::String PluginHost::ApproveMethod(Call& call, const Params& params) {
		Core::String id = params.Str("id");
		Plugin* plugin = nullptr;
		for (Plugin* candidate : plugins)
			if (candidate->manifest->id.View() == id.View() && candidate->manifest->source == PluginSource::App) plugin = candidate;
		if (!plugin) throw RpcError(ErrorCode::NotFound, (Core::String("no app plugin ") + id.View()).View());
		approved.At(id) = FolderDigest(plugin->manifest->folder);
		if (!SaveChoices()) throw RpcError(ErrorCode::Unavailable, "the plugin choices could not be saved");
		server->auth->Record("plugin-approved", (Core::String("\"plugin\":") + JsonString(id.View()).View()).View());
		Load();
		return Get(id.View())->SummaryJson();
	}

	Core::String PluginHost::ContributionsMethod(Call& call, const Params& params) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("plugins"));
		json.BeginArray();
		for (Plugin* plugin : plugins) {
			if (plugin->state != PluginState::Loaded) continue;
			json.BeginObject();
			json.Field("id", plugin->manifest->id.View());
			json.Field("source", PluginSourceName(plugin->manifest->source));
			json.RawField("contributes", plugin->manifest->contributes.IsValid() ? NodeJson(plugin->manifest->contributes).View() : Core::StringView("{}"));
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String PluginHost::ReloadMethod(Call& call, const Params& params) {
		Load();
		return Snapshot();
	}
}
