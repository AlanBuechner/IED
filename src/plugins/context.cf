include "context.ch"
include "host/server.ch"

namespace Ied
{
	static int32 FoldAscii(int32 c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }

	static bool SameIgnoringCase(Core::StringView a, Core::StringView b) {
		if (a.ByteLength() != b.ByteLength()) return false;
		for (int64 i = 0; i < a.ByteLength(); ++i)
			if (FoldAscii(a.ByteAt(i)) != FoldAscii(b.ByteAt(i))) return false;
		return true;
	}

	bool MarkerNamed(const Core::Array<Core::String>& names, Core::StringView marker) {
		const bool byEnding = marker.StartsWith(Core::StringView("*."));
		Core::StringView ending = byEnding ? marker.Substring(1, marker.ByteLength() - 1) : marker;
		for (const Core::String& name : names) {
			Core::StringView view = name.View();
			if (!byEnding && SameIgnoringCase(view, marker)) return true;
			if (byEnding && view.ByteLength() > ending.ByteLength() && SameIgnoringCase(view.Substring(view.ByteLength() - ending.ByteLength(), ending.ByteLength()), ending)) return true;
		}
		return false;
	}

	Core::Array<Core::String> FolderNames(const FS::Path& folder) {
		Core::Array<Core::String> names;
		if (!FS::IsDirectory(folder.CStr())) return names;
		FS::Directory listing = FS::Directory(folder.CStr());
		for (FS::DirectoryEntry& entry : listing) names.Push(entry.name);
		return names;
	}

	static void AddOnce(Core::Array<Core::String>& into, Core::StringView value) {
		if (value.IsEmpty()) return;
		for (const Core::String& known : into)
			if (known.View() == value) return;
		into.Push(Core::String(value));
	}

	// The languages whose projectIcons markers lie in `root`.
	static void MarkedLanguages(const Core::Array<Serialization::DomNode>& icons, const FS::Path& root, Core::Array<Core::String>& into) {
		Core::Array<Core::String> names = FolderNames(root);
		for (const Serialization::DomNode& icon : icons) {
			Serialization::DomNode markers = icon.Member("markers");
			for (int64 i = 0; i < markers.Count(); ++i)
				if (MarkerNamed(names, markers.At(i).AsView())) AddOnce(into, icon.Member("languageId").AsView());
		}
	}

	Core::Array<Core::String> WorkspaceLanguages(Server* server, Workspace* ws) {
		Core::Array<Core::String> languages;
		Core::Array<Serialization::DomNode> icons;
		for (const Contribution& given : server->plugins->Entries(ws, Core::StringView("projectIcons"))) icons.Push(given.entry);
		MarkedLanguages(icons, ws->root, languages);
		if (ws->solution)
			for (ProjectModel* project : ws->solution->projects) {
				AddOnce(languages, project->data.Member("language").AsView());
				MarkedLanguages(icons, project->root, languages);
			}
		return languages;
	}

	// What workspaceLanguage.<id> reads: the workspace's languages, worked out once.
	class LanguagesOnce
	{
		public bool read;
		public Core::Array<Core::String> languages;
	}

	WhenLookup WorkspaceWhen(Server* server, Workspace* ws) {
		Settings* settings = server->settings;
		LanguagesOnce* once = new LanguagesOnce();
		return [server, ws, settings, once](Core::StringView key) -> WhenValue {
			if (key == "workspaceTrusted") return WhenBool(ws->trusted);
			if (key == "workspaceKind") return WhenText(ws->kind.View());
			if (key.StartsWith(Core::StringView("config."))) return WhenFromJson(settings->Effective(ws, Core::StringView(""), key.Substring(7, key.ByteLength() - 7)).View());
			if (key.StartsWith(Core::StringView("workspaceContains."))) {
				FS::Path path = ws->root / key.Substring(18, key.ByteLength() - 18);
				return WhenBool(FS::FileExists(path.CStr()) || FS::IsDirectory(path.CStr()));
			}
			if (!key.StartsWith(Core::StringView("workspaceLanguage."))) return WhenNone();
			if (!once->read) {
				once->languages = WorkspaceLanguages(server, ws);
				once->read = true;
			}
			Core::StringView id = key.Substring(18, key.ByteLength() - 18);
			for (const Core::String& language : once->languages)
				if (language.View() == id) return WhenBool(true);
			return WhenBool(false);
		};
	}
}
