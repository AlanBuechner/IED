include "session.ch"
include "lsp/framing.ch"
include "host/server.ch"

namespace Ied
{
	const int64 kDapReadBytes = 65536;
	const int64 kDapWaitSliceNs = 50000000;
	const int64 kDapWriterSliceMs = 200;
	const int64 kDapStackFrames = 20;

	const char* DebugStateName(DebugState state) {
		if (state == DebugState::Building) return "building";
		if (state == DebugState::Starting) return "starting";
		if (state == DebugState::Running) return "running";
		if (state == DebugState::Stopped) return "stopped";
		if (state == DebugState::Ended) return "ended";
		return "failed";
	}

	void DebugSession::Init(Server* server, Workspace* ws, Core::StringView id, const DebugLaunch& launch) {
		this.server = server;
		this.ws = ws;
		this.id = Core::String(id);
		this.launch = launch;
		this.state = DebugState::Building;
		this.capabilities = Core::String("{}");
		this.threads = Core::String("[]");
		this.frames = Core::String("[]");
		this.nextSeq = 1;
	}

	Core::String DebugSession::SummaryJson() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("id", id.View());
		json.Field("name", launch.name.View());
		json.Field("project", launch.project.View());
		json.Field("type", launch.type.View());
		json.Field("state", DebugStateName(state));
		json.IntField("revision", revision);
		json.Field("problem", problem.View());
		json.Key(Core::StringView("exitCode"));
		if (exited) json.Int(exitCode);
		else json.Null();
		json.Key(Core::StringView("stop"));
		if (state == DebugState::Stopped) {
			json.BeginObject();
			json.IntField("threadId", stopThread);
			json.Field("reason", stopReason.View());
			json.Field("description", stopDescription.View());
			json.EndObject();
		}
		else json.Null();
		json.EndObject();
		return json.ToString();
	}

	// --- Starting ----------------------------------------------------------------------------------------------------

	static ProfileVariables VariablesOf(Server* server, Workspace* ws, const DapProvider* provider, Core::StringView project) {
		ProfileVariables variables;
		variables.pluginDir = Core::String(provider->pluginDir.View());
		variables.workspaceDir = Core::String(ws->root.View());
		variables.solutionDir = Core::String(ws->root.View());
		variables.projectName = Core::String(project);
		Settings* settings = server->settings;
		variables.config = [settings, ws](Core::StringView key) -> Core::String { return settings->Effective(ws, Core::StringView(""), key); };
		variables.iedHome = server->config.homeDir;
		variables.pluginState = Core::String((FS::Path(server->config.dataDir.View()) / "plugins" / provider->pluginId.View()).View());
		Tools* tools = server->tools;
		variables.tool = [tools, ws](Core::StringView id) -> Core::String { return tools->ProgramFor(ws, id); };
		return variables;
	}

	// As a language server's (docs/24): with launchMode staged, a copy of the adapter's folder keyed by the program's
	// size and time, so the adapter can be rebuilt while a session runs.
	Core::String DebugSession::ProgramToRun(Core::String& error) const {
		if (server->tools->LacksProgram(ws, provider->command.View(), error)) return Core::String();
		Core::String command = ExpandProfileVariables(provider->command.View(), VariablesOf(server, ws, provider, launch.project.View()));
		FS::Path program = FS::AbsolutePath(command.CStr());
		if (!provider->staged) return command;
		FS::FileInfo info;
		if (!FS::GetInfo(program.CStr(), info)) {
			error = Core::String("no program ") + command.View();
			return Core::String();
		}
		Core::StringBuilder key;
		key.AppendInt(info.size);
		key.Append("-");
		key.AppendInt(info.modifiedNs);
		FS::Path stage = FS::Path(server->config.stateDir.View()) / "dap-stage" / provider->type.View() / key.View();
		FS::Path staged = stage / program.FileName();
		if (!FS::FileExists(staged.CStr()) && FS::CopyTree(program.Parent().CStr(), stage.CStr()) < 0) {
			error = Core::String("cannot stage ") + program.Parent().View() + " in " + stage.View();
			return Core::String();
		}
		return Core::String(staged.View());
	}

	// `text` with ${port} as the port IED listens on for the adapter.
	static Core::String WithPort(Core::StringView text, int32 port) {
		const int64 at = text.IndexOf(Core::StringView("${port}"));
		if (at < 0) return Core::String(text);
		Core::StringBuilder out;
		out.Append(text.Substring(0, at));
		out.AppendInt(port);
		out.Append(text.Substring(at + 7, text.ByteLength()));
		return out.ToString();
	}

	// Over stdio the adapter's input and output are the protocol; over tcp its output and errors are only a log.
	Process::StartInfo DebugSession::StartInfoFor(Core::StringView program, int32 port) const {
		ProfileVariables variables = VariablesOf(server, ws, provider, launch.project.View());
		Process::StartInfo info;
		info.program = Core::String(program);
		for (const Core::String& arg : provider->args) ExpandProfileArgument(WithPort(arg.View(), port).View(), variables, info.arguments);
		for (const Core::String& entry : provider->environment) info.environment.Push(ExpandProfileVariables(entry.View(), variables));
		info.environment = server->tools->EnvironmentFor(ws, info.environment);
		info.workingDirectory = provider->cwd.IsEmpty() ? Core::String(ws->root.View()) : ExpandProfileVariables(provider->cwd.View(), variables);
		info.input = provider->tcp ? Process::Redirect::Null : Process::Redirect::Pipe;
		info.output = Process::Redirect::Pipe;
		info.errors = provider->tcp ? Process::Redirect::ToOutput : Process::Redirect::Pipe;
		return info;
	}

	static Core::String InitializeArguments(Core::StringView type) {
		JsonWriter json;
		json.BeginObject();
		json.Field("clientID", "ied");
		json.Field("clientName", "IED");
		json.Field("adapterID", type);
		json.Field("locale", "en");
		json.BoolField("linesStartAt1", true);
		json.BoolField("columnsStartAt1", true);
		json.Field("pathFormat", "path");
		json.BoolField("supportsVariableType", true);
		json.BoolField("supportsVariablePaging", false);
		json.BoolField("supportsRunInTerminalRequest", false);
		json.BoolField("supportsStartDebuggingRequest", false);
		json.EndObject();
		return json.ToString();
	}

	void DebugSession::Start(DapProvider* provider) {
		this.provider = provider;
		state = DebugState::Starting;
		Core::String error;
		Core::String program = ProgramToRun(error);
		if (program.IsEmpty()) {
			Fail(error.View());
			return;
		}
		Net::TcpListener* listener = nullptr;
		int32 port = 0;
		if (provider->tcp) {
			listener = new Net::TcpListener();
			if (!listener->Listen(Net::Address::Loopback(0))) {
				Fail((Core::String("cannot listen for the debug adapter: ") + listener->Error()).View());
				return;
			}
			port = listener->LocalAddress().port;
		}
		Process::Child started = Process::Child::Start(StartInfoFor(program.View(), port));
		if (!started.IsOpen()) {
			if (listener) listener->Close();
			Fail(((Core::String("cannot start the ") + provider->label.View()) + " debug adapter: " + started.Error()).View());
			return;
		}
		run += 1;
		const int64 thisRun = run;
		child = new Process::Child(take(started));
		outgoing = new MessageQueue();
		DebugSession* self = this;
		Process::Child* process = child;
		MessageQueue* queue = outgoing;
		if (listener) {
			Threading::Thread::Run([self, listener, process, queue, thisRun]() { self->AcceptLoop(listener, process, queue, thisRun); }).Detach();
			Threading::Thread::Run([self, process, thisRun]() { self->ErrorLoop(process, Process::Stream::Output, thisRun); }).Detach();
		}
		else {
			DapChannel* channel = new DapChannel();
			channel->child = process;
			Talk(channel, process, queue, thisRun);
			Threading::Thread::Run([self, process, thisRun]() { self->ErrorLoop(process, Process::Stream::Errors, thisRun); }).Detach();
		}
		Ask(Core::StringView("initialize"), InitializeArguments(provider->type.View()).View(), [self](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			self->Initialized(ok, body, message);
		});
		server->debugger->StateChanged(this);
	}

	// The adapter's capabilities are in: the program is launched (or attached to); the adapter's `initialized` event
	// then asks for the breakpoints (docs/25 "Sessions").
	void DebugSession::Initialized(bool ok, const Serialization::DomNode& body, Core::StringView message) {
		if (!ok) {
			Fail((Core::String("the debug adapter refused initialize: ") + message).View());
			return;
		}
		capabilities = body.IsValid() ? NodeJson(body) : Core::String("{}");
		DebugSession* self = this;
		Ask(launch.request.View(), launch.arguments.View(), [self](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			if (!ok) self->Fail(((Core::String("the program could not be started: ") + message)).View());
		});
	}

	// --- Talking -----------------------------------------------------------------------------------------------------

	void DebugSession::Write(Core::StringView json) {
		if (outgoing) outgoing->Push(FrameMessage(json).View());
	}

	int64 DebugSession::Send(Core::StringView command, Core::StringView arguments, DapAnswer* answer) {
		const int64 seq = nextSeq;
		nextSeq += 1;
		answers.Insert(seq, answer);
		JsonWriter json;
		json.BeginObject();
		json.IntField("seq", seq);
		json.Field("type", "request");
		json.Field("command", command);
		json.RawField("arguments", arguments.IsEmpty() ? Core::StringView("{}") : arguments);
		json.EndObject();
		Write(json.View());
		return seq;
	}

	void DebugSession::Ask(Core::StringView command, Core::StringView arguments, DapThen then) {
		DapAnswer* answer = new DapAnswer();
		answer->then = then;
		answer->hasThen = true;
		Send(command, arguments, answer);
	}

	Core::String DebugSession::Request(Call& call, Core::StringView command, Core::StringView arguments) {
		if (!child || !IsLive()) throw RpcError(ErrorCode::Unavailable, (Core::String("the debug session is ") + DebugStateName(state)).View());
		DapAnswer* answer = new DapAnswer();
		answer->wake = call.cancel;
		const int64 seq = Send(command, arguments, answer);
		const int64 deadline = clock_now_ns() + kDapRequestTimeoutMs * 1000000;
		while (!answer->done && !call.cancel->IsCancelled() && clock_now_ns() < deadline) call.cancel->wake.WaitFor(server->lock, kDapWaitSliceNs);
		answers.Remove(seq);
		if (answer->done && answer->ok) return answer->body;
		if (answer->done) throw RpcError(ErrorCode::PluginError, answer->message.IsEmpty() ? Core::StringView("the debug adapter failed") : answer->message.View());
		if (call.cancel->IsCancelled()) throw RpcError(ErrorCode::Cancelled, "request cancelled");
		throw RpcError(ErrorCode::Timeout, (Core::String(command) + " took longer than the debug adapter's time").View());
	}

	void DebugSession::Stop() {
		if (!IsLive()) return;
		if (!child) {
			state = DebugState::Ended;
			server->debugger->StateChanged(this);
			return;
		}
		const bool terminate = capabilities.View().Contains(Core::StringView("\"supportsTerminateRequest\":true"));
		DebugSession* self = this;
		Ask(terminate ? Core::StringView("terminate") : Core::StringView("disconnect"), Core::StringView("{}"), [self](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			if (!ok) self->Ask(Core::StringView("disconnect"), Core::StringView("{\"terminateDebuggee\":true}"), [](bool ok, const Serialization::DomNode& body, Core::StringView message) {});
		});
		Process::Child* process = child;
		Threading::Thread::Run([process]() { if (process->Wait(kDapExitGraceMs * 2) == Process::kTimedOut) process->Kill(); }).Detach();
	}

	void DebugSession::Fail(Core::StringView why) {
		state = DebugState::Failed;
		problem = Core::String(why);
		if (child) child->Kill();
		server->debugger->StateChanged(this);
	}

	// --- What the adapter sends --------------------------------------------------------------------------------------

	void DebugSession::Dispatch(Core::StringView body) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(body, *doc);
		if (!read.Ok()) {
			server->debugger->Log(this, (Core::String("a message that is not JSON: ") + body.Substring(0, 200)).View());
			return;
		}
		Core::StringView type = read.root.Member("type").AsView();
		if (type == "response") Answered(read.root);
		else if (type == "event") Happened(read.root.Member("event").AsView(), read.root.Member("body"));
		else if (type == "request") Respond(read.root);
	}

	void DebugSession::Answered(const Serialization::DomNode& message) {
		const int64 seq = message.Member("request_seq").AsInt();
		DapAnswer** found = answers.Find(seq);
		if (!found) return;
		DapAnswer* answer = *found;
		answer->done = true;
		answer->ok = message.Member("success").AsBool();
		answer->body = message.Member("body").IsValid() ? NodeJson(message.Member("body")) : Core::String("null");
		answer->message = Core::String(message.Member("message").AsView());
		Serialization::DomNode error = message.Member("body").Member("error").Member("format");
		if (!answer->ok && error.Kind() == Serialization::DomKind::String) answer->message = Core::String(error.AsView());
		if (answer->hasThen) {
			answers.Remove(seq);
			answer->then(answer->ok, message.Member("body"), answer->message.View());
		}
		else if (answer->wake) answer->wake->wake.NotifyAll();
	}

	// Reverse requests IED does not take yet (runInTerminal, startDebugging) are refused, so the adapter does without.
	void DebugSession::Respond(const Serialization::DomNode& request) {
		JsonWriter json;
		json.BeginObject();
		json.IntField("seq", nextSeq);
		nextSeq += 1;
		json.Field("type", "response");
		json.IntField("request_seq", request.Member("seq").AsInt());
		json.Field("command", request.Member("command").AsView());
		json.BoolField("success", false);
		json.Field("message", (Core::String("IED does not take ") + request.Member("command").AsView()).View());
		json.EndObject();
		Write(json.View());
	}

	void DebugSession::Happened(Core::StringView event, const Serialization::DomNode& body) {
		if (event == "initialized") server->debugger->Configure(this);
		else if (event == "stopped") Stopped(body);
		else if (event == "continued") Continued();
		else if (event == "exited") {
			exited = true;
			exitCode = body.Member("exitCode").AsInt();
		}
		else if (event == "terminated") Terminated();
		else if (event == "process") Named(body);
		else server->debugger->Event(this, event, body);
	}

	// The adapter named the program's process: what it uses is sampled from now on (docs/25 "Diagnostic Tools").
	void DebugSession::Named(const Serialization::DomNode& body) {
		const int64 processId = body.Member("systemProcessId").AsInt();
		if (processId <= 0 || usage) return;
		usage = new ProgramUsage();
		usage->processId = (uint32)processId;
		usage->name = Core::String(body.Member("name").AsView());
		server->debugger->ProgramNamed(this);
	}

	// The program stopped: its threads and the stopped thread's top frames are fetched before clients hear of it, so
	// the stop arrives with where it is.
	void DebugSession::Stopped(const Serialization::DomNode& body) {
		state = DebugState::Stopped;
		revision += 1;
		stopThread = body.Member("threadId").AsInt();
		stopReason = Core::String(body.Member("reason").AsView());
		stopDescription = Core::String(body.Member("description").AsView().IsEmpty() ? body.Member("text").AsView() : body.Member("description").AsView());
		const int64 stopped = revision;
		DebugSession* self = this;
		Ask(Core::StringView("threads"), Core::StringView("{}"), [self, stopped](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			self->threads = ok ? NodeJson(body.Member("threads")) : Core::String("[]");
			if (self->stopThread == 0 && ok && body.Member("threads").Count() > 0) self->stopThread = body.Member("threads").At(0).Member("id").AsInt();
			self->FetchFrames(stopped);
		});
	}

	void DebugSession::FetchFrames(int64 stopped) {
		JsonWriter arguments;
		arguments.BeginObject();
		arguments.IntField("threadId", stopThread);
		arguments.IntField("startFrame", 0);
		arguments.IntField("levels", kDapStackFrames);
		arguments.EndObject();
		DebugSession* self = this;
		Ask(Core::StringView("stackTrace"), arguments.View(), [self, stopped](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			if (self->revision != stopped) return;
			self->frames = ok ? NodeJson(body.Member("stackFrames")) : Core::String("[]");
			self->server->debugger->StopShown(self);
		});
	}

	void DebugSession::Continued() {
		if (state != DebugState::Stopped) return;
		Ran();
	}

	void DebugSession::Ran() {
		state = DebugState::Running;
		revision += 1;
		frames = Core::String("[]");
		server->debugger->StateChanged(this);
	}

	void DebugSession::Terminated() {
		if (!IsLive()) return;
		state = DebugState::Ended;
		server->debugger->StateChanged(this);
		Ask(Core::StringView("disconnect"), Core::StringView("{}"), [](bool ok, const Serialization::DomNode& body, Core::StringView message) {});
		Process::Child* process = child;
		Threading::Thread::Run([process]() { if (process->Wait(kDapExitGraceMs) == Process::kTimedOut) process->Kill(); }).Detach();
	}

	// --- Ending ------------------------------------------------------------------------------------------------------

	// The adapter's process ended (lock held): waiting requests fail, and a session that had not ended has now.
	void DebugSession::Exited() {
		for (const Core::KeyValue<int64, DapAnswer*>& entry : answers) {
			entry.value->done = true;
			entry.value->ok = false;
			entry.value->message = Core::String("the debug adapter exited");
			if (entry.value->wake) entry.value->wake->wake.NotifyAll();
		}
		answers.Clear();
		if (outgoing) outgoing->Close();
		if (!IsLive()) return;
		if (state == DebugState::Starting) Fail(Core::StringView("the debug adapter exited before the program started"));
		else {
			state = DebugState::Ended;
			server->debugger->StateChanged(this);
		}
	}

	// --- The threads -------------------------------------------------------------------------------------------------

	// A writer and a reader on `channel`; messages queued before it opened (initialize) go first.
	void DebugSession::Talk(DapChannel* channel, Process::Child* process, MessageQueue* queue, int64 thisRun) {
		DebugSession* self = this;
		Threading::Thread::Run([self, channel, queue]() { self->WriteLoop(channel, queue); }).Detach();
		Threading::Thread::Run([self, channel, process, thisRun]() { self->ReadLoop(channel, process, thisRun); }).Detach();
	}

	// Transport tcp: the adapter connects to the port it was given, within kDapConnectTimeoutMs.
	void DebugSession::AcceptLoop(Net::TcpListener* listener, Process::Child* process, MessageQueue* queue, int64 thisRun) {
		Net::TcpStream accepted = listener->Accept(kDapConnectTimeoutMs);
		const Core::String why = Core::String(listener->Error());
		listener->Close();
		Threading::LockGuard guard(server->lock);
		if (run != thisRun) return;
		if (!accepted.IsOpen()) {
			Fail((Core::String("the debug adapter did not connect: ") + (why.IsEmpty() ? Core::StringView("it took too long") : why.View())).View());
			return;
		}
		DapChannel* channel = new DapChannel();
		channel->child = process;
		channel->stream = new Net::TcpStream(take(accepted));
		Talk(channel, process, queue, thisRun);
	}

	void DebugSession::WriteLoop(DapChannel* channel, MessageQueue* queue) {
		Core::String message;
		while (queue->Next(message, kDapWriterSliceMs) || !queue->IsClosed()) {
			if (!message.IsEmpty() && !channel->Write(message.View())) return;
			message = Core::String();
		}
	}

	void DebugSession::ReadLoop(DapChannel* channel, Process::Child* process, int64 thisRun) {
		FrameReader frames;
		char[kDapReadBytes] buffer;
		for (;;) {
			const int64 got = channel->Read((void*)&buffer[0], kDapReadBytes);
			if (got <= 0) break;
			frames.Feed(Core::StringView(&buffer[0], got));
			Core::String body;
			while (frames.Next(body)) {
				Threading::LockGuard guard(server->lock);
				if (run == thisRun) Dispatch(body.View());
			}
			if (frames.Failed()) {
				Threading::LockGuard guard(server->lock);
				if (run == thisRun) server->debugger->Log(this, frames.Failure());
				process->Kill();
				break;
			}
		}
		if (channel->stream) channel->stream->Close();
		if (process->Wait(kDapExitGraceMs) == Process::kTimedOut) process->Kill();
		Threading::LockGuard guard(server->lock);
		if (run == thisRun) Exited();
	}

	void DebugSession::ErrorLoop(Process::Child* process, Process::Stream stream, int64 thisRun) {
		char[kDapReadBytes] buffer;
		for (;;) {
			const int64 got = process->Read(stream, (void*)&buffer[0], kDapReadBytes);
			if (got <= 0) break;
			Threading::LockGuard guard(server->lock);
			if (run == thisRun) server->debugger->Log(this, Core::StringView(&buffer[0], got));
		}
	}
}
