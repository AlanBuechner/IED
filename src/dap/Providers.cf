include "Providers.ch"

namespace Ied
{
	static Core::Array<Core::String> Strings(const Serialization::DomNode& list) {
		Core::Array<Core::String> strings;
		for (int64 i = 0; list.Kind() == Serialization::DomKind::Array && i < list.Count(); ++i) strings.Push(Core::String(list.At(i).AsView()));
		return strings;
	}

	DapProvider* ReadDapProvider(const Serialization::DomNode& node, Core::StringView pluginId, const FS::Path& pluginDir) {
		DapProvider* provider = new DapProvider();
		provider->m_Type = Core::String(node.Member("type").AsView());
		provider->m_Label = node.Member("label").AsView().IsEmpty() ? provider->m_Type : Core::String(node.Member("label").AsView());
		provider->m_PluginId = Core::String(pluginId);
		provider->m_PluginDir = pluginDir;
		provider->m_Command = Core::String(node.Member("command").AsView());
		provider->m_Args = Strings(node.Member("args"));
		Serialization::DomNode env = node.Member("env");
		for (int64 i = 0; env.Kind() == Serialization::DomKind::Object && i < env.Count(); ++i) provider->m_Environment.Push((Core::String(env.KeyAt(i)) + "=") + env.ValueAt(i).AsView());
		provider->m_Cwd = Core::String(node.Member("cwd").AsView());
		provider->m_Languages = Strings(node.Member("languages"));
		provider->m_Staged = node.Member("launchMode").AsView() == "staged";
		provider->m_Tcp = node.Member("transport").AsView() == "tcp";
		provider->m_When = Core::String(node.Member("when").AsView());
		return provider;
	}

	void ReadDapProviders(const Serialization::DomNode& contributes, Core::StringView pluginId, const FS::Path& pluginDir, Core::Array<DapProvider*>& providers) {
		Serialization::DomNode list = contributes.Member("dapProviders");
		for (int64 i = 0; i < list.Count(); ++i) providers.Push(ReadDapProvider(list.At(i), pluginId, pluginDir));
	}

	DapProvider* ProviderOfType(const Core::Array<DapProvider*>& providers, Core::StringView type) {
		for (int64 i = providers.Count() - 1; i >= 0; --i)
			if (providers[i]->m_Type.View() == type) return providers[i];
		return nullptr;
	}
}
