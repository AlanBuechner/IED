include "usage.ch"
include "web/json.ch"

namespace Ied
{
	static void WriteSample(JsonWriter& json, const UsageSample& sample) {
		Core::StringBuilder cpu;
		cpu.AppendInt(sample.cpuTenths / 10);
		cpu.Append(".");
		cpu.AppendInt(sample.cpuTenths % 10);
		json.BeginArray();
		json.Int(sample.ms);
		json.Raw(cpu.View());
		json.Int(sample.privateBytes);
		json.Int(sample.workingSetBytes);
		json.EndArray();
	}

	void ProgramUsage::Add(const UsageSample& sample) {
		samples.Push(sample);
		while (samples.Count() > kUsageSamplesKept) samples.RemoveAt(0);
	}

	Core::String ProgramUsage::Json() const {
		JsonWriter json;
		json.BeginObject();
		json.IntField("processId", (int64)processId);
		json.Field("name", name.View());
		json.Key(Core::StringView("samples"));
		json.BeginArray();
		for (const UsageSample& sample : samples) WriteSample(json, sample);
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String ProgramUsage::EventJson(const UsageSample& sample) const {
		JsonWriter json;
		json.BeginObject();
		json.IntField("processId", (int64)processId);
		json.Field("name", name.View());
		json.Key(Core::StringView("sample"));
		WriteSample(json, sample);
		json.EndObject();
		return json.ToString();
	}

	int64 CpuTenths(int64 cpuNs, int64 wallNs, int32 processors) {
		if (cpuNs <= 0 || wallNs <= 0 || processors <= 0) return 0;
		const int64 tenths = cpuNs * 1000 / (wallNs * (int64)processors);
		return tenths > 1000 ? 1000 : tenths;
	}
}
