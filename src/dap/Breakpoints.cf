include "Breakpoints.ch"
include "host/Server.ch"

namespace Ied
{
	const int64 c_MostBreakpointsPerFile = 1000;
	const int64 c_MostWatches = 200;

	Core::String BreakpointsTopic(const Workspace* ws) { return Core::String("bp:") + ws->m_WsId.View(); }

	static FS::Path BreakpointsFile(const Workspace* ws) { return ws->m_LocalState / "breakpoints.json"; }

	void Breakpoints::Init(Server* server) {
		this.m_Server = server;
		Breakpoints* self = this;
		server->m_Rpc.Register("bp.set", [self](Call& call, const Params& params) -> Core::String { return self->SetMethod(call, params); });
		server->m_Rpc.Register("bp.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->m_Rpc.Register("watch.set", [self](Call& call, const Params& params) -> Core::String { return self->WatchSetMethod(call, params); });
	}

	void Breakpoints::WorkspaceOpened(Workspace* ws) {
		m_Workspaces.Insert(ws->m_WsId, new WorkspaceBreakpoints());
		Load(ws);
		Breakpoints* self = this;
		m_Server->m_Hub.Add(BreakpointsTopic(ws).View(), [self, ws]() -> Core::String { return self->Snapshot(ws); });
	}

	WorkspaceBreakpoints* Breakpoints::Get(Workspace* ws) {
		WorkspaceBreakpoints* found = nullptr;
		if (!m_Workspaces.TryGet(ws->m_WsId, found)) {
			found = new WorkspaceBreakpoints();
			m_Workspaces.Insert(ws->m_WsId, found);
		}
		return found;
	}

	Core::Array<Core::String> Breakpoints::FilesOf(Workspace* ws) {
		Core::Array<Core::String> paths;
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->m_Files) paths.Push(entry.key);
		return paths;
	}

	Core::Array<SourceBreakpoint*> Breakpoints::Of(Workspace* ws, Core::StringView path) {
		Core::Array<SourceBreakpoint*> list;
		Get(ws)->m_Files.TryGet(Core::String(path), list);
		return list;
	}

	// --- Reading and writing -----------------------------------------------------------------------------------------

	static SourceBreakpoint* ReadBreakpoint(const Serialization::DomNode& node) {
		SourceBreakpoint* breakpoint = new SourceBreakpoint();
		breakpoint->m_Line = node.Member("line").AsInt();
		breakpoint->m_Enabled = node.Member("enabled").Kind() != Serialization::DomKind::Bool || node.Member("enabled").AsBool();
		breakpoint->m_Condition = Core::String(node.Member("condition").AsView());
		breakpoint->m_HitCondition = Core::String(node.Member("hitCondition").AsView());
		breakpoint->m_LogMessage = Core::String(node.Member("logMessage").AsView());
		return breakpoint;
	}

	static void WriteBreakpoint(JsonWriter& json, const SourceBreakpoint* breakpoint) {
		json.BeginObject();
		json.IntField("line", breakpoint->m_Line);
		json.BoolField("enabled", breakpoint->m_Enabled);
		if (!breakpoint->m_Condition.IsEmpty()) json.Field("condition", breakpoint->m_Condition.View());
		if (!breakpoint->m_HitCondition.IsEmpty()) json.Field("hitCondition", breakpoint->m_HitCondition.View());
		if (!breakpoint->m_LogMessage.IsEmpty()) json.Field("logMessage", breakpoint->m_LogMessage.View());
		json.EndObject();
	}

	Core::String Breakpoints::FileJson(Core::StringView path, const Core::Array<SourceBreakpoint*>& list) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path);
		json.Key(Core::StringView("breakpoints"));
		json.BeginArray();
		for (const SourceBreakpoint* breakpoint : list) WriteBreakpoint(json, breakpoint);
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Breakpoints::Load(Workspace* ws) {
		FS::Path file = BreakpointsFile(ws);
		if (!FS::FileExists(file.CStr())) return;
		FS::File opened = FS::File(file.CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text.View(), *doc);
		Serialization::DomNode files = read.Ok() ? read.root.Member("files") : Serialization::DomNode();
		if (files.Kind() != Serialization::DomKind::Object) {
			m_Server->Log((Core::String("ignoring ") + file.View() + ": not a breakpoints file").View());
			return;
		}
		Serialization::DomNode watches = read.root.Member("watches");
		for (int64 i = 0; watches.Kind() == Serialization::DomKind::Array && i < watches.Count(); ++i) Get(ws)->m_Watches.Push(Core::String(watches.At(i).AsView()));
		for (int64 i = 0; i < files.Count(); ++i) {
			Core::Array<SourceBreakpoint*> list;
			for (int64 j = 0; j < files.ValueAt(i).Count(); ++j) list.Push(ReadBreakpoint(files.ValueAt(i).At(j)));
			if (!list.IsEmpty()) Get(ws)->m_Files.Insert(Core::String(files.KeyAt(i)), list);
		}
	}

	void Breakpoints::Save(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Key(Core::StringView("files"));
		json.BeginObject();
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->m_Files) {
			json.Key(entry.key.View());
			json.BeginArray();
			for (const SourceBreakpoint* breakpoint : entry.value) WriteBreakpoint(json, breakpoint);
			json.EndArray();
		}
		json.EndObject();
		json.Key(Core::StringView("watches"));
		json.BeginArray();
		for (const Core::String& expression : Get(ws)->m_Watches) json.String(expression.View());
		json.EndArray();
		json.EndObject();
		FS::Path file = BreakpointsFile(ws);
		FS::MakeDirectories(file.Parent().CStr());
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength())) m_Server->Log((Core::String("the breakpoints could not be written: ") + file.View()).View());
	}

	// --- Sessions' bindings ------------------------------------------------------------------------------------------

	Core::String Breakpoints::BoundJson(Core::StringView sessionId, Core::StringView path, const Core::Array<BoundBreakpoint*>& list) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("sessionId", sessionId);
		json.Field("path", path);
		json.Key(Core::StringView("breakpoints"));
		json.BeginArray();
		for (const BoundBreakpoint* bound : list) {
			json.BeginObject();
			json.IntField("line", bound->m_Line);
			json.BoolField("verified", bound->m_Verified);
			json.IntField("boundLine", bound->m_BoundLine);
			if (!bound->m_Message.IsEmpty()) json.Field("message", bound->m_Message.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Breakpoints::Bound(Workspace* ws, Core::StringView sessionId, Core::StringView path, const Core::Array<BoundBreakpoint*>& list) {
		WorkspaceBreakpoints* all = Get(ws);
		Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>> paths;
		all->m_Bound.TryGet(Core::String(sessionId), paths);
		paths.Insert(Core::String(path), list);
		all->m_Bound.Insert(Core::String(sessionId), paths);
		m_Server->m_Hub.Publish(BreakpointsTopic(ws).View(), "bp.bound", BoundJson(sessionId, path, list).View());
	}

	void Breakpoints::Changed(Workspace* ws, Core::StringView sessionId, const Serialization::DomNode& breakpoint) {
		const int64 id = breakpoint.Member("id").AsInt();
		Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>> paths;
		if (id == 0 || !Get(ws)->m_Bound.TryGet(Core::String(sessionId), paths)) return;
		for (const Core::KeyValue<Core::String, Core::Array<BoundBreakpoint*>>& entry : paths)
			for (BoundBreakpoint* bound : entry.value) {
				if (bound->m_Id != id) continue;
				bound->m_Verified = breakpoint.Member("verified").AsBool();
				if (breakpoint.Member("line").Kind() == Serialization::DomKind::Int) bound->m_BoundLine = breakpoint.Member("line").AsInt() - 1;
				bound->m_Message = Core::String(breakpoint.Member("message").AsView());
				m_Server->m_Hub.Publish(BreakpointsTopic(ws).View(), "bp.bound", BoundJson(sessionId, entry.key.View(), entry.value).View());
				return;
			}
	}

	void Breakpoints::SessionGone(Workspace* ws, Core::StringView sessionId) {
		if (!Get(ws)->m_Bound.Remove(Core::String(sessionId))) return;
		JsonWriter json;
		json.BeginObject();
		json.Field("sessionId", sessionId);
		json.EndObject();
		m_Server->m_Hub.Publish(BreakpointsTopic(ws).View(), "bp.unbound", json.View());
	}

	// --- The topic and methods ---------------------------------------------------------------------------------------

	// {expressions: [text]}
	Core::String Breakpoints::WatchesJson(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("expressions"));
		json.BeginArray();
		for (const Core::String& expression : Get(ws)->m_Watches) json.String(expression.View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// {files: [{path, breakpoints}], bound: [{sessionId, path, breakpoints}], watches: [text]}
	Core::String Breakpoints::Snapshot(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("files"));
		json.BeginArray();
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->m_Files) json.Raw(FileJson(entry.key.View(), entry.value).View());
		json.EndArray();
		json.Key(Core::StringView("bound"));
		json.BeginArray();
		for (const Core::KeyValue<Core::String, Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>>>& session : Get(ws)->m_Bound)
			for (const Core::KeyValue<Core::String, Core::Array<BoundBreakpoint*>>& entry : session.value) json.Raw(BoundJson(session.key.View(), entry.key.View(), entry.value).View());
		json.EndArray();
		json.Key(Core::StringView("watches"));
		json.BeginArray();
		for (const Core::String& expression : Get(ws)->m_Watches) json.String(expression.View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String Breakpoints::WatchSetMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		Serialization::DomNode given = params.List("expressions");
		if (given.Count() > c_MostWatches) throw RpcError(ErrorCode::BadRequest, "too many watch expressions");
		Core::Array<Core::String> expressions;
		for (int64 i = 0; i < given.Count(); ++i) {
			Core::StringView text = given.At(i).AsView().Trimmed();
			if (text.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "a watch expression needs text");
			expressions.Push(Core::String(text));
		}
		Get(ws)->m_Watches = expressions;
		Save(ws);
		const Core::String json = WatchesJson(ws);
		m_Server->m_Hub.Publish(BreakpointsTopic(ws).View(), "watch.changed", json.View());
		return json;
	}

	Core::String Breakpoints::SetMethod(Call& call, const Params& params) {
		Workspace* ws = m_Server->m_Workspaces->Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		Serialization::DomNode given = params.List("breakpoints");
		if (given.Count() > c_MostBreakpointsPerFile) throw RpcError(ErrorCode::BadRequest, "too many breakpoints in one file");
		Core::Array<SourceBreakpoint*> list;
		for (int64 i = 0; i < given.Count(); ++i) {
			if (given.At(i).Member("line").Kind() != Serialization::DomKind::Int || given.At(i).Member("line").AsInt() < 0) throw RpcError(ErrorCode::BadRequest, "a breakpoint needs a line, from 0");
			list.Push(ReadBreakpoint(given.At(i)));
		}
		if (list.IsEmpty()) Get(ws)->m_Files.Remove(path);
		else Get(ws)->m_Files.Insert(path, list);
		Save(ws);
		const Core::String file = FileJson(path.View(), list);
		m_Server->m_Hub.Publish(BreakpointsTopic(ws).View(), "bp.changed", file.View());
		m_Server->m_Debugger->BreakpointsChanged(ws, path.View());
		return file;
	}

	Core::String Breakpoints::ListMethod(Call& call, const Params& params) {
		return Snapshot(m_Server->m_Workspaces->Get(params.Str("wsId").View()));
	}
}
