include "service.ch"
include "host/server.ch"
include "plugins/context.ch"
include "lsp/uris.ch"

namespace Ied
{
	Core::String DebugTopic(const Workspace* ws) { return Core::String("dbg:") + ws->wsId.View(); }

	Core::String SessionTopic(const DebugSession* session) { return (DebugTopic(session->ws) + ":") + session->id.View(); }

	void Debugger::Init(Server* server) {
		this.server = server;
		Debugger* self = this;
		server->rpc.Register("dbg.start", [self](Call& call, const Params& params) -> Core::String { return self->StartMethod(call, params); });
		server->rpc.Register("dbg.stop", [self](Call& call, const Params& params) -> Core::String { return self->StopMethod(call, params); });
		server->rpc.Register("dbg.restart", [self](Call& call, const Params& params) -> Core::String { return self->RestartMethod(call, params); });
		server->rpc.Register("dbg.sessions", [self](Call& call, const Params& params) -> Core::String { return self->SessionsMethod(call, params); });
		server->rpc.Register("dbg.continue", [self](Call& call, const Params& params) -> Core::String { return self->Control(params, Core::StringView("continue"), true); });
		server->rpc.Register("dbg.next", [self](Call& call, const Params& params) -> Core::String { return self->Control(params, Core::StringView("next"), true); });
		server->rpc.Register("dbg.stepIn", [self](Call& call, const Params& params) -> Core::String { return self->Control(params, Core::StringView("stepIn"), true); });
		server->rpc.Register("dbg.stepOut", [self](Call& call, const Params& params) -> Core::String { return self->Control(params, Core::StringView("stepOut"), true); });
		server->rpc.Register("dbg.pause", [self](Call& call, const Params& params) -> Core::String { return self->Control(params, Core::StringView("pause"), false); });
		server->rpc.Register("dbg.stackTrace", [self](Call& call, const Params& params) -> Core::String { return self->StackTraceMethod(call, params); });
		server->rpc.Register("dbg.scopes", [self](Call& call, const Params& params) -> Core::String { return self->PassMethod(call, params, Core::StringView("scopes")); });
		server->rpc.Register("dbg.variables", [self](Call& call, const Params& params) -> Core::String { return self->PassMethod(call, params, Core::StringView("variables")); });
		server->rpc.Register("dbg.evaluate", [self](Call& call, const Params& params) -> Core::String { return self->PassMethod(call, params, Core::StringView("evaluate")); });
		server->rpc.Register("dbg.request", [self](Call& call, const Params& params) -> Core::String { return self->RequestMethod(call, params); });
	}

	void Debugger::WorkspaceOpened(Workspace* ws) {
		Debugger* self = this;
		server->hub.Add(DebugTopic(ws).View(), [self, ws]() -> Core::String { return self->WorkspaceSnapshot(ws); });
	}

	DapProvider* Debugger::ProviderFor(Workspace* ws, Core::StringView type) {
		Core::Array<DapProvider*> providers;
		for (const Contribution& given : server->plugins->Entries(ws, Core::StringView("dapProviders")))
			providers.Push(ReadDapProvider(given.entry, given.plugin->manifest->id.View(), given.plugin->manifest->folder));
		DapProvider* provider = ProviderOfType(providers, type);
		if (!provider) return nullptr;
		Core::String error;
		const bool holds = WhenHolds(provider->when.View(), WorkspaceWhen(server, ws), error);
		if (!error.IsEmpty()) server->Log((((Core::String("the when of debug adapter ") + provider->type.View()) + " does not parse: ") + error.View()).View());
		return holds ? provider : nullptr;
	}

	DebugSession* Debugger::Find(Core::StringView sessionId) {
		for (DebugSession* session : sessions)
			if (session->id.View() == sessionId) return session;
		throw RpcError(ErrorCode::NotFound, (Core::String("no debug session ") + sessionId).View());
	}

	// Ended sessions beyond kDebugSessionsKept go, their topics with them.
	void Debugger::Keep(DebugSession* session) {
		sessions.Push(session);
		DebugSession* shown = session;
		Debugger* self = this;
		server->hub.Add(SessionTopic(session).View(), [self, shown]() -> Core::String { return self->SessionSnapshot(shown); });
		while (sessions.Count() > kDebugSessionsKept) {
			int64 oldest = -1;
			for (int64 i = 0; i < sessions.Count() && oldest < 0; ++i)
				if (!sessions[i]->IsLive()) oldest = i;
			if (oldest < 0) break;
			server->hub.Remove(SessionTopic(sessions[oldest]).View());
			sessions.RemoveAt(oldest);
		}
	}

	// --- What sessions report ----------------------------------------------------------------------------------------

	void Debugger::StateChanged(DebugSession* session) {
		Core::String summary = session->SummaryJson();
		server->hub.Publish(DebugTopic(session->ws).View(), "dbg.session", summary.View());
		server->hub.Publish(SessionTopic(session).View(), "dbg.state", summary.View());
		if (!session->IsLive()) server->breakpoints->SessionGone(session->ws, session->id.View());
		if (session->state == DebugState::Failed) server->outputs->Append(session->ws, Core::StringView("debug"), ((Core::String("\x1b[31m") + session->problem.View()) + "\x1b[0m\r\n").View());
	}

	void Debugger::StopShown(DebugSession* session) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		JsonWriter json;
		json.BeginObject();
		json.RawField("session", session->SummaryJson().View());
		json.RawField("threads", session->threads.View());
		json.RawField("frames", ClientFrames(session, Serialization::ReadJson(session->frames.View(), *doc).root).View());
		json.EndObject();
		server->hub.Publish(SessionTopic(session).View(), "dbg.stopped", json.View());
		server->hub.Publish(DebugTopic(session->ws).View(), "dbg.session", session->SummaryJson().View());
	}

	void Debugger::Configure(DebugSession* session) {
		session->configured = true;
		for (const Core::String& path : server->breakpoints->FilesOf(session->ws)) SendBreakpoints(session, path.View(), [](bool ok, const Serialization::DomNode& body, Core::StringView message) {});
		SendExceptionFilters(session);
		DebugSession* configured = session;
		session->Ask(Core::StringView("configurationDone"), Core::StringView("{}"), [configured](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			if (configured->state == DebugState::Starting) configured->Ran();
		});
	}

	void Debugger::Event(DebugSession* session, Core::StringView event, const Serialization::DomNode& body) {
		if (event == "output") {
			Core::StringView category = body.Member("category").AsView();
			if (category == "telemetry") return;
			Core::StringView text = body.Member("output").AsView();
			session->output.Push(Core::String(text));
			while (session->output.Count() > kDapOutputLinesKept) session->output.RemoveAt(0);
			JsonWriter json;
			json.BeginObject();
			json.Field("category", category.IsEmpty() ? Core::StringView("console") : category);
			json.Field("text", text);
			json.EndObject();
			server->hub.Publish(SessionTopic(session).View(), "dbg.output", json.View());
			server->outputs->Append(session->ws, Core::StringView("debug"), text);
		}
		else if (event == "breakpoint") server->breakpoints->Changed(session->ws, session->id.View(), body.Member("breakpoint"));
	}

	void Debugger::Log(DebugSession* session, Core::StringView text) {
		server->Log((((Core::String("[debug ") + session->launch.type.View()) + "] ") + text.Trimmed()).View());
	}

	// --- Breakpoints and exception filters ---------------------------------------------------------------------------

	static bool Takes(const DebugSession* session, const char* capability) {
		return session->capabilities.View().Contains(((Core::String("\"") + capability) + "\":true").View());
	}

	// Why the adapter cannot take `breakpoint`, or nothing.
	static Core::String Refusal(const DebugSession* session, const SourceBreakpoint* breakpoint) {
		if (!breakpoint->condition.IsEmpty() && !Takes(session, "supportsConditionalBreakpoints")) return (Core::String("the ") + session->launch.type.View()) + " debugger takes no conditions";
		if (!breakpoint->hitCondition.IsEmpty() && !Takes(session, "supportsHitConditionalBreakpoints")) return (Core::String("the ") + session->launch.type.View()) + " debugger takes no hit counts";
		if (!breakpoint->logMessage.IsEmpty() && !Takes(session, "supportsLogPoints")) return (Core::String("the ") + session->launch.type.View()) + " debugger takes no log points";
		return Core::String();
	}

	static BoundBreakpoint* Unbound(const SourceBreakpoint* breakpoint, Core::StringView why) {
		BoundBreakpoint* bound = new BoundBreakpoint();
		bound->line = breakpoint->line;
		bound->boundLine = breakpoint->line;
		bound->message = Core::String(why);
		return bound;
	}

	static BoundBreakpoint* BoundFrom(const SourceBreakpoint* breakpoint, const Serialization::DomNode& result) {
		BoundBreakpoint* bound = new BoundBreakpoint();
		bound->line = breakpoint->line;
		bound->id = result.Member("id").AsInt();
		bound->verified = result.Member("verified").AsBool();
		bound->boundLine = result.Member("line").Kind() == Serialization::DomKind::Int ? result.Member("line").AsInt() - 1 : breakpoint->line;
		bound->message = Core::String(result.Member("message").AsView());
		return bound;
	}

	void Debugger::SendBreakpoints(DebugSession* session, Core::StringView path, DapThen then) {
		Core::Array<SourceBreakpoint*> sent;
		Core::Array<SourceBreakpoint*> refused;
		for (SourceBreakpoint* breakpoint : server->breakpoints->Of(session->ws, path)) {
			if (!breakpoint->enabled) continue;
			if (Refusal(session, breakpoint).IsEmpty()) sent.Push(breakpoint);
			else refused.Push(breakpoint);
		}
		FS::Path file = session->ws->At(path);
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("source"));
		json.BeginObject();
		json.Field("name", file.FileName());
		json.Field("path", file.View());
		json.EndObject();
		json.Key(Core::StringView("breakpoints"));
		json.BeginArray();
		for (const SourceBreakpoint* breakpoint : sent) {
			json.BeginObject();
			json.IntField("line", breakpoint->line + 1);
			if (!breakpoint->condition.IsEmpty()) json.Field("condition", breakpoint->condition.View());
			if (!breakpoint->hitCondition.IsEmpty()) json.Field("hitCondition", breakpoint->hitCondition.View());
			if (!breakpoint->logMessage.IsEmpty()) json.Field("logMessage", breakpoint->logMessage.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		Server* host = server;
		const Core::String where = Core::String(path);
		session->Ask(Core::StringView("setBreakpoints"), json.View(), [host, session, where, sent, refused, then](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			Core::Array<BoundBreakpoint*> list;
			for (int64 i = 0; i < sent.Count(); ++i) list.Push(ok ? BoundFrom(sent[i], body.Member("breakpoints").At(i)) : Unbound(sent[i], message));
			for (const SourceBreakpoint* breakpoint : refused) list.Push(Unbound(breakpoint, Refusal(session, breakpoint).View()));
			host->breakpoints->Bound(session->ws, session->id.View(), where.View(), list);
			then(ok, body, message);
		});
	}

	// The filters the adapter turns on by default (F-DBG-14; choosing them per workspace comes with the Exception
	// Settings window).
	void Debugger::SendExceptionFilters(DebugSession* session) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode filters = Serialization::ReadJson(session->capabilities.View(), *doc).root.Member("exceptionBreakpointFilters");
		if (filters.Kind() != Serialization::DomKind::Array) return;
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("filters"));
		json.BeginArray();
		for (int64 i = 0; i < filters.Count(); ++i)
			if (filters.At(i).Member("default").AsBool()) json.String(filters.At(i).Member("filter").AsView());
		json.EndArray();
		json.EndObject();
		session->Ask(Core::StringView("setExceptionBreakpoints"), json.View(), [](bool ok, const Serialization::DomNode& body, Core::StringView message) {});
	}

	void Debugger::BreakpointsChanged(Workspace* ws, Core::StringView path) {
		for (DebugSession* session : sessions)
			if (session->ws == ws && session->IsLive() && session->configured) SendBreakpoints(session, path, [](bool ok, const Serialization::DomNode& body, Core::StringView message) {});
	}

	// --- Paths and positions -----------------------------------------------------------------------------------------

	// A frame's source for clients: a workspace path, else a file: URI the session named (so it opens read-only), else
	// the adapter's own reference.
	void Debugger::WriteClientSource(DebugSession* session, JsonWriter& json, const Serialization::DomNode& source) {
		json.BeginObject();
		json.Field("name", source.Member("name").AsView());
		Core::StringView path = source.Member("path").AsView();
		Core::String relative;
		if (!path.IsEmpty() && RelativeTo(session->ws->root.View(), path, relative) && !relative.IsEmpty()) json.Field("path", relative.View());
		else if (!path.IsEmpty() && FS::FileExists(Core::String(path).CStr())) {
			Core::String uri = CanonicalFileUri(FileUriOf(path).View());
			server->lsp->NameFile(session->ws, uri.View(), (Core::String("dap:") + session->launch.type.View()).View(), session->launch.project.View());
			json.Field("uri", uri.View());
		}
		if (source.Member("sourceReference").AsInt() > 0) json.IntField("sourceReference", source.Member("sourceReference").AsInt());
		json.EndObject();
	}

	Core::String Debugger::ClientFrames(DebugSession* session, const Serialization::DomNode& frames) {
		JsonWriter json;
		json.BeginArray();
		for (int64 i = 0; frames.Kind() == Serialization::DomKind::Array && i < frames.Count(); ++i) {
			Serialization::DomNode frame = frames.At(i);
			json.BeginObject();
			json.IntField("id", frame.Member("id").AsInt());
			json.Field("name", frame.Member("name").AsView());
			json.IntField("line", frame.Member("line").AsInt() > 0 ? frame.Member("line").AsInt() - 1 : 0);
			json.IntField("column", frame.Member("column").AsInt() > 0 ? frame.Member("column").AsInt() - 1 : 0);
			if (!frame.Member("presentationHint").AsView().IsEmpty()) json.Field("presentationHint", frame.Member("presentationHint").AsView());
			if (frame.Member("source").IsValid()) {
				json.Key(Core::StringView("source"));
				WriteClientSource(session, json, frame.Member("source"));
			}
			json.EndObject();
		}
		json.EndArray();
		return json.ToString();
	}

	// --- Snapshots ---------------------------------------------------------------------------------------------------

	// {sessions: [summary]}
	Core::String Debugger::WorkspaceSnapshot(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("sessions"));
		json.BeginArray();
		for (DebugSession* session : sessions)
			if (session->ws == ws) json.Raw(session->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// {session, threads, frames, output: [text]}
	Core::String Debugger::SessionSnapshot(DebugSession* session) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		JsonWriter json;
		json.BeginObject();
		json.RawField("session", session->SummaryJson().View());
		json.RawField("threads", session->threads.View());
		json.RawField("frames", ClientFrames(session, Serialization::ReadJson(session->frames.View(), *doc).root).View());
		json.Key(Core::StringView("output"));
		json.BeginArray();
		for (const Core::String& text : session->output) json.String(text.View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	Core::String Debugger::StartMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		if (!ws->trusted) throw RpcError(ErrorCode::Forbidden, "debugging runs the workspace's code: trust the workspace first");
		DebugLaunch launch = server->tasks->ResolveDebug(ws, params.Str("project", Core::StringView("")).View(), params.Str("configuration", Core::StringView("")).View());
		DapProvider* provider = ProviderFor(ws, launch.type.View());
		if (!provider) throw RpcError(ErrorCode::NotFound, (Core::String("no plugin offers a debug adapter of type ") + launch.type.View()).View());
		TaskRun* before = launch.preLaunchTask.IsEmpty() ? nullptr : server->tasks->RunTask(ws, launch.project.View(), launch.preLaunchTask.View(), Core::StringView(""), Serialization::DomNode());
		started += 1;
		Core::StringBuilder id;
		id.Append("d");
		id.AppendInt(started);
		DebugSession* session = new DebugSession(server, ws, id.View(), launch);
		Keep(session);
		server->outputs->Clear(ws, Core::StringView("debug"));
		if (!before) session->Start(provider);
		else {
			StateChanged(session);
			Server* host = server;
			Threading::Thread::Run([host, session, before, provider]() {
				Threading::LockGuard guard(host->lock);
				const bool built = host->tasks->AwaitEnd(before);
				if (session->state != DebugState::Building) return;
				if (built) session->Start(provider);
				else session->Fail(((Core::String("the pre-launch task ") + session->launch.preLaunchTask.View()) + " failed").View());
			}).Detach();
		}
		JsonWriter json;
		json.BeginObject();
		json.Field("sessionId", session->id.View());
		json.Field("topic", SessionTopic(session).View());
		json.EndObject();
		return json.ToString();
	}

	Core::String Debugger::StopMethod(Call& call, const Params& params) {
		DebugSession* session = Find(params.Str("sessionId").View());
		if (session->state == DebugState::Building) {
			session->state = DebugState::Ended;
			StateChanged(session);
		}
		else session->Stop();
		return Core::String("{}");
	}

	Core::String Debugger::RestartMethod(Call& call, const Params& params) {
		DebugSession* session = Find(params.Str("sessionId").View());
		StopMethod(call, params);
		JsonWriter json;
		json.BeginObject();
		json.Field("wsId", session->ws->wsId.View());
		json.Field("project", session->launch.project.View());
		json.Field("configuration", session->launch.name.View());
		json.EndObject();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return StartMethod(call, Params(Serialization::ReadJson(json.View(), *doc).root));
	}

	Core::String Debugger::SessionsMethod(Call& call, const Params& params) {
		return WorkspaceSnapshot(server->workspaces->Get(params.Str("wsId").View()));
	}

	// continue, next, stepIn, stepOut (the program must be stopped) and pause (running): a revision that is not the
	// session's is a conflict, and the session moves on at once, so a second press from another device conflicts too.
	Core::String Debugger::Control(const Params& params, Core::StringView command, bool whenStopped) {
		DebugSession* session = Find(params.Str("sessionId").View());
		if (!session->IsLive()) throw RpcError(ErrorCode::Conflict, "the debug session has ended");
		if (params.Has("revision") && params.Int("revision") != session->revision) throw RpcError(ErrorCode::Conflict, "the debug session moved on: refresh and try again");
		if (whenStopped && session->state != DebugState::Stopped) throw RpcError(ErrorCode::Conflict, "the program is not stopped");
		if (!whenStopped && session->state != DebugState::Running) throw RpcError(ErrorCode::Conflict, "the program is not running");
		JsonWriter json;
		json.BeginObject();
		json.IntField("threadId", params.Int("threadId", session->stopThread));
		json.EndObject();
		if (whenStopped) session->Ran();
		const int64 at = session->revision;
		Debugger* self = this;
		session->Ask(command, json.View(), [self, session, at](bool ok, const Serialization::DomNode& body, Core::StringView message) {
			if (!ok) self->Log(session, message);
		});
		JsonWriter answer;
		answer.BeginObject();
		answer.IntField("revision", at);
		answer.EndObject();
		return answer.ToString();
	}

	Core::String Debugger::StackTraceMethod(Call& call, const Params& params) {
		DebugSession* session = Find(params.Str("sessionId").View());
		JsonWriter json;
		json.BeginObject();
		json.IntField("threadId", params.Int("threadId", session->stopThread));
		json.IntField("startFrame", params.Int("startFrame", 0));
		json.IntField("levels", params.Int("levels", 50));
		json.EndObject();
		Core::String answered = session->Request(call, Core::StringView("stackTrace"), json.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode body = Serialization::ReadJson(answered.View(), *doc).root;
		JsonWriter result;
		result.BeginObject();
		result.RawField("stackFrames", ClientFrames(session, body.Member("stackFrames")).View());
		result.IntField("totalFrames", body.Member("totalFrames").AsInt());
		result.EndObject();
		return result.ToString();
	}

	// scopes {frameId}, variables {variablesReference}, evaluate {expression, frameId?, context?}: the adapter's answer.
	Core::String Debugger::PassMethod(Call& call, const Params& params, Core::StringView command) {
		DebugSession* session = Find(params.Str("sessionId").View());
		JsonWriter json;
		json.BeginObject();
		if (command == "scopes") json.IntField("frameId", params.Int("frameId"));
		else if (command == "variables") json.IntField("variablesReference", params.Int("variablesReference"));
		else {
			json.Field("expression", params.Str("expression").View());
			if (params.Has("frameId")) json.IntField("frameId", params.Int("frameId"));
			json.Field("context", params.Str("context", Core::StringView("watch")).View());
		}
		json.EndObject();
		return session->Request(call, command, json.View());
	}

	Core::String Debugger::RequestMethod(Call& call, const Params& params) {
		DebugSession* session = Find(params.Str("sessionId").View());
		Serialization::DomNode arguments = params.Field("arguments");
		const Core::String json = arguments.IsValid() ? NodeJson(arguments) : Core::String("{}");
		return session->Request(call, params.Str("command").View(), json.View());
	}
}
