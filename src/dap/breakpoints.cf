include "breakpoints.ch"
include "host/server.ch"

namespace Ied
{
	const int64 kMostBreakpointsPerFile = 1000;

	Core::String BreakpointsTopic(const Workspace* ws) { return Core::String("bp:") + ws->wsId.View(); }

	static FS::Path BreakpointsFile(const Workspace* ws) { return ws->root / ".ied" / "local" / "breakpoints.json"; }

	void Breakpoints::Init(Server* server) {
		this.server = server;
		Breakpoints* self = this;
		server->rpc.Register("bp.set", [self](Call& call, const Params& params) -> Core::String { return self->SetMethod(call, params); });
		server->rpc.Register("bp.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
	}

	void Breakpoints::WorkspaceOpened(Workspace* ws) {
		workspaces.Insert(ws->wsId, new WorkspaceBreakpoints());
		Load(ws);
		Breakpoints* self = this;
		server->hub.Add(BreakpointsTopic(ws).View(), [self, ws]() -> Core::String { return self->Snapshot(ws); });
	}

	WorkspaceBreakpoints* Breakpoints::Get(Workspace* ws) {
		WorkspaceBreakpoints* found = nullptr;
		if (!workspaces.TryGet(ws->wsId, found)) {
			found = new WorkspaceBreakpoints();
			workspaces.Insert(ws->wsId, found);
		}
		return found;
	}

	Core::Array<Core::String> Breakpoints::FilesOf(Workspace* ws) {
		Core::Array<Core::String> paths;
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->files) paths.Push(entry.key);
		return paths;
	}

	Core::Array<SourceBreakpoint*> Breakpoints::Of(Workspace* ws, Core::StringView path) {
		Core::Array<SourceBreakpoint*> list;
		Get(ws)->files.TryGet(Core::String(path), list);
		return list;
	}

	// --- Reading and writing -----------------------------------------------------------------------------------------

	static SourceBreakpoint* ReadBreakpoint(const Serialization::DomNode& node) {
		SourceBreakpoint* breakpoint = new SourceBreakpoint();
		breakpoint->line = node.Member("line").AsInt();
		breakpoint->enabled = node.Member("enabled").Kind() != Serialization::DomKind::Bool || node.Member("enabled").AsBool();
		breakpoint->condition = Core::String(node.Member("condition").AsView());
		breakpoint->hitCondition = Core::String(node.Member("hitCondition").AsView());
		breakpoint->logMessage = Core::String(node.Member("logMessage").AsView());
		return breakpoint;
	}

	static void WriteBreakpoint(JsonWriter& json, const SourceBreakpoint* breakpoint) {
		json.BeginObject();
		json.IntField("line", breakpoint->line);
		json.BoolField("enabled", breakpoint->enabled);
		if (!breakpoint->condition.IsEmpty()) json.Field("condition", breakpoint->condition.View());
		if (!breakpoint->hitCondition.IsEmpty()) json.Field("hitCondition", breakpoint->hitCondition.View());
		if (!breakpoint->logMessage.IsEmpty()) json.Field("logMessage", breakpoint->logMessage.View());
		json.EndObject();
	}

	Core::String Breakpoints::FileJson(Core::StringView path, const Core::Array<SourceBreakpoint*>& list) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("path", path);
		json.Key(Core::StringView("breakpoints"));
		json.BeginArray();
		for (const SourceBreakpoint* breakpoint : list) WriteBreakpoint(json, breakpoint);
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Breakpoints::Load(Workspace* ws) {
		FS::Path file = BreakpointsFile(ws);
		if (!FS::FileExists(file.CStr())) return;
		FS::File opened = FS::File(file.CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text.View(), *doc);
		Serialization::DomNode files = read.Ok() ? read.root.Member("files") : Serialization::DomNode();
		if (files.Kind() != Serialization::DomKind::Object) {
			server->Log((Core::String("ignoring ") + file.View() + ": not a breakpoints file").View());
			return;
		}
		for (int64 i = 0; i < files.Count(); ++i) {
			Core::Array<SourceBreakpoint*> list;
			for (int64 j = 0; j < files.ValueAt(i).Count(); ++j) list.Push(ReadBreakpoint(files.ValueAt(i).At(j)));
			if (!list.IsEmpty()) Get(ws)->files.Insert(Core::String(files.KeyAt(i)), list);
		}
	}

	void Breakpoints::Save(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Key(Core::StringView("files"));
		json.BeginObject();
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->files) {
			json.Key(entry.key.View());
			json.BeginArray();
			for (const SourceBreakpoint* breakpoint : entry.value) WriteBreakpoint(json, breakpoint);
			json.EndArray();
		}
		json.EndObject();
		json.EndObject();
		FS::Path file = BreakpointsFile(ws);
		FS::MakeDirectories(file.Parent().CStr());
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength())) server->Log((Core::String("the breakpoints could not be written: ") + file.View()).View());
	}

	// --- Sessions' bindings ------------------------------------------------------------------------------------------

	Core::String Breakpoints::BoundJson(Core::StringView sessionId, Core::StringView path, const Core::Array<BoundBreakpoint*>& list) const {
		JsonWriter json;
		json.BeginObject();
		json.Field("sessionId", sessionId);
		json.Field("path", path);
		json.Key(Core::StringView("breakpoints"));
		json.BeginArray();
		for (const BoundBreakpoint* bound : list) {
			json.BeginObject();
			json.IntField("line", bound->line);
			json.BoolField("verified", bound->verified);
			json.IntField("boundLine", bound->boundLine);
			if (!bound->message.IsEmpty()) json.Field("message", bound->message.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Breakpoints::Bound(Workspace* ws, Core::StringView sessionId, Core::StringView path, const Core::Array<BoundBreakpoint*>& list) {
		WorkspaceBreakpoints* all = Get(ws);
		Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>> paths;
		all->bound.TryGet(Core::String(sessionId), paths);
		paths.Insert(Core::String(path), list);
		all->bound.Insert(Core::String(sessionId), paths);
		server->hub.Publish(BreakpointsTopic(ws).View(), "bp.bound", BoundJson(sessionId, path, list).View());
	}

	void Breakpoints::Changed(Workspace* ws, Core::StringView sessionId, const Serialization::DomNode& breakpoint) {
		const int64 id = breakpoint.Member("id").AsInt();
		Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>> paths;
		if (id == 0 || !Get(ws)->bound.TryGet(Core::String(sessionId), paths)) return;
		for (const Core::KeyValue<Core::String, Core::Array<BoundBreakpoint*>>& entry : paths)
			for (BoundBreakpoint* bound : entry.value) {
				if (bound->id != id) continue;
				bound->verified = breakpoint.Member("verified").AsBool();
				if (breakpoint.Member("line").Kind() == Serialization::DomKind::Int) bound->boundLine = breakpoint.Member("line").AsInt() - 1;
				bound->message = Core::String(breakpoint.Member("message").AsView());
				server->hub.Publish(BreakpointsTopic(ws).View(), "bp.bound", BoundJson(sessionId, entry.key.View(), entry.value).View());
				return;
			}
	}

	void Breakpoints::SessionGone(Workspace* ws, Core::StringView sessionId) {
		if (!Get(ws)->bound.Remove(Core::String(sessionId))) return;
		JsonWriter json;
		json.BeginObject();
		json.Field("sessionId", sessionId);
		json.EndObject();
		server->hub.Publish(BreakpointsTopic(ws).View(), "bp.unbound", json.View());
	}

	// --- The topic and methods ---------------------------------------------------------------------------------------

	// {files: [{path, breakpoints}], bound: [{sessionId, path, breakpoints}]}
	Core::String Breakpoints::Snapshot(Workspace* ws) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("files"));
		json.BeginArray();
		for (const Core::KeyValue<Core::String, Core::Array<SourceBreakpoint*>>& entry : Get(ws)->files) json.Raw(FileJson(entry.key.View(), entry.value).View());
		json.EndArray();
		json.Key(Core::StringView("bound"));
		json.BeginArray();
		for (const Core::KeyValue<Core::String, Core::HashMap<Core::String, Core::Array<BoundBreakpoint*>>>& session : Get(ws)->bound)
			for (const Core::KeyValue<Core::String, Core::Array<BoundBreakpoint*>>& entry : session.value) json.Raw(BoundJson(session.key.View(), entry.key.View(), entry.value).View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String Breakpoints::SetMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		Core::String path = NormalizePath(params.Str("path").View());
		Serialization::DomNode given = params.List("breakpoints");
		if (given.Count() > kMostBreakpointsPerFile) throw RpcError(ErrorCode::BadRequest, "too many breakpoints in one file");
		Core::Array<SourceBreakpoint*> list;
		for (int64 i = 0; i < given.Count(); ++i) {
			if (given.At(i).Member("line").Kind() != Serialization::DomKind::Int || given.At(i).Member("line").AsInt() < 0) throw RpcError(ErrorCode::BadRequest, "a breakpoint needs a line, from 0");
			list.Push(ReadBreakpoint(given.At(i)));
		}
		if (list.IsEmpty()) Get(ws)->files.Remove(path);
		else Get(ws)->files.Insert(path, list);
		Save(ws);
		const Core::String file = FileJson(path.View(), list);
		server->hub.Publish(BreakpointsTopic(ws).View(), "bp.changed", file.View());
		server->debugger->BreakpointsChanged(ws, path.View());
		return file;
	}

	Core::String Breakpoints::ListMethod(Call& call, const Params& params) {
		return Snapshot(server->workspaces->Get(params.Str("wsId").View()));
	}
}
