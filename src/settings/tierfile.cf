include "tierfile.ch"
include "web/json.ch"
include "web/params.ch"

namespace Ied
{
	void TierFile::Problem(int32 line, Core::StringView key, Core::StringView message) {
		TierProblem* problem = new TierProblem();
		problem->line = line;
		problem->key = Core::String(key);
		problem->message = Core::String(message);
		problems.Push(problem);
	}

	bool TierFile::Reload(SettingsCatalog& catalog, bool force) {
		Core::String now;
		if (FS::FileExists(file.CStr())) {
			FS::File opened = FS::File(file.CStr(), "rb");
			now = opened.ReadText();
		}
		if (loaded && !force && now.View() == text.View()) return false;
		if (!loaded || now.View() != text.View()) revision += 1;
		loaded = true;
		text = now;
		Check(catalog);
		return true;
	}

	// Each member's value is checked on its own: a bad one is reported and the key keeps its last valid value; a key
	// no longer in the file loses its value.
	void TierFile::Check(SettingsCatalog& catalog) {
		problems.Clear();
		Core::StringView view = text.View();
		if (view.Trimmed().IsEmpty()) {
			values.Clear();
			return;
		}
		TopLevel top;
		Core::String error;
		if (!ScanMembers(view, top, error)) {
			Problem(1, Core::StringView(""), (Core::String("not a settings file: ") + error.View()).View());
			return;
		}
		Core::HashMap<Core::String, Core::String> kept;
		for (MemberSpan* member : top.members) {
			const int32 line = LineOf(view, member->keyStart);
			Core::StringView key = member->key.View();
			Core::String last;
			const bool hadValue = values.TryGet(member->key, last);
			Serialization::DomDoc* doc = new Serialization::DomDoc();
			Serialization::ReadResult read = Serialization::ReadJsonc(view.Substring(member->valueStart, member->valueEnd - member->valueStart), *doc);
			SettingInfo* setting = catalog.Get(key);
			Core::Array<Core::String> wrong;
			if (!setting) wrong.Push(Core::String("unknown setting"));
			else if (!catalog.AllowedIn(setting, tier.View())) wrong.Push((Core::String("cannot be set in the ") + tier.View()) + " tier");
			else if (!read.Ok()) wrong.Push(Core::String("not a JSON value"));
			else wrong = catalog.Check(setting, read.root);
			for (const Core::String& message : wrong) Problem(line, key, message.View());
			if (wrong.IsEmpty()) kept.At(member->key) = NodeJson(read.root);
			else if (hadValue && setting) kept.At(member->key) = last;
		}
		values = kept;
	}

	bool TierFile::Write(SettingsCatalog& catalog, Core::StringView newText, Core::String& error) {
		FS::MakeDirectories(file.Parent().CStr());
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)newText.Data(), newText.ByteLength())) {
			error = Core::String("cannot write ") + file.View();
			return false;
		}
		Reload(catalog, false);
		return true;
	}

	Core::String TierFile::StateJson() const {
		JsonWriter json;
		json.BeginObject();
		json.Field("file", file.View());
		json.IntField("revision", revision);
		json.Key(Core::StringView("problems"));
		json.BeginArray();
		for (TierProblem* problem : problems) {
			json.BeginObject();
			json.IntField("line", problem->line);
			if (!problem->key.IsEmpty()) json.Field("key", problem->key.View());
			json.Field("message", problem->message.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
