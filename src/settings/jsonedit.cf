include "jsonedit.ch"

namespace Ied
{
	static int32 ByteAt(Core::StringView text, int64 at) { return at < text.ByteLength() ? text.ByteAt(at) : -1; }

	static bool IsBlank(int32 c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }

	// Past whitespace and comments; false at a block comment that never ends.
	static bool SkipGap(Core::StringView text, int64& at) {
		for (;;) {
			while (IsBlank(ByteAt(text, at))) at += 1;
			if (ByteAt(text, at) != '/') return true;
			const int32 next = ByteAt(text, at + 1);
			if (next == '/') {
				while (at < text.ByteLength() && ByteAt(text, at) != '\n') at += 1;
			}
			else if (next == '*') {
				const int64 close = text.Substring(at + 2, text.ByteLength()).IndexOf(Core::StringView("*/"));
				if (close < 0) return false;
				at = at + 2 + close + 2;
			}
			else return true;
		}
	}

	// Past a string literal starting at `at`; false when it never ends.
	static bool SkipString(Core::StringView text, int64& at) {
		at += 1;
		while (at < text.ByteLength()) {
			const int32 c = text.ByteAt(at);
			at += c == '\\' ? 2 : 1;
			if (c == '"') return true;
		}
		return false;
	}

	// Past one value (a string, a nested object or array, or a literal) to where it ends.
	static bool SkipValue(Core::StringView text, int64& at) {
		if (ByteAt(text, at) == '"') return SkipString(text, at);
		int32 depth = 0;
		while (at < text.ByteLength()) {
			const int32 c = text.ByteAt(at);
			if (c == '"' && !SkipString(text, at)) return false;
			if (c == '"') continue;
			if (c == '/' && (ByteAt(text, at + 1) == '/' || ByteAt(text, at + 1) == '*')) {
				if (depth == 0) return true;
				if (!SkipGap(text, at)) return false;
				continue;
			}
			if (c == '{' || c == '[') depth += 1;
			else if (c == '}' || c == ']') {
				if (depth == 0) return true;
				depth -= 1;
				if (depth == 0) {
					at += 1;
					return true;
				}
			}
			else if ((c == ',' || IsBlank(c)) && depth == 0) return true;
			at += 1;
		}
		return depth == 0;
	}

	static bool Fail(Core::String& error, const char* why) {
		error = Core::String(why);
		return false;
	}

	static bool ReadKey(Core::StringView text, int64& at, Core::String& key) {
		const int64 start = at;
		if (ByteAt(text, at) != '"' || !SkipString(text, at)) return false;
		Serialization::DomDoc doc;
		Serialization::ReadResult read = Serialization::ReadJson(text.Substring(start, at - start), doc);
		if (!read.Ok()) return false;
		key = Core::String(read.root.AsView());
		return true;
	}

	bool ScanMembers(Core::StringView text, TopLevel& top, Core::String& error) {
		int64 at = 0;
		if (!SkipGap(text, at) || ByteAt(text, at) != '{') return Fail(error, "the file is not one JSON object");
		top.open = at;
		at += 1;
		for (;;) {
			if (!SkipGap(text, at)) return Fail(error, "a block comment never ends");
			if (ByteAt(text, at) == '}') {
				top.close = at;
				return true;
			}
			MemberSpan* member = new MemberSpan();
			member->keyStart = at;
			if (!ReadKey(text, at, member->key)) return Fail(error, "a member's name is not a string");
			if (!SkipGap(text, at) || ByteAt(text, at) != ':') return Fail(error, "a member's name is not followed by ':'");
			at += 1;
			if (!SkipGap(text, at)) return Fail(error, "a block comment never ends");
			member->valueStart = at;
			if (!SkipValue(text, at) || at == member->valueStart) return Fail(error, "a member has no value");
			member->valueEnd = at;
			top.members.Push(member);
			if (!SkipGap(text, at)) return Fail(error, "a block comment never ends");
			if (ByteAt(text, at) == ',') at += 1;
			else if (ByteAt(text, at) != '}') return Fail(error, "members are not separated by ','");
		}
	}

	static MemberSpan* Find(const TopLevel& top, Core::StringView key) {
		for (MemberSpan* member : top.members)
			if (member->key.View() == key) return member;
		return nullptr;
	}

	static Core::String Spliced(Core::StringView text, int64 from, int64 to, Core::StringView insert) {
		Core::StringBuilder out;
		out.Append(text.Substring(0, from));
		out.Append(insert);
		out.Append(text.Substring(to, text.ByteLength() - to));
		return out.ToString();
	}

	static Core::String MemberText(Core::StringView key, Core::StringView valueJson) {
		Core::StringBuilder member;
		Serialization::WriteJsonString(key, &member);
		member.Append(": ");
		member.Append(valueJson);
		return member.ToString();
	}

	bool SetMember(Core::StringView text, Core::StringView key, Core::StringView valueJson, Core::String& edited, Core::String& error) {
		if (text.Trimmed().IsEmpty()) {
			edited = (Core::String("{\n\t") + MemberText(key, valueJson).View()) + "\n}\n";
			return true;
		}
		TopLevel top;
		if (!ScanMembers(text, top, error)) return false;
		MemberSpan* member = Find(top, key);
		if (member) {
			edited = Spliced(text, member->valueStart, member->valueEnd, valueJson);
			return true;
		}
		Core::String added = MemberText(key, valueJson);
		if (top.members.IsEmpty()) {
			edited = Spliced(text, top.open + 1, top.open + 1, ((Core::String("\n\t") + added.View()) + "\n").View());
			return true;
		}
		const int64 after = top.members.Back()->valueEnd;
		edited = Spliced(text, after, after, ((Core::String(",\n\t") + added.View())).View());
		return true;
	}

	// Where a member's line starts when only blanks come before it on that line, else the member itself.
	static int64 LineStart(Core::StringView text, int64 at) {
		int64 start = at;
		while (start > 0 && (text.ByteAt(start - 1) == ' ' || text.ByteAt(start - 1) == '\t')) start -= 1;
		return start > 0 && text.ByteAt(start - 1) == '\n' ? start : at;
	}

	// Past the line break that ends a member's line when only blanks follow it there, else the member's end.
	static int64 LineEnd(Core::StringView text, int64 at) {
		int64 end = at;
		while (end < text.ByteLength() && (text.ByteAt(end) == ' ' || text.ByteAt(end) == '\t' || text.ByteAt(end) == '\r')) end += 1;
		return end < text.ByteLength() && text.ByteAt(end) == '\n' ? end + 1 : at;
	}

	bool RemoveMember(Core::StringView text, Core::StringView key, Core::String& edited, Core::String& error) {
		TopLevel top;
		if (!ScanMembers(text, top, error)) return false;
		int64 index = -1;
		for (int64 i = 0; i < top.members.Count(); ++i)
			if (top.members[i]->key.View() == key) index = i;
		if (index < 0) {
			edited = Core::String(text);
			return true;
		}
		MemberSpan* member = top.members[index];
		const bool last = index == top.members.Count() - 1;
		if (!last) {
			const int64 next = top.members[index + 1]->keyStart;
			edited = Spliced(text, LineStart(text, member->keyStart), LineStart(text, next), Core::StringView(""));
			return true;
		}
		const int64 from = index == 0 ? LineStart(text, member->keyStart) : top.members[index - 1]->valueEnd;
		const int64 to = index == 0 && from < member->keyStart ? LineEnd(text, member->valueEnd) : member->valueEnd;
		edited = Spliced(text, from, to, Core::StringView(""));
		return true;
	}

	int32 LineOf(Core::StringView text, int64 offset) {
		int32 line = 1;
		for (int64 i = 0; i < offset && i < text.ByteLength(); ++i)
			if (text.ByteAt(i) == '\n') line += 1;
		return line;
	}
}
