include "throttle.ch"

namespace Ied
{
	int64 LoginThrottle::RetryAfterS(Core::StringView address, int64 nowMs) const {
		LoginAttempts* entry = nullptr;
		if (!attempts.TryGet(Core::String(address), entry) || entry->lockedUntilMs <= nowMs) return 0;
		return (entry->lockedUntilMs - nowMs + 999) / 1000;
	}

	static int64 LockoutMs(int32 lockouts) {
		int64 ms = kFirstLockoutMs;
		for (int32 i = 1; i < lockouts && ms < kLongestLockoutMs; ++i) ms *= 2;
		return ms < kLongestLockoutMs ? ms : kLongestLockoutMs;
	}

	bool LoginThrottle::Failed(Core::StringView address, int64 nowMs) {
		Core::String key = Core::String(address);
		LoginAttempts* entry = nullptr;
		if (!attempts.TryGet(key, entry)) {
			entry = new LoginAttempts();
			attempts.Insert(key, entry);
		}
		if (nowMs - entry->lastFailureMs > kLongestLockoutMs) entry->lockouts = 0;
		entry->lastFailureMs = nowMs;
		while (entry->failures.Count() > 0 && nowMs - entry->failures[0] >= kFailureWindowMs) entry->failures.RemoveAt(0);
		entry->failures.Push(nowMs);
		if (entry->failures.Count() < kFailuresBeforeLockout) return false;
		entry->failures.Clear();
		entry->lockouts += 1;
		entry->lockedUntilMs = nowMs + LockoutMs(entry->lockouts);
		return true;
	}

	void LoginThrottle::Succeeded(Core::StringView address) { attempts.Remove(Core::String(address)); }
}
