include "SecretStore.ch"
include "web/Json.ch"

namespace Ied
{
	// CRYPTPROTECT_UI_FORBIDDEN: never ask the user anything (the server has no window to ask in).
	const uint32 c_DpapiNoUi = 1;

	bool IsSecretName(Core::StringView name) {
		const int64 length = name.ByteLength();
		if (length < 1 || length > 64) return false;
		for (int64 i = 0; i < length; ++i) {
			const int32 c = name.ByteAt(i);
			const bool letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
			const bool digit = c >= '0' && c <= '9';
			if (!letter && !digit && c != '.' && c != '_' && c != '-') return false;
		}
		return true;
	}

	Core::String SecretStore::SystemError(const char* what) {
		Core::StringBuilder text;
		text.Append(what);
		text.Append(" failed (error ");
		text.AppendInt(m_LastError != nullptr ? (int64)m_LastError() : (int64)0);
		text.Append(")");
		return text.ToString();
	}

	// DPAPI from the system's own libraries, loaded once; false with why on a system that has none.
	bool SecretStore::Load(Core::String& problem) {
		if (m_Loaded) {
			problem = m_LoadProblem;
			return m_LoadProblem.IsEmpty();
		}
		m_Loaded = true;
		Platform::Library crypt = Platform::Library("crypt32.dll");
		Platform::Library kernel = Platform::Library("kernel32.dll");
		if (crypt.IsOpen() && kernel.IsOpen()) {
			m_Protect = (funcptr<int32(DpapiBlob*, void*, DpapiBlob*, void*, void*, uint32, DpapiBlob*)>)crypt.Find("CryptProtectData");
			m_Unprotect = (funcptr<int32(DpapiBlob*, void*, DpapiBlob*, void*, void*, uint32, DpapiBlob*)>)crypt.Find("CryptUnprotectData");
			m_LocalFree = (funcptr<void*(void*)>)kernel.Find("LocalFree");
			m_LastError = (funcptr<uint32()>)kernel.Find("GetLastError");
		}
		if (m_Protect == nullptr || m_Unprotect == nullptr || m_LocalFree == nullptr) {
			m_LoadProblem = Core::String("IED's secret store keeps values with Windows' DPAPI, which this system does not have; name an environment variable instead: { \"env\": \"<variable>\" } (docs/11 \"Secrets\")");
			problem = m_LoadProblem;
			return false;
		}
		m_Crypt = take(crypt);
		m_Kernel = take(kernel);
		return true;
	}

	bool SecretStore::Available(Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		return Load(problem);
	}

	bool SecretStore::Protect(Core::StringView name, Core::StringView value, Core::String& sealed, Core::String& problem) {
		DpapiBlob input;
		input.m_Size = (uint32)value.ByteLength();
		input.m_Data = (uint8*)value.Data();
		DpapiBlob entropy;
		entropy.m_Size = (uint32)name.ByteLength();
		entropy.m_Data = (uint8*)name.Data();
		DpapiBlob output;
		output.m_Size = 0;
		output.m_Data = nullptr;
		if (m_Protect(&input, nullptr, &entropy, nullptr, nullptr, c_DpapiNoUi, &output) == 0) {
			problem = SystemError("encrypting it (CryptProtectData)");
			return false;
		}
		sealed = Core::Base64Encode((const void*)output.m_Data, (int64)output.m_Size);
		m_LocalFree((void*)output.m_Data);
		return true;
	}

	bool SecretStore::Unprotect(Core::StringView name, Core::StringView sealed, Core::String& value, Core::String& problem) {
		Core::Array<uint8> bytes;
		if (!Core::Base64Decode(sealed, bytes) || bytes.Count() == 0) {
			problem = (Core::String("the secret '") + name) + "' in " + m_File.View() + " is not base64";
			return false;
		}
		DpapiBlob input;
		input.m_Size = (uint32)bytes.Count();
		input.m_Data = (uint8*)bytes.Data();
		DpapiBlob entropy;
		entropy.m_Size = (uint32)name.ByteLength();
		entropy.m_Data = (uint8*)name.Data();
		DpapiBlob output;
		output.m_Size = 0;
		output.m_Data = nullptr;
		if (m_Unprotect(&input, nullptr, &entropy, nullptr, nullptr, c_DpapiNoUi, &output) == 0) {
			problem = (Core::String("the secret '") + name) + "' cannot be decrypted by this Windows user: " + SystemError("CryptUnprotectData").View() + "; store it again";
			return false;
		}
		value = Core::String(Core::StringView((const char*)output.m_Data, (int64)output.m_Size));
		m_LocalFree((void*)output.m_Data);
		return true;
	}

	// The file's secrets as JSON text members ("\"name\":{...}"), keyed by name; empty when there is no file.
	static bool ReadSecrets(Core::StringView file, Core::HashMap<Core::String, Core::String>& sealed, Core::HashMap<Core::String, int64>& setMs, Core::String& problem) {
		if (!FS::FileExists(Core::String(file).CStr())) return true;
		FS::File opened = FS::File(Core::String(file).CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc doc;
		Serialization::ReadResult read = Serialization::ReadJson(text.View(), doc);
		Serialization::DomNode secrets = read.Ok() ? read.root.Member("secrets") : Serialization::DomNode();
		if (!read.Ok() || secrets.Kind() != Serialization::DomKind::Object) {
			problem = Core::String(file) + " is not a secret store's file";
			return false;
		}
		for (int64 i = 0; i < secrets.Count(); ++i) {
			Serialization::DomNode entry = secrets.ValueAt(i);
			Core::StringView sealedText = entry.Member("dpapi").AsView();
			if (sealedText.IsEmpty()) continue;
			sealed.At(Core::String(secrets.KeyAt(i))) = Core::String(sealedText);
			setMs.At(Core::String(secrets.KeyAt(i))) = entry.Member("setMs").AsInt();
		}
		return true;
	}

	static bool WriteSecrets(Core::StringView file, const Core::HashMap<Core::String, Core::String>& sealed, const Core::HashMap<Core::String, int64>& setMs, Core::String& problem) {
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, Core::String>& entry : sealed) names.Push(entry.key);
		names.Sort();
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Key(Core::StringView("secrets"));
		json.BeginObject();
		for (const Core::String& name : names) {
			json.Key(name.View());
			json.BeginObject();
			json.Field("dpapi", sealed.Get(name).View());
			json.IntField("setMs", setMs.Contains(name) ? setMs.Get(name) : (int64)0);
			json.EndObject();
		}
		json.EndObject();
		json.EndObject();
		Core::String text = json.ToString() + "\n";
		FS::Path path = FS::Path(file);
		FS::MakeDirectories(path.Parent().CStr());
		if (FS::WriteFileAtomically(path.CStr(), (const void*)text.View().Data(), text.ByteLength())) return true;
		problem = Core::String("cannot write ") + file;
		return false;
	}

	bool SecretStore::Get(Core::StringView name, Core::String& value, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		if (!Load(problem)) return false;
		Core::HashMap<Core::String, Core::String> sealed;
		Core::HashMap<Core::String, int64> setMs;
		if (!ReadSecrets(m_File.View(), sealed, setMs, problem)) return false;
		if (!sealed.Contains(Core::String(name))) {
			problem = (Core::String("no secret '") + name) + "' is stored on this machine";
			return false;
		}
		return Unprotect(name, sealed.Get(Core::String(name)).View(), value, problem);
	}

	bool SecretStore::Set(Core::StringView name, Core::StringView value, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		if (!Load(problem)) return false;
		Core::HashMap<Core::String, Core::String> sealed;
		Core::HashMap<Core::String, int64> setMs;
		if (!ReadSecrets(m_File.View(), sealed, setMs, problem)) return false;
		Core::String text;
		if (!Protect(name, value, text, problem)) return false;
		sealed.At(Core::String(name)) = text;
		setMs.At(Core::String(name)) = Platform::UnixTimeNs() / 1000000;
		return WriteSecrets(m_File.View(), sealed, setMs, problem);
	}

	bool SecretStore::Remove(Core::StringView name, bool& removed, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		removed = false;
		Core::HashMap<Core::String, Core::String> sealed;
		Core::HashMap<Core::String, int64> setMs;
		if (!ReadSecrets(m_File.View(), sealed, setMs, problem)) return false;
		if (!sealed.Contains(Core::String(name))) return true;
		sealed.Remove(Core::String(name));
		setMs.Remove(Core::String(name));
		removed = true;
		return WriteSecrets(m_File.View(), sealed, setMs, problem);
	}

	Core::String SecretStore::ListJson() {
		Threading::LockGuard guard(m_Lock);
		Core::String problem;
		const bool available = Load(problem);
		Core::HashMap<Core::String, Core::String> sealed;
		Core::HashMap<Core::String, int64> setMs;
		Core::String readProblem;
		ReadSecrets(m_File.View(), sealed, setMs, readProblem);
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, Core::String>& entry : sealed) names.Push(entry.key);
		names.Sort();
		JsonWriter json;
		json.BeginObject();
		json.BoolField("available", available);
		if (!problem.IsEmpty()) json.Field("problem", problem.View());
		else if (!readProblem.IsEmpty()) json.Field("problem", readProblem.View());
		json.Key(Core::StringView("secrets"));
		json.BeginArray();
		for (const Core::String& name : names) {
			json.BeginObject();
			json.Field("name", name.View());
			json.IntField("setMs", setMs.Contains(name) ? setMs.Get(name) : (int64)0);
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
