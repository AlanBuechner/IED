include "SecretStore.ch"
include "web/Json.ch"

namespace Ied
{
	// CRYPTPROTECT_UI_FORBIDDEN: never ask the user anything (the server has no window to ask in).
	const uint32 c_DpapiNoUi = 1;

	bool IsSecretName(Core::StringView name) {
		const int64 length = name.ByteLength();
		if (length < 1 || length > 64) return false;
		for (int64 i = 0; i < length; ++i) {
			const int32 c = name.ByteAt(i);
			const bool letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
			const bool digit = c >= '0' && c <= '9';
			if (!letter && !digit && c != '.' && c != '_' && c != '-') return false;
		}
		return true;
	}

	static const char* ProtectionName(SecretProtection protection) {
		if (protection == SecretProtection::Dpapi) return "dpapi";
		if (protection == SecretProtection::OwnerOnly) return "owner-only";
		return "none";
	}

	Core::String SecretStore::SystemError(const char* what) {
		Core::StringBuilder text;
		text.Append(what);
		text.Append(" failed (error ");
		text.AppendInt(m_LastError != nullptr ? (int64)m_LastError() : (int64)0);
		text.Append(")");
		return text.ToString();
	}

	// How this system keeps values, found once: DPAPI from Windows' own libraries, else chmod from the C library (Linux);
	// false with why on a system that has neither.
	bool SecretStore::Load(Core::String& problem) {
		if (m_Loaded) {
			problem = m_LoadProblem;
			return m_LoadProblem.IsEmpty();
		}
		m_Loaded = true;
		Platform::Library crypt = Platform::Library("crypt32.dll");
		Platform::Library kernel = Platform::Library("kernel32.dll");
		if (crypt.IsOpen() && kernel.IsOpen()) {
			m_Protect = (funcptr<int32(DpapiBlob*, void*, DpapiBlob*, void*, void*, uint32, DpapiBlob*)>)crypt.Find("CryptProtectData");
			m_Unprotect = (funcptr<int32(DpapiBlob*, void*, DpapiBlob*, void*, void*, uint32, DpapiBlob*)>)crypt.Find("CryptUnprotectData");
			m_LocalFree = (funcptr<void*(void*)>)kernel.Find("LocalFree");
			m_LastError = (funcptr<uint32()>)kernel.Find("GetLastError");
		}
		if (m_Protect != nullptr && m_Unprotect != nullptr && m_LocalFree != nullptr) {
			m_Protection = SecretProtection::Dpapi;
			m_Crypt = take(crypt);
			m_Kernel = take(kernel);
			return true;
		}
		Platform::Library libc = Platform::Library("libc.so.6");
		if (libc.IsOpen()) m_Chmod = (funcptr<int32(const char*, uint32)>)libc.Find("chmod");
		if (m_Chmod != nullptr) {
			m_Protection = SecretProtection::OwnerOnly;
			m_Libc = take(libc);
			return true;
		}
		m_LoadProblem = Core::String("IED's secret store keeps values with Windows' DPAPI or, on Linux, in a file only its user reads; this system has neither. Name an environment variable instead: { \"env\": \"<variable>\" } (docs/11 \"Secrets\")");
		problem = m_LoadProblem;
		return false;
	}

	bool SecretStore::Available(Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		return Load(problem);
	}

	bool SecretStore::Protect(Core::StringView name, Core::StringView value, Core::String& sealed, Core::String& problem) {
		DpapiBlob input;
		input.m_Size = (uint32)value.ByteLength();
		input.m_Data = (uint8*)value.Data();
		DpapiBlob entropy;
		entropy.m_Size = (uint32)name.ByteLength();
		entropy.m_Data = (uint8*)name.Data();
		DpapiBlob output;
		output.m_Size = 0;
		output.m_Data = nullptr;
		if (m_Protect(&input, nullptr, &entropy, nullptr, nullptr, c_DpapiNoUi, &output) == 0) {
			problem = SystemError("encrypting it (CryptProtectData)");
			return false;
		}
		sealed = Core::Base64Encode((const void*)output.m_Data, (int64)output.m_Size);
		m_LocalFree((void*)output.m_Data);
		return true;
	}

	bool SecretStore::Unprotect(Core::StringView name, Core::StringView sealed, Core::String& value, Core::String& problem) {
		Core::Array<uint8> bytes;
		if (!Core::Base64Decode(sealed, bytes) || bytes.Count() == 0) {
			problem = (Core::String("the secret '") + name) + "' in " + m_File.View() + " is not base64";
			return false;
		}
		DpapiBlob input;
		input.m_Size = (uint32)bytes.Count();
		input.m_Data = (uint8*)bytes.Data();
		DpapiBlob entropy;
		entropy.m_Size = (uint32)name.ByteLength();
		entropy.m_Data = (uint8*)name.Data();
		DpapiBlob output;
		output.m_Size = 0;
		output.m_Data = nullptr;
		if (m_Unprotect(&input, nullptr, &entropy, nullptr, nullptr, c_DpapiNoUi, &output) == 0) {
			problem = (Core::String("the secret '") + name) + "' cannot be decrypted by this Windows user: " + SystemError("CryptUnprotectData").View() + "; store it again";
			return false;
		}
		value = Core::String(Core::StringView((const char*)output.m_Data, (int64)output.m_Size));
		m_LocalFree((void*)output.m_Data);
		return true;
	}

	// The file's entries by name; none when there is no file.
	static bool ReadSecrets(Core::StringView file, Core::HashMap<Core::String, SecretEntry*>& entries, Core::String& problem) {
		if (!FS::FileExists(Core::String(file).CStr())) return true;
		FS::File opened = FS::File(Core::String(file).CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc doc;
		Serialization::ReadResult read = Serialization::ReadJson(text.View(), doc);
		Serialization::DomNode secrets = read.Ok() ? read.root.Member("secrets") : Serialization::DomNode();
		if (!read.Ok() || secrets.Kind() != Serialization::DomKind::Object) {
			problem = Core::String(file) + " is not a secret store's file";
			return false;
		}
		for (int64 i = 0; i < secrets.Count(); ++i) {
			Serialization::DomNode node = secrets.ValueAt(i);
			SecretEntry* entry = new SecretEntry();
			if (!node.Member("dpapi").AsView().IsEmpty()) {
				entry->m_Kind = Core::String("dpapi");
				entry->m_Data = Core::String(node.Member("dpapi").AsView());
			}
			else if (!node.Member("file").AsView().IsEmpty()) {
				entry->m_Kind = Core::String("file");
				entry->m_Data = Core::String(node.Member("file").AsView());
			}
			else continue;
			entry->m_SetMs = node.Member("setMs").AsInt();
			entries.At(Core::String(secrets.KeyAt(i))) = entry;
		}
		return true;
	}

	// The file written whole; on Linux its folder made readable by the user alone first (so the file is never readable by
	// another, even for the moment before its own mode is set), then the file.
	bool SecretStore::Write(const Core::HashMap<Core::String, SecretEntry*>& entries, Core::String& problem) {
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, SecretEntry*>& entry : entries) names.Push(entry.key);
		names.Sort();
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Field("protection", ProtectionName(m_Protection));
		json.Key(Core::StringView("secrets"));
		json.BeginObject();
		for (const Core::String& name : names) {
			SecretEntry* entry = entries.Get(name);
			json.Key(name.View());
			json.BeginObject();
			json.Field(entry->m_Kind.View() == "dpapi" ? "dpapi" : "file", entry->m_Data.View());
			json.IntField("setMs", entry->m_SetMs);
			json.EndObject();
		}
		json.EndObject();
		json.EndObject();
		Core::String text = json.ToString() + "\n";
		FS::Path path = FS::Path(m_File.View());
		FS::MakeDirectories(path.Parent().CStr());
		if (m_Protection == SecretProtection::OwnerOnly && m_Chmod(path.Parent().CStr(), c_SecretFolderMode) != 0) {
			problem = (Core::String("cannot make ") + path.Parent().View()) + " readable by its user alone (chmod 700)";
			return false;
		}
		if (!FS::WriteFileAtomically(path.CStr(), (const void*)text.View().Data(), text.ByteLength())) {
			problem = Core::String("cannot write ") + m_File.View();
			return false;
		}
		if (m_Protection == SecretProtection::OwnerOnly && m_Chmod(path.CStr(), c_SecretFileMode) != 0) {
			problem = (Core::String("cannot make ") + m_File.View()) + " readable by its user alone (chmod 600)";
			return false;
		}
		return true;
	}

	bool SecretStore::Get(Core::StringView name, Core::String& value, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		if (!Load(problem)) return false;
		Core::HashMap<Core::String, SecretEntry*> entries;
		if (!ReadSecrets(m_File.View(), entries, problem)) return false;
		SecretEntry* entry = entries.Contains(Core::String(name)) ? entries.Get(Core::String(name)) : nullptr;
		if (!entry) {
			problem = (Core::String("no secret '") + name) + "' is stored on this machine";
			return false;
		}
		if (entry->m_Kind.View() == "dpapi") {
			if (m_Protection != SecretProtection::Dpapi) {
				problem = (Core::String("the secret '") + name) + "' was stored with Windows' DPAPI, which this system does not have; store it again";
				return false;
			}
			return Unprotect(name, entry->m_Data.View(), value, problem);
		}
		Core::Array<uint8> bytes;
		if (!Core::Base64Decode(entry->m_Data.View(), bytes)) {
			problem = (Core::String("the secret '") + name) + "' in " + m_File.View() + " is not base64";
			return false;
		}
		value = Core::String(Core::StringView((const char*)bytes.Data(), bytes.Count()));
		return true;
	}

	bool SecretStore::Set(Core::StringView name, Core::StringView value, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		if (!Load(problem)) return false;
		Core::HashMap<Core::String, SecretEntry*> entries;
		if (!ReadSecrets(m_File.View(), entries, problem)) return false;
		SecretEntry* entry = new SecretEntry();
		if (m_Protection == SecretProtection::Dpapi) {
			entry->m_Kind = Core::String("dpapi");
			if (!Protect(name, value, entry->m_Data, problem)) return false;
		}
		else {
			entry->m_Kind = Core::String("file");
			entry->m_Data = Core::Base64Encode((const void*)value.Data(), value.ByteLength());
		}
		entry->m_SetMs = Platform::UnixTimeNs() / 1000000;
		entries.At(Core::String(name)) = entry;
		return Write(entries, problem);
	}

	bool SecretStore::Remove(Core::StringView name, bool& removed, Core::String& problem) {
		Threading::LockGuard guard(m_Lock);
		removed = false;
		Core::HashMap<Core::String, SecretEntry*> entries;
		if (!ReadSecrets(m_File.View(), entries, problem)) return false;
		if (!entries.Contains(Core::String(name))) return true;
		Load(problem);
		problem = Core::String();
		entries.Remove(Core::String(name));
		removed = true;
		return Write(entries, problem);
	}

	Core::String SecretStore::ListJson() {
		Threading::LockGuard guard(m_Lock);
		Core::String problem;
		const bool available = Load(problem);
		Core::HashMap<Core::String, SecretEntry*> entries;
		Core::String readProblem;
		ReadSecrets(m_File.View(), entries, readProblem);
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, SecretEntry*>& entry : entries) names.Push(entry.key);
		names.Sort();
		JsonWriter json;
		json.BeginObject();
		json.BoolField("available", available);
		json.Field("protection", ProtectionName(m_Protection));
		if (!problem.IsEmpty()) json.Field("problem", problem.View());
		else if (!readProblem.IsEmpty()) json.Field("problem", readProblem.View());
		json.Key(Core::StringView("secrets"));
		json.BeginArray();
		for (const Core::String& name : names) {
			json.BeginObject();
			json.Field("name", name.View());
			json.IntField("setMs", entries.Get(name)->m_SetMs);
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
