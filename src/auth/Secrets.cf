include "Secrets.ch"
include "host/Server.ch"
include "web/Json.ch"

namespace Ied
{
	void Secrets::Init(Server* server) {
		this.m_Server = server;
		m_Store = new SecretStore((FS::Path(server->m_Config.m_DataDir.View()) / "auth" / "secrets.json").View());
		Secrets* self = this;
		server->m_Rpc.Register("secrets.list", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->m_Rpc.Register("secrets.set", [self](Call& call, const Params& params) -> Core::String { return self->SetMethod(call, params); });
		server->m_Rpc.Register("secrets.remove", [self](Call& call, const Params& params) -> Core::String { return self->RemoveMethod(call, params); });
	}

	static Core::String SecretName(const Params& params) {
		Core::String name = params.Str("name");
		if (!IsSecretName(name.View())) throw RpcError(ErrorCode::BadRequest, "a secret's name is 1 to 64 letters, digits, '.', '_' and '-'");
		return name;
	}

	Core::String Secrets::ListMethod(Call& call, const Params& params) { return m_Store->ListJson(); }

	Core::String Secrets::SetMethod(Call& call, const Params& params) {
		Core::String name = SecretName(params);
		Core::String value = params.Str("value");
		if (value.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "a secret's value is not empty");
		if (value.ByteLength() > c_MostSecretBytes) throw RpcError(ErrorCode::BadRequest, "a secret's value is at most 4096 bytes");
		Core::String problem;
		if (!m_Store->Set(name.View(), value.View(), problem)) throw RpcError(ErrorCode::Unavailable, problem.View());
		Changed("secret-set", name.View());
		return Core::String("{}");
	}

	Core::String Secrets::RemoveMethod(Call& call, const Params& params) {
		Core::String name = SecretName(params);
		bool removed = false;
		Core::String problem;
		if (!m_Store->Remove(name.View(), removed, problem)) throw RpcError(ErrorCode::Unavailable, problem.View());
		if (removed) Changed("secret-removed", name.View());
		return Core::String(removed ? "{\"removed\":true}" : "{\"removed\":false}");
	}

	// The security log names the secret (never its value), every window hears the list, and the config server mirror
	// looks again at once: its token may be this one.
	void Secrets::Changed(const char* event, Core::StringView name) {
		JsonWriter fields;
		fields.BeginObject();
		fields.Field("name", name);
		fields.EndObject();
		Core::StringView members = fields.View();
		m_Server->m_Auth->Record(event, members.Substring(1, members.ByteLength() - 2));
		m_Server->m_Hub.Publish(Core::StringView("server"), "secrets.changed", m_Store->ListJson().View());
		if (m_Server->m_SharedMirror) m_Server->m_SharedMirror->Wake();
	}
}
