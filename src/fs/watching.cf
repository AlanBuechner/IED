include "watching.ch"

namespace Ied
{
	bool FolderWatch::Start(const FS::Path& folder, BatchHandler handle, Core::String& error) {
		watcher = new FS::Watcher(folder.CStr());
		if (!watcher->IsOpen()) {
			error = Core::String(watcher->Error());
			return false;
		}
		FolderWatch* self = this;
		thread = Threading::Thread::Run([self, handle]() { self->Run(handle); });
		return true;
	}

	// Waits forever while nothing is gathered, then a quiet spell at most; a batch that keeps growing goes out after
	// kLongestBatchMs anyway, so a long burst still shows up as it happens.
	void FolderWatch::Run(BatchHandler handle) {
		ChangeBatch batch;
		int64 firstNs = 0;
		for (;;) {
			FS::Change change;
			const bool more = watcher->Next(change, batch.IsEmpty() ? FS::kWaitForever : kQuietMs);
			if (!more && !watcher->TimedOut()) return;
			if (more) {
				if (batch.IsEmpty()) firstNs = clock_now_ns();
				batch.Add(change);
				if (clock_now_ns() - firstNs < kLongestBatchMs * 1000000) continue;
			}
			if (batch.IsEmpty()) continue;
			handle(batch);
			batch.Clear();
		}
	}
}
