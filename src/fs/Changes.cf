include "Changes.ch"

namespace Ied
{
	TreeChangeKind FirstChange(FS::ChangeKind kind) {
		if (kind == FS::ChangeKind::Added) return TreeChangeKind::Created;
		if (kind == FS::ChangeKind::Removed) return TreeChangeKind::Deleted;
		return TreeChangeKind::Changed;
	}

	bool FoldChange(TreeChangeKind before, FS::ChangeKind kind, TreeChangeKind& after) {
		const bool removed = kind == FS::ChangeKind::Removed;
		if (before == TreeChangeKind::Created && removed) return false;
		if (before == TreeChangeKind::Created) after = TreeChangeKind::Created;
		else if (removed) after = TreeChangeKind::Deleted;
		else after = TreeChangeKind::Changed;
		return true;
	}

	const char* TreeChangeName(TreeChangeKind kind) {
		if (kind == TreeChangeKind::Created) return "created";
		if (kind == TreeChangeKind::Deleted) return "deleted";
		return "changed";
	}

	Core::String WatchedPath(Core::StringView path) {
		Core::StringBuilder text;
		for (int64 i = 0; i < path.ByteLength(); ++i) text.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return text.ToString();
	}

	void ChangeBatch::Fold(Core::StringView path, FS::ChangeKind kind) {
		Core::String key = Core::String(path);
		int64 at = -1;
		if (!m_Index.TryGet(key, at)) {
			m_Index.Insert(key, m_Entries.Count());
			TreeChange change;
			change.m_Path = key;
			change.m_Kind = FirstChange(kind);
			m_Entries.Push(change);
			m_Live.Push(true);
			m_LiveCount += 1;
			return;
		}
		const bool was = m_Live[at];
		if (was) m_Live[at] = FoldChange(m_Entries[at].m_Kind, kind, m_Entries[at].m_Kind);
		else {
			m_Entries[at].m_Kind = FirstChange(kind);
			m_Live[at] = true;
		}
		m_LiveCount += (m_Live[at] ? 1 : 0) - (was ? 1 : 0);
	}

	Core::Array<TreeChange> ChangeBatch::Changes() const {
		Core::Array<TreeChange> folded;
		for (int64 i = 0; i < m_Entries.Count(); ++i)
			if (m_Live[i]) folded.Push(m_Entries[i]);
		return folded;
	}

	void ChangeBatch::Add(const FS::Change& change) {
		if (change.kind == FS::ChangeKind::Overflow) {
			m_Overflow = true;
			return;
		}
		if (change.kind != FS::ChangeKind::Renamed) {
			Fold(WatchedPath(change.path.View()).View(), change.kind);
			return;
		}
		Fold(WatchedPath(change.oldPath.View()).View(), FS::ChangeKind::Removed);
		Fold(WatchedPath(change.path.View()).View(), FS::ChangeKind::Added);
	}

	void ChangeBatch::Clear() {
		m_Entries.Clear();
		m_Live.Clear();
		m_Index.Clear();
		m_LiveCount = 0;
		m_Overflow = false;
	}
}
