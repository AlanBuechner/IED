include "ignore.ch"

namespace Ied
{
	static IgnoreRule RuleOf(Core::StringView line) {
		IgnoreRule rule;
		if (line.StartsWith(Core::StringView("!"))) {
			rule.negate = true;
			line = line.Substring(1, line.ByteLength() - 1);
		}
		if (line.EndsWith(Core::StringView("/"))) {
			rule.directoryOnly = true;
			line = line.Substring(0, line.ByteLength() - 1);
		}
		if (line.StartsWith(Core::StringView("/"))) {
			rule.anchored = true;
			line = line.Substring(1, line.ByteLength() - 1);
		}
		rule.anchored = rule.anchored || line.IndexOf('/', 0) >= 0;
		rule.pattern = Core::String(line);
		return rule;
	}

	Core::Array<IgnoreRule> ParseIgnoreRules(Core::StringView text) {
		Core::Array<IgnoreRule> rules;
		int64 start = 0;
		while (start < text.ByteLength()) {
			int64 end = text.IndexOf('\n', start);
			if (end < 0) end = text.ByteLength();
			Core::StringView line = text.Substring(start, end - start).Trimmed();
			if (!line.IsEmpty() && !line.StartsWith(Core::StringView("#")) && line != "!" && line != "/") rules.Push(RuleOf(line));
			start = end + 1;
		}
		return rules;
	}

	static Core::StringView NameOf(Core::StringView path) {
		for (int64 i = path.ByteLength() - 1; i >= 0; --i)
			if (path.ByteAt(i) == '/') return path.Substring(i + 1, path.ByteLength() - i - 1);
		return path;
	}

	static bool Matches(const IgnoreRule& rule, Core::StringView relative, bool directory) {
		if (rule.directoryOnly && !directory) return false;
		return GlobMatch(rule.pattern.View(), rule.anchored ? relative : NameOf(relative));
	}

	// `path` relative to `folder`, or false when it is not under it.
	static bool Below(Core::StringView folder, Core::StringView path, Core::StringView& relative) {
		if (folder.IsEmpty()) {
			relative = path;
			return true;
		}
		if (path.ByteLength() <= folder.ByteLength() + 1 || !path.StartsWith(folder) || path.ByteAt(folder.ByteLength()) != '/') return false;
		relative = path.Substring(folder.ByteLength() + 1, path.ByteLength() - folder.ByteLength() - 1);
		return true;
	}

	bool IsIgnored(const Core::Array<IgnoreFile*>& files, Core::StringView path, bool directory) {
		bool ignored = false;
		for (const IgnoreFile* file : files) {
			Core::StringView relative;
			if (!Below(file->folder.View(), path, relative)) continue;
			for (const IgnoreRule& rule : file->rules)
				if (Matches(rule, relative, directory)) ignored = !rule.negate;
		}
		return ignored;
	}
}
