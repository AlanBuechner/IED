include "Search.ch"

namespace Ied
{
	static int32 FoldAscii(int32 c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }

	static Core::String Folded(Core::StringView text) {
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) out.AppendByte(FoldAscii(text.ByteAt(i)));
		return out.ToString();
	}

	void LineMatcher::Init(const SearchQuery& query) {
		Core::String body = query.m_Regex ? query.m_Text : EscapeRegex(query.m_Text.View());
		m_Pattern = Core::Regex((query.m_CaseSensitive ? body : Core::String("(?i)") + body.View()).View());
		m_Folded = !query.m_CaseSensitive;
		if (!query.m_Regex) m_Literal = m_Folded ? Folded(query.m_Text.View()) : query.m_Text;
	}

	// Whether `needle` (folded already when `fold`) occurs in `text`, folding the text's ASCII letters as it goes.
	static bool Contains(Core::StringView text, Core::StringView needle, bool fold) {
		const int64 last = text.ByteLength() - needle.ByteLength();
		if (needle.IsEmpty()) return true;
		const int32 first = needle.ByteAt(0);
		for (int64 at = 0; at <= last; ++at) {
			if ((fold ? FoldAscii(text.ByteAt(at)) : text.ByteAt(at)) != first) continue;
			int64 i = 1;
			while (i < needle.ByteLength() && (fold ? FoldAscii(text.ByteAt(at + i)) : text.ByteAt(at + i)) == needle.ByteAt(i)) i += 1;
			if (i == needle.ByteLength()) return true;
		}
		return false;
	}

	bool LineMatcher::MayMatch(Core::StringView text) const { return m_Literal.IsEmpty() || Contains(text, m_Literal.View(), m_Folded); }

	int64 LineMatcher::Find(Core::StringView line) const {
		Core::RegexMatch found;
		if (!m_Pattern.Search(line, found) || found.End() == found.Start()) return -1;
		return Core::Utf16Length(line.Substring(0, found.Start()));
	}

	Core::Array<Core::String> DefaultSearchExcludes() {
		Core::Array<Core::String> folders;
		const char*[9] names = { "**/.git", "**/node_modules", "**/build", "**/bin", "**/bin-int", "**/toolchains", "**/vendor",
			"**/third_party", "**/__pycache__" };
		for (const char* name : names) folders.Push(Core::String(name));
		return folders;
	}

	Core::String EscapeRegex(Core::StringView text) {
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			if (Core::StringView("\\.^$|?*+()[]{}").IndexOf((char)c, 0) >= 0) out.AppendByte('\\');
			out.AppendByte(c);
		}
		return out.ToString();
	}

	bool IsSearched(Core::StringView path, const SearchQuery& query) {
		if (MatchesAny(query.m_Exclude, path)) return false;
		return query.m_Include.IsEmpty() || MatchesAny(query.m_Include, path);
	}

	static Core::String Preview(Core::StringView line) {
		Core::StringView trimmed = line.Trimmed();
		if (trimmed.CharCount() <= c_SearchPreviewChars) return Core::String(trimmed);
		int64 bytes = 0;
		for (int64 chars = 0; chars < c_SearchPreviewChars && bytes < trimmed.ByteLength(); ++chars) {
			bytes += 1;
			while (bytes < trimmed.ByteLength() && (trimmed.ByteAt(bytes) & 0xC0) == 0x80) bytes += 1;
		}
		return Core::String(trimmed.Substring(0, bytes));
	}

	void SearchText(Core::StringView path, Core::StringView text, const LineMatcher& matcher, int64 limit, SearchResult& result) {
		if (!matcher.MayMatch(text)) return;
		int64 start = 0;
		for (int64 number = 0; start <= text.ByteLength(); ++number) {
			int64 end = text.IndexOf('\n', start);
			if (end < 0) end = text.ByteLength();
			Core::StringView line = text.Substring(start, end - start);
			if (!line.IsEmpty() && line.ByteAt(line.ByteLength() - 1) == '\r') line = line.Substring(0, line.ByteLength() - 1);
			const int64 col = matcher.Find(line);
			if (col >= 0) {
				if (result.m_Matches.Count() >= limit) {
					result.m_Truncated = true;
					return;
				}
				SearchMatch match;
				match.m_Path = Core::String(path);
				match.m_Line = number;
				match.m_Col = col;
				match.m_Preview = Preview(line);
				result.m_Matches.Push(match);
			}
			start = end + 1;
		}
	}

	static bool HasNul(Core::StringView bytes) {
		for (int64 i = 0; i < bytes.ByteLength(); ++i)
			if (bytes.ByteAt(i) == 0) return true;
		return false;
	}

	// The text a search reads for a file: an open document's, else the file's when it is small and its first bytes say
	// it is text; false to skip it (`tooLarge` set when its size was why).
	static bool TextToSearch(const FS::Path& file, Core::StringView path, const Core::HashMap<Core::String, Core::String>& open, Core::String& text, bool& tooLarge) {
		tooLarge = false;
		if (open.TryGet(Core::String(path), text)) return true;
		FS::FileInfo info;
		if (!FS::GetInfo(file.CStr(), info)) return false;
		if (info.size > c_SearchFileLimitBytes) {
			tooLarge = true;
			return false;
		}
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen()) return false;
		char[c_SearchBinaryProbeBytes] probe;
		const int64 got = opened.Read((void*)&probe[0], c_SearchBinaryProbeBytes);
		if (got < 0 || HasNul(Core::StringView(&probe[0], got))) return false;
		opened.Seek(0);
		text = opened.ReadText();
		return true;
	}

	SearchResult SearchFolder(const FS::Path& root, const SearchQuery& query, const Core::HashMap<Core::String, Core::String>& open,
		const Threading::Atomic<bool>* cancel) {
		SearchResult* result = new SearchResult();
		LineMatcher* matcher = new LineMatcher(query);
		if (!matcher->IsValid()) return *result;
		FileWalk walk;
		walk.m_Root = root;
		walk.m_Exclude = query.m_Exclude;
		walk.m_UseIgnoreFiles = query.m_UseIgnoreFiles;
		walk.m_Cancel = cancel;
		const SearchQuery* asked = &query;
		const Core::HashMap<Core::String, Core::String>* texts = &open;
		walk.Run([result, matcher, asked, texts, root](Core::StringView path) -> bool {
			if (!IsSearched(path, *asked)) return true;
			Core::String text;
			bool tooLarge = false;
			if (TextToSearch(root / path, path, *texts, text, tooLarge)) SearchText(path, text.View(), *matcher, asked->m_MaxResults, *result);
			else if (tooLarge) result->m_TooLarge.Push(Core::String(path));
			return !result->m_Truncated;
		});
		return *result;
	}
}
