include "Install.ch"
include "Commands.ch"

namespace Ied
{
	const int64 c_InstallReadBytes = 16384;
	const int64 c_DigestChunkBytes = 65536;

	void InstallControl::Cancel() {
		Threading::LockGuard guard(m_Lock);
		m_Cancelled = true;
		if (m_Child) m_Child->Kill();
	}

	bool InstallControl::Cancelled() {
		Threading::LockGuard guard(m_Lock);
		return m_Cancelled;
	}

	bool InstallControl::Running(Process::Child* started) {
		Threading::LockGuard guard(m_Lock);
		m_Child = started;
		if (m_Cancelled) started->Kill();
		return !m_Cancelled;
	}

	void InstallControl::Ended() {
		Threading::LockGuard guard(m_Lock);
		m_Child = nullptr;
	}

	Core::String ReplaceAll(Core::StringView text, Core::StringView from, Core::StringView to) {
		if (from.IsEmpty()) return Core::String(text);
		Core::StringBuilder out;
		int64 at = 0;
		for (;;) {
			const int64 found = text.IndexOf(from, at);
			if (found < 0) break;
			out.Append(text.Substring(at, found - at));
			out.Append(to);
			at = found + from.ByteLength();
		}
		out.Append(text.Substring(at, text.ByteLength() - at));
		return out.ToString();
	}

	static bool IsHexDigit(int32 c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }

	Core::String DigestIn(Core::StringView text) {
		int64 run = 0;
		for (int64 i = 0; i <= text.ByteLength(); ++i) {
			if (i < text.ByteLength() && IsHexDigit(text.ByteAt(i))) {
				run += 1;
				continue;
			}
			if (run == 64) return text.Substring(i - 64, 64).ToLower();
			run = 0;
		}
		return Core::String();
	}

	Core::String FileDigest(const FS::Path& file) {
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen()) return Core::String();
		Crypto::Sha256Builder digest;
		uint8[65536] buffer;
		for (;;) {
			const int64 got = opened.Read((void*)&buffer[0], c_DigestChunkBytes);
			if (got < 0) return Core::String();
			if (got == 0) break;
			digest.Add((const void*)&buffer[0], got);
		}
		return digest.Finish().ToHex();
	}

	Core::String UrlFileName(Core::StringView url) {
		Core::StringView path = url;
		const int64 query = path.IndexOf('?', 0);
		if (query >= 0) path = path.Substring(0, query);
		int64 slash = -1;
		for (int64 i = 0; i < path.ByteLength(); ++i)
			if (path.ByteAt(i) == '/') slash = i;
		Core::StringView name = path.Substring(slash + 1, path.ByteLength() - slash - 1);
		return name.IsEmpty() ? Core::String("download") : Core::String(name);
	}

	// A program of the system's own (curl.exe, tar.exe in System32), so a curl or tar of another kind on PATH is not the
	// one that runs; the name alone when System32 has none.
	static Core::String SystemProgram(const char* name) {
		Core::String root;
		if (Platform::TryGetEnvironmentVariable("SystemRoot", root)) {
			FS::Path file = FS::Path(root.View()) / "System32" / name;
			if (FS::FileExists(file.CStr())) return Core::String(file.View());
		}
		return Core::String(name);
	}

	// Runs `argv`, its output said as it comes; false with `problem` when it does not start, fails or is cancelled.
	static bool RunStreaming(const Core::Array<Core::String>& argv, Core::StringView cwd, const Core::Array<Core::String>& environment, InstallControl* control, const InstallSay& say, Core::String& problem) {
		Process::StartInfo info;
		if (!CommandStartInfo(argv, cwd, environment, info, problem)) return false;
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::ToOutput;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			problem = ((Core::String("cannot start ") + argv[0].View()) + ": ") + started.Error();
			return false;
		}
		Process::Child* child = new Process::Child(take(started));
		if (!control->Running(child)) {
			child->Wait();
			control->Ended();
			problem = Core::String("cancelled");
			return false;
		}
		char8[16384] buffer;
		Core::String carried;
		while (child->HasOutput()) {
			Process::Stream from;
			const int64 got = child->ReadAny((void*)&buffer[0], c_InstallReadBytes, from, 200);
			if (got == Process::kTimedOut) continue;
			if (got <= 0) break;
			say(Core::StringView(&buffer[0], got));
		}
		const int64 code = child->Wait();
		control->Ended();
		child->Close();
		if (control->Cancelled()) {
			problem = Core::String("cancelled");
			return false;
		}
		if (code != 0) {
			Core::StringBuilder why;
			why.Append(FS::Path(argv[0].View()).FileName());
			why.Append(" exited with code ");
			why.AppendInt(code);
			problem = why.ToString();
			return false;
		}
		return true;
	}

	// curl -fsSL to `file`; false with `problem`.
	static bool Fetch(Core::StringView url, const FS::Path& file, const InstallPlan& plan, InstallControl* control, const InstallSay& say, Core::String& problem) {
		Core::Array<Core::String> argv;
		argv.Push(SystemProgram("curl.exe"));
		argv.Push(Core::String("-fsSL"));
		argv.Push(Core::String("--retry"));
		argv.Push(Core::String("2"));
		argv.Push(Core::String("--connect-timeout"));
		argv.Push(Core::String("30"));
		argv.Push(Core::String("-o"));
		argv.Push(Core::String(file.View()));
		argv.Push(Core::String(url));
		if (RunStreaming(argv, plan.m_Downloads.View(), plan.m_Environment, control, say, problem)) return true;
		problem = ((Core::String("the download of ") + url) + " failed: ") + problem.View();
		return false;
	}

	// The SHA-256 the download must have: the manifest's for the tool's install version, else the digest file's.
	static bool ExpectedDigest(const InstallStep* step, const InstallPlan& plan, Core::StringView url, InstallControl* control, const InstallSay& say, Core::String& digest, Core::String& problem) {
		if (plan.m_Version == plan.m_Spec->m_InstallVersion && !step->m_Sha256.IsEmpty()) {
			digest = step->m_Sha256;
			return true;
		}
		if (step->m_Sha256Url.IsEmpty()) {
			problem = ((((Core::String("no SHA-256 to check the download of ") + plan.m_Spec->m_Title.View()) + " ") + plan.m_Version.View()) + " against: the plugin pins only ") + plan.m_Spec->m_InstallVersion.View();
			return false;
		}
		Core::String digestUrl = plan.m_Expand(step->m_Sha256Url.View());
		FS::Path file = plan.m_Downloads / (UrlFileName(url) + ".sha256").View();
		say(((Core::String("Checksum from ") + digestUrl.View()) + "\r\n").View());
		if (!Fetch(digestUrl.View(), file, plan, control, say, problem)) return false;
		FS::File opened = FS::File(file.CStr(), "rb");
		digest = DigestIn(opened.IsOpen() ? opened.ReadText().View() : Core::StringView(""));
		opened.Close();
		FS::RemoveFile(file.CStr());
		if (digest.IsEmpty()) problem = digestUrl + " holds no SHA-256";
		return !digest.IsEmpty();
	}

	static bool Unpack(const InstallStep* step, const InstallPlan& plan, const FS::Path& file, Core::StringView url, InstallControl* control, const InstallSay& say, Core::String& problem) {
		if (step->m_Extract == "none") {
			FS::Path target = plan.m_Folder / (step->m_FileName.IsEmpty() ? UrlFileName(url) : plan.m_Expand(step->m_FileName.View())).View();
			if (FS::Rename(file.CStr(), target.CStr())) return true;
			problem = (Core::String("cannot move the download to ") + target.View());
			return false;
		}
		Core::Array<Core::String> argv;
		argv.Push(SystemProgram("tar.exe"));
		argv.Push(Core::String("-xf"));
		argv.Push(Core::String(file.View()));
		argv.Push(Core::String("-C"));
		argv.Push(Core::String(plan.m_Folder.View()));
		if (step->m_Strip > 0) {
			Core::StringBuilder strip;
			strip.Append("--strip-components=");
			strip.AppendInt(step->m_Strip);
			argv.Push(strip.ToString());
		}
		const bool done = RunStreaming(argv, plan.m_Downloads.View(), plan.m_Environment, control, say, problem);
		FS::RemoveFile(file.CStr());
		if (!done) problem = Core::String("unpacking failed: ") + problem.View();
		return done;
	}

	static bool Download(const InstallStep* step, const InstallPlan& plan, InstallControl* control, const InstallSay& say, Core::String& problem) {
		Core::String url = plan.m_Expand(step->m_Download.View());
		Core::String expected;
		if (!ExpectedDigest(step, plan, url.View(), control, say, expected, problem)) return false;
		FS::Path file = plan.m_Downloads / ((plan.m_Spec->m_Id + "-") + UrlFileName(url.View()).View()).View();
		say(((Core::String("Downloading ") + url.View()) + "\r\n").View());
		if (!Fetch(url.View(), file, plan, control, say, problem)) return false;
		Core::String got = FileDigest(file);
		if (got != expected) {
			FS::RemoveFile(file.CStr());
			problem = ((((Core::String("the download's SHA-256 is ") + got.View()) + ", not ") + expected.View()) + "; nothing of it was kept");
			return false;
		}
		say((Core::String("SHA-256 checked: ") + got.View() + "\r\n").View());
		return Unpack(step, plan, file, url.View(), control, say, problem);
	}

	static bool Command(const InstallStep* step, const InstallPlan& plan, InstallControl* control, const InstallSay& say, Core::String& problem) {
		Core::Array<Core::String> argv;
		for (const Core::String& word : step->m_Run) argv.Push(plan.m_Expand(word.View()));
		Core::Array<Core::String> environment = plan.m_Environment;
		for (const Core::String& entry : step->m_Environment) environment.Push(plan.m_Expand(entry.View()));
		Core::String cwd = step->m_Cwd.IsEmpty() ? plan.m_Cwd : plan.m_Expand(step->m_Cwd.View());
		Core::StringBuilder line;
		line.Append("> ");
		for (const Core::String& word : argv) {
			line.Append(word.View());
			line.Append(" ");
		}
		line.Append("\r\n");
		say(line.View());
		return RunStreaming(argv, cwd.View(), environment, control, say, problem);
	}

	bool RunInstall(const InstallPlan& plan, InstallControl* control, const InstallSay& say, Core::String& problem) {
		if (FS::IsDirectory(plan.m_Folder.CStr())) FS::RemoveAll(plan.m_Folder.CStr());
		if (!FS::MakeDirectories(plan.m_Folder.CStr()) || !FS::MakeDirectories(plan.m_Downloads.CStr())) {
			problem = Core::String("cannot make ") + plan.m_Folder.View();
			return false;
		}
		for (const InstallStep* step : plan.m_Spec->m_Steps) {
			say(((Core::String("-- ") + step->m_Label.View()) + "\r\n").View());
			const bool done = step->m_Download.IsEmpty() ? Command(step, plan, control, say, problem) : Download(step, plan, control, say, problem);
			if (!done || control->Cancelled()) {
				if (problem.IsEmpty()) problem = Core::String("cancelled");
				FS::RemoveAll(plan.m_Folder.CStr());
				return false;
			}
		}
		return true;
	}
}
