include "Versions.ch"

namespace Ied
{
	static bool IsDigit(int32 c) { return c >= '0' && c <= '9'; }

	// The numbers of a version from its first digit: "go1.22.3" is 1, 22, 3; "1.75.0-nightly" 1, 75, 0.
	static Core::Array<int64> Numbers(Core::StringView version) {
		Core::Array<int64> numbers;
		int64 at = 0;
		while (at < version.ByteLength() && !IsDigit(version.ByteAt(at))) at += 1;
		while (at < version.ByteLength() && IsDigit(version.ByteAt(at))) {
			int64 value = 0;
			while (at < version.ByteLength() && IsDigit(version.ByteAt(at))) {
				value = value * 10 + (version.ByteAt(at) - '0');
				at += 1;
			}
			numbers.Push(value);
			if (at + 1 < version.ByteLength() && version.ByteAt(at) == '.' && IsDigit(version.ByteAt(at + 1))) at += 1;
			else break;
		}
		return numbers;
	}

	int32 CompareVersions(Core::StringView a, Core::StringView b) {
		Core::Array<int64> left = Numbers(a);
		Core::Array<int64> right = Numbers(b);
		const int64 count = left.Count() > right.Count() ? left.Count() : right.Count();
		for (int64 i = 0; i < count; ++i) {
			const int64 x = i < left.Count() ? left[i] : 0;
			const int64 y = i < right.Count() ? right[i] : 0;
			if (x != y) return x < y ? -1 : 1;
		}
		return 0;
	}

	bool IsNumericVersion(Core::StringView version) { return !version.IsEmpty() && IsDigit(version.ByteAt(0)); }

	bool VersionSatisfies(Core::StringView found, Core::StringView wanted, bool minimum) {
		if (!IsNumericVersion(wanted)) return true;
		if (minimum) return CompareVersions(found, wanted) >= 0;
		Core::Array<int64> want = Numbers(wanted);
		Core::Array<int64> have = Numbers(found);
		if (have.Count() < want.Count()) return false;
		for (int64 i = 0; i < want.Count(); ++i)
			if (have[i] != want[i]) return false;
		return true;
	}

	static Core::String ReadSmallFile(const FS::Path& file) {
		if (!FS::FileExists(file.CStr()) || FS::FileSize(file.CStr()) > 1048576) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? opened.ReadText() : Core::String();
	}

	PinnedVersion FindPin(const FS::Path& root, const Core::Array<Core::String>& folders, const Core::Array<VersionSource*>& sources) {
		PinnedVersion pin;
		for (const VersionSource* source : sources) {
			Core::Regex regex = Core::Regex((Core::String("(?m)") + source->m_Regexp.View()).View());
			if (!regex.IsValid() || regex.GroupCount() < 1) continue;
			for (const Core::String& folder : folders) {
				Core::String relative = folder.IsEmpty() ? source->m_File : (folder + "/") + source->m_File.View();
				Core::String text = ReadSmallFile(root / relative.View());
				Core::RegexMatch found;
				if (text.IsEmpty() || !regex.Search(text.View(), found) || found.Group(1).Trimmed().IsEmpty()) continue;
				pin.m_Version = Core::String(found.Group(1).Trimmed());
				pin.m_Minimum = source->m_Minimum;
				pin.m_File = relative;
				return pin;
			}
		}
		return pin;
	}

	Core::String VersionToInstall(const PinnedVersion& pin, Core::StringView fallback) {
		if (pin.m_Version.IsEmpty()) return Core::String(fallback);
		if (!pin.m_Minimum) return pin.m_Version;
		if (fallback.IsEmpty() || CompareVersions(pin.m_Version.View(), fallback) > 0) return pin.m_Version;
		return Core::String(fallback);
	}

	Core::String ToolInstallVersion(const ToolSpec* spec, const PinnedVersion& pin) {
		Core::String version = VersionToInstall(pin, spec->m_InstallVersion.View());
		return version.IsEmpty() ? Core::String("latest") : version;
	}

	bool IsFolderSafeVersion(Core::StringView version) {
		bool other = false;
		for (int64 i = 0; i < version.ByteLength(); ++i) {
			const int32 c = version.ByteAt(i);
			const bool letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || IsDigit(c) || c == '_' || c == '-' || c == '+';
			if (!letter && c != '.') return false;
			other = other || letter;
		}
		return other;
	}
}
