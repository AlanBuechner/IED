include "Commands.ch"

namespace Ied
{
	bool IsBatchProgram(Core::StringView program) {
		Core::String lower = program.ToLower();
		return lower.View().EndsWith(Core::StringView(".cmd")) || lower.View().EndsWith(Core::StringView(".bat"));
	}

	bool QuotedBatchLine(const Core::Array<Core::String>& argv, Core::String& line, Core::String& problem) {
		Core::StringBuilder out;
		for (const Core::String& word : argv) {
			Core::StringView text = word.View();
			if (text.IndexOf('"', 0) >= 0 || text.IndexOf('%', 0) >= 0 || text.IndexOf('\n', 0) >= 0 || text.IndexOf('\r', 0) >= 0) {
				problem = Core::String("a batch file runs through cmd.exe, which would read the quote, '%' or line break in ") + text;
				return false;
			}
			if (out.ByteLength() > 0) out.Append(" ");
			out.AppendByte('"');
			out.Append(text);
			out.AppendByte('"');
		}
		line = out.ToString();
		return true;
	}

	bool CommandStartInfo(const Core::Array<Core::String>& argv, Core::StringView cwd, const Core::Array<Core::String>& environment, Process::StartInfo& info, Core::String& problem) {
		if (argv.IsEmpty() || argv[0].IsEmpty()) {
			problem = Core::String("no program");
			return false;
		}
		if (IsBatchProgram(argv[0].View())) {
			if (!QuotedBatchLine(argv, info.shellCommand, problem)) return false;
		}
		else {
			info.program = argv[0];
			for (int64 i = 1; i < argv.Count(); ++i) info.arguments.Push(argv[i]);
		}
		info.workingDirectory = Core::String(cwd);
		info.environment = environment;
		return true;
	}

	Core::String FirstLine(Core::StringView output) {
		for (Core::StringView line : output.Split('\n')) {
			Core::StringView text = line.Trimmed();
			if (text.IsEmpty()) continue;
			return Core::String(text.ByteLength() > 300 ? text.Substring(0, 300) : text);
		}
		return Core::String();
	}

	static bool IsPathEntry(Core::StringView entry) { return entry.ToLower().View().StartsWith(Core::StringView("path=")); }

	Core::Array<Core::String> WithPathFirst(const Core::Array<Core::String>& environment, Core::StringView prepend) {
		if (prepend.IsEmpty()) return environment;
		Core::Array<Core::String> out;
		Core::String path;
		bool given = false;
		for (const Core::String& entry : environment) {
			if (IsPathEntry(entry.View())) {
				path = Core::String(entry.View().Substring(5, entry.View().ByteLength() - 5));
				given = true;
			}
			else out.Push(entry);
		}
		if (!given && !Platform::TryGetEnvironmentVariable("PATH", path)) path = Core::String();
		out.Push((Core::String("PATH=") + prepend) + (path.IsEmpty() ? Core::String() : Core::String(";") + path.View()).View());
		return out;
	}
}
