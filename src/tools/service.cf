include "service.ch"
include "host/server.ch"
include "plugins/context.ch"
include "commands.ch"

namespace Ied
{
	Core::String ToolsTopic(const Workspace* ws) { return Core::String("tools:") + ws->wsId.View(); }

	FS::Path ToolsFolder(Server* server) { return FS::Path(server->config.dataDir.View()) / "tools"; }

	void Tools::Init(Server* server) {
		this.server = server;
		Tools* self = this;
		server->rpc.Register("tools.status", [self](Call& call, const Params& params) -> Core::String { return self->StatusMethod(call, params); });
		server->rpc.Register("tools.detect", [self](Call& call, const Params& params) -> Core::String { return self->DetectMethod(call, params); });
		server->rpc.Register("tools.install", [self](Call& call, const Params& params) -> Core::String { return self->InstallMethod(call, params); });
		server->rpc.Register("tools.cancel", [self](Call& call, const Params& params) -> Core::String { return self->CancelMethod(call, params); });
		server->rpc.Register("tools.dismiss", [self](Call& call, const Params& params) -> Core::String { return self->DismissMethod(call, params); });
	}

	// --- Workspaces --------------------------------------------------------------------------------------------------

	WorkspaceTools* Tools::EntryOf(Workspace* ws) {
		for (WorkspaceTools* entry : entries)
			if (entry->ws == ws) return entry;
		return nullptr;
	}

	WorkspaceTools* Tools::EntryParam(const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		WorkspaceTools* entry = EntryOf(ws);
		if (!entry) throw RpcError(ErrorCode::NotFound, (Core::String("no workspace ") + ws->wsId.View()).View());
		return entry;
	}

	void Tools::WorkspaceOpened(Workspace* ws) {
		WorkspaceTools* entry = new WorkspaceTools();
		entry->ws = ws;
		entries.Push(entry);
		Tools* self = this;
		server->hub.Add(ToolsTopic(ws).View(), [self, entry]() -> Core::String { return self->Snapshot(entry); });
		Detect(entry);
	}

	void Tools::TrustChanged(Workspace* ws) {
		WorkspaceTools* entry = EntryOf(ws);
		if (entry) Detect(entry);
	}

	void Tools::PluginsChanged(Workspace* ws) { TrustChanged(ws); }

	// A setting may name a tool's program: when one of the tools' settings changed, they are found again.
	void Tools::SettingsChanged(Workspace* ws) {
		WorkspaceTools* entry = EntryOf(ws);
		if (entry && entry->detected && ToolSettings(ws) != entry->settings) Detect(entry);
	}

	Core::String Tools::ToolSettings(Workspace* ws) {
		Core::StringBuilder values;
		for (const ToolSpec* spec : ToolsOf(ws))
			if (!spec->setting.IsEmpty()) {
				values.Append(spec->setting.View());
				values.Append("=");
				values.Append(SettingText(ws, spec->setting.View()).View());
				values.Append("\n");
			}
		return values.ToString();
	}

	// A pin file (go.mod, rust-toolchain.toml) that changed: its tools are found again.
	void Tools::FilesChanged(Workspace* ws, const ChangeBatch& batch) {
		WorkspaceTools* entry = EntryOf(ws);
		if (!entry || !entry->detected) return;
		if (batch.Overflowed()) {
			Detect(entry);
			return;
		}
		for (const TreeChange& change : batch.Changes()) {
			Core::StringView name = FS::Path(change.path.View()).FileName();
			for (const Core::String& pinned : entry->pinFiles)
				if (pinned.View() == name) {
					Detect(entry);
					return;
				}
		}
	}

	Core::Array<ToolSpec*> Tools::AllToolsOf(Workspace* ws) {
		Core::Array<ToolSpec*> all;
		for (const Contribution& given : server->plugins->Entries(ws, Core::StringView("tools")))
			all.Push(ReadToolSpec(given.entry, given.plugin->manifest->id.View(), given.plugin->manifest->name.View(), given.plugin->manifest->folder));
		return LastOfEachId(all);
	}

	Core::Array<ToolSpec*> Tools::ToolsOf(Workspace* ws) {
		Core::Array<ToolSpec*> holding;
		WhenLookup lookup = WorkspaceWhen(server, ws);
		for (ToolSpec* spec : AllToolsOf(ws)) {
			Core::String error;
			if (WhenHolds(spec->when.View(), lookup, error)) holding.Push(spec);
			else if (!error.IsEmpty()) server->Log((((Core::String("the when of tool ") + spec->id.View()) + " does not parse: ") + error.View()).View());
		}
		return holding;
	}

	// --- Finding them ------------------------------------------------------------------------------------------------

	Core::String Tools::SettingText(Workspace* ws, Core::StringView key) {
		if (key.IsEmpty()) return Core::String();
		Core::String json = server->settings->Effective(ws, Core::StringView(""), key);
		if (json.IsEmpty()) return Core::String();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode value = Serialization::ReadJson(json.View(), *doc).root;
		return value.Kind() == Serialization::DomKind::String ? Core::String(value.AsView()) : Core::String();
	}

	ProfileVariables Tools::VariablesFor(Workspace* ws, const ToolSpec* spec) {
		ProfileVariables variables;
		variables.pluginDir = Core::String(spec->pluginDir.View());
		variables.workspaceDir = Core::String(ws->root.View());
		variables.solutionDir = Core::String(ws->root.View());
		variables.iedHome = server->config.homeDir;
		variables.pluginState = Core::String((FS::Path(server->config.dataDir.View()) / "plugins" / spec->pluginId.View()).View());
		Settings* settings = server->settings;
		variables.config = [settings, ws](Core::StringView key) -> Core::String { return settings->Effective(ws, Core::StringView(""), key); };
		Tools* self = this;
		variables.tool = [self, ws](Core::StringView id) -> Core::String { return self->ProgramFor(ws, id); };
		return variables;
	}

	// The projects' code roots inside the workspace, relative to it: where a pin file may be besides the root.
	Core::Array<Core::String> Tools::ProjectFolders(Workspace* ws) {
		Core::Array<Core::String> folders;
		folders.Push(Core::String(""));
		if (!ws->solution) return folders;
		for (const ProjectModel* project : ws->solution->projects) {
			Core::String relative;
			if (!RelativeTo(ws->root.View(), project->root.View(), relative) || relative.IsEmpty()) continue;
			bool known = false;
			for (const Core::String& folder : folders) known = known || folder == relative;
			if (!known) folders.Push(relative);
		}
		return folders;
	}

	DetectJob* Tools::JobFor(Workspace* ws, ToolSpec* spec) {
		DetectJob* job = new DetectJob();
		job->spec = spec;
		Core::String looked;
		job->candidates = ToolCandidates(spec, SettingText(ws, spec->setting.View()).View(), VariablesFor(ws, spec), ToolsFolder(server), looked);
		job->looked = looked;
		job->cwd = Core::String(ws->root.View());
		job->pin = FindPin(ws->root, ProjectFolders(ws), spec->versionFrom);
		job->environment = EnvironmentFor(ws, Core::Array<Core::String>());
		return job;
	}

	void Tools::Detect(WorkspaceTools* entry) {
		if (entry->detecting) {
			entry->dirty = true;
			return;
		}
		entry->detecting = true;
		Publish(entry);
		Tools* self = this;
		Threading::Thread::Run([self, entry]() { self->DetectLoop(entry); }).Detach();
	}

	// The jobs read with the lock held, the programs asked without it, the statuses kept with it; again while something
	// changed in between.
	void Tools::DetectLoop(WorkspaceTools* entry) {
		for (;;) {
			Core::Array<DetectJob*> jobs;
			{
				Threading::LockGuard guard(server->lock);
				entry->dirty = false;
				entry->settings = ToolSettings(entry->ws);
				entry->pinFiles.Clear();
				if (entry->ws->trusted)
					for (ToolSpec* spec : ToolsOf(entry->ws)) {
						jobs.Push(JobFor(entry->ws, spec));
						for (const VersionSource* source : spec->versionFrom) entry->pinFiles.Push(Core::String(FS::Path(source->file.View()).FileName()));
					}
			}
			Core::Array<ToolStatus*> found;
			for (DetectJob* job : jobs) found.Push(DetectTool(*job));
			Threading::LockGuard guard(server->lock);
			bool arrived = false;
			for (const ToolStatus* status : found) {
				ToolStatus* before = StatusOf(entry, status->spec->id.View());
				arrived = arrived || (before && before->Lacking() && !status->Lacking());
			}
			entry->statuses = found;
			entry->detected = true;
			if (arrived) server->lsp->ToolsChanged(entry->ws);
			for (const ToolStatus* status : found)
				if (!status->Lacking()) entry->failures.Remove(status->spec->id);
			if (entry->dirty) continue;
			entry->detecting = false;
			Publish(entry);
			return;
		}
	}

	ToolStatus* Tools::StatusOf(WorkspaceTools* entry, Core::StringView id) {
		for (ToolStatus* status : entry->statuses)
			if (status->spec->id.View() == id) return status;
		return nullptr;
	}

	void Tools::Store(WorkspaceTools* entry, ToolStatus* status) {
		for (int64 i = 0; i < entry->statuses.Count(); ++i)
			if (entry->statuses[i]->spec->id == status->spec->id) {
				entry->statuses[i] = status;
				return;
			}
		entry->statuses.Push(status);
	}

	Core::String Tools::ProgramFor(Workspace* ws, Core::StringView id) {
		WorkspaceTools* entry = EntryOf(ws);
		ToolStatus* status = entry ? StatusOf(entry, id) : nullptr;
		if (status && !status->path.IsEmpty()) return status->path;
		for (ToolSpec* spec : AllToolsOf(ws)) {
			if (spec->id.View() != id) continue;
			Core::String looked;
			Core::String setting = SettingText(ws, spec->setting.View());
			Core::Array<ToolCandidate> candidates = ToolCandidates(spec, setting.View(), VariablesFor(ws, spec), ToolsFolder(server), looked);
			if (!candidates.IsEmpty()) return candidates[0].path;
			return setting.View().Trimmed().IsEmpty() ? spec->program : Core::String(setting.View().Trimmed());
		}
		return Core::String();
	}

	bool Tools::LacksProgram(Workspace* ws, Core::StringView command, Core::String& problem) {
		Core::StringView text = command.Trimmed();
		if (!text.StartsWith(Core::StringView("${tool:")) || !text.EndsWith(Core::StringView("}")) || text.IndexOf('}', 0) != text.ByteLength() - 1) return false;
		WorkspaceTools* entry = EntryOf(ws);
		ToolStatus* status = entry ? StatusOf(entry, text.Substring(7, text.ByteLength() - 8)) : nullptr;
		if (!status || (status->state != "missing" && status->state != "failed")) return false;
		Core::String failure;
		const bool failed = entry->failures.TryGet(status->spec->id, failure);
		Core::StringView why = failed ? failure.View() : status->problem.View();
		while (why.EndsWith(Core::StringView("."))) why = why.Substring(0, why.ByteLength() - 1);
		problem = (((status->spec->title + " is not installed: ") + why) + ". ") + (status->spec->CanInstall() ? "Settings > Languages installs it." : "Settings > Languages says how to get it.");
		return true;
	}

	Core::Array<Core::String> Tools::EnvironmentFor(Workspace* ws, const Core::Array<Core::String>& environment) {
		WorkspaceTools* entry = EntryOf(ws);
		if (!entry) return environment;
		Core::StringBuilder folders;
		Core::Array<Core::String> seen;
		for (const ToolStatus* status : entry->statuses) {
			if (!status->spec->onPath || status->path.IsEmpty() || status->source == "path" || status->source == "setting") continue;
			Core::String folder = Core::String(FS::Path(status->path.View()).Parent().View());
			bool known = false;
			for (const Core::String& each : seen) known = known || each == folder;
			if (known) continue;
			seen.Push(folder);
			if (folders.ByteLength() > 0) folders.Append(";");
			folders.Append(folder.View());
		}
		return WithPathFirst(environment, folders.View());
	}

	// --- The topic ---------------------------------------------------------------------------------------------------

	// The ids of the tools the workspace lacks, ','-separated: what a dismissed banner is compared against.
	Core::String Tools::Lacking(WorkspaceTools* entry) {
		Core::StringBuilder ids;
		for (const ToolStatus* status : entry->statuses)
			if (status->Lacking()) {
				if (ids.ByteLength() > 0) ids.Append(",");
				ids.Append(status->spec->id.View());
			}
		return ids.ToString();
	}

	static bool Queued(const WorkspaceTools* entry, Core::StringView id) {
		for (const Core::String& each : entry->queued)
			if (each.View() == id) return true;
		return false;
	}

	// {trusted, detected, detecting, install: {tools, current} | null, busy (an install runs for another workspace),
	// dismissed, tools: [status]} - each status as ToolStatus::Json, with state installing, queued or failed over it.
	Core::String Tools::Snapshot(WorkspaceTools* entry) {
		Core::Array<ToolStatus*> shown = entry->statuses;
		if (!entry->ws->trusted || !entry->detected) {
			shown.Clear();
			for (ToolSpec* spec : ToolsOf(entry->ws)) {
				ToolStatus* status = new ToolStatus();
				status->spec = spec;
				status->state = Core::String("unchecked");
				shown.Push(status);
			}
		}
		JsonWriter json;
		json.BeginObject();
		json.BoolField("trusted", entry->ws->trusted);
		json.BoolField("detected", entry->detected);
		json.BoolField("detecting", entry->detecting);
		json.Key(Core::StringView("install"));
		if (installing != entry) json.Null();
		else {
			json.BeginObject();
			json.Key(Core::StringView("tools"));
			json.BeginArray();
			for (const Core::String& id : entry->queued) json.String(id.View());
			json.EndArray();
			json.Field("current", entry->current.View());
			json.EndObject();
		}
		json.BoolField("busy", installing != nullptr && installing != entry);
		Core::String lacking = Lacking(entry);
		json.BoolField("dismissed", !lacking.IsEmpty() && lacking == entry->dismissed);
		json.Key(Core::StringView("tools"));
		json.BeginArray();
		for (ToolStatus* status : shown) {
			ToolStatus* each = status;
			Core::String failure;
			const bool failed = status->Lacking() && entry->failures.TryGet(status->spec->id, failure);
			const bool now = installing == entry && entry->current == status->spec->id;
			if (failed || now || (installing == entry && Queued(entry, status->spec->id.View()))) {
				each = status->Copy();
				each->state = Core::String(now ? "installing" : failed ? "failed" : "queued");
				if (failed && !now) each->problem = failure;
			}
			json.Raw(each->Json().View());
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String Tools::SnapshotJson(Workspace* ws) {
		WorkspaceTools* entry = EntryOf(ws);
		return entry ? Snapshot(entry) : Core::String();
	}

	void Tools::Publish(WorkspaceTools* entry) { server->hub.Publish(ToolsTopic(entry->ws).View(), "tools.changed", Snapshot(entry).View()); }

	// --- Installing --------------------------------------------------------------------------------------------------

	void Tools::Say(WorkspaceTools* entry, Core::StringView text) { server->outputs->Append(entry->ws, Core::StringView(kToolsOutputSource), text); }

	InstallPlan Tools::PlanFor(WorkspaceTools* entry, ToolSpec* spec) {
		InstallPlan plan;
		ToolStatus* status = StatusOf(entry, spec->id.View());
		PinnedVersion pin = status ? status->pin : FindPin(entry->ws->root, ProjectFolders(entry->ws), spec->versionFrom);
		plan.spec = spec;
		plan.version = ToolInstallVersion(spec, pin);
		plan.folder = ToolsFolder(server) / spec->id.View() / plan.version.View();
		plan.downloads = ToolsFolder(server) / ".downloads";
		plan.cwd = Core::String(entry->ws->root.View());
		plan.environment = EnvironmentFor(entry->ws, Core::Array<Core::String>());
		Tools* self = this;
		Server* host = server;
		Workspace* ws = entry->ws;
		Core::String version = plan.version;
		Core::String folder = Core::String(plan.folder.View());
		plan.expand = [self, host, ws, spec, version, folder](Core::StringView text) -> Core::String {
			Core::String own = ReplaceAll(ReplaceAll(text, Core::StringView("${version}"), version.View()).View(), Core::StringView("${installDir}"), folder.View());
			Threading::LockGuard guard(host->lock);
			return ExpandProfileVariables(own.View(), self->VariablesFor(ws, spec));
		};
		return plan;
	}

	void Tools::InstallLoop(WorkspaceTools* entry, Core::Array<ToolSpec*> order, InstallControl* control) {
		Tools* self = this;
		Server* host = server;
		InstallSay say = [self, host, entry](Core::StringView text) {
			Threading::LockGuard guard(host->lock);
			self->Say(entry, text);
		};
		Core::Array<Core::String> done;
		Core::String failure;
		for (ToolSpec* spec : order) {
			InstallPlan plan;
			{
				Threading::LockGuard guard(server->lock);
				entry->current = spec->id;
				Publish(entry);
				plan = PlanFor(entry, spec);
				Say(entry, ((((Core::String("\r\n== Installing ") + spec->title.View()) + " ") + plan.version.View()) + " into " + plan.folder.View() + "\r\n").View());
			}
			Core::String problem;
			bool installed = false;
			if (!IsFolderSafeVersion(plan.version.View())) problem = (Core::String("the version to install, '") + plan.version.View()) + "', cannot name a folder";
			else installed = RunInstall(plan, control, say, problem);
			DetectJob* job = nullptr;
			{
				Threading::LockGuard guard(server->lock);
				job = JobFor(entry->ws, spec);
			}
			ToolStatus* status = DetectTool(*job);
			Threading::LockGuard guard(server->lock);
			Store(entry, status);
			if (installed && status->state != "found") {
				installed = false;
				problem = Core::String("it was installed, but it is still not found: ") + status->problem.View();
			}
			if (!installed) {
				entry->failures.At(spec->id) = problem;
				failure = ((spec->title + " was not installed: ") + problem.View());
				Say(entry, ((Core::String("\x1b[31m") + failure.View()) + "\x1b[0m\r\n").View());
				break;
			}
			entry->failures.Remove(spec->id);
			done.Push((spec->title + " ") + (status->version.IsEmpty() ? plan.version : status->version).View());
			Say(entry, ((Core::String("\x1b[32mInstalled ") + done[done.Count() - 1].View()) + ": " + status->path.View() + "\x1b[0m\r\n").View());
		}
		Threading::LockGuard guard(server->lock);
		entry->current = Core::String();
		entry->queued.Clear();
		installing = nullptr;
		this.control = nullptr;
		Publish(entry);
		for (WorkspaceTools* other : entries)
			if (other != entry) Publish(other);
		if (!done.IsEmpty()) server->presence->Add(Core::StringView("info"), (Core::String("Installed ") + Core::Join(done, ", ").View()).View());
		if (!failure.IsEmpty()) server->presence->Add(Core::StringView("error"), failure.View());
		server->lsp->ToolsChanged(entry->ws);
		for (WorkspaceTools* other : entries)
			if (other != entry) Detect(other);
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	Core::String Tools::StatusMethod(Call& call, const Params& params) { return Snapshot(EntryParam(params)); }

	Core::String Tools::DetectMethod(Call& call, const Params& params) {
		WorkspaceTools* entry = EntryParam(params);
		if (!entry->ws->trusted) throw RpcError(ErrorCode::Forbidden, "the workspace is not trusted: no program is run to find its tools");
		Detect(entry);
		return Core::String("{}");
	}

	static ToolSpec* SpecNamed(const Core::Array<ToolSpec*>& specs, Core::StringView id) {
		for (ToolSpec* spec : specs)
			if (spec->id.View() == id) return spec;
		return nullptr;
	}

	static bool Has(const Core::Array<ToolSpec*>& specs, const ToolSpec* spec) {
		for (const ToolSpec* each : specs)
			if (each == spec) return true;
		return false;
	}

	Core::String Tools::InstallMethod(Call& call, const Params& params) {
		WorkspaceTools* entry = EntryParam(params);
		if (!entry->ws->trusted) throw RpcError(ErrorCode::Forbidden, "the workspace is not trusted: nothing is installed for it");
		if (installing) throw RpcError(ErrorCode::Conflict, (Core::String("an install of language tools runs already, for ") + installing->ws->name.View()).View());
		Core::Array<ToolSpec*> specs = ToolsOf(entry->ws);
		Core::Array<ToolSpec*> targets;
		Serialization::DomNode named = params.List("tools");
		for (int64 i = 0; named.Kind() == Serialization::DomKind::Array && i < named.Count(); ++i) {
			ToolSpec* spec = SpecNamed(specs, named.At(i).AsView());
			if (!spec) throw RpcError(ErrorCode::NotFound, (Core::String("the workspace needs no tool ") + named.At(i).AsView()).View());
			if (!spec->CanInstall()) throw RpcError(ErrorCode::BadRequest, ((spec->title + " cannot be installed by IED") + (spec->homepage.IsEmpty() ? Core::String() : Core::String(": see ") + spec->homepage.View()).View()).View());
			if (!Has(targets, spec)) targets.Push(spec);
		}
		if (named.Kind() != Serialization::DomKind::Array || named.Count() == 0)
			for (ToolSpec* spec : specs) {
				ToolStatus* status = StatusOf(entry, spec->id.View());
				if (status && status->Lacking() && spec->CanInstall()) targets.Push(spec);
			}
		for (int64 i = 0; i < targets.Count(); ++i)
			for (const Core::String& required : targets[i]->requires) {
				ToolSpec* spec = SpecNamed(specs, required.View());
				ToolStatus* status = spec ? StatusOf(entry, required.View()) : nullptr;
				if (!spec || Has(targets, spec) || (status && status->state == "found")) continue;
				if (!spec->CanInstall()) throw RpcError(ErrorCode::BadRequest, (((targets[i]->title + " needs ") + spec->title.View()) + ", which IED cannot install").View());
				targets.Push(spec);
			}
		if (targets.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "nothing to install: no tool the workspace lacks has an install");
		Core::Array<ToolSpec*> order = InstallOrder(targets);
		JsonWriter refused;
		refused.BeginObject();
		refused.Field("reason", "userScope");
		refused.Key(Core::StringView("tools"));
		refused.BeginArray();
		bool forUser = false;
		for (const ToolSpec* spec : order)
			if (spec->InstallsForUser()) {
				refused.String(spec->id.View());
				forUser = true;
			}
		refused.EndArray();
		refused.EndObject();
		if (forUser && !params.Bool("allowUserScope", false))
			throw RpcError(ErrorCode::Forbidden, "an install writes outside IED's tools folder, for your user: ask, then pass allowUserScope", refused.View());
		installing = entry;
		control = new InstallControl();
		entry->queued.Clear();
		for (const ToolSpec* spec : order) {
			entry->queued.Push(spec->id);
			entry->failures.Remove(spec->id);
		}
		Publish(entry);
		for (WorkspaceTools* other : entries)
			if (other != entry) Publish(other);
		Tools* self = this;
		InstallControl* running = control;
		Threading::Thread::Run([self, entry, order, running]() { self->InstallLoop(entry, order, running); }).Detach();
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("tools"));
		json.BeginArray();
		for (const ToolSpec* spec : order) json.String(spec->id.View());
		json.EndArray();
		json.Field("output", kToolsOutputSource);
		json.EndObject();
		return json.ToString();
	}

	Core::String Tools::CancelMethod(Call& call, const Params& params) {
		WorkspaceTools* entry = EntryParam(params);
		if (installing != entry || !control) throw RpcError(ErrorCode::NotFound, "no install runs for this workspace");
		control->Cancel();
		return Core::String("{}");
	}

	Core::String Tools::DismissMethod(Call& call, const Params& params) {
		WorkspaceTools* entry = EntryParam(params);
		entry->dismissed = Lacking(entry);
		Publish(entry);
		return Core::String("{}");
	}
}
