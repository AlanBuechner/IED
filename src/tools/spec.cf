include "spec.ch"

namespace Ied
{
	static Core::Array<Core::String> StringsOf(const Serialization::DomNode& list) {
		Core::Array<Core::String> strings;
		for (int64 i = 0; list.Kind() == Serialization::DomKind::Array && i < list.Count(); ++i) strings.Push(Core::String(list.At(i).AsView()));
		return strings;
	}

	static Core::Array<Core::String> EnvironmentOf(const Serialization::DomNode& env) {
		Core::Array<Core::String> entries;
		for (int64 i = 0; env.Kind() == Serialization::DomKind::Object && i < env.Count(); ++i) entries.Push((Core::String(env.KeyAt(i)) + "=") + env.ValueAt(i).AsView());
		return entries;
	}

	static InstallStep* ReadStep(const Serialization::DomNode& node) {
		InstallStep* step = new InstallStep();
		step->label = Core::String(node.Member("label").AsView());
		step->download = Core::String(node.Member("download").AsView());
		step->sha256 = node.Member("sha256").AsView().ToLower();
		step->sha256Url = Core::String(node.Member("sha256Url").AsView());
		step->extract = node.Member("extract").AsView().IsEmpty() ? Core::String("zip") : Core::String(node.Member("extract").AsView());
		step->strip = node.Member("strip").AsInt();
		step->fileName = Core::String(node.Member("fileName").AsView());
		step->run = StringsOf(node.Member("run"));
		step->environment = EnvironmentOf(node.Member("env"));
		step->cwd = Core::String(node.Member("cwd").AsView());
		step->userScope = node.Member("scope").AsView() == "user";
		if (step->label.IsEmpty()) step->label = step->download.IsEmpty() ? (step->run.IsEmpty() ? Core::String("step") : step->run[0]) : Core::String("Download");
		return step;
	}

	bool ToolSpec::InstallsForUser() const {
		for (const InstallStep* step : steps)
			if (step->userScope) return true;
		return false;
	}

	ToolSpec* ReadToolSpec(const Serialization::DomNode& node, Core::StringView pluginId, Core::StringView pluginName, const FS::Path& pluginDir) {
		ToolSpec* spec = new ToolSpec();
		spec->id = Core::String(node.Member("id").AsView());
		spec->title = node.Member("title").AsView().IsEmpty() ? spec->id : Core::String(node.Member("title").AsView());
		spec->kind = node.Member("kind").AsView().IsEmpty() ? Core::String("other") : Core::String(node.Member("kind").AsView());
		spec->pluginId = Core::String(pluginId);
		spec->pluginName = Core::String(pluginName);
		spec->pluginDir = pluginDir;
		spec->when = Core::String(node.Member("when").AsView());
		spec->program = Core::String(node.Member("program").AsView());
		spec->setting = Core::String(node.Member("setting").AsView());
		spec->bundled = StringsOf(node.Member("bundled"));
		spec->searchPaths = StringsOf(node.Member("searchPaths"));
		Serialization::DomNode detect = node.Member("detect");
		spec->versionArgs = StringsOf(detect.Member("args"));
		spec->versionPattern = Core::String(detect.Member("pattern").AsView());
		spec->versionEnvironment = EnvironmentOf(detect.Member("env"));
		Serialization::DomNode from = node.Member("versionFrom");
		for (int64 i = 0; from.Kind() == Serialization::DomKind::Array && i < from.Count(); ++i) {
			VersionSource* source = new VersionSource();
			source->file = Core::String(from.At(i).Member("file").AsView());
			source->regexp = Core::String(from.At(i).Member("regexp").AsView());
			source->minimum = from.At(i).Member("match").AsView() == "minimum";
			spec->versionFrom.Push(source);
		}
		spec->requires = StringsOf(node.Member("requires"));
		Serialization::DomNode install = node.Member("install");
		spec->installVersion = Core::String(install.Member("version").AsView());
		spec->installBin = Core::String(install.Member("bin").AsView());
		Serialization::DomNode steps = install.Member(kToolSystem);
		for (int64 i = 0; steps.Kind() == Serialization::DomKind::Array && i < steps.Count(); ++i) spec->steps.Push(ReadStep(steps.At(i)));
		spec->homepage = Core::String(node.Member("homepage").AsView());
		spec->onPath = node.Member("onPath").AsBool();
		return spec;
	}

	Core::Array<ToolSpec*> LastOfEachId(const Core::Array<ToolSpec*>& tools) {
		Core::Array<ToolSpec*> kept;
		for (int64 i = 0; i < tools.Count(); ++i) {
			bool replaced = false;
			for (int64 j = i + 1; j < tools.Count() && !replaced; ++j) replaced = tools[j]->id == tools[i]->id;
			if (!replaced) kept.Push(tools[i]);
		}
		return kept;
	}

	static bool Listed(const Core::Array<ToolSpec*>& tools, Core::StringView id) {
		for (const ToolSpec* tool : tools)
			if (tool->id.View() == id) return true;
		return false;
	}

	static ToolSpec* Named(const Core::Array<ToolSpec*>& tools, Core::StringView id) {
		for (ToolSpec* tool : tools)
			if (tool->id.View() == id) return tool;
		return nullptr;
	}

	// `tool` after what it requires; `visiting` breaks a cycle (a tool that requires itself, at any depth, goes once).
	static void Place(ToolSpec* tool, const Core::Array<ToolSpec*>& tools, Core::Array<ToolSpec*>& order, Core::Array<ToolSpec*>& visiting) {
		if (Listed(order, tool->id.View()) || Listed(visiting, tool->id.View())) return;
		visiting.Push(tool);
		for (const Core::String& required : tool->requires) {
			ToolSpec* first = Named(tools, required.View());
			if (first) Place(first, tools, order, visiting);
		}
		order.Push(tool);
	}

	Core::Array<ToolSpec*> InstallOrder(const Core::Array<ToolSpec*>& tools) {
		Core::Array<ToolSpec*> order;
		Core::Array<ToolSpec*> visiting;
		for (ToolSpec* tool : tools) Place(tool, tools, order, visiting);
		return order;
	}
}
