// plugins/codediagnostics (docs/26 section 2): the problems of a compiler's diagnostics text - errors and warnings with
// their place, the source lines and carets skipped, lines of any other shape ignored. plugins/codecalls: an event
// reaches each listener of a plugin even when one throws, a built-in's included (it has no script).

include "plugins/CodeDiagnostics.ch"
include "plugins/CodeCalls.ch"

[test("server.code")]
class CodeTests {
	[test("diagnostics_read")]
	public static void TestDiagnosticsRead() {
		Core::StringView text = Core::StringView("its code did not compile:\ntools.cf (10:15) error: no variable named projects_here\n  \t\tcontext.Log(projects_here);\n  \t\t            ^\n\nsub/util.cf (2:1) warning: an unused name: x\n");
		Core::Array<Ied::CodeProblem> problems = Ied::ReadCodeProblems(text);
		assert_true(problems.Count() == 2, "an error and a warning");
		assert_true(problems[0].m_File.View() == "tools.cf" && problems[0].m_Line == 10 && problems[0].m_Column == 15 && problems[0].m_Severity == 1, "the error's place");
		assert_true(problems[0].m_Message.View() == "no variable named projects_here", "the error's message");
		assert_true(problems[1].m_File.View() == "sub/util.cf" && problems[1].m_Severity == 2 && problems[1].m_Message.View() == "an unused name: x", "the warning");
	}

	[test("diagnostics_other_lines")]
	public static void TestDiagnosticsOtherLines() {
		assert_true(Ied::ReadCodeProblems(Core::StringView("a (b) error: c\nx.cf (3) error: no column\ny.cf (1:2) remark: unknown\n")).IsEmpty(), "not the compiler's shape");
		assert_true(Ied::ReadCodeProblems(Core::StringView("")).IsEmpty(), "nothing to read");
	}

	[test("event_listener_that_throws")]
	public static void TestEventListenerThatThrows() {
		Ied::CodeInstance* instance = new Ied::CodeInstance();
		instance->m_Builtin = true;
		instance->m_State = Ied::CodeState::Active;
		bool* heard = new bool();
		instance->m_Handlers.m_ListenKinds.Push(Core::String("tree.changed"));
		instance->m_Handlers.m_Listeners.Push([](const IED::Event& event) { throw Ied::RpcError(Ied::ErrorCode::Internal, Core::StringView("a listener that throws")); });
		instance->m_Handlers.m_ListenKinds.Push(Core::String("tree.changed"));
		instance->m_Handlers.m_Listeners.Push([heard](const IED::Event& event) { *heard = true; });
		Ied::DeliverEvent(instance, Core::StringView("ws:w1"), Core::StringView("tree.changed"), Core::StringView("{}"));
		assert_true(*heard, "a built-in's next listener still hears the event");
		assert_true(instance->m_State == Ied::CodeState::Active, "a throw is not a fault");
	}
}
