// lsp/: message framing, positions between UTF-16 and UTF-8, URIs, and the pool's message helpers.

include "lsp/Framing.ch"
include "lsp/Positions.ch"
include "lsp/Uris.ch"
include "lsp/Profiles.ch"
include "lsp/Rewrite.ch"
include "lsp/Pool.ch"

static int64 Col(const char* line, int64 col, Ied::PositionEncoding from, Ied::PositionEncoding to) { return Ied::ConvertColumn(Core::StringView(line), col, from, to); }

// "a.c" holds an e-acute (two bytes, one unit) then " = 1;", and a second line "ok"; "b.c" is ASCII. Server URIs are
// file:///x/..., client URIs ied://w1/....
static Ied::LineIndex* s_GA = new Ied::LineIndex(Core::StringView("\xc3\xa9 = 1;\nok"));

static Ied::Rewrite ToClient() {
	Ied::Rewrite rewrite;
	rewrite.m_From = Ied::PositionEncoding::Utf8;
	rewrite.m_To = Ied::PositionEncoding::Utf16;
	rewrite.m_Lines = [](Core::StringView uri) -> const Ied::LineIndex* { return uri == "file:///x/a.c" ? s_GA : nullptr; };
	rewrite.m_MapUri = [](Core::StringView uri) -> Core::String { return uri.StartsWith(Core::StringView("file:///x/")) ? Core::String("ied://w1/") + uri.Substring(10, uri.ByteLength() - 10) : Core::String(uri); };
	rewrite.m_Uri = Core::String("file:///x/a.c");
	return rewrite;
}

static Core::String Rewritten(const char* json, const Ied::Rewrite& rewrite) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Ied::RewriteJson(Serialization::ReadJson(Core::StringView(json), *doc).root, rewrite);
}

[test("server.lsp")]
class LspTests {
	[test("framing")]
	public static void TestFraming() {
		Ied::FrameReader reader;
		Core::String body;
		Core::String framed = Ied::FrameMessage(Core::StringView("{\"id\":1}"));
		assert_se("Content-Length: 8\r\n\r\n{\"id\":1}", framed.CStr(), "a framed message");
		reader.Feed(framed.View().Substring(0, 10));
		assert_true(!reader.Next(body), "not yet: half a header");
		reader.Feed(framed.View().Substring(10, framed.ByteLength() - 12));
		assert_true(!reader.Next(body), "not yet: two bytes short");
		reader.Feed(framed.View().Substring(framed.ByteLength() - 2, 2));
		reader.Feed(Core::StringView("content-length: 2\r\nContent-Type: application/vscode-jsonrpc\r\n\r\n{}Content-Length: 0\r\n\r\n"));
		assert_true(reader.Next(body) && body == "{\"id\":1}", "the first message whole");
		assert_true(reader.Next(body) && body == "{}", "header names fold case; other headers are passed over");
		assert_true(reader.Next(body) && body.IsEmpty(), "an empty body");
		assert_true(!reader.Next(body) && !reader.Failed(), "nothing more");
	}

	[test("framing_refused")]
	public static void TestFramingRefused() {
		Ied::FrameReader reader;
		Core::String body;
		reader.Feed(Core::StringView("Content-Type: x\r\n\r\n{}"));
		assert_true(!reader.Next(body) && reader.Failed(), "no Content-Length");
		reader.Feed(Core::StringView("Content-Length: 2\r\n\r\n{}"));
		assert_true(!reader.Next(body), "nothing after a failure");
		assert_eq(-1, Ied::ContentLengthOf(Core::StringView("Content-Length: -3")), "negative");
		assert_eq(-1, Ied::ContentLengthOf(Core::StringView("Content-Length: x")), "not a number");
		assert_eq(-1, Ied::ContentLengthOf(Core::StringView("Content-Length: 99999999999")), "too large");
		assert_eq(12, Ied::ContentLengthOf(Core::StringView("X: 1\r\nContent-Length:  12 ")), "spaces around the number");
	}

	[test("positions")]
	public static void TestPositions() {
		const Ied::PositionEncoding u16 = Ied::PositionEncoding::Utf16;
		const Ied::PositionEncoding u8 = Ied::PositionEncoding::Utf8;
		assert_eq(3, Col("abcdef", 3, u16, u8), "ASCII is the same");
		assert_eq(3, Col("a\xc3\xa9" "b", 2, u16, u8), "an e-acute is two bytes and one unit");
		assert_eq(2, Col("a\xc3\xa9" "b", 3, u8, u16), "back");
		assert_eq(5, Col("a\xf0\x9f\x8e\xae" "b", 3, u16, u8), "an emoji is four bytes and two units");
		assert_eq(3, Col("a\xf0\x9f\x8e\xae" "b", 5, u8, u16), "back");
		assert_eq(5, Col("a\xf0\x9f\x8e\xae" "b", 2, u16, u8), "half a surrogate pair moves to the character's end");
		assert_eq(3, Col("a\xf0\x9f\x8e\xae" "b", 3, u8, u16), "a byte inside a sequence too");
		assert_eq(6, Col("a\xc3\xa9", 5, u16, u8), "past the end stays past it by as much (2 units, 3 bytes, then 3 more)");
		assert_eq(5, Col("a\xf0\x9f\x8e\xae", 2, u16, u8), "inside the last character: its end");
		assert_eq(0, Col("", 0, u16, u8), "an empty line");
		Ied::PositionEncoding parsed = u16;
		assert_true(Ied::ParsePositionEncoding(Core::StringView("bytes"), parsed) && parsed == u8, "bytes is UTF-8");
		assert_true(!Ied::ParsePositionEncoding(Core::StringView("utf-32"), parsed), "utf-32 is not offered");
	}

	[test("line_index")]
	public static void TestLineIndex() {
		Ied::LineIndex lines = Ied::LineIndex(Core::StringView("one\r\ntwo\n\nlast"));
		assert_eq(4, lines.Count(), "four lines");
		assert_true(lines.Line(0) == "one\r", "a \\r stays part of its line");
		assert_true(lines.Line(2).IsEmpty() && lines.Line(3) == "last" && lines.Line(9).IsEmpty(), "empty, last, past the end");
	}

	[test("uris")]
	public static void TestUris() {
		assert_se("file:///C:/Work/My%20Game/a.c", Ied::FileUriOf(Core::StringView("C:\\Work\\My Game\\a.c")).CStr(), "a Windows path");
		assert_se("file:///home/x/%C3%A9.c", Ied::FileUriOf(Core::StringView("/home/x/\xc3\xa9.c")).CStr(), "UTF-8 byte by byte");
		assert_se("file:///C:/a%23b%25.c", Ied::FileUriOf(Core::StringView("C:/a#b%.c")).CStr(), "reserved characters");
		Core::String path;
		assert_true(Ied::PathOfFileUri(Core::StringView("file:///C:/Work/My%20Game/a.c"), path) && path == "C:\\Work\\My Game\\a.c", "back");
		assert_true(Ied::PathOfFileUri(Core::StringView("file:///c%3A/x.c"), path) && path == "c:\\x.c", "an encoded drive colon");
		assert_true(Ied::PathOfFileUri(Core::StringView("file:///home/x/%C3%A9.c"), path) && path == "/home/x/\xc3\xa9.c", "a POSIX path");
		assert_true(!Ied::PathOfFileUri(Core::StringView("http://x/a.c"), path) && !Ied::PathOfFileUri(Core::StringView("file:///a%2"), path), "another scheme, a bad escape");
		assert_se("ied://w1/src/my%20main.c", Ied::IedUriOf(Core::StringView("w1"), Core::StringView("src/my main.c")).CStr(), "an ied URI");
		assert_se("file:///C:/My%20Lib/a.h", Ied::CanonicalFileUri(Core::StringView("file:///c%3A/My Lib/a.h")).CStr(), "the canonical form of a file URI");
		assert_se("file:///home/x/a.h", Ied::CanonicalFileUri(Core::StringView("file:///home/x/a.h")).CStr(), "a POSIX one as it is");
		assert_true(Ied::CanonicalFileUri(Core::StringView("http://x/a.h")).IsEmpty(), "not a file URI");
		Core::String wsId;
		Core::String relative;
		assert_true(Ied::ParseIedUri(Core::StringView("ied://w1/src/my%20main.c"), wsId, relative) && wsId == "w1" && relative == "src/my main.c", "parsed");
		assert_true(!Ied::ParseIedUri(Core::StringView("ied:///x"), wsId, relative) && !Ied::ParseIedUri(Core::StringView("file:///x"), wsId, relative), "no workspace, another scheme");
	}

	[test("profiles")]
	public static void TestProfiles() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode contributes = Serialization::ReadJsonc(Core::StringView(
			"{\"lspProfiles\": ["
			"{\"id\": \"clangd\", \"command\": \"clangd\", \"selector\": {\"languages\": [\"c\", \"cpp\"]}},"
			"{\"id\": \"c4\", \"command\": \"${pluginDir}/../tools/C4LSP/C4LSP.exe\", \"args\": [\"--root\", \"${solutionDir}\"],"
			" \"env\": {\"C4_HOME\": \"${pluginDir}\"}, \"selector\": {\"extensions\": [\".cf\", \".ch\"], \"globs\": [\"**/*.c4x\"]},"
			" \"launchMode\": \"staged\", \"scope\": \"project\", \"positionEncoding\": \"bytes\", \"requestIds\": \"integer\","
			" \"refetchOnDiagnostics\": [\"semanticTokens\"], \"codeActionsNeedClientFilter\": true, \"when\": \"workspaceTrusted\","
			" \"initializationOptions\": {\"tidy\": true}, \"initializationOptionsFiles\": {\"files\": \"${workspaceDir}/opts/*.json\", \"key\": \"programs\"}}"
			"]}"), *doc).root;
		Core::Array<Ied::LspProfile*> profiles;
		Ied::ReadLspProfiles(contributes, Core::StringView("c4"), FS::Path("C:/tc/ied"), profiles);
		assert_eq(2, profiles.Count(), "two profiles");
		Ied::LspProfile* c4 = profiles[1];
		assert_true(c4->m_Staged && c4->m_PerProject && !c4->m_Negotiate && c4->m_Encoding == Ied::PositionEncoding::Utf8 && c4->m_IntegerIds && c4->m_FilterCodeActions, "the quirks");
		assert_true(profiles[0]->m_Negotiate && !profiles[0]->m_Staged && !profiles[0]->m_PerProject && profiles[0]->m_InitializationOptions == "{}", "the defaults");
		assert_se("{\"tidy\":true}", c4->m_InitializationOptions.CStr(), "initialization options as JSON");
		assert_se("C4_HOME=${pluginDir}", c4->m_Environment[0].CStr(), "the environment");
		assert_se("${workspaceDir}/opts/*.json", c4->m_OptionsFiles.CStr(), "the options files");
		assert_se("programs", c4->m_OptionsFilesKey.CStr(), "their key");
		assert_true(profiles[0]->m_OptionsFiles.IsEmpty() && profiles[0]->m_OptionsFilesKey.IsEmpty(), "none by default");
		assert_true(Ied::ProfileServing(profiles, Core::StringView("c4"), Core::StringView("src/a.CF")) == c4, "by extension, any case");
		assert_true(Ied::ProfileServing(profiles, Core::StringView("plaintext"), Core::StringView("x/y/z.c4x")) == c4, "by glob");
		assert_true(Ied::ProfileServing(profiles, Core::StringView("cpp"), Core::StringView("a.hpp")) == profiles[0], "by language");
		assert_true(Ied::ProfileServing(profiles, Core::StringView("python"), Core::StringView("a.py")) == nullptr, "none");
		Ied::ProfileVariables variables;
		variables.m_PluginDir = Core::String("C:/tc/ied");
		variables.m_SolutionDir = Core::String("D:/game");
		assert_se("C:/tc/ied/../tools/C4LSP/C4LSP.exe", Ied::ExpandProfileVariables(c4->m_Command.View(), variables).CStr(), "pluginDir");
		assert_se("D:/game", Ied::ExpandProfileVariables(c4->m_Args[1].View(), variables).CStr(), "solutionDir");
		assert_se("a ${setting:x} b${", Ied::ExpandProfileVariables(Core::StringView("a ${setting:x} b${"), variables).CStr(), "others are left");
		assert_se("/lsp-options/.json", Ied::ExpandProfileVariables(Core::StringView("${projectDir}/lsp-options/${projectName}.json"), variables).CStr(), "no project: empty");
		variables.m_ProjectName = Core::String("Game");
		variables.m_ProjectDir = Core::String("D:/game/src");
		assert_se("D:/game/src/lsp-options/Game.json", Ied::ExpandProfileVariables(Core::StringView("${projectDir}/lsp-options/${projectName}.json"), variables).CStr(), "a project");
		assert_se("x", Ied::ExpandProfileVariables(Core::StringView("x${config:cpp.path}"), variables).CStr(), "no settings: nothing");
		variables.m_Config = [](Core::StringView key) -> Core::String {
			if (key == "cpp.path") return Core::String("\"C:/LLVM/bin/clangd.exe\"");
			if (key == "cpp.jobs") return Core::String("4");
			if (key == "cpp.args") return Core::String("[\"--log=error\", \"--pch-storage=memory\"]");
			return Core::String();
		};
		assert_se("C:/LLVM/bin/clangd.exe", Ied::ExpandProfileVariables(Core::StringView("${config:cpp.path}"), variables).CStr(), "a string setting");
		assert_se("-j=4", Ied::ExpandProfileVariables(Core::StringView("-j=${config:cpp.jobs}"), variables).CStr(), "a number as written");
		assert_se("-x=", Ied::ExpandProfileVariables(Core::StringView("-x=${config:cpp.unset}${config:cpp.args}"), variables).CStr(), "unset, or a list inside text: nothing");
		Core::Array<Core::String> args;
		Ied::ExpandProfileArgument(Core::StringView("${config:cpp.args}"), variables, args);
		Ied::ExpandProfileArgument(Core::StringView("--x=${config:cpp.jobs}"), variables, args);
		assert_eq(3, args.Count(), "a list argument spreads");
		assert_se("--pch-storage=memory", args[1].CStr(), "in order");
		assert_se("--x=4", args[2].CStr(), "another argument as one");
	}

	[test("rewrite")]
	public static void TestRewrite() {
		Ied::Rewrite toClient = ToClient();
		assert_se("{\"line\":0,\"character\":1}", Rewritten("{\"line\":0,\"character\":2}", toClient).CStr(), "a position of the message's document");
		assert_se("{\"uri\":\"ied://w1/a.c\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}}",
			Rewritten("{\"uri\":\"file:///x/a.c\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":2}}}", toClient).CStr(), "a Location");
		assert_se("[{\"uri\":\"ied://w1/b.c\",\"range\":{\"start\":{\"line\":0,\"character\":2}}}]",
			Rewritten("[{\"uri\":\"file:///x/b.c\",\"range\":{\"start\":{\"line\":0,\"character\":2}}}]", toClient).CStr(), "another document: its own lines (unknown here, so unchanged)");
		assert_se("{\"originSelectionRange\":{\"start\":{\"line\":0,\"character\":1}},\"targetUri\":\"ied://w1/b.c\",\"targetRange\":{\"start\":{\"line\":0,\"character\":2}}}",
			Rewritten("{\"originSelectionRange\":{\"start\":{\"line\":0,\"character\":2}},\"targetUri\":\"file:///x/b.c\",\"targetRange\":{\"start\":{\"line\":0,\"character\":2}}}", toClient).CStr(),
			"a LocationLink: the origin range is the message's document");
		assert_se("{\"changes\":{\"ied://w1/a.c\":[{\"range\":{\"start\":{\"line\":0,\"character\":1}},\"newText\":\"x\"}]}}",
			Rewritten("{\"changes\":{\"file:///x/a.c\":[{\"range\":{\"start\":{\"line\":0,\"character\":2}},\"newText\":\"x\"}]}}", toClient).CStr(), "a WorkspaceEdit's changes");
		assert_se("{\"label\":\"x\",\"data\":{\"line\":0,\"character\":2}}", Rewritten("{\"label\":\"x\",\"data\":{\"line\":0,\"character\":2}}", toClient).CStr(), "opaque data is left");
		assert_se("{\"startLine\":0,\"startCharacter\":1,\"endLine\":1,\"endCharacter\":2}",
			Rewritten("{\"startLine\":0,\"startCharacter\":2,\"endLine\":1,\"endCharacter\":2}", toClient).CStr(), "a folding range");
		Ied::Rewrite toServer = toClient;
		toServer.m_From = Ied::PositionEncoding::Utf16;
		toServer.m_To = Ied::PositionEncoding::Utf8;
		assert_se("{\"position\":{\"line\":0,\"character\":4}}", Rewritten("{\"position\":{\"line\":0,\"character\":3}}", toServer).CStr(), "and back");
	}

	[test("semantic_tokens")]
	public static void TestSemanticTokens() {
		Core::Array<int64> data;
		int64[15] raw = { 0, 0, 2, 1, 0, 0, 3, 1, 2, 0, 1, 0, 2, 3, 0 };
		for (int64 n : raw) data.Push(n);
		Core::Array<int64> converted = Ied::RewriteSemanticTokens(data, *s_GA, Ied::PositionEncoding::Utf8, Ied::PositionEncoding::Utf16);
		Core::Array<int64> expected;
		int64[15] want = { 0, 0, 1, 1, 0, 0, 2, 1, 2, 0, 1, 0, 2, 3, 0 };
		for (int64 n : want) expected.Push(n);
		assert_eq(expected.Count(), converted.Count(), "as many numbers");
		bool same = true;
		for (int64 i = 0; i < expected.Count(); ++i) same = same && expected[i] == converted[i];
		assert_true(same, "the e-acute token is one unit long, the next starts a unit earlier; the next line's are unchanged");
	}

	[test("text_document")]
	public static void TestTextDocument() {
		assert_se("{\"position\":{\"line\":1,\"character\":2},\"textDocument\":{\"uri\":\"ied://w1/a.c\"}}",
			Ied::WithTextDocument(Core::StringView("{\"position\":{\"line\":1,\"character\":2}}"), Core::StringView("ied://w1/a.c")).CStr(), "added after the params");
		assert_se("{\"textDocument\":{\"uri\":\"ied://w1/a.c\"}}",
			Ied::WithTextDocument(Core::StringView("{\"textDocument\":{\"uri\":\"elsewhere\",\"version\":3}}"), Core::StringView("ied://w1/a.c")).CStr(), "one the client sent is replaced");
		assert_se("{\"textDocument\":{\"uri\":\"ied://w1/a.c\"}}", Ied::WithTextDocument(Core::StringView("null"), Core::StringView("ied://w1/a.c")).CStr(), "no params");
	}

	[test("code_action_filter")]
	public static void TestCodeActionFilter() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode actions = Serialization::ReadJson(Core::StringView(
			"[{\"title\":\"on line 1\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":4}}}]},"
			"{\"title\":\"on line 5\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":5,\"character\":0},\"end\":{\"line\":5,\"character\":4}}}]},"
			"{\"title\":\"refactor\"}]"), *doc).root;
		Serialization::DomNode cursor = Serialization::ReadJson(Core::StringView("{\"start\":{\"line\":1,\"character\":4},\"end\":{\"line\":1,\"character\":4}}"), *doc).root;
		Core::String kept = Ied::FilterCodeActions(actions, cursor);
		assert_true(kept.View().Contains(Core::StringView("on line 1")), "a diagnostic the cursor touches at its end");
		assert_true(!kept.View().Contains(Core::StringView("on line 5")), "a diagnostic elsewhere");
		assert_true(kept.View().Contains(Core::StringView("refactor")), "an action without diagnostics");
		Serialization::DomNode none = Serialization::ReadJson(Core::StringView("null"), *doc).root;
		assert_se("null", Ied::FilterCodeActions(none, cursor).CStr(), "no actions");
	}

	[test("transient_eviction")]
	public static void TestTransientEviction() {
		Ied::LanguageServer* language = new Ied::LanguageServer();
		const char*[3] paths = { "a.cf", "b.cf", "c.cf" };
		for (const char* path : paths) {
			Ied::TransientFile* file = new Ied::TransientFile();
			file->m_Path = Core::String(path);
			language->m_Transient.Push(file);
			language->m_Documents.Insert(file->m_Path, true);
		}
		language->m_Published.Insert(Core::String("a.cf"), true);
		language->m_Published.Insert(Core::String("c.cf"), true);

		Core::Array<Ied::EvictedFile> evicted = Ied::EvictTransients(language, 1);
		assert_eq(2, evicted.Count(), "the two oldest go");
		assert_true(evicted[0].m_Path == "a.cf" && evicted[0].m_HadDiagnostics, "the oldest, whose diagnostics are withdrawn");
		assert_true(evicted[1].m_Path == "b.cf" && !evicted[1].m_HadDiagnostics, "one the server said nothing of");
		assert_true(!language->m_Documents.Contains(Core::String("a.cf")) && !language->m_Documents.Contains(Core::String("b.cf")), "no longer open on the server");
		assert_true(!language->m_Published.Contains(Core::String("a.cf")), "nor counted as published");
		assert_true(language->m_Transient.Count() == 1 && language->m_Published.Contains(Core::String("c.cf")), "the newest stays with its diagnostics");
		assert_eq(0, Ied::EvictTransients(language, 1).Count(), "none past the limit: none go");
	}

	[test("server_errors")]
	public static void TestServerErrors() {
		Ied::RpcError modified = Ied::LspServerError(Core::StringView("{\"code\":-32801,\"message\":\"Request cancelled because the document was modified\"}"));
		assert_true(modified.m_Code == Ied::ErrorCode::Cancelled, "the document changed under the request: no answer, not a failure");
		assert_se("Request cancelled because the document was modified", modified.m_Message.CStr(), "the server's words kept");
		assert_true(Ied::LspServerError(Core::StringView("{\"code\":-32800,\"message\":\"cancelled\"}")).m_Code == Ied::ErrorCode::Cancelled, "a request the server cancelled");
		Ied::RpcError failed = Ied::LspServerError(Core::StringView("{\"code\":-32603,\"message\":\"boom\"}"));
		assert_true(failed.m_Code == Ied::ErrorCode::PluginError && failed.m_Data.View().Contains(Core::StringView("-32603")), "any other error is the server's failure, its object kept");
		assert_se("the language server failed", Ied::LspServerError(Core::StringView("{\"code\":-32603}")).m_Message.CStr(), "one without a message");
	}
}
