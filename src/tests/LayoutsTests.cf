// services/layouts: the layout file format, the device classes, and where a workspace's layouts live.

include "services/Layouts.ch"
include "services/Workspaces.ch"
include "host/Trust.ch"

static bool Reads(const char* text, int64& revision, Core::String& json) { return Ied::ReadLayoutFile(Core::StringView(text), revision, json); }

static Ied::Workspace* WorkspaceAt(const char* root, const char* kind) {
	Ied::Workspace* ws = new Ied::Workspace();
	ws->m_WsId = Core::String("w1");
	ws->m_Root = FS::Path(root);
	ws->m_Kind = Core::String(kind);
	ws->m_LocalState = Ied::LocalStateFolder(ws->m_Root, ws->m_Kind.View(), Core::StringView("C:/AppData/IED"));
	return ws;
}

[test("server.layouts")]
class LayoutTests {
	[test("file_format")]
	public static void TestFileFormat() {
		int64 revision = -1;
		Core::String json;
		assert_true(Reads("{\"revision\": 3, \"layout\": {\"v\": 1}}", revision, json), "an object");
		assert_eq(3, revision, "its revision");
		assert_se("{\"v\":1}", json.CStr(), "the document, as JSON text");
		assert_true(Reads("{\"revision\": 0, \"layout\": null}", revision, json), "a forgotten layout");
		assert_se("null", json.CStr(), "null");
	}

	[test("file_format_refused")]
	public static void TestFileFormatRefused() {
		int64 revision = 0;
		Core::String json;
		assert_true(!Reads("{\"layout\": {}}", revision, json), "no revision");
		assert_true(!Reads("{\"revision\": -1, \"layout\": {}}", revision, json), "a negative revision");
		assert_true(!Reads("{\"revision\": 1}", revision, json), "no layout");
		assert_true(!Reads("{\"revision\": 1, \"layout\": \"tabs\"}", revision, json), "a layout that is not an object");
		assert_true(!Reads("{\"revision\": 1, \"layout\": ", revision, json), "malformed JSON");
		assert_true(!Reads("", revision, json), "an empty file");
	}

	[test("device_classes")]
	public static void TestDeviceClasses() {
		assert_true(Ied::IsDeviceClass(Core::StringView("desktop")) && Ied::IsDeviceClass(Core::StringView("tablet")) && Ied::IsDeviceClass(Core::StringView("phone")), "the three");
		assert_true(!Ied::IsDeviceClass(Core::StringView("Desktop")) && !Ied::IsDeviceClass(Core::StringView("")) && !Ied::IsDeviceClass(Core::StringView("watch")), "nothing else");
	}

	[test("folder")]
	public static void TestFolder() {
		assert_se("C:/Work/Game/.ied/local/layout", Ied::LayoutFolder(WorkspaceAt("C:/Work/Game", "solution")).CStr(), "a solution: its .ied/local");
		Ied::Workspace* folder = WorkspaceAt("C:/Work/Notes", "folder");
		assert_se((folder->m_LocalState / "layout").CStr(), Ied::LayoutFolder(folder).CStr(), "a folder: layout in its local state, in the app data");
	}
}
