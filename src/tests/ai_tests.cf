// ai: server-sent events, one completion put together from its chunks, the dialects local models write, and what a
// model server says of itself.

include "ai/wire/sse.ch"
include "ai/wire/completion.ch"
include "ai/wire/dialect.ch"
include "ai/probe.ch"
include "ai/models.ch"

static Core::StringView View(const char* text) { return Core::StringView(text); }

[test("server.ai.sse")]
class SseTests {
	[test("events_and_comments")]
	public static void TestEventsAndComments() {
		Ied::SseReader sse;
		sse.Feed(View(": keepalive\n\ndata: {\"a\":1}\n"));
		Ied::SseEvent event;
		assert_true(sse.Next(event), "the comment");
		assert_true(event.kind == Ied::SseKind::Comment, "kept apart from data");
		assert_true(!sse.Next(event), "the event has not ended");
		sse.Feed(View("\r\ndata: [DONE]\n\n"));
		assert_true(sse.Next(event) && event.data.View() == "{\"a\":1}", "a CRLF blank line ends it");
		assert_true(sse.Next(event) && event.data.View() == "[DONE]", "then the next");
	}

	[test("data_lines_join")]
	public static void TestDataLinesJoin() {
		Ied::SseReader sse;
		sse.Feed(View("data: one\ndata:two\nevent: x\n\n"));
		Ied::SseEvent event;
		assert_true(sse.Next(event) && event.data.View() == "one\ntwo", "data lines join with a newline; the space after the colon is optional");
	}

	[test("bytes_split_anywhere")]
	public static void TestBytesSplitAnywhere() {
		Core::StringView stream = View("data: {\"x\":\"hello\"}\n\ndata: [DONE]\n\n");
		Ied::SseReader sse;
		Ied::SseEvent event;
		int32 events = 0;
		for (int64 i = 0; i < stream.ByteLength(); ++i) {
			sse.Feed(stream.Substring(i, 1));
			while (sse.Next(event)) events += 1;
		}
		assert_eq(2, events, "one byte at a time");
	}

	[test("flush_takes_an_unended_event")]
	public static void TestFlush() {
		Ied::SseReader sse;
		sse.Feed(View("data: last"));
		Ied::SseEvent event;
		assert_true(!sse.Next(event), "no blank line yet");
		assert_true(sse.Flush(event) && event.data.View() == "last", "a server that closed without it");
	}
}

[test("server.ai.completion")]
class CompletionTests {
	[test("content_reasoning_finish_usage")]
	public static void TestContent() {
		Ied::Completion completion;
		Core::Array<Ied::CompletionDelta> deltas;
		completion.Take(View("{\"choices\":[{\"delta\":{\"reasoning_content\":\"hm\"}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"reasoning\":\" ok\"}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"content\":\"lo\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":3},\"timings\":{\"prompt_per_second\":250.5}}"), deltas);
		completion.Take(View("[DONE]"), deltas);
		assert_true(completion.content.View() == "Hello", "content joins");
		assert_true(completion.reasoning.View() == "hm ok", "reasoning_content and reasoning both count");
		assert_true(completion.finishReason.View() == "stop", "the finish reason");
		assert_eq((int64)12, completion.promptTokens, "usage");
		assert_eq((int64)3, completion.completionTokens, "usage");
		assert_true(completion.promptPerSecond > 250.0, "llama.cpp's timings");
		assert_true(completion.done, "[DONE]");
		assert_eq((int64)4, deltas.Count(), "one delta per piece");
		assert_true(deltas[0].kind == Ied::DeltaKind::Reasoning && deltas[2].kind == Ied::DeltaKind::Content, "kinds");
	}

	[test("malformed_chunk_is_skipped")]
	public static void TestMalformed() {
		Ied::Completion completion;
		Core::Array<Ied::CompletionDelta> deltas;
		completion.Take(View("{\"choices\":[{\"delta\":{\"content\":\"a\"}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"del"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"content\":\"b\"}}]}"), deltas);
		assert_eq((int64)1, completion.malformedChunks, "counted");
		assert_true(completion.content.View() == "ab", "and skipped");
	}

	[test("error_in_the_stream")]
	public static void TestError() {
		Ied::Completion completion;
		Core::Array<Ied::CompletionDelta> deltas;
		completion.Take(View("{\"error\":{\"message\":\"context length exceeded\",\"code\":400}}"), deltas);
		assert_true(completion.errored && completion.errorMessage.View() == "context length exceeded", "the server's message");
	}

	[test("tool_calls_merge_by_id_then_index")]
	public static void TestToolCalls() {
		Ied::Completion completion;
		Core::Array<Ied::CompletionDelta> deltas;
		completion.Take(View("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"a\",\"function\":{\"name\":\"fs_read\",\"arguments\":\"{\\\"pa\"}}]}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"th\\\":1}\"}}]}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"b\",\"function\":{\"name\":\"fs_list\",\"arguments\":\"{}\"}}]}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{},\"finish_reason\":\"tool_calls\"}]}"), deltas);
		assert_eq((int64)2, completion.calls.Count(), "two ids at one index stay two calls");
		assert_true(completion.calls[0]->name.View() == "fs_read" && completion.calls[0]->arguments.View() == "{\"path\":1}", "an id-less delta joins the latest call at its index");
		assert_true(completion.calls[1]->name.View() == "fs_list", "the second call");
		assert_true(deltas[1].call == 0 && deltas[2].call == 1, "deltas name their call");
	}

	[test("id_arriving_late_joins")]
	public static void TestLateId() {
		Ied::Completion completion;
		Core::Array<Ied::CompletionDelta> deltas;
		completion.Take(View("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"name\":\"finish\",\"arguments\":\"\"}}]}}]}"), deltas);
		completion.Take(View("{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"c1\",\"function\":{\"arguments\":\"{}\"}}]}}]}"), deltas);
		assert_eq((int64)1, completion.calls.Count(), "an id first seen later joins the id-less call at its index");
		assert_true(completion.calls[0]->id.View() == "c1" && completion.calls[0]->arguments.View() == "{}", "and gives it the id");
	}
}

[test("server.ai.dialect")]
class DialectTests {
	[test("think_split_across_chunks")]
	public static void TestThink() {
		Ied::ThinkSplitter splitter;
		Core::String thinking;
		Core::String visible;
		const char*[5] chunks = { "<thi", "nk>plan", "ning</th", "ink>Hello <", "b>" };
		for (int32 i = 0; i < 5; ++i) splitter.Feed(View(chunks[i]), thinking, visible);
		splitter.Flush(thinking, visible);
		assert_true(thinking.View() == "planning", "the reasoning");
		assert_true(visible.View() == "Hello <b>", "the rest, a '<' that was not a tag included");
		assert_true(splitter.SawThink() && !splitter.InThink(), "closed");
	}

	[test("unclosed_think_is_reasoning")]
	public static void TestUnclosedThink() {
		Ied::ThinkSplitter splitter;
		Core::String thinking;
		Core::String visible;
		splitter.Feed(View("<think>still going"), thinking, visible);
		splitter.Flush(thinking, visible);
		assert_true(thinking.View() == "still going" && visible.IsEmpty() && splitter.InThink(), "a cut stream ends inside");
	}

	[test("hermes")]
	public static void TestHermes() {
		Core::String rest;
		Core::Array<Ied::TextToolCall> calls = Ied::ParseTextToolCalls(View("Reading it.\n<tool_call>\n{\"name\": \"fs_read\", \"arguments\": {\"path\": \"a.cf\"}}\n</tool_call>"), rest);
		assert_eq((int64)1, calls.Count(), "one call");
		assert_true(calls[0].name.View() == "fs_read", "its name");
		assert_true(calls[0].arguments.View() == "{\"path\":\"a.cf\"}", "its arguments as JSON");
		assert_true(rest.View() == "Reading it.", "the prose around it");
	}

	[test("qwen")]
	public static void TestQwen() {
		Core::String rest;
		Core::Array<Ied::TextToolCall> calls = Ied::ParseTextToolCalls(View("<tool_call>\n<function=fs_read>\n<parameter=path>\nsrc/a.cf\n</parameter>\n<parameter=offset>\n10\n</parameter>\n</function>\n</tool_call>"), rest);
		assert_eq((int64)1, calls.Count(), "one call");
		assert_true(calls[0].name.View() == "fs_read", "its name");
		assert_true(calls[0].arguments.View() == "{\"path\":\"src/a.cf\",\"offset\":10}", "a raw value is a string, a JSON one stays JSON");
	}

	[test("mistral_list_and_args")]
	public static void TestMistral() {
		Core::String rest;
		Core::Array<Ied::TextToolCall> calls = Ied::ParseTextToolCalls(View("[TOOL_CALLS][{\"name\": \"fs_list\", \"arguments\": {}}, {\"name\": \"finish\", \"arguments\": {\"summary\": \"x\"}}]"), rest);
		assert_eq((int64)2, calls.Count(), "a list of calls");
		assert_true(calls[1].name.View() == "finish" && rest.IsEmpty(), "both, nothing left");
		calls = Ied::ParseTextToolCalls(View("[TOOL_CALLS]fs_read[ARGS]{\"path\": \"b\"}"), rest);
		assert_eq((int64)1, calls.Count(), "the name[ARGS] form");
		assert_true(calls[0].name.View() == "fs_read" && calls[0].arguments.View() == "{\"path\": \"b\"}", "arguments as written");
	}

	[test("fenced_json")]
	public static void TestFenced() {
		Core::String rest;
		Core::Array<Ied::TextToolCall> calls = Ied::ParseTextToolCalls(View("I'll list it:\n```json\n{\"name\": \"fs_list\", \"parameters\": {\"path\": \".\"}}\n```"), rest);
		assert_eq((int64)1, calls.Count(), "one call");
		assert_true(calls[0].name.View() == "fs_list" && calls[0].arguments.View() == "{\"path\":\".\"}", "parameters count as arguments");
		calls = Ied::ParseTextToolCalls(View("```json\n{\"a\": 1}\n```"), rest);
		assert_eq((int64)0, calls.Count(), "a fenced object without a name is just code");
	}

	[test("harmony")]
	public static void TestHarmony() {
		Core::String rest;
		Core::Array<Ied::TextToolCall> calls = Ied::ParseTextToolCalls(View("<|start|>assistant<|channel|>commentary to=functions.fs_read <|constrain|>json<|message|>{\"path\": \"c\"}<|call|>"), rest);
		assert_eq((int64)1, calls.Count(), "one call");
		assert_true(calls[0].name.View() == "fs_read" && calls[0].arguments.View() == "{\"path\": \"c\"}", "name and arguments");
	}

	[test("prose_is_not_a_call")]
	public static void TestProse() {
		Core::String rest;
		assert_eq((int64)0, Ied::ParseTextToolCalls(View("I will now read the file."), rest).Count(), "no calls");
		assert_true(!Ied::LooksLikeTextToolCall(View("I will now read the file.")), "nothing that looks like one");
		assert_true(Ied::LooksLikeTextToolCall(View("<tool_call>{\"name\": \"fs_read\", \"argu")), "a cut call looks like one");
	}
}

[test("server.ai.probe")]
class ProbeTests {
	[test("llamacpp_props_and_models")]
	public static void TestLlamaCpp() {
		Ied::ModelProbe probe;
		Ied::ReadModelList(View("{\"object\": \"list\", \"data\": [{\"id\": \"qwen\", \"meta\": {\"n_ctx\": 262144, \"n_ctx_train\": 262144}}]}"), probe);
		assert_eq((int64)262144, probe.contextWindow, "llama.cpp's meta.n_ctx");
		Ied::ReadProps(View("{\"default_generation_settings\": {\"n_ctx\": 65536}, \"total_slots\": 4}"), probe);
		assert_true(probe.server.View() == "llama.cpp", "/props names llama.cpp");
		assert_eq((int64)65536, probe.contextWindow, "the slot context wins over the model's");
		assert_eq((int64)4, probe.slots, "slots");
		assert_true(probe.models.Count() == 1 && probe.models[0].View() == "qwen", "the ids");
	}

	[test("vllm_max_model_len")]
	public static void TestVllm() {
		Ied::ModelProbe probe;
		Ied::ReadModelList(View("{\"data\": [{\"id\": \"a\", \"max_model_len\": 32768}, {\"id\": \"b\"}]}"), probe);
		assert_eq((int64)32768, probe.contextWindow, "vLLM's max_model_len");
		assert_eq((int64)2, probe.models.Count(), "every model");
		Ied::ReadProps(View("{\"error\": \"not found\"}"), probe);
		assert_eq((int64)32768, probe.contextWindow, "props without a slot context change nothing");
	}

	[test("server_root")]
	public static void TestServerRoot() {
		assert_true(Ied::ServerRoot(View("http://h:8080/v1")).View() == "http://h:8080", "/v1 off");
		assert_true(Ied::ServerRoot(View("http://h:8080/v1/")).View() == "http://h:8080", "a trailing slash too");
		assert_true(Ied::ServerRoot(View("http://h:11434")).View() == "http://h:11434", "no /v1 stays");
	}
}

[test("server.ai.models")]
class ModelTests {
	[test("an_off_role_uses_primary")]
	public static void TestOffRole() {
		Core::Array<Core::String> problems;
		Core::Array<Ied::ModelProfile*> models = Ied::ReadModels(View("{\"a\": {\"endpoint\": \"http://a/v1\"}, \"b\": {\"endpoint\": \"http://b/v1\"}}"), problems);
		const char* groups = "{\"g\": {\"primary\": {\"model\": \"b\", \"fallback\": [\"a\"]}, \"worker\": {\"model\": \"a\"}}}";
		Ied::RoleModel role;
		Core::Array<Ied::ModelProfile*> worker = Ied::RoleCandidates(models, View(groups), View("g"), View("worker"), role);
		assert_true(worker.Count() == 1 && worker[0]->name.View() == "a", "a role that is on uses its model");
		Ied::RoleModel off;
		Core::Array<Ied::ModelProfile*> planning = Ied::RoleCandidates(models, View(groups), View("g"), View("planning"), off);
		assert_true(planning.Count() == 2 && planning[0]->name.View() == "b" && planning[1]->name.View() == "a", "an off role is the primary, fallbacks too");
		Ied::RoleModel none;
		Core::Array<Ied::ModelProfile*> first = Ied::RoleCandidates(models, View("{}"), View("g"), View("primary"), none);
		assert_true(first.Count() == 1 && first[0]->name.View() == "a", "no group: the first model");
		assert_true(problems.IsEmpty(), "both profiles read");
	}
}
