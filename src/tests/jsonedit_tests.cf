// settings/jsonedit: top-level members found past comments and nesting, and values set, added and removed with the
// comments and layout around them kept.

include "settings/jsonedit.ch"

static Core::String Set(const char* text, const char* key, const char* value) {
	Core::String edited;
	Core::String error;
	if (!Ied::SetMember(Core::StringView(text), Core::StringView(key), Core::StringView(value), edited, error)) return Core::String("ERROR ") + error.View();
	return edited;
}

static Core::String Removed(const char* text, const char* key) {
	Core::String edited;
	Core::String error;
	if (!Ied::RemoveMember(Core::StringView(text), Core::StringView(key), edited, error)) return Core::String("ERROR ") + error.View();
	return edited;
}

[test("server.jsonedit")]
class JsonEditTests {
	[test("scan")]
	public static void TestScan() {
		Ied::TopLevel top;
		Core::String error;
		const char* text = "// settings\n{\n\t\"a\": 1, // one\n\t\"b\": {\"x\": [1, {\"y\": \"}\"}]}, /* , */\n\t\"c\": \"s,t\"\n}\n";
		assert_true(Ied::ScanMembers(Core::StringView(text), top, error), error.CStr());
		assert_eq((int64)3, top.members.Count(), "three members, nesting and comments passed over");
		Core::StringView view = Core::StringView(text);
		assert_true(view.Substring(top.members[1]->valueStart, top.members[1]->valueEnd - top.members[1]->valueStart) == "{\"x\": [1, {\"y\": \"}\"}]}", "a nested value's span");
		assert_true(view.Substring(top.members[2]->valueStart, top.members[2]->valueEnd - top.members[2]->valueStart) == "\"s,t\"", "a string with a comma");
		assert_eq(5, Ied::LineOf(view, top.members[2]->keyStart), "its line");
		const char*[4] bad = { "[1]", "{\"a\" 1}", "{\"a\": 1 \"b\": 2}", "{ /* never" };
		for (int32 i = 0; i < 4; ++i) {
			Ied::TopLevel broken;
			assert_true(!Ied::ScanMembers(Core::StringView(bad[i]), broken, error), bad[i]);
		}
	}

	[test("set")]
	public static void TestSet() {
		assert_se("{\n\t// tab width\n\t\"editor.tabSize\": 2, // narrow\n\t\"b\": true\n}", Set("{\n\t// tab width\n\t\"editor.tabSize\": 4, // narrow\n\t\"b\": true\n}", "editor.tabSize", "2").CStr(),
			"a value replaced in place, comments kept");
		assert_se("{\n\t\"a\": 1,\n\t\"new.key\": [1, 2]\n}", Set("{\n\t\"a\": 1\n}", "new.key", "[1, 2]").CStr(), "a new member after the last");
		assert_se("{\n\t\"k\": \"v\"\n}", Set("{}", "k", "\"v\"").CStr(), "into an empty object");
		assert_se("{\n\t\"k\": 1\n}\n", Set("", "k", "1").CStr(), "a new file");
		assert_true(Set("[]", "k", "1").View().StartsWith(Core::StringView("ERROR")), "not an object");
	}

	[test("remove")]
	public static void TestRemove() {
		assert_se("{\n\t\"b\": 2\n}", Removed("{\n\t\"a\": 1,\n\t\"b\": 2\n}", "a").CStr(), "the first member and its line");
		assert_se("{\n\t\"a\": 1\n}", Removed("{\n\t\"a\": 1,\n\t\"b\": 2\n}", "b").CStr(), "the last member and the comma before it");
		assert_se("{\n\t// keep\n\t\"a\": 1,\n\t\"c\": 3\n}", Removed("{\n\t// keep\n\t\"a\": 1,\n\t\"b\": 2,\n\t\"c\": 3\n}", "b").CStr(), "a middle member");
		assert_se("{\n}", Removed("{\n\t\"a\": 1\n}", "a").CStr(), "the only member");
		assert_se("{\"a\": 1}", Removed("{\"a\": 1}", "zzz").CStr(), "a missing member: nothing changes");
	}
}
