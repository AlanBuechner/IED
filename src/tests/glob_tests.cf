// fs/glob: '*', '?' and "**" against paths, case folded; what counts as a glob.

include "fs/glob.ch"

static bool Match(const char* pattern, const char* path) { return Ied::GlobMatch(Core::StringView(pattern), Core::StringView(path)); }

[test("server.glob")]
class GlobTests {
	[test("segments")]
	public static void TestSegments() {
		assert_true(Match("build/ied/*.iedproj", "build/ied/Game.iedproj"), "a star in the last segment");
		assert_true(!Match("build/ied/*.iedproj", "build/ied/sub/Game.iedproj"), "a star stays in its segment");
		assert_true(Match("src/?.cf", "src/a.cf") && !Match("src/?.cf", "src/ab.cf"), "one character");
		assert_true(Match("BUILD\\ied\\game.IEDPROJ", "build/ied/Game.iedproj"), "case and separators folded");
		assert_true(Match("*", "anything") && !Match("*", "a/b"), "a lone star");
		assert_true(Match("a*b*c", "aXXbYYc") && !Match("a*b*c", "aXXbYY"), "stars that must back up");
	}

	[test("double_star")]
	public static void TestDoubleStar() {
		assert_true(Match("**/*.iedproj", "Game.iedproj"), "no folders");
		assert_true(Match("**/*.iedproj", "a/b/c/Game.iedproj"), "many folders");
		assert_true(Match("build/**/x.json", "build/x.json") && Match("build/**/x.json", "build/a/b/x.json"), "in the middle");
		assert_true(!Match("build/**/x.json", "other/x.json"), "but not elsewhere");
		assert_true(Match("**", "a/b/c"), "everything");
	}

	[test("is_glob")]
	public static void TestIsGlob() {
		assert_true(Ied::IsGlob(Core::StringView("a/*.x")) && Ied::IsGlob(Core::StringView("?")), "wildcards");
		assert_true(!Ied::IsGlob(Core::StringView("tools/Tool.iedproj")), "a plain path");
	}
}
