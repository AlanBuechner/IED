// tasks: what a project offers (presets under its own file, by key; a preset no loaded plugin offers names the plugin
// that offers it and why it is out), ${name} expansion that refuses unknown names,
// problem matchers over one line and over several, the toolbar's selections on disk, a run's problems as JSON, and a
// step's missing program: the setting that names it, whether cmd would find it, what to say.

include "tasks/model.ch"
include "tasks/expand.ch"
include "tasks/matcher.ch"
include "tasks/selections.ch"
include "tasks/runner.ch"
include "tasks/missing.ch"
include "tasks/presets.ch"

static Serialization::DomNode Json(const char* text) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Serialization::ReadJson(Core::StringView(text), *doc).root;
}

// A plugin as the host keeps it: `contributes` null for a manifest that could not be read.
static Ied::Plugin* PluginWith(const char* id, Ied::PluginState state, const char* contributes) {
	Ied::Manifest* manifest = new Ied::Manifest();
	manifest->id = Core::String(id);
	manifest->folder = FS::Path("C:/toolchains/c4/dev/ied");
	if (contributes) {
		manifest->root = Json(contributes);
		manifest->contributes = manifest->root.Member("contributes");
	}
	Ied::Plugin* plugin = new Ied::Plugin();
	plugin->manifest = manifest;
	plugin->state = state;
	return plugin;
}

static Ied::ProblemMatcher* Matcher(const char* json) {
	Core::String problem;
	return Ied::ReadProblemMatcher(Json(json), problem);
}

[test("server.tasks")]
class TasksTests {
	[test("missing_program")]
	public static void TestMissingProgram() {
		assert_se("nuke.command", Ied::ProgramSetting(Core::StringView("\"${config:nuke.command}\" build ${config}")).CStr(), "quoted, as the Nuke preset writes it");
		assert_se("tool.path", Ied::ProgramSetting(Core::StringView("  ${config:tool.path} -v")).CStr(), "bare");
		assert_se("", Ied::ProgramSetting(Core::StringView("nuke ${config:nuke.command}")).CStr(), "a setting later on the line names no program");
		assert_se("C:/Tools/nuke.cmd", Ied::ProgramWord(Core::StringView("\"C:/Tools/nuke.cmd\" run")).CStr(), "quotes taken off");
		assert_se("nuke", Ied::ProgramWord(Core::StringView("nuke build Development")).CStr(), "the first word");
		FS::Path folder = FS::TempDirectory() / "ied-missing-program-test";
		FS::RemoveAll(folder.CStr());
		assert_true(FS::MakeDirectories((folder / "bin").CStr()), "made");
		const char* text = "@echo off";
		assert_true(FS::WriteFileAtomically((folder / "bin" / "tool.cmd").CStr(), text, 9), "written");
		Core::StringView extensions = Core::StringView(".COM;.EXE;.BAT;.CMD");
		Core::String path = Core::String("C:/nowhere;") + (folder / "bin").View();
		assert_true(Ied::FindsProgram(Core::StringView("tool"), folder.View(), path.View(), extensions), "on PATH, with PATHEXT's .CMD");
		assert_true(Ied::FindsProgram(Core::StringView("tool"), (folder / "bin").View(), Core::StringView(""), extensions), "in the step's folder");
		assert_true(Ied::FindsProgram(Core::StringView("bin/tool.cmd"), folder.View(), Core::StringView(""), extensions), "a path under the step's folder");
		assert_true(!Ied::FindsProgram(Core::StringView("nuke"), folder.View(), path.View(), extensions), "nowhere");
		assert_true(!Ied::FindsProgram(Core::StringView("tool.exe"), folder.View(), path.View(), extensions), "an extension of its own is not completed");
		Core::String note = Ied::MissingProgramNote(Core::StringView("nuke"), Core::StringView("nuke.command"));
		assert_true(note.View().IndexOf(Core::StringView("nuke was not found"), 0) >= 0 && note.View().IndexOf(Core::StringView("Set nuke.command (Settings)"), 0) >= 0, "names the program and its setting");
		FS::RemoveAll(folder.CStr());
	}

	[test("missing_preset")]
	public static void TestMissingPreset() {
		const char* offersNuke = "{\"contributes\": {\"taskPresets\": [{\"id\": \"c4.nuke\"}]}}";
		Core::Array<Ied::Plugin*> plugins;
		plugins.Push(PluginWith("rust", Ied::PluginState::Loaded, "{\"contributes\": {\"taskPresets\": [{\"id\": \"rust.nuke\"}]}}"));
		plugins.Push(PluginWith("lint", Ied::PluginState::Failed, "{\"contributes\": {}}"));
		assert_se("no plugin offers the task preset c4.nuke", Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins).CStr(), "no plugin that is out offers it");

		Ied::Plugin* c4 = PluginWith("c4", Ied::PluginState::Failed, offersNuke);
		c4->manifest->problems.Push(Core::String("/contributes/systemMessageSections/0/maxTokens: 640 is greater than maximum 600"));
		plugins.Push(c4);
		Core::String text = Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins);
		assert_true(text.View().StartsWith(Core::StringView("no plugin offers the task preset c4.nuke: the plugin c4, which offers it, did not load: /contributes/systemMessageSections/0/maxTokens: 640 is greater than maximum 600, in ")), text.CStr());
		assert_true(text.View().EndsWith(Core::StringView("ied-plugin.json")), "the manifest to fix");
		c4->manifest->problems.Push(Core::String("/version: not a version"));
		assert_true(Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins).View().Contains(Core::StringView("600 (and 1 more), in ")), "the first problem, and how many more");

		c4->state = Ied::PluginState::Untrusted;
		assert_se("no plugin offers the task preset c4.nuke: the plugin c4, which offers it, is off until this workspace is trusted", Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins).CStr(), "a workspace not trusted");
		c4->state = Ied::PluginState::Disabled;
		assert_true(Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins).View().EndsWith(Core::StringView("which offers it, is turned off (Extensions > Manage Plugins)")), "turned off");
		c4->state = Ied::PluginState::Overridden;
		assert_se("no plugin offers the task preset c4.nuke", Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins).CStr(), "another of its id stands in");

		Ied::Plugin* unread = PluginWith("broken", Ied::PluginState::Failed, nullptr);
		unread->manifest->problems.Push(Core::String("ied-plugin.json is not JSON: unexpected end (line 3)"));
		plugins.Push(unread);
		text = Ied::MissingPresetText(Core::StringView("c4.nuke"), plugins);
		assert_true(text.View().StartsWith(Core::StringView("no plugin offers the task preset c4.nuke; the plugin broken did not load: ied-plugin.json is not JSON: unexpected end (line 3), in ")), text.CStr());
	}

	[test("presets_under_the_project")]
	public static void TestPresetsUnderTheProject() {
		Ied::OfferedTasks offered;
		Ied::ReadTaskEntries(Json("{\"variables\": {\"config\": {\"kind\": \"dropdown\", \"values\": [\"Debug\", \"Development\"], \"default\": \"Development\", \"scope\": \"solution\"}},"
			"\"tasks\": {\"build\": {\"slot\": \"build\", \"steps\": [{\"run\": [\"nuke\", \"build\"], \"problemMatcher\": \"c4\"}]}, \"test\": {\"steps\": [{\"run\": \"nuke test\"}]}},"
			"\"toolbar\": [\"config\", \"build\"]}"), Core::StringView("preset c4.nuke"), offered);
		Ied::ReadTaskEntries(Json("{\"tasks\": {\"build\": {\"label\": \"Build it\", \"steps\": [{\"task\": \"test\"}, {\"run\": [\"x\"], \"onlyIf\": \"always\", \"env\": {\"A\": \"1\"}}]}, \"empty\": {\"steps\": []}}}"), Core::StringView("Game.iedproj"), offered);
		assert_eq(2, offered.tasks.Count(), "the project's build replaced the preset's; an empty task is a problem, not a task");
		Ied::TaskDef* build = offered.Task(Core::StringView("build"));
		assert_se("Build it", build->label.CStr(), "the project's");
		assert_true(build->slot.IsEmpty() && offered.InSlot(Core::StringView("build")) == nullptr, "a replaced task keeps nothing of the preset's");
		assert_true(build->steps[0]->kind == Ied::StepKind::Task && build->steps[0]->name == "test", "a task step");
		assert_true(build->steps[1]->onlyIf == Ied::OnlyIf::Always && build->steps[1]->env[0] == "A=1", "onlyIf and env");
		assert_se("nuke test", offered.Task(Core::StringView("test"))->steps[0]->shell.CStr(), "a shell string");
		assert_eq(1, offered.problems.Count(), "the empty task");
		Ied::TaskVariable* config = offered.Variable(Core::StringView("config"));
		assert_true(config->solutionScope && config->defaultValue == "Development" && config->values.Count() == 2, "the variable");
		assert_eq(2, offered.toolbar.Count(), "the preset's toolbar stays when the project has none");
	}

	[test("expansion")]
	public static void TestExpansion() {
		Ied::TaskLookup lookup = [](Core::StringView name, Core::String& value) -> bool {
			if (name == "config") value = Core::String("Debug");
			else if (name == "buildSystem.projectName") value = Core::String("Game");
			else return false;
			return true;
		};
		Core::String out;
		Core::String unknown;
		assert_true(Ied::ExpandTaskText(Core::StringView("-c ${config} -p ${buildSystem.projectName}"), lookup, out, unknown) && out == "-c Debug -p Game", "known names");
		assert_true(!Ied::ExpandTaskText(Core::StringView("${config}/${nope}"), lookup, out, unknown) && unknown == "nope", "an unknown name fails, named");
		assert_true(Ied::ExpandTaskText(Core::StringView("plain $ {x} ${"), lookup, out, unknown) && out == "plain $ {x} ${", "no variable");
	}

	[test("one_line_matcher")]
	public static void TestOneLineMatcher() {
		Ied::ProblemMatcher* c4 = Matcher("{\"id\": \"c4\", \"source\": \"c4\", \"patterns\": [{\"regexp\": \"^(.+?) \\\\((\\\\d+):(\\\\d+)\\\\) (fatal error|error|warning): (.*)$\", \"file\": 1, \"line\": 2, \"column\": 3, \"severity\": 4, \"message\": 5}]}");
		assert_true(c4 != nullptr && c4->source == "c4" && c4->fileKind == "search", "read");
		Ied::MatcherState state = Ied::MatcherState(c4);
		Ied::MatchedProblem found;
		assert_true(state.Feed(Core::StringView("src/main.cf (12:5) error: no member 'x'"), found), "a problem");
		assert_true(found.file == "src/main.cf" && found.line == 12 && found.column == 5 && found.severity == "error" && found.message == "no member 'x'", "its fields");
		assert_true(state.Feed(Core::StringView("a.cf (1:1) fatal error: stop"), found) && found.severity == "error", "fatal error is an error");
		assert_true(!state.Feed(Core::StringView("Compiling Game..."), found), "not a problem");
		Core::String problem;
		assert_true(Ied::ReadProblemMatcher(Json("{\"id\": \"bad\", \"patterns\": [{\"regexp\": \"(\"}]}"), problem) == nullptr && !problem.IsEmpty(), "a pattern that does not compile");
	}

	[test("multi_line_matcher")]
	public static void TestMultiLineMatcher() {
		Ied::ProblemMatcher* lint = Matcher("{\"id\": \"lint\", \"severityMap\": {\"W\": \"warning\"}, \"defaultSeverity\": \"info\", \"patterns\": ["
			"{\"regexp\": \"^FILE (.+)$\", \"file\": 1},"
			"{\"regexp\": \"^  (\\\\d+): ([A-Z]) (.+)$\", \"line\": 1, \"severity\": 2, \"message\": 3, \"loop\": true}]}");
		Ied::MatcherState state = Ied::MatcherState(lint);
		Ied::MatchedProblem found;
		assert_true(!state.Feed(Core::StringView("FILE a.c"), found), "the first line starts a problem");
		assert_true(state.Feed(Core::StringView("  3: W unused"), found) && found.file == "a.c" && found.line == 3 && found.severity == "warning", "the second completes it, the file carried over");
		assert_true(state.Feed(Core::StringView("  7: X odd"), found) && found.file == "a.c" && found.line == 7 && found.severity == "info", "the loop goes on; an unmapped word is the default");
		assert_true(!state.Feed(Core::StringView("done"), found), "the loop ends");
		assert_true(!state.Feed(Core::StringView("  9: W stray"), found), "a loop line without its first line is nothing");
		assert_true(!state.Feed(Core::StringView("FILE b.c"), found) && state.Feed(Core::StringView("  1: W x"), found) && found.file == "b.c", "a new problem");
	}

	[test("selections")]
	public static void TestSelections() {
		FS::Path file = FS::TempDirectory() / "ied-selections-test" / "selections.json";
		FS::RemoveAll(file.Parent().CStr());
		Ied::TaskSelections empty = Ied::ReadTaskSelections(file);
		Core::String value;
		assert_true(empty.startupProject.IsEmpty() && !empty.Value(Core::StringView("Game"), Core::StringView("config"), true, value), "none yet");
		Ied::TaskSelections chosen;
		chosen.startupProject = Core::String("Game");
		chosen.Set(Core::StringView("Game"), Core::StringView("config"), true, Core::StringView("Debug"));
		chosen.Set(Core::StringView("Game"), Core::StringView("target"), false, Core::StringView("Win64"));
		assert_true(Ied::WriteTaskSelections(file, chosen), "written");
		Ied::TaskSelections read = Ied::ReadTaskSelections(file);
		assert_se("Game", read.startupProject.CStr(), "the startup project");
		assert_true(read.Value(Core::StringView("Tool"), Core::StringView("config"), true, value) && value == "Debug", "a solution variable is every project's");
		assert_true(read.Value(Core::StringView("Game"), Core::StringView("target"), false, value) && value == "Win64", "a project's own");
		assert_true(!read.Value(Core::StringView("Tool"), Core::StringView("target"), false, value), "not another project's");
		FS::RemoveAll(file.Parent().CStr());
	}

	[test("run_problems_json")]
	public static void TestRunProblemsJson() {
		Ied::TaskRun* run = new Ied::TaskRun();
		run->problems.Insert(Core::String("c4/Game\nsrc/a.cf"), Core::String("{\"message\":\"one\"},{\"message\":\"two\"}"));
		run->problems.Insert(Core::String("lint/Game\nsrc/a.cf"), Core::String("{\"message\":\"three\"}"));
		run->problems.Insert(Core::String("c4/Game\nsrc/b.cf"), Core::String("{\"message\":\"four\"}"));
		Serialization::DomNode files = Json(Ied::RunProblemsJson(run).CStr());
		assert_true(files.Kind() == Serialization::DomKind::Object && files.Count() == 2, "a member per file");
		Serialization::DomNode a = files.Member("src/a.cf");
		assert_true(a.Count() == 2 && a.Member("c4/Game").Count() == 2 && a.Member("lint/Game").Count() == 1, "an array per source, every item in it");
		assert_true(a.Member("c4/Game").At(1).Member("message").AsView() == "two", "in order");
		assert_true(files.Member("src/b.cf").Member("c4/Game").At(0).Member("message").AsView() == "four", "the other file");
		assert_true(Ied::RunProblemsJson(new Ied::TaskRun()).View() == "{}", "none");
	}
}
