// services/workspaces' and services/trash's honest parts: workspace-relative paths, the paths no one browses, the
// ids that name trash entries, and which files are solutions and projects (the names before too) and which folder
// opens as its solution.

include "services/Workspaces.ch"
include "services/Trash.ch"
include "solutions/Model.ch"

static bool Refused(const char* path) {
	try {
		Ied::NormalizePath(Core::StringView(path));
	}
	catch (Ied::RpcError& error) {
		return error.m_Code == Ied::ErrorCode::BadRequest;
	}
	return false;
}

[test("server.workspaces")]
class WorkspaceTests {
	[test("normalize_path")]
	public static void TestNormalizePath() {
		assert_se("src/main.cf", Ied::NormalizePath(Core::StringView("src/main.cf")).CStr(), "as it is");
		assert_se("src/main.cf", Ied::NormalizePath(Core::StringView("src\\main.cf")).CStr(), "backslashes");
		assert_se("a/b", Ied::NormalizePath(Core::StringView("/a//b/")).CStr(), "empty parts dropped");
		assert_true(Ied::NormalizePath(Core::StringView("")).IsEmpty(), "the root");
		assert_se("a", Ied::NormalizePath(Core::StringView("./a")).CStr(), "'.' is the folder it is in");
		assert_se("a/b", Ied::NormalizePath(Core::StringView("a/./b/.")).CStr(), "anywhere in the path");
		assert_true(Ied::NormalizePath(Core::StringView(".")).IsEmpty(), "'.' alone the root");
		const char*[4] bad = { "..", "a/../b", "C:/Windows", "./.." };
		for (int32 i = 0; i < 4; ++i) assert_true(Refused(bad[i]), bad[i]);
	}

	[test("hidden_paths")]
	public static void TestHiddenPaths() {
		assert_true(Ied::IsHiddenPath(Core::StringView(".git")) && Ied::IsHiddenPath(Core::StringView(".git/HEAD")), "a repository's folder");
		assert_true(!Ied::IsHiddenPath(Core::StringView(".github/workflows/ci.yml")), "not a folder that merely starts alike");
		assert_true(!Ied::IsHiddenPath(Core::StringView("src/.gitignore")), "nor a file named like it");
	}

	[test("trash_ids")]
	public static void TestTrashIds() {
		assert_true(Ied::IsTrashId(Core::StringView("1792555292665-3")), "the form MoveIn makes");
		const char*[6] bad = { "", "..", "../x", "1-2/..", "C:", "1792555292665-3\\.." };
		for (int32 i = 0; i < 6; ++i) assert_true(!Ied::IsTrashId(Core::StringView(bad[i])), bad[i]);
	}

	[test("text_digest")]
	public static void TestTextDigest() {
		assert_se("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", Ied::TextDigest(Core::StringView("abc")).CStr(), "SHA-256, hex");
	}

	[test("ungiven_projects")]
	public static void TestUngivenProjects() {
		Ied::SolutionModel* solution = new Ied::SolutionModel();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		solution->m_Data = Serialization::ReadJson(Core::StringView(
			"{\"groups\": [{\"name\": \"C4\", \"projects\": [\"C4\", \"C4Api\"]}, {\"name\": \"Plugins\", \"projects\": [\"ied.chat\"], \"groups\": [{\"name\": \"More\", \"projects\": [\"ied.git\", \"C4Api\"]}]}]}"), *doc).root;
		Ied::ProjectModel* given = new Ied::ProjectModel();
		given->m_Name = Core::String("C4");
		solution->m_Projects.Push(given);
		Core::Array<Core::String> ungiven = solution->UngivenProjects();
		assert_eq(3, ungiven.Count(), "a project named twice counts once; one a file gives does not count");
		assert_true(ungiven[0] == "C4Api" && ungiven[1] == "ied.chat" && ungiven[2] == "ied.git", "in the order named, nested groups too");
		Ied::SolutionModel* plain = new Ied::SolutionModel();
		plain->m_Data = Serialization::ReadJson(Core::StringView("{\"projects\": []}"), *doc).root;
		assert_true(plain->UngivenProjects().IsEmpty(), "no groups, nothing ungiven");
	}

	static Ied::ProjectModel* ProjectAt(const char* name, const FS::Path& root) {
		Ied::ProjectModel* project = new Ied::ProjectModel();
		project->m_Name = Core::String(name);
		project->m_Root = root;
		return project;
	}

	[test("linked_projects")]
	public static void TestLinkedProjects() {
		FS::Path games = FS::Path("C:/Games/Mine");
		Ied::SolutionModel* solution = new Ied::SolutionModel();
		solution->m_Folder = games;
		solution->m_Projects.Push(ProjectAt("Game", games / "Game"));
		solution->m_Projects.Push(ProjectAt("Mine", games));
		solution->m_Projects.Push(ProjectAt("Engine", FS::Path("D:/Claymore/Engine")));
		solution->m_Projects.Push(ProjectAt("Anime", FS::Path("D:/Claymore/Plugins/Anime")));
		Ied::PlaceRoots(solution);
		assert_true(solution->m_Projects[0]->m_Path == "Game" && solution->m_Projects[0]->m_Link.IsEmpty(), "inside: a path of the folder");
		assert_true(solution->m_Projects[1]->m_Path.IsEmpty(), "the folder itself");
		assert_true(solution->m_Projects[2]->m_Link == "@Engine" && solution->m_Projects[2]->m_Path == "@Engine", "outside: a link of its name");
		assert_true(solution->LinkedFile(Core::StringView("@Engine/src/a.cf")).View() == FS::Path("D:/Claymore/Engine/src/a.cf").View(), "a link's file");
		assert_true(solution->LinkedFile(Core::StringView("@Anime")).View() == FS::Path("D:/Claymore/Plugins/Anime").View(), "the link itself is the root");
		assert_true(solution->LinkedFile(Core::StringView("@Nothing/a.cf")).IsEmpty() && solution->LinkedFile(Core::StringView("Game/a.cf")).IsEmpty(), "no such link, or none at all");
		Core::String path;
		assert_true(solution->LinkedPath(FS::Path("d:\\claymore\\plugins\\anime\\src\\b.cf"), path) && path == "@Anime/src/b.cf", path.CStr());
		assert_true(!solution->LinkedPath(FS::Path("D:/Claymore/Other/c.cf"), path), "under no linked root");
		assert_true(!solution->LinkedPath(FS::Path("C:/Games/Mine/Game/a.cf"), path), "a file of the folder is no link's");

		Ied::Workspace* ws = new Ied::Workspace();
		ws->m_Root = games;
		ws->m_LocalState = FS::Path("C:/Local/State");
		ws->m_Solution = solution;
		ws->m_Trusted = true;
		assert_true(ws->At(Core::StringView("@Engine/src/a.cf")).View() == FS::Path("D:/Claymore/Engine/src/a.cf").View(), "a trusted solution follows its links");
		assert_true(ws->At(Core::StringView("Game/a.cf")).View() == (games / "Game/a.cf").View(), "and the folder's own paths stay");
		assert_true(ws->PathOf(FS::Path("D:/Claymore/Engine/src/a.cf"), path) && path == "@Engine/src/a.cf", "and back");
		assert_true(ws->PathOf(FS::Path("C:/Games/Mine/Game/a.cf"), path) && path == "Game/a.cf", "a file of the folder");
		ws->m_Trusted = false;
		assert_true(ws->At(Core::StringView("@Engine/src/a.cf")).View() == (games / "@Engine/src/a.cf").View(), "an untrusted one reaches nothing outside");
		assert_true(!ws->PathOf(FS::Path("D:/Claymore/Engine/src/a.cf"), path), "nor names it");
	}

	[test("nearest_solution")]
	public static void TestNearestSolution() {
		FS::Path root = FS::TempDirectory() / "ied-nearest-solution-test";
		FS::RemoveAll(root.CStr());
		FS::MakeDirectories((root / "Projects" / "Valley" / "Game" / "Content").CStr());
		const char* text = "{}";
		FS::WriteFileAtomically((root / "Engine.iedsln").CStr(), (const void*)text, 2);
		assert_true(Ied::NearestSolution(root / "Projects" / "Valley" / "Game" / "Content").View().EndsWith(Core::StringView("Engine.iedsln")), "the engine's, with none nearer");
		FS::WriteFileAtomically((root / "Projects" / "Valley" / "Valley.iedsln").CStr(), (const void*)text, 2);
		assert_true(Ied::NearestSolution(root / "Projects" / "Valley" / "Game" / "Content").View().EndsWith(Core::StringView("Valley.iedsln")), "the project's own, nearer");
		assert_true(Ied::NearestSolution(root / "Projects").View().EndsWith(Core::StringView("Engine.iedsln")), "from beside it, the one above");
		FS::RemoveAll(root.CStr());
	}

	[test("solution_files")]
	public static void TestSolutionFiles() {
		assert_true(Ied::IsSolutionFile(Core::StringView("C:/Work/Game.iedsln")) && Ied::IsSolutionFile(Core::StringView("Game.IEDSLN")), "the name, in any case");
		assert_true(Ied::IsSolutionFile(Core::StringView("Game.ied.sln")), "the name before");
		assert_true(!Ied::IsSolutionFile(Core::StringView("Game.sln")), "Visual Studio's");
		assert_true(Ied::IsProjectFile(Core::StringView("build/ied/Game.iedproj")) && Ied::IsProjectFile(Core::StringView("Game.ied.proj")), "a project, either name");
		assert_true(!Ied::IsProjectFile(Core::StringView("Game.vcxproj")), "not another tool's");
		FS::Path root = FS::TempDirectory() / "ied-solution-files-test";
		FS::RemoveAll(root.CStr());
		FS::MakeDirectories((root / "none").CStr());
		FS::MakeDirectories((root / "one").CStr());
		FS::MakeDirectories((root / "two").CStr());
		const char* text = "{}";
		FS::WriteFileAtomically((root / "one" / "Game.iedsln").CStr(), (const void*)text, 2);
		FS::WriteFileAtomically((root / "one" / "README.md").CStr(), (const void*)text, 2);
		FS::WriteFileAtomically((root / "two" / "A.iedsln").CStr(), (const void*)text, 2);
		FS::WriteFileAtomically((root / "two" / "B.ied.sln").CStr(), (const void*)text, 2);
		assert_true(Ied::SolutionIn(root / "none").IsEmpty(), "no solution");
		assert_true(Ied::SolutionIn(root / "one").View().EndsWith(Core::StringView("Game.iedsln")), "the one solution");
		assert_true(Ied::SolutionIn(root / "two").IsEmpty(), "two: no choice made");
		FS::RemoveAll(root.CStr());
	}
}
