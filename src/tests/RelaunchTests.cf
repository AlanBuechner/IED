// host/relaunch: when a relaunch shows in the status, is claimed or comes due, and the arguments the server starts
// again with.

include "host/Relaunch.ch"
include "host/Config.ch"

static Core::Array<Core::String> Strings(const char* text) {
	Core::Array<Core::String> parts;
	Core::StringView rest = Core::StringView(text);
	while (!rest.IsEmpty()) {
		const int64 space = rest.IndexOf(' ', 0);
		parts.Push(Core::String(space < 0 ? rest : rest.Substring(0, space)));
		rest = space < 0 ? Core::StringView("") : rest.Substring(space + 1, rest.ByteLength() - space - 1);
	}
	return parts;
}

static Core::String Joined(const Core::Array<Core::String>& parts) {
	Core::StringBuilder text;
	for (int64 i = 0; i < parts.Count(); ++i) {
		if (i > 0) text.AppendByte(' ');
		text.Append(parts[i].View());
	}
	return text.ToString();
}

[test("server.relaunch")]
class RelaunchTests {
	[test("claimed")]
	public static void TestClaimed() {
		Ied::Relaunch relaunch;
		assert_true(relaunch.Ask(Core::StringView("installed"), 1000), "asked");
		assert_true(!relaunch.Ask(Core::StringView("again"), 1100), "one at a time");
		assert_true(!relaunch.Shown(1000 + Ied::c_RelaunchGraceMs - 1) && !relaunch.Claim(1500), "not shown while the asker's answer goes out");
		assert_true(relaunch.Shown(1000 + Ied::c_RelaunchGraceMs), "then the status shows it");
		assert_true(relaunch.Claim(1000 + Ied::c_RelaunchGraceMs + 10), "the desktop app takes it");
		assert_true(!relaunch.Shown(1000 + Ied::c_RelaunchGraceMs + 20) && !relaunch.Claim(1000 + Ied::c_RelaunchGraceMs + 20), "once");
		assert_true(!relaunch.Due(1000 + Ied::c_RelaunchGraceMs + Ied::c_RelaunchClaimMs + 1), "claimed: the app relaunches, not the server");
		assert_true(relaunch.Due(1000 + Ied::c_RelaunchGraceMs + 10 + Ied::c_RelaunchClaimedMs), "an app that never stopped the server: the server does it");
		assert_true(relaunch.Starting() && !relaunch.Due(1000 + Ied::c_RelaunchGraceMs + 20 + Ied::c_RelaunchClaimedMs), "due once");
	}

	[test("unclaimed")]
	public static void TestUnclaimed() {
		Ied::Relaunch relaunch;
		assert_true(!relaunch.Due(1 << 30), "nothing asked, nothing due");
		relaunch.Ask(Core::StringView("installed"), 0);
		assert_true(!relaunch.Due(Ied::c_RelaunchGraceMs + Ied::c_RelaunchClaimMs - 1), "the app gets its time to claim it");
		assert_true(relaunch.Due(Ied::c_RelaunchGraceMs + Ied::c_RelaunchClaimMs), "no app watches: the server relaunches itself");
		assert_true(!relaunch.Claim(Ied::c_RelaunchGraceMs + Ied::c_RelaunchClaimMs + 1), "too late to claim");
	}

	[test("arguments")]
	public static void TestArguments() {
		Core::Array<Core::String> paths;
		paths.Push(Core::String("C:\\Game\\Game.iedsln"));
		paths.Push(Core::String("C:\\Tools"));
		Core::Array<Core::String> given = Strings("--static C:\\IED\\frontend --workspace C:\\Old --port 9000 --control ied-x --relaunched --quiet");
		assert_se("--static C:\\IED\\frontend --control ied-x --quiet --port 8766 --relaunched --workspace C:\\Game\\Game.iedsln --workspace C:\\Tools",
			Joined(Ied::RelaunchArguments(given, 8766, paths)).CStr(), "the same options, its port, and the owner's workspaces");
		Ied::ServerConfig config = Ied::DefaultConfig();
		Core::String error;
		assert_true(Ied::ParseArguments(Ied::RelaunchArguments(given, 8766, paths), config, error), error.CStr());
		assert_true(config.m_Relaunched && config.m_PortGiven && config.m_Port == 8766 && config.m_Workspaces.Count() == 2, "what the relaunched server reads");
		assert_true(config.m_Arguments.Count() == 12, "and keeps for the next relaunch");
	}
}
