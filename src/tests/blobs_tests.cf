// services/blobs: uploads kept by id, the oldest dropped past the limit.

include "services/blobs.ch"

static Core::Array<uint8> BlobBytes(int64 count, uint8 value) {
	Core::Array<uint8> bytes;
	for (int64 i = 0; i < count; ++i) bytes.Push(value);
	return bytes;
}

[test("server.blobs")]
class BlobsTests {
	[test("kept_by_id")]
	public static void TestKept() {
		Ied::Blobs* blobs = new Ied::Blobs();
		Core::String id = blobs->Put(Core::StringView("image/png"), BlobBytes(3, 7));
		Ied::Blob* blob = blobs->Get(id.View());
		assert_true(blob && blob->contentType.View() == "image/png" && blob->bytes.Count() == 3 && blob->bytes[2] == 7, "its type and bytes");
		assert_true(!blobs->Get(Core::StringView("b-0000000000000000")), "no such id");
	}

	[test("oldest_dropped_past_the_limit")]
	public static void TestLimit() {
		Ied::Blobs* blobs = new Ied::Blobs(10);
		Core::String first = blobs->Put(Core::StringView("a/b"), BlobBytes(4, 1));
		Core::String second = blobs->Put(Core::StringView("a/b"), BlobBytes(4, 2));
		assert_eq((int64)8, blobs->KeptBytes(), "both fit");
		Core::String third = blobs->Put(Core::StringView("a/b"), BlobBytes(4, 3));
		assert_true(!blobs->Get(first.View()) && blobs->Get(second.View()) && blobs->Get(third.View()), "the oldest made room");
		assert_eq((int64)8, blobs->KeptBytes(), "within the limit");
		Core::String large = blobs->Put(Core::StringView("a/b"), BlobBytes(12, 4));
		assert_true(blobs->Get(large.View()) && !blobs->Get(second.View()) && !blobs->Get(third.View()), "one over the limit alone is still kept, the rest dropped");
		assert_eq((int64)12, blobs->KeptBytes(), "only it");
	}
}
