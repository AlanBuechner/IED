// dap/usage: a debugged program's share of the processors, its samples kept to the last ones, and how they are written.

include "dap/Usage.ch"

static Ied::UsageSample Sample(int64 ms, int64 cpuTenths, int64 privateBytes, int64 workingSetBytes) {
	Ied::UsageSample sample;
	sample.m_Ms = ms;
	sample.m_CpuTenths = cpuTenths;
	sample.m_PrivateBytes = privateBytes;
	sample.m_WorkingSetBytes = workingSetBytes;
	return sample;
}

[test("server.usage")]
class UsageUnitTests {
	[test("cpu_share")]
	public static void TestCpuShare() {
		assert_eq((int64)250, Ied::CpuTenths((int64)500000000, (int64)500000000, 4), "a whole processor of four: 25.0 %");
		assert_eq((int64)1000, Ied::CpuTenths((int64)2000000000, (int64)500000000, 4), "all of them");
		assert_eq((int64)1000, Ied::CpuTenths((int64)9000000000, (int64)500000000, 4), "never more than all");
		assert_eq((int64)0, Ied::CpuTenths((int64)0, (int64)500000000, 4), "idle");
		assert_eq((int64)0, Ied::CpuTenths((int64)500000000, (int64)0, 4), "no time passed");
	}

	[test("kept_and_written")]
	public static void TestKeptAndWritten() {
		Ied::ProgramUsage usage;
		usage.m_ProcessId = (uint32)4242;
		usage.m_Name = Core::String("demo.exe");
		for (int64 i = 0; i < Ied::c_UsageSamplesKept + 5; ++i) usage.Add(Sample(i * Ied::c_UsageIntervalMs, 5, 1024, 2048));
		assert_eq(Ied::c_UsageSamplesKept, usage.m_Samples.Count(), "the last ones kept");
		assert_eq((int64)5 * Ied::c_UsageIntervalMs, usage.m_Samples[0].m_Ms, "the oldest dropped");
		assert_se("{\"processId\":4242,\"name\":\"demo.exe\",\"sample\":[1500,12.5,1048576,2097152]}", usage.EventJson(Sample(1500, 125, 1048576, 2097152)).CStr(), "an event");
		Ied::ProgramUsage one;
		one.m_ProcessId = (uint32)7;
		one.m_Name = Core::String("a.exe");
		one.Add(Sample(500, 3, 10, 20));
		assert_se("{\"processId\":7,\"name\":\"a.exe\",\"samples\":[[500,0.3,10,20]]}", one.Json().CStr(), "a snapshot");
	}
}
