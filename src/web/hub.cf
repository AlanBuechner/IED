include "hub.ch"
include "session.ch"

namespace Ied
{
	const int64 kMegabyte = 1048576;

	Core::StringView TopicKind(Core::StringView key) {
		int64 start = 0;
		for (int64 i = 0; i < key.ByteLength(); ++i)
			if (key.ByteAt(i) == '/') start = i + 1;
		int64 end = start;
		while (end < key.ByteLength() && key.ByteAt(end) != ':') end += 1;
		return key.Substring(start, end - start);
	}

	static bool IsCoalescibleKind(Core::StringView kind) { return kind == "out" || kind == "run" || kind == "term" || kind == "chat"; }

	TopicLimits Hub::DefaultLimits(Core::StringView key) {
		Core::StringView kind = TopicKind(key);
		TopicLimits limits;
		limits.events = 2000;
		limits.bytes = 4 * kMegabyte;
		if (kind == "chat") { limits.events = 20000; limits.bytes = 8 * kMegabyte; }
		if (kind == "run") { limits.events = 50000; limits.bytes = 16 * kMegabyte; }
		if (kind == "term") { limits.events = 1000000; limits.bytes = 5 * kMegabyte; }
		limits.coalescible = IsCoalescibleKind(kind);
		return limits;
	}

	Core::String MergeData(const Merge& merge) {
		Core::StringBuilder data;
		data.AppendByte('{');
		data.Append(merge.rest.View());
		if (!merge.rest.IsEmpty()) data.AppendByte(',');
		Serialization::WriteJsonString(merge.field.View(), &data);
		data.AppendByte(':');
		Serialization::WriteJsonString(merge.text.View(), &data);
		data.AppendByte('}');
		return data.ToString();
	}

	Core::String EventFrame(Core::StringView topic, int64 seq, Core::StringView kind, Core::StringView data) {
		JsonWriter json;
		json.BeginObject();
		json.Field("t", "evt");
		json.Field("topic", topic);
		json.IntField("seq", seq);
		json.Field("kind", kind);
		json.RawField("data", data);
		json.EndObject();
		return json.ToString();
	}

	// --- Topic -------------------------------------------------------------------------------------------------------

	int64 Topic::ReplayBytes(int64 cursor) const {
		int64 total = 0;
		for (Event* event : ring)
			if (event->seq > cursor) total += event->bytes;
		return total;
	}

	Core::Array<Event*> Topic::EventsAfter(int64 cursor) const {
		Core::Array<Event*> after;
		for (Event* event : ring)
			if (event->seq > cursor) after.Push(event);
		return after;
	}

	Core::String Topic::SnapshotFrame() const {
		Core::String data = snapshot();
		JsonWriter json;
		json.BeginObject();
		json.Field("t", "snap");
		json.Field("topic", key.View());
		json.IntField("seq", seq);
		json.RawField("data", data.View());
		json.EndObject();
		return json.ToString();
	}

	void Topic::Append(Event* event) {
		seq = event->seq;
		ring.Push(event);
		ringBytes += event->bytes;
		while (!ring.IsEmpty() && (ring.Count() > limits.events || ringBytes > limits.bytes)) ringBytes -= ring.Pop()->bytes;
	}

	void Topic::ClearRing() {
		ring.Clear();
		ringBytes = 0;
	}

	void Topic::Subscribe(Session* session) {
		for (int64 i = 0; i < subscribers.Count(); ++i)
			if (subscribers[i] == session) return;
		subscribers.Push(session);
	}

	void Topic::Unsubscribe(Session* session) {
		for (int64 i = 0; i < subscribers.Count(); ++i)
			if (subscribers[i] == session) { subscribers.RemoveAt(i); return; }
	}

	// --- Hub ---------------------------------------------------------------------------------------------------------

	Topic* Hub::Add(Core::StringView key, Snapshot snapshot, TopicLimits limits) {
		Core::String name = Core::String(key);
		if (topics.Contains(name)) return nullptr;
		Topic* topic = new Topic();
		topic->key = name;
		topic->snapshot = snapshot;
		topic->limits = limits;
		topics.Insert(name, topic);
		return topic;
	}

	Topic* Hub::Find(Core::StringView key) const {
		Topic* found = nullptr;
		topics.TryGet(Core::String(key), found);
		return found;
	}

	int64 Hub::Deliver(Topic* topic, Event* event) {
		topic->Append(event);
		Core::Array<Session*> subscribers = topic->subscribers;
		for (int64 i = 0; i < subscribers.Count(); ++i) subscribers[i]->Deliver(topic, event);
		return event->seq;
	}

	int64 Hub::Publish(Core::StringView key, const char* kind, Core::StringView data) {
		Topic* topic = Find(key);
		if (!topic) return 0;
		Event* event = new Event();
		event->seq = topic->seq + 1;
		event->kind = Core::String(kind);
		event->text = EventFrame(key, event->seq, event->kind.View(), data);
		event->bytes = event->text.ByteLength();
		return Deliver(topic, event);
	}

	int64 Hub::PublishMergeable(Core::StringView key, const char* kind, const Merge& merge) {
		Topic* topic = Find(key);
		if (!topic) return 0;
		Core::String data = MergeData(merge);
		Event* event = new Event();
		event->seq = topic->seq + 1;
		event->kind = Core::String(kind);
		event->text = EventFrame(key, event->seq, event->kind.View(), data.View());
		event->bytes = event->text.ByteLength();
		event->mergeable = topic->limits.coalescible;
		event->merge = merge;
		return Deliver(topic, event);
	}

	void Hub::Remove(Core::StringView key) {
		Topic* topic = Find(key);
		if (!topic) return;
		Core::Array<Session*> subscribers = topic->subscribers;
		for (int64 i = 0; i < subscribers.Count(); ++i) subscribers[i]->Forget(topic->key.View());
		topics.Remove(Core::String(key));
	}

	void Hub::ClearRings() {
		for (KeyValue<Core::String, Topic*>& entry : topics) entry.value->ClearRing();
	}
}
