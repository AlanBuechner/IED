include "rpc.ch"
include "session.ch"
include "host/server.ch"

namespace Ied
{
	Outcome Failure(const RpcError& error) {
		Outcome outcome;
		outcome.json = error.ToJson();
		return outcome;
	}

	Outcome Success(Core::StringView json) {
		Outcome outcome;
		outcome.ok = true;
		outcome.json = Core::String(json);
		return outcome;
	}

	Core::StringView Call::ClientId() const { return session->clientId.View(); }

	void Call::Sleep(int64 ms) {
		const int64 deadline = clock_now_ns() + ms * 1000000;
		for (int64 left = ms * 1000000; left > 0 && !cancel->IsCancelled(); left = deadline - clock_now_ns())
			cancel->wake.WaitFor(server->lock, left);
		if (cancel->IsCancelled()) throw RpcError(ErrorCode::Cancelled, "request cancelled");
	}

	void Call::OpenStream(CancelToken* token) { session->streams.Insert(requestId, token); }

	Core::Array<Core::String> Rpc::Names() const {
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, Method>& entry : methods) names.Push(entry.key);
		names.Sort();
		return names;
	}

	Outcome Rpc::Invoke(Call& call, Core::StringView method, const Params& params) {
		Method* found = methods.Find(Core::String(method));
		if (!found) {
			JsonWriter data;
			data.BeginObject();
			data.Field("method", method);
			data.EndObject();
			Core::StringBuilder message;
			message.Append("unknown method '");
			message.Append(method);
			message.Append("'");
			return Failure(RpcError(ErrorCode::NotFound, message.View(), data.View()));
		}
		try {
			return Success((*found)(call, params).View());
		}
		catch (RpcError& error) {
			return Failure(error);
		}
		catch (...) {
			return Failure(RpcError(ErrorCode::Internal, "the method failed"));
		}
	}

	void Rpc::ExpireOps(int64 nowNs) {
		Core::Array<Core::String> expired;
		for (const Core::KeyValue<Core::String, OpEntry*>& entry : ops)
			if (entry.value->done && nowNs - entry.value->createdNs > kOpLifetimeNs) expired.Push(entry.key);
		for (int64 i = 0; i < expired.Count(); ++i) ops.Remove(expired[i]);
	}

	// A duplicate of a request still running waits for it (the server lock is released meanwhile).
	Outcome Rpc::RunOnce(Call& call, Core::StringView method, const Params& params) {
		const int64 now = clock_now_ns();
		ExpireOps(now);
		Core::StringBuilder key;
		key.Append(call.ClientId());
		key.AppendByte(' ');
		key.Append(call.opId.View());
		Core::String name = key.ToString();
		OpEntry** existing = ops.Find(name);
		if (existing) {
			OpEntry* entry = *existing;
			if (entry->method.View() != method) {
				Core::StringBuilder message;
				message.Append("opId '");
				message.Append(call.opId.View());
				message.Append("' was already used for ");
				message.Append(entry->method.View());
				return Failure(RpcError(ErrorCode::BadRequest, message.View()));
			}
			while (!entry->done) call.server->changed.Wait(call.server->lock);
			return entry->outcome;
		}
		OpEntry* entry = new OpEntry();
		entry->method = Core::String(method);
		entry->createdNs = now;
		ops.Insert(name, entry);
		entry->outcome = Invoke(call, method, params);
		entry->done = true;
		call.server->changed.NotifyAll();
		return entry->outcome;
	}

	Outcome Rpc::Run(Call& call, Core::StringView method, const Params& params) {
		if (call.opId.IsEmpty()) return Invoke(call, method, params);
		return RunOnce(call, method, params);
	}
}
