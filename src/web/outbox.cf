include "outbox.ch"

namespace Ied
{
	void Outbox::Append(OutItem* item) {
		items.Push(item);
		bytes += item->bytes;
		if (!item->topic.IsEmpty()) topicBytes.At(item->topic) += item->bytes;
		ready.NotifyOne();
	}

	void Outbox::PushControl(Core::StringView text) {
		Threading::LockGuard guard(mutex);
		if (closed) return;
		OutItem* item = new OutItem();
		item->text = Core::String(text);
		item->bytes = text.ByteLength();
		Append(item);
	}

	Gap Outbox::PushEvent(Core::StringView topic, const Event* event) {
		Threading::LockGuard guard(mutex);
		if (closed) return Gap();
		if (event->mergeable && bytes >= coalesceBytes && MergeIntoTail(topic, event)) return EnforceBudget();
		OutItem* item = new OutItem();
		item->text = event->text;
		item->bytes = event->bytes;
		item->topic = Core::String(topic);
		item->firstSeq = event->seq;
		item->seq = event->seq;
		item->kind = event->kind;
		item->mergeable = event->mergeable;
		item->merge = event->merge;
		Append(item);
		return EnforceBudget();
	}

	bool Outbox::MergeIntoTail(Core::StringView topic, const Event* event) {
		if (items.IsEmpty()) return false;
		OutItem* tail = items.Back();
		if (!tail->mergeable || tail->topic.View() != topic || tail->kind.View() != event->kind.View()) return false;
		if (tail->bytes + event->bytes > kMaxMergedBytes) return false;
		if (tail->merge.field.View() != event->merge.field.View() || tail->merge.rest.View() != event->merge.rest.View()) return false;
		tail->merge.text.Append(event->merge.text.View());
		Core::String data = MergeData(tail->merge);
		Core::String text = EventFrame(topic, event->seq, event->kind.View(), data.View());
		const int64 grown = text.ByteLength() - tail->bytes;
		bytes += grown;
		topicBytes.At(tail->topic) += grown;
		tail->text = take(text);
		tail->bytes += grown;
		tail->seq = event->seq;
		return true;
	}

	Core::StringView Outbox::Heaviest() const {
		Core::StringView heaviest;
		int64 most = -1;
		for (const Core::KeyValue<Core::String, int64>& entry : topicBytes)
			if (entry.value > most) { most = entry.value; heaviest = entry.key.View(); }
		return heaviest;
	}

	Gap Outbox::EnforceBudget() {
		Gap gap;
		if (bytes <= budget || topicBytes.IsEmpty()) return gap;
		gap.topic = Core::String(Heaviest());
		gap.first = -1;
		for (OutItem* item : items) {
			if (item->topic.View() != gap.topic.View()) continue;
			if (gap.first < 0) gap.first = item->firstSeq;
			gap.last = item->seq;
		}
		gap.dropped = true;
		Remove(gap.topic.View());
		return gap;
	}

	void Outbox::Remove(Core::StringView topic) {
		Core::Queue<OutItem*> kept;
		for (OutItem* item : items) {
			if (item->topic.View() == topic) bytes -= item->bytes;
			else kept.Push(item);
		}
		items = take(kept);
		topicBytes.Remove(Core::String(topic));
	}

	void Outbox::DropTopic(Core::StringView topic) {
		Threading::LockGuard guard(mutex);
		if (topicBytes.Contains(Core::String(topic))) Remove(topic);
	}

	bool Outbox::Next(Core::String& text, int32 timeoutMs) {
		Threading::LockGuard guard(mutex);
		if (items.IsEmpty() && !closed) ready.WaitFor(mutex, (int64)timeoutMs * 1000000);
		if (closed || items.IsEmpty()) return false;
		OutItem* item = items.Pop();
		bytes -= item->bytes;
		if (!item->topic.IsEmpty()) {
			int64* held = topicBytes.Find(item->topic);
			if (held) {
				*held -= item->bytes;
				if (*held <= 0) topicBytes.Remove(item->topic);
			}
		}
		text = take(item->text);
		return true;
	}

	void Outbox::Close() {
		Threading::LockGuard guard(mutex);
		closed = true;
		items.Clear();
		topicBytes.Clear();
		bytes = 0;
		ready.NotifyAll();
	}

	bool Outbox::IsEmpty() {
		Threading::LockGuard guard(mutex);
		return items.IsEmpty();
	}

	bool Outbox::IsClosed() {
		Threading::LockGuard guard(mutex);
		return closed;
	}

	int64 Outbox::Bytes() {
		Threading::LockGuard guard(mutex);
		return bytes;
	}

	int64 Outbox::Budget() {
		Threading::LockGuard guard(mutex);
		return budget;
	}

	int64 Outbox::CoalesceBytes() {
		Threading::LockGuard guard(mutex);
		return coalesceBytes;
	}

	void Outbox::Configure(int64 budget, int64 coalesceBytes) {
		Threading::LockGuard guard(mutex);
		this.budget = budget;
		this.coalesceBytes = coalesceBytes;
	}
}
