include "proxy.ch"
include "host/server.ch"

namespace Ied
{
	const int32 kUpstreamConnectMs = 5000;
	const int32 kFetchMs = 120000;
	const int32 kPumpSliceMs = 1000;
	const int64 kTunnelPingNs = 20000000000;

	bool WorkspaceRoute(Core::StringView path, Core::StringView& wsId, Core::StringView& rest) {
		if (!path.StartsWith(Core::StringView("/w/"))) return false;
		const int64 slash = path.IndexOf('/', 3);
		if (slash <= 3) return false;
		wsId = path.Substring(3, slash - 3);
		rest = path.Substring(slash, path.ByteLength() - slash);
		return true;
	}

	Core::String UpstreamTarget(Core::StringView path, Core::StringView rest, Core::StringView query) {
		const bool own = rest == "/ws" || rest.StartsWith(Core::StringView("/api/"));
		Core::String target = Core::String(own ? rest : path);
		if (!query.IsEmpty()) target = (target + "?") + query;
		return target;
	}

	Core::StringView ServingWorkspace(Core::StringView wsId) {
		const int64 dot = wsId.IndexOf('.', 0);
		return dot < 0 ? wsId : wsId.Substring(0, dot);
	}

	int32 TunnelCloseCode(int32 code) {
		if (code == 1000 || code == 1001 || code == 1002 || code == 1003 || code == 1007 || code == 1008 || code == 1011 || code == 1012) return code;
		return 1012;
	}

	static void Refuse(Http::Response& response, int32 status, const char* error, Core::StringView message) {
		JsonWriter json;
		json.BeginObject();
		json.Field("error", error);
		json.Field("message", message);
		json.EndObject();
		AnswerJson(response, status, json.View());
	}

	void Proxy::Forward(const Http::Request& request, Http::Response& response, Core::StringView wsId, Device* device) {
		Core::StringView named;
		Core::StringView rest;
		WorkspaceRoute(request.path.View(), named, rest);
		Core::StringView serving = ServingWorkspace(wsId);
		{
			Threading::LockGuard guard(server->lock);
			if (!server->workspaces->Listed(serving)) {
				Refuse(response, 404, "not-found", (Core::String("no workspace ") + wsId + " is open").View());
				return;
			}
		}
		int32 port = 0;
		Core::String secret;
		if (!server->servers->AwaitReady(serving, kServerAwaitMs, port, secret)) {
			Refuse(response, 503, "unavailable", (Core::String("the server of workspace ") + serving + " is not running: it is starting, restarting or failed").View());
			return;
		}
		if (rest == "/ws") WebSocket(request, response, wsId, port, secret.View(), device);
		else Fetch(request, response, UpstreamTarget(request.path.View(), rest, request.query.View()).View(), port, secret.View(), device);
	}

	static bool HopHeader(Core::StringView name) {
		const char*[9] skipped = { "Host", "Cookie", "Connection", "Upgrade", "Accept-Encoding", "Content-Length", "Transfer-Encoding", "X-IED-Secret", "X-IED-Device" };
		for (int32 i = 0; i < 9; ++i)
			if (Http::EqualsIgnoringCase(name, Core::StringView(skipped[i]))) return true;
		return false;
	}

	void Proxy::Fetch(const Http::Request& request, Http::Response& response, Core::StringView target, int32 port, Core::StringView secret, Device* device) {
		Http::Request upstream;
		upstream.method = request.method;
		upstream.target = Core::String(target);
		for (int64 i = 0; i < request.headers.Count(); ++i) {
			const Http::Header& header = request.headers.At(i);
			if (!HopHeader(header.name.View())) upstream.headers.Add(header.name.View(), header.value.View());
		}
		upstream.headers.Set(Core::StringView("X-IED-Secret"), secret);
		upstream.headers.Set(Core::StringView("X-IED-Device"), device->id.View());
		upstream.body = request.body;
		Http::FetchResult got = Http::Fetch(Net::Address::Loopback(port), upstream, kFetchMs);
		if (!got.ok) {
			Refuse(response, 502, "unavailable", (Core::String("the workspace server did not answer: ") + got.error.View()).View());
			return;
		}
		response.status = got.response.status;
		for (int64 i = 0; i < got.response.headers.Count(); ++i) {
			const Http::Header& header = got.response.headers.At(i);
			if (!HopHeader(header.name.View()) && !Http::EqualsIgnoringCase(header.name.View(), Core::StringView("Content-Encoding"))) response.headers.Add(header.name.View(), header.value.View());
		}
		response.body = got.response.body;
	}

	static Core::String UpstreamUrl(int32 port, Core::StringView secret, Core::StringView deviceId) {
		Core::StringBuilder url;
		url.Append("ws://127.0.0.1:");
		url.AppendInt(port);
		url.Append("/ws?secret=");
		url.Append(secret);
		url.Append("&device=");
		url.Append(deviceId);
		return url.ToString();
	}

	void Proxy::WebSocket(const Http::Request& request, Http::Response& response, Core::StringView wsId, int32 port, Core::StringView secret, Device* device) {
		if (!Http::IsWebSocketRequest(request)) {
			Refuse(response, 400, "bad-request", Core::StringView("/w/<wsId>/ws is a WebSocket"));
			return;
		}
		Upstream* upstream = new Upstream();
		upstream->socket = Http::WebSocket::Connect(UpstreamUrl(port, secret, device->id.View()).View(), kUpstreamConnectMs);
		if (!upstream->socket.IsOpen()) {
			Refuse(response, 503, "unavailable", (Core::String("the workspace server's socket did not open: ") + upstream->socket.Error()).View());
			return;
		}
		Tunnel* tunnel = new Tunnel();
		tunnel->wsId = Core::String(wsId);
		tunnel->deviceId = device->id;
		tunnel->upstream = upstream;
		Proxy* self = this;
		const bool accepted = Http::AcceptWebSocket(request, response, [self, tunnel](Http::WebSocket& socket) {
			tunnel->client = &socket;
			self->Add(tunnel);
			self->Pump(tunnel);
			self->Remove(tunnel);
		});
		if (!accepted) upstream->socket.Close(1001, Core::StringView("the browser's upgrade was refused"));
	}

	// On the browser's connection thread: its messages to the workspace server, while a thread of its own sends the
	// workspace server's to the browser; when one side ends, the other is closed.
	void Proxy::Pump(Tunnel* tunnel) {
		Http::WebSocket* client = tunnel->client;
		Upstream* upstream = tunnel->upstream;
		Threading::Thread back = Threading::Thread::Run([client, upstream]() {
			Http::WebSocketMessage message;
			for (;;) {
				if (!upstream->socket.Receive(message, kPumpSliceMs)) {
					if (upstream->socket.TimedOut()) continue;
					break;
				}
				const bool sent = message.kind == Http::MessageKind::Text ? client->SendText(message.Text()) : client->SendBinary((const void*)message.data.Data(), message.data.Count());
				if (!sent) break;
			}
			if (client->IsOpen()) client->Close(TunnelCloseCode(upstream->socket.CloseCode()), Core::StringView(upstream->socket.CloseReason()));
		});
		Http::WebSocketMessage message;
		int64 pinged = clock_now_ns();
		for (;;) {
			if (!client->Receive(message, kPumpSliceMs)) {
				if (!client->TimedOut()) break;
			}
			else {
				const bool sent = message.kind == Http::MessageKind::Text ? upstream->socket.SendText(message.Text()) : upstream->socket.SendBinary((const void*)message.data.Data(), message.data.Count());
				if (!sent) break;
			}
			if (!upstream->socket.IsOpen()) break;
			if (clock_now_ns() - pinged > kTunnelPingNs) {
				client->Ping(Core::StringView("ied"));
				pinged = clock_now_ns();
			}
		}
		if (upstream->socket.IsOpen()) upstream->socket.Close(1001, Core::StringView("the browser left"));
		back.Join();
	}

	void Proxy::Add(Tunnel* tunnel) {
		Threading::LockGuard guard(lock);
		tunnels.Push(tunnel);
	}

	void Proxy::Remove(Tunnel* tunnel) {
		Threading::LockGuard guard(lock);
		for (int64 i = 0; i < tunnels.Count(); ++i)
			if (tunnels[i] == tunnel) {
				tunnels.RemoveAt(i);
				return;
			}
	}

	int64 Proxy::Count() {
		Threading::LockGuard guard(lock);
		return tunnels.Count();
	}

	void Proxy::Revoke(Core::StringView deviceId) {
		Core::Array<Tunnel*> closing;
		{
			Threading::LockGuard guard(lock);
			for (Tunnel* tunnel : tunnels)
				if (tunnel->deviceId.View() == deviceId) closing.Push(tunnel);
		}
		for (Tunnel* tunnel : closing) {
			tunnel->client->SendText(ByeFrame("auth-revoked").View());
			tunnel->client->Close(1008, Core::StringView("auth-revoked"));
			tunnel->upstream->socket.Close(1001, Core::StringView("auth-revoked"));
		}
	}
}
