// ied-server: the IED server (docs/01). Its first line on stdout is "LISTENING http://<host>:<port>", its second
// "OPEN http://<host>:<port>/?t=<token>": a launch token that signs a browser in once, within a minute (docs/11).

include "host/server.ch"
include "host/control.ch"
include "web/front.ch"
include "programs.ch"

static Core::Array<Core::String> Arguments(int32 argc, char8** argv) {
	Core::Array<Core::String> arguments;
	for (int32 i = 1; i < argc; ++i) arguments.Push(Core::String((const char*)argv[i]));
	return arguments;
}

static Net::Address BindAddress(const Ied::ServerConfig& config) {
	if (config.host.View() == "localhost") return Net::Address::Loopback(config.port);
	Core::StringBuilder text;
	const bool v6 = config.host.View().IndexOf(':', 0) >= 0;
	if (v6) text.AppendByte('[');
	text.Append(config.host.View());
	if (v6) text.AppendByte(']');
	text.AppendByte(':');
	text.AppendInt(config.port);
	return Net::ParseAddress(text.CStr());
}

static void Fail(Core::StringView why) {
	Core::StringBuilder text;
	text.Append("ied-server: ");
	text.Append(why);
	text.AppendByte('\n');
	Platform::WriteError(text.View());
}

// The same, kept in logs/server.log too: the server exists, so it has a log.
static void Fail(Ied::Server* server, Core::StringView why) {
	server->logFile.Write((Core::String("not started: ") + why).View());
	Fail(why);
}

static void Announce(const char* what, Core::StringView url) {
	Core::StringBuilder line;
	line.Append(what);
	line.AppendByte(' ');
	line.Append(url);
	line.AppendByte('\n');
	Platform::WriteOutput(line.View());
}

// Loads the server's state; false, having said why, when it cannot run. Sign-in is the master's alone (docs/11).
static bool Prepare(Ied::Server* server, const Net::Address& at) {
	Core::String error;
	Threading::LockGuard guard(server->lock);
	if (!server->IsMaster()) {
		server->plugins->Load();
		return true;
	}
	if (!server->auth->Load(error)) {
		Fail(server, error.View());
		return false;
	}
	if (!at.IsLoopback() && !server->auth->HasPassword()) {
		Fail(server, Core::StringView("listening beyond this machine needs an owner password: set one from a loopback session first (docs/11)"));
		return false;
	}
	server->plugins->Load();
	server->auth->Record("start", (Core::String("\"address\":") + Ied::JsonString(at.ToString().View()).View()).View());
	return true;
}

// A relaunched server waits (kRelaunchedWaitMs) for the one before it to let go of the pipe and the port.
// So does a workspace server, whose pipe the server it replaces (a restart, a relaunch) may hold a moment longer.
static bool Retrying(const Ied::ServerConfig& config, int64 started) {
	const bool waits = config.relaunched || Ied::IsWorkspaceServer(config);
	if (!waits || clock_now_ns() - started > Ied::kRelaunchedWaitMs * 1000000) return false;
	Threading::Thread::Sleep(250000000);
	return true;
}

static bool ClaimPipe(Ied::Control* control, const Ied::ServerConfig& config, Core::String& error) {
	const int64 started = clock_now_ns();
	while (!control->Listen(Ied::ControlName(config).View(), error))
		if (!Retrying(config, started)) return false;
	return true;
}

// The port asked for; else any (a relaunched server's port is its old one, which it may not get back).
static bool ListenHttp(Http::Server* http, const Net::Address& at, const Ied::ServerConfig& config) {
	const int64 started = clock_now_ns();
	while (!http->Listen(at))
		if (!Retrying(config, started)) return (!config.portGiven || config.relaunched) && http->Listen(at.WithPort(0));
	return true;
}

// Once a relaunch no desktop app took has stopped the server (host/relaunch.ch): its program again.
static void StartRelaunched(Ied::Server* server) {
	Core::Array<Core::String> arguments;
	{
		Threading::LockGuard guard(server->lock);
		if (!server->relaunch.Starting()) return;
		arguments = Ied::RelaunchArguments(server->config.arguments, server->port, server->workspaces->OwnerPaths());
	}
	Core::String problem;
	if (Ied::StartAgain(arguments, problem)) server->logFile.Write(Core::StringView("relaunch: started again"));
	else server->logFile.Write((Core::String("relaunch: could not start again: ") + problem.View()).View());
}

static Core::String LaunchToken(Ied::Server* server) {
	Threading::LockGuard guard(server->lock);
	return server->auth->MintLaunchToken(Ied::kLaunchTokenMs);
}

// The listening URL without the trailing '/' (the first line's form).
static Core::String ListeningUrl(const Ied::ServerConfig& config, int32 port) {
	Core::String url = Ied::LaunchUrl(config, port, Core::StringView(""), Core::StringView(""));
	return Core::String(url.View().Substring(0, url.View().ByteLength() - 1));
}

// A workspace server's secret, out of its environment before anything it starts could inherit it (docs/11
// "Workspace servers").
static bool TakeSecret(Ied::ServerConfig& config) {
	if (!Ied::IsWorkspaceServer(config)) return true;
	config.secret = Platform::GetEnvironmentVariable("IED_SERVER_SECRET");
	Platform::RemoveEnvironmentVariable("IED_SERVER_SECRET");
	return config.secret.ByteLength() == 64;
}

// A workspace server ends when its master is gone: it runs in the master's job, so this is for a master that left
// without ending it.
static void WatchMaster(Ied::Server* server, Ied::Control* control) {
	if (server->IsMaster()) return;
	Core::String master = server->config.masterControl;
	Threading::Thread::Run([master, control]() {
		for (;;) {
			Threading::Thread::Sleep(2000000000);
			if (Launch::ServerGone(master.View())) {
				control->StopFor(Core::StringView("stopped: its master server is gone"));
				return;
			}
		}
	}).Detach();
}

// The master's plugin code registers the methods and topics of its routes (docs/10 "Routing") as it starts: it opens
// its port once that is done (at most kRoutesSettleMs), so its first client's routes are whole.
static void AwaitRoutes(Ied::Server* server) {
	if (!server->IsMaster()) return;
	const int64 deadline = clock_now_ns() + Ied::kRoutesSettleMs * 1000000;
	for (;;) {
		{
			Threading::LockGuard guard(server->lock);
			if (!server->code->Starting()) return;
		}
		if (clock_now_ns() > deadline) return;
		Threading::Thread::Sleep(20000000);
	}
}

static void AnnounceStart(Ied::Server* server) {
	if (!server->IsMaster()) return;
	Announce("LISTENING", ListeningUrl(server->config, server->port).View());
	Announce("OPEN", Ied::LaunchUrl(server->config, server->port, LaunchToken(server).View(), Core::StringView("")).View());
}

int32 main(int32 argc, char8** argv) {
	Ied::ServerConfig config = Ied::DefaultConfig();
	Core::String error;
	if (!Ied::ParseArguments(Arguments(argc, argv), config, error)) {
		Fail(error.View());
		return 2;
	}
	if (!TakeSecret(config)) {
		Fail(Core::StringView("a workspace server is started by its master, which gives it its secret (docs/11)"));
		return 2;
	}
	Net::Address at = BindAddress(config);
	if (!at.IsValid()) {
		Fail(Core::StringView("--host is not an address"));
		return 2;
	}
	Http::Server* http = new Http::Server();
	Ied::Server* server = new Ied::Server(config);
	Platform::SetCrashLog(server->logFile.File().View());
	Ied::Control* control = new Ied::Control(server, [http]() { http->Stop(); });
	if (!ClaimPipe(control, config, error)) {
		Fail(server, (Core::String("another ied-server runs for this user (") + error.View() + "); `ied status` tells which").View());
		return Launch::kAnotherServerExit;
	}
	if (!Prepare(server, at)) return 2;
	AwaitRoutes(server);
	Ied::Front* front = new Ied::Front(server);
	if (!ListenHttp(http, at, config)) {
		Fail(server, Core::StringView(http->Error()));
		return 1;
	}
	server->port = http->LocalAddress().port;
	if (!server->appWatch.Start(server, error)) server->Log((Core::String("app data is not watched: ") + error.View()).View());
	control->Start();
	if (server->IsMaster()) {
		Threading::LockGuard guard(server->lock);
		server->servers->Begin();
	}
	AnnounceStart(server);
	server->logFile.Write((Core::String("listening: ") + ListeningUrl(config, server->port).View()).View());
	WatchMaster(server, control);
	http->Serve([front](const Http::Request& request, Http::Response& response) { front->Handle(request, response); });
	server->logFile.Write(Core::StringView("exit: the HTTP server stopped"));
	if (server->IsMaster()) StartRelaunched(server);
	return 0;
}
