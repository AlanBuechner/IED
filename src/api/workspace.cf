include "workspace.ch"
include "host/server.ch"
include "fs/search.ch"
include "fs/glob.ch"

namespace IED
{
	static Ied::CodeInstance* Caller(Core::String& problem) { return Ied::ApiCaller(problem); }

	bool FindWorkspace(Core::StringView wsId, Workspace& ws) {
		Core::String problem;
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = server->workspaces->Find(wsId);
		if (!found || !server->code->LoadedIn(instance, found)) return false;
		ws = Ied::PluginWorkspace(server, found);
		return true;
	}

	bool OpenFolder(Core::StringView folder, Workspace& ws, Core::String& problem) {
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return false;
		if (!instance->May(Core::StringView("workspace.open"))) {
			problem = Core::String("the plugin's manifest does not ask for the permission workspace.open");
			return false;
		}
		FS::Path canonical = FS::CanonicalPath(Core::String(folder).CStr());
		if (canonical.IsEmpty() || !FS::IsDirectory(canonical.CStr())) {
			problem = Core::String("no folder ") + folder;
			return false;
		}
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = server->workspaces->ForRoot(canonical);
		if (!found) found = server->workspaces->Open(canonical, Core::StringView("folder"));
		ws = Ied::PluginWorkspace(server, found);
		return true;
	}

	Core::Array<Workspace> Workspaces() {
		Core::Array<Workspace> open;
		Core::String problem;
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return open;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		for (Ied::Workspace* ws : server->workspaces->All())
			if (server->code->LoadedIn(instance, ws)) open.Push(Ied::PluginWorkspace(server, ws));
		return open;
	}

	static Ied::Workspace* Permitted(Ied::CodeInstance* instance, const Workspace& ws, const char* permission, Core::String& problem) {
		return Ied::PermittedWorkspace(instance, ws.id.View(), permission, problem);
	}

	bool ReadFile(const Workspace& ws, Core::StringView path, Core::String& text, Core::String& problem) {
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Permitted(instance, ws, "fs.read", problem);
		if (!found) return false;
		try {
			text = server->workspaces->Read(found, Ied::NormalizePath(path).View());
			return true;
		}
		catch (Ied::RpcError& error) {
			problem = error.message;
			return false;
		}
	}

	bool MoveToTrash(Core::StringView wsId, Core::StringView path, Core::String& problem) {
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Workspace named;
		named.id = Core::String(wsId);
		Ied::Workspace* found = Permitted(instance, named, "fs.write", problem);
		if (!found) return false;
		try {
			Core::String relative = Ied::NormalizePath(path);
			server->trash->MoveIn(found, relative.View(), FS::IsDirectory(found->At(relative.View()).CStr()));
			return true;
		}
		catch (Ied::RpcError& error) {
			problem = error.message;
			return false;
		}
	}

	bool RelativeTo(Core::StringView root, Core::StringView path, Core::String& relative) { return Ied::RelativeTo(root, path, relative); }

	Core::Array<Core::String> DefaultExcludes() { return Ied::DefaultSearchExcludes(); }

	Core::String NormalizePath(Core::StringView path) { return Ied::NormalizePath(path); }

	Core::String WorkspaceFile(const Workspace& ws, Core::StringView path) {
		FS::Path root = FS::Path(ws.root.View());
		FS::Path state = ws.localState.IsEmpty() ? root / ".ied" / "local" : FS::Path(ws.localState.View());
		return Core::String(Ied::LocalOrRootFile(root, state, path).View());
	}

	bool GlobMatch(Core::StringView pattern, Core::StringView path) { return Ied::GlobMatch(pattern, path); }

	Core::Array<Core::String> ExpandGlob(Core::StringView folder, Core::StringView pattern) { return Ied::ExpandGlob(FS::Path(folder), pattern); }

	bool WriteFile(const Workspace& ws, Core::StringView path, Core::StringView text, Core::String& problem) {
		Ied::CodeInstance* instance = Caller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Permitted(instance, ws, "fs.write", problem);
		if (!found) return false;
		try {
			server->workspaces->Write(found, Ied::NormalizePath(path).View(), text, -1);
			return true;
		}
		catch (Ied::RpcError& error) {
			problem = error.message;
			return false;
		}
	}
}
