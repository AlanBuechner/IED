include "Relaunching.ch"
include "host/Server.ch"

namespace IED
{
	bool RelaunchServer(Core::StringView reason, Core::String& problem) {
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return false;
		if (!instance->May(Core::StringView("server.relaunch"))) {
			problem = Core::String("the plugin's manifest does not ask for the permission server.relaunch");
			return false;
		}
		Ied::Server* server = instance->m_Runtime->m_Server;
		Ied::ApiLock guard(server);
		// The relaunch is the master's: it stops its workspace servers and starts again with them (docs/27).
		if (server->m_Master) {
			Ied::JsonWriter params;
			params.BeginObject();
			params.Field("reason", (((Core::String("plugin ") + instance->m_PluginId.View()) + ": ") + reason).View());
			params.EndObject();
			Core::String result;
			if (!server->m_Master->Call(&server->m_Lock, Core::StringView("master.relaunch"), params.View(), result, problem)) return false;
			server->Log((((Core::String("relaunch: asked of the master by plugin ") + instance->m_PluginId.View()) + ": ") + reason).View());
			return true;
		}
		if (!server->m_Relaunch.Ask(reason, clock_now_ns() / 1000000)) {
			problem = Core::String("a relaunch is already under way");
			return false;
		}
		server->Log((((Core::String("relaunch: asked by plugin ") + instance->m_PluginId.View()) + ": ") + reason).View());
		return true;
	}
}
