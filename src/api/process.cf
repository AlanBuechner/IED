include "process.ch"
include "host/server.ch"

namespace IED
{
	static int64 NowMs() { return clock_now_ns() / 1000000; }

	// The child's output until it ends or `seconds` pass (then it is killed); its exit code, or -1 when it was stopped.
	static int64 Collect(Process::Child& child, int64 seconds, CommandResult& result) {
		const int64 deadline = NowMs() + seconds * 1000;
		char8[16384] buffer;
		while (child.HasOutput()) {
			if (NowMs() > deadline) {
				result.problem = Core::String("it ran out of time and was stopped");
				child.Kill();
				break;
			}
			Process::Stream from;
			const int64 got = child.ReadAny((void*)&buffer[0], 16384, from, 200);
			if (got > 0 && result.output.View().ByteLength() < kCommandKeptBytes) result.output = result.output + Core::StringView(&buffer[0], got);
			else if (got != Process::kTimedOut && got != 0) break;
		}
		const int64 code = child.Wait(5000);
		return result.problem.IsEmpty() ? code : -1;
	}

	CommandResult RunCommand(const Workspace& ws, const Core::Array<Core::String>& argv, Core::StringView cwd, int64 seconds) {
		CommandResult result;
		Ied::CodeInstance* instance = Ied::CurrentCode();
		if (!instance) {
			result.problem = Core::String("the plugin API is for a plugin's code, on its thread");
			return result;
		}
		Process::StartInfo info;
		{
			Ied::Server* server = instance->runtime->server;
			Ied::ApiLock guard(server);
			Ied::Workspace* found = server->workspaces->Find(ws.id.View());
			if (!instance->May(Core::StringView("process.spawn"))) result.problem = Core::String("the plugin's manifest does not ask for the permission process.spawn");
			else if (!found || !server->code->LoadedIn(instance, found)) result.problem = (Core::String("no open workspace ") + ws.id.View()) + " for this plugin";
			else if (!found->trusted) result.problem = Core::String("the workspace is not trusted: commands cannot run in it");
			else if (argv.IsEmpty()) result.problem = Core::String("no command");
			if (!result.problem.IsEmpty()) return result;
			try {
				info.workingDirectory = Core::String(found->At(Ied::NormalizePath(cwd).View()).View());
			}
			catch (Ied::RpcError& error) {
				result.problem = error.message;
				return result;
			}
		}
		info.program = argv[0];
		for (int64 i = 1; i < argv.Count(); ++i) info.arguments.Push(argv[i]);
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::Pipe;
		Process::Child child = Process::Child::Start(info);
		if (!child.IsOpen()) {
			result.problem = (Core::String("the command did not start: ") + child.Error());
			return result;
		}
		result.started = true;
		result.exitCode = (int32)Collect(child, seconds < 1 ? 1 : seconds, result);
		return result;
	}
}
