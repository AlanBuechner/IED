	bool LspFormatted(const Workspace& ws, Core::StringView path, int64 tabSize, bool insertSpaces, int64 ms, Core::String& formatted, Core::String& problem) {
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->m_Runtime->m_Server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Ied::PermittedWorkspace(instance, ws.m_Id.View(), "lsp", problem);
		if (!found) return false;
		try {
			Ied::Call call = ServerCall(server);
			formatted = server->m_Lsp->FormattedFor(call, found, Ied::NormalizePath(path).View(), tabSize, insertSpaces, ms);
			return true;
		}
		catch (Ied::RpcError& error) {
			problem = error.m_Message;
			return false;
		}
	}

	bool LspFileText(const Workspace& ws, Core::StringView uri, Core::String& text, Core::String& problem) {
		Core::String path;
		if (WorkspacePathOf(ws, uri, path)) return TextAsEdited(ws, path.View(), text, problem);
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->m_Runtime->m_Server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Ied::PermittedWorkspace(instance, ws.m_Id.View(), "lsp", problem);
		if (!found) return false;
		if (server->m_Lsp->NamedText(found, Ied::CanonicalFileUri(uri).View(), text)) return true;
		problem = (Core::String("no language server of the workspace named ") + uri) + "; only those files are readable from outside it";
		return false;
	}
}
