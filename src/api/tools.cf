include "tools.ch"

namespace IED
{
	ToolResult ToolText(Core::StringView content) {
		ToolResult result;
		result.content = Core::String(content);
		return result;
	}

	ToolResult ToolFailure(Core::StringView message) {
		ToolResult result;
		result.content = Core::String(message);
		result.isError = true;
		return result;
	}
}
