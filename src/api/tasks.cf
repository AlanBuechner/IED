include "tasks.ch"
include "host/server.ch"

namespace IED
{
	TaskOutcome RunTask(const Workspace& ws, Core::StringView project, Core::StringView key, Core::StringView slot) {
		TaskOutcome outcome;
		Ied::CodeInstance* instance = Ied::ApiCaller(outcome.problem);
		if (!instance) return outcome;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Ied::PermittedWorkspace(instance, ws.id.View(), "process.spawn", outcome.problem);
		if (!found) return outcome;
		if (!found->trusted) {
			outcome.problem = Core::String("the workspace is not trusted: nothing runs in it");
			return outcome;
		}
		try {
			Ied::TaskRun* run = server->tasks->RunTask(found, project, key, slot, Serialization::DomNode());
			outcome.succeeded = server->tasks->AwaitEnd(run);
			outcome.cancelled = run->status == Ied::RunStatus::Cancelled;
			outcome.label = run->label;
			outcome.ms = run->endedMs - run->startedMs;
			outcome.tail = run->tail;
			outcome.problems = Ied::RunProblemsJson(run);
		}
		catch (Ied::RpcError& error) {
			outcome.problem = error.message;
		}
		return outcome;
	}

	Core::String StartTask(const Workspace& ws, Core::StringView project, Core::StringView key, Core::StringView slot, Core::String& problem) {
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return Core::String();
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Ied::PermittedWorkspace(instance, ws.id.View(), "process.spawn", problem);
		if (!found) return Core::String();
		if (!found->trusted) {
			problem = Core::String("the workspace is not trusted: nothing runs in it");
			return Core::String();
		}
		try {
			return server->tasks->RunTask(found, project, key, slot, Serialization::DomNode())->runId;
		}
		catch (Ied::RpcError& error) {
			problem = error.message;
		}
		return Core::String();
	}

	bool TaskEnded(Core::StringView runId, TaskOutcome& outcome) {
		Ied::CodeInstance* instance = Ied::ApiCaller(outcome.problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::TaskRun* run = server->tasks->Run(runId);
		if (!run) {
			outcome.problem = Core::String("no run ") + runId;
			return false;
		}
		if (run->IsActive()) return false;
		outcome.succeeded = run->status == Ied::RunStatus::Succeeded;
		outcome.cancelled = run->status == Ied::RunStatus::Cancelled;
		outcome.label = run->label;
		outcome.ms = run->endedMs - run->startedMs;
		outcome.tail = run->tail;
		outcome.problems = Ied::RunProblemsJson(run);
		return true;
	}

	bool CancelTask(Core::StringView runId) {
		Core::String problem;
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::TaskRun* run = server->tasks->Run(runId);
		if (!run || !run->IsActive()) return false;
		server->tasks->Cancel(run);
		return true;
	}

	Core::String Problems(const Workspace& ws) {
		Core::String problem;
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return Core::String("{\"files\":{}}");
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		Ied::Workspace* found = Ied::PermittedWorkspace(instance, ws.id.View(), "fs.read", problem);
		return found ? server->diagnostics->Snapshot(found) : Core::String("{\"files\":{}}");
	}

	bool SetTaskVariable(Core::StringView wsId, Core::StringView name, Core::StringView value) {
		Core::String problem;
		Ied::CodeInstance* instance = Ied::ApiCaller(problem);
		if (!instance) return false;
		Ied::Server* server = instance->runtime->server;
		Ied::ApiLock guard(server);
		server->tasks->SetVariable(wsId, name, value);
		return true;
	}
}
