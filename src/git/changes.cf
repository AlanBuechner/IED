// The git methods that change a repository (docs/10 "Git"): staging, discarding, committing, branches and stashes.
// Each logs its command and git's words to the workspace's Git output and reads the repository again before it
// answers, so the caller's next snapshot already shows the change.

include "service.ch"
include "patch.ch"
include "host/server.ch"

namespace Ied
{
	GitRun Git::RunChange(GitRepo* repo, const Core::Array<Core::String>& arguments, ErrorCode code) {
		GitCli cli = CliFor(repo->ws);
		FS::Path root = repo->root;
		GitRun run;
		{
			Threading::UnlockGuard released(server->lock);
			run = cli.Run(root, arguments, kGitWriteTimeoutMs);
		}
		Core::StringBuilder log;
		log.Append("> ");
		log.Append(GitCommandLine(arguments).View());
		log.AppendByte('\n');
		log.Append(run.output.View());
		log.Append(run.errors.View());
		Log(repo, log.View());
		Refresh(repo, true);
		if (!run.Ok()) throw RpcError(run.exitCode == Process::kError ? ErrorCode::Unavailable : code, run.Problem().View());
		return run;
	}

	// A name git takes as an argument: never one it would read as an option.
	static Core::String NameParam(const Params& params, const char* key) {
		Core::String name = Core::String(params.Str(key).View().Trimmed());
		if (name.IsEmpty() || name.View().StartsWith(Core::StringView("-"))) throw RpcError(ErrorCode::BadRequest, (Core::String(key) + " is not a name git takes").View());
		return name;
	}

	static Core::Array<Core::String> PathsParam(const Params& params) {
		Serialization::DomNode given = params.List("paths");
		Core::Array<Core::String> paths;
		for (int64 i = 0; i < given.Count(); ++i) {
			Core::StringView path = given.At(i).AsView();
			if (path.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "an empty path");
			paths.Push(Core::String(path));
		}
		if (paths.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "no paths");
		return paths;
	}

	static Core::Array<Core::String> WithPaths(Core::Array<Core::String> arguments, const Core::Array<Core::String>& paths) {
		arguments.Push(Core::String("--"));
		for (const Core::String& path : paths) arguments.Push(path);
		return arguments;
	}

	static bool Unborn(const GitRepo* repo) {
		return repo->headJson.View().Contains(Core::StringView("\"oid\":\"\""));
	}

	static Core::String Empty() {
		return Core::String("{}");
	}

	Core::String Git::StageMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		RunChange(repo, WithPaths(GitArgs("add", "-A"), PathsParam(params)), ErrorCode::BadRequest);
		return Empty();
	}

	Core::String Git::UnstageMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::Array<Core::String> arguments = Unborn(repo) ? GitArgs("rm", "--cached", "-r") : GitArgs("restore", "--staged");
		if (Unborn(repo)) arguments.Push(Core::String("--quiet"));
		RunChange(repo, WithPaths(arguments, PathsParam(params)), ErrorCode::BadRequest);
		return Empty();
	}

	// A file in the system's temp folder holding `text`, for git to read (-F, apply).
	static FS::Path TempFile(Core::StringView name, Core::StringView text) {
		FS::Path file = FS::TempDirectory() / name;
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)text.Data(), text.ByteLength())) throw RpcError(ErrorCode::Unavailable, (Core::String("cannot write ") + file.View()).View());
		return file;
	}

	// The work tree diff's hunk staged, or the staged diff's unstaged (`staged`); with `discard`, the work tree diff's
	// hunk taken out of the work tree. The caller names the hunk by its index and header as it saw them.
	void Git::ApplyHunk(const Params& params, bool discard) {
		GitRepo* repo = RepoFor(params);
		Core::String path = params.Str("path");
		const bool staged = !discard && params.Bool("staged", false);
		const int64 hunk = params.Int("hunk");
		Core::Array<int64> chosen;
		if (params.Has("lines")) {
			Serialization::DomNode lines = params.List("lines");
			for (int64 i = 0; i < lines.Count(); ++i) chosen.Push(lines.At(i).AsInt());
			if (chosen.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "no lines chosen");
		}
		GitDiff diff = ParseDiff(RunOrThrow(repo, GitDiffArgs(path.View(), Core::StringView(""), Core::StringView(""), false, staged, 3), kGitReadTimeoutMs, ErrorCode::BadRequest).output.View());
		if (hunk < 0 || hunk >= diff.hunks.Count() || diff.hunks[hunk].header.View() != params.Str("header").View())
			throw RpcError(ErrorCode::Conflict, "the file changed since its diff was read; look again");
		Core::String patch = HunkPatch(diff, hunk, chosen, staged || discard);
		if (patch.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "the chosen lines change nothing");
		FS::Path file = TempFile((Core::String("ied-") + repo->repoId.View() + "-hunk.patch").View(), patch.View());
		Core::Array<Core::String> arguments = GitArgs("apply", "--recount");
		if (!discard) arguments.Push(Core::String("--cached"));
		if (staged || discard) arguments.Push(Core::String("-R"));
		arguments.Push(Core::String(file.View()));
		try {
			RunChange(repo, arguments, ErrorCode::Conflict);
		}
		catch (RpcError& error) {
			FS::RemoveFile(file.CStr());
			throw error;
		}
		FS::RemoveFile(file.CStr());
	}

	Core::String Git::StagePatchMethod(Call& call, const Params& params) {
		ApplyHunk(params, false);
		return Empty();
	}

	Core::String Git::DiscardPatchMethod(Call& call, const Params& params) {
		ApplyHunk(params, true);
		return Empty();
	}

	// Untracked paths go to the IED trash (when they are in the workspace folder); the others back to the index.
	Core::String Git::DiscardMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::Array<Core::String> paths = PathsParam(params);
		Core::Array<Core::String> status = WithPaths(GitArgs("status", "--porcelain=v2", "-z"), paths);
		status.Insert(3, Core::String("--untracked-files=all"));
		GitStatus read = ParseStatus(RunOrThrow(repo, status, kGitReadTimeoutMs, ErrorCode::BadRequest).output.View());
		Core::Array<Core::String> tracked;
		for (const Core::String& path : paths) {
			bool untracked = false;
			for (const GitChange& change : read.untracked) untracked = untracked || change.path == path;
			if (!untracked) {
				tracked.Push(path);
				continue;
			}
			Core::String relative;
			if (repo->relative == ".." || !RelativeTo(repo->ws->root.View(), (repo->root / path.View()).View(), relative))
				throw RpcError(ErrorCode::BadRequest, (Core::String("an untracked file outside the workspace folder is not discarded: ") + path.View()).View());
			server->trash->MoveIn(repo->ws, relative.View(), false);
		}
		if (!tracked.IsEmpty()) RunChange(repo, WithPaths(GitArgs("restore", "--worktree"), tracked), ErrorCode::BadRequest);
		else Refresh(repo, false);
		return Empty();
	}

	Core::String Git::CommitMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String message = Core::String(params.Str("message").View().Trimmed());
		const bool amend = params.Bool("amend", false);
		if (message.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "a commit needs a message");
		if (!amend && repo->changesJson.View().Contains(Core::StringView("\"staged\":[]"))) throw RpcError(ErrorCode::BadRequest, "nothing is staged");
		FS::Path file = TempFile((Core::String("ied-") + repo->repoId.View() + "-message.txt").View(), (message + "\n").View());
		Core::Array<Core::String> arguments = GitArgs("commit", "-F", file.CStr());
		if (amend) arguments.Push(Core::String("--amend"));
		if (params.Bool("signoff", false)) arguments.Push(Core::String("--signoff"));
		try {
			RunChange(repo, arguments, ErrorCode::BadRequest);
		}
		catch (RpcError& error) {
			FS::RemoveFile(file.CStr());
			throw error;
		}
		FS::RemoveFile(file.CStr());
		GitRun head = RunOrThrow(repo, GitArgs("rev-parse", "HEAD"), kGitReadTimeoutMs, ErrorCode::Internal);
		JsonWriter json;
		json.BeginObject();
		json.Field("oid", head.output.View().Trimmed());
		json.EndObject();
		return json.ToString();
	}

	// The files git names when a checkout would overwrite local changes (its tab-indented lines).
	static Core::String OverwrittenJson(Core::StringView problem) {
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("files"));
		json.BeginArray();
		for (Core::StringView line : SplitOn(problem, '\n'))
			if (line.StartsWith(Core::StringView("\t"))) json.String(line.Trimmed());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// A local branch, or with `remote` a remote one ("origin/x"): a local branch tracking it is made.
	Core::String Git::CheckoutMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String branch = NameParam(params, "branch");
		Core::Array<Core::String> arguments = GitArgs("switch");
		if (params.Bool("remote", false)) arguments.Push(Core::String("--track"));
		arguments.Push(branch);
		try {
			RunChange(repo, arguments, ErrorCode::Conflict);
		}
		catch (RpcError& error) {
			if (error.code == ErrorCode::Conflict && error.message.View().Contains(Core::StringView("would be overwritten"))) throw RpcError(ErrorCode::Conflict, error.message.View(), OverwrittenJson(error.message.View()).View());
			throw error;
		}
		return Empty();
	}

	Core::String Git::BranchMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String name = NameParam(params, "name");
		Core::Array<Core::String> arguments = params.Bool("checkout", false) ? GitArgs("switch", "-c", name.CStr()) : GitArgs("branch", name.CStr());
		if (params.Has("from")) arguments.Push(NameParam(params, "from"));
		RunChange(repo, arguments, ErrorCode::BadRequest);
		return Empty();
	}

	Core::String Git::BranchDeleteMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String name = NameParam(params, "name");
		RunChange(repo, GitArgs("branch", params.Bool("force", false) ? "-D" : "-d", name.CStr()), ErrorCode::Conflict);
		return Empty();
	}

	Core::String Git::BranchRenameMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::Array<Core::String> arguments = GitArgs("branch", "-m", NameParam(params, "name").CStr());
		arguments.Push(NameParam(params, "to"));
		RunChange(repo, arguments, ErrorCode::BadRequest);
		return Empty();
	}

	Core::String Git::StashMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::Array<Core::String> arguments = GitArgs("stash", "push");
		if (params.Bool("untracked", false)) arguments.Push(Core::String("--include-untracked"));
		if (params.Bool("keepIndex", false)) arguments.Push(Core::String("--keep-index"));
		Core::String message = Core::String(params.Str("message", Core::StringView("")).View().Trimmed());
		if (!message.IsEmpty()) {
			arguments.Push(Core::String("-m"));
			arguments.Push(message);
		}
		GitRun run = RunChange(repo, arguments, ErrorCode::BadRequest);
		if (run.output.View().Contains(Core::StringView("No local changes to save"))) throw RpcError(ErrorCode::BadRequest, "no local changes to stash");
		return Empty();
	}

	static Core::String StashName(const Params& params) {
		const int64 index = params.Int("index");
		if (index < 0) throw RpcError(ErrorCode::BadRequest, "a stash index is 0 or more");
		Core::StringBuilder name;
		name.Append("stash@{");
		name.AppendInt(index);
		name.AppendByte('}');
		return name.ToString();
	}

	Core::String Git::StashApplyMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		RunChange(repo, GitArgs("stash", params.Bool("pop", false) ? "pop" : "apply", StashName(params).CStr()), ErrorCode::Conflict);
		return Empty();
	}

	Core::String Git::StashDropMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		RunChange(repo, GitArgs("stash", "drop", StashName(params).CStr()), ErrorCode::NotFound);
		return Empty();
	}
}
