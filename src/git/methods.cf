// The git methods that read (docs/10 "Git"): repos, log, show, diff, fileAt and lastMessage.

include "service.ch"
include "host/server.ch"

namespace Ied
{
	void Git::RegisterMethods() {
		Git* self = this;
		server->rpc.Register("git.repos", [self](Call& call, const Params& params) -> Core::String { return self->ReposMethod(call, params); });
		server->rpc.Register("git.log", [self](Call& call, const Params& params) -> Core::String { return self->LogMethod(call, params); });
		server->rpc.Register("git.show", [self](Call& call, const Params& params) -> Core::String { return self->ShowMethod(call, params); });
		server->rpc.Register("git.diff", [self](Call& call, const Params& params) -> Core::String { return self->DiffMethod(call, params); });
		server->rpc.Register("git.fileAt", [self](Call& call, const Params& params) -> Core::String { return self->FileAtMethod(call, params); });
		server->rpc.Register("git.lastMessage", [self](Call& call, const Params& params) -> Core::String { return self->LastMessageMethod(call, params); });
		server->rpc.Register("git.stage", [self](Call& call, const Params& params) -> Core::String { return self->StageMethod(call, params); });
		server->rpc.Register("git.unstage", [self](Call& call, const Params& params) -> Core::String { return self->UnstageMethod(call, params); });
		server->rpc.Register("git.stagePatch", [self](Call& call, const Params& params) -> Core::String { return self->StagePatchMethod(call, params); });
		server->rpc.Register("git.discardPatch", [self](Call& call, const Params& params) -> Core::String { return self->DiscardPatchMethod(call, params); });
		server->rpc.Register("git.discard", [self](Call& call, const Params& params) -> Core::String { return self->DiscardMethod(call, params); });
		server->rpc.Register("git.commit", [self](Call& call, const Params& params) -> Core::String { return self->CommitMethod(call, params); });
		server->rpc.Register("git.checkout", [self](Call& call, const Params& params) -> Core::String { return self->CheckoutMethod(call, params); });
		server->rpc.Register("git.branch", [self](Call& call, const Params& params) -> Core::String { return self->BranchMethod(call, params); });
		server->rpc.Register("git.branchDelete", [self](Call& call, const Params& params) -> Core::String { return self->BranchDeleteMethod(call, params); });
		server->rpc.Register("git.branchRename", [self](Call& call, const Params& params) -> Core::String { return self->BranchRenameMethod(call, params); });
		server->rpc.Register("git.stash", [self](Call& call, const Params& params) -> Core::String { return self->StashMethod(call, params); });
		server->rpc.Register("git.stashApply", [self](Call& call, const Params& params) -> Core::String { return self->StashApplyMethod(call, params); });
		server->rpc.Register("git.stashDrop", [self](Call& call, const Params& params) -> Core::String { return self->StashDropMethod(call, params); });
		server->rpc.Register("git.fetch", [self](Call& call, const Params& params) -> Core::String { return self->OpMethod(call, params, "fetch"); });
		server->rpc.Register("git.pull", [self](Call& call, const Params& params) -> Core::String { return self->OpMethod(call, params, "pull"); });
		server->rpc.Register("git.push", [self](Call& call, const Params& params) -> Core::String { return self->OpMethod(call, params, "push"); });
	}

	GitRepo* Git::RepoFor(const Params& params) const {
		Core::String repoId = params.Str("repoId");
		for (GitWorkspace* git : workspaces)
			for (GitRepo* repo : git->repos)
				if (repo->repoId == repoId) {
					if (!repo->ws->trusted) throw RpcError(ErrorCode::Untrusted, "git does not run in an untrusted workspace");
					return repo;
				}
		throw RpcError(ErrorCode::NotFound, (Core::String("no repository ") + repoId.View()).View());
	}

	GitRun Git::RunOrThrow(GitRepo* repo, const Core::Array<Core::String>& arguments, int32 timeoutMs, ErrorCode code) {
		GitCli cli = CliFor(repo->ws);
		FS::Path root = repo->root;
		GitRun run;
		{
			Threading::UnlockGuard released(server->lock);
			run = cli.Run(root, arguments, timeoutMs);
		}
		if (!run.Ok()) throw RpcError(run.exitCode == Process::kError ? ErrorCode::Unavailable : code, run.Problem().View());
		return run;
	}

	Core::String Git::ReposMethod(Call& call, const Params& params) {
		Workspace* ws = server->workspaces->Get(params.Str("wsId").View());
		GitWorkspace* git = Find(ws);
		if (!git) throw RpcError(ErrorCode::NotFound, "the workspace has no git side");
		return git->SnapshotJson();
	}

	static int32 Folded(int32 c) {
		return c >= 'A' && c <= 'Z' ? c + 32 : c;
	}

	// Whether `text` has `query` in it, ASCII letters in any case.
	static bool HasFolded(Core::StringView text, Core::StringView query) {
		for (int64 start = 0; start + query.ByteLength() <= text.ByteLength(); ++start) {
			int64 i = 0;
			while (i < query.ByteLength() && Folded(text.ByteAt(start + i)) == Folded(query.ByteAt(i))) i += 1;
			if (i == query.ByteLength()) return true;
		}
		return false;
	}

	// A log record (kGitLogFormat and the body) that a search keeps: the message, the author or the email has the
	// query, or the hash starts with it.
	static bool Matches(Core::StringView record, Core::StringView query) {
		Core::Array<Core::StringView> fields = SplitOn(record.Trimmed(), (char)31);
		if (fields.Count() < 6) return false;
		if (fields[0].StartsWith(query)) return true;
		for (int64 i = 2; i < fields.Count(); ++i)
			if (i != 4 && HasFolded(fields[i], query)) return true;
		return false;
	}

	// Every commit, newest first, the stashes left out; `limit` + 1 of them after `skip` when there is no search.
	static Core::Array<Core::String> LogArgs(int64 skip, int64 limit, bool search) {
		Core::Array<Core::String> arguments = GitArgs("log", "--date-order", "-z");
		arguments.Push(Core::String("--exclude=refs/stash"));
		arguments.Push(Core::String("--all"));
		arguments.Push(Core::String("--format=") + kGitLogFormat + (search ? "%x1f%b" : ""));
		if (search) return arguments;
		Core::StringBuilder count;
		count.Append("--max-count=");
		count.AppendInt(limit + 1);
		arguments.Push(count.ToString());
		Core::StringBuilder skipped;
		skipped.Append("--skip=");
		skipped.AppendInt(skip);
		arguments.Push(skipped.ToString());
		return arguments;
	}

	Core::String Git::LogMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		int64 limit = params.Int("limit", kGitLogDefault);
		if (limit < 1 || limit > kGitLogMost) throw RpcError(ErrorCode::BadRequest, "limit is 1 to 2000");
		const int64 skip = params.Int("skip", 0);
		Core::String query = Core::String(params.Str("query", Core::StringView("")).View().Trimmed());
		if (repo->headJson.IsEmpty() || repo->headJson.View().Contains(Core::StringView("\"oid\":\"\""))) return GitLogJson(Core::Array<GitCommit>(), false);
		GitRun run = RunOrThrow(repo, LogArgs(skip, limit, !query.IsEmpty()), kGitReadTimeoutMs, ErrorCode::BadRequest);
		if (query.IsEmpty()) {
			Core::Array<GitCommit> commits = ParseLog(run.output.View());
			const bool more = commits.Count() > limit;
			if (more) commits.RemoveAt(commits.Count() - 1);
			return GitLogJson(commits, more);
		}
		Core::StringBuilder kept;
		int64 found = 0;
		for (Core::StringView record : SplitOn(run.output.View(), (char)0)) {
			if (!Matches(record, query.View())) continue;
			found += 1;
			if (found <= skip || found > skip + limit) continue;
			kept.Append(record);
			kept.AppendByte(0);
		}
		return GitLogJson(ParseLog(kept.View()), found > skip + limit);
	}

	// A commit's change against its first parent (a root commit's against nothing), renames found.
	static void AddRange(Core::Array<Core::String>& arguments, Core::StringView oid, bool hasParent) {
		arguments.Push(Core::String("-M"));
		if (hasParent) arguments.Push(Core::String(oid) + "^1");
		arguments.Push(Core::String(oid));
	}

	Core::String Git::ShowMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String oid = params.Str("oid");
		Core::Array<Core::String> show = GitArgs("show", "-s");
		show.Push(Core::String("--format=%H%x1f%P%x1f%an%x1f%ae%x1f%at%x1f%cn%x1f%ce%x1f%ct%x1f%s%x1f%b"));
		show.Push(Core::String(oid));
		GitRun shown = RunOrThrow(repo, show, kGitReadTimeoutMs, ErrorCode::NotFound);
		Core::Array<Core::StringView> fields = SplitOn(shown.output.View(), (char)31);
		if (fields.Count() < 10) throw RpcError(ErrorCode::NotFound, (Core::String("no commit ") + oid.View()).View());
		const bool hasParent = !fields[1].Trimmed().IsEmpty();
		Core::Array<Core::String> names = hasParent ? GitArgs("diff", "--name-status", "-z") : GitArgs("diff-tree", "-r", "--root", "--no-commit-id");
		Core::Array<Core::String> counts = hasParent ? GitArgs("diff", "--numstat", "-z") : GitArgs("diff-tree", "-r", "--root", "--no-commit-id");
		if (!hasParent) {
			names.Push(Core::String("--name-status"));
			names.Push(Core::String("-z"));
			counts.Push(Core::String("--numstat"));
			counts.Push(Core::String("-z"));
		}
		AddRange(names, fields[0].Trimmed(), hasParent);
		AddRange(counts, fields[0].Trimmed(), hasParent);
		Core::Array<GitFileChange> files = ParseNameStatus(RunOrThrow(repo, names, kGitReadTimeoutMs, ErrorCode::NotFound).output.View());
		AddNumstat(files, RunOrThrow(repo, counts, kGitReadTimeoutMs, ErrorCode::NotFound).output.View());
		JsonWriter json;
		json.BeginObject();
		json.Field("oid", fields[0].Trimmed());
		json.Key(Core::StringView("parents"));
		json.BeginArray();
		for (Core::StringView parent : SplitOn(fields[1], ' ')) json.String(parent);
		json.EndArray();
		json.Field("author", fields[2]);
		json.Field("email", fields[3]);
		int64 seconds = 0;
		Core::ParseInt64(fields[4], seconds);
		json.IntField("authorMs", seconds * 1000);
		json.Field("committer", fields[5]);
		json.Field("committerEmail", fields[6]);
		Core::ParseInt64(fields[7], seconds);
		json.IntField("commitMs", seconds * 1000);
		json.Field("subject", fields[8]);
		json.Field("body", fields[9].Trimmed());
		json.RawField("files", GitFilesJson(files).View());
		json.EndObject();
		return json.ToString();
	}

	Core::Array<Core::String> GitDiffArgs(Core::StringView path, Core::StringView oldPath, Core::StringView oid, bool hasParent, bool staged, int64 context) {
		Core::Array<Core::String> arguments = oid.IsEmpty() || hasParent ? GitArgs("diff", "--no-ext-diff") : GitArgs("diff-tree", "-p", "--root", "--no-commit-id");
		Core::StringBuilder unified;
		unified.Append("-U");
		unified.AppendInt(context);
		arguments.Push(unified.ToString());
		arguments.Push(Core::String("-M"));
		if (oid.IsEmpty() && staged) arguments.Push(Core::String("--cached"));
		if (!oid.IsEmpty() && hasParent) arguments.Push(Core::String(oid) + "^1");
		if (!oid.IsEmpty()) arguments.Push(Core::String(oid));
		arguments.Push(Core::String("--"));
		if (!oldPath.IsEmpty()) arguments.Push(Core::String(oldPath));
		arguments.Push(Core::String(path));
		return arguments;
	}

	static bool HasParent(Core::StringView showParents) {
		return !showParents.Trimmed().IsEmpty();
	}

	Core::String Git::DiffMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String path = params.Str("path");
		Core::String oldPath = params.Str("oldPath", Core::StringView(""));
		Core::String oid = params.Str("oid", Core::StringView(""));
		int64 context = params.Int("context", 3);
		if (context < 0 || context > 1000) throw RpcError(ErrorCode::BadRequest, "context is 0 to 1000");
		bool hasParent = false;
		if (!oid.IsEmpty()) hasParent = HasParent(RunOrThrow(repo, GitArgs("show", "-s", "--format=%P", oid.CStr()), kGitReadTimeoutMs, ErrorCode::NotFound).output.View());
		GitRun run = RunOrThrow(repo, GitDiffArgs(path.View(), oldPath.View(), oid.View(), hasParent, params.Bool("staged", false), context), kGitReadTimeoutMs, ErrorCode::BadRequest);
		const bool truncated = run.output.View().ByteLength() > kGitDiffMostBytes;
		Core::StringView text = truncated ? run.output.View().Substring(0, kGitDiffMostBytes) : run.output.View();
		return GitDiffJson(path.View(), oldPath.View(), ParseDiff(text), truncated);
	}

	static bool LooksBinary(Core::StringView text) {
		const int64 probe = text.ByteLength() < 8000 ? text.ByteLength() : 8000;
		for (int64 i = 0; i < probe; ++i)
			if (text.ByteAt(i) == 0) return true;
		return false;
	}

	// A side of a side-by-side diff: the file in a commit (`rev`), the index (":") or the work tree ("").
	Core::String Git::FileAtMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		Core::String path = params.Str("path");
		Core::String rev = params.Str("rev", Core::StringView(""));
		Core::String text;
		bool missing = false;
		if (rev.IsEmpty()) {
			FS::Path file = repo->root / path.View();
			missing = !FS::FileExists(file.CStr());
			if (!missing) text = FS::File(file.CStr(), "rb").ReadText();
		}
		else {
			GitCli cli = CliFor(repo->ws);
			FS::Path root = repo->root;
			GitRun run;
			{
				Threading::UnlockGuard released(server->lock);
				run = cli.Run(root, GitArgs("show", (rev == ":" ? (Core::String(":") + path.View()) : ((rev + ":") + path.View())).CStr()), kGitReadTimeoutMs);
			}
			missing = !run.Ok();
			text = run.output;
		}
		const bool binary = LooksBinary(text.View());
		const bool truncated = text.View().ByteLength() > kGitFileMostBytes;
		JsonWriter json;
		json.BeginObject();
		json.Field("text", binary || missing ? Core::StringView("") : (truncated ? text.View().Substring(0, kGitFileMostBytes) : text.View()));
		json.BoolField("binary", binary);
		json.BoolField("missing", missing);
		json.BoolField("truncated", truncated);
		json.EndObject();
		return json.ToString();
	}

	Core::String Git::LastMessageMethod(Call& call, const Params& params) {
		GitRepo* repo = RepoFor(params);
		GitRun run = RunOrThrow(repo, GitArgs("log", "-1", "--format=%B"), kGitReadTimeoutMs, ErrorCode::NotFound);
		JsonWriter json;
		json.BeginObject();
		json.Field("message", run.output.View().Trimmed());
		json.EndObject();
		return json.ToString();
	}
}
