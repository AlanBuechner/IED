include "Templates.ch"
include "host/Server.ch"
include "fs/Walk.ch"
include "web/Json.ch"

namespace Ied
{
	void ProjectTemplates::Init(Server* server) {
		this.m_Server = server;
		ProjectTemplates* self = this;
		server->m_Rpc.Register("project.templates", [self](Call& call, const Params& params) -> Core::String { return self->ListMethod(call, params); });
		server->m_Rpc.Register("project.create", [self](Call& call, const Params& params) -> Core::String { return self->CreateMethod(call, params); });
	}

	bool IsProjectName(Core::StringView name) {
		if (name.IsEmpty() || name.ByteLength() > 64) return false;
		for (int64 i = 0; i < name.ByteLength(); ++i) {
			const int32 c = name.ByteAt(i);
			const bool word = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
			if (!word && (i == 0 || (c != '.' && c != '-'))) return false;
		}
		return true;
	}

	Core::String WithName(Core::StringView text, Core::StringView name) {
		Core::StringBuilder out;
		int64 at = 0;
		for (int64 found = text.IndexOf(Core::StringView("${name}"), 0); found >= 0; found = text.IndexOf(Core::StringView("${name}"), at)) {
			out.Append(text.Substring(at, found - at));
			out.Append(name);
			at = found + 7;
		}
		out.Append(text.Substring(at, text.ByteLength() - at));
		return out.ToString();
	}

	static void Collect(Core::Array<ProjectTemplate*>& into, const Core::Array<Contribution>& entries, Workspace* from) {
		for (const Contribution& given : entries) {
			if (from && given.m_Plugin->m_Manifest->m_Source != PluginSource::Project) continue;
			Core::String key = (given.m_Plugin->m_Manifest->m_Id + "/") + given.m_Entry.Member("id").AsView();
			bool seen = false;
			for (ProjectTemplate* known : into) seen = seen || known->m_Key.View() == key.View();
			if (seen) continue;
			ProjectTemplate* made = new ProjectTemplate();
			made->m_Key = key;
			made->m_Plugin = given.m_Plugin;
			made->m_From = from;
			made->m_Entry = given.m_Entry;
			into.Push(made);
		}
	}

	Core::Array<ProjectTemplate*> ProjectTemplates::All() {
		Core::Array<ProjectTemplate*> all;
		Collect(all, m_Server->m_Plugins->Entries(nullptr, Core::StringView("projectTemplates")), nullptr);
		for (Workspace* ws : m_Server->m_Workspaces->All())
			if (ws->m_Trusted) Collect(all, m_Server->m_Plugins->Entries(ws, Core::StringView("projectTemplates")), ws);
		return all;
	}

	// The name the plugin's `languages` give the template's language ("cpp": "C++"), else the id.
	static Core::String LanguageName(const Plugin* plugin, Core::StringView language) {
		Serialization::DomNode languages = plugin->m_Manifest->m_Contributes.Member("languages");
		for (int64 i = 0; i < languages.Count(); ++i) {
			Serialization::DomNode entry = languages.At(i);
			if (entry.Member("id").AsView() != language) continue;
			Serialization::DomNode aliases = entry.Member("aliases");
			return aliases.Count() > 0 ? Core::String(aliases.At(0).AsView()) : Core::String(language);
		}
		return Core::String(language);
	}

	// Where the window loads the plugin's files from (an icon's SVG).
	static Core::String PluginBase(const ProjectTemplate* made) {
		Core::String plugin = (made->m_Plugin->m_Manifest->m_Id + "/");
		return made->m_From ? ((Core::String("/w/") + made->m_From->m_WsId.View()) + "/plugins/") + plugin.View() : Core::String("/plugins/") + plugin.View();
	}

	bool TemplateCanAdd(const ProjectTemplate* made, Workspace* ws) {
		if (!ws || !ws->m_Trusted || !ws->m_Solution) return false;
		Serialization::DomNode into = made->m_Entry.Member("into");
		for (int64 i = 0; i < into.Count(); ++i)
			if (FS::FileExists((ws->m_Root / into.At(i).AsView()).CStr())) return true;
		return false;
	}

	// Where a new project goes unless the person says: beside the project opened last, else in their home folder.
	static Core::String DefaultLocation(Server* server) {
		const Core::Array<RecentProject>& recent = server->m_Recent.All();
		if (!recent.IsEmpty()) {
			FS::Path last = FS::Path(recent[0].m_Path.View());
			FS::Path folder = recent[0].m_Kind == "solution" ? last.Parent() : last;
			if (!folder.Parent().IsEmpty()) return ForwardSlashes(folder.Parent().View());
		}
		Core::String home;
		return Platform::TryGetEnvironmentVariable("USERPROFILE", home) ? ForwardSlashes(home.View()) : Core::String();
	}

	static void WriteTemplate(JsonWriter& json, const ProjectTemplate* made, Workspace* ws) {
		Serialization::DomNode entry = made->m_Entry;
		json.BeginObject();
		json.Field("key", made->m_Key.View());
		json.Field("plugin", made->m_Plugin->m_Manifest->m_Id.View());
		json.Field("id", entry.Member("id").AsView());
		json.Field("title", entry.Member("title").AsView());
		json.Field("description", entry.Member("description").AsView());
		json.Field("language", entry.Member("language").AsView());
		json.Field("languageName", LanguageName(made->m_Plugin, entry.Member("language").AsView()).View());
		json.Key(Core::StringView("tags"));
		json.BeginArray();
		Serialization::DomNode tags = entry.Member("tags");
		for (int64 i = 0; i < tags.Count(); ++i) json.String(tags.At(i).AsView());
		json.EndArray();
		json.BoolField("canAdd", TemplateCanAdd(made, ws));
		json.EndObject();
	}

	// {templates: [{key, plugin, id, title, description, language, languageName, tags, canAdd}], icons: [{plugin: {id,
	// base}, value}] (the template plugins' projectIcons, as the shell's icons read them), location}
	Core::String ProjectTemplates::ListMethod(Call& call, const Params& params) {
		Workspace* ws = params.Has("wsId") ? m_Server->m_Workspaces->Get(params.Str("wsId").View()) : nullptr;
		Core::Array<ProjectTemplate*> all = All();
		JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("templates"));
		json.BeginArray();
		for (ProjectTemplate* made : all) WriteTemplate(json, made, ws);
		json.EndArray();
		json.Key(Core::StringView("icons"));
		json.BeginArray();
		Core::Array<Core::String> drawn;
		for (ProjectTemplate* made : all) {
			bool seen = false;
			for (const Core::String& id : drawn) seen = seen || id.View() == made->m_Plugin->m_Manifest->m_Id.View();
			if (seen) continue;
			drawn.Push(made->m_Plugin->m_Manifest->m_Id);
			Serialization::DomNode icons = made->m_Plugin->m_Manifest->m_Contributes.Member("projectIcons");
			for (int64 i = 0; i < icons.Count(); ++i) {
				json.BeginObject();
				json.Key(Core::StringView("plugin"));
				json.BeginObject();
				json.Field("id", made->m_Plugin->m_Manifest->m_Id.View());
				json.Field("base", PluginBase(made).View());
				json.EndObject();
				json.RawField("value", NodeJson(icons.At(i)).View());
				json.EndObject();
			}
		}
		json.EndArray();
		json.Field("location", DefaultLocation(m_Server).View());
		json.EndObject();
		return json.ToString();
	}

	// ---------------------------------------------------------------------------------------------------------------
	// Making a project

	static ProjectTemplate* Named(const Core::Array<ProjectTemplate*>& all, Core::StringView key) {
		for (ProjectTemplate* made : all)
			if (made->m_Key.View() == key) return made;
		throw RpcError(ErrorCode::NotFound, (Core::String("no project template ") + key).View());
	}

	// Copies the template's files into `project`, ${name} filled in their paths and text; a file there stays. "" when
	// every one was written, else why not.
	static Core::String CopyFiles(const FS::Path& from, const FS::Path& project, Core::StringView name) {
		Core::String problem;
		FileWalk walk;
		walk.m_Root = from;
		walk.m_UseIgnoreFiles = false;
		walk.m_Cancel = nullptr;
		walk.Run([from, project, name, &problem](Core::StringView path) -> bool {
			FS::Path target = project / WithName(path, name).View();
			if (FS::FileExists(target.CStr())) return true;
			FS::File source = FS::File((from / path).CStr(), "rb");
			Core::String text = source.ReadText();
			source.Close();
			Core::String filled = WithName(text.View(), name);
			if (FS::MakeDirectories(target.Parent().CStr()) && FS::WriteFileAtomically(target.CStr(), filled.CStr(), filled.View().ByteLength())) return true;
			problem = Core::String("could not write ") + ForwardSlashes(target.View()).View();
			return false;
		});
		return problem;
	}

	// The template's folder of files in its plugin, or "" for none; a path that leaves the plugin is refused.
	static FS::Path FilesOf(const ProjectTemplate* made) {
		Core::StringView files = made->m_Entry.Member("files").AsView();
		if (files.IsEmpty()) return FS::Path();
		if (FS::Path(files).IsAbsolute() || files.IndexOf(Core::StringView(".."), 0) >= 0) throw RpcError(ErrorCode::BadRequest, ((Core::String("the template ") + made->m_Key.View()) + "'s files are outside its plugin").View());
		return made->m_Plugin->m_Manifest->m_Folder / files;
	}

	// The variables a template's steps see: the new project's name and folders.
	static Core::HashMap<Core::String, Core::String>* TemplateValues(Core::StringView name, const FS::Path& project, const FS::Path& workspace) {
		Core::HashMap<Core::String, Core::String>* values = new Core::HashMap<Core::String, Core::String>();
		values->Insert(Core::String("name"), Core::String(name));
		values->Insert(Core::String("projectName"), Core::String(name));
		values->Insert(Core::String("projectDir"), ForwardSlashes(project.View()));
		values->Insert(Core::String("projectRoot"), ForwardSlashes(project.View()));
		values->Insert(Core::String("workspaceDir"), ForwardSlashes(workspace.View()));
		values->Insert(Core::String("solutionDir"), ForwardSlashes(workspace.View()));
		return values;
	}

	ProjectChange* ProjectTemplates::Create(Core::StringView key, Core::StringView name, Core::StringView location, Workspace* into) {
		ProjectTemplate* made = Named(All(), key);
		if (!IsProjectName(name)) throw RpcError(ErrorCode::BadRequest, ((Core::String("'") + name) + "' cannot name a project: use letters, digits, '_', '.' and '-'").View());
		if (into && !into->m_Trusted) throw RpcError(ErrorCode::Forbidden, "a template runs commands in the workspace: trust it first");
		if (into && !TemplateCanAdd(made, into)) throw RpcError(ErrorCode::BadRequest, ((Core::String("the template ") + made->m_Key.View()) + " cannot add a project to this solution").View());
		Core::String folder = into ? Core::String(into->m_Root.View()) : Core::String(location);
		if (folder.IsEmpty() || !FS::Path(folder.View()).IsAbsolute()) throw RpcError(ErrorCode::BadRequest, "a new project needs the folder it goes in, as a full path");
		FS::Path project = FS::Path(folder.View()) / name;
		FS::Path workspace = into ? into->m_Root : project;
		if (FS::IsDirectory(project.CStr()) || FS::FileExists(project.CStr())) throw RpcError(ErrorCode::Conflict, (ForwardSlashes(project.View()) + " is there already: pick another name or folder").View());
		Core::Array<ProjectStep*> steps = PlanProjectSteps(m_Server, made->m_Entry.Member("steps"), into, TemplateValues(name, project, workspace), (Core::String("the template ") + made->m_Key.View()).View());
		FS::Path files = FilesOf(made);
		Core::StringBuilder log;
		Core::String problem;
		{
			Threading::UnlockGuard released(m_Server->m_Lock);
			if (!FS::MakeDirectories(project.CStr())) problem = Core::String("could not make ") + ForwardSlashes(project.View()).View();
			if (problem.IsEmpty()) problem = RunProjectSteps(steps, log);
			if (problem.IsEmpty() && !files.IsEmpty()) problem = CopyFiles(files, project, name);
			if (!problem.IsEmpty()) FS::RemoveAll(project.CStr());
		}
		if (!problem.IsEmpty()) throw RpcError(ErrorCode::Unavailable, problem.View());
		ProjectChange* change = new ProjectChange();
		change->m_Ws = into;
		if (into && into->m_Solution) m_Server->m_Workspaces->SolutionChanged(into);
		if (!into) {
			if (!m_Server->RecordTrust(project, true)) m_Server->Log(Core::StringView("the new project could not be trusted"));
			Core::String relative;
			change->m_Ws = m_Server->m_Workspaces->OpenFor(project, relative);
		}
		change->m_Path = ForwardSlashes(project.View());
		change->m_Project = Core::String(name);
		change->m_Log = StepLogTail(log.View());
		return change;
	}

	// {template, name, location (a new workspace's folder goes in it) | wsId (the project goes into that solution)} ->
	// {workspace, path, log}: the new workspace opened (trusted: its owner made it), or the solution it went into.
	Core::String ProjectTemplates::CreateMethod(Call& call, const Params& params) {
		Workspace* into = params.Has("wsId") ? m_Server->m_Workspaces->Get(params.Str("wsId").View()) : nullptr;
		Core::String location = into ? Core::String() : params.Str("location", Core::StringView(""));
		ProjectChange* change = Create(params.Str("template").View(), params.Str("name").View(), location.View(), into);
		JsonWriter json;
		json.BeginObject();
		json.RawField("workspace", change->m_Ws->SummaryJson().View());
		json.Field("path", change->m_Path.View());
		json.Field("log", change->m_Log.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String DefaultProjectLocation(Server* server) { return DefaultLocation(server); }
}
