include "Steps.ch"
include "host/Server.ch"
include "tasks/Model.ch"
include "tasks/Expand.ch"
include "tasks/Missing.ch"

namespace Ied
{
	Core::String ForwardSlashes(Core::StringView path) {
		Core::StringBuilder out;
		for (int64 i = 0; i < path.ByteLength(); ++i) out.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return out.ToString();
	}

	Core::String StepLogTail(Core::StringView text) {
		Core::StringView trimmed = text.Trimmed();
		return Core::String(trimmed.ByteLength() <= c_ProjectLogBytes ? trimmed : trimmed.Substring(trimmed.ByteLength() - c_ProjectLogBytes, c_ProjectLogBytes));
	}

	static Core::String Expanded(Core::StringView text, const TaskLookup& lookup, Core::StringView owner) {
		Core::String out;
		Core::String unknown;
		if (!ExpandTaskText(text, lookup, out, unknown)) throw RpcError(ErrorCode::BadRequest, ((((Core::String("") + owner) + " names ${") + unknown.View()) + "}, which nothing gives").View());
		return out;
	}

	// ${KEY} from `values`, ${env:NAME} (empty when unset) and ${config:KEY} (a string setting's text, else its JSON).
	static TaskLookup StepLookup(Server* server, Workspace* ws, const Core::HashMap<Core::String, Core::String>* values) {
		Settings* settings = server->m_Settings;
		return [values, settings, ws](Core::StringView key, Core::String& value) -> bool {
			if (values->TryGet(Core::String(key), value)) return true;
			if (key.StartsWith(Core::StringView("env:"))) {
				if (!Platform::TryGetEnvironmentVariable(Core::String(key.Substring(4, key.ByteLength() - 4)).CStr(), value)) value = Core::String();
				return true;
			}
			if (!key.StartsWith(Core::StringView("config:"))) return false;
			Serialization::DomDoc* doc = new Serialization::DomDoc();
			Core::String json = settings->Effective(ws, Core::StringView(""), key.Substring(7, key.ByteLength() - 7));
			Serialization::DomNode setting = json.IsEmpty() ? Serialization::DomNode() : Serialization::ReadJson(json.View(), *doc).root;
			value = setting.Kind() == Serialization::DomKind::String ? Core::String(setting.AsView()) : Core::String(json.View().Trimmed());
			return true;
		};
	}

	Core::Array<ProjectStep*> PlanProjectSteps(Server* server, const Serialization::DomNode& steps, Workspace* ws, const Core::HashMap<Core::String, Core::String>* values, Core::StringView owner) {
		TaskLookup lookup = StepLookup(server, ws, values);
		Core::Array<ProjectStep*> planned;
		for (int64 i = 0; i < steps.Count(); ++i) {
			TaskStep* step = ReadTaskStep(steps.At(i));
			if (step->m_Kind != StepKind::Run || (step->m_Argv.IsEmpty() && step->m_Shell.IsEmpty())) throw RpcError(ErrorCode::BadRequest, ((Core::String("a step of ") + owner) + " runs nothing").View());
			ProjectStep* run = new ProjectStep();
			for (const Core::String& arg : step->m_Argv) run->m_Argv.Push(Expanded(arg.View(), lookup, owner));
			if (!step->m_Shell.IsEmpty()) run->m_Shell = Expanded(step->m_Shell.View(), lookup, owner);
			run->m_Cwd = Expanded(step->m_Cwd.IsEmpty() ? Core::StringView("${workspaceDir}") : step->m_Cwd.View(), lookup, owner);
			run->m_Label = !step->m_Label.IsEmpty() ? step->m_Label : !run->m_Shell.IsEmpty() ? run->m_Shell : run->m_Argv[0];
			run->m_Setting = ProgramSetting(!step->m_Shell.IsEmpty() ? step->m_Shell.View() : step->m_Argv.IsEmpty() ? Core::StringView("") : step->m_Argv[0].View());
			planned.Push(run);
		}
		return planned;
	}

	Core::String RunProjectStep(const ProjectStep* step, Core::StringBuilder& log) {
		Process::StartInfo info;
		if (!step->m_Shell.IsEmpty()) info.shellCommand = step->m_Shell;
		else {
			info.program = step->m_Argv[0];
			for (int64 i = 1; i < step->m_Argv.Count(); ++i) info.arguments.Push(step->m_Argv[i]);
		}
		info.workingDirectory = step->m_Cwd;
		info.input = Process::Redirect::Null;
		info.errors = Process::Redirect::ToOutput;
		Process::Output done = Process::Run(info, (int32)c_ProjectStepMs);
		log.Append(done.output.View());
		if (done.exitCode == 0) return Core::String();
		Core::StringBuilder why;
		why.Append("the step ");
		why.Append(step->m_Label.View());
		if (done.exitCode == Process::kTimedOut) why.Append(" ran out of time");
		else if (done.exitCode == Process::kError) {
			why.Append(" did not start: ");
			why.Append(done.error.View());
		}
		else {
			why.Append(" failed (exit ");
			why.AppendInt(done.exitCode);
			why.Append(")");
		}
		Core::String program = !step->m_Shell.IsEmpty() ? ProgramWord(step->m_Shell.View()) : step->m_Argv[0];
		Core::String path;
		Core::String extensions;
		if (!Platform::TryGetEnvironmentVariable("PATH", path)) path = Core::String();
		if (!Platform::TryGetEnvironmentVariable("PATHEXT", extensions)) extensions = Core::String(".COM;.EXE;.BAT;.CMD");
		if (!step->m_Setting.IsEmpty() && !FindsProgram(program.View(), step->m_Cwd.View(), path.View(), extensions.View())) {
			why.Append(". ");
			why.Append(MissingProgramText(program.View(), step->m_Setting.View()).View());
		}
		Core::String tail = StepLogTail(done.output.View());
		if (!tail.IsEmpty()) {
			why.Append(":\n");
			why.Append(tail.View());
		}
		return why.ToString();
	}

	Core::String RunProjectSteps(const Core::Array<ProjectStep*>& steps, Core::StringBuilder& log) {
		for (const ProjectStep* step : steps) {
			Core::String problem = RunProjectStep(step, log);
			if (!problem.IsEmpty()) return problem;
		}
		return Core::String();
	}
}
