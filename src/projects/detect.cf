include "detect.ch"
include "host/server.ch"
include "plugins/context.ch"
include "plugins/languages.ch"
include "fs/walk.ch"
include "fs/search.ch"

namespace Ied
{
	// The language whose projectIcons marker lies in `names`, first entry first; "" for none.
	static Core::String MarkedLanguage(const Core::Array<Contribution>& icons, const Core::Array<Core::String>& names) {
		for (const Contribution& icon : icons) {
			Serialization::DomNode markers = icon.entry.Member("markers");
			for (int64 i = 0; i < markers.Count(); ++i)
				if (MarkerNamed(names, markers.At(i).AsView())) return Core::String(icon.entry.Member("languageId").AsView());
		}
		return Core::String();
	}

	static bool Drawn(const Core::Array<Contribution>& icons, Core::StringView language) {
		for (const Contribution& icon : icons)
			if (icon.entry.Member("languageId").AsView() == language) return true;
		return false;
	}

	// The language most of the folder's files are in, of those `icons` draw (a tie: the one drawn first); "" for none.
	static Core::String CountedLanguage(Server* server, Workspace* ws, const FS::Path& folder, const Core::Array<Contribution>& icons) {
		Core::Array<Serialization::DomNode> contributes;
		for (Plugin* plugin : server->plugins->LoadedFor(ws)) contributes.Push(plugin->manifest->contributes);
		Core::HashMap<Core::String, int64> counts;
		int64 seen = 0;
		FileWalk walk;
		walk.root = folder;
		walk.exclude = DefaultSearchExcludes();
		walk.useIgnoreFiles = true;
		walk.cancel = nullptr;
		walk.Run([&contributes, &icons, &counts, &seen](Core::StringView path) -> bool {
			Core::String language = LanguageFor(contributes, path);
			int64 had = 0;
			counts.TryGet(language, had);
			if (Drawn(icons, language.View())) counts.At(language) = had + 1;
			seen += 1;
			return seen < kDetectFilesMost;
		});
		Core::String best;
		int64 most = 0;
		for (const Contribution& icon : icons) {
			int64 count = 0;
			Core::String language = Core::String(icon.entry.Member("languageId").AsView());
			if (counts.TryGet(language, count) && count > most) {
				best = language;
				most = count;
			}
		}
		return best;
	}

	// Whether the plugin giving `preset` builds `language`: it declares no languages, or that one among them.
	static bool OfLanguage(const Contribution& preset, Core::StringView language) {
		Serialization::DomNode languages = preset.plugin->manifest->contributes.Member("languages");
		if (languages.Count() == 0) return true;
		for (int64 i = 0; i < languages.Count(); ++i)
			if (languages.At(i).Member("id").AsView() == language) return true;
		return false;
	}

	static Core::Array<Core::String> DetectedPresets(const Core::Array<Contribution>& presets, const Core::Array<Core::String>& names, Core::StringView language) {
		Core::Array<Contribution> found;
		for (const Contribution& preset : presets) {
			Core::StringView detect = preset.entry.Member("detect").AsView();
			if (!detect.IsEmpty() && MarkerNamed(names, detect) && OfLanguage(preset, language)) found.Push(preset);
		}
		Core::Array<Core::String> ids;
		for (const Contribution& preset : found) {
			bool extended = false;
			for (const Contribution& other : found) extended = extended || other.entry.Member("extends").AsView() == preset.entry.Member("id").AsView();
			if (!extended) ids.Push(Core::String(preset.entry.Member("id").AsView()));
		}
		return ids;
	}

	FolderFacts DetectFolder(Server* server, Workspace* ws, const FS::Path& folder) {
		FolderFacts facts;
		Core::Array<Contribution> icons = server->plugins->Entries(ws, Core::StringView("projectIcons"));
		Core::Array<Core::String> names = FolderNames(folder);
		facts.language = MarkedLanguage(icons, names);
		if (facts.language.IsEmpty()) facts.language = CountedLanguage(server, ws, folder, icons);
		facts.presets = DetectedPresets(server->plugins->Entries(ws, Core::StringView("taskPresets")), names, facts.language.View());
		return facts;
	}
}
