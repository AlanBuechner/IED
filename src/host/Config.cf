include "Config.ch"

namespace Ied
{
	const int64 c_Kilobyte = 1024;

	ServerConfig DefaultConfig() {
		ServerConfig config;
		config.m_Version = Core::String("0.1.0");
		config.m_Host = Core::String("127.0.0.1");
		config.m_Port = 8765;
		config.m_IdleTimeoutMs = 60000;
		config.m_OutboundBudget = 4 * c_Kilobyte * c_Kilobyte;
		config.m_CoalesceBytes = 256 * c_Kilobyte;
		return config;
	}

	// A count small enough that any unit it is multiplied by still fits.
	static bool ParseCount(Core::StringView text, int64& value) {
		const int64 kMostCount = 1000000000;
		int64 parsed = 0;
		if (!Core::ParseInt64(text, parsed) || parsed < 0 || parsed > kMostCount) return false;
		value = parsed;
		return true;
	}

	static bool Fail(Core::String& error, Core::StringView option, const char* why) {
		Core::StringBuilder text;
		text.Append(option);
		text.Append(": ");
		text.Append(why);
		error = text.ToString();
		return false;
	}

	// --config-token <role> <name>: the two values after it.
	static bool ParseConfigToken(const Core::Array<Core::String>& arguments, int64& i, ServerConfig& config, Core::String& error) {
		Core::StringView option = arguments[i].View();
		if (i + 2 >= arguments.Count()) return Fail(error, option, "takes a role (reader or admin) and a name");
		Core::StringView role = arguments[i + 1].View();
		Core::StringView name = arguments[i + 2].View();
		if (role != "reader" && role != "admin") return Fail(error, option, "takes a role, reader or admin, then a name");
		if (name.Trimmed().IsEmpty()) return Fail(error, option, "takes a name after its role (what the token is for: a machine, a tool)");
		config.m_ConfigTokenRole = Core::String(role);
		config.m_ConfigTokenName = Core::String(name.Trimmed());
		i += 2;
		return true;
	}

	// One option and its value (when it takes one) at `i`; `i` moves past them.
	static bool ParseOption(const Core::Array<Core::String>& arguments, int64& i, ServerConfig& config, Core::String& error) {
		Core::StringView option = arguments[i].View();
		if (option == "--config-token") return ParseConfigToken(arguments, i, config, error);
		if (option == "--test-hooks") { config.m_TestHooks = true; return true; }
		if (option == "--quiet") { config.m_Quiet = true; return true; }
		if (option == "--relaunched") { config.m_Relaunched = true; return true; }
		if (i + 1 >= arguments.Count()) return Fail(error, option, "needs a value (or is unknown)");
		i += 1;
		Core::StringView value = arguments[i].View();
		int64 number = 0;
		if (option == "--role") {
			if (value != "master" && value != "workspace") return Fail(error, option, "is master or workspace");
			config.m_Role = value == "workspace" ? ServerRole::Workspace : ServerRole::Master;
		}
		else if (option == "--ws-id") config.m_WsId = Core::String(value);
		else if (option == "--master") config.m_MasterControl = Core::String(value);
		else if (option == "--state") config.m_StateDir = Core::String(value);
		else if (option == "--log") config.m_LogPath = Core::String(value);
		else if (option == "--restarted-after") config.m_RestartedAfter = Core::String(value);
		else if (option == "--host") config.m_Host = Core::String(value);
		else if (option == "--static") config.m_StaticDir = Core::String(value);
		else if (option == "--data") config.m_DataDir = Core::String(value);
		else if (option == "--home") config.m_HomeDir = Core::String(value);
		else if (option == "--app-data") config.m_AppDataDir = Core::String(value);
		else if (option == "--control") config.m_ControlName = Core::String(value);
		else if (option == "--workspace") config.m_Workspaces.Push(Core::String(value));
		else if (option == "--allow-origin") config.m_AllowOrigins.Push(Core::String(value));
		else if (option == "--allow-host") config.m_AllowHosts.Push(Core::String(value));
		else if (option == "--config-root") config.m_ConfigRoot = Core::String(value);
		else if (option == "--tls-identity") config.m_TlsIdentity = Core::String(value);
		else if (option == "--debug-scripts") {
			if (value != "on" && value != "off") return Fail(error, option, "is on or off");
			config.m_DebugScripts = value == "on" ? 1 : 0;
		}
		else if (!ParseCount(value, number)) return Fail(error, option, "is unknown, or its value is not a count");
		else if (option == "--port" && number <= 65535) {
			config.m_Port = (int32)number;
			config.m_PortGiven = true;
		}
		else if (option == "--idle-timeout") config.m_IdleTimeoutMs = number * 1000;
		else if (option == "--outbound-budget-mb") config.m_OutboundBudget = number * c_Kilobyte * c_Kilobyte;
		else if (option == "--coalesce-kb") config.m_CoalesceBytes = number * c_Kilobyte;
		else return Fail(error, option, "is unknown or out of range");
		return true;
	}

	bool ParseArguments(const Core::Array<Core::String>& arguments, ServerConfig& config, Core::String& error) {
		config.m_Arguments = arguments;
		for (int64 i = 0; i < arguments.Count(); ++i)
			if (!ParseOption(arguments, i, config, error)) return false;
		if (!config.m_ConfigTokenRole.IsEmpty() && config.m_ConfigRoot.IsEmpty()) {
			error = Core::String("--config-token needs --config-root: the config server's folder, whose access.json keeps the token's hash");
			return false;
		}
		if (IsConfigServer(config) && IsWorkspaceServer(config)) {
			error = Core::String("--config-root is the master's (docs/35): a workspace server serves no configuration");
			return false;
		}
		if (!IsWorkspaceServer(config)) return true;
		if (config.m_WsId.IsEmpty() || config.m_MasterControl.IsEmpty() || config.m_Workspaces.Count() != 1) {
			error = Core::String("--role workspace needs --ws-id, --master and one --workspace (only the master starts one)");
			return false;
		}
		// Loopback only, on a port of the system's choosing (docs/11 "Workspace servers").
		config.m_Host = Core::String("127.0.0.1");
		config.m_Port = 0;
		config.m_PortGiven = false;
		return true;
	}

	bool IsWorkspaceServer(const ServerConfig& config) { return config.m_Role == ServerRole::Workspace; }

	bool IsConfigServer(const ServerConfig& config) { return !config.m_ConfigRoot.IsEmpty(); }

	Core::String StateFolder(const ServerConfig& config) { return config.m_StateDir.IsEmpty() ? DataFolder(config) : config.m_StateDir; }

	Core::String LogPath(const ServerConfig& config) {
		if (!config.m_LogPath.IsEmpty()) return config.m_LogPath;
		return Core::String((FS::Path(DataFolder(config).View()) / "logs" / "server.log").View());
	}

	static Core::String RandomHex(int32 bytes) {
		uint8[16] random;
		Platform::RandomBytes((void*)&random[0], bytes);
		Core::StringBuilder text;
		for (int32 i = 0; i < bytes; ++i) text.AppendUIntBase((uint64)random[i], 16, 2);
		return text.ToString();
	}

#if defined(PLATFORM_LINUX)
	// A per-user folder on Linux (the XDG base directories): $<variable>, else $HOME/<fallback>, with "ied" in it.
	static Core::String XdgFolder(const char* variable, const char* fallback) {
		Core::String base;
		if (!Platform::TryGetEnvironmentVariable(variable, base) || base.IsEmpty())
			base = Core::String((FS::Path(Platform::GetEnvironmentVariable("HOME").View()) / fallback).View());
		return Core::String((FS::Path(base.View()) / "ied").View());
	}
#endif

	Core::String DataFolder(const ServerConfig& config) {
		if (!config.m_DataDir.IsEmpty()) return config.m_DataDir;
		if (config.m_TestHooks) return Core::String((FS::TempDirectory() / (Core::String("ied-data-") + RandomHex(6).View()).View()).View());
#if defined(PLATFORM_LINUX)
		return XdgFolder("XDG_STATE_HOME", ".local/state");
#else
		return Core::String((FS::Path(Platform::GetEnvironmentVariable("LOCALAPPDATA").View()) / "IED").View());
#endif
	}

	Core::String HomeFolder(const ServerConfig& config) {
		if (!config.m_HomeDir.IsEmpty()) return config.m_HomeDir;
		for (FS::Path at = Platform::ExecutablePath().Parent(); !at.IsEmpty(); at = at.Parent()) {
			if (FS::FileExists((at / "shared" / "host-api" / "schemas" / "plugin-manifest.v1.schema.json").CStr())) return Core::String(at.View());
			if (at.Parent().View() == at.View()) break;
		}
		return Core::String();
	}

	Core::String StaticFolder(const ServerConfig& config) {
		if (!config.m_StaticDir.IsEmpty()) return config.m_StaticDir;
		Core::String home = HomeFolder(config);
		return home.IsEmpty() ? home : Core::String((FS::Path(home.View()) / "frontend").View());
	}

	Core::String AppDataFolder(const ServerConfig& config) {
		if (!config.m_AppDataDir.IsEmpty()) return config.m_AppDataDir;
		if (config.m_TestHooks) return Core::String((FS::Path(DataFolder(config).View()) / "app").View());
#if defined(PLATFORM_LINUX)
		return XdgFolder("XDG_CONFIG_HOME", ".config");
#else
		return Core::String((FS::Path(Platform::GetEnvironmentVariable("APPDATA").View()) / "IED").View());
#endif
	}

	Core::String ControlName(const ServerConfig& config) {
		if (!config.m_ControlName.IsEmpty()) return config.m_ControlName;
		if (config.m_TestHooks) return Net::UserLocalName((Core::String("ied-test-") + RandomHex(6).View()).CStr());
		return Net::UserLocalName("ied");
	}

	Core::String BrowserHost(const ServerConfig& config) {
		Core::StringView host = config.m_Host.View();
		if (host == "0.0.0.0" || host.IsEmpty()) return Core::String("127.0.0.1");
		if (host == "::") return Core::String("[::1]");
		return host.IndexOf(':', 0) >= 0 ? (Core::String("[") + host) + "]" : Core::String(host);
	}

	Core::String LaunchUrl(const ServerConfig& config, int32 port, Core::StringView token, Core::StringView fragment) {
		Core::StringBuilder url;
		url.Append(config.m_TlsIdentity.IsEmpty() ? "http://" : "https://");
		url.Append(BrowserHost(config).View());
		url.AppendByte(':');
		url.AppendInt(port);
		url.AppendByte('/');
		if (!token.IsEmpty()) {
			url.Append("?t=");
			url.Append(token);
		}
		if (!fragment.IsEmpty()) {
			url.AppendByte('#');
			url.Append(fragment);
		}
		return url.ToString();
	}
}
