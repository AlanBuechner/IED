include "servers.ch"
include "server.ch"
include "trust.ch"
include "programs.ch"

namespace Ied
{
	const int64 kServerPollNs = 100000000;
	const int64 kExitWindowMs = 60000;

	static int64 NowMs() { return Platform::UnixTimeNs() / 1000000; }

	const char* ServerStateName(ServerState state) {
		if (state == ServerState::Starting) return "starting";
		if (state == ServerState::Ready) return "ready";
		if (state == ServerState::Restarting) return "restarting";
		if (state == ServerState::Stopping) return "stopping";
		return "failed";
	}

	Core::String FolderKey(Core::StringView root) {
		Core::String digest = TextDigest(TrustKey(root).View());
		return Core::String(digest.View().Substring(0, 16));
	}

	bool SameSecret(Core::StringView a, Core::StringView b) {
		if (a.IsEmpty() || a.ByteLength() != b.ByteLength()) return false;
		return Crypto::ConstantTimeEquals((const void*)a.Data(), (const void*)b.Data(), a.ByteLength());
	}

	void WorkspaceServers::Init(Server* server) {
		this.server = server;
		masterControl = ControlName(server->config);
		WorkspaceServers* self = this;
		server->rpc.Register("ws.restart", [self](Call& call, const Params& params) -> Core::String { return self->RestartMethod(call, params); });
		server->rpc.Register("ws.close", [self](Call& call, const Params& params) -> Core::String { return self->CloseMethod(call, params); });
	}

	WorkspaceServer* WorkspaceServers::Find(Core::StringView wsId) const {
		for (WorkspaceServer* record : records)
			if (record->wsId.View() == wsId) return record;
		return nullptr;
	}

	void WorkspaceServers::Start(Workspace* ws) {
		WorkspaceServer* record = new WorkspaceServer();
		record->wsId = ws->wsId;
		record->target = Core::String(ws->target.IsEmpty() ? ws->root.View() : ws->target.View());
		record->root = Core::String(ws->root.View());
		record->control = (masterControl + "-") + ws->wsId.View();
		Core::String key = FolderKey(ws->root.View());
		FS::Path data = FS::Path(server->config.dataDir.View());
		record->stateDir = Core::String((data / "servers" / key.View()).View());
		record->logPath = Core::String((data / "logs" / (Core::String("workspace-") + key.View() + ".log").View()).View());
		record->state = ServerState::Starting;
		record->exitCode = -1;
		records.Push(record);
		if (!running) return;
		WorkspaceServers* self = this;
		Threading::Thread::Run([self, record]() { self->Keep(record); }).Detach();
	}

	void WorkspaceServers::Begin() {
		if (running) return;
		running = true;
		WorkspaceServers* self = this;
		for (WorkspaceServer* record : records) Threading::Thread::Run([self, record]() { self->Keep(record); }).Detach();
	}

	void WorkspaceServers::Retarget(Core::StringView wsId, Core::StringView target) {
		WorkspaceServer* record = Find(wsId);
		if (record) record->target = Core::String(target);
	}

	Core::String WorkspaceServers::StateJson(Core::StringView wsId) const {
		WorkspaceServer* record = Find(wsId);
		if (!record) return Core::String("null");
		JsonWriter json;
		json.BeginObject();
		json.Field("state", ServerStateName(record->state));
		json.IntField("pid", record->pid);
		json.IntField("startedMs", record->startedMs);
		json.IntField("restarts", record->restarts);
		if (record->exitCode >= 0) json.IntField("exitCode", record->exitCode);
		if (!record->problem.IsEmpty()) json.Field("problem", record->problem.View());
		json.Field("log", record->logPath.View());
		json.EndObject();
		return json.ToString();
	}

	// workspace.changed on the server topic: the workspace's summary with its server's state.
	void WorkspaceServers::Changed(WorkspaceServer* record) {
		record->changed.NotifyAll();
		Workspace* ws = server->workspaces->Listed(record->wsId.View());
		if (ws) server->hub.Publish(Core::StringView("server"), "workspace.changed", ws->SummaryJson().View());
	}

	Core::Array<Core::String> WorkspaceServers::Arguments(const WorkspaceServer* record) const {
		const ServerConfig& config = server->config;
		Core::Array<Core::String> argv;
		argv.Push(Core::String("--role"));
		argv.Push(Core::String("workspace"));
		argv.Push(Core::String("--ws-id"));
		argv.Push(record->wsId);
		argv.Push(Core::String("--workspace"));
		argv.Push(record->target);
		argv.Push(Core::String("--master"));
		argv.Push(masterControl);
		argv.Push(Core::String("--control"));
		argv.Push(record->control);
		argv.Push(Core::String("--data"));
		argv.Push(config.dataDir);
		argv.Push(Core::String("--app-data"));
		argv.Push(config.appDataDir);
		argv.Push(Core::String("--state"));
		argv.Push(record->stateDir);
		argv.Push(Core::String("--log"));
		argv.Push(record->logPath);
		if (!config.homeDir.IsEmpty()) {
			argv.Push(Core::String("--home"));
			argv.Push(config.homeDir);
		}
		if (!config.staticDir.IsEmpty()) {
			argv.Push(Core::String("--static"));
			argv.Push(config.staticDir);
		}
		if (config.testHooks) argv.Push(Core::String("--test-hooks"));
		if (config.quiet) argv.Push(Core::String("--quiet"));
		if (config.debugScripts >= 0) {
			argv.Push(Core::String("--debug-scripts"));
			argv.Push(Core::String(config.debugScripts ? "on" : "off"));
		}
		Core::StringBuilder idle;
		idle.AppendInt(config.idleTimeoutMs / 1000);
		argv.Push(Core::String("--idle-timeout"));
		argv.Push(idle.ToString());
		Core::StringBuilder budget;
		budget.AppendInt(config.outboundBudget / (1024 * 1024));
		argv.Push(Core::String("--outbound-budget-mb"));
		argv.Push(budget.ToString());
		Core::StringBuilder coalesce;
		coalesce.AppendInt(config.coalesceBytes / 1024);
		argv.Push(Core::String("--coalesce-kb"));
		argv.Push(coalesce.ToString());
		if (!record->restartedAfter.IsEmpty()) {
			argv.Push(Core::String("--restarted-after"));
			argv.Push(record->restartedAfter);
		}
		return argv;
	}

	// The process started (the lock is held): false with `problem` when it could not be.
	bool WorkspaceServers::StartProcess(WorkspaceServer* record, Core::String& problem) {
		record->secret = NewSecret();
		Process::StartInfo info;
		info.program = Core::String(Platform::ExecutablePath().View());
		info.arguments = Arguments(record);
		info.environment.Push(Core::String("IED_SERVER_SECRET=") + record->secret.View());
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Inherit;
		info.killOnClose = true;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			problem = Core::String("it did not start: ") + started.Error();
			return false;
		}
		Process::Child* child = new Process::Child();
		*child = take(started);
		record->child = child;
		record->pid = (int64)child->Id();
		record->startedMs = NowMs();
		record->port = 0;
		return true;
	}

	// Waits (no lock held) until the server's pipe answers its status, or it exits, or kServerReadyMs pass; its port
	// then. False with `problem` when it is not ready.
	bool WorkspaceServers::AwaitStarted(WorkspaceServer* record, Core::String& problem) {
		const int64 deadline = clock_now_ns() + kServerReadyMs * 1000000;
		while (clock_now_ns() < deadline) {
			if (record->child->Wait(0) != Process::kTimedOut) {
				problem = Core::String("it ended before it was ready");
				return false;
			}
			Net::LocalStream stream = Net::LocalStream::Connect(record->control.CStr(), 200);
			if (stream.IsOpen()) {
				Launch::Reply reply = Launch::Ask(stream, Core::StringView("status"), Core::StringView(""));
				Serialization::DomDoc* doc = new Serialization::DomDoc();
				Serialization::ReadResult read = Serialization::ReadJson(reply.result.View(), *doc);
				const int64 port = read.Ok() ? read.root.Member("result").Member("port").AsInt() : 0;
				// Its own answer, not one from the server it replaces still holding the pipe a moment.
				const bool own = read.Ok() && read.root.Member("result").Member("pid").AsInt() == record->pid;
				if (reply.ok && port > 0 && own) {
					Threading::LockGuard guard(server->lock);
					record->port = (int32)port;
					return true;
				}
			}
			Threading::Thread::Sleep(kServerPollNs);
		}
		problem = Core::String("it was not ready within a minute");
		return false;
	}

	// One server's life: started, waited for, watched; started again after an exit nobody asked for, or after a
	// restart; until it is closed or the master stops.
	void WorkspaceServers::Keep(WorkspaceServer* record) {
		for (;;) {
			Core::String problem;
			bool launched = false;
			{
				Threading::LockGuard guard(server->lock);
				if (record->closing || record->shutdown) break;
				launched = StartProcess(record, problem);
				// A restart asked for from here on is this run's.
				record->restartAsked = false;
				Core::StringBuilder line;
				line.Append("workspace server ");
				line.Append(record->wsId.View());
				if (launched) {
					line.Append(" started for ");
					line.Append(record->target.View());
					line.Append(", pid ");
					line.AppendInt(record->pid);
				}
				else {
					line.Append(" could not start: ");
					line.Append(problem.View());
				}
				server->Log(line.View());
			}
			if (launched && AwaitStarted(record, problem)) {
				Threading::LockGuard guard(server->lock);
				// Unless a restart or a close was asked while it started: its stop is on the way.
				if (!record->restartAsked && !record->closing && !record->shutdown) {
					record->state = ServerState::Ready;
					Changed(record);
				}
			}
			// One that never became ready (it hangs in its start) is ended, and counts as an exit.
			else if (launched && record->child->Wait(0) == Process::kTimedOut) record->child->Kill();
			const int64 code = launched ? record->child->Wait(Process::kWaitForever) : -1;
			Threading::LockGuard guard(server->lock);
			Exited(record, code, problem.View());
			if (record->closing || record->shutdown) break;
			while (record->state == ServerState::Failed && !record->restartAsked && !record->closing && !record->shutdown) record->changed.Wait(server->lock);
			if (record->closing || record->shutdown) break;
		}
		Threading::LockGuard guard(server->lock);
		record->changed.NotifyAll();
		if (!record->closing) return;
		for (int64 i = 0; i < records.Count(); ++i)
			if (records[i] == record) records.RemoveAt(i);
		server->workspaces->Closed(record->wsId.View());
	}

	// How a run ended (the lock is held): asked for, or not - then counted, and started again unless it was the
	// kServerExitsPerMinute'th within a minute.
	void WorkspaceServers::Exited(WorkspaceServer* record, int64 code, Core::StringView how) {
		// The Child is not closed here: a stopper thread may still wait on it; it closes when it is collected.
		record->child = nullptr;
		record->port = 0;
		record->exitCode = code;
		Core::String ended = code >= 0 ? Launch::ExitCodeText(code) : Core::String(how);
		const bool asked = record->restartAsked || record->closing || record->shutdown;
		server->Log((((Core::String("workspace server ") + record->wsId.View()) + (asked ? " stopped (" : " exited unasked (")) + ended.View() + "); its log: " + record->logPath.View()).View());
		if (record->closing || record->shutdown) {
			record->state = ServerState::Stopping;
			Changed(record);
			return;
		}
		if (record->restartAsked) {
			record->restartedAfter = Core::String("a restart someone asked for");
			record->problem = Core::String();
			record->state = ServerState::Restarting;
			record->restarts += 1;
			Changed(record);
			return;
		}
		const int64 now = NowMs();
		Core::Array<int64> recent;
		for (int64 at : record->exitsMs)
			if (now - at < kExitWindowMs) recent.Push(at);
		recent.Push(now);
		record->exitsMs = recent;
		record->problem = (Core::String("its last run ended: ") + ended.View()) + (how.IsEmpty() || code < 0 ? Core::String("") : Core::String(" (") + how + ")").View();
		record->restartedAfter = record->problem;
		if (recent.Count() >= kServerExitsPerMinute) {
			record->state = ServerState::Failed;
			server->Log((((Core::String("workspace server ") + record->wsId.View()) + " failed: it ended ") + Core::String("three times within a minute") + "; ws.restart starts it again").View());
		}
		else {
			record->state = ServerState::Restarting;
			record->restarts += 1;
		}
		Changed(record);
	}

	// Its pipe told to stop, from a thread of its own (no lock held); ended after kServerStopMs if it has not.
	void WorkspaceServers::AskStop(WorkspaceServer* record) {
		Core::String control = record->control;
		Process::Child* child = record->child;
		Threading::Thread::Run([control, child]() {
			Net::LocalStream stream = Net::LocalStream::Connect(control.CStr(), 2000);
			if (stream.IsOpen()) Launch::Ask(stream, Core::StringView("stop"), Core::StringView(""));
			if (child && child->Wait((int32)kServerStopMs) == Process::kTimedOut) child->Kill();
		}).Detach();
	}

	void WorkspaceServers::Restart(Core::StringView wsId) {
		WorkspaceServer* record = Find(wsId);
		if (!record || record->closing) throw RpcError(ErrorCode::NotFound, (Core::String("no workspace ") + wsId).View());
		record->restartAsked = true;
		server->Log(((Core::String("workspace server ") + wsId) + ": restart asked").View());
		if (record->state == ServerState::Failed) {
			record->state = ServerState::Starting;
			record->exitsMs.Clear();
			Changed(record);
			return;
		}
		record->state = ServerState::Restarting;
		Changed(record);
		AskStop(record);
	}

	void WorkspaceServers::Close(Core::StringView wsId) {
		WorkspaceServer* record = Find(wsId);
		if (!record || record->closing) throw RpcError(ErrorCode::NotFound, (Core::String("no workspace ") + wsId).View());
		record->closing = true;
		record->state = ServerState::Stopping;
		server->Log(((Core::String("workspace ") + wsId) + ": closing").View());
		Changed(record);
		if (record->child) AskStop(record);
	}

	bool WorkspaceServers::AwaitReady(Core::StringView wsId, int64 ms, int32& port, Core::String& secret) {
		Threading::LockGuard guard(server->lock);
		const int64 deadline = clock_now_ns() + ms * 1000000;
		for (;;) {
			WorkspaceServer* record = Find(wsId);
			if (!record || record->closing || record->shutdown || record->state == ServerState::Failed) return false;
			if (record->state == ServerState::Ready && record->port > 0) {
				port = record->port;
				secret = record->secret;
				return true;
			}
			const int64 left = deadline - clock_now_ns();
			if (left <= 0) return false;
			record->changed.WaitFor(server->lock, left);
		}
	}

	void WorkspaceServers::StopAll() {
		Core::Array<Core::String> controls;
		Core::Array<Process::Child*> children;
		{
			Threading::LockGuard guard(server->lock);
			for (WorkspaceServer* record : records) {
				record->shutdown = true;
				record->changed.NotifyAll();
				if (!record->child) continue;
				controls.Push(record->control);
				children.Push(record->child);
			}
		}
		for (int64 i = 0; i < controls.Count(); ++i) {
			Core::String control = controls[i];
			Net::LocalStream stream = Net::LocalStream::Connect(control.CStr(), 2000);
			if (stream.IsOpen()) Launch::Ask(stream, Core::StringView("stop"), Core::StringView(""));
		}
		const int64 deadline = clock_now_ns() + kServerStopMs * 1000000;
		for (Process::Child* child : children) {
			const int64 left = (deadline - clock_now_ns()) / 1000000;
			if (child->Wait(left > 0 ? (int32)left : 0) == Process::kTimedOut) child->Kill();
		}
	}

	void WorkspaceServers::TellAll(Core::StringView method, Core::StringView paramsJson) {
		Core::Array<Core::String> controls;
		for (WorkspaceServer* record : records)
			if (record->state == ServerState::Ready && !record->closing && !record->shutdown) controls.Push(record->control);
		if (controls.IsEmpty()) return;
		Threading::UnlockGuard released(server->lock);
		for (const Core::String& control : controls) {
			Net::LocalStream stream = Net::LocalStream::Connect(control.CStr(), 2000);
			if (stream.IsOpen()) Launch::AskWithin(stream, method, paramsJson, 10000);
		}
	}

	Core::String WorkspaceServers::RestartMethod(Call& call, const Params& params) {
		Core::String wsId = params.Str("wsId");
		Restart(wsId.View());
		Workspace* ws = server->workspaces->Listed(wsId.View());
		return ws->SummaryJson();
	}

	Core::String WorkspaceServers::CloseMethod(Call& call, const Params& params) {
		Close(params.Str("wsId").View());
		return Core::String("{}");
	}
}
