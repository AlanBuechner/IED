include "server.ch"

namespace Ied
{
	Core::String NewEpoch() {
		uint8[6] bytes;
		Platform::RandomBytes((void*)&bytes[0], 6);
		Core::StringBuilder text;
		text.Append("e-");
		for (int32 i = 0; i < 6; ++i) text.AppendUIntBase((uint64)bytes[i], 16, 2);
		return text.ToString();
	}

	void Server::Init(ServerConfig config) {
		this.config = config;
		this.config.dataDir = DataFolder(config);
		this.config.homeDir = HomeFolder(config);
		this.config.staticDir = StaticFolder(this.config);
		this.config.appDataDir = AppDataFolder(this.config);
		this.config.stateDir = StateFolder(this.config);
		this.config.logPath = LogPath(this.config);
		startedMs = Platform::UnixTimeNs() / 1000000;
		logFile.Open(this.config.logPath.View());
		LogStart();
		Core::String trustError;
		trust.Load((FS::Path(this.config.appDataDir.View()) / "trust.json").View(), trustError);
		if (!trustError.IsEmpty()) Log(trustError.View());
		Core::String recentError;
		recent.Load((FS::Path(this.config.dataDir.View()) / "recent.json").View(), recentError);
		if (!recentError.IsEmpty()) Log(recentError.View());
		Core::String schemaError;
		if (!schemas.Load(this.config.homeDir.View(), schemaError)) Log((Core::String("the host API schemas are missing: ") + schemaError.View()).View());
		epoch = NewEpoch();
		Server* self = this;
		// Opening the configured workspaces reaches settings, plugins and documents: they exist first.
		presence = new Presence(self);
		auth = new Auth(self);
		plugins = new PluginHost(self);
		code = new CodeRuntime(self);
		settings = new Settings(self);
		documents = new Documents(self);
		blobs = new Blobs();
		outputs = new Outputs(self);
		layouts = new Layouts(self);
		trash = new Trash(self);
		search = new Search(self);
		diagnostics = new Diagnostics(self);
		lsp = new LspPool(self);
		tasks = new Tasks(self);
		breakpoints = new Breakpoints(self);
		debugger = new Debugger(self);
		tools = new Tools(self);
		projects = new ProjectTemplates(self);
		projectManager = new ProjectManager(self);
		if (IsMaster()) {
			servers = new WorkspaceServers(self);
			proxy = new Proxy(self);
		}
		else master = new MasterLink(this.config.masterControl.View());
		logThread = Threading::Thread::Run([self]() { self->logPump.Run(self); });
		// From here on the log pump, the git thread and each workspace's watcher once it opens reach the services under the
		// lock.
		Threading::LockGuard guard(lock);
		if (!this.config.restartedAfter.IsEmpty()) Log((Core::String("restarted after: ") + this.config.restartedAfter.View()).View());
		workspaces = new Workspaces(self);
		if (config.testHooks) testHooks = new TestHooks(self);
	}

	Core::String LogStamp(int64 unixNs) {
		Platform::CalendarTime now = Platform::LocalCalendar(unixNs);
		Core::StringBuilder stamp;
		stamp.AppendByte('[');
		stamp.AppendIntBase(now.hour, 10, 2);
		stamp.AppendByte(':');
		stamp.AppendIntBase(now.minute, 10, 2);
		stamp.AppendByte(':');
		stamp.AppendIntBase(now.second, 10, 2);
		stamp.Append("] ");
		return stamp.ToString();
	}

	void Server::Log(Core::StringView line) {
		Core::String stamped = LogStamp(Platform::UnixTimeNs()) + line;
		if (!config.quiet) Platform::WriteError(((Core::String("[ied] ") + stamped.View()) + "\n").View());
		logFile.Write(line);
		logPump.Push(stamped.View());
	}

	// The first line of a run in logs/server.log: which server, and where its state and install are.
	void Server::LogStart() {
		Core::StringBuilder line;
		line.Append("start: ied-server ");
		line.Append(config.version.View());
		if (!IsMaster()) {
			line.Append(", workspace server ");
			line.Append(config.wsId.View());
			line.Append(" for ");
			line.Append(config.workspaces[0].View());
		}
		line.Append(" (");
		line.Append(Platform::ExecutablePath().View());
		line.Append("), data ");
		line.Append(config.dataDir.View());
		line.Append(", home ");
		line.Append(config.homeDir.View());
		if (config.relaunched) line.Append(", relaunched");
		logFile.Write(line.View());
	}

	void LogPump::Push(Core::StringView line) {
		Threading::LockGuard guard(lock);
		pending.Push(Core::String(line));
		ready.NotifyOne();
	}

	void LogPump::Run(Server* server) {
		for (;;) {
			Core::Array<Core::String> lines;
			{
				Threading::LockGuard guard(lock);
				while (pending.IsEmpty()) ready.Wait(lock);
				lines = pending;
				pending.Clear();
			}
			Threading::LockGuard serverGuard(server->lock);
			for (const Core::String& line : lines) server->outputs->Log(line.View());
		}
	}

	bool Server::RecordTrust(const FS::Path& root, bool trusted) {
		if (IsMaster()) {
			if (!trust.Set(root, trusted)) return false;
			auth->Record(trusted ? "workspace-trusted" : "workspace-untrusted", (Core::String("\"root\":") + JsonString(root.View()).View()).View());
			workspaces->TrustSaid(root, trusted);
			return true;
		}
		JsonWriter params;
		params.BeginObject();
		params.Field("root", root.View());
		params.BoolField("trusted", trusted);
		params.EndObject();
		Core::String result;
		Core::String problem;
		if (!master->Call(&lock, Core::StringView("master.trust"), params.View(), result, problem)) {
			Log((Core::String("the trust choice did not reach the master: ") + problem.View()).View());
			return false;
		}
		trust.Remember(root, trusted);
		return true;
	}

	void Server::RemoveSession(Session* session) {
		for (int64 i = 0; i < sessions.Count(); ++i)
			if (sessions[i] == session) { sessions.RemoveAt(i); return; }
	}

	void Server::Restart() {
		Core::Array<Session*> closing;
		{
			Threading::LockGuard guard(lock);
			if (testHooks) testHooks->OnRestart();
			epoch = NewEpoch();
			hub.ClearRings();
			rpc.ClearOps();
			closing = sessions;
			for (int64 i = 0; i < closing.Count(); ++i) closing[i]->Push(ByeFrame("server-restart").View());
		}
		for (int64 i = 0; i < closing.Count(); ++i) closing[i]->FlushAndClose(1001, "server-restart");
		Core::StringBuilder line;
		line.Append("simulated restart; new epoch ");
		line.Append(epoch.View());
		Log(line.View());
	}
}
