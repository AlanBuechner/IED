include "control.ch"
include "server.ch"

namespace Ied
{
	// JSON-RPC 2.0's own error codes, and the one for everything a method refuses.
	const int32 kParseError = -32700;
	const int32 kInvalidRequest = -32600;
	const int32 kMethodNotFound = -32601;
	const int32 kInvalidParams = -32602;
	const int32 kMethodFailed = -32000;

	Core::String RpcResponse(Core::StringView id, Core::StringView result, int32 code, Core::StringView message) {
		JsonWriter json;
		json.BeginObject();
		json.Field("jsonrpc", "2.0");
		json.RawField("id", id.IsEmpty() ? Core::StringView("null") : id);
		if (code == 0) json.RawField("result", result);
		else {
			json.Key(Core::StringView("error"));
			json.BeginObject();
			json.IntField("code", code);
			json.Field("message", message);
			json.EndObject();
		}
		json.EndObject();
		return json.ToString();
	}

	bool Control::Listen(Core::StringView name, Core::String& error) {
		if (listener.Listen(Core::String(name).CStr())) return true;
		error = Core::String(listener.Error());
		return false;
	}

	void Control::Start() {
		Control* self = this;
		acceptor = Threading::Thread::Run([self]() { self->AcceptLoop(); });
	}

	// Until the server stops: then the pipe closes, so `ied` sees no server even before the process has ended.
	void Control::AcceptLoop() {
		while (!stopping.Load()) {
			Net::LocalStream accepted = listener.Accept(kAcceptSliceMs);
			if (!accepted.IsOpen() && !listener.TimedOut()) break;
			if (!accepted.IsOpen()) continue;
			Net::LocalStream* stream = new Net::LocalStream(take(accepted));
			Control* self = this;
			Threading::Thread::Run([self, stream]() { self->Serve(stream); }).Detach();
		}
		listener.Close();
	}

	// Answers each line as it comes; a "stop" ends the server once its answer is out.
	void Control::Serve(Net::LocalStream* stream) {
		Core::StringBuilder pending;
		char[4096] chunk;
		for (;;) {
			const int64 got = stream->Receive((void*)&chunk[0], 4096, Net::kWaitForever);
			if (got <= 0 || pending.ByteLength() + got > kControlLineBytes) break;
			pending.AppendBytes(&chunk[0], got);
			Core::StringView text = pending.View();
			const int64 end = text.IndexOf('\n', 0);
			if (end < 0) continue;
			Core::String line = Core::String(text.Substring(0, end).Trimmed());
			Core::String rest = Core::String(text.Substring(end + 1, text.ByteLength() - end - 1));
			pending.Clear();
			pending.Append(rest.View());
			if (line.IsEmpty()) continue;
			ControlAnswer answer = Answer(line.View());
			stream->SendText((answer.line + "\n").View(), 5000);
			if (answer.stop) {
				stream->Close();
				Stop();
				return;
			}
		}
		stream->Close();
	}

	static ControlAnswer Refusal(Core::StringView id, int32 code, Core::StringView message) {
		ControlAnswer answer;
		answer.line = RpcResponse(id, Core::StringView(""), code, message);
		return answer;
	}

	ControlAnswer Control::Answer(Core::StringView line) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(line, *doc);
		if (!parsed.Ok()) return Refusal(Core::StringView(""), kParseError, Core::StringView("not JSON"));
		Serialization::DomNode id = parsed.root.Member("id");
		Core::String idJson = id.IsValid() ? NodeJson(id) : Core::String();
		Serialization::DomNode method = parsed.root.Member("method");
		if (method.Kind() != Serialization::DomKind::String || parsed.root.Member("jsonrpc").AsView() != "2.0")
			return Refusal(idJson.View(), kInvalidRequest, Core::StringView("not a JSON-RPC 2.0 request"));
		try {
			ControlAnswer answer;
			answer.line = RpcResponse(idJson.View(), Call(method.AsView(), parsed.root.Member("params")).View(), 0, Core::StringView(""));
			answer.stop = method.AsView() == "stop";
			return answer;
		}
		catch (RpcError& error) {
			const bool unknown = error.code == ErrorCode::NotFound && error.message.View().StartsWith(Core::StringView("no method"));
			const int32 code = unknown ? kMethodNotFound : error.code == ErrorCode::BadRequest ? kInvalidParams : kMethodFailed;
			return Refusal(idJson.View(), code, error.message.View());
		}
	}

	Core::String Control::Call(Core::StringView method, const Serialization::DomNode& params) {
		if (method == "url") return (Core::String("{\"url\":") + JsonString(Launch(Core::StringView("")).View()).View()) + "}";
		if (method == "status") return Status();
		if (method == "open") return Open(params);
		if (method == "stop") return Core::String("{}");
		throw RpcError(ErrorCode::NotFound, (Core::String("no method '") + method + "'").View());
	}

	// A URL that signs a browser in once and shows `fragment` (docs/11 "Launch token").
	Core::String Control::Launch(Core::StringView fragment) {
		Threading::LockGuard guard(server->lock);
		Core::String token = server->auth->MintLaunchToken(kLaunchTokenMs);
		return LaunchUrl(server->config, server->port, token.View(), fragment);
	}

	Core::String Control::Status() {
		Threading::LockGuard guard(server->lock);
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", server->config.version.View());
		json.IntField("pid", (int64)Platform::ProcessId());
		json.Field("url", LaunchUrl(server->config, server->port, Core::StringView(""), Core::StringView("")).View());
		json.RawField("workspaces", server->workspaces->SummariesJson().View());
		json.IntField("clients", server->sessions.Count());
		json.EndObject();
		return json.ToString();
	}

	// "open=<wsId>/<path>[:<line>[:<col>]]": what the web client shows once it has signed in (docs/10).
	static Core::String OpenFragment(Core::StringView wsId, Core::StringView path, int64 line, int64 col) {
		Core::StringBuilder fragment;
		fragment.Append("open=");
		fragment.Append(wsId);
		fragment.AppendByte('/');
		fragment.Append(path);
		if (line > 0) {
			fragment.AppendByte(':');
			fragment.AppendInt(line);
			if (col > 0) {
				fragment.AppendByte(':');
				fragment.AppendInt(col);
			}
		}
		return fragment.ToString();
	}

	Core::String Control::Open(const Serialization::DomNode& params) {
		Core::String path = Core::String(params.Member("path").AsView());
		if (path.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "open needs a path");
		FS::Path target = FS::CanonicalPath(path.CStr());
		if (target.IsEmpty()) throw RpcError(ErrorCode::NotFound, (Core::String("no such file or folder: ") + path.View()).View());
		Core::String wsId;
		Core::String relative;
		{
			Threading::LockGuard guard(server->lock);
			wsId = server->workspaces->OpenFor(target, relative)->wsId;
		}
		JsonWriter json;
		json.BeginObject();
		json.Field("wsId", wsId.View());
		json.Field("path", relative.View());
		Core::String fragment = OpenFragment(wsId.View(), relative.View(), params.Member("line").AsInt(), params.Member("col").AsInt());
		json.Field("url", Launch(fragment.View()).View());
		json.EndObject();
		return json.ToString();
	}

	// Every client is told and closed, then the HTTP server stops, and with it the process.
	void Control::Stop() {
		stopping.Store(true);
		Core::Array<Session*> closing;
		{
			Threading::LockGuard guard(server->lock);
			closing = server->sessions;
			for (Session* session : closing) session->Push(ByeFrame("shutdown").View());
			server->lsp->StopAll();
		}
		for (Session* session : closing) session->FlushAndClose(1001, "shutdown");
		server->Log(Core::StringView("stopped by the control channel"));
		stop();
	}
}
