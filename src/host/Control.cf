include "Control.ch"
include "Server.ch"

namespace Ied
{
	// JSON-RPC 2.0's own error codes, and the one for everything a method refuses.
	const int32 c_ParseError = -32700;
	const int32 c_InvalidRequest = -32600;
	const int32 c_MethodNotFound = -32601;
	const int32 c_InvalidParams = -32602;
	const int32 c_MethodFailed = -32000;

	Core::String RpcResponse(Core::StringView id, Core::StringView result, int32 code, Core::StringView message) {
		JsonWriter json;
		json.BeginObject();
		json.Field("jsonrpc", "2.0");
		json.RawField("id", id.IsEmpty() ? Core::StringView("null") : id);
		if (code == 0) json.RawField("result", result);
		else {
			json.Key(Core::StringView("error"));
			json.BeginObject();
			json.IntField("code", code);
			json.Field("message", message);
			json.EndObject();
		}
		json.EndObject();
		return json.ToString();
	}

	bool Control::Listen(Core::StringView name, Core::String& error) {
		if (m_Listener.Listen(Core::String(name).CStr())) return true;
		error = Core::String(m_Listener.Error());
		return false;
	}

	void Control::Start() {
		Control* self = this;
		m_Acceptor = Threading::Thread::Run([self]() { self->AcceptLoop(); });
	}

	// Until the server stops: then the pipe closes, so `ied` sees no server even before the process has ended. A
	// relaunch that came due stops it here.
	void Control::AcceptLoop() {
		while (!m_Stopping.Load()) {
			Net::LocalStream accepted = m_Listener.Accept(c_AcceptSliceMs);
			if (!accepted.IsOpen() && !m_Listener.TimedOut()) break;
			if (RelaunchDue()) Stop(Core::StringView("stopped to relaunch: no desktop app took the relaunch"));
			if (!accepted.IsOpen()) continue;
			Net::LocalStream* stream = new Net::LocalStream(take(accepted));
			Control* self = this;
			Threading::Thread::Run([self, stream]() { self->Serve(stream); }).Detach();
		}
		m_Listener.Close();
	}

	// Answers each line as it comes; a "stop" ends the server once its answer is out.
	void Control::Serve(Net::LocalStream* stream) {
		Core::StringBuilder pending;
		char[4096] chunk;
		for (;;) {
			const int64 got = stream->Receive((void*)&chunk[0], 4096, Net::kWaitForever);
			if (got <= 0 || pending.ByteLength() + got > c_ControlLineBytes) break;
			pending.AppendBytes(&chunk[0], got);
			Core::StringView text = pending.View();
			const int64 end = text.IndexOf('\n', 0);
			if (end < 0) continue;
			Core::String line = Core::String(text.Substring(0, end).Trimmed());
			Core::String rest = Core::String(text.Substring(end + 1, text.ByteLength() - end - 1));
			pending.Clear();
			pending.Append(rest.View());
			if (line.IsEmpty()) continue;
			ControlAnswer answer = Answer(line.View());
			stream->SendText((answer.m_Line + "\n").View(), 5000);
			if (answer.m_Stop) {
				stream->Close();
				Stop(Core::StringView("stopped by the control channel"));
				return;
			}
		}
		stream->Close();
	}

	static ControlAnswer Refusal(Core::StringView id, int32 code, Core::StringView message) {
		ControlAnswer answer;
		answer.m_Line = RpcResponse(id, Core::StringView(""), code, message);
		return answer;
	}

	ControlAnswer Control::Answer(Core::StringView line) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(line, *doc);
		if (!parsed.Ok()) return Refusal(Core::StringView(""), c_ParseError, Core::StringView("not JSON"));
		Serialization::DomNode id = parsed.root.Member("id");
		Core::String idJson = id.IsValid() ? NodeJson(id) : Core::String();
		Serialization::DomNode method = parsed.root.Member("method");
		if (method.Kind() != Serialization::DomKind::String || parsed.root.Member("jsonrpc").AsView() != "2.0")
			return Refusal(idJson.View(), c_InvalidRequest, Core::StringView("not a JSON-RPC 2.0 request"));
		try {
			ControlAnswer answer;
			answer.m_Line = RpcResponse(idJson.View(), Call(method.AsView(), parsed.root.Member("params")).View(), 0, Core::StringView(""));
			answer.m_Stop = method.AsView() == "stop";
			return answer;
		}
		catch (RpcError& error) {
			const bool unknown = error.m_Code == ErrorCode::NotFound && error.m_Message.View().StartsWith(Core::StringView("no method"));
			const int32 code = unknown ? c_MethodNotFound : error.m_Code == ErrorCode::BadRequest ? c_InvalidParams : c_MethodFailed;
			return Refusal(idJson.View(), code, error.m_Message.View());
		}
	}

	Core::String Control::Call(Core::StringView method, const Serialization::DomNode& params) {
		if (!m_Server->IsMaster()) return WorkspaceCall(method, params);
		if (method.StartsWith(Core::StringView("master."))) return MasterCall(method, params);
		if (method == "url") return (Core::String("{\"url\":") + JsonString(Launch(Core::StringView("")).View()).View()) + "}";
		if (method == "status") return Status();
		if (method == "open") return Open(params);
		if (method == "stop") return Core::String("{}");
		if (method == "relaunch.claim") return ClaimRelaunch();
		throw RpcError(ErrorCode::NotFound, (Core::String("no method '") + method + "'").View());
	}

	// A URL that signs a browser in once and shows `fragment` (docs/11 "Launch token").
	Core::String Control::Launch(Core::StringView fragment) {
		Threading::LockGuard guard(m_Server->m_Lock);
		Core::String token = m_Server->m_Auth->MintLaunchToken(c_LaunchTokenMs);
		return LaunchUrl(m_Server->m_Config, m_Server->m_Port, token.View(), fragment);
	}

	Core::String Control::Status() {
		Threading::LockGuard guard(m_Server->m_Lock);
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", m_Server->m_Config.m_Version.View());
		json.IntField("pid", (int64)Platform::ProcessId());
		json.Field("url", LaunchUrl(m_Server->m_Config, m_Server->m_Port, Core::StringView(""), Core::StringView("")).View());
		json.RawField("workspaces", m_Server->m_Workspaces->SummariesJson().View());
		json.IntField("clients", m_Server->m_Sessions.Count());
		json.BoolField("relaunch", m_Server->m_Relaunch.Shown(clock_now_ns() / 1000000));
		json.EndObject();
		return json.ToString();
	}

	Core::String Control::WorkspaceCall(Core::StringView method, const Serialization::DomNode& params) {
		if (method == "status") return WorkspaceStatus();
		if (method == "stop") return Core::String("{}");
		// The master wrote plugins.json: read it again now, before the master answers (its watcher would, a moment later).
		if (method == "choices.changed") {
			Threading::LockGuard guard(m_Server->m_Lock);
			m_Server->m_Plugins->Load();
			return Core::String("{}");
		}
		// The master wrote settings.json (the app tier): the same.
		if (method == "settings.changed") {
			Threading::LockGuard guard(m_Server->m_Lock);
			m_Server->m_Settings->AppFileChanged();
			return Core::String("{}");
		}
		throw RpcError(ErrorCode::NotFound, (Core::String("no method '") + method + "' (a workspace server's pipe is its master's)").View());
	}

	Core::String Control::WorkspaceStatus() {
		Threading::LockGuard guard(m_Server->m_Lock);
		JsonWriter json;
		json.BeginObject();
		json.Field("serverVersion", m_Server->m_Config.m_Version.View());
		json.Field("wsId", m_Server->m_Config.m_WsId.View());
		json.IntField("pid", (int64)Platform::ProcessId());
		json.IntField("port", m_Server->m_Port);
		json.Field("sessionEpoch", m_Server->m_Epoch.View());
		json.RawField("workspaces", m_Server->m_Workspaces->SummariesJson().View());
		json.IntField("clients", m_Server->m_Sessions.Count());
		json.EndObject();
		return json.ToString();
	}

	static Core::String Required(const Serialization::DomNode& params, const char* name) {
		Serialization::DomNode value = params.Member(name);
		if (value.Kind() != Serialization::DomKind::String || value.AsView().IsEmpty()) throw RpcError(ErrorCode::BadRequest, (Core::String("needs ") + name).View());
		return Core::String(value.AsView());
	}

	Core::String Control::MasterCall(Core::StringView method, const Serialization::DomNode& params) {
		if (method == "master.workspace") {
			Threading::LockGuard guard(m_Server->m_Lock);
			m_Server->m_Workspaces->ServerSays(Required(params, "wsId").View(), params.Member("summary"), params.Member("solutionFile").AsView());
			return Core::String("{}");
		}
		if (method == "master.settings") {
			Core::String key = Required(params, "key");
			Serialization::DomNode value = params.Member("value");
			Core::String valueJson = value.IsValid() && value.Kind() != Serialization::DomKind::Null ? NodeJson(value) : Core::String();
			Threading::LockGuard guard(m_Server->m_Lock);
			Core::String problem;
			if (!m_Server->m_Settings->WriteApp(key.View(), valueJson.View(), problem)) throw RpcError(ErrorCode::BadRequest, problem.View());
			return Core::String("{}");
		}
		if (method == "master.trust") {
			FS::Path root = FS::Path(Required(params, "root").View());
			Threading::LockGuard guard(m_Server->m_Lock);
			if (!m_Server->RecordTrust(root, params.Member("trusted").AsBool())) throw RpcError(ErrorCode::Unavailable, "the trust choice could not be saved");
			return Core::String("{}");
		}
		if (method == "master.open") {
			FS::Path target = FS::CanonicalPath(Required(params, "path").CStr());
			if (target.IsEmpty()) throw RpcError(ErrorCode::NotFound, "no such file or folder");
			Threading::LockGuard guard(m_Server->m_Lock);
			Core::String relative;
			Workspace* ws = m_Server->m_Workspaces->OpenFor(target, relative);
			return (Core::String("{\"workspace\":") + ws->SummaryJson().View()) + "}";
		}
		if (method == "master.binding") {
			Core::String name = Required(params, "name");
			Serialization::DomNode args = params.Member("args");
			Core::String text = args.IsValid() ? NodeJson(args) : Core::String("{}");
			int64 wait = params.Member("waitMs").AsInt();
			if (wait <= 0) wait = IED::c_BindingWaitMs;
			Threading::LockGuard guard(m_Server->m_Lock);
			CodeInstance* provider = m_Server->m_Code->Provider(nullptr, name.View());
			if (!provider) throw RpcError(ErrorCode::NotFound, ((Core::String("no plugin of the master provides the server binding '") + name.View()) + "'").View());
			IED::Result result = InvokeBindingWithin(m_Server, provider, name.View(), text.View(), NeverStopped(), wait);
			if (!result.Ok()) throw RpcError(ErrorCode::PluginError, result.m_Error.View());
			return (Core::String("{\"result\":") + result.m_Json.View()) + "}";
		}
		if (method == "master.notify") {
			Core::String level = Core::String(params.Member("level").AsView());
			Core::String text = Required(params, "text");
			Threading::LockGuard guard(m_Server->m_Lock);
			m_Server->m_Presence->Add(level.IsEmpty() ? Core::StringView("info") : level.View(), text.View());
			return Core::String("{}");
		}
		if (method == "master.relaunch") {
			Core::String reason = Core::String(params.Member("reason").AsView());
			Threading::LockGuard guard(m_Server->m_Lock);
			if (!m_Server->m_Relaunch.Ask(reason.View(), clock_now_ns() / 1000000)) throw RpcError(ErrorCode::Conflict, "a relaunch is already under way");
			m_Server->Log((Core::String("relaunch: asked by a workspace server: ") + reason.View()).View());
			return Core::String("{}");
		}
		throw RpcError(ErrorCode::NotFound, (Core::String("no method '") + method + "'").View());
	}

	Core::String Control::ClaimRelaunch() {
		Threading::LockGuard guard(m_Server->m_Lock);
		const bool claimed = m_Server->m_Relaunch.Claim(clock_now_ns() / 1000000);
		if (claimed) m_Server->Log((Core::String("relaunch: the desktop app relaunches IED (") + m_Server->m_Relaunch.m_Reason.View() + ")").View());
		return Core::String(claimed ? "{\"claimed\":true}" : "{\"claimed\":false}");
	}

	bool Control::RelaunchDue() {
		Threading::LockGuard guard(m_Server->m_Lock);
		return m_Server->m_Relaunch.Due(clock_now_ns() / 1000000);
	}

	// "open=<wsId>/<path>[:<line>[:<col>]]": what the web client shows once it has signed in (docs/10).
	static Core::String OpenFragment(Core::StringView wsId, Core::StringView path, int64 line, int64 col) {
		Core::StringBuilder fragment;
		fragment.Append("open=");
		fragment.Append(wsId);
		fragment.AppendByte('/');
		fragment.Append(path);
		if (line > 0) {
			fragment.AppendByte(':');
			fragment.AppendInt(line);
			if (col > 0) {
				fragment.AppendByte(':');
				fragment.AppendInt(col);
			}
		}
		return fragment.ToString();
	}

	Core::String Control::Open(const Serialization::DomNode& params) {
		Core::String path = Core::String(params.Member("path").AsView());
		if (path.IsEmpty()) throw RpcError(ErrorCode::BadRequest, "open needs a path");
		FS::Path target = FS::CanonicalPath(path.CStr());
		if (target.IsEmpty()) throw RpcError(ErrorCode::NotFound, (Core::String("no such file or folder: ") + path.View()).View());
		Core::String wsId;
		Core::String relative;
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			wsId = m_Server->m_Workspaces->OpenFor(target, relative)->m_WsId;
		}
		JsonWriter json;
		json.BeginObject();
		json.Field("wsId", wsId.View());
		json.Field("path", relative.View());
		Core::String fragment = OpenFragment(wsId.View(), relative.View(), params.Member("line").AsInt(), params.Member("col").AsInt());
		json.Field("url", Launch(fragment.View()).View());
		json.EndObject();
		return json.ToString();
	}

	// Every client is told and closed, then the HTTP server stops, and with it the process.
	void Control::Stop(Core::StringView why) {
		if (m_Stopping.Load()) return;
		m_Stopping.Store(true);
		// The master's workspace servers stop first, so their chats and terminals end as at their own stop.
		if (m_Server->m_Servers) m_Server->m_Servers->StopAll();
		Core::Array<Session*> closing;
		{
			Threading::LockGuard guard(m_Server->m_Lock);
			closing = m_Server->m_Sessions;
			for (Session* session : closing) session->Push(ByeFrame("shutdown").View());
			m_Server->m_Lsp->StopAll();
		}
		for (Session* session : closing) session->FlushAndClose(1001, "shutdown");
		m_Server->Log(why);
		m_Stop();
	}
}
