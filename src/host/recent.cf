include "recent.ch"
include "trust.ch"
include "web/json.ch"

namespace Ied
{
	static RecentProject ProjectFrom(const Serialization::DomNode& node) {
		RecentProject project;
		project.path = Core::String(node.Member("path").AsView());
		project.name = Core::String(node.Member("name").AsView());
		project.kind = Core::String(node.Member("kind").AsView());
		project.opened = node.Member("opened").AsInt();
		project.favorite = node.Member("favorite").AsBool();
		return project;
	}

	void RecentProjects::Load(Core::StringView file, Core::String& error) {
		this.file = Core::String(file);
		items.Clear();
		if (!FS::FileExists(this.file.CStr())) return;
		FS::File opened = FS::File(this.file.CStr(), "rb");
		Core::String text = opened.ReadText();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJsonc(text.View(), *doc);
		Serialization::DomNode projects = read.Ok() ? read.root.Member("projects") : Serialization::DomNode();
		if (projects.Kind() != Serialization::DomKind::Array) {
			error = Core::String("ignoring ") + file + ": not a recent projects file";
			return;
		}
		for (int64 i = 0; i < projects.Count(); ++i) {
			RecentProject project = ProjectFrom(projects.At(i));
			if (!project.path.IsEmpty() && IndexOf(project.path.View()) < 0) items.Push(project);
		}
	}

	int64 RecentProjects::IndexOf(Core::StringView path) const {
		Core::String key = TrustKey(path);
		for (int64 i = 0; i < items.Count(); ++i)
			if (TrustKey(items[i].path.View()).View() == key.View()) return i;
		return -1;
	}

	bool RecentProjects::Contains(Core::StringView path) const { return IndexOf(path) >= 0; }

	bool RecentProjects::Opened(Core::StringView path, Core::StringView name, Core::StringView kind, int64 now) {
		RecentProject project;
		const int64 at = IndexOf(path);
		if (at >= 0) {
			project = items[at];
			items.RemoveAt(at);
		}
		project.path = Core::String(path);
		project.name = Core::String(name);
		project.kind = Core::String(kind);
		project.opened = now;
		items.Insert(0, project);
		int64 others = 0;
		for (int64 i = 0; i < items.Count(); ++i) {
			if (items[i].favorite) continue;
			others += 1;
			if (others > kRecentLimit) {
				items.RemoveAt(i);
				i -= 1;
			}
		}
		return Save();
	}

	bool RecentProjects::SetFavorite(Core::StringView path, bool favorite) {
		const int64 at = IndexOf(path);
		if (at < 0) return false;
		items[at].favorite = favorite;
		return Save();
	}

	bool RecentProjects::Forget(Core::StringView path) {
		const int64 at = IndexOf(path);
		if (at < 0) return false;
		items.RemoveAt(at);
		return Save();
	}

	static void WriteProject(JsonWriter& json, const RecentProject& project, bool withExists) {
		json.BeginObject();
		json.Field("path", project.path.View());
		json.Field("name", project.name.View());
		json.Field("kind", project.kind.View());
		json.IntField("opened", project.opened);
		json.BoolField("favorite", project.favorite);
		if (withExists) json.BoolField("exists", FS::FileExists(project.path.CStr()) || FS::IsDirectory(project.path.CStr()));
		json.EndObject();
	}

	Core::String RecentProjects::Json() const {
		JsonWriter json;
		json.BeginArray();
		for (const RecentProject& project : items) WriteProject(json, project, true);
		json.EndArray();
		return json.ToString();
	}

	bool RecentProjects::Save() {
		JsonWriter json;
		json.BeginObject();
		json.IntField("version", 1);
		json.Key(Core::StringView("projects"));
		json.BeginArray();
		for (const RecentProject& project : items) WriteProject(json, project, false);
		json.EndArray();
		json.EndObject();
		FS::MakeDirectories(FS::Path(file.View()).Parent().CStr());
		return FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength());
	}
}
