include "config.ch"

namespace Ied
{
	const int64 kKilobyte = 1024;

	ServerConfig DefaultConfig() {
		ServerConfig config;
		config.version = Core::String("0.1.0");
		config.host = Core::String("127.0.0.1");
		config.port = 8765;
		config.idleTimeoutMs = 60000;
		config.outboundBudget = 4 * kKilobyte * kKilobyte;
		config.coalesceBytes = 256 * kKilobyte;
		return config;
	}

	// A count small enough that any unit it is multiplied by still fits.
	static bool ParseCount(Core::StringView text, int64& value) {
		const int64 kMostCount = 1000000000;
		int64 parsed = 0;
		if (!Core::ParseInt64(text, parsed) || parsed < 0 || parsed > kMostCount) return false;
		value = parsed;
		return true;
	}

	static bool Fail(Core::String& error, Core::StringView option, const char* why) {
		Core::StringBuilder text;
		text.Append(option);
		text.Append(": ");
		text.Append(why);
		error = text.ToString();
		return false;
	}

	// One option and its value (when it takes one) at `i`; `i` moves past them.
	static bool ParseOption(const Core::Array<Core::String>& arguments, int64& i, ServerConfig& config, Core::String& error) {
		Core::StringView option = arguments[i].View();
		if (option == "--test-hooks") { config.testHooks = true; return true; }
		if (option == "--quiet") { config.quiet = true; return true; }
		if (option == "--relaunched") { config.relaunched = true; return true; }
		if (i + 1 >= arguments.Count()) return Fail(error, option, "needs a value (or is unknown)");
		i += 1;
		Core::StringView value = arguments[i].View();
		int64 number = 0;
		if (option == "--role") {
			if (value != "master" && value != "workspace") return Fail(error, option, "is master or workspace");
			config.role = value == "workspace" ? ServerRole::Workspace : ServerRole::Master;
		}
		else if (option == "--ws-id") config.wsId = Core::String(value);
		else if (option == "--master") config.masterControl = Core::String(value);
		else if (option == "--state") config.stateDir = Core::String(value);
		else if (option == "--log") config.logPath = Core::String(value);
		else if (option == "--restarted-after") config.restartedAfter = Core::String(value);
		else if (option == "--host") config.host = Core::String(value);
		else if (option == "--static") config.staticDir = Core::String(value);
		else if (option == "--data") config.dataDir = Core::String(value);
		else if (option == "--home") config.homeDir = Core::String(value);
		else if (option == "--app-data") config.appDataDir = Core::String(value);
		else if (option == "--control") config.controlName = Core::String(value);
		else if (option == "--workspace") config.workspaces.Push(Core::String(value));
		else if (option == "--allow-origin") config.allowOrigins.Push(Core::String(value));
		else if (option == "--allow-host") config.allowHosts.Push(Core::String(value));
		else if (option == "--debug-scripts") {
			if (value != "on" && value != "off") return Fail(error, option, "is on or off");
			config.debugScripts = value == "on" ? 1 : 0;
		}
		else if (!ParseCount(value, number)) return Fail(error, option, "is unknown, or its value is not a count");
		else if (option == "--port" && number <= 65535) {
			config.port = (int32)number;
			config.portGiven = true;
		}
		else if (option == "--idle-timeout") config.idleTimeoutMs = number * 1000;
		else if (option == "--outbound-budget-mb") config.outboundBudget = number * kKilobyte * kKilobyte;
		else if (option == "--coalesce-kb") config.coalesceBytes = number * kKilobyte;
		else return Fail(error, option, "is unknown or out of range");
		return true;
	}

	bool ParseArguments(const Core::Array<Core::String>& arguments, ServerConfig& config, Core::String& error) {
		config.arguments = arguments;
		for (int64 i = 0; i < arguments.Count(); ++i)
			if (!ParseOption(arguments, i, config, error)) return false;
		if (!IsWorkspaceServer(config)) return true;
		if (config.wsId.IsEmpty() || config.masterControl.IsEmpty() || config.workspaces.Count() != 1) {
			error = Core::String("--role workspace needs --ws-id, --master and one --workspace (only the master starts one)");
			return false;
		}
		// Loopback only, on a port of the system's choosing (docs/11 "Workspace servers").
		config.host = Core::String("127.0.0.1");
		config.port = 0;
		config.portGiven = false;
		return true;
	}

	bool IsWorkspaceServer(const ServerConfig& config) { return config.role == ServerRole::Workspace; }

	Core::String StateFolder(const ServerConfig& config) { return config.stateDir.IsEmpty() ? DataFolder(config) : config.stateDir; }

	Core::String LogPath(const ServerConfig& config) {
		if (!config.logPath.IsEmpty()) return config.logPath;
		return Core::String((FS::Path(DataFolder(config).View()) / "logs" / "server.log").View());
	}

	static Core::String RandomHex(int32 bytes) {
		uint8[16] random;
		Platform::RandomBytes((void*)&random[0], bytes);
		Core::StringBuilder text;
		for (int32 i = 0; i < bytes; ++i) text.AppendUIntBase((uint64)random[i], 16, 2);
		return text.ToString();
	}

	Core::String DataFolder(const ServerConfig& config) {
		if (!config.dataDir.IsEmpty()) return config.dataDir;
		if (config.testHooks) return Core::String((FS::TempDirectory() / (Core::String("ied-data-") + RandomHex(6).View()).View()).View());
		return Core::String((FS::Path(Platform::GetEnvironmentVariable("LOCALAPPDATA").View()) / "IED").View());
	}

	Core::String HomeFolder(const ServerConfig& config) {
		if (!config.homeDir.IsEmpty()) return config.homeDir;
		for (FS::Path at = Platform::ExecutablePath().Parent(); !at.IsEmpty(); at = at.Parent()) {
			if (FS::FileExists((at / "shared" / "host-api" / "schemas" / "plugin-manifest.v1.schema.json").CStr())) return Core::String(at.View());
			if (at.Parent().View() == at.View()) break;
		}
		return Core::String();
	}

	Core::String StaticFolder(const ServerConfig& config) {
		if (!config.staticDir.IsEmpty()) return config.staticDir;
		Core::String home = HomeFolder(config);
		return home.IsEmpty() ? home : Core::String((FS::Path(home.View()) / "frontend").View());
	}

	Core::String AppDataFolder(const ServerConfig& config) {
		if (!config.appDataDir.IsEmpty()) return config.appDataDir;
		if (config.testHooks) return Core::String((FS::Path(DataFolder(config).View()) / "app").View());
		return Core::String((FS::Path(Platform::GetEnvironmentVariable("APPDATA").View()) / "IED").View());
	}

	Core::String ControlName(const ServerConfig& config) {
		if (!config.controlName.IsEmpty()) return config.controlName;
		if (config.testHooks) return Net::UserLocalName((Core::String("ied-test-") + RandomHex(6).View()).CStr());
		return Net::UserLocalName("ied");
	}

	Core::String BrowserHost(const ServerConfig& config) {
		Core::StringView host = config.host.View();
		if (host == "0.0.0.0" || host.IsEmpty()) return Core::String("127.0.0.1");
		if (host == "::") return Core::String("[::1]");
		return host.IndexOf(':', 0) >= 0 ? (Core::String("[") + host) + "]" : Core::String(host);
	}

	Core::String LaunchUrl(const ServerConfig& config, int32 port, Core::StringView token, Core::StringView fragment) {
		Core::StringBuilder url;
		url.Append("http://");
		url.Append(BrowserHost(config).View());
		url.AppendByte(':');
		url.AppendInt(port);
		url.AppendByte('/');
		if (!token.IsEmpty()) {
			url.Append("?t=");
			url.Append(token);
		}
		if (!fragment.IsEmpty()) {
			url.AppendByte('#');
			url.Append(fragment);
		}
		return url.ToString();
	}
}
