include "Appdata.ch"
include "Server.ch"

namespace Ied
{
	// The shared folder itself made or removed (docs/35); the system also says it changed whenever something in it does,
	// the mirror's staging too, which is nothing to read again.
	static bool SharedFolderCameOrWent(const TreeChange& change) {
		return change.m_Kind != TreeChangeKind::Changed && (change.m_Path.View() == "shared" || change.m_Path.View() == "shared/plugins");
	}

	// The app tier, or the Shared tier's mirror (docs/35).
	bool TouchesSettings(const ChangeBatch& batch) {
		for (const TreeChange& change : batch.Changes()) {
			Core::StringView path = change.m_Path.View();
			if (path == "settings.json" || path == c_SharedSettings || SharedFolderCameOrWent(change)) return true;
		}
		return batch.Overflowed();
	}

	// App plugins, or the shared ones a config server serves (docs/35).
	bool TouchesPlugins(const ChangeBatch& batch) {
		for (const TreeChange& change : batch.Changes()) {
			Core::StringView path = change.m_Path.View();
			if (path == "plugins" || path.StartsWith(Core::StringView("plugins/"))) return true;
			if (path.StartsWith(Core::StringView("shared/plugins/")) || SharedFolderCameOrWent(change)) return true;
		}
		return batch.Overflowed();
	}

	static bool Touches(const ChangeBatch& batch, const char* file) {
		for (const TreeChange& change : batch.Changes())
			if (change.m_Path.View() == file) return true;
		return batch.Overflowed();
	}

	bool TouchesTrust(const ChangeBatch& batch) { return Touches(batch, "trust.json"); }

	bool TouchesChoices(const ChangeBatch& batch) { return Touches(batch, "plugins.json"); }

	bool AppDataWatch::Start(Server* server, Core::String& error) {
		FS::Path folder = FS::Path(server->m_Config.m_AppDataDir.View());
		FS::MakeDirectories(folder.CStr());
		return m_Watch.Start(folder, [server](const ChangeBatch& batch) {
			Threading::LockGuard guard(server->m_Lock);
			// The master writes plugins.json and trust.json; a workspace server reads them again (docs/01 "Processes").
			if (TouchesPlugins(batch) || (!server->IsMaster() && TouchesChoices(batch))) server->m_Plugins->Load();
			else if (TouchesSettings(batch)) server->m_Settings->AppFileChanged();
			if (!server->IsMaster() && TouchesTrust(batch)) {
				Core::String problem;
				server->m_Trust.Reload(problem);
				if (!problem.IsEmpty()) server->Log(problem.View());
				server->m_Workspaces->TrustFileChanged();
			}
		}, error);
	}
}
