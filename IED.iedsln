{
	"version": 1,
	"name": "IED",
	"projects": [
		{
			"file": "build/ied/*.iedproj",
			"optional": true
		}
	],
	"groups": [
		{
			"name": "C++ Libraries",
			"projects": [
				"ChangeNotification",
				"CodeGen",
				"Core",
				"CoreTesting",
				"HeaderTool",
				"ObjectDescription",
				"Profiling",
				"Reflection",
				"ReflectionTesting",
				"StaticReflection",
				"Threading",
				"UnitTesting",
				"yaml"
			]
		},
		{
			"name": "C4",
			"projects": [
				"Bedrock",
				"C4",
				"C4Api",
				"C4DAP",
				"C4DAPLib",
				"C4Lib",
				"C4LSP",
				"C4LSPLib",
				"C4Protocol",
				"C4Script",
				"C4Testing",
				"CBind"
			]
		},
		{
			"name": "IED Plugins",
			"projects": [
				"c4 plugin",
				"ied.browser",
				"ied.chat",
				"ied.cpp",
				"ied.csharp",
				"ied.data",
				"ied.desktop",
				"ied.developer",
				"ied.editor",
				"ied.filetypes",
				"ied.git",
				"ied.go",
				"ied.gpu",
				"ied.java",
				"ied.lua",
				"ied.markdown",
				"ied.mcp",
				"ied.nuke",
				"ied.profiler",
				"ied.python",
				"ied.rust",
				"ied.scripts",
				"ied.shaders",
				"ied.sql",
				"ied.terminal",
				"ied.tor",
				"ied.web",
				"ied.webfetch",
				"ied.websearch"
			]
		}
	],
	"items": [
		"README.md",
		"AGENTS.md",
		"nuke.toml"
	],
	"localPlugins": [
		{
			"id": "c4",
			"path": "toolchains/c4/dev/ied"
		}
	],
	"generator": {
		"run": [
			"nuke",
			"init",
			"--ied"
		],
		"generatedPaths": [
			"build/ied/"
		]
	}
}
