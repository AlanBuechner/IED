include "External.ch"

namespace Launch
{
	static bool HasScheme(Core::StringView url, const char* scheme) {
		Core::StringView wanted = Core::StringView(scheme);
		return url.ByteLength() > wanted.ByteLength() && Http::EqualsIgnoringCase(url.Substring(0, wanted.ByteLength()), wanted);
	}

	bool IsExternalUrl(Core::StringView url) { return HasScheme(url, "http://") || HasScheme(url, "https://") || HasScheme(url, "mailto:"); }

	bool OpenExternal(Core::StringView url) {
		if (!IsExternalUrl(url)) return false;
		Process::StartInfo info;
		info.program = Core::String("rundll32");
		info.arguments.Push(Core::String("url.dll,FileProtocolHandler"));
		info.arguments.Push(Core::String(url));
		// The browser the handler starts is its child, and a child is born in the launcher's job: with the job killed on
		// close (the default) the window it just opened goes with it once this call ends.
		info.killOnClose = false;
		Process::Child child = Process::Child::Start(info);
		return child.IsOpen();
	}
}
