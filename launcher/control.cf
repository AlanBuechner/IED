include "control.ch"

namespace Launch
{
	Core::String ControlName(Core::StringView control) { return control.IsEmpty() ? Net::UserLocalName("ied") : Core::String(control); }

	Core::String RequestLine(Core::StringView method, Core::StringView paramsJson) {
		Core::StringBuilder line;
		line.Append("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
		line.Append(method);
		line.AppendByte('"');
		if (!paramsJson.IsEmpty()) {
			line.Append(",\"params\":");
			line.Append(paramsJson);
		}
		line.Append("}\n");
		return line.ToString();
	}

	Reply ParseReply(Core::StringView line) {
		Reply reply;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(line, *doc);
		Serialization::DomNode result = parsed.Ok() ? parsed.root.Member("result") : Serialization::DomNode();
		Serialization::DomNode failure = parsed.Ok() ? parsed.root.Member("error") : Serialization::DomNode();
		if (result.IsValid()) {
			reply.ok = true;
			reply.result = Core::String(line);
		}
		else if (failure.IsValid()) reply.error = Core::String(failure.Member("message").AsView());
		else reply.error = Core::String("the server's answer was not JSON-RPC");
		return reply;
	}

	Core::String ResultField(const Reply& reply, const char* name) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(reply.result.View(), *doc);
		return parsed.Ok() ? Core::String(parsed.root.Member("result").Member(name).AsView()) : Core::String();
	}

	// One line from the stream: false when it closed or went quiet first.
	static bool ReadLine(Net::LocalStream& stream, Core::String& line, int32 timeoutMs) {
		Core::StringBuilder text;
		char[4096] chunk;
		for (;;) {
			const int64 got = stream.Receive((void*)&chunk[0], 4096, timeoutMs);
			if (got <= 0) return false;
			text.AppendBytes(&chunk[0], got);
			const int64 end = text.View().IndexOf('\n', 0);
			if (end < 0) continue;
			line = Core::String(text.View().Substring(0, end));
			return true;
		}
	}

	Reply Ask(Net::LocalStream& stream, Core::StringView method, Core::StringView paramsJson) { return AskWithin(stream, method, paramsJson, kAnswerMs); }

	Reply AskWithin(Net::LocalStream& stream, Core::StringView method, Core::StringView paramsJson, int32 timeoutMs) {
		Core::String line;
		if (!stream.SendText(RequestLine(method, paramsJson).View(), kAnswerMs) || !ReadLine(stream, line, timeoutMs)) {
			Reply failed;
			failed.error = Core::String("the server did not answer");
			return failed;
		}
		return ParseReply(line.View());
	}
}
