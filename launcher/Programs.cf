include "Programs.ch"

namespace Launch
{
	// `<name>.exe` (on Linux `<name>`) beside this program, else in the build layout's `../<name>/` folder.
	static FS::Path SiblingProgram(const char* name) {
#if defined(PLATFORM_LINUX)
		Core::String file = Core::String(name);
#else
		Core::String file = Core::String(name) + ".exe";
#endif
		FS::Path here = Platform::ExecutablePath().Parent();
		FS::Path beside = here / file.View();
		if (FS::FileExists(beside.CStr())) return beside;
		FS::Path sibling = here.Parent() / name / file.View();
		return FS::FileExists(sibling.CStr()) ? sibling : FS::Path();
	}

	FS::Path ServerProgram() { return SiblingProgram("ied-server"); }

	FS::Path DesktopProgram() { return SiblingProgram("ied-desktop"); }

	FS::Path WebClientFolder() {
		for (FS::Path at = Platform::ExecutablePath().Parent(); !at.IsEmpty(); at = at.Parent()) {
			FS::Path candidate = at / "frontend";
			if (FS::FileExists((candidate / "login.html").CStr())) return candidate;
			if (at.Parent().View() == at.View()) break;
		}
		return FS::Path();
	}

	FS::Path HeapCheckReportFile() { return LogsFolder() / "heap-checks.log"; }

	Core::Array<Core::String> GcCheckEnvironment(Core::StringView reportFile) {
		Core::Array<Core::String> variables;
		variables.Push(Core::String("C4_GC_VERIFY_MAPS=") + reportFile);
		variables.Push(Core::String("C4_GC_POISON=1"));
		return variables;
	}

	Core::Array<Core::String> MallocCheckEnvironment() {
		Core::Array<Core::String> variables;
#if defined(PLATFORM_LINUX)
		variables.Push(Core::String("LD_PRELOAD=libc_malloc_debug.so.0"));
		variables.Push(Core::String("GLIBC_TUNABLES=glibc.malloc.check=3"));
		variables.Push(Core::String("MALLOC_PERTURB_=165"));
#endif
		return variables;
	}

	bool HeapChecksRequested() {
		Core::String value;
		return Platform::TryGetEnvironmentVariable(c_HeapChecksVariable, value) && !value.IsEmpty() && value.View() != "0";
	}

#if defined(PLATFORM_LINUX)
	// The server's standard error appended to the reports' file (C4_GC_VERIFY_MAPS names it): glibc's findings and the
	// runtime's fatal report go there, and the workspace servers, which inherit it, write there too. The shell becomes the
	// server (exec), so its process is the one started.
	static void ErrorsToReports(Process::StartInfo& info) {
		Core::Array<Core::String> wrapped;
		wrapped.Push(Core::String("-c"));
		wrapped.Push(Core::String("exec \"$0\" \"$@\" 2>>\"$C4_GC_VERIFY_MAPS\""));
		wrapped.Push(info.program);
		for (const Core::String& argument : info.arguments) wrapped.Push(argument);
		info.program = Core::String("/bin/sh");
		info.arguments = wrapped;
	}
#endif

	// The environment the server and its workspace servers run in when the checks are asked for (they inherit the master's),
	// and a line in the reports' file saying who asked and that the reports are appended there.
	static void AddHeapChecks(Process::StartInfo& info) {
		FS::Path report = HeapCheckReportFile();
		for (const Core::String& variable : GcCheckEnvironment(report.View())) info.environment.Push(variable);
		for (const Core::String& variable : MallocCheckEnvironment()) info.environment.Push(variable);
		LogFile log;
		if (log.Open(report.View())) log.Write(Core::StringView("ied-server started with the heap checks (IED_HEAP_CHECKS): the runtime's pointer-map reports are appended below; glibc aborts on a corrupt heap, and its message and the server's fatal report follow"));
#if defined(PLATFORM_LINUX)
		ErrorsToReports(info);
#endif
	}

	static Process::StartInfo ServerStart(const FS::Path& program, Core::StringView control) {
		Process::StartInfo info;
		info.program = Core::String(program.View());
		FS::Path web = WebClientFolder();
		if (!web.IsEmpty()) {
			info.arguments.Push(Core::String("--static"));
			info.arguments.Push(Core::String(web.View()));
		}
		if (!control.IsEmpty()) {
			info.arguments.Push(Core::String("--control"));
			info.arguments.Push(Core::String(control));
		}
		// No stream shared, so it gets a hidden console of its own and outlives the program that started it.
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		info.killOnClose = false;
		if (HeapChecksRequested()) AddHeapChecks(info);
		return info;
	}

	bool ServerGone(Core::StringView control) {
		Core::String name = ControlName(control);
		Net::LocalStream probe = Net::LocalStream::Connect(name.CStr(), 0);
		return !probe.IsOpen() && !probe.TimedOut();
	}

	bool AwaitGone(Core::StringView control) {
		const int64 deadline = clock_now_ns() + c_ServerStartMs * 1000000;
		while (clock_now_ns() < deadline) {
			if (ServerGone(control)) return true;
			Threading::Thread::Sleep(50000000);
		}
		return false;
	}

	Net::LocalStream StartServer(Core::StringView control, Core::String& error, Process::Child* started) {
		FS::Path program = ServerProgram();
		if (program.IsEmpty()) {
			error = Core::String("ied-server is not beside ") + Platform::ExecutablePath().FileName();
			return Net::LocalStream();
		}
		Process::Child child = Process::Child::Start(ServerStart(program, control));
		if (!child.IsOpen()) {
			error = Core::String("ied-server did not start: ") + child.Error();
			return Net::LocalStream();
		}
		const int64 deadline = clock_now_ns() + c_ServerStartMs * 1000000;
		Core::String name = ControlName(control);
		while (clock_now_ns() < deadline) {
			Net::LocalStream stream = Net::LocalStream::Connect(name.CStr(), c_ConnectMs);
			if (stream.IsOpen()) {
				if (started) *started = take(child);
				return stream;
			}
			if (child.Wait(100) != Process::kTimedOut) break;
		}
		const int64 code = child.Wait(0);
		if (code == c_AnotherServerExit) {
			Net::LocalStream other = Net::LocalStream::Connect(name.CStr(), c_ConnectMs);
			if (other.IsOpen()) return other;
		}
		if (code < 0) {
			error = Core::String("ied-server started but its control pipe never opened");
			return Net::LocalStream();
		}
		Core::StringBuilder ended;
		ended.Append("ied-server ended (");
		ended.Append(ExitCodeText(code).View());
		ended.Append(") before its control pipe opened; ");
		ended.Append((LogsFolder() / "server.log").View());
		ended.Append(" says why");
		error = ended.ToString();
		return Net::LocalStream();
	}

	Net::LocalStream Reach(Core::StringView control, Core::String& error, Process::Child* started) {
		Core::String name = ControlName(control);
		Net::LocalStream stream = Net::LocalStream::Connect(name.CStr(), c_ConnectMs);
		if (stream.IsOpen()) return take(stream);
		return StartServer(control, error, started);
	}
}
