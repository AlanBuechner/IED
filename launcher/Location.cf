include "Location.ch"

namespace Launch
{
	// The number after the last ':' of `text`, with `text` cut before it; false when there is none.
	static bool TakeNumber(Core::StringView& text, int64& number) {
		int64 colon = -1;
		for (int64 i = text.ByteLength() - 1; i >= 0 && colon < 0; --i)
			if (text.ByteAt(i) == ':') colon = i;
		if (colon < 2) return false;
		int64 parsed = 0;
		if (!Core::ParseInt64(text.Substring(colon + 1, text.ByteLength() - colon - 1), parsed) || parsed < 1) return false;
		number = parsed;
		text = text.Substring(0, colon);
		return true;
	}

	void SplitLocation(Core::StringView text, Core::String& path, int64& line, int64& col) {
		line = 0;
		col = 0;
		Core::StringView rest = text;
		int64 last = 0;
		if (TakeNumber(rest, last)) {
			int64 before = 0;
			if (TakeNumber(rest, before)) {
				line = before;
				col = last;
			}
			else line = last;
		}
		path = Core::String(rest);
	}

	OpenRequest OpenOf(Core::StringView path) {
		OpenRequest request;
		request.m_Path = Core::String(path);
		return request;
	}

	Core::String OpenParams(const OpenRequest& request) {
		Core::StringBuilder params;
		params.Append("{\"path\":");
		Serialization::WriteJsonString(FS::AbsolutePath(request.m_Path.CStr()).View(), &params);
		params.Append(",\"line\":");
		params.AppendInt(request.m_Line);
		params.Append(",\"col\":");
		params.AppendInt(request.m_Col);
		if (!request.m_In.IsEmpty()) {
			params.Append(",\"in\":");
			Serialization::WriteJsonString(FS::AbsolutePath(request.m_In.CStr()).View(), &params);
		}
		if (request.m_Reveal) params.Append(",\"reveal\":true");
		params.AppendByte('}');
		return params.ToString();
	}
}
