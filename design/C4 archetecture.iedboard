,{"id":"e374","layer":"L2","type":"rect","x":230,"y":5602,"w":430,"h":76,"text":"Reflection scope per project, off in Dist","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e375","layer":"L2","type":"rect","x":660,"y":5602,"w":760,"h":76,"text":"Every global and type is registered in every program (13 MB image in the IED server): size and link time.","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e376","layer":"L2","type":"rect","x":1420,"y":5602,"w":300,"h":76,"text":"Reflection image, MaterializeGlobals","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e377","layer":"L2","type":"rect","x":40,"y":5678,"w":70,"h":76,"text":"R14","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e378","layer":"L2","type":"rect","x":110,"y":5678,"w":120,"h":76,"text":"Done","color":"green","fill":"green","fontSize":14,"by":"ai"}
,{"id":"e379","layer":"L2","type":"rect","x":230,"y":5678,"w":430,"h":76,"text":"Rename namespace Scripting; fix doc drift","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e380","layer":"L2","type":"rect","x":660,"y":5678,"w":760,"h":76,"text":"The whole compiler is C++ namespace 'Scripting'; docs list a Testing/ folder that is gone and a two-way include rule the code dropped.","color":"gray","fontSize":14,"by":"ai"}
