,{"id":"e370","layer":"L2","type":"rect","x":660,"y":5526,"w":760,"h":76,"text":"Two split/verify/import paths double the surface where bugs like BUG-435 hide.","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e371","layer":"L2","type":"rect","x":1420,"y":5526,"w":300,"h":76,"text":"ProgramOutput, ModulePartitions","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e372","layer":"L2","type":"rect","x":40,"y":5602,"w":70,"h":76,"text":"R13","color":"gray","fontSize":14,"by":"ai"}
