,{"id":"e382","layer":"L2","type":"rect","x":40,"y":5754,"w":70,"h":76,"text":"R15","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e383","layer":"L2","type":"rect","x":110,"y":5754,"w":120,"h":76,"text":"Done","color":"green","fill":"green","fontSize":14,"by":"ai"}
,{"id":"e384","layer":"L2","type":"rect","x":230,"y":5754,"w":430,"h":76,"text":"C4Api v2: model queries through the C API","color":"gray","fontSize":14,"by":"ai"}
,{"id":"e385","layer":"L2","type":"rect","x":660,"y":5754,"w":760,"h":76,"text":"Tools outside IED see syntax only.","color":"gray","fontSize":14,"by":"ai"}
