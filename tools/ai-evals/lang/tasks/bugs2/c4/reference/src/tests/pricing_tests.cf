include "pricing.ch"
include "orders.ch"

static Invoice::OrderLine Line(Invoice::Tier tier, int64 quantity, int64 unitCents) {
	Invoice::OrderLine line;
	line.order = Core::String("1");
	line.customer = Core::String("c");
	line.tier = tier;
	line.quantity = quantity;
	line.unitCents = unitCents;
	return line;
}

[test("invoice.pricing.bulk_from_ten")]
static void BulkStartsAtTen() {
	assert_eq((int64)2250, Invoice::LineCents(10, 250), "ten get the discount");
	assert_eq((int64)2250, Invoice::LineCents(9, 250), "nine do not");
}

[test("invoice.pricing.gold_after_bulk")]
static void GoldDiscountsTheSubtotal() {
	Core::Array<Invoice::OrderLine> lines;
	lines.Push(Line(Invoice::Tier::Gold, 20, 100));
	Invoice::Totals totals = Invoice::PriceOrder(lines);
	assert_eq((int64)1800, totals.subtotal, "subtotal");
	assert_eq((int64)90, totals.goldDiscount, "5% of the discounted subtotal");
}

[test("invoice.pricing.rounds_half_up")]
static void RoundsHalfUp() {
	assert_eq((int64)81, Invoice::PercentOf(1007, 8), "80.56 cents");
	assert_eq((int64)1, Invoice::PercentOf(10, 5), "0.5 cent");
}

[test("invoice.report.no_orders")]
static void ReportsNoOrders() {
	Core::Array<Invoice::Order> none;
	assert_true(Invoice::Report(none) == "orders 0 total 0.00\naverage 0.00\n", "no orders");
}
