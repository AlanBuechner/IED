// Arrays of arrays: a grid, its transpose, and mixed contents.
fn makeGrid(rows, cols) {
    let grid = [];
    let r = 0;
    while (r < rows) {
        let row = [];
        let c = 0;
        while (c < cols) {
            push(row, r * cols + c);
            c = c + 1;
        }
        push(grid, row);
        r = r + 1;
    }
    return grid;
}

fn transpose(grid) {
    let result = [];
    let c = 0;
    while (c < len(grid[0])) {
        let column = [];
        let r = 0;
        while (r < len(grid)) {
            push(column, grid[r][c]);
            r = r + 1;
        }
        push(result, column);
        c = c + 1;
    }
    return result;
}

let grid = makeGrid(3, 4);
print(grid);
print(transpose(grid));
print("cell", grid[2][3], "row", grid[1], "rows", len(grid), "cols", len(grid[0]));

grid[1][2] = 99;
grid[0] = ["replaced", "row"];
print(grid);

let mixed = [1, "two", [3, ["four", nil]], true, [], [[]]];
print(mixed);
print(mixed[2][1][0], len(mixed[2]), mixed[2][1], str(mixed[4]));
print("as string: " + str(mixed));
