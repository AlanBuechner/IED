include "document.ch"

static void ExpectDocument(const char* markdown, const char* html) {
	Core::String got = MdHtml::RenderDocument(Core::StringView(markdown));
	assert_se(html, got.CStr(), markdown);
}

[test("mdhtml.document.empty")]
static void RendersNothingForAnEmptyDocument() {
	ExpectDocument("", "");
	ExpectDocument("\n  \n\t\n", "");
}

[test("mdhtml.document.paragraphs")]
static void JoinsParagraphLines() {
	ExpectDocument("a\nb\n\nc", "<p>a\nb</p>\n<p>c</p>\n");
	ExpectDocument("  a  \r\n  b", "<p>a\nb</p>\n");
}

[test("mdhtml.document.headings")]
static void RendersHeadings() {
	ExpectDocument("# One\n## Two ##\n####### seven", "<h1>One</h1>\n<h2>Two</h2>\n<p>####### seven</p>\n");
}

[test("mdhtml.document.paragraph_ends")]
static void EndsParagraphsAtOtherBlocks() {
	ExpectDocument("text\n# Head\nmore", "<p>text</p>\n<h1>Head</h1>\n<p>more</p>\n");
	ExpectDocument("text\n---", "<p>text</p>\n<hr />\n");
	ExpectDocument("text\n- item", "<p>text</p>\n<ul>\n<li>item</li>\n</ul>\n");
}

[test("mdhtml.document.code_blocks")]
static void RendersCodeBlocks() {
	ExpectDocument("```js\nif (a < b) {}\n```", "<pre><code class=\"language-js\">if (a &lt; b) {}\n</code></pre>\n");
	ExpectDocument("```\n```", "<pre><code></code></pre>\n");
}

[test("mdhtml.document.unclosed_fence")]
static void RunsAnUnclosedFenceToTheEnd() {
	ExpectDocument("```\n  keep\n\n*x*", "<pre><code>  keep\n\n*x*\n</code></pre>\n");
}

[test("mdhtml.document.quotes")]
static void ParsesQuoteContentAsBlocks() {
	ExpectDocument("> a\n> b\n>\n> c", "<blockquote>\n<p>a\nb</p>\n<p>c</p>\n</blockquote>\n");
	ExpectDocument("> a\n>> b", "<blockquote>\n<p>a</p>\n<blockquote>\n<p>b</p>\n</blockquote>\n</blockquote>\n");
	ExpectDocument("> ```\n> x\n> ```\nafter", "<blockquote>\n<pre><code>x\n</code></pre>\n</blockquote>\n<p>after</p>\n");
}

[test("mdhtml.document.quote_end")]
static void EndsAQuoteAtALineWithoutMarker() {
	ExpectDocument("> a\nb", "<blockquote>\n<p>a</p>\n</blockquote>\n<p>b</p>\n");
}

[test("mdhtml.document.list_continuation")]
static void ContinuesListItemsAndListsAcrossBlankLines() {
	ExpectDocument("- a\ncontinued\n\n- b\n\nafter", "<ul>\n<li>a\ncontinued</li>\n<li>b</li>\n</ul>\n<p>after</p>\n");
}

[test("mdhtml.document.nested_lists")]
static void NestsListsByIndentation() {
	ExpectDocument("1. one\n   - sub\n2. two", "<ol>\n<li>one\n<ul>\n<li>sub</li>\n</ul>\n</li>\n<li>two</li>\n</ol>\n");
	ExpectDocument("> - a\n>   - b", "<blockquote>\n<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n</blockquote>\n");
}

[test("mdhtml.document.rule_before_list")]
static void PrefersARuleToAListItem() {
	ExpectDocument("- - -\n-", "<hr />\n<ul>\n<li></li>\n</ul>\n");
}
