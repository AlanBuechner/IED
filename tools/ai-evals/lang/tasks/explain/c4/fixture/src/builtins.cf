include "builtins.ch"

namespace Calc
{
	// Writes the arguments separated by spaces, then a line break.
	static Value BuiltinPrint(const BuiltinCall& call) {
		Core::StringBuilder line;
		for (int64 i = 0; i < call.arguments.Count(); ++i) {
			if (i > 0) line.Append(" ");
			AppendValue(line, call.arguments[i]);
		}
		line.Append("\n");
		call.output->Write(line.View());
		return Value::Nil();
	}

	// The argument as print writes it.
	static Value BuiltinStr(const BuiltinCall& call) {
		return Value::Str(FormatValue(call.arguments[0]).View());
	}

	static void DefineBuiltin(Environment* globals, BuiltinValue* builtin) {
		globals->Define(builtin->name.View(), Value::Builtin(builtin));
	}

	void DefineBuiltins(Environment* globals) {
		DefineBuiltin(globals, new BuiltinValue(Core::StringView("print"), kAnyArgumentCount, BuiltinPrint));
		DefineBuiltin(globals, new BuiltinValue(Core::StringView("str"), 1, BuiltinStr));
	}
}
