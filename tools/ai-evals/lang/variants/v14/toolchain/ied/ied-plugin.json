// The C4 language in IED (docs/tools/03-editor-lsp-dap.md): the language with its grammar and how C4LSP's semantic
// tokens map onto IED's syntax colors (Visual Assist style: `controlFlow` pink, `preprocessor` gray), C4LSP - one server per
// project of a solution, as C4LSP analyzes one program (its options are the ones Nuke writes for the project) - C4DAP,
// the c4 and c4-test problem matchers and output links, the c4.nuke task preset (IED's `nuke` preset with C4's matchers
// and Launch configuration, IED docs/06, docs/25, docs/26), and how C4 files and projects look (teal "C4", a header
// "h"), and the AI skills of this version of the language (skills/). Ships in every toolchain as <toolchain>/ied/
// (MakeToolchain.py); a solution names it in its localPlugins.
{
	"manifestVersion": 1,
	"id": "c4",
	"name": "C4 Language",
	"version": "0.1.0",
	"description": "C4 sources: the language, its grammar and C4LSP (diagnostics, completion, navigation, formatting, refactoring).",
	"publisher": "C4",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"permissions": ["process.spawn", "lsp", "dap", "fs.read"],
	"dependencies": [ { "id": "ied.nuke", "version": "^0.1", "optional": true } ],
	"contributes": {
		"fileIcons": [
			{ "languageId": "c4", "extensions": [".cf"], "label": "C4", "color": "--hue-teal" },
			{ "languageId": "c4", "extensions": [".ch"], "label": "h", "color": "--hue-teal" }
		],
		"projectIcons": [
			{ "languageId": "c4", "label": "C4", "color": "--hue-teal", "presets": ["c4.nuke"] }
		],
		"outputLinks": [
			{ "id": "c4", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s()<>\"'|*?]+?\\.[A-Za-z0-9_+-]+) \\((\\d+):(\\d+)\\)", "file": 1, "line": 2, "column": 3 },
			{ "id": "c4-test", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		],
		"languages": [
			{
				"id": "c4",
				"aliases": ["C4"],
				"extensions": [".cf", ".ch"],
				"fences": ["c4", "cf", "ch"],
				"lineComment": "//",
				"blockComment": ["/*", "*/"],
				"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
				"autoClosingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
				"indentation": { "increasePattern": "^.*\\{[^}\"']*$", "decreasePattern": "^\\s*\\}" },
				"grammar": "grammars/c4.monarch.json",
				"taskComments": ["TODO", "HACK", "FIXME", "NOTE"]
			}
		],
		"semanticTokenColors": [
			{
				"languageId": "c4",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"type.builtin": "--syntax-keyword",
					"class": "--syntax-type",
					"enum": "--syntax-type",
					"interface": "--syntax-type",
					"struct": "--syntax-type",
					"typeParameter": "--syntax-type",
					"parameter": "--syntax-parameter",
					"variable": "--syntax-variable",
					"field": "--syntax-member",
					"property": "--syntax-member",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"macro": "--syntax-macro",
					"keyword": "--syntax-keyword",
					"modifier": "--syntax-keyword",
					"controlFlow": "--syntax-control",
					"preprocessor": "--syntax-preprocessor",
					"comment": "--syntax-comment",
					"number": "--syntax-number",
					"string": "--syntax-string"
				}
			}
		],
		"headerSourcePairs": [ { "extensions": [".ch", ".cf"] } ],
		"problemMatchers": [
			{
				"id": "c4",
				"source": "c4",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}/src", "${cwd}"] },
				"patterns": [ { "regexp": "^(.+?) \\((\\d+):(\\d+)\\) (fatal error|error|warning|note): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 } ],
				"severityMap": { "fatal error": "error", "note": "info" }
			},
			{
				"id": "c4-test",
				"source": "c4-test",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}/src", "${cwd}"] },
				"patterns": [ { "regexp": "^FAIL: (.+?):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 } ],
				"defaultSeverity": "error"
			}
		],
		"taskPresets": [
			{
				"id": "c4.nuke",
				"label": "C4 (Nuke)",
				"detect": "nuke.toml",
				"extends": "nuke",
				"problemMatcher": ["c4", "c4-test"],
				"debug": {
					"default": "Launch",
					"configurations": {
						"Launch": { "type": "c4", "request": "launch", "program": "${projectOutput}", "cwd": "${projectRoot}", "stopOnEntry": false, "preLaunchTask": "build" }
					}
				}
			}
		],
		"dapProviders": [
			{
				"type": "c4",
				"label": "C4",
				"command": "${pluginDir}/../tools/C4DAP/C4DAP.exe",
				"env": { "C4_HOME": "${pluginDir}/.." },
				"launchMode": "staged",
				"languages": ["c4"],
				"when": "workspaceTrusted"
			}
		],
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/C4" },
		"skills": ["skills"],
		"aiHints": [
			{"match": "cannot bind a reference to a prvalue", "hint": "?: on objects makes a copy, and a function's returned object is a temporary: bind a reference to a variable, or pick between objects through pointers (T* p = c ? &a : &b;)."},
			{"match": "no matching overload of (push_back|emplace_back|size|length|empty|insert|erase|find|c_str|substr|begin|end|at|front|back|append|clear|count|contains|starts_with|ends_with|to_string)\\b", "hint": "Bedrock is not the STL: Push, Count, IsEmpty, Insert, RemoveAt, Find, CStr, Substring (of a StringView), Back, Append, Clear, Contains, StartsWith. docs_read({\"path\": \"c4/library/bedrock-api.md\", \"heading\": \"Core::Array\"}) lists a type's members."},
			{"match": "type not found: auto\\b", "hint": "C4 has no auto: write the type (int64 n = ...; Core::String s = ...)."},
			{"match": "type not found: (std|string|vector|map|unordered_map|size_t)\\b", "hint": "C4 has no C++ standard library: include \"bedrock.ch\" and use Core::String, Core::Array<T>, Core::HashMap<K, V>; sizes and counts are int64."},
			{"match": "Unexpected token '(int|char|float|double|bool|unsigned|long|short|uint8|int32|int64|uint32|uint64|char8)'", "hint": "If this declares an array, the extent belongs to the type: int32[4] values; a char buffer is a Core::StringBuilder."},
			{"match": "Unexpected token .* in type body", "hint": "In a class body, a constructor is [operator(\"create\")] public void Init(...) { ... }, the destructor [operator(\"delete\")] public void Destroy(), and every member says public or private."},
			{"match": "redefinition of (variable|function|type) .*already", "hint": "All files of a project are one program: a function, type or constant defined in two files collides (a `static` function does not; in a namespace a `static` variable or constant does). Give the name one home (a header both include) or a distinct name."},
			{"match": "argument \\d+ of (assert_se|printf|strcmp|strlen) has type '(String|StringView)'", "hint": "This takes a C string: pass s.CStr() (a StringView: Core::String(view).CStr()), or compare with assert_true(s == \"text\")."},
			{"match": "no operator '\\+' takes a '(String|StringView)' on the left and a '(int32|int64|uint64|double|float|bool)'", "hint": "Numbers do not add to strings: build text with Core::StringBuilder (Append, AppendInt, AppendDouble) or Core::Format(&builder, \"{0:D}\", n)."},
			{"match": "Cannot access private (field|method)", "hint": "Members are private unless marked: write public before each member other code uses."},
			{"match": "no function named Core::(Split|Join|ToLower|ToUpper|Trim|ParseDouble|ToString|Lowercase)\\b", "hint": "Bedrock has no such helper: write a small one over Core::StringView (IndexOf, Substring, ByteAt, Trimmed) and Core::StringBuilder."},
			{"match": "cannot initialize '(String|StringView)' from '(int32|int64|double)'", "hint": "Numbers become text through Core::StringBuilder.AppendInt / AppendDouble or Core::Format, not a constructor."}
		],
		"aiDocs": [ { "id": "c4", "title": "C4 language, Bedrock library (library/bedrock-api.md: every type's and function's signatures; library/bedrock.md: the guide), runtime and tools reference", "folder": "docs" } ],
		"systemMessageSections": [
			{ "id": "c4", "when": "workspaceLanguage.c4", "maxTokens": 600, "text": "C4 (.cf sources, .ch headers) looks like C++ but is not, and C++ habits are its usual compile errors. Read the c4-language skill before writing C4, c4-testing before writing tests. What every program needs:\n- One program per project: all .cf/.ch files of src/ compile together. `include \"x.ch\"` (no #include, no ../). File-scope constants and variables need names unique across ALL files (two files may not both define `kMax`; in a namespace not even as `static`); a `static` helper function is private to its file.\n- Entry: `int32 main(int32 argc, char** argv)`. Types: int32, int64, uint8, float, double, bool, char8. No `auto`: write the type. Arrays and pointers belong to the type: `int32[4] a;`, not `int a[4]`.\n- Class members are private unless marked, each one: `public int64 count;`. Constructors, destructors and operators are annotated methods: `[operator(\"create\")] public void Init(int64 n) { ... }`, `[operator(\"delete\")]`, `[operator(\"==\")]`. Make objects with `T x = T(args);` or `T x(args);`; `new T(args)` is garbage collected. A lambda that returns a value names its type: `[](int32 x) -> bool { return x > 0; }`.\n- Library: `include \"bedrock.ch\"`; there is no std::. Core::String (made explicitly: `Core::String(\"text\")`; `s == \"text\"` works), Core::StringView (Split(','), Trimmed, Substring), Core::StringBuilder, Core::Array<T> (Push, Count, Sort, SortBy), Core::HashMap<K, V> (Find, Insert, m[k]), Core::ParseInt64 / ParseDouble, FS::File, Platform::WriteOutput / WriteError (a StringView). Counts are int64. `Core::Format(&builder, \"{0}: {1}\", name, count)` writes Strings, views and numbers as they are; printf is C's: a String goes as `s.CStr()`. Standard input: `Platform::InputLines lines; while (lines.Next(line))`.\n- Before using a Bedrock type or function, read its exact signatures in the API digest: `docs_read({\"path\": \"c4/library/bedrock-api.md\", \"heading\": \"Core::HashMap\"})`; docs_search finds a function by name (`docs_search({\"query\": \"ParseInt64\"})`). Never guess C++ names (Push, not push_back; Count, not size), and do not read the toolchain's headers through the shell.\n- Tests: `[test(\"group.name\")] static void F() { assert_eq((int64)2, Count(), \"why\"); }` in src/tests/*.cf. Build and test with build_run (task \"test\"); try the built program with program_run: `build/bin/Development-windows-x64/<project>/<project>.exe`." }
		],
		"lspProfiles": [
			{
				"id": "c4-language-server",
				"label": "C4LSP",
				"command": "${pluginDir}/../tools/C4LSP/C4LSP.exe",
				"env": { "C4_HOME": "${pluginDir}/.." },
				"selector": { "languages": ["c4"] },
				"scope": "project",
				"initializationOptionsFile": "${workspaceDir}/.ied/local/lsp-options/${projectName}.json",
				"pluginCodeOption": "scripts",
				"launchMode": "staged",
				"refetchOnDiagnostics": ["semanticTokens", "foldingRange"],
				"codeActionsNeedClientFilter": true,
				"aiExposedRequests": [
					{
						"method": "c4/expandMacro",
						"purpose": "expandMacro",
						"description": "The C4 macro used at a position and what that use expands to: {textDocument, position} -> {name, expansion}, or null where no macro is used."
					}
				],
				"when": "config.c4.languageServer"
			}
		]
	}
}
