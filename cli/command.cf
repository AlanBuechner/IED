include "command.ch"

namespace Cli
{
	const char* Usage() {
		return "usage: ied [<path>[:<line>[:<col>]]]   open a folder or file in IED (default: this folder)\n"
			"       ied status | url | stop\n"
			"options: --control <name> (another server's pipe), --no-browser (print the URL),\n"
			"         --browser (the default browser, not the desktop app)\n";
	}

	static Verb VerbOf(Core::StringView word, bool& known) {
		known = true;
		if (word == "status") return Verb::Status;
		if (word == "url") return Verb::Url;
		if (word == "stop") return Verb::Stop;
		if (word == "help" || word == "--help" || word == "-h") return Verb::Help;
		known = false;
		return Verb::Open;
	}

	bool ParseCommand(const Core::Array<Core::String>& arguments, Command& command, Core::String& error) {
		command.verb = Verb::Open;
		bool positional = false;
		for (int64 i = 0; i < arguments.Count(); ++i) {
			Core::StringView argument = arguments[i].View();
			if (argument == "--no-browser") command.noBrowser = true;
			else if (argument == "--browser") command.browser = true;
			else if (argument == "--control" && i + 1 < arguments.Count()) command.control = arguments[++i];
			else if (argument.StartsWith(Core::StringView("--")) && argument != "--help") {
				error = Core::String("unknown option ") + argument;
				return false;
			}
			else if (positional) {
				error = Core::String("one path or command at a time: ") + argument;
				return false;
			}
			else {
				positional = true;
				bool known = false;
				command.verb = VerbOf(argument, known);
				if (!known) Launch::SplitLocation(argument, command.path, command.line, command.col);
			}
		}
		if (command.verb == Verb::Open && command.path.IsEmpty()) command.path = Core::String(".");
		return true;
	}
}
