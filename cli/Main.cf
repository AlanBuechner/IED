// ied: the IED command line. Opens a folder or a file in the desktop app (or the browser), starting the user's
// ied-server when none runs; `ied status`, `ied url` and `ied stop` ask the running one (docs/10 "Local control
// channel", docs/27).

include "Command.ch"

static Core::Array<Core::String> Arguments(int32 argc, char8** argv) {
	Core::Array<Core::String> arguments;
	for (int32 i = 1; i < argc; ++i) arguments.Push(Core::String((const char*)argv[i]));
	return arguments;
}

static int32 Fail(Core::StringView why) {
	Platform::WriteError((Core::String("ied: ") + why + "\n").View());
	return 1;
}

static int32 Show(const Cli::Command& command, Core::StringView url) {
	if (command.m_NoBrowser || !Launch::OpenExternal(url)) Platform::WriteOutput((Core::String(url) + "\n").View());
	return 0;
}

// `path:line:col` with the path made absolute, as ied-desktop reads it.
static Core::String DesktopLocation(const Cli::Command& command) {
	Core::StringBuilder location;
	location.Append(FS::AbsolutePath(command.m_Path.CStr()).View());
	if (command.m_Line > 0) {
		location.AppendByte(':');
		location.AppendInt(command.m_Line);
		if (command.m_Col > 0) {
			location.AppendByte(':');
			location.AppendInt(command.m_Col);
		}
	}
	return location.ToString();
}

// Hands the location to the desktop app beside ied; false when there is none or it did not start.
static bool OpenInDesktop(const Cli::Command& command) {
	FS::Path desktop = Launch::DesktopProgram();
	if (desktop.IsEmpty()) return false;
	Process::StartInfo info;
	info.program = Core::String(desktop.View());
	info.arguments.Push(DesktopLocation(command));
	if (!command.m_Control.IsEmpty()) {
		info.arguments.Push(Core::String("--control"));
		info.arguments.Push(command.m_Control);
	}
	info.input = Process::Redirect::Null;
	info.output = Process::Redirect::Null;
	info.errors = Process::Redirect::Null;
	info.killOnClose = false;
	Process::Child child = Process::Child::Start(info);
	return child.IsOpen();
}

static int32 Run(const Cli::Command& command, Net::LocalStream& stream) {
	if (command.m_Verb == Cli::Verb::Open) {
		if (!command.m_NoBrowser && !command.m_Browser && OpenInDesktop(command)) return 0;
		Launch::Reply reply = Launch::Ask(stream, Core::StringView("open"), Launch::OpenParams(command.m_Path.View(), command.m_Line, command.m_Col).View());
		return reply.m_Ok ? Show(command, Launch::ResultField(reply, "url").View()) : Fail(reply.m_Error.View());
	}
	if (command.m_Verb == Cli::Verb::Url) {
		Launch::Reply reply = Launch::Ask(stream, Core::StringView("url"), Core::StringView(""));
		return reply.m_Ok ? Show(command, Launch::ResultField(reply, "url").View()) : Fail(reply.m_Error.View());
	}
	Launch::Reply reply = Launch::Ask(stream, Core::StringView(command.m_Verb == Cli::Verb::Stop ? "stop" : "status"), Core::StringView(""));
	if (!reply.m_Ok) return Fail(reply.m_Error.View());
	if (command.m_Verb == Cli::Verb::Status) Platform::WriteOutput((reply.m_Result + "\n").View());
	if (command.m_Verb == Cli::Verb::Stop && !Launch::AwaitGone(command.m_Control.View())) return Fail(Core::StringView("the server said it stops but still answers"));
	return 0;
}

int32 main(int32 argc, char8** argv) {
	Cli::Command command;
	Core::String error;
	if (!Cli::ParseCommand(Arguments(argc, argv), command, error)) {
		Fail(error.View());
		Platform::WriteError(Core::StringView(Cli::Usage()));
		return 2;
	}
	if (command.m_Verb == Cli::Verb::Help) {
		Platform::WriteOutput(Core::StringView(Cli::Usage()));
		return 0;
	}
	Core::String name = Launch::ControlName(command.m_Control.View());
	Net::LocalStream stream = Net::LocalStream::Connect(name.CStr(), Launch::c_ConnectMs);
	if (!stream.IsOpen() && (command.m_Verb == Cli::Verb::Status || command.m_Verb == Cli::Verb::Stop)) return Fail(Core::StringView("no ied-server runs for this user"));
	if (!stream.IsOpen()) stream = Launch::StartServer(command.m_Control.View(), error);
	if (!stream.IsOpen()) return Fail(error.View());
	return Run(command, stream);
}
