include "client.ch"

namespace Cli
{
	Core::String RequestLine(Core::StringView method, Core::StringView paramsJson) {
		Core::StringBuilder line;
		line.Append("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
		line.Append(method);
		line.AppendByte('"');
		if (!paramsJson.IsEmpty()) {
			line.Append(",\"params\":");
			line.Append(paramsJson);
		}
		line.Append("}\n");
		return line.ToString();
	}

	Reply ParseReply(Core::StringView line) {
		Reply reply;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(line, *doc);
		Serialization::DomNode result = parsed.Ok() ? parsed.root.Member("result") : Serialization::DomNode();
		Serialization::DomNode failure = parsed.Ok() ? parsed.root.Member("error") : Serialization::DomNode();
		if (result.IsValid()) {
			reply.ok = true;
			reply.result = Core::String(line);
		}
		else if (failure.IsValid()) reply.error = Core::String(failure.Member("message").AsView());
		else reply.error = Core::String("the server's answer was not JSON-RPC");
		return reply;
	}

	// One line from the stream: false when it closed or went quiet first.
	static bool ReadLine(Net::LocalStream& stream, Core::String& line) {
		Core::StringBuilder text;
		char[4096] chunk;
		for (;;) {
			const int64 got = stream.Receive((void*)&chunk[0], 4096, kAnswerMs);
			if (got <= 0) return false;
			text.AppendBytes(&chunk[0], got);
			const int64 end = text.View().IndexOf('\n', 0);
			if (end < 0) continue;
			line = Core::String(text.View().Substring(0, end));
			return true;
		}
	}

	Reply Ask(Net::LocalStream& stream, Core::StringView method, Core::StringView paramsJson) {
		Core::String line;
		if (!stream.SendText(RequestLine(method, paramsJson).View(), kAnswerMs) || !ReadLine(stream, line)) {
			Reply failed;
			failed.error = Core::String("the server did not answer");
			return failed;
		}
		return ParseReply(line.View());
	}

	FS::Path ServerProgram() {
		FS::Path here = Platform::ExecutablePath().Parent();
		FS::Path beside = here / "ied-server.exe";
		if (FS::FileExists(beside.CStr())) return beside;
		FS::Path sibling = here.Parent() / "ied-server" / "ied-server.exe";
		return FS::FileExists(sibling.CStr()) ? sibling : FS::Path();
	}

	FS::Path WebClientFolder() {
		for (FS::Path at = Platform::ExecutablePath().Parent(); !at.IsEmpty(); at = at.Parent()) {
			FS::Path candidate = at / "frontend";
			if (FS::FileExists((candidate / "login.html").CStr())) return candidate;
			if (at.Parent().View() == at.View()) break;
		}
		return FS::Path();
	}

	static Process::StartInfo ServerStart(const FS::Path& program, Core::StringView control) {
		Process::StartInfo info;
		info.program = Core::String(program.View());
		FS::Path web = WebClientFolder();
		if (!web.IsEmpty()) {
			info.arguments.Push(Core::String("--static"));
			info.arguments.Push(Core::String(web.View()));
		}
		if (!control.IsEmpty()) {
			info.arguments.Push(Core::String("--control"));
			info.arguments.Push(Core::String(control));
		}
		// No stream shared, so it gets a hidden console of its own and outlives the one ied ran in.
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		info.killOnClose = false;
		return info;
	}

	bool AwaitGone(Core::StringView control) {
		Core::String name = Core::String(control);
		const int64 deadline = clock_now_ns() + kServerStartMs * 1000000;
		while (clock_now_ns() < deadline) {
			Net::LocalStream probe = Net::LocalStream::Connect(name.CStr(), 0);
			if (!probe.IsOpen() && !probe.TimedOut()) return true;
			Threading::Thread::Sleep(50000000);
		}
		return false;
	}

	Net::LocalStream StartServer(Core::StringView control, Core::String& error) {
		FS::Path program = ServerProgram();
		if (program.IsEmpty()) {
			error = Core::String("ied-server.exe is not beside ied");
			return Net::LocalStream();
		}
		Process::Child child = Process::Child::Start(ServerStart(program, control));
		if (!child.IsOpen()) {
			error = Core::String("ied-server did not start: ") + child.Error();
			return Net::LocalStream();
		}
		const int64 deadline = clock_now_ns() + kServerStartMs * 1000000;
		Core::String name = control.IsEmpty() ? Net::UserLocalName("ied") : Core::String(control);
		while (clock_now_ns() < deadline) {
			Net::LocalStream stream = Net::LocalStream::Connect(name.CStr(), kConnectMs);
			if (stream.IsOpen()) return stream;
			if (child.Wait(100) != Process::kTimedOut) break;
		}
		error = Core::String("ied-server started but its control pipe never opened");
		return Net::LocalStream();
	}
}
