.ied/local/

# Agent worktrees, editors and OS noise
.claude/worktrees/
.claude/settings.local.json
.vs/
*.user
Thumbs.db
__pycache__/
*.pyc
.cache/

# Per-machine preview servers of agent sessions
.claude/launch.json
