// The C4 language in IED (docs/tools/03-editor-lsp-dap.md): the language with its grammar and how C4LSP's semantic
// tokens map onto IED's syntax colors (Visual Assist style: `controlFlow` pink, `preprocessor` gray), C4LSP - one server per
// project of a solution, as C4LSP analyzes one program (its options are the ones Nuke writes for the project) - C4DAP,
// and the c4.nuke task preset (with its Launch configuration) and the c4 and c4-test problem matchers (IED docs/06,
// docs/25), and how C4 files and projects look (teal "C4", a header "h"; a Nuke manifest its own). Ships in every
// toolchain as
// <toolchain>/ied/ (MakeToolchain.py); a solution names it in its localPlugins.
{
	"manifestVersion": 1,
	"id": "c4",
	"name": "C4 Language",
	"version": "0.1.0",
	"description": "C4 sources: the language, its grammar and C4LSP (diagnostics, completion, navigation, formatting, refactoring).",
	"publisher": "C4",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"permissions": ["process.spawn", "lsp", "dap", "fs.read"],
	"contributes": {
		"fileIcons": [
			{ "languageId": "c4", "extensions": [".cf"], "label": "C4", "color": "--hue-teal" },
			{ "languageId": "c4", "extensions": [".ch"], "label": "h", "color": "--hue-teal" },
			{ "fileNames": ["nuke.toml"], "label": "NK", "color": "--hue-red" }
		],
		"projectIcons": [
			{ "languageId": "c4", "label": "C4", "color": "--hue-teal", "presets": ["c4.nuke"] }
		],
		"languages": [
			{
				"id": "c4",
				"aliases": ["C4"],
				"extensions": [".cf", ".ch"],
				"lineComment": "//",
				"blockComment": ["/*", "*/"],
				"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
				"autoClosingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
				"indentation": { "increasePattern": "^.*\\{[^}\"']*$", "decreasePattern": "^\\s*\\}" },
				"grammar": "grammars/c4.monarch.json",
				"taskComments": ["TODO", "HACK", "FIXME", "NOTE"]
			}
		],
		"semanticTokenColors": [
			{
				"languageId": "c4",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"type.builtin": "--syntax-keyword",
					"class": "--syntax-type",
					"enum": "--syntax-type",
					"interface": "--syntax-type",
					"struct": "--syntax-type",
					"typeParameter": "--syntax-type",
					"parameter": "--syntax-parameter",
					"variable": "--syntax-variable",
					"field": "--syntax-member",
					"property": "--syntax-member",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"macro": "--syntax-macro",
					"keyword": "--syntax-keyword",
					"modifier": "--syntax-keyword",
					"controlFlow": "--syntax-control",
					"preprocessor": "--syntax-preprocessor",
					"comment": "--syntax-comment",
					"number": "--syntax-number",
					"string": "--syntax-string"
				}
			}
		],
		"headerSourcePairs": [ { "extensions": [".ch", ".cf"] } ],
		"problemMatchers": [
			{
				"id": "c4",
				"source": "c4",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}/src", "${cwd}"] },
				"patterns": [ { "regexp": "^(.+?) \\((\\d+):(\\d+)\\) (fatal error|error|warning|note): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 } ],
				"severityMap": { "fatal error": "error", "note": "info" }
			},
			{
				"id": "c4-test",
				"source": "c4-test",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}/src", "${cwd}"] },
				"patterns": [ { "regexp": "^FAIL: (.+?):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 } ],
				"defaultSeverity": "error"
			}
		],
		"taskPresets": [
			{
				"id": "c4.nuke",
				"label": "Nuke",
				"detect": "nuke.toml",
				"variables": {
					"config": { "kind": "dropdown", "label": "Configuration", "values": ["Debug", "Development", "Dist"], "default": "Development", "scope": "solution" },
					"arch": { "kind": "dropdown", "label": "Platform", "values": ["x64"], "default": "x64", "scope": "solution" }
				},
				"tasks": {
					"build": { "label": "Build", "icon": "$(gear)", "slot": "build", "steps": [{ "run": "\"${setting:c4.nuke.command}\" build ${config} ${projectName} -a ${arch}", "problemMatcher": "c4" }] },
					"rebuild": { "label": "Rebuild", "slot": "rebuild", "steps": [{ "run": "\"${setting:c4.nuke.command}\" rebuild ${config} ${projectName} -a ${arch}", "problemMatcher": "c4" }] },
					"clean": { "label": "Clean", "slot": "clean", "steps": [{ "run": "\"${setting:c4.nuke.command}\" clean ${config} ${projectName} -a ${arch}", "problemMatcher": "c4" }] },
					"run": { "label": "Run", "icon": "$(run)", "slot": "run", "concurrency": "restart", "steps": [{ "run": "\"${setting:c4.nuke.command}\" run ${config} ${projectName} -a ${arch}", "problemMatcher": "c4", "output": "run" }] },
					"test": { "label": "Test", "icon": "$(beaker)", "slot": "test", "steps": [{ "run": "\"${setting:c4.nuke.command}\" test ${config} ${projectName} -a ${arch}", "problemMatcher": ["c4", "c4-test"], "output": "test" }] }
				},
				"toolbar": ["config", "arch", "|", "run", "build", "test"],
				"debug": {
					"default": "Launch",
					"configurations": {
						"Launch": { "type": "c4", "request": "launch", "program": "${workspaceDir}/build/bin/${config}-windows-${arch}/${projectName}/${projectName}.exe", "cwd": "${projectRoot}", "stopOnEntry": false, "preLaunchTask": "build" }
					}
				}
			}
		],
		"dapProviders": [
			{
				"type": "c4",
				"label": "C4",
				"command": "${pluginDir}/../tools/C4DAP/C4DAP.exe",
				"env": { "C4_HOME": "${pluginDir}/.." },
				"launchMode": "staged",
				"languages": ["c4"],
				"when": "workspaceTrusted"
			}
		],
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/C4" },
		"lspProfiles": [
			{
				"id": "c4-language-server",
				"label": "C4LSP",
				"command": "${pluginDir}/../tools/C4LSP/C4LSP.exe",
				"env": { "C4_HOME": "${pluginDir}/.." },
				"selector": { "languages": ["c4"] },
				"scope": "project",
				"initializationOptionsFile": "${workspaceDir}/.ied/local/lsp-options/${projectName}.json",
				"launchMode": "staged",
				"refetchOnDiagnostics": ["semanticTokens", "foldingRange"],
				"codeActionsNeedClientFilter": true,
				"when": "config.c4.languageServer"
			}
		]
	}
}
