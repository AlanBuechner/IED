// Built with -march=native (ExpectedExit.json): the building machine's widest vectors. `SIMD_FLOAT_LANES` picks the
// width, so the same program runs 16-lane AVX-512 code where the machine has it and 8-lane AVX code elsewhere (D-62).
// main returns the failures.
include "bedrock.ch"

#if SIMD_AVX512F && SIMD_FLOAT_LANES != 16
#error "AVX-512 holds 16 float lanes"
#endif
#if !SIMD_AVX512F && SIMD_AVX && SIMD_FLOAT_LANES != 8
#error "AVX holds 8 float lanes"
#endif

const int32 kLanes = SIMD_FLOAT_LANES;
alias Wide = packed float[kLanes];

Wide Polynomial(Wide x, int32 depth) {
	return depth == 0 ? simd_muladd(simd_muladd(x, 3.0f, 2.0f), x, 1.0f) : Polynomial(x, depth - 1);   // 3x^2 + 2x + 1
}

int32 main() {
	int32 failures = 0;
	Wide x = 0.0f;
	for (int32 i = 0; i < kLanes; ++i) x[i] = (float)i;
	Wide y = Polynomial(x, 2);
	failures += y[0] == 1.0f && y[2] == 17.0f ? 0 : 1;
	failures += y[kLanes - 1] == 3.0f * (float)((kLanes - 1) * (kLanes - 1)) + 2.0f * (float)(kLanes - 1) + 1.0f ? 0 : 1;
	Core::Array<Wide> rows;
	for (int32 r = 0; r < 33; ++r) rows.Push(x + (float)r);
	float total = 0.0f;
	for (const Wide& row : rows) total += simd_reduce_max(row);
	failures += total == (float)(33 * (kLanes - 1) + 528) ? 0 : 1;   // the sum of (kLanes - 1 + r) for r in 0..32
	failures += simd_bitmask(y > 10.0f) == (uint32)((1 << kLanes) - 4) ? 0 : 1;   // every lane but the first two
	return failures;
}
