// `new T[n]` with a run-time count: n zeroed elements, the braced entries start the first ones and the rest are
// default-constructed; arrays of arrays, polymorphic elements and pointers to elements.
int32 g_failures = 0;

void Check(bool ok, const char* what) {
	if (!ok) { printf("FAIL %s\n", what); g_failures++; }
}
struct Point { int32 x; int32 y = 4; }
struct Started { int32 v; [operator("create")] void Init() { v = 3; } [operator("create")] void Init(int32 x) { v = x; } }
class Shape { public virtual int32 Sides() { return 0; } }
class Square : Shape { public override int32 Sides() { return 4; } }
template<T> T* Fill(int32 n, T value) {
	T* items = new T[n];
	for (int32 i = 0; i < n; i++) items[i] = value;
	return items;
}

int32 main() {
	int32 n = 5;
	int32* numbers = new int32[n];
	bool zero = true;
	for (int32 i = 0; i < n; i++) zero = zero && numbers[i] == 0;
	Check(zero, "plain elements start zero");
	numbers[4] = 9;
	Check(numbers[4] == 9, "elements are writable");

	Point* points = new Point[n];
	Check(points[0].x == 0 && points[4].y == 4, "field initializers start every element");
	Started* started = new Started[n]{ Started(1), Started(2) };
	Check(started[0].v == 1 && started[1].v == 2 && started[2].v == 3 && started[4].v == 3, "entries start the first elements, the default create the rest");
	int32* listed = new int32[4]{ 7, 8 };
	Check(listed[0] == 7 && listed[1] == 8 && listed[2] == 0 && listed[3] == 0, "entries then zero");
	int32* designated = new int32[n]{ [3] = 5, 6 };
	Check(designated[3] == 5 && designated[4] == 6 && designated[0] == 0, "designated entries");
	int32* sized = new int32[3]();
	Check(sized[2] == 0, "new T[n]() value-starts the elements");

	int32[2]* rows = new int32[2][3]{ { 1, 2 }, { 3, 4 } };
	Check(rows[0][1] == 2 && rows[1][0] == 3 && rows[2][1] == 0, "an array of arrays");
	Square* squares = new Square[2];
	Shape* shape = &squares[1];
	Check(shape->Sides() == 4, "every element gets its vptrs");
	int32** pointers = new int32*[n];
	pointers[2] = &numbers[4];
	Check(*pointers[2] == 9 && pointers[0] == null, "an array of pointers");
	float* filled = Fill<float>(n, 1.5f);
	Check(filled[4] == 1.5f, "a template element type");
	int32 empty = 0;
	int32* none = new int32[empty];
	Check(none != null, "an empty array is still an allocation");
	uint8 small = 3;
	uint8* bytes = new uint8[small];
	Check(bytes[2] == 0, "any integer count");
	return g_failures;
}
