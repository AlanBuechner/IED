// thread_local objects with a create, a delete or a run-time start (D-48): each attached thread starts its own
// copies before its entry runs and destroys them when it ends; a thread_local local starts on each thread's first
// pass. main returns the failures.
struct Counter {
	public int32 value;
	[operator("create")] public void Init() { value = 10; atomic_fetch_add(&g_created, 1, MemoryOrder::SeqCst); }
	[operator("delete")] public void End() { atomic_fetch_add(&g_destroyed, 1, MemoryOrder::SeqCst); }
}

struct Result { public int32 failures; }

int32 g_created = 0;
int32 g_destroyed = 0;
const int32 kThreads = 4;
const int32 kObjectsPerThread = 4; // t_counter, both of t_pair, Visits' counter

int32 Seed() { return (int32)(thread_current_id() % 1000) + 1; }

thread_local Counter t_counter;
thread_local int32 t_seed = Seed();
thread_local Counter[2] t_pair;

int32 Visits() {
	thread_local Counter visits;
	visits.value += 1;
	return visits.value;
}

int32 Check() {
	int32 failures = 0;
	if (t_counter.value != 10 || t_pair[0].value != 10 || t_pair[1].value != 10) failures++;
	if (t_seed != Seed()) failures++;
	t_counter.value += 5;
	if (t_counter.value != 15) failures++;
	Visits();
	Visits();
	if (Visits() != 13) failures++;
	return failures;
}

void Run(void* state) {
	Result* r = (Result*)state;
	r->failures = Check();
}

int32 main() {
	int32 failures = Check();
	Result*[kThreads] results;
	void*[kThreads] threads;
	for (int32 i = 0; i < kThreads; i++) {
		results[i] = new Result;
		threads[i] = thread_start(Run, (void*)results[i]);
	}
	for (int32 i = 0; i < kThreads; i++) {
		thread_join(threads[i]);
		failures += results[i]->failures;
	}
	if (atomic_load(&g_created, MemoryOrder::SeqCst) != kObjectsPerThread * (kThreads + 1)) failures++;
	if (atomic_load(&g_destroyed, MemoryOrder::SeqCst) != kObjectsPerThread * kThreads) failures++; // main's end at exit
	return failures;
}
