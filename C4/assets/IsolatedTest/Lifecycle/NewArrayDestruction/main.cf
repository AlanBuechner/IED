// A heap array's elements are destroyed exactly once: by `delete[] p` (or `delete p`, the same thing on the
// collected heap), or by the collector when the array is unreachable; the elements of an array of arrays too.
int32 g_failures = 0;
int32 g_live = 0;

void Check(bool ok, const char* what) {
	if (!ok) { printf("FAIL %s\n", what); g_failures++; }
}
struct Counted {
	int32 id;
	[operator("create")] void Init() { g_live++; id = g_live; }
	[operator("delete")] void Done() { if (id != 0) g_live--; id = 0; }
}
void Drop(int32 n) { Counted* lost = new Counted[n]; }

int32 main() {
	int32 n = 4;
	Counted* items = new Counted[n];
	Check(g_live == 4, "every element is started");
	delete[] items;
	Check(g_live == 0, "delete[] destroys every element");
	Counted* more = new Counted[n];
	delete more;
	Check(g_live == 0, "delete destroys every element of an array too");
	Counted[3]* grid = new Counted[3][n];
	Check(g_live == 12, "an array of arrays starts every innermost element");
	delete[] grid;
	Check(g_live == 0, "and destroys every one");
	for (int32 i = 0; i < 40; i++) Drop(25);
	gc_collect();
	gc_collect();
	Check(g_live < 1000, "the collector destroys unreachable arrays");
	Counted* nothing = null;
	delete[] nothing;
	return g_failures;
}
