// A directive continues on the next line after a trailing backslash, a macro call may span lines, and
// every line keeps its number (docs/language/02).
#define SQUARE_SUM(a, b) \
    ((a) * (a) + \
     (b) * (b))

#if defined(SQUARE_SUM) && \
    1
#define CONTINUED 1
#endif

[test("macros.continuation.define")]
public static void TestContinuedDefine() {
    assert_eq(25, SQUARE_SUM(3, 4), "a three-line definition");
    assert_eq(1, CONTINUED, "a two-line #if");
}

[test("macros.continuation.call")]
public static void TestCallAcrossLines() {
    int32 value = SQUARE_SUM(1,
                             2);
    assert_eq(5, value, "a call whose arguments continue on the next line");
    int32 commented = SQUARE_SUM(2, // the first
                                 1);
    assert_eq(5, commented, "a comment inside the call does not hide the next line");
}

[test("macros.continuation.lines")]
public static void TestLinesStay() {
    assert_eq(30, __LINE__, "line numbers after continued directives and calls are unchanged");
}
