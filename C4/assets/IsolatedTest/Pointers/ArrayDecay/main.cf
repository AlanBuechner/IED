// An array decays to a pointer to its first element where a pointer is wanted (BUG-090): in an
// initialization, an assignment, an argument and a return.
int32 g_failures = 0;

void Check(bool ok, const char* what) {
	if (!ok) { printf("FAIL %s\n", what); g_failures++; }
}

int32 Sum(int32* p, int32 n) {
	int32 s = 0;
	for (int32 i = 0; i < n; i++) s = s + p[i];
	return s;
}
int32 FirstConst(const int32* p) { return p[0]; }
int64 AsAddress(void* p) { return (int64)p; }

struct Grid { public int32[4] cells; }
int32* CellsOf(Grid& g) { return g.cells; }

int32 main() {
	int32[3] a;
	a[0] = 4; a[1] = 5; a[2] = 6;
	int32* p = a;
	Check(p[0] == 4 && p[2] == 6, "initialization takes the first element's address");
	Check(p == &a[0], "the address of the first element");
	int32* q;
	q = a;
	Check(q[1] == 5, "assignment decays too");
	Check(Sum(a, 3) == 15, "an array argument to a pointer parameter");
	Check(FirstConst(a) == 4, "to a pointer-to-const parameter");
	Check(AsAddress(a) == (int64)&a[0], "to a void* parameter");
	Grid g;
	g.cells[3] = 9;
	Check(CellsOf(g)[3] == 9, "a field array returned as a pointer");
	return g_failures;
}
