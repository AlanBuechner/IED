include "vecns.ch"
int32 main() {
	// In-namespace alias resolves across files (was "Unknown type 'Math::V3F'").
	Math::V3F a; a.data[0] = 1.5f; a.data[1] = 2.5f;

	// Method returning the template param by value, on a namespaced instantiation.
	if ((int32)a.Get(0) != 1) return 1;       // (int32)1.5 == 1
	if ((int32)a.Get(1) != 2) return 2;       // (int32)2.5 == 2

	// Method taking a T param.
	if (!a.Has(0, 1.5f)) return 3;
	if (a.Has(0, 9.0f)) return 4;

	// In-namespace free function using the alias + both methods cross-file.
	float d = Math::DotV3(a, a);              // a.Get(0) + a.Get(1) = 1.5 + 2.5 = 4.0
	if (d < 3.9f || d > 4.1f) return 5;
	return 0;
}
