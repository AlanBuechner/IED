// BUG-062 and the goto rules: falling through into a label continues there; a backward goto destroys
// what it leaves; a forward goto out of nested blocks runs their cleanups.
int32 g_dtor;
struct Res { [operator("delete")] public void Fini() { g_dtor++; } };

int32 FallThroughIntoLabel(int32 a) {
	int32 v = 0;
	if (a != 0) goto L;
	v = 5;
L:
	v = v + 1;
	return v;
}

int32 BackwardGotoDestroys() {
	g_dtor = 0;
	int32 n = 0;
again:
	{
		Res r;
		n++;
		if (n < 3) goto again;
	}
	return g_dtor;
}

int32 ForwardGotoOutOfNested() {
	g_dtor = 0;
	int32 hits = 0;
	{
		Res a;
		{
			Res b;
			if (hits == 0) goto out;
			hits = 100;
		}
	}
out:
	return g_dtor;
}

int32 main() {
	int32 failures = 0;
	if (FallThroughIntoLabel(0) != 6) failures++;
	if (FallThroughIntoLabel(1) != 1) failures++;
	if (BackwardGotoDestroys() != 3) failures++;
	if (ForwardGotoOutOfNested() != 2) failures++;
	if (failures != 0) printf("GotoScopes failures: %d\n", failures);
	return failures;
}
