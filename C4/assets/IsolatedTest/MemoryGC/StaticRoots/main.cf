// BUG-008: every global storage that may hold a pointer is a root - a plain global, a file-scope static, a
// static data member, a function-local static, a global array of pointers and a global struct with a
// pointer field. A global integer is not.
include "Memory/gc.ch"

struct Tracked {
	public int32 value;
	[operator("delete")] void Finalize() { g_finalized++; }
}

struct Holder { public int32 count; public Tracked* item; }

struct Registry { public static Tracked* s_item; }

struct Garbage { public int64[8] words; }

int32 g_finalized = 0;
Tracked* g_plain = null;
static Tracked* g_fileStatic = null;
Tracked*[4] g_array;
Holder g_holder;

Tracked* Make(int32 value) {
	Tracked* t = new Tracked;
	t->value = value;
	return t;
}

Tracked* LocalStatic() {
	static Tracked* s_local = null;
	if (s_local == null) s_local = Make(5);
	return s_local;
}

void Fill() {
	g_plain = Make(1);
	g_fileStatic = Make(2);
	Registry::s_item = Make(3);
	g_array[3] = Make(4);
	LocalStatic();
	g_holder.item = Make(6);
}

int64 Scrub(int32 depth) {
	int64[128] junk;
	for (int32 i = 0; i < 128; i++) junk[i] = depth;
	GC::IsReachable((void*)&junk);
	if (depth == 0) return junk[1];
	return Scrub(depth - 1) + junk[2];
}

int32 Sum() {
	return g_plain->value + g_fileStatic->value + Registry::s_item->value + g_array[3]->value + LocalStatic()->value
		+ g_holder.item->value;
}

int32 main() {
	Fill();
	for (int32 round = 0; round < 4; round++) {
		for (int32 k = 0; k < 2000; k++) { Garbage* g = new Garbage; g->words[0] = k; }
		Scrub(8);
		GC::Collect();
	}
	if (g_finalized != 0) return 1;
	if (Sum() != 21) return 2;
	printf("STATIC ROOTS OK\n");
	return 0;
}
