// BUG-094: finalizers run after the collection, in dependency order. An unreachable finalizable object keeps
// what it refers to alive for its finalizer; an object another unreachable finalizable object refers to is
// finalized only after that one; an object's pointers to itself do not hold it back; a finalizer may
// allocate; every finalizer runs once.
include "Memory/gc.ch"

const int32 kPairs = 100;

struct Inner {
	public int32 tag;
	public bool finalized;
	[operator("delete")] void Finalize() { finalized = true; g_innerFinalized++; }
}

struct Outer {
	public Inner* inner;
	public int32 tag;
	[operator("delete")] void Finalize() {
		if (inner->finalized || inner->tag != tag) g_orderViolations++;
		int32* scratch = new int32;   // allocating in a finalizer is allowed
		*scratch = tag;
		g_outerFinalized++;
	}
}

struct SelfRef {
	public SelfRef* self;
	[operator("delete")] void Finalize() { g_selfFinalized++; }
}

struct Cyclic {
	public Cyclic* other;
	[operator("delete")] void Finalize() { g_cyclicFinalized++; }
}

int32 g_innerFinalized = 0;
int32 g_outerFinalized = 0;
int32 g_orderViolations = 0;
int32 g_selfFinalized = 0;
int32 g_cyclicFinalized = 0;

void MakeGarbage() {
	for (int32 i = 0; i < kPairs; i++) {
		Outer* o = new Outer;
		o->tag = i;
		o->inner = new Inner;
		o->inner->tag = i;
		SelfRef* s = new SelfRef;
		s->self = s;
		Cyclic* a = new Cyclic;
		Cyclic* b = new Cyclic;
		a->other = b;
		b->other = a;
	}
}

int64 Scrub(int32 depth) {
	int64[128] junk;
	for (int32 i = 0; i < 128; i++) junk[i] = depth;
	GC::IsReachable((void*)&junk);
	if (depth == 0) return junk[1];
	return Scrub(depth - 1) + junk[2];
}

void Collect() {
	Scrub(8);
	GC::Collect();
}

int32 main() {
	MakeGarbage();
	Collect();
	if (g_innerFinalized != 0) return 1;              // every inner waits for its outer
	if (g_outerFinalized < kPairs - 5) return 2;
	if (g_selfFinalized < kPairs - 5) return 3;
	Collect();
	Collect();
	Collect();
	if (g_orderViolations != 0) return 4;
	if (g_innerFinalized < kPairs - 5) return 5;
	if (g_cyclicFinalized < 2 * kPairs - 10) return 6;  // cycles of finalizable objects are finalized too
	if (g_innerFinalized > kPairs || g_outerFinalized > kPairs || g_selfFinalized > kPairs) return 7;
	if (g_cyclicFinalized > 2 * kPairs) return 8;
	printf("FINALIZER ORDER OK\n");
	return 0;
}
