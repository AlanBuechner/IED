// GC end-to-end test for the v1 Go-style stop-the-world mark-sweep collector.
//
// Guarantees verified here (all deterministic):
//   1. Basic alloc returns non-null; fields read/write correctly.
//   2. new T(args) runs the [operator("create")] constructor.
//   3. new T{...} aggregate-initializes when there is no create constructor.
//   4. delete ptr frees and runs [operator("delete")] exactly once.
//   5. Liveness: a reachable object survives repeated collections under churn.
//   6. Manual gc_collect() mid-program is safe and does not disturb live objects.
//   7. Stats: allocs/collections counters reflect the work performed.
//   8. Memory bounded: heavy churn keeps the committed heap within one arena of start.
//   9. Cycles: repeated build/drop/collect of pointer cycles does NOT grow the heap
//      unboundedly (conservative over-retention is bounded, never a leak).
//
// Exit code = number of failed checks (0 = pass).

struct Node { int32 id; Node* next; };
struct Chunk { int32 a; int32 b; int32 c; int32 d; };

int32 g_fail = 0;
void Check(int32 cond, const char* msg) { if (!cond) { printf("FAIL: %s\n", msg); g_fail++; } }

// --- Constructor + finalizer types ---
int32 g_finalized = 0;
struct Widget {
    int32 value;
    [operator("create")] void Init(int32 v) { value = v * 2; }
    [operator("delete")] void Finalize() { g_finalized++; }
};

// --- Aggregate-init type (no create constructor) ---
struct Vec2 { float x; float y; };

Node* g_a;
Node* g_b;

void MakeAndDropCycle() {
    Node* a = new Node;
    Node* b = new Node;
    a->id = 100;
    b->id = 200;
    a->next = b;
    b->next = a;
    g_a = a;
    g_b = b;
    g_a = nullptr;   // drop the only external references (inside this frame)
    g_b = nullptr;
}

int32 main() {
    // --- 1. Basic alloc + field round-trip ---
    Chunk* c = new Chunk;
    Check(c != nullptr, "alloc returns non-null");
    c->a = 10; c->b = 20; c->c = 30; c->d = 40;
    Check(c->a == 10 && c->b == 20 && c->c == 30 && c->d == 40, "field read/write round-trip");

    // --- 2. new T(args) runs the [operator("create")] constructor ---
    Widget* w = new Widget(21);
    Check(w != nullptr, "ctor alloc non-null");
    Check(w->value == 42, "create constructor ran with arg");

    // --- 3. new T{...} aggregate init (no create constructor) ---
    Vec2* v = new Vec2{ 1.5f, -2.5f };
    Check(v != nullptr, "aggregate alloc non-null");
    Check(v->x == 1.5f && v->y == -2.5f, "aggregate init set fields");

    // --- 4. delete frees and runs the finalizer exactly once ---
    Widget* w2 = new Widget(5);
    Check(g_finalized == 0, "no finalizer before delete");
    delete w2;
    Check(g_finalized == 1, "finalizer ran once after delete");

    // --- 5. Liveness: reachable object survives repeated collections under churn ---
    uint64 allocsBefore = gc_allocs();
    for (int32 i = 0; i < 20; ++i) {
        Chunk* tmp = new Chunk;
        tmp->a = i;
        gc_collect();
    }
    Check(c->a == 10 && c->d == 40, "liveness: live object survives churn + collect");

    // --- 6. Manual trigger mid-program is safe and does not disturb live objects ---
    gc_collect();
    Check(c->c == 30 && w->value == 42, "manual gc_collect() is safe");

    // --- 7. Stats: allocation counter reflects the churn we performed ---
    uint64 allocsNow = gc_allocs();
    Check(allocsNow >= allocsBefore + 20, "gc_allocs counts allocations");
    Check(gc_collections() > 0, "gc_collections recorded collections");

    // --- 8. Memory bounded: heavy churn keeps the committed heap within one arena ---
    uint64 heapStart = gc_heap_bytes();
    for (int32 i = 0; i < 2000; ++i) {
        Chunk* x = new Chunk;   // dropped at end of each iteration
        x->a = i;
    }
    gc_collect();
    uint64 heapEnd = gc_heap_bytes();
    Check(heapEnd <= heapStart + (16 * 1024 * 1024), "memory bounded after heavy churn");
    Check(c->d == 40, "live object intact after load test");

    // --- 9. Cycles: repeated build/drop/collect does not grow the heap unboundedly ---
    uint64 cycStart = gc_heap_bytes();
    for (int32 round = 0; round < 100; ++round) {
        MakeAndDropCycle();
        gc_collect();
    }
    uint64 cycEnd = gc_heap_bytes();
    // 100 discarded cycles must not consume more than one full arena. If the collector
    // leaked a cycle per round this would grow far beyond a single 16 MiB arena.
    Check(cycEnd < cycStart + (16 * 1024 * 1024), "cycles do not leak unboundedly");

    if (g_fail == 0) { printf("GCTEST OK\n"); return 0; }
    printf("GCTEST FAILED: %d check(s)\n", g_fail);
    return g_fail;
}
