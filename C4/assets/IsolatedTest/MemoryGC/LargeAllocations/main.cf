// BUG-033: objects larger than an arena, and aligned allocations. Large objects get their own pages, survive
// while referenced, are reclaimed when dropped and give their memory back to the OS once they have been free
// for a collection.
include "Memory/gc.ch"

[link("c4_alloc")] uint8* GcAlloc(uint64 size, uint64 align);

const uint64 kMiB = 1048576;
const int32 kDropped = 20;

bool Filled(uint8* p, uint64 size, uint8 mark) {
	return p[0] == mark && p[size / 2] == mark && p[size - 1] == mark;
}

uint8* MakeFilled(uint64 size, uint8 mark) {
	uint8* p = GcAlloc(size, 16);
	if (p == null) return null;
	if (p[0] != 0 || p[size / 2] != 0 || p[size - 1] != 0) return null; // managed memory starts zeroed
	p[0] = mark;
	p[size / 2] = mark;
	p[size - 1] = mark;
	return p;
}

int32 CheckAlignment() {
	for (uint64 align = 16; align <= 8192; align = align * 2) {
		for (int32 i = 0; i < 8; i++) {
			uint8* p = GcAlloc(24 + (uint64)i * 40, align);
			if ((uint64)p % align != 0) return 1;
		}
	}
	return 0;
}

void DropMany() {
	for (int32 i = 0; i < kDropped; i++) MakeFilled(8 * kMiB, 9);
}

int32 main() {
	uint8* a = MakeFilled(20 * kMiB, 1);
	uint8* b = MakeFilled(100 * kMiB, 2);  // larger than one 64 MiB arena
	uint8* c = MakeFilled(300 * kMiB, 3);
	if (a == null || b == null || c == null) return 1;
	GC::Collect();
	GC::Collect();
	if (!Filled(a, 20 * kMiB, 1) || !Filled(b, 100 * kMiB, 2) || !Filled(c, 300 * kMiB, 3)) return 2;
	uint64 held = GC::GetStats().heapBytes;
	if (held < 420 * kMiB) return 3;

	delete b;
	delete c;
	for (int32 round = 0; round < 3; round++) GC::Collect();
	if (GC::GetStats().heapBytes > held - 300 * kMiB) return 4; // the freed runs went back to the OS
	if (!Filled(a, 20 * kMiB, 1)) return 5;

	uint8* again = MakeFilled(200 * kMiB, 4); // reuses (and recommits) the returned pages
	if (again == null || !Filled(again, 200 * kMiB, 4)) return 6;

	uint64 before = GC::GetStats().liveBytes;
	DropMany();
	GC::Collect();
	if (GC::GetStats().liveBytes > before + 4 * 8 * kMiB) return 7; // at most a few kept by stale stack words

	if (CheckAlignment() != 0) return 8;
	printf("LARGE OK\n");
	return 0;
}
