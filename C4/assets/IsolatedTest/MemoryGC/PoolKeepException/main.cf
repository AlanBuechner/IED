// An exception escaping a pool's keep callback stops the program: keep runs while the collection marks, with every other
// thread stopped, and must not unwind through the collector into the caller of the collection.
include "bedrock.ch"

void TakeUnreached(GC::Pool& pool) {
	for (int32 i = 0; i < 50; i++) { int32* slot = (int32*)pool.Take(); *slot = i; }
}

int64 Scrub(int32 depth) {
	int64[128] junk;
	for (int32 i = 0; i < 128; i++) junk[i] = depth;
	GC::IsReachable((void*)&junk);
	if (depth == 0) return junk[1];
	return Scrub(depth - 1) + junk[2];
}

int32 main() {
	GC::PoolOptions options;
	options.keep = [](void* object) -> bool { throw 7; };
	GC::Pool pool = GC::Pool(16, 64, options);
	TakeUnreached(pool);
	Scrub(8);
	try {
		GC::Collect();
	} catch (...) {
		printf("SHOULD NOT REACH HERE: the exception reached the caller of the collection\n");
		return 2;
	}
	printf("SHOULD NOT REACH HERE: keep was not asked\n");
	return 3;
}
