// R16 (B70/B71): Bedrock's scanned buffers are read by their elements' pointer maps (gc_type_of), and so is a region of a
// reflected type's values (Reflection::Type::GcType). An address kept in an integer field of an element keeps nothing
// alive; the elements' pointer fields keep their targets - in an Array, a HashMap, a List, and a raw buffer registered by
// its reflected type.
include "bedrock.ch"

int32 g_finalized = 0;

struct Target {
	public int32 value;
	[operator("delete")] void Finalize() { g_finalized++; }
}

struct Holder { public uint64 address; public Target* target; public float scale; }

const int32 kEach = 60;

Core::Array<Holder> g_array;
Core::HashMap<int32, Holder> g_map;
Core::List<Holder> g_list;
Holder* g_raw = null;
int64 g_keptSum = 0;
int32 g_kept = 0;

Holder Make() {
	Holder h;
	h.address = (uint64)new Target;
	h.target = new Target;
	h.target->value = g_kept;
	g_keptSum += g_kept;
	g_kept++;
	return h;
}

bool Fill() {
	for (int32 i = 0; i < kEach; i++) {
		g_array.Push(Make());
		g_map.Insert(i, Make());
		g_list.PushBack(Make());
	}
	const Reflection::Type holder = Reflection::FindType("Holder");
	if (!holder.IsValid() || holder.GcType() == null || gc_type_of(Holder) == null) return false;
	const uint64 bytes = (uint64)(kEach * (int64)sizeof(Holder));
	g_raw = (Holder*)raw_alloc(bytes);
	memset((void*)g_raw, 0, bytes);
	gc_register_typed_region((void*)g_raw, bytes, holder.GcType());
	for (int32 i = 0; i < kEach; i++) g_raw[i] = Make();
	return true;
}

int64 Scrub(int32 depth) {
	int64[128] junk;
	for (int32 i = 0; i < 128; i++) junk[i] = depth;
	GC::IsReachable((void*)&junk);
	if (depth == 0) return junk[1];
	return Scrub(depth - 1) + junk[2];
}

int64 KeptSum() {
	int64 sum = 0;
	for (int64 i = 0; i < g_array.Count(); i++) sum += g_array[i].target->value;
	for (int32 i = 0; i < kEach; i++) sum += g_map.Find(i)->target->value;
	for (Core::ListNode<Holder>* node = g_list.First(); node != null; node = node->next) sum += node->value.target->value;
	for (int32 i = 0; i < kEach; i++) sum += g_raw[i].target->value;
	return sum;
}

int32 main() {
	if (gc_type_of(int32*) == null) return 1;   // every type has a record; one read whole has no map
	if (!Fill()) return 2;
	Scrub(8);
	GC::Collect();
	GC::Collect();
	const int32 dropped = 4 * kEach;
	printf("finalized %d of %d targets only an integer named\n", g_finalized, dropped);
	if (g_finalized < dropped - 5) return 3;   // the integer-held targets went
	if (g_finalized > dropped) return 4;       // the pointer-held ones stayed
	if (KeptSum() != g_keptSum) return 5;
	gc_unregister_region((void*)g_raw);
	raw_free((void*)g_raw);
	printf("PRECISE BUFFERS OK\n");
	return 0;
}
