// R16: a global root is read by its type's pointer map (__c4_gc_roots): an address kept in an integer of a global, a
// static local or a thread_local keeps nothing alive; their pointer fields keep their targets.
include "Memory/gc.ch"

int32 g_finalized = 0;

struct Target {
	public int32 value;
	[operator("delete")] void Finalize() { g_finalized++; }
}

const int32 kAddresses = 40;

struct Registry {
	public uint64[40] addresses;
	public Target* kept;
	public int32 count;
}

Registry g_registry;
thread_local Registry t_registry;

Registry* Statics() {
	static Registry s_registry;
	return &s_registry;
}

void Fill(Registry* registry, int32 value) {
	for (int32 i = 0; i < kAddresses; i++) registry->addresses[i] = (uint64)new Target;
	registry->kept = new Target;
	registry->kept->value = value;
	registry->count = kAddresses;
}

int64 Scrub(int32 depth) {
	int64[128] junk;
	for (int32 i = 0; i < 128; i++) junk[i] = depth;
	GC::IsReachable((void*)&junk);
	if (depth == 0) return junk[1];
	return Scrub(depth - 1) + junk[2];
}

int32 main() {
	Fill(&g_registry, 1);
	Fill(&t_registry, 2);
	Fill(Statics(), 3);
	Scrub(8);
	GC::Collect();
	GC::Collect();
	const int32 dropped = 3 * kAddresses;
	printf("finalized %d of %d targets only an integer named\n", g_finalized, dropped);
	if (g_finalized < dropped - 5) return 1;   // the integer-held targets went
	if (g_finalized > dropped) return 2;       // the pointer-held ones stayed
	if (g_registry.kept->value != 1 || t_registry.kept->value != 2 || Statics()->kept->value != 3) return 3;
	printf("PRECISE ROOTS OK\n");
	return 0;
}
