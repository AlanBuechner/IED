extern "c++" include "il.h"
extern "c++" source "il.cpp"

int32 g_fail = 0;
void Check(int32 cond, const char* what) {
	if (!cond) { printf("FAIL %s\n", what); g_fail++; }
}

int32 main() {
	// by-value int32 list
	Check(SumInts({1, 2, 3}) == 6, "SumInts({1,2,3})==6");
	Check(SumInts({}) == 0, "empty SumInts==0");
	Check(SumInts({-4, 4, 9}) == 9, "negative elements");

	// by-value float list
	float f = SumFloats({1.5f, 2.5f});
	Check((int32)(f * 2.0f) == 8, "SumFloats==4.0");

	// by-value double list (product)
	double d = ProdDoubles({2.0, 3.0, 4.0});
	Check((int32)d == 24, "ProdDoubles==24");

	// const-ref char list
	Check(CountChars({'a','b','c'}) == 3, "CountChars==3");
	Check(CountChars({}) == 0, "empty CountChars==0");

	// const-ref int32 list (min)
	Check(MinIntsRef({5, -2, 9}) == -2, "MinIntsRef==-2");
	Check(MinIntsRef({}) == 0, "empty MinIntsRef==0");

	printf("INITLIST INTEROP: %d failure(s)\n", g_fail);
	return g_fail;
}
