// Win32Window - minimal REAL Win32 API usage in pure C4.
// De-risks the interop pipeline for the DX12 stress game and locks in a critical
// edge case: a C4 free function passed as a foreign funcptr field (WNDPROC) that
// Windows then CALLS BACK into. Also covers struct init, #define-style constants,
// and import-library linking (user32/kernel32).
//
// The test is self-terminating: after creating the window it posts WM_CLOSE to
// itself, so the message pump dispatches WM_CLOSE -> WinProc -> DestroyWindow ->
// WM_DESTROY -> PostQuitMessage, then GetMessageA returns 0 and we exit. This proves
// Windows actually invoked the C4 callback (g_wmcreate/g_wmclose are set only by it).
extern "c" include "windows.h" {
	include_dir("C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um");
	include_dir("C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared");
	lib("user32.lib");
	lib("kernel32.lib");
}

// The headers' #define constants (WM_CLOSE, CS_HREDRAW, SW_SHOW) come with the binding (BUG-284).

// WNDPROC-compatible callback. A C4 free function address is stored in the foreign
// funcptr field (wc.lpfnWndProc); Windows calls it with (HWND, UINT, WPARAM, LPARAM)
// -> LRESULT. On x64: hwnd=ptr, msg=u32, wParam=u64, lParam=i64, returns i64.
int64 g_wmcreate = 0;
int64 g_wmclose  = 0;

int64 WinProc(HWND__* hWnd, int32 msg, uint64 wParam, int64 lParam) {
	if (msg == WM_CREATE) { g_wmcreate++; }
	if (msg == WM_CLOSE)  { g_wmclose++; DestroyWindow(hWnd); return 0; }
	if (msg == WM_DESTROY) { PostQuitMessage(0); return 0; }
	return DefWindowProcA(hWnd, msg, wParam, lParam);
}

int32 main() {
	tagWNDCLASSEXA wc;
	wc.cbSize = 80; // sizeof(WNDCLASSEX) on x64 (48 is the x86 size - Windows rejects it with err 87)
	wc.style = CS_HREDRAW;
	wc.lpfnWndProc = WinProc;
	wc.cbClsExtra = 0;
	wc.cbWndExtra = 0;
	wc.hInstance = null;
	wc.hIcon = null;
	wc.hCursor = null;
	wc.hbrBackground = (HBRUSH__*)14; // COLOR_WINDOW+1
	wc.lpszMenuName = null;
	wc.lpszClassName = "C4Win32Probe";
	wc.hIconSm = null;

	int32 atom = RegisterClassExA(&wc);
	if (atom == 0) { printf("RegisterClassExA FAILED err=%d\n", GetLastError()); return 1; }
	printf("class registered, atom=%d\n", atom);

	HWND__* hwnd = CreateWindowExA(0, "C4Win32Probe", "C4 Win32 Probe", 0x00CF0000, 100, 100, 480, 320, null, null, null, null);
	if (hwnd == null) { printf("CreateWindowExA FAILED err=%d\n", GetLastError()); return 1; }
	printf("window created\n");

	// Creation sends WM_NCCREATE/WM_CREATE to our WNDPROC - proves the C4 callback is live.
	if (g_wmcreate == 0) { printf("WIN32 FAIL: WinProc not called during creation\n"); return 1; }

	ShowWindow(hwnd, SW_SHOW);
	UpdateWindow(hwnd);

	// Post WM_CLOSE to ourselves so the pump exercises the C4 callback and terminates.
	PostMessageA(hwnd, WM_CLOSE, 0, 0);

	tagMSG msg;
	int32 guard = 0;
	while (GetMessageA(&msg, null, 0, 0) != 0 && guard < 500) {
		guard++;
		DispatchMessageA(&msg); // deliver to OUR WinProc (not the default proc)
	}

	printf("message loop ended after %d iterations\n", guard);
	if (g_wmclose == 0) { printf("WIN32 FAIL: WinProc never handled WM_CLOSE\n"); return 1; }

	printf("WIN32 WINDOW OK\n");
	return 0;
}
