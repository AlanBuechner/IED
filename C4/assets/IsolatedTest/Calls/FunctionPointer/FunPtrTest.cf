int32 Add(int32 a, int32 b) { return a + b; }
int32 Mul(int32 a, int32 b) { return a * b; }

// Apply a binary operator through a function pointer.
int32 Apply(funcptr<int32(int32, int32)> op, int32 a, int32 b) {
	return op(a, b);
}

// Global funptr initialized with a function address.
funcptr<int32(int32, int32)> g_op = Add;

int32 main() {
	// 1. Store address of a free function in a local funcptr var and call it.
	funcptr<int32(int32, int32)> f = Add;
	if (f(2, 3) != 5) { printf("FAIL local add=%d\n", f(2, 3)); return 1; }

	// 2. Reassign to a different function and call again.
	f = Mul;
	if (f(4, 5) != 20) { printf("FAIL local mul=%d\n", f(4, 5)); return 1; }

	// 3. Pass the function pointer as a parameter and call from the callee.
	if (Apply(Add, 6, 7) != 13) { printf("FAIL apply add\n"); return 1; }
	if (Apply(Mul, 6, 7) != 42) { printf("FAIL apply mul\n"); return 1; }

	// 4. Global funptr initialized with a function address.
	if (g_op(10, 20) != 30) { printf("FAIL global add=%d\n", g_op(10, 20)); return 1; }
	g_op = Mul;
	if (g_op(3, 4) != 12) { printf("FAIL global mul=%d\n", g_op(3, 4)); return 1; }

	// 5. Bare function name used directly as a value in an argument position.
	if (Apply(Mul, 8, 9) != 72) { printf("FAIL direct arg\n"); return 1; }

	printf("FUNPTR OK\n");
	return 0;
}
