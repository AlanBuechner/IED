// Custom operator call probe - `a.operator_<name>()` resolves to the method
// annotated [operator("<name>")], for both regular member methods and extension methods.

struct A {
	int32 value;

	[operator("create")] public void Init(int32 v) {
		this.value = v;
	}

	[operator("hash")] public int32 Hash() {
		return this.value * 7;
	}

	[operator("scale")] public int32 Scale(int32 f) {
		return this.value * f;
	}
}

// Extension-method operator on A (this = the extended object).
[operator("double")] int32 DoubleValue() extends A {
	return this.value * 2;
}

int32 main() {
	A a;
	a.Init(10);

	// Regular member method operator, called by operator name.
	int32 h = a.operator_hash();
	if (h != 70) { printf("FAIL hash got %d\n", h); return 1; }

	// Custom operator with a parameter.
	int32 s = a.operator_scale(4);
	if (s != 40) { printf("FAIL scale got %d\n", s); return 1; }

	// Extension-method operator called by name.
	int32 d = a.operator_double();
	if (d != 20) { printf("FAIL double got %d\n", d); return 1; }

	printf("CUSTOM OPERATOR OK\n");
	return 0;
}
