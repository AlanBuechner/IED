struct N {
	int32 v;
	[operator("create")] public void Init(int32 x) { this->v = x; }
	[operator("+")] public int32 Add(const N& o) { return this->v + o.v; }
}
int32 main() {
	N a; a.Init(1); N b; b.Init(2);
	int32 s = a + b;
	if (s != 3) { printf("FAIL got %d\n", s); return 1; }
	printf("DIFFERENT RETURN TYPE OK\n");
	return 0;
}
