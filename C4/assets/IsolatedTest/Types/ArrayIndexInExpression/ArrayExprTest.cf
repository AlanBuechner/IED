// Bug B repro - array indexing inside larger expressions.

int32 Twice(int32 v) { return v * 2; }

struct Pt { int32 x; };

int32 main() {
	int32[4] a;
	a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;

	// arr[i] + 1 inside an expression.
	int32 v = a[1] + 1;
	if (v != 3) { printf("FAIL arr[i]+1 got %d\n", v); return 1; }

	// f(arr[i]).
	int32 w = Twice(a[2]);
	if (w != 6) { printf("FAIL f(arr[i]) got %d\n", w); return 1; }

	// arr[i] = arr[j] + k.
	a[0] = a[3] + 10;
	if (a[0] != 14) { printf("FAIL store expr got %d\n", a[0]); return 1; }

	// variable index from another array.
	int32[2] idx;
	idx[0] = 1; idx[1] = 3;
	int32 s = a[idx[0]] + a[idx[1]];
	if (s != 2 + 4) { printf("FAIL double-index got %d\n", s); return 1; }

	// array of struct: element field read/write.
	Pt[3] pts;
	pts[0].x = 10; pts[1].x = 20; pts[2].x = 30;
	int32 sum = 0;
	for (int32 i = 0; i < 3; i++) sum += pts[i].x;
	if (sum != 60) { printf("FAIL array-of-struct sum got %d\n", sum); return 1; }
	pts[1].x = 99;
	if (pts[1].x != 99) { printf("FAIL array-of-struct write got %d\n", pts[1].x); return 1; }

	printf("ARRAY EXPR OK\n");
	return 0;
}
