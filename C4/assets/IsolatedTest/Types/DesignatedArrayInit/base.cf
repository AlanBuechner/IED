int32 main() {
	int32[10] i = { [0] = 0, [6] = 1 };
	if (i[0] != 0) return 1;
	if (i[6] != 1) return 2;
	if (i[1] != 0) return 3;
	if (i[9] != 0) return 4;
	int32[8] a = { 1, 2, [5] = 9, 7 };
	if (a[0] != 1) return 10;
	if (a[1] != 2) return 11;
	if (a[2] != 0) return 12;
	if (a[5] != 9) return 13;
	if (a[6] != 7) return 14;
	int32[8] r = { [2...5] = 42 };
	if (r[0] != 0) return 20;
	if (r[1] != 0) return 21;
	if (r[2] != 42) return 22;
	if (r[3] != 42) return 23;
	if (r[4] != 42) return 24;
	if (r[5] != 42) return 25;
	if (r[6] != 0) return 26;
	printf("INITMAP OK\n");
	return 0;
}
