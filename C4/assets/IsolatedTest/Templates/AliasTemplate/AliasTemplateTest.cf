// Alias template tests - monomorphization of `template<T> alias X = <type expr>;`
//
// Covers: 1D array instantiation over multiple types, pointer instantiation, and
// reuse of the same template with different arguments (distinct instantiations).
// Note: nested arrays (T[4][4]) are blocked by the known array-indexing limitation
// (see docs/status/implementation-status.md), independent of templates.

// Fixed-size array of T
template<T> alias Vec = T[8];

// Pointer to T
template<T> alias Ptr = T*;

int32 main() {
	// 1. Array-of-int32 instantiation
	Vec<int32> a;
	a[0] = 10;
	a[7] = 90;
	if (a[0] + a[7] != 100) { printf("FAIL vec int=%d\n", a[0] + a[7]); return 1; }

	// 2. Array-of-uint64 instantiation (same template, different type)
	Vec<uint64> b;
	b[0] = 5;
	b[1] = 7;
	if (b[0] + b[1] != 12) { printf("FAIL vec uint64\n"); return 1; }

	// 3. Array-of-bool instantiation
	Vec<bool> c;
	c[0] = true;
	c[1] = false;
	if (c[0] == false || c[1] == true) { printf("FAIL vec bool\n"); return 1; }

	// 4. Pointer instantiation
	int32 x = 42;
	Ptr<int32> p = &x;
	*p = 7;
	if (x != 7) { printf("FAIL ptr x=%d\n", x); return 1; }

	printf("ALIAS TEMPLATE OK\n");
	return 0;
}
