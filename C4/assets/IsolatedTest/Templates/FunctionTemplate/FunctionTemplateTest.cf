// Function template tests - monomorphization of `template<T> T F(T v) {...}`
//
// Covers: identity over multiple types, a two-parameter template, and reuse of the
// same template with different arguments (distinct instantiations coexisting).

template<T> T Identity(T v) { return v; }

template<A, B> A Add(A a, B b) { return a + b; }

int32 main() {
	// 1. Identity<int32>
	int32 x = Identity<int32>(42);
	if (x != 42) { printf("FAIL identity int=%d\n", x); return 1; }

	// 2. Identity<uint64> - same template, different instantiation
	uint64 y = Identity<uint64>(99);
	if (y != 99) { printf("FAIL identity uint64\n"); return 1; }

	// 3. Identity<bool>
	bool b = Identity<bool>(true);
	if (!b) { printf("FAIL identity bool\n"); return 1; }

	// 4. Two-parameter template Add<int32,int32>
	int32 sum = Add<int32, int32>(20, 22);
	if (sum != 42) { printf("FAIL add int=%d\n", sum); return 1; }

	// 5. Two-parameter template Add<uint64,uint64>
	uint64 big = Add<uint64, uint64>(1000000, 500000);
	if (big != 1500000) { printf("FAIL add uint64\n"); return 1; }

	// 6. Distinct instantiations coexist and both work
	int32 a = Identity<int32>(7);
	uint64 c = Identity<uint64>(8);
	if (a != 7 || c != 8) { printf("FAIL compose\n"); return 1; }

	printf("FUNCTION TEMPLATE OK\n");
	return 0;
}
