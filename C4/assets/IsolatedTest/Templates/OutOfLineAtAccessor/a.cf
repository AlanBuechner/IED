template<T> class Box {
    T* data;
    int32 count;
    [operator("create")] public void Init(int32 cap) { this->data = (T*)raw_alloc(cap * sizeof(T)); this->count = 0; }
    public void Push(T v);
    public int32 Count() { return this->count; }
    public T At(int32 i);
}
template<T> public void Box::Push(T v) { this->data[this->count] = v; this->count = this->count + 1; }
template<T> public T Box::At(int32 i) { return this->data[i]; }
int32 main() {
    Box<int32>* b = new Box<int32>{4};
    b->Push(7);
    printf("P2 ool-push count=%d val=%d\n", b->Count(), b->At(0));
    return 0;
}