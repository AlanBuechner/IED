// Probe: nested template param - Vec<T>'s field is Box<T>. When instantiating Vec<int32>, the
// nested Box<T> must become Box<int32> (not a dangling bare T). This is the 4a-ii cutover's
// weakest spot: the nested instantiation's "source expression" arg is Vec's bare `T` node.
template<T> struct Box { public T v; };
template<T> struct Vec { public T x; public Box<T> b; };

int32 main() {
	Vec<int32> v;
	v.x = 5;
	v.b.v = 7; // access the nested Box<T>'s member - requires Box<int32>, not a dangling T
	if (v.x != 5 || v.b.v != 7) return 1;
	return 0;
}
