// Probe: a template body that EXPLICITLY calls another template using the bound param as an argument.
// After the 4a cutover HIR lowers the SUBSTITUTED body (G<int32>(x)), a node NOT in
// functionCallMangledNames, so HIR must re-derive the mangled key from the concrete arg text and it
// must agree with semantic's recorded key. Also covers a specialization arg: G<Box<T>> -> G<Box<int32>>.
template<T> struct Box { public T v; };
template<T> int32 G(T x) { return 42; }                 // body irrelevant - we test symbol resolution
template<T> int32 F(T x) { return G<T>(x); }            // explicit call, bound param as arg
template<T> int32 H(Box<T> b) { return G<Box<T>>(b); }  // specialization arg (Box<T> -> Box<int32>)

int32 main() {
	int32 r = F<int32>(5);   // F<int32> -> body calls G<int32>(x): re-derived key must match recorded
	if (r != 42) return 1;
	Box<int32> b;
	b.v = 9;
	int32 h = H<int32>(b);   // H<int32> -> body calls G<Box<int32>>(b): specialization arg re-derived
	if (h != 42) return 1;
	return 0;
}
