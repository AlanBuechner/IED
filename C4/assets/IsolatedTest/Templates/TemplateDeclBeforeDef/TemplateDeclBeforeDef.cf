// Function templates declared before their definitions (catalog rows A2 + A8). A declaration and its
// definition are one overload-set member (the definition's body stands for both), whether the call writes
// its arguments or deduces them, for same-arity overloads, extension templates and chains of templates whose
// bodies call templates defined even later. Mutual recursion across template bodies must terminate.
template<T> int32 Add(T a, T b);                       // A2: declaration before definition
template<T> struct Box { public T v; };
template<T> int32 Unbox(Box<T> b);                      // A2 with an object-template parameter

// A8-style chain: C's body calls B<int32>, whose body calls A<int32>; all three are declared
// before use and defined after main (in reverse dependency order).
template<T> int32 A(T t);
template<T> int32 B(T t);
template<T> int32 C(T t);

// Mutual recursion ACROSS template bodies: Foo calls Bar, Bar calls Foo. Without an in-progress
// guard the deferred re-instantiation would re-walk a body that is still being instantiated and
// recurse to stack overflow (the compiler crashed here before the m_InProgressInstances guard).
template<T> T Foo(T t);
template<T> T Bar(T t);

// Same-arity overloads, both declared first: each declaration pairs with its own definition.
template<T> int32 Shape(Box<T> b);
template<T> int32 Shape(T* p);

template<T> struct Pair { public T first; public T second; }
template<T> T Total() extends Pair<T>;

namespace Calc { template<T> T Twice(T v); }

int32 main() {
	if (Add<int32>(2, 3) != 5) return 1;
	if (Add<int64>(20, 22) != 42) return 1;

	Box<int32> x; x.v = 7;
	if (Unbox<int32>(x) != 7) return 1;

	if (C<int32>(1) != 1) return 1;

	if (Foo<int32>(3) != 3) return 1;   // Foo(3)=Bar(2)+1=Foo(0)+2+1 ... resolves to 3
	if (Bar<int64>(11) != 11) return 1;

	if (Add(4, 5) != 9) return 2;                 // deduced
	if (Unbox(x) != 7) return 2;
	int32 n = 3;
	if (Shape(x) != 1) return 3;
	if (Shape(&n) != 2) return 3;
	Pair<int32> p; p.first = 30; p.second = 12;
	if (p.Total() != 42) return 4;
	if (Calc::Twice(21) != 42) return 5;
	return 0;
}

template<T> int32 Add(T a, T b) { return a + b; }
template<T> int32 Unbox(Box<T> b) { return b.v; }
template<T> int32 A(T t) { return t + 0; }
template<T> int32 B(T t) { return A<int32>(t) + 0; }   // body calls a template defined later
template<T> int32 C(T t) { return B<int32>(t); }
template<T> T Foo(T t) { if (t <= 1) return t; return Bar<T>(t - 1) + 1; }
template<T> T Bar(T t) { if (t <= 0) return t; return Foo<T>(t - 2) + 2; }
template<T> int32 Shape(Box<T> b) { return 1; }
template<T> int32 Shape(T* p) { return 2; }
template<T> T Total() extends Pair<T> { return first + second; }
namespace Calc { template<T> T Twice(T v) { return v + v; } }
