template<T> T Apply(funcptr<T(T,T)> op, T a, T b) { return op(a, b); }
int32 AddI(int32 a, int32 b) { return a + b; }
float MulF(float a, float b) { return a * b; }
int32 main() {
	if (Apply<int32>(AddI, 20, 22) != 42) return 1;
	if (Apply<float>(MulF, 2.5f, 4.0f) != 10.0f) return 2;
	printf("TPL FUNPTR OK\n");
	return 0;
}
