int32 main() {
    uint32 big = 4294967295;
    float fb = (float)big;               // ~4.29e9, NOT -1
    int32 neg = -8;
    uint32 ush = 0x40000000;
    uint32 a = 4294967295;
    char ch = -5;
    int32 widened = (int32)ch;           // stays -5
    int32 bad = 0;
    if (!(fb > 4000000000.0f)) bad++;
    if ((neg >> 1) != -4) bad++;         // arithmetic shift
    if ((ush >> 1) != 536870912) bad++;  // logical shift
    if ((a / 2) != 2147483647) bad++;    // unsigned div
    if ((a % 4) != 3) bad++;             // unsigned rem
    if (((-7) / 2) != -3) bad++;         // signed div trunc toward zero
    if (widened != -5) bad++;
    return bad;
}
