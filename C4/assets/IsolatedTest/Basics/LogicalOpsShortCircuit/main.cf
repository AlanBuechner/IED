int32 side = 0;
int32 Boom() { side++; return 1; }
int32 main() {
    int32 bad = 0;
    side = 0; bool r1 = (false && Boom());
    if (r1 || side != 0) bad++;
    side = 0; bool r2 = (true && Boom());
    if (!r2 || side != 1) bad++;
    side = 0; bool r3 = (false || Boom());
    if (!r3 || side != 1) bad++;
    side = 0; bool r4 = (true || Boom());
    if (!r4 || side != 0) bad++;
    bool a = true, b = true, c = false, d = true;
    int32 t = ((a && b && c && d) ? 0 : 1);     // deep logical as ternary condition
    if (t != 1) bad++;
    return bad;
}
