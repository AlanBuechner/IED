int64 wrap(int64 v) { return v; }
int32 main() {
    bool c = true;
    uint32 a = 0x80000000;
    uint32 b = 1;
    int64 x = c ? a : b;         // +2147483648 (was -2147483648)
    int64 y = wrap(c ? a : b);   // same through a call argument
    return (x == 2147483648 && y == 2147483648) ? 0 : 1;
}
