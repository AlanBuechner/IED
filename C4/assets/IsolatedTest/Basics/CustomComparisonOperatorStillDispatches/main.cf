struct V { int32 x; int32 y;
[operator("equal")] public int32 Eq(const V& o) extends V { return (this->x == o.x && this->y == o.y) ? 1 : 0; }
[operator("notequal")] public int32 Ne(const V& o) extends V { return (this->x != o.x || this->y != o.y) ? 1 : 0; }
}
int main() {
	V a; a.x = 7; a.y = 9;
	V b; b.x = 7; b.y = 9;
	V c; c.x = 1; c.y = 2;
	if ((a == b) != 1) { printf("FAIL eq\n"); return 1; }
	if ((a != b) != 0) { printf("FAIL ne same\n"); return 1; }
	if ((a != c) != 1) { printf("FAIL ne diff\n"); return 1; }
	return 0;
}
