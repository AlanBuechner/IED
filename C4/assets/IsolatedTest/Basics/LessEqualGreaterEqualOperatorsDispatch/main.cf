struct V { int32 x;
[operator("less_equal")] public int32 Le(const V& o) extends V { return this->x <= o.x ? 1 : 0; }
[operator("greater_equal")] public int32 Ge(const V& o) extends V { return this->x >= o.x ? 1 : 0; }
}
int main() {
	V a; a.x = 3;
	V b; b.x = 5;
	if ((a <= b) != 1) { printf("FAIL le\n"); return 1; }
	if ((b <= a) != 0) { printf("FAIL le2\n"); return 1; }
	if ((b >= a) != 1) { printf("FAIL ge\n"); return 1; }
	if ((a >= b) != 0) { printf("FAIL ge2\n"); return 1; }
	return 0;
}
