struct A { int32 x;
[operator("logical_and")] public int32 LA(const A& o) extends A { return (this->x != 0 && o.x != 0) ? 1 : 0; }
[operator("logical_or")] public int32 LO(const A& o) extends A { return (this->x != 0 || o.x != 0) ? 1 : 0; }
}
int main() {
	A a; a.x = 1;
	A b; b.x = 0;
	if ((a && b) != 0) { printf("FAIL and\n"); return 1; }
	if ((a || b) != 1) { printf("FAIL or\n"); return 1; }
	return 0;
}
