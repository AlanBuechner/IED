// A --script-host program loads C4Script.dll on its first call into it (the link delay-loads it): without the DLL
// beside it, the program still starts and Host::Open says what is missing.
include "scripttest.ch"

int32 main(int32 argc, char** argv)
{
	ScriptTest::Checks checks = ScriptTest::Begin(argc, argv);
	FS::Path library = Platform::ExecutablePath().Parent() / "C4Script.dll";
	checks.That(FS::RemoveFile(library.CStr()), "the host removes the DLL beside it");
	Scripting::Host* host = Scripting::Host::Open();
	checks.That(!host->IsOpen(), "the host does not open without C4Script.dll");
	checks.Contains(host->Error(), "C4Script.dll does not load", "its error names the DLL");
	return checks.End("MissingLibrary");
}
