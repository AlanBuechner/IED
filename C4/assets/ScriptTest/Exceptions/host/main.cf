// Exceptions cross the boundary both ways, by type: the host catches what the script throws (host types, the
// script's types by their host base, plain values), the script catches what the host throws, cleanups run as an
// exception unwinds script frames, and an exception leaving Script::Call reaches the caller (it is no fault).
include "scripttest.ch"
include "errors.ch"

namespace Errors
{
	void Fail(int32 code) { throw GameError(code); }
	void ThrowInt(int32 value) { throw value; }

	int32 CallAndCatch(funcptr<void()> fn)
	{
		try { fn(); }
		catch (GameError& e) { return e.code * 100 + e.Severity(); }
		catch (int32 v) { return -v; }
		return 0;
	}
}

int32 CallScript(Scripting::Script* script, const char* name)
{
	funcptr<int32()> fn = (funcptr<int32()>)script->Address(name);
	return fn == nullptr ? -1000 : fn();
}

int32 CatchFrom(Scripting::Script* script, const char* name)
{
	funcptr<void()> fn = (funcptr<void()>)script->Address(name);
	return fn == nullptr ? -1000 : Errors::CallAndCatch(fn);
}

void RunThrowsInt(void* fn) { ((funcptr<void()>)fn)(); }

class Run
{
	public funcptr<int32()> fn;
	public int32 result = 0;
}

void RunForResult(void* run) { ((Run*)run)->result = ((Run*)run)->fn(); }

void RunCatchingRefusal(void* run)
{
	try { ((Run*)run)->fn(); }
	catch (Errors::Refusal& r) { ((Run*)run)->result = r.code; }
}

// BUG-315: a thrown type with a destructor, thrown by the script and caught by it, by the host inside a guarded call,
// and outside one; each exception object is destroyed once, and none of it is a fault.
void CheckRefusals(Scripting::Script* script, ScriptTest::Checks& checks)
{
	Errors::g_refusalsDropped = 0;
	checks.Equal(14, CallScript(script, "CatchesRefusal"), "the script catches its own throw of a host type with a destructor");
	Run own;
	own.fn = (funcptr<int32()>)script->Address("CatchesRefusal");
	checks.That(script->Call(RunForResult, (void*)&own), "the script catches it inside a guarded call");
	checks.Equal(14, own.result, "and returns what it caught");
	Run host;
	host.fn = (funcptr<int32()>)script->Address("ThrowsRefusal");
	checks.That(script->Call(RunCatchingRefusal, (void*)&host), "the host catches it inside a guarded call");
	checks.Equal(7, host.result, "the host's handler sees the object");
	int32 caught = 0;
	try { script->Call(RunThrowsInt, script->Address("ThrowsRefusal")); }
	catch (Errors::Refusal& r) { caught = r.code; }
	checks.Equal(7, caught, "it leaves a guarded call to the host's handler");
	checks.Equal(4, Errors::g_refusalsDropped, "each exception object is destroyed once");
	checks.That(!script->Faulted(), "none of it is a fault");
}

void CheckExceptions(Scripting::Script* script, ScriptTest::Checks& checks)
{
	checks.Equal(701, CatchFrom(script, "ThrowsHostType"), "the host catches a host type the script throws");
	checks.Equal(1109, CatchFrom(script, "ThrowsOwnType"), "the host catches the script's type by its host base");
	checks.Equal(-13, CatchFrom(script, "ThrowsInt"), "the host catches an int32 the script throws");
	checks.Equal(21, CallScript(script, "CatchesHost"), "the script catches a host type the host throws");
	checks.Equal(10, CallScript(script, "CatchesHostInt"), "the script catches an int32 the host throws");
	checks.Equal(9, CallScript(script, "CatchesOwn"), "the script catches its own type");
	checks.Equal(4, CallScript(script, "Rethrows"), "the script rethrows a host type");
	checks.Equal(1, CallScript(script, "CatchesAll"), "catch (...) in the script");
	Errors::g_unwound = 0;
	checks.Equal(-17, CatchFrom(script, "UnwindsThroughCleanups"), "an exception leaves through script cleanups");
	checks.Equal(2, Errors::g_unwound, "both cleanups ran");

	int32 caught = 0;
	try { script->Call(RunThrowsInt, script->Address("ThrowsInt")); }
	catch (int32 v) { caught = v; }
	checks.Equal(13, caught, "an exception leaving Script::Call reaches its caller");
	checks.That(!script->Faulted(), "an exception is no fault");
}

int32 main(int32 argc, char** argv)
{
	ScriptTest::Checks checks = ScriptTest::Begin(argc, argv);
	Scripting::Host* host = ScriptTest::OpenHost(checks);
	if (!host->IsOpen()) return checks.End("Exceptions");
	Scripting::Script* script = ScriptTest::Load(host, checks, ScriptTest::OptionsFor(checks, "exceptions", "exceptions.cf"));
	if (script->Ok()) CheckExceptions(script, checks);
	if (script->Ok()) CheckRefusals(script, checks);
	script->Unload();
	return checks.End("Exceptions");
}
