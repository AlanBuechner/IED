// Operators - Integer Promotion Tests (implementation)
include "../Framework/Assert.ch"
include "IntegerPromotion.ch"

void TestIntegerPromotion() {
	// Usual arithmetic conversions: narrow integers promote to at least int32 before the
	// operation. Without promotion, 30000 + 30000 in int16 wraps to -5536.
	int16 a = 30000;
	int16 b = 30000;
	int32 sum = a + b;
	AssertIntEquals(60000, sum, "int16 + int16 promotes to at least int32 (no i16 overflow)");

	// Same guarantee for the smallest integer type.
	int8 x = 100;
	int8 y = 100;
	int32 s2 = x + y;
	AssertIntEquals(200, s2, "int8 + int8 promotes to at least int32 (no i8 overflow)");

	// Unsigned narrow types promote too.
	uint16 u = 60000;
	uint16 v = 60000;
	uint32 s4 = u + v;
	AssertIntEquals(120000, (int32)s4, "uint16 + uint16 promotes to at least int32");

	// Signedness-aware: both operands promote to signed int32, so the result is a plain sum.
	uint8 u2 = 200;
	int8 n2 = -50;
	int32 s6 = (int32)u2 + n2;
	AssertIntEquals(150, s6, "uint8 + int8 both promote to int32");

	// Mixed widths: the wider operand wins.
	int16 m = 10000;
	int32 nn = 30000;
	int32 s5 = m + nn;
	AssertIntEquals(40000, s5, "int16 + int32 yields int32");

	// Unary minus promotes a narrow signed operand to int32 (no in-width wrap).
	int16 neg = 30000;
	int32 r1 = -neg;
	AssertIntEquals(-30000, r1, "unary minus on int16 promotes to int32");

	// Unary minus on an UNSIGNED narrow operand zero-extends first, so the result is a true
	// negative (-(uint8)250 == -250), not the in-width wrap (+6).
	uint8 u3 = 250;
	int32 r2 = -u3;
	AssertIntEquals(-250, r2, "unary minus on uint8 zero-extends then negates");

	// Increment yields the promoted value (uint8 250 ++ -> 251), while the slot stores back its width.
	uint8 u4 = 250;
	int32 r3 = ++u4;
	AssertIntEquals(251, r3, "++ on uint8 yields promoted int32 value");

	// Ternary: mixed-width branches reconcile to the wider type (int16 : int32 -> int32), so the
	// result holds a plain int32 with no narrowing. c=true takes the then-branch.
	bool c = true;
	int32 r4 = c ? (int16)10000 : 30000;
	AssertIntEquals(10000, r4, "ternary int16:int32 reconciles to int32");
}
