include "../Framework/Assert.ch"
include "VaListForms.ch"

struct VaPair { public int32 a; public int32 b; }                       // 8 bytes: rides in its slot
struct VaTriple { public int64 x; public int64 y; public int64 z; }      // 24 bytes: arrives by pointer

int64 VaMixed(int32 count, ...) {
	va_list ap;
	va_start(ap);
	int32 small = va_arg(ap, int32);
	int64 big = va_arg(ap, int64);
	double d = va_arg(ap, double);
	int32* p = va_arg(ap, int32*);
	VaPair pair = va_arg(ap, VaPair);
	VaTriple triple = va_arg(ap, VaTriple);
	double promoted = va_arg(ap, double);
	va_end(ap);
	return small + big + (int64)d + *p + pair.a + pair.b + triple.x + triple.y + triple.z + (int64)promoted;
}

int32 VaSumTwice(int32 count, ...) {
	va_list ap;
	va_start(ap);
	va_list again;
	va_copy(again, ap);
	int32 first = 0;
	for (int32 i = 0; i < count; ++i) first += va_arg(ap, int32);
	int32 second = 0;
	for (int32 i = 0; i < count; ++i) second += va_arg(again, int32);
	va_end(again);
	va_end(ap);
	return first * 1000 + second;
}

int32 VaCount(int32 count, ...) { return count; }

void TestVaListForms() {
	int32 target = 4;
	VaPair pair; pair.a = 5; pair.b = 6;
	VaTriple triple; triple.x = 7; triple.y = 8; triple.z = 9;
	float narrow = 10.0f;
	int64 total = VaMixed(7, 1, (int64)2000000000000, 3.5, &target, pair, triple, narrow);
	Assert(total == 2000000000000 + 1 + 3 + 4 + 5 + 6 + 7 + 8 + 9 + 10, "every kind of variadic argument reads back");
	AssertIntEquals(6006, VaSumTwice(3, 1, 2, 3), "va_copy reads the same arguments again");
	AssertIntEquals(0, VaCount(0), "a variadic function called with no variadic arguments");
}
