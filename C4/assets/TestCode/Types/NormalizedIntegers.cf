// Types - normalized integers (D-38): a float converts by value (clamped, scaled, rounded to nearest), an
// integer is the stored encoding, and arithmetic runs in float (double for 32 and 64 bits).
include "../Framework/Assert.ch"
include "NormalizedIntegers.ch"

const snorm8 kNiHalf = 0.5f;
const unorm8 kNiFull = 1.0f;
const snorm16 kNiRaw = 100;
snorm8 gNiLow = -1.0f;

snorm8 NiSnorm8(float v) { return v; }
unorm8 NiUnorm8(float v) { return v; }
snorm16 NiSnorm16(float v) { return v; }
unorm16 NiUnorm16(float v) { return v; }
float NiValue8(snorm8 v) { return v; }
float NiValueU8(unorm8 v) { return v; }
bool NiNear(double a, double b) { double d = a - b; if (d < 0.0) d = -d; return d < 0.000001; }

void TestNormalizedFromFloat() {
	AssertIntEquals(64, (int32)NiSnorm8(0.5f), "snorm8 0.5 rounds 63.5 up to 64");
	AssertIntEquals(127, (int32)NiSnorm8(1.0f), "snorm8 1 is 127");
	AssertIntEquals(-127, (int32)NiSnorm8(-1.0f), "snorm8 -1 is -127");
	AssertIntEquals(127, (int32)NiSnorm8(2.0f), "snorm8 clamps above 1");
	AssertIntEquals(-127, (int32)NiSnorm8(-3.0f), "snorm8 clamps below -1");
	AssertIntEquals(0, (int32)NiSnorm8(0.0f / 0.0f), "NaN stores 0");
	AssertIntEquals(128, (int32)NiUnorm8(0.5f), "unorm8 0.5 rounds 127.5 up to 128");
	AssertIntEquals(64, (int32)NiUnorm8(0.25f), "unorm8 0.25 rounds 63.75 to 64");
	AssertIntEquals(0, (int32)NiUnorm8(-0.5f), "unorm8 clamps below 0");
	AssertIntEquals(255, (int32)NiUnorm8(1.5f), "unorm8 clamps above 1");
	AssertIntEquals(-16384, (int32)NiSnorm16(-0.5f), "snorm16 -0.5 rounds -16383.5 to -16384");
	AssertIntEquals(65535, (int32)NiUnorm16(1.0f), "unorm16 1 is 65535");
}

void TestNormalizedToFloat() {
	AssertFloatEquals(1.0f, NiValueU8(NiUnorm8(1.0f)), "unorm8 255 reads 1");
	AssertFloatEquals(1.0f, NiValue8(NiSnorm8(1.0f)), "snorm8 127 reads 1");
	AssertFloatEquals(-1.0f, NiValue8(NiSnorm8(-1.0f)), "snorm8 -127 reads -1");
	int8 lowest = -128;
	snorm8 edge = *(snorm8*)&lowest;
	AssertFloatEquals(-1.0f, NiValue8(edge), "snorm8 -128 reads -1, not below it");
	snorm8 stored = 100;
	AssertIntEquals(100, (int32)stored, "an integer is the encoding");
	AssertFloatEquals(100.0f / 127.0f, NiValue8(stored), "and reads as encoding over 127");
	unorm8 quarter = 0.25f;
	unorm16 wide = quarter;
	AssertIntEquals(16448, (int32)wide, "unorm8 64 is unorm16 16448 by value");
	snorm8 signed = quarter;
	AssertIntEquals(32, (int32)signed, "unorm8 0.25 is snorm8 32 by value");
	snorm8 big = 300;
	AssertIntEquals(127, (int32)big, "an integer clamps to the encoding range");
	unorm8 under = -3;
	AssertIntEquals(0, (int32)under, "a negative integer stores 0 in a unorm");
}

void TestNormalizedWideTypes() {
	snorm32 s32 = 0.5f;
	Assert((int64)s32 == 1073741824, "snorm32 0.5");
	double d32 = s32;
	Assert(NiNear(d32, 1073741824.0 / 2147483647.0), "snorm32 reads in double");
	unorm32 u32 = 1.0;
	Assert((uint32)u32 == 4294967295u, "unorm32 1 is the largest encoding");
	unorm64 u64 = 1.0;
	Assert((uint64)u64 == 18446744073709551615u, "unorm64 1 is the largest encoding");
	u64 = 0.0;
	Assert((uint64)u64 == 0u, "unorm64 0");
	snorm64 s64 = -1.0;
	Assert((int64)s64 == -9223372036854775807, "snorm64 -1");
	s64 = 1.0;
	double d64 = s64;
	Assert(d64 == 1.0, "snorm64 1 reads 1");
}

void TestNormalizedArithmetic() {
	unorm8 a = 0.5f;
	unorm8 b = 0.25f;
	float sum = a + b;
	Assert(NiNear(sum, 128.0 / 255.0 + 64.0 / 255.0), "the sum of two unorm8 is their values' sum");
	Assert(sizeof(a + b) == 4, "8- and 16-bit normalized arithmetic is float");
	snorm32 s = 0.5f;
	Assert(sizeof(s + s) == 8, "32-bit normalized arithmetic is double");
	Assert(sizeof(a * 2.0) == 8, "a double operand makes it double");
	unorm8 c = a + b;
	AssertIntEquals(192, (int32)c, "storing the sum encodes it");
	a += 0.75f;
	AssertIntEquals(255, (int32)a, "compound assignment clamps");
	Assert(b < a, "comparison is by value");
	snorm8 n = 0.5f;
	float negated = -n;
	Assert(NiNear(negated, -64.0 / 127.0), "negation is a float");
	float scaled = n * 2;
	Assert(NiNear(scaled, 128.0 / 127.0), "an integer operand is its value");
}

void TestNormalizedConstants() {
	AssertIntEquals(64, (int32)kNiHalf, "a normalized constant from a float");
	AssertIntEquals(255, (int32)kNiFull, "a normalized constant at 1");
	AssertIntEquals(100, (int32)kNiRaw, "a normalized constant from an integer is its encoding");
	AssertIntEquals(-127, (int32)gNiLow, "a normalized global");
}
