include "../Framework/Assert.ch"
include "FuncPtrTables.ch"

int32 TableAdd(int32 a, int32 b) { return a + b; }
int32 TableSub(int32 a, int32 b) { return a - b; }
int32 TableMul(int32 a, int32 b) { return a * b; }

funcptr<int32(int32, int32)>[3] g_ops;

funcptr<int32(int32, int32)> Pick(int32 i) { return g_ops[i]; }

int32 Apply(funcptr<int32(int32, int32)>* slot, int32 a, int32 b) { return (*slot)(a, b); }

void TestFuncPtrTables() {
	g_ops[0] = TableAdd;
	g_ops[1] = TableSub;
	g_ops[2] = TableMul;
	AssertIntEquals(7, g_ops[0](3, 4), "a call through a table element");
	AssertIntEquals(-1, g_ops[1](3, 4), "each element is its own function");
	AssertIntEquals(12, Pick(2)(3, 4), "a function returning a funcptr, called at once");
	AssertIntEquals(5, Apply(&g_ops[0], 2, 3), "a pointer to a table element");
	funcptr<int32(int32, int32)>[2] local = { TableMul, TableAdd };
	AssertIntEquals(20, local[0](4, 5), "a braced local table");
	func<int32(int32)>[2] steps;
	steps[0] = [](int32 x) -> int32 { return x + 1; };
	int32 base = 10;
	steps[1] = [base](int32 x) -> int32 { return x + base; };
	AssertIntEquals(6, steps[0](5), "a func table holds lambdas");
	AssertIntEquals(15, steps[1](5), "including capturing ones");
}
