// Types - Array Element Expression Tests (implementation)
include "../Framework/Assert.ch"
include "ArrayElementExpression.ch"

struct Pt { int32 x; };

int32 Twice(int32 v) { return v * 2; }

void TestArrayElementExpressions() {
	int32[4] a;
	a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;

	// arr[i] + 1 inside an expression.
	int32 v = a[1] + 1;
	AssertEqual(3, v);

	// f(arr[i]).
	int32 w = Twice(a[2]);
	AssertEqual(6, w);

	// arr[i] = arr[j] + k.
	a[0] = a[3] + 10;
	AssertEqual(14, a[0]);

	// variable index from another array (double indexing).
	int32[2] idx;
	idx[0] = 1; idx[1] = 3;
	int32 s = a[idx[0]] + a[idx[1]];
	AssertEqual(6, s);

	// array of struct: element field read/write must target the array in place.
	Pt[3] pts;
	pts[0].x = 10; pts[1].x = 20; pts[2].x = 30;
	int32 sum = 0;
	for (int32 i = 0; i < 3; i++) sum += pts[i].x;
	AssertEqual(60, sum);
	pts[1].x = 99;
	AssertEqual(99, pts[1].x);
}
