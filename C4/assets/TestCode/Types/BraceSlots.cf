// Types - Brace Slots Tests (implementation)
include "../Framework/Assert.ch"
include "BraceSlots.ch"

// BUG-195..197: positional braces fill the instance fields in order: never a static, one view of a union (the
// first), and the lanes of a packed region.
struct BsWithStatic { public static int32 count; public int32 a; public int32 b; }
struct BsWithUnion {
	public int32 id;
	public union { struct { public float r; public float g; }; struct { public float x; public float y; }; };
	public int32 tail;
}
class BsWithLanes {
	public int32 id;
	public union { packed float x, y; packed float r, g; packed float[2] data; };
	public int32 tail;
}
class BsOnlyArray { public union { packed int32[3] data; }; public int32 after; }
struct BsOuter { public BsWithUnion inner; public int32 last; }

void TestBraceSlotsInDeclarations() {
	BsWithStatic s = { 1, 2 };
	Assert(s.a == 1 && s.b == 2 && BsWithStatic::count == 0, "a static is not a slot");
	BsWithUnion u = { 7, 1.5f, 2.5f, 9 };
	Assert(u.id == 7 && u.r == 1.5f && u.g == 2.5f && u.tail == 9, "a union fills its first view");
	BsWithLanes l = { 3, 4.0f, 5.0f, 6 };
	Assert(l.id == 3 && l.x == 4.0f && l.y == 5.0f && l.tail == 6, "packed lanes are slots");
	BsWithLanes k = { id = 1, g = 8.0f, tail = 2 };
	Assert(k.id == 1 && k.x == 0.0f && k.y == 8.0f && k.tail == 2, "a designator names a lane by any name");
	BsOnlyArray a = { 1, 2, 3, 4 };
	Assert(a.data[0] == 1 && a.data[2] == 3 && a.after == 4, "unnamed lanes of an array-only region");
	BsOuter o = { { 1, 0.5f, 0.25f, 2 }, 3 };
	Assert(o.inner.g == 0.25f && o.inner.tail == 2 && o.last == 3, "a nested aggregate");
}

void TestBraceSlotsInConstruction() {
	BsWithStatic s = BsWithStatic{ 5, 6 };
	Assert(s.a == 5 && s.b == 6, "T{...} skips the static");
	BsWithUnion u = BsWithUnion{ 1, 0.5f, 0.25f, 4 };
	Assert(u.r == 0.5f && u.g == 0.25f && u.tail == 4, "T{...} fills one view of the union");
	BsWithLanes l = BsWithLanes{ 9, 1.0f, 2.0f, 3 };
	Assert(l.id == 9 && l.x == 1.0f && l.y == 2.0f && l.tail == 3, "T{...} fills the lanes");
	BsWithLanes partial = BsWithLanes{ 2, 7.0f };
	Assert(partial.x == 7.0f && partial.y == 0.0f && partial.tail == 0, "omitted lanes are zero");
}

void TestBraceSlots() {
	TestBraceSlotsInDeclarations();
	TestBraceSlotsInConstruction();
}
