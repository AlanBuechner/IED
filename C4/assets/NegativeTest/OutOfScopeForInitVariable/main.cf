// A for-loop's init variable is scoped to the loop statement (C++ semantics). Using it after the
// loop must be a clear undefined-identifier error, not malformed IR. Before the for-init scoping fix
// this compiled to an untyped load and failed at LLVM with "value doesn't match function result type".
int32 main() {
    int32 sum = 0;
    for (int32 i = 1; i <= 4; i++) sum += i;
    return i;
}
