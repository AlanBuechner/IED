	// --- the search ----------------------------------------------------------------------------------------------

	// How hard a level looks (zlib's table): a match this long shortens the next search (good); a lazy level takes a
	// match without looking one byte on once it is this long (lazy), a greedy one inserts no more of a longer match's
	// positions; a match this long ends a search (nice); `chain` bounds the candidates a search tries.
	struct LevelSearch
	{
		public int32 good;
		public int32 lazy;
		public int32 nice;
		public int32 chain;
		public bool lazyMatching;
	}

	// The levels up to this one find matches with buckets instead of chains.
	const int32 kBucketLevel = 2;

	LevelSearch SearchFor(int32 level) {
		const int32[10] good = { 0, 4, 4, 4, 4, 8, 8, 8, 32, 32 };
		const int32[10] lazy = { 0, 4, 5, 6, 4, 16, 16, 32, 128, 258 };
		const int32[10] nice = { 0, 8, 16, 32, 16, 32, 128, 128, 258, 258 };
		const int32[10] chain = { 0, 4, 8, 32, 16, 32, 128, 256, 1024, 4096 };
		LevelSearch search;
		search.good = good[level];
		search.lazy = lazy[level];
		search.nice = nice[level];
		search.chain = chain[level];
		search.lazyMatching = level >= 4;
		return search;
	}

	// Positions are kept as 32-bit offsets from `base`, which moves up (zlib's slide) before they could overflow.
	const int64 kSlideAt = 1073741824;

	// A position is hashed by its next four bytes (zlib-ng's choice): a chain then holds only positions that share
	// four, so far fewer candidates are tried, at the cost of matches of exactly three bytes.
	const int64 kHashBytes = 4;

	// The positions seen, by the hash of their next four bytes: head[hash] is the latest (as its offset from `base`,
	// plus one; 0: none), and prev links a position to the one before it with the same hash, within the window.
	struct MatchFinder
	{
		public const uint8* data;
		public int64 size;
		public int64 base;
		public Core::Array<uint32> head;
		public Core::Array<uint32> prev;

		public void Start(const uint8* bytes, int64 count) {
			data = bytes;
			size = count;
			head.Resize((int64)kHashSize);
			prev.Resize(kWindowSize);
		}

		public void Insert(int64 position) {
			if (position + kHashBytes > size) return;
			if (position - base >= kSlideAt) Slide(position - kWindowSize - base);
			const int64 hash = Hash(position);
			prev[position & (kWindowSize - 1)] = head[hash];
			head[hash] = (uint32)(position - base + 1);
		}

		// The position an entry names, or -1 for none.
		public int64 Position(uint32 entry) const { return entry == 0u ? -1 : base + (int64)entry - 1; }

		private int64 Hash(int64 position) const {
			uint32 value = 0u;
			memcpy((void*)&value, (void*)(data + position), 4u);
			return (int64)((value * 2654435761u) >> (uint32)(32 - kHashBits));
		}

		// Every entry `shift` lower, those it would take below the base gone: none is within the window then.
		private void Slide(int64 shift) {
			SlideEntries(head.Data(), head.Count(), (uint32)shift);
			SlideEntries(prev.Data(), prev.Count(), (uint32)shift);
			base += shift;
		}
	}

	void SlideEntries(uint32* entries, int64 count, uint32 shift) {
		for (int64 i = 0; i < count; i++) entries[i] = entries[i] > shift ? entries[i] - shift : 0u;
	}

	// How many bytes at `a` and `b` agree, up to `limit`: eight at a time.
	int32 CommonLength(const uint8* a, const uint8* b, int32 limit) {
		int32 length = 0;
		while (length + 8 <= limit) {
			uint64 x = 0u;
			uint64 y = 0u;
			memcpy((void*)&x, (void*)(a + length), 8u);
			memcpy((void*)&y, (void*)(b + length), 8u);
			const uint64 differ = x ^ y;
			if (differ != 0u) return length + (int32)(bit_trailing_zeros(differ) >> 3);
			length += 8;
		}
		while (length < limit && a[length] == b[length]) length++;
		return length;
	}

	uint32 Load32(const uint8* at) {
		uint32 value = 0u;
		memcpy((void*)&value, (void*)at, 4u);
		return value;
	}

	// The longest match for `position` (after it was inserted) longer than `shorter`, by its chain of candidates. A
	// candidate is compared in full only when its first four bytes and the four that would end a longer match agree
	// (zlib-ng's check): most are turned away by two loads.
	struct Match
	{
		public int32 length;
		public int32 distance;
	}

	Match LongestMatch(const MatchFinder& finder, int64 position, int32 shorter, const LevelSearch& search) {
		Match best;
		best.length = shorter;
		const int64 left = finder.size - position;
		const int32 limit = left < (int64)kMaxMatch ? (int32)left : kMaxMatch;
		if (limit < (int32)kHashBytes || shorter >= limit) return best;
		int32 chain = shorter >= search.good ? search.chain >> 2 : search.chain;
		const uint8* here = finder.data + position;
		const uint32 start = Load32(here);
		int32 endAt = shorter >= 3 ? shorter - 3 : 0;
		uint32 end = Load32(here + endAt);
		const uint32* prev = finder.prev.Data();
		int64 candidate = finder.Position(prev[position & (kWindowSize - 1)]);
		while (candidate >= 0 && position - candidate <= kWindowSize && chain > 0) {
			chain--;
			const uint8* there = finder.data + candidate;
			if (Load32(there + endAt) == end && Load32(there) == start) {
				const int32 length = CommonLength(there, here, limit);
				if (length > best.length) {
					best.length = length;
					best.distance = (int32)(position - candidate);
					if (length >= search.nice || length >= limit) break;
					endAt = length - 3;
					end = Load32(here + endAt);
				}
			}
			const int64 next = finder.Position(prev[candidate & (kWindowSize - 1)]);
			if (next >= candidate) break; // a link the window overwrote
			candidate = next;
		}
		return best;
	}

	// --- the symbols -----------------------------------------------------------------------------------------------

	// A block's literals and matches as they were found, and the input bytes they cover.
	struct Symbols
	{
		public Core::Array<uint32> items;   // a literal byte, or kMatchFlag | length << 15 | (distance - 1)
		public int64 start;                 // the input offset the block begins at
		public int64 end;

		public Frequencies counts;          // of the symbols, counted as they come

		public void Literal(uint8 byte) {
			items.Push((uint32)byte);
			counts.literals[(int32)byte] += 1u;
			end += 1;
		}

		public void Match(int32 length, int32 distance) {
			items.Push(kMatchFlag | ((uint32)length << 15) | (uint32)(distance - 1));
			counts.literals[257 + LengthIndex(length)] += 1u;
			counts.distances[DistanceSymbol(distance)] += 1u;
			end += (int64)length;
		}
	}

	int32 LengthIndex(int32 length) { return (int32)kLengthIndex[length - kMinMatch]; }

	int32 DistanceSymbol(int32 distance) {
		const int32 at = distance - 1;
		return (int32)(at < 256 ? kDistanceSymbol[at] : kDistanceSymbol[256 + (at >> 7)]);
	}

	// --- the codes -------------------------------------------------------------------------------------------------

	// Huffman code lengths for `count` symbols' frequencies (0: unused), none longer than `limit`: an optimal code,
	// its frequencies halved (each kept at least 1) until it fits.
	void BuildLengths(const uint32* frequencies, int32 count, int32 limit, uint8* lengths) {
		Core::Array<uint32> weights;
		weights.Resize((int64)count);
		for (int32 i = 0; i < count; i++) weights[i] = frequencies[i];
		while (true) {
			int32 longest = OptimalLengths(&weights[0], count, lengths);
			if (longest <= limit) return;
			for (int32 i = 0; i < count; i++) if (weights[i] != 0u) weights[i] = (weights[i] + 1u) / 2u;
		}
	}

	// An optimal code's lengths (Huffman's two queues over the symbols sorted by weight): the longest.
	int32 OptimalLengths(const uint32* weights, int32 count, uint8* lengths) {
		Core::Array<int32> order;
		for (int32 i = 0; i < count; i++) {
			lengths[i] = 0u;
			if (weights[i] != 0u) order.Push(i);
		}
		const int32 used = (int32)order.Count();
		if (used == 0) return 0;
		if (used == 1) { lengths[order[0]] = 1u; return 1; }
		order.SortBy([weights](int32 a, int32 b) -> bool { return weights[a] < weights[b] || (weights[a] == weights[b] && a < b); });
		// Nodes 0..used-1 are the leaves in weight order, then the merged nodes in the order they are made.
		Core::Array<uint64> weight;
		Core::Array<int32> parent;
		weight.Resize((int64)(2 * used));
		parent.Resize((int64)(2 * used));
		for (int32 i = 0; i < used; i++) weight[i] = (uint64)weights[order[i]];
		int32 leaf = 0;
		int32 merged = used;
		for (int32 made = used; made < 2 * used - 1; made++) {
			int32[2] pick;
			for (int32 k = 0; k < 2; k++) {
				if (leaf < used && (merged >= made || weight[leaf] <= weight[merged])) { pick[k] = leaf; leaf++; }
				else { pick[k] = merged; merged++; }
			}
			weight[made] = weight[pick[0]] + weight[pick[1]];
			parent[pick[0]] = made;
			parent[pick[1]] = made;
		}
		const int32 root = 2 * used - 2;
		Core::Array<int32> depth;
		depth.Resize((int64)(2 * used));
		depth[root] = 0;
		int32 longest = 0;
		for (int32 node = root - 1; node >= 0; node--) {
			depth[node] = depth[parent[node]] + 1;
			if (node < used) {
				lengths[order[node]] = (uint8)depth[node];
				if (depth[node] > longest) longest = depth[node];
			}
		}
		return longest;
	}

	// Each symbol's canonical code (RFC 1951 section 3.2.2), bit-reversed for writing least significant first.
	void BuildCodes(const uint8* lengths, int32 count, uint16* codes) {
		int32[16] sizes;
		for (int32 i = 0; i < 16; i++) sizes[i] = 0;
		for (int32 i = 0; i < count; i++) sizes[lengths[i]] += 1;
		sizes[0] = 0;
		int32[16] next;
		int32 code = 0;
		for (int32 bits = 1; bits < 16; bits++) {
			code = (code + sizes[bits - 1]) << 1;
			next[bits] = code;
		}
		for (int32 i = 0; i < count; i++) {
			const int32 len = (int32)lengths[i];
			if (len == 0) continue;
			int32 value = next[len];
			next[len] += 1;
			int32 reversed = 0;
			for (int32 b = 0; b < len; b++) { reversed = (reversed << 1) | (value & 1); value >>= 1; }
			codes[i] = (uint16)reversed;
		}
	}

	// A block's codes: literal/length and distance lengths and codes, and its code-length code when it is dynamic.
	struct BlockCodes
	{
		public uint8[286] literalLengths;
		public uint16[286] literalCodes;
		public uint8[30] distanceLengths;
		public uint16[30] distanceCodes;
	}

	// A block's codes wherever they are kept: the fixed codes are constants, a dynamic block's are built.
	struct CodeSet
	{
		public const uint8* literalLengths;
		public const uint16* literalCodes;
		public const uint8* distanceLengths;
		public const uint16* distanceCodes;
	}

	CodeSet FixedCodes() {
		CodeSet codes;
		codes.literalLengths = &kFixedLiteralLengths[0];
		codes.literalCodes = &kFixedLiteralCodes[0];
		codes.distanceLengths = &kFixedDistanceLengths[0];
		codes.distanceCodes = &kFixedDistanceCodes[0];
		return codes;
	}

	CodeSet CodesOf(const BlockCodes& block) {
		CodeSet codes;
		codes.literalLengths = &block.literalLengths[0];
		codes.literalCodes = &block.literalCodes[0];
		codes.distanceLengths = &block.distanceLengths[0];
		codes.distanceCodes = &block.distanceCodes[0];
		return codes;
	}

	// The symbols' frequencies, end of block included.
	struct Frequencies
	{
		public uint32[286] literals;
		public uint32[30] distances;
	}

	Frequencies BlockFrequencies(const Symbols& symbols) {
		Frequencies counts = symbols.counts;
		counts.literals[kEndOfBlockSymbol] += 1u;
		return counts;
	}

	// The bits the symbols take under `codes`, extra bits included.
	int64 DataBits(const Frequencies& counts, const CodeSet& codes) {
		int64 bits = 0;
		for (int32 i = 0; i < kLiteralCodes; i++) {
			bits += (int64)counts.literals[i] * (int64)codes.literalLengths[i];
			if (i >= 257) bits += (int64)counts.literals[i] * (int64)kMatchLengthExtra[i - 257];
		}
		for (int32 i = 0; i < kDistanceCodes; i++) bits += (int64)counts.distances[i] * (int64)(codes.distanceLengths[i] + kMatchDistanceExtra[i]);
		return bits;
	}

	// --- the header of a dynamic block -----------------------------------------------------------------------------

	// The code lengths run-length coded (16: the last length again, 17 and 18: zeros): a symbol and its extra bits each.
	struct LengthRuns
	{
		public Core::Array<uint8> symbols;
		public Core::Array<uint8> extras;
	}

	LengthRuns RunsOf(const uint8* lengths, int32 count) {
		LengthRuns runs;
		int32 i = 0;
		while (i < count) {
			const uint8 value = lengths[i];
			int32 run = 1;
			while (i + run < count && lengths[i + run] == value) run++;
			i += run;
			if (value == 0u) {
				while (run >= 11) { const int32 take = run < 138 ? run : 138; runs.symbols.Push(18u); runs.extras.Push((uint8)(take - 11)); run -= take; }
				if (run >= 3) { runs.symbols.Push(17u); runs.extras.Push((uint8)(run - 3)); run = 0; }
				while (run > 0) { runs.symbols.Push(0u); runs.extras.Push(0u); run--; }
				continue;
			}
			runs.symbols.Push(value);
			runs.extras.Push(0u);
			run--;
			while (run >= 3) { const int32 take = run < 6 ? run : 6; runs.symbols.Push(16u); runs.extras.Push((uint8)(take - 3)); run -= take; }
			while (run > 0) { runs.symbols.Push(value); runs.extras.Push(0u); run--; }
		}
		return runs;
	}

	// A dynamic block's header, ready to write and to cost.
	struct DynamicHeader
	{
		public int32 literalCount;
		public int32 distanceCount;
		public int32 lengthCodeCount;
		public uint8[320] lengths;     // the literal then the distance code lengths
		public LengthRuns runs;
		public uint8[19] lengthCodeLengths;
		public uint16[19] lengthCodeCodes;
	}

	DynamicHeader HeaderFor(const BlockCodes& codes) {
		DynamicHeader header;
		header.literalCount = kLiteralCodes;
		while (header.literalCount > 257 && codes.literalLengths[header.literalCount - 1] == 0u) header.literalCount--;
		header.distanceCount = kDistanceCodes;
		while (header.distanceCount > 1 && codes.distanceLengths[header.distanceCount - 1] == 0u) header.distanceCount--;
		for (int32 i = 0; i < header.literalCount; i++) header.lengths[i] = codes.literalLengths[i];
		for (int32 i = 0; i < header.distanceCount; i++) header.lengths[header.literalCount + i] = codes.distanceLengths[i];
		header.runs = RunsOf(&header.lengths[0], header.literalCount + header.distanceCount);
		uint32[19] counts;
		for (int32 i = 0; i < 19; i++) counts[i] = 0u;
		for (int64 i = 0; i < header.runs.symbols.Count(); i++) counts[(int32)header.runs.symbols[i]] += 1u;
		BuildLengths(&counts[0], 19, kMostLengthCodeBits, &header.lengthCodeLengths[0]);
		BuildCodes(&header.lengthCodeLengths[0], 19, &header.lengthCodeCodes[0]);
		header.lengthCodeCount = 19;
		while (header.lengthCodeCount > 4 && header.lengthCodeLengths[(int32)kLengthCodeOrder[header.lengthCodeCount - 1]] == 0u) header.lengthCodeCount--;
		return header;
	}

	int64 HeaderBits(const DynamicHeader& header) {
		int64 bits = 5 + 5 + 4 + 3 * (int64)header.lengthCodeCount;
		for (int64 i = 0; i < header.runs.symbols.Count(); i++) {
			const int32 symbol = (int32)header.runs.symbols[i];
			bits += (int64)header.lengthCodeLengths[symbol] + (symbol == 16 ? 2 : symbol == 17 ? 3 : symbol == 18 ? 7 : 0);
		}
		return bits;
	}

	// --- writing ---------------------------------------------------------------------------------------------------

	// The most bytes a block's coded symbols and header take besides 6 a symbol (a 15-bit code, 5 extra bits, a 15-bit
	// code and 13 extra bits): the header, the end of block and the last bits.
	const int64 kBlockRoomSlack = 1024;

	// Bits out, least significant first, after what `out` held: whole 32-bit words stored straight into room Reserve
	// made, which Finish trims to what was written. Writing loops copy it into a local, so a stored byte (which may
	// alias anything) does not make them read its fields again.
	struct BitWriter
	{
		public Core::Array<uint8>* out;
		public uint8* base;     // out's bytes, until the next Reserve
		public int64 written;   // bytes of `out` written
		public uint64 bits;
		public int32 count;

		public void Start(Core::Array<uint8>& array) {
			out = &array;
			written = array.Count();
			base = array.Data();
		}

		// Room for `bytes` more bytes past what was written.
		public void Reserve(int64 bytes) {
			const int64 needed = written + bytes;
			const int64 size = out->Count();
			if (needed > size) out->Resize(needed > size * 2 ? needed : size * 2);
			base = out->Data();
		}

		// At most 32 bits a call: whole 32-bit words go out as they fill.
		public void Put(uint32 value, int32 n) {
			bits |= (uint64)value << (uint64)count;
			count += n;
			if (count < 32) return;
			const uint32 word = (uint32)bits;
			memcpy((void*)(base + written), (void*)&word, 4u);
			written += 4;
			bits >>= 32u;
			count -= 32;
		}

		// To the next whole byte, with zero bits, and the whole bytes out.
		public void Align() {
			if ((count & 7) != 0) Put(0u, 8 - (count & 7));
			while (count > 0) {
				base[written] = (uint8)(bits & 0xffu);
				written += 1;
				bits >>= 8u;
				count -= 8;
			}
		}

		// Bytes as they are, once aligned.
		public void PutBytes(const uint8* bytes, int64 n) {
			memcpy((void*)(base + written), (void*)bytes, (uint64)n);
			written += n;
		}

		// The last bits out, and `out` exactly what was written.
		public void Finish() {
			Align();
			out->Resize(written);
		}
	}

	void WriteSymbols(BitWriter& into, const Symbols& symbols, const CodeSet& codes) {
		BitWriter writer = into;
		const uint32* items = symbols.items.Data();
		const int64 count = symbols.items.Count();
		for (int64 i = 0; i < count; i++) {
			const uint32 item = items[i];
			if ((item & kMatchFlag) == 0u) {
				writer.Put((uint32)codes.literalCodes[(int32)item], (int32)codes.literalLengths[(int32)item]);
				continue;
			}
			const int32 length = (int32)((item >> 15) & 511u);
			const int32 distance = (int32)(item & 32767u) + 1;
			const int32 lengthIndex = LengthIndex(length);
			writer.Put((uint32)codes.literalCodes[257 + lengthIndex], (int32)codes.literalLengths[257 + lengthIndex]);
			writer.Put((uint32)(length - (int32)kMatchLengthBase[lengthIndex]), (int32)kMatchLengthExtra[lengthIndex]);
			const int32 distanceIndex = DistanceSymbol(distance);
			writer.Put((uint32)codes.distanceCodes[distanceIndex], (int32)codes.distanceLengths[distanceIndex]);
			writer.Put((uint32)(distance - (int32)kMatchDistanceBase[distanceIndex]), (int32)kMatchDistanceExtra[distanceIndex]);
		}
		writer.Put((uint32)codes.literalCodes[kEndOfBlockSymbol], (int32)codes.literalLengths[kEndOfBlockSymbol]);
		into = writer;
	}

	void WriteHeader(BitWriter& writer, const DynamicHeader& header) {
		writer.Put((uint32)(header.literalCount - 257), 5);
		writer.Put((uint32)(header.distanceCount - 1), 5);
		writer.Put((uint32)(header.lengthCodeCount - 4), 4);
		for (int32 i = 0; i < header.lengthCodeCount; i++) writer.Put((uint32)header.lengthCodeLengths[(int32)kLengthCodeOrder[i]], 3);
		for (int64 i = 0; i < header.runs.symbols.Count(); i++) {
			const int32 symbol = (int32)header.runs.symbols[i];
			writer.Put((uint32)header.lengthCodeCodes[symbol], (int32)header.lengthCodeLengths[symbol]);
			if (symbol >= 16) writer.Put((uint32)header.runs.extras[i], symbol == 16 ? 2 : symbol == 17 ? 3 : 7);
		}
	}

	void WriteStored(BitWriter& writer, const uint8* data, int64 start, int64 end, bool last) {
		int64 at = start;
		while (true) {
			const int64 size = end - at < kMostStoredBytes ? end - at : kMostStoredBytes;
			const bool final = last && at + size == end;
			writer.Put(final ? 1u : 0u, 1);
			writer.Put(0u, 2);
			writer.Align();
			writer.Put((uint32)size, 16);
			writer.Put((uint32)(size ^ 0xffff), 16);
			writer.PutBytes(data + at, size);
			at += size;
			if (at >= end) return;
		}
	}

	int64 StoredBits(int64 bytes, int32 pending) {
		const int64 blocks = bytes == 0 ? 1 : (bytes + kMostStoredBytes - 1) / kMostStoredBytes;
		return blocks * (3 + 7 + 32) + bytes * 8 + (int64)(8 - pending);
	}

	// The block in whichever form takes fewest bits: stored, fixed codes, or codes of its own.
	void WriteBlock(BitWriter& writer, const uint8* data, const Symbols& symbols, bool last) {
		writer.Reserve((symbols.end - symbols.start) + 6 * symbols.items.Count() + kBlockRoomSlack);
		const Frequencies counts = BlockFrequencies(symbols);
		BlockCodes dynamic;
		BuildLengths(&counts.literals[0], kLiteralCodes, kMostCodeBits, &dynamic.literalLengths[0]);
		uint32[30] distances;
		bool anyDistance = false;
		for (int32 i = 0; i < kDistanceCodes; i++) { distances[i] = counts.distances[i]; anyDistance = anyDistance || distances[i] != 0u; }
		if (!anyDistance) distances[0] = 1u; // a block without matches still has a distance code
		BuildLengths(&distances[0], kDistanceCodes, kMostCodeBits, &dynamic.distanceLengths[0]);
		BuildCodes(&dynamic.literalLengths[0], kLiteralCodes, &dynamic.literalCodes[0]);
		BuildCodes(&dynamic.distanceLengths[0], kDistanceCodes, &dynamic.distanceCodes[0]);
		const DynamicHeader header = HeaderFor(dynamic);
		const CodeSet fixed = FixedCodes();
		const CodeSet own = CodesOf(dynamic);
		const int64 dynamicBits = 3 + HeaderBits(header) + DataBits(counts, own);
		const int64 fixedBits = 3 + DataBits(counts, fixed);
		const int64 storedBits = StoredBits(symbols.end - symbols.start, writer.count);
		if (storedBits <= dynamicBits && storedBits <= fixedBits) {
			WriteStored(writer, data, symbols.start, symbols.end, last);
			return;
		}
		writer.Put(last ? 1u : 0u, 1);
		if (fixedBits <= dynamicBits) {
			writer.Put(1u, 2);
			WriteSymbols(writer, symbols, fixed);
			return;
		}
		writer.Put(2u, 2);
		WriteHeader(writer, header);
		WriteSymbols(writer, symbols, own);
	}

	// --- the compressor ----------------------------------------------------------------------------------------------

	// Gathers symbols and writes a block whenever a block's worth is in.
	struct Compressor
	{
		public const uint8* data;
		public BitWriter writer;
		public Symbols symbols;

		public void Flush(bool last) {
			WriteBlock(writer, data, symbols, last);
			symbols.items.Clear();
			Frequencies none;
			symbols.counts = none;
			symbols.start = symbols.end;
		}

		public void BlockIfFull() { if (symbols.items.Count() >= (int64)kBlockSymbols) Flush(false); }
	}

	// The fastest levels' match finder (libdeflate's ht_matchfinder): each hash keeps the last kBucketSize positions
	// that had it, newest first, and a position is matched against those alone. No chain is kept, so a position costs
	// one bucket's read and write.
	const int64 kBucketSize = 2;

	struct BucketFinder
	{
		public const uint8* data;
		public int64 size;
		public int64 base;
		public Core::Array<uint32> buckets;   // offsets from `base` plus one (0: none)

		public void Start(const uint8* bytes, int64 count) {
			data = bytes;
			size = count;
			buckets.Resize((int64)kHashSize * kBucketSize);
		}

		// The longest match among the bucket's positions for `position`, which then joins the bucket.
		public Match FindAndInsert(int64 position) {
			Match best;
			best.length = kMinMatch - 1;
			const int64 left = size - position;
			if (left < kHashBytes) return best;
			if (position - base >= kSlideAt) Slide(position - kWindowSize - base);
			const int32 limit = left < (int64)kMaxMatch ? (int32)left : kMaxMatch;
			const uint8* here = data + position;
			const uint32 start = Load32(here);
			uint32* bucket = buckets.Data() + Hash(position) * kBucketSize;
			for (int64 k = 0; k < kBucketSize; k++) {
				if (bucket[k] == 0u) break;
				const int64 candidate = base + (int64)bucket[k] - 1;
				if (position - candidate > kWindowSize) break;
				const uint8* there = data + candidate;
				if (Load32(there) != start) continue;
				const int32 length = CommonLength(there, here, limit);
				if (length > best.length) {
					best.length = length;
					best.distance = (int32)(position - candidate);
				}
			}
			Push(bucket, position);
			return best;
		}

		public void Insert(int64 position) {
			if (size - position < kHashBytes) return;
			Push(buckets.Data() + Hash(position) * kBucketSize, position);
		}

		private void Push(uint32* bucket, int64 position) {
			for (int64 k = kBucketSize - 1; k > 0; k--) bucket[k] = bucket[k - 1];
			bucket[0] = (uint32)(position - base + 1);
		}

		private int64 Hash(int64 position) const { return (int64)((Load32(data + position) * 2654435761u) >> (uint32)(32 - kHashBits)); }

		private void Slide(int64 shift) {
			SlideEntries(buckets.Data(), buckets.Count(), (uint32)shift);
			base += shift;
		}
	}

	// After 2^this searches in a row find nothing, a fast level searches every other position, then every third, and
	// so on until a match is found (LZ4's acceleration): data that does not compress goes by quickly, its bytes still
	// written as literals.
	const int32 kSkipTrigger = 6;

	// The fastest levels: the longest match among a bucket's positions, taken at once, searching less often while
	// nothing is found.
	void CompressFast(Compressor& compressor, BucketFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		int64 misses = 0;
		while (position < size) {
			const Match match = finder.FindAndInsert(position);
			if (match.length >= kMinMatch) {
				compressor.symbols.Match(match.length, match.distance);
				if (match.length <= search.lazy) for (int32 k = 1; k < match.length; k++) finder.Insert(position + (int64)k);
				position += (int64)match.length;
				misses = 0;
			}
			else {
				const int64 step = 1 + (misses >> (int64)kSkipTrigger);
				const int64 end = position + step < size ? position + step : size;
				for (; position < end; position++) compressor.symbols.Literal(compressor.data[position]);
				misses += 1;
			}
			compressor.BlockIfFull();
		}
	}

	// zlib's deflate_fast: the longest match at each position searched, taken at once.
	void CompressGreedy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		int64 misses = 0;
		while (position < size) {
			finder.Insert(position);
			const Match match = LongestMatch(finder, position, kMinMatch - 1, search);
			if (match.length >= kMinMatch) {
				compressor.symbols.Match(match.length, match.distance);
				if (match.length <= search.lazy) for (int32 k = 1; k < match.length; k++) finder.Insert(position + (int64)k);
				position += (int64)match.length;
				misses = 0;
			}
			else {
				const int64 step = 1 + (misses >> (int64)kSkipTrigger);
				const int64 end = position + step < size ? position + step : size;
				for (; position < end; position++) compressor.symbols.Literal(compressor.data[position]);
				misses += 1;
			}
			compressor.BlockIfFull();
		}
	}

	// zlib's deflate_slow: a match is taken only when the next position has no longer one.
	void CompressLazy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		Match previous;
		bool pending = false;   // the byte before `position` waits: a literal, or the start of `previous`
		while (position < size) {
			finder.Insert(position);
			Match current;
			current.length = kMinMatch - 1;
			// Only a longer match than the one waiting matters: the search starts from its length (zlib's).
			if (previous.length < search.lazy) current = LongestMatch(finder, position, previous.length > current.length ? previous.length : current.length, search);
			if (pending && previous.length >= kMinMatch && current.length <= previous.length) {
				compressor.symbols.Match(previous.length, previous.distance);
				const int64 end = position - 1 + (int64)previous.length;
				for (int64 k = position + 1; k < end; k++) finder.Insert(k);
				position = end;
				pending = false;
				previous.length = 0;
				compressor.BlockIfFull();
				continue;
			}
			if (pending) compressor.symbols.Literal(compressor.data[position - 1]);
			pending = true;
			previous = current;
			position += 1;
			compressor.BlockIfFull();
		}
		if (pending) compressor.symbols.Literal(compressor.data[position - 1]);
	}

	void Deflate(const uint8* data, int64 size, int32 level, Core::Array<uint8>& out) {
		const int32 clamped = level < kStoreLevel ? kDefaultLevel : level > kBestLevel ? kBestLevel : level;
		Compressor compressor;
		compressor.data = data;
		compressor.writer.Start(out);
		if (clamped == kStoreLevel) {
			compressor.writer.Reserve(size + kBlockRoomSlack + 5 * (size / kMostStoredBytes));
			WriteStored(compressor.writer, data, 0, size, true);
			compressor.writer.Finish();
			return;
		}
		const LevelSearch search = SearchFor(clamped);
		if (clamped <= kBucketLevel) {
			BucketFinder buckets;
			buckets.Start(data, size);
			CompressFast(compressor, buckets, size, search);
		}
		else {
			MatchFinder finder;
			finder.Start(data, size);
			if (search.lazyMatching) CompressLazy(compressor, finder, size, search);
			else CompressGreedy(compressor, finder, size, search);
		}
		compressor.Flush(true);
		compressor.writer.Finish();
	}
}
