include "deflate.ch"
include "deflatesearch.ch"
include "deflatewrite.ch"

namespace Compression
{
	// Gathers symbols and writes a block whenever a block's worth is in.
	struct Compressor
	{
		public const uint8* data;
		public BitWriter writer;
		public Symbols symbols;

		public void Flush(bool last) {
			WriteBlock(writer, data, symbols, last);
			symbols.items.Clear();
			Frequencies none;
			symbols.counts = none;
			symbols.start = symbols.end;
		}

		public void BlockIfFull() { if (symbols.items.Count() >= (int64)kBlockSymbols) Flush(false); }
	}

	// After 2^this searches in a row find nothing, a fast level searches every other position, then every third, and
	// so on until a match is found (LZ4's acceleration): data that does not compress goes by quickly, its bytes still
	// written as literals.
	const int32 kSkipTrigger = 6;

	// The fastest levels: the longest match among a bucket's positions, taken at once, searching less often while
	// nothing is found.
	void CompressFast(Compressor& compressor, BucketFinder& finder, int64 size, const LevelSearch& search);

	// zlib's deflate_fast: the longest match at each position searched, taken at once.
	void CompressGreedy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search);

	// zlib's deflate_slow: a match is taken only when the next position has no longer one.
	void CompressLazy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search);

	void CompressFast(Compressor& compressor, BucketFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		int64 misses = 0;
		while (position < size) {
			const Match match = finder.FindAndInsert(position);
			if (match.length >= kMinMatch) {
				compressor.symbols.Match(match.length, match.distance);
				if (match.length <= search.lazy) for (int32 k = 1; k < match.length; k++) finder.Insert(position + (int64)k);
				position += (int64)match.length;
				misses = 0;
			}
			else {
				const int64 step = 1 + (misses >> (int64)kSkipTrigger);
				const int64 end = position + step < size ? position + step : size;
				for (; position < end; position++) compressor.symbols.Literal(compressor.data[position]);
				misses += 1;
			}
			compressor.BlockIfFull();
		}
	}

	void CompressGreedy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		int64 misses = 0;
		while (position < size) {
			finder.Insert(position);
			const Match match = LongestMatch(finder, position, kMinMatch - 1, search);
			if (match.length >= kMinMatch) {
				compressor.symbols.Match(match.length, match.distance);
				if (match.length <= search.lazy) for (int32 k = 1; k < match.length; k++) finder.Insert(position + (int64)k);
				position += (int64)match.length;
				misses = 0;
			}
			else {
				const int64 step = 1 + (misses >> (int64)kSkipTrigger);
				const int64 end = position + step < size ? position + step : size;
				for (; position < end; position++) compressor.symbols.Literal(compressor.data[position]);
				misses += 1;
			}
			compressor.BlockIfFull();
		}
	}

	void CompressLazy(Compressor& compressor, MatchFinder& finder, int64 size, const LevelSearch& search) {
		int64 position = 0;
		Match previous;
		bool pending = false;   // the byte before `position` waits: a literal, or the start of `previous`
		while (position < size) {
			finder.Insert(position);
			Match current;
			current.length = kMinMatch - 1;
			// Only a longer match than the one waiting matters: the search starts from its length (zlib's).
			if (previous.length < search.lazy) current = LongestMatch(finder, position, previous.length > current.length ? previous.length : current.length, search);
			if (pending && previous.length >= kMinMatch && current.length <= previous.length) {
				compressor.symbols.Match(previous.length, previous.distance);
				const int64 end = position - 1 + (int64)previous.length;
				for (int64 k = position + 1; k < end; k++) finder.Insert(k);
				position = end;
				pending = false;
				previous.length = 0;
				compressor.BlockIfFull();
				continue;
			}
			if (pending) compressor.symbols.Literal(compressor.data[position - 1]);
			pending = true;
			previous = current;
			position += 1;
			compressor.BlockIfFull();
		}
		if (pending) compressor.symbols.Literal(compressor.data[position - 1]);
	}

	void Deflate(const uint8* data, int64 size, int32 level, Core::Array<uint8>& out) {
		const int32 clamped = level < kStoreLevel ? kDefaultLevel : level > kBestLevel ? kBestLevel : level;
		Compressor compressor;
		compressor.data = data;
		compressor.writer.Start(out);
		if (clamped == kStoreLevel) {
			compressor.writer.Reserve(size + kBlockRoomSlack + 5 * (size / kMostStoredBytes));
			WriteStored(compressor.writer, data, 0, size, true);
			compressor.writer.Finish();
			return;
		}
		const LevelSearch search = SearchFor(clamped);
		if (clamped <= kBucketLevel) {
			BucketFinder buckets;
			buckets.Start(data, size);
			CompressFast(compressor, buckets, size, search);
		}
		else {
			MatchFinder finder;
			finder.Start(data, size);
			if (search.lazyMatching) CompressLazy(compressor, finder, size, search);
			else CompressGreedy(compressor, finder, size, search);
		}
		compressor.Flush(true);
		compressor.writer.Finish();
	}
}
