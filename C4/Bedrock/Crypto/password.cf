include "password.ch"
include "compare.ch"
include "Container/array.ch"
include "Text/stringbuilder.ch"
include "Text/base64.ch"
include "Text/integer.ch"
include "Platform/system.ch"

namespace Crypto
{
	const int64 kPasswordSaltBytes = 16;
	// VerifyPassword's ceiling on m: a stored string cannot make a check take more than 4 GiB.
	const int64 kMaxVerifyMemoryKiB = 4194304;

	// A PHC string's parts: "$<type>$v=19$m=<m>,t=<t>,p=<p>$<salt>$<tag>".
	class PhcHash
	{
		public Argon2Params params;
		public Core::Array<uint8> salt;
		public Core::Array<uint8> tag;
	}

	static const char* TypeName(Argon2Type type) {
		if (type == Argon2Type::D) return "argon2d";
		if (type == Argon2Type::I) return "argon2i";
		return "argon2id";
	}

	static bool ParseType(Core::StringView name, Argon2Type& type) {
		if (name == "argon2d") type = Argon2Type::D;
		else if (name == "argon2i") type = Argon2Type::I;
		else if (name == "argon2id") type = Argon2Type::Id;
		else return false;
		return true;
	}

	static Argon2Input PasswordInput(Core::StringView password, const uint8* salt, int64 saltBytes) {
		Argon2Input input;
		input.password = (const void*)password.Data();
		input.passwordBytes = password.ByteLength();
		input.salt = (const void*)salt;
		input.saltBytes = saltBytes;
		input.secret = nullptr;
		input.secretBytes = 0;
		input.associated = nullptr;
		input.associatedBytes = 0;
		return input;
	}

	// Base64 without its '=' padding, as PHC strings carry it.
	static void AppendUnpadded(Core::StringBuilder& text, const uint8* bytes, int64 count) {
		const Core::String padded = Core::Base64Encode((const void*)bytes, count);
		Core::StringView view = padded.View();
		int64 length = view.ByteLength();
		while (length > 0 && view.ByteAt(length - 1) == '=') length -= 1;
		text.Append(view.Substring(0, length));
	}

	static bool DecodeUnpadded(Core::StringView text, Core::Array<uint8>& out) {
		if (text.IndexOf('=', 0) >= 0 || text.ByteLength() % 4 == 1) return false;
		Core::StringBuilder padded;
		padded.Append(text);
		for (int64 i = text.ByteLength() % 4; i % 4 != 0; ++i) padded.AppendByte('=');
		return Core::Base64Decode(padded.View(), out);
	}

	static Core::String Encoded(const Argon2Params& params, const uint8* salt, const uint8* tag) {
		Core::StringBuilder text;
		text.AppendByte('$');
		text.Append(TypeName(params.type));
		text.Append("$v=19$m=");
		text.AppendInt(params.memoryKiB);
		text.Append(",t=");
		text.AppendInt(params.passes);
		text.Append(",p=");
		text.AppendInt(params.lanes);
		text.AppendByte('$');
		AppendUnpadded(text, salt, kPasswordSaltBytes);
		text.AppendByte('$');
		AppendUnpadded(text, tag, params.tagBytes);
		return text.ToString();
	}

	Core::String HashPassword(Core::StringView password, const Argon2Params& params) {
		uint8[16] salt;
		if (params.tagBytes < 4 || !Platform::RandomBytes((void*)&salt[0], kPasswordSaltBytes)) return Core::String();
		Core::Array<uint8> tag;
		tag.Resize(params.tagBytes);
		if (!Argon2(params, PasswordInput(password, &salt[0], kPasswordSaltBytes), (void*)tag.Data())) return Core::String();
		return Encoded(params, &salt[0], tag.Data());
	}

	static Core::Array<Core::StringView> Split(Core::StringView text, char separator) {
		Core::Array<Core::StringView> parts;
		int64 start = 0;
		for (int64 at = text.IndexOf(separator, 0); at >= 0; at = text.IndexOf(separator, start)) {
			parts.Push(text.Substring(start, at - start));
			start = at + 1;
		}
		parts.Push(text.Substring(start, text.ByteLength() - start));
		return parts;
	}

	// "<name>=<number>" with the number in 1 to `most`.
	static bool ParseCost(Core::StringView text, const char* name, int64 most, int32& value) {
		Core::StringView prefix = Core::StringView(name);
		int64 number = 0;
		if (!text.StartsWith(prefix) || !Core::ParseInt64(text.Substring(prefix.ByteLength(), text.ByteLength() - prefix.ByteLength()), number)) return false;
		if (number < 1 || number > most) return false;
		value = (int32)number;
		return true;
	}

	static bool ParseCosts(Core::StringView text, Argon2Params& params) {
		Core::Array<Core::StringView> costs = Split(text, ',');
		return costs.Count() == 3 && ParseCost(costs[0], "m=", kMaxVerifyMemoryKiB, params.memoryKiB)
			&& ParseCost(costs[1], "t=", 2147483647, params.passes) && ParseCost(costs[2], "p=", 16777215, params.lanes);
	}

	static bool ParseEncoded(Core::StringView text, PhcHash& hash) {
		Core::Array<Core::StringView> parts = Split(text, '$');
		if (parts.Count() != 6 || !parts[0].IsEmpty() || parts[2] != "v=19") return false;
		if (!ParseType(parts[1], hash.params.type) || !ParseCosts(parts[3], hash.params)) return false;
		if (!DecodeUnpadded(parts[4], hash.salt) || !DecodeUnpadded(parts[5], hash.tag)) return false;
		hash.params.tagBytes = (int32)hash.tag.Count();
		return true;
	}

	bool VerifyPassword(Core::StringView password, Core::StringView encoded) {
		PhcHash hash;
		if (!ParseEncoded(encoded, hash)) return false;
		Core::Array<uint8> tag;
		tag.Resize(hash.tag.Count());
		if (!Argon2(hash.params, PasswordInput(password, hash.salt.Data(), hash.salt.Count()), (void*)tag.Data())) return false;
		return ConstantTimeEquals((const void*)tag.Data(), (const void*)hash.tag.Data(), tag.Count());
	}
}
