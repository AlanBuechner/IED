include "sha256.ch"
include "compare.ch"
include "../Text/stringbuilder.ch"

namespace Crypto
{
	const int64 kSha256BlockBytes = 64;
	// Where the message length goes in the last block: the final 8 bytes.
	const int64 kSha256LengthOffset = 56;

	// The first 32 bits of the fractional parts of the cube roots of the first 64 primes (FIPS 180-4 section 4.2.2).
	const uint32[64] kSha256Rounds = {
		0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
		0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
		0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
		0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
		0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
		0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
		0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
		0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
	};

	static uint32 RotateRight(uint32 value, int32 bits) { return (value >> (uint32)bits) | (value << (uint32)(32 - bits)); }

	static uint32 BigEndian32(const uint8* bytes) {
		return ((uint32)bytes[0] << 24u) | ((uint32)bytes[1] << 16u) | ((uint32)bytes[2] << 8u) | (uint32)bytes[3];
	}

	static void Schedule(const uint8* data, uint32* w) {
		for (int32 t = 0; t < 16; ++t) w[t] = BigEndian32(data + t * 4);
		for (int32 t = 16; t < 64; ++t) {
			const uint32 s0 = RotateRight(w[t - 15], 7) ^ RotateRight(w[t - 15], 18) ^ (w[t - 15] >> 3u);
			const uint32 s1 = RotateRight(w[t - 2], 17) ^ RotateRight(w[t - 2], 19) ^ (w[t - 2] >> 10u);
			w[t] = w[t - 16] + s0 + w[t - 7] + s1;
		}
	}

	void Sha256Builder::Compress(const uint8* data) {
		uint32[64] w;
		Schedule(data, &w[0]);
		uint32[8] v;
		for (int32 i = 0; i < 8; ++i) v[i] = state[i];
		for (int32 t = 0; t < 64; ++t) {
			const uint32 s1 = RotateRight(v[4], 6) ^ RotateRight(v[4], 11) ^ RotateRight(v[4], 25);
			const uint32 choose = (v[4] & v[5]) ^ (~v[4] & v[6]);
			const uint32 t1 = v[7] + s1 + choose + kSha256Rounds[t] + w[t];
			const uint32 s0 = RotateRight(v[0], 2) ^ RotateRight(v[0], 13) ^ RotateRight(v[0], 22);
			const uint32 majority = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
			for (int32 i = 7; i > 0; --i) v[i] = v[i - 1];
			v[4] += t1;
			v[0] = t1 + s0 + majority;
		}
		for (int32 i = 0; i < 8; ++i) state[i] += v[i];
	}

	// The initial hash value (FIPS 180-4 section 5.3.3), set before the first byte.
	static void Sha256Start(uint32* state) {
		state[0] = 0x6a09e667u;
		state[1] = 0xbb67ae85u;
		state[2] = 0x3c6ef372u;
		state[3] = 0xa54ff53au;
		state[4] = 0x510e527fu;
		state[5] = 0x9b05688cu;
		state[6] = 0x1f83d9abu;
		state[7] = 0x5be0cd19u;
	}

	void Sha256Builder::Add(const void* bytes, int64 count) {
		if (!started) {
			Sha256Start(&state[0]);
			started = true;
		}
		const uint8* next = (const uint8*)bytes;
		totalBytes += (uint64)count;
		int64 i = 0;
		while (i < count) {
			if (blockBytes == 0 && count - i >= kSha256BlockBytes) {
				Compress(next + i);
				i += kSha256BlockBytes;
				continue;
			}
			block[blockBytes] = next[i];
			blockBytes += 1;
			i += 1;
			if (blockBytes == kSha256BlockBytes) {
				Compress(&block[0]);
				blockBytes = 0;
			}
		}
	}

	Sha256Digest Sha256Builder::Finish() {
		const uint64 bits = totalBytes * 8u;
		uint8[1] marker = { (uint8)0x80 };
		uint8[1] zero = { (uint8)0 };
		Add((const void*)&marker[0], 1);
		while (blockBytes != kSha256LengthOffset) Add((const void*)&zero[0], 1);
		uint8[8] length;
		for (int32 i = 0; i < 8; ++i) length[i] = (uint8)(bits >> (uint64)(56 - i * 8));
		Add((const void*)&length[0], 8);
		Sha256Digest digest;
		for (int32 i = 0; i < 32; ++i) digest.bytes[i] = (uint8)(state[i / 4] >> (uint32)(24 - (i % 4) * 8));
		return digest;
	}

	Sha256Digest Sha256(const void* bytes, int64 count) {
		Sha256Builder builder;
		builder.Add(bytes, count);
		return builder.Finish();
	}

	Core::String Sha256Digest::ToHex() const {
		Core::StringBuilder text;
		for (int32 i = 0; i < 32; ++i) text.AppendUIntBase((uint64)bytes[i], 16, 2);
		return text.ToString();
	}

	bool Sha256Digest::Equals(const Sha256Digest& other) const {
		return ConstantTimeEquals((const void*)&bytes[0], (const void*)&other.bytes[0], kSha256Bytes);
	}
}
