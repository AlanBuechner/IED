include "regex.ch"
include "regexcompile.ch"
include "regexvm.ch"

namespace Core
{
	StringView RegexMatch::Group(int32 group) const {
		if (!Matched(group)) return StringView();
		return text.Substring(Start(group), End(group) - Start(group));
	}

	int32 Regex::GroupIndex(StringView name) const {
		for (int64 g = 1; g < names.Count(); ++g)
			if (names[g].View() == name) return (int32)g;
		return -1;
	}

	bool Regex::Matches(StringView text) const {
		RegexMatch match;
		return Match(text, match);
	}

	bool Regex::Match(StringView text, RegexMatch& match) const {
		match.text = text;
		return IsValid() && Run(text, 0, true, match.bounds);
	}

	bool Regex::Search(StringView text, RegexMatch& match, int64 from) const {
		match.text = text;
		if (!IsValid() || from < 0 || from > text.ByteLength()) return false;
		return Run(text, from, false, match.bounds);
	}

	bool Regex::Contains(StringView text) const {
		RegexMatch match;
		return Search(text, match, 0);
	}

	Array<RegexMatch> Regex::FindAll(StringView text) const {
		Array<RegexMatch> all;
		int64 from = 0;
		RegexMatch match;
		while (Search(text, match, from)) {
			all.Push(match);
			from = match.End();
			if (match.End() == match.Start()) {
				if (from >= text.ByteLength()) break;
				int32 width = 0;
				DecodeUtf8(text.Data(), text.ByteLength(), from, width);
				from += width;
			}
		}
		return all;
	}

	String Regex::Replace(StringView text, StringView replacement) const {
		StringBuilder out;
		int64 copied = 0;
		for (const RegexMatch& match : FindAll(text)) {
			out.Append(text.Substring(copied, match.Start() - copied));
			AppendReplacement(out, replacement, match);
			copied = match.End();
		}
		out.Append(text.Substring(copied, text.ByteLength() - copied));
		return out.ToString();
	}

	// A group's number written in decimal; -1 for anything else.
	static int32 GroupNumber(StringView text) {
		if (text.IsEmpty() || text.ByteLength() > 4) return -1;
		int32 number = 0;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			if (text.ByteAt(i) < '0' || text.ByteAt(i) > '9') return -1;
			number = number * 10 + (text.ByteAt(i) - '0');
		}
		return number;
	}

	// `replacement` with $0 to $9, ${n} and ${name} as the groups' texts and $$ as '$'; a '$' that starts none of
	// those is itself.
	void Regex::AppendReplacement(StringBuilder& out, StringView replacement, const RegexMatch& match) const {
		const int64 length = replacement.ByteLength();
		int64 i = 0;
		while (i < length) {
			const int32 c = replacement.ByteAt(i);
			const int32 after = i + 1 < length ? replacement.ByteAt(i + 1) : (int32)-1;
			if (c != '$' || after < 0) {
				out.AppendByte(c);
				i += 1;
			}
			else if (after == '$') {
				out.AppendByte('$');
				i += 2;
			}
			else if (after >= '0' && after <= '9') {
				out.Append(match.Group(after - '0'));
				i += 2;
			}
			else if (after == '{' && replacement.IndexOf('}', i + 2) > i + 2) {
				const int64 close = replacement.IndexOf('}', i + 2);
				const StringView name = replacement.Substring(i + 2, close - i - 2);
				const int32 group = GroupIndex(name) >= 0 ? GroupIndex(name) : GroupNumber(name);
				out.Append(match.Group(group));
				i = close + 1;
			}
			else {
				out.AppendByte(c);
				i += 1;
			}
		}
	}
}
