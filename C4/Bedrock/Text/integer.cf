include "integer.ch"

namespace Core
{
	bool ParseInt64(StringView text, int64& value) {
		const bool negative = text.ByteLength() > 0 && text.ByteAt(0) == '-';
		const int64 first = negative ? 1 : 0;
		if (text.ByteLength() == first) return false;
		const uint64 limit = negative ? (uint64)1 << 63 : ((uint64)1 << 63) - 1;
		uint64 magnitude = 0;
		for (int64 i = first; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			if (c < '0' || c > '9') return false;
			const uint64 digit = (uint64)(c - '0');
			if (magnitude > (limit - digit) / 10) return false;
			magnitude = magnitude * 10 + digit;
		}
		value = negative ? (int64)((uint64)0 - magnitude) : (int64)magnitude;
		return true;
	}
}
