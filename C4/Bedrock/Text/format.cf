include "format.ch"

namespace Core
{
	// One placeholder: the argument it names, its kind letter (0 for none) and width, and how many bytes it spans (0
	// when the text at that position is not a well-formed placeholder).
	struct FormatField {
		public int64 index;
		public int32 kind;
		public int32 width;
		public int64 length;
	}

	int32 FormatDigit(int32 c) { return c >= '0' && c <= '9' ? c - '0' : -1; }

	FormatField ParseFormatField(const char* text, int64 at) {
		FormatField field;
		int64 p = at + 1;
		if (FormatDigit(text[p]) < 0) return field;
		while (FormatDigit(text[p]) >= 0) { field.index = field.index * 10 + FormatDigit(text[p]); p += 1; }
		if (text[p] == ':') {
			field.kind = text[p + 1];
			p += 2;
			if (text[p] == '.') {
				p += 1;
				while (FormatDigit(text[p]) >= 0) { field.width = field.width * 10 + FormatDigit(text[p]); p += 1; }
			}
		}
		if (text[p] != '}') return field;
		field.length = p + 1 - at;
		return field;
	}

	int32 FormatBase(int32 kind) { return kind == 'x' ? 16 : kind == 'b' ? 2 : kind == 'o' ? 8 : 10; }

	// A signed integer in another base is its two's complement bits.
	void AppendFormatInteger(StringBuilder* out, const FormatField& field, const FormatArgument& argument) {
		const int32 base = FormatBase(field.kind);
		if (argument.kind == FormatValue::Signed && base == 10) out->AppendIntBase(argument.integer, 10, field.width);
		else out->AppendUIntBase((uint64)argument.integer, base, field.width);
	}

	void AppendFormatReal(StringBuilder* out, const FormatField& field, const FormatArgument& argument) {
		const bool fixed = field.kind == 'f' || field.kind == 'F';
		if (argument.kind == FormatValue::Float) out->AppendFloat((float)argument.real, fixed ? field.width : -1);
		else out->AppendDouble(argument.real, fixed ? field.width : -1);
	}

	void AppendFormatArgument(StringBuilder* out, const FormatField& field, const FormatArgument& argument) {
		switch (argument.kind) {
			case FormatValue::Signed: AppendFormatInteger(out, field, argument); break;
			case FormatValue::Unsigned: AppendFormatInteger(out, field, argument); break;
			case FormatValue::Float: AppendFormatReal(out, field, argument); break;
			case FormatValue::Double: AppendFormatReal(out, field, argument); break;
			case FormatValue::Text: out->Append(argument.text); break;
			case FormatValue::Bool: out->Append(argument.integer != 0 ? "true" : "false"); break;
			case FormatValue::Char: out->AppendByte((int32)argument.integer); break;
		}
	}

	void FormatArguments(StringBuilder* out, const char* format, const FormatArgument* arguments, int64 count) {
		int64 i = 0;
		while (format[i] != (char)0) {
			const int32 c = format[i];
			const bool doubled = (c == '{' || c == '}') && format[i + 1] == c;
			const FormatField field = c == '{' && !doubled ? ParseFormatField(format, i) : FormatField();
			if (field.length > 0 && field.index < count) {
				AppendFormatArgument(out, field, arguments[field.index]);
				i += field.length;
				continue;
			}
			out->AppendByte(c);
			i += doubled ? 2 : 1;
		}
	}
}
