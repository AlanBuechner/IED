include "thread.ch"

[link("c4_thread_sleep_fallbacks")] int64 c4_thread_sleep_fallbacks() noexcept;

namespace Threading
{
	// Room for any name SetCurrentName gives in a debugger's thread list.
	const int32 kLongestThreadName = 1024;

	Core::String Thread::CurrentName() {
		char[kLongestThreadName] name;
		const int32 length = thread_name(&name[0], kLongestThreadName);
		return Core::String(length > 0 ? &name[0] : "");
	}

	// The body lives in a managed box the new thread holds; the runtime keeps it alive until the thread does.
	class ThreadBody { public func<void()> run; }

	Thread Thread::Run(func<void()> body) {
		ThreadBody* box = new ThreadBody;
		box->run = body;
		Thread thread;
		thread.handle = thread_start(RunBody, (void*)box);
		return thread;
	}

	void Thread::RunBody(void* body) { ((ThreadBody*)body)->run(); }

	int64 Thread::SleepFallbacks() { return c4_thread_sleep_fallbacks(); }

	void Thread::Join() {
		if (!handle) return;
		thread_join(handle);
		handle = nullptr;
	}

	void Thread::Detach() {
		if (!handle) return;
		thread_detach(handle);
		handle = nullptr;
	}
}
