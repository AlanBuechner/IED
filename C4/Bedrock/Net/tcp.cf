include "tcp.ch"
include "sockets.ch"
include "tlsruntime.ch"

namespace Net
{
	// --- TcpStream ------------------------------------------------------------------------------------------------------

	TcpStream TcpStream::Connect(const Address& to, int32 timeoutMs) {
		TcpStream stream;
		char[kErrorBytes] why;
		const int64 socket = stream.last.Record(c4_net_tcp_connect(&to, timeoutMs, &why[0], kErrorBytes), &why[0]);
		if (socket >= 0) stream.slot = socket + 1;
		return stream;
	}

	TcpStream TcpStream::FromSocket(int64 socket) {
		TcpStream stream;
		if (socket >= 0) stream.slot = socket + 1;
		return stream;
	}

	// --- TLS --------------------------------------------------------------------------------------------------------------

	// Open and not secured yet; else false, with why.
	bool TcpStream::CanSecure() {
		if (!IsOpen()) last.Fail("the stream is closed");
		else if (IsSecure()) last.Fail("the stream is already secured");
		return IsOpen() && !IsSecure();
	}

	// A handshake's session taken on; the stream closed when there is none.
	bool TcpStream::Secured(int64 session) {
		if (session < 0) {
			Close();
			return false;
		}
		tls = session + 1;
		return true;
	}

	bool TcpStream::StartTls(const TlsClientOptions& options, int32 timeoutMs) {
		if (!CanSecure()) return false;
		TlsClientRecord record;
		record.hostName = options.hostName.CStr();
		record.extraRoots = (const void*)options.extraRoots.Data();
		record.extraRootsSize = options.extraRoots.Count();
		char[kErrorBytes] why;
		return Secured(last.Record(c4_tls_connect(Socket(), &record, timeoutMs, &why[0], kErrorBytes), &why[0]));
	}

	bool TcpStream::AcceptTls(const TlsIdentity& identity, int32 timeoutMs) {
		if (!CanSecure()) return false;
		char[kErrorBytes] why;
		return Secured(last.Record(c4_tls_accept(Socket(), identity.Handle(), timeoutMs, &why[0], kErrorBytes), &why[0]));
	}

	TlsVersion TcpStream::SecureVersion() const { return IsSecure() ? (TlsVersion)c4_tls_version(Session()) : TlsVersion::None; }

	// --- sending and receiving ----------------------------------------------------------------------------------------------

	int64 TcpStream::Send(const void* bytes, int64 count, int32 timeoutMs) {
		if (!IsOpen()) return last.Fail("the stream is closed");
		char[kErrorBytes] why;
		if (IsSecure()) return last.Record(c4_tls_send(Session(), bytes, count, timeoutMs, &why[0], kErrorBytes), &why[0]);
		return last.Record(c4_net_send(Socket(), bytes, count, nullptr, timeoutMs, &why[0], kErrorBytes), &why[0]);
	}

	bool TcpStream::SendAll(const void* bytes, int64 count, int32 timeoutMs) {
		if (!IsOpen()) {
			last.Fail("the stream is closed");
			return false;
		}
		const uint8* next = (const uint8*)bytes;
		int64 left = count;
		while (left > 0) {
			const int64 sent = Send((const void*)next, left, timeoutMs);
			if (sent <= 0) return false;
			next = next + sent;
			left -= sent;
		}
		return true;
	}

	int64 TcpStream::Receive(void* buffer, int64 capacity, int32 timeoutMs) {
		if (!IsOpen()) return last.Fail("the stream is closed");
		char[kErrorBytes] why;
		if (IsSecure()) return last.Record(c4_tls_receive(Session(), buffer, capacity, timeoutMs, &why[0], kErrorBytes), &why[0]);
		return last.Record(c4_net_receive(Socket(), buffer, capacity, nullptr, timeoutMs, &why[0], kErrorBytes), &why[0]);
	}

	bool TcpStream::ReceiveAll(void* buffer, int64 count, int32 timeoutMs) {
		if (!IsOpen()) {
			last.Fail("the stream is closed");
			return false;
		}
		uint8* next = (uint8*)buffer;
		int64 left = count;
		while (left > 0) {
			const int64 received = Receive((void*)next, left, timeoutMs);
			if (received == 0) last.Fail("the connection closed before every byte arrived");
			if (received <= 0) return false;
			next = next + received;
			left -= received;
		}
		return true;
	}

	bool TcpStream::SetNoDelay(bool on) { return IsOpen() && c4_net_set_no_delay(Socket(), on ? 1 : 0) == 0; }

	void TcpStream::Shutdown(Net::Shutdown side) {
		if (!IsOpen()) return;
		if (IsSecure() && side == Net::Shutdown::Send) c4_tls_close_notify(Session());
		c4_net_shutdown(Socket(), (int32)side);
	}

	Address TcpStream::LocalAddress() const { return LocalAddressOf(Socket()); }
	Address TcpStream::PeerAddress() const { return PeerAddressOf(Socket()); }

	void TcpStream::Close() {
		if (tls != 0) {
			c4_tls_close_notify(Session());
			c4_tls_free(Session());
		}
		if (slot != 0) c4_net_close(Socket());
		tls = 0;
		slot = 0;
	}

	// --- TcpListener ----------------------------------------------------------------------------------------------------

	bool TcpListener::Listen(const Address& at, int32 backlog) {
		Close();
		char[kErrorBytes] why;
		const int64 socket = last.Record(c4_net_tcp_listen(&at, backlog, &why[0], kErrorBytes), &why[0]);
		if (socket < 0) return false;
		slot = socket + 1;
		return true;
	}

	TcpStream TcpListener::Accept(int32 timeoutMs) {
		if (!IsOpen()) {
			last.Fail("the listener is not listening");
			return TcpStream();
		}
		char[kErrorBytes] why;
		return TcpStream::FromSocket(last.Record(c4_net_tcp_accept(Socket(), timeoutMs, nullptr, &why[0], kErrorBytes), &why[0]));
	}

	Address TcpListener::LocalAddress() const { return LocalAddressOf(Socket()); }

	void TcpListener::Close() {
		if (slot != 0) c4_net_close(Socket());
		slot = 0;
	}
}
