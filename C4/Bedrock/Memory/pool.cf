include "pool.ch"

namespace GC
{
	// The runtime's c4_gc_pool_desc.
	struct PoolDesc
	{
		public uint64 slotSize;
		public uint64 slotCount;
		public bool noscan;
		public bool keepAll;
		public funcptr<bool(void*, void*)> keep;
		public funcptr<void(void*, void*)> release;
		public void* userData;
	}

	[link("c4_gc_pool_create")] void* PoolCreate(const PoolDesc* desc);
	[link("c4_gc_pool_destroy")] void PoolDestroy(void* pool);
	[link("c4_gc_pool_base")] uint8* PoolBase(void* pool);
	[link("c4_gc_pool_slot_size")] uint64 PoolSlotSize(void* pool);
	[link("c4_gc_pool_occupy")] bool PoolOccupy(void* pool, void* object);
	[link("c4_gc_pool_vacate")] bool PoolVacate(void* pool, void* object);
	[link("c4_gc_pool_occupied")] bool PoolOccupied(void* pool, const void* object);

	static bool KeepThroughOptions(void* user, void* object) { return ((PoolState*)user)->options.keep(object); }

	static void FreeAndTell(void* user, void* object) {
		PoolState* state = (PoolState*)user;
		if (!state->handle) return;   // closed while the release was on its way
		int64 slot = ((int64)object - (int64)PoolBase(state->handle)) / state->slotBytes;
		{
			Threading::LockGuard guard(state->mutex);
			state->free.Push(slot);
		}
		if (state->options.released) state->options.released(object);
	}

	void Pool::Open(int64 slotBytes, int64 count, PoolOptions options) {
		if (slotBytes <= 0 || count <= 0) return;
		PoolState* shared = new PoolState();
		shared->options = options;
		PoolDesc desc;
		desc.slotSize = (uint64)slotBytes;
		desc.slotCount = (uint64)count;
		desc.noscan = options.noscan;
		desc.keepAll = options.keepAll;
		if (options.keep) desc.keep = KeepThroughOptions;
		desc.release = FreeAndTell;
		desc.userData = (void*)shared;
		shared->handle = PoolCreate(&desc);
		if (!shared->handle) return;
		shared->slotBytes = (int64)PoolSlotSize(shared->handle);
		shared->count = count;
		state = shared;
	}

	int64 Pool::FreeSlot() {
		Threading::LockGuard guard(state->mutex);
		if (!state->free.IsEmpty()) return state->free.Pop();
		if (state->fresh == state->count) return -1;
		state->fresh += 1;
		return state->fresh - 1;
	}

	void* Pool::Take() {
		if (!state) return nullptr;
		int64 slot = FreeSlot();
		if (slot < 0 && !state->options.keepAll) {
			Collect();   // ends what nothing reaches; its slots come back through FreeAndTell
			slot = FreeSlot();
		}
		if (slot < 0) return nullptr;
		void* object = At(slot);
		memset(object, 0, (uint64)state->slotBytes);
		PoolOccupy(state->handle, object);
		return object;
	}

	void Pool::Give(void* object) {
		if (!Holds(object)) return;
		PoolVacate(state->handle, object);
		Threading::LockGuard guard(state->mutex);
		state->free.Push(IndexOf(object));
	}

	bool Pool::Holds(const void* object) const { return state != nullptr && PoolOccupied(state->handle, object); }

	void* Pool::At(int64 index) const {
		if (!state || index < 0 || index >= state->count) return nullptr;
		return (void*)(PoolBase(state->handle) + index * state->slotBytes);
	}

	int64 Pool::IndexOf(const void* object) const {
		if (!state) return -1;
		int64 offset = (int64)object - (int64)PoolBase(state->handle);
		if (offset < 0 || offset % state->slotBytes != 0 || offset / state->slotBytes >= state->count) return -1;
		return offset / state->slotBytes;
	}

	void Pool::Close() {
		if (!state) return;
		PoolDestroy(state->handle);
		state->handle = nullptr;
		state = nullptr;
	}
}
