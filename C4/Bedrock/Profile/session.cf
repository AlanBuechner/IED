include "session.ch"
include "collector.ch"
include "Platform/time.ch"
include "Platform/system.ch"
include "Memory/gc.ch"

namespace Profile
{
	const int32 kStateUnknown = 0;
	const int32 kStateOff = 1;
	const int32 kStateOn = 2;
	const int64 kFrequencyProbeNs = 20000000;

	int32 g_state = 0;
	Session* g_session = null;
	int64 g_sessions = 0;
	thread_local EventBuffer* t_buffer = null;
	thread_local int64 t_bufferSession = 0;

	int64 Now() {
		uint64 low;
		uint64 high;
		asm(nomem, nostack) {
			"rdtsc";
			out("eax") low;
			out("edx") high;
		}
		return (int64)((high << 32) | low);
	}

	GC::AllocCounts Less(GC::AllocCounts a, GC::AllocCounts b) {
		GC::AllocCounts counts;
		counts.objects = a.objects - b.objects;
		counts.bytes = a.bytes - b.bytes;
		counts.nativeBytes = a.nativeBytes - b.nativeBytes;
		return counts;
	}

	void ProfilerWork::Init() {
		if (t_workDepth == 0) before = GC::ThreadAllocated();
		t_workDepth += 1;
	}

	void ProfilerWork::Delete() {
		t_workDepth -= 1;
		if (t_workDepth != 0) return;
		const GC::AllocCounts took = Less(GC::ThreadAllocated(), before);
		t_profilerTook.objects += took.objects;
		t_profilerTook.bytes += took.bytes;
		t_profilerTook.nativeBytes += took.nativeBytes;
	}

	void EventBuffer::Timed(Event type, int64 ticks) {
		PutEvent(bytes, type);
		PutZigzag(bytes, ticks - last);
		last = ticks;
	}

	uint64 Session::Intern(Core::StringView text) {
		if (text.IsEmpty()) return 0;
		uint64 id;
		if (strings.TryGet(Core::String(text), id)) return id;
		id = Once(text);
		strings.Insert(Core::String(text), id);
		return id;
	}

	uint64 Session::Once(Core::StringView text) {
		nextString += 1;
		Threading::LockGuard held(global.lock);
		PutEvent(global.bytes, Event::StringDef);
		PutVarint(global.bytes, nextString);
		PutText(global.bytes, text);
		return nextString;
	}

	bool Session::Send(const Core::Array<uint8>& bytes) {
		if (bytes.IsEmpty()) return true;
		if (stream) return stream->SendAll((const void*)bytes.Data(), bytes.Count(), kSendWaitMs);
		return file && file->Write((const void*)bytes.Data(), bytes.Count()) == bytes.Count();
	}

	// --- Threads --------------------------------------------------------------------------------------------------

	// Marks the thread's buffer ended when the thread exits, so the flusher drops it once it is empty.
	struct ThreadEnd
	{
		[operator("delete")] public void Delete() {
			if (t_buffer) atomic_store(&t_buffer->ended, 1, MemoryOrder::Release);
		}

		public int32 armed;
	}

	thread_local ThreadEnd t_end;

	// A thread the system knows by a name (Thread::SetCurrentName, a debugger's) starts with that name in the profiler.
	static void NameFromSystem(Session* session, EventBuffer* buffer) {
		Core::String name = Threading::Thread::CurrentName();
		if (name.IsEmpty()) return;
		uint64 text;
		{
			Threading::LockGuard held(session->lock);
			text = session->Intern(name.View());
		}
		const int64 now = Now();
		Threading::LockGuard held(buffer->lock);
		buffer->Timed(Event::ThreadName, now);
		PutVarint(buffer->bytes, text);
	}

	EventBuffer* ThreadBuffer(Session* session) {
		if (t_buffer && t_bufferSession == session->number) return t_buffer;
		EventBuffer* buffer = new EventBuffer();
		buffer->bytes.Reserve(kThreadBufferBytes);
		buffer->last = session->startTicks;
		buffer->base = session->startTicks;
		{
			Threading::LockGuard held(session->lock);
			session->nextThread += 1;
			buffer->thread = session->nextThread;
			session->threads.Push(buffer);
			session->threadOfSystem.Insert(Threading::Thread::CurrentId(), buffer->thread);
			Threading::LockGuard global(session->global.lock);
			PutEvent(session->global.bytes, Event::ThreadDef);
			PutVarint(session->global.bytes, buffer->thread);
			PutVarint(session->global.bytes, Threading::Thread::CurrentId());
			PutVarint(session->global.bytes, 0);
		}
		t_buffer = buffer;
		t_bufferSession = session->number;
		t_end.armed = 1;
		NameFromSystem(session, buffer);
		return buffer;
	}

	// --- Flushing -------------------------------------------------------------------------------------------------

	static void QueueCalibration(Session* session, int64 now) {
		Threading::LockGuard held(session->global.lock);
		PutEvent(session->global.bytes, Event::Calibration);
		PutVarint(session->global.bytes, (uint64)now);
		PutVarint(session->global.bytes, (uint64)Platform::UnixTimeNs());
	}

	void QueueAllocCount(Session* session, GC::AllocCounts counts, int64 now) {
		Threading::LockGuard held(session->global.lock);
		session->global.Timed(Event::AllocCount, now);
		PutVarint(session->global.bytes, counts.objects);
		PutVarint(session->global.bytes, counts.bytes);
	}

	static void QueueHeapPlot(Session* session, int64 now) {
		const GC::Stats stats = GC::GetStats();
		const GC::AllocCounts allocated = GC::Allocated();
		const Platform::ProcessMemory process = Platform::GetProcessMemory();
		{
			Threading::LockGuard held(session->global.lock);
			session->global.Timed(Event::PlotValue, now);
			PutVarint(session->global.bytes, session->heapPlot);
			PutDouble(session->global.bytes, (double)(stats.heapBytes - stats.freeBytes));
			session->global.Timed(Event::PlotValue, now);
			PutVarint(session->global.bytes, session->processPlot);
			PutDouble(session->global.bytes, (double)process.privateBytes);
			session->global.Timed(Event::PlotValue, now);
			PutVarint(session->global.bytes, session->nativePlot);
			PutDouble(session->global.bytes, (double)stats.nativeBytes);
		}
		QueueAllocCount(session, allocated, now);
	}

	// A memory plot the session keeps itself (kind 1, bytes).
	static void DefineMemoryPlot(Session* session, uint64 id, const char* name) {
		Threading::LockGuard held(session->lock);
		const uint64 text = session->Intern(Core::StringView(name));
		Threading::LockGuard global(session->global.lock);
		PutEvent(session->global.bytes, Event::PlotDef);
		PutVarint(session->global.bytes, id);
		PutVarint(session->global.bytes, text);
		PutVarint(session->global.bytes, 1);
		PutVarint(session->global.bytes, 0);
	}

	static void QueuePeriodic(Session* session) {
		const int64 now = Now();
		const int64 perSecond = session->frequency;
		if (now - session->lastCalibration >= perSecond * kCalibrateEveryNs / kNsPerSecond) {
			session->lastCalibration = now;
			QueueCalibration(session, now);
		}
		if (now - session->lastHeapPlot >= perSecond / (kNsPerSecond / kHeapPlotEveryNs)) {
			session->lastHeapPlot = now;
			QueueHeapPlot(session, now);
		}
	}

	// Takes a buffer's events (the lock held only while it swaps them); false when it had none. The flusher reserves the
	// room for the next round itself, so that native memory is counted on its thread, not in the zones of the writer.
	static bool Take(EventBuffer* buffer, Core::Array<uint8>& bytes, int64& base) {
		Threading::LockGuard held(buffer->lock);
		if (buffer->bytes.IsEmpty()) return false;
		buffer->bytes.Swap(bytes);
		buffer->bytes.Reserve(bytes.Count());
		base = buffer->base;
		buffer->base = buffer->last;
		return true;
	}

	// One round: every thread's events, then the global ones, sent global first. False when sending failed.
	static bool FlushOnce(Session* session) {
		QueuePeriodic(session);
		QueueAllocSamples(session);
		Core::Array<EventBuffer*> buffers;
		{
			Threading::LockGuard held(session->lock);
			buffers.Append(session->threads);
		}
		Core::Array<uint8> threads;
		for (EventBuffer* buffer : buffers) {
			Core::Array<uint8> body;
			int64 base;
			if (Take(buffer, body, base)) PutChunk(threads, kThreadChunk, buffer->thread, base, body);
		}
		Core::Array<uint8> out;
		Core::Array<uint8> globalBody;
		int64 globalBase;
		if (Take(&session->global, globalBody, globalBase)) PutChunk(out, kGlobalChunk, 0, globalBase, globalBody);
		out.Append(threads);
		const bool sent = session->Send(out);
		Threading::LockGuard held(session->lock);
		for (int64 i = session->threads.Count() - 1; i >= 0; --i) {
			EventBuffer* buffer = session->threads[i];
			if (atomic_load(&buffer->ended, MemoryOrder::Acquire) != 0 && buffer->bytes.IsEmpty()) session->threads.RemoveSwap(i);
		}
		return sent;
	}

	static void FlushLoop(Session* session) {
		while (atomic_load(&session->stopping, MemoryOrder::Acquire) == 0) {
			Threading::Thread::Sleep(kFlushEveryNs);
			if (!FlushOnce(session)) {
				atomic_store(&g_state, kStateOff, MemoryOrder::Release);
				return;
			}
		}
	}

	// --- Starting and stopping ------------------------------------------------------------------------------------

	// Ticks a second of Now(), measured against the system's counter.
	static int64 MeasureFrequency() {
		const int64 ticks0 = Now();
		const int64 counter0 = Platform::Ticks();
		Threading::Thread::Sleep(kFrequencyProbeNs);
		const int64 ticks1 = Now();
		const int64 counter1 = Platform::Ticks();
		const double seconds = (double)(counter1 - counter0) / (double)Platform::TickFrequency();
		return seconds > 0.0 ? (int64)((double)(ticks1 - ticks0) / seconds) : kNsPerSecond;
	}

	static bool Open(Session* session, Core::StringView target, Core::String& token, Core::String& problem) {
		if (target.StartsWith(Core::StringView("file:"))) {
			Core::String path = Core::String(target.Substring(5, target.ByteLength() - 5));
			session->file = new FS::File(path.CStr(), "wb");
			if (!session->file->IsOpen()) problem = Core::String("cannot write ") + path.View();
			return problem.IsEmpty();
		}
		const int64 at = target.IndexOf(Core::StringView(";token="));
		Core::String address = Core::String(at < 0 ? target : target.Substring(0, at));
		if (at >= 0) token = Core::String(target.Substring(at + 7, target.ByteLength() - at - 7));
		Net::Address to = Net::ParseAddress(address.CStr());
		if (!to.IsValid()) {
			problem = Core::String("not an address: ") + address.View();
			return false;
		}
		Net::TcpStream connected = Net::TcpStream::Connect(to, kConnectWaitMs);
		if (!connected.IsOpen()) {
			problem = (Core::String("cannot reach the profiler at ") + address.View()) + ": " + connected.Error();
			return false;
		}
		connected.SetNoDelay(true);
		session->stream = new Net::TcpStream(take(connected));
		return true;
	}

	static Core::Array<uint8> HelloStream(Session* session, Core::StringView app, Core::StringView token) {
		Core::Array<uint8> body;
		PutEvent(body, Event::Hello);
		PutVarint(body, kProtocolVersion);
		PutText(body, app);
		PutVarint(body, Platform::ProcessId());
		PutVarint(body, (uint64)session->frequency);
		PutVarint(body, (uint64)session->startTicks);
		PutVarint(body, (uint64)Platform::UnixTimeNs());
		PutVarint(body, kEstimatedClock);
		PutText(body, token);
		Core::Array<uint8> out;
		PutPreamble(out);
		PutChunk(out, kGlobalChunk, 0, session->startTicks, body);
		return out;
	}

	bool StartSession(Core::StringView target, Core::StringView app, Core::String& problem) {
		if (atomic_load(&g_state, MemoryOrder::Acquire) == kStateOn) {
			problem = Core::String("a profiling session is running");
			return false;
		}
		Session* session = new Session();
		Core::String token;
		if (!Open(session, target, token, problem)) return false;
		g_sessions += 1;
		session->number = g_sessions;
		session->frequency = MeasureFrequency();
		session->startTicks = Now();
		session->global.last = session->startTicks;
		session->global.base = session->startTicks;
		session->lastCalibration = session->startTicks;
		session->lastHeapPlot = session->startTicks;
		if (!session->Send(HelloStream(session, app, token.View()))) {
			problem = Core::String("the profiler closed the connection");
			return false;
		}
		session->nextPlot = 3;
		session->heapPlot = 1;
		session->processPlot = 2;
		session->nativePlot = 3;
		session->global.bytes.Reserve(kThreadBufferBytes);
		DefineMemoryPlot(session, session->heapPlot, "GC heap");
		DefineMemoryPlot(session, session->processPlot, "Process memory");
		DefineMemoryPlot(session, session->nativePlot, "Native memory");
		QueueCalibration(session, session->startTicks);
		g_session = session;
		WatchCollector(session);
		session->flusher = new Threading::Thread(Threading::Thread::Run([session]() { FlushLoop(session); }));
		atomic_store(&g_state, kStateOn, MemoryOrder::Release);
		ObserveJobs(true);
		return true;
	}

	void StopSession() {
		int32 on = kStateOn;
		if (!atomic_compare_exchange(&g_state, &on, kStateOff, MemoryOrder::AcqRel, MemoryOrder::Acquire)) return;
		Session* session = g_session;
		ObserveJobs(false);
		UnwatchCollector(session);
		atomic_store(&session->stopping, 1, MemoryOrder::Release);
		session->flusher->Join();
		FlushOnce(session);
		Core::Array<uint8> body;
		PutEvent(body, Event::Bye);
		PutVarint(body, 0);
		Core::Array<uint8> bye;
		PutChunk(bye, kGlobalChunk, 0, session->startTicks, body);
		session->Send(bye);
		if (session->stream) session->stream->Close();
		if (session->file) session->file->Close();
	}

	// --- The first use --------------------------------------------------------------------------------------------

	// Reads IED_PROFILER once: a session starts when it names a target, profiling stays off otherwise.
	static void StartFromEnvironment() {
		Core::String target;
		if (!Platform::TryGetEnvironmentVariable("IED_PROFILER", target) || target.IsEmpty()) return;
		Core::String problem;
		FS::Path program = Platform::ExecutablePath();
		StartSession(target.View(), program.Stem(), problem);
	}

	Session* Running() {
		int32 state = atomic_load(&g_state, MemoryOrder::Acquire);
		if (state == kStateOn) return g_session;
		if (state != kStateUnknown) return null;
		int32 unknown = kStateUnknown;
		if (!atomic_compare_exchange(&g_state, &unknown, kStateOff, MemoryOrder::AcqRel, MemoryOrder::Acquire)) return null;
		StartFromEnvironment();
		return atomic_load(&g_state, MemoryOrder::Acquire) == kStateOn ? g_session : null;
	}

	// Sends what is left when the program ends.
	struct ProgramEnd
	{
		[operator("delete")] public void Delete() { StopSession(); }
	}

	ProgramEnd g_programEnd;
}
