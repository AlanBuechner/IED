// Reflected annotations (D-42): every annotation the compiler does not act on, with its arguments folded - as the declaration
// it takes has them (D-87): an integer for a double is a double, a default left out is there.

include "bedrock.ch"

// Declared in the global namespace, so the uses below name them alone; [Script::Callable] is named by its namespace.
annotation Serialize on type;
annotation Range(int64 min, int64 max) on type, field;
annotation Range(double min, double max) on type, field;
annotation Tooltip(const char* text) on type;
annotation Hidden on field;
annotation Command(const char* name, bool now) on method;
annotation Units(const char* units) on parameter;
annotation Flags on enum;
annotation Setting(const char* name) on variable;
annotation NotZero on parameter;
annotation Tag(int32 tag) on function;
annotation Declared on function;
annotation Defined on function;
annotation Requires(typename component, typename... more) on type;
annotation Holds(typename... types) on type;
annotation Named(const char* name) on type;
annotation Limit(int32 limit) on type;
annotation Of(typename type) on field;
annotation Bind(typename type) on method;
annotation From(typename type) on parameter;
annotation Gauge(double low, double high, double step = 0.25, const char* units = "m") on field;
namespace Script { annotation Callable on function; }

namespace RaLimits { const int32 kMax = 10; }
const float kRaScale = 0.5f;

[Serialize, Range(-1, RaLimits::kMax * 2)] [Tooltip("speed" "\n" "fast")]
struct RaShip {
	[Range(0.0, kRaScale)] public float speed;
	[Hidden] public int32 secret;
	[Command("go", true)] public void Go([Units("m")] float distance) { speed = distance; }
}
[Flags] enum class RaMode { A, B }
[Setting("volume")] float g_raVolume = 1.0f;
[Script::Callable] int32 RaTwice([NotZero] int32 x) { return x * 2; }
[group("ra"), Tag(7)] int32 RaGrouped() { return 1; }
[Declared] int32 RaSplit(int32 a);
[Defined] int32 RaSplit(int32 a) { return a; }

// Types as arguments: qualified, unqualified from the declaration's namespace, a template instance nothing else uses, an
// alias, a builtin, a pointer; a constant name still folds as a constant, and nameof is a string.
namespace RaRender {
	struct RaMesh { public int32 vertices; }
	[Requires(RaMesh)] struct RaRenderer { public int32 pass; }
}
template<T> struct RaBox { public T value; }
alias RaMeshAlias = RaRender::RaMesh;

const char* kRaMeshName = nameof(RaRender::RaMesh);   // a constant now (BUG-463)

[Requires(RaRender::RaMesh, RaBox<int32>), Holds(int32, RaRender::RaMesh*), Named(nameof(RaRender::RaMesh)), Limit(RaLimits::kMax)]
struct RaCollider {
	[Of(RaMeshAlias)] public int32 shape;
	[Bind(RaRender::RaRenderer)] public void Attach([From(RaRender::RaMesh)] int32 id) { shape = id; }
}

struct RaDial {
	[Gauge(0, 10)] public float level;
	[Gauge(1, 2.5, 0.5, "kg")] public float weight;
}

[test("reflect.annotations")]
class ReflectionAnnotationTests {
	[test("type")]
	public static void TestType() {
		Reflection::Type ship = Reflection::FindType("RaShip");
		assert_eq(3, (int32)ship.AnnotationCount(), "Serialize, Range, Tooltip");
		assert_se("Serialize", ship.AnnotationAt(0).Name(), "in source order");
		assert_eq(0, (int32)ship.FindAnnotation("Serialize").ArgCount(), "no arguments");
		Reflection::Annotation range = ship.FindAnnotation("Range");
		assert_true(range.ArgKind(0) == Reflection::AnnotationArg::Int ? 1 : 0, "an integer argument");
		assert_eq(-1, (int32)range.IntArg(0), "a negative literal folds");
		assert_eq(20, (int32)range.IntArg(1), "a qualified constant expression folds");
		assert_se("speed\nfast", ship.FindAnnotation("Tooltip").StringArg(0), "adjacent string literals join");
		assert_true(!ship.FindAnnotation("Missing").IsValid() ? 1 : 0, "a missing name");
	}

	[test("members")]
	public static void TestMembers() {
		Reflection::Type ship = Reflection::FindType("RaShip");
		Reflection::Annotation range = ship.FindField("speed").FindAnnotation("Range");
		assert_true(range.ArgKind(1) == Reflection::AnnotationArg::Float ? 1 : 0, "a float argument");
		assert_true(range.FloatArg(1) == 0.5 ? 1 : 0, "a float constant folds");
		assert_true(ship.FindField("secret").FindAnnotation("Hidden").IsValid() ? 1 : 0, "a field annotation");
		Reflection::Method go = ship.FindMethod("Go");
		Reflection::Annotation command = go.FindAnnotation("Command");
		assert_se("go", command.StringArg(0), "a string argument");
		assert_true(command.ArgKind(1) == Reflection::AnnotationArg::Bool && command.BoolArg(1) ? 1 : 0, "a bool argument");
		assert_se("m", go.ParamAt(0).FindAnnotation("Units").StringArg(0), "a parameter annotation");
	}

	[test("entities")]
	public static void TestEntities() {
		assert_true(Reflection::FindType("RaMode").FindAnnotation("Flags").IsValid() ? 1 : 0, "an enum annotation");
		assert_se("volume", Reflection::FindVariable("g_raVolume").FindAnnotation("Setting").StringArg(0), "a variable annotation");
		Reflection::Function twice = Reflection::FindFunction("RaTwice");
		assert_true(twice.FindAnnotation("Script::Callable").IsValid() ? 1 : 0, "a qualified name as written");
		assert_true(twice.ParamAt(0).FindAnnotation("NotZero").IsValid() ? 1 : 0, "a function parameter annotation");
	}

	[test("compiler_annotations_not_kept")]
	public static void TestCompilerAnnotationsNotKept() {
		Reflection::Function grouped = Reflection::FindFunction("RaGrouped");
		assert_eq(1, (int32)grouped.AnnotationCount(), "only Tag");
		assert_eq(7, (int32)grouped.AnnotationAt(0).IntArg(0), "its argument");
		assert_eq(0, (int32)Reflection::FindType("ReflectionAnnotationTests").AnnotationCount(), "test is the compiler's");
	}

	[test("type_arguments")]
	public static void TestTypeArguments() {
		Reflection::Annotation requires = Reflection::FindType("RaCollider").FindAnnotation("Requires");
		assert_true(requires.ArgKind(0) == Reflection::AnnotationArg::Type ? 1 : 0, "a type argument");
		assert_se("RaRender::RaMesh", requires.StringArg(0), "its name");
		assert_se("RaRender::RaMesh", requires.TypeArg(0).Name(), "and the type it names");
		assert_eq(0, (int32)requires.IntArg(0), "no number");
		assert_se("RaBox<int32>", requires.StringArg(1), "a template instance");
		assert_true(requires.TypeArg(1).IsValid() ? 1 : 0, "made and registered though nothing else uses it");
		assert_eq(4, (int32)requires.TypeArg(1).SizeOf(), "with its layout");
		Reflection::Annotation holds = Reflection::FindType("RaCollider").FindAnnotation("Holds");
		assert_se("int32", holds.StringArg(0), "a builtin");
		assert_true(holds.ArgKind(1) == Reflection::AnnotationArg::Type ? 1 : 0, "a pointer reads as a type alone");
		assert_se("RaRender::RaMesh*", holds.StringArg(1), "its name");
	}

	[test("names_and_constants_beside_types")]
	public static void TestNamesAndConstantsBesideTypes() {
		Reflection::Type collider = Reflection::FindType("RaCollider");
		Reflection::Annotation named = collider.FindAnnotation("Named");
		assert_true(named.ArgKind(0) == Reflection::AnnotationArg::String ? 1 : 0, "nameof is a string (BUG-463)");
		assert_se("RaRender::RaMesh", named.StringArg(0), "the type's name");
		assert_true(!named.TypeArg(0).IsValid() ? 1 : 0, "a string names no type");
		assert_se("RaRender::RaMesh", kRaMeshName, "a const global started by nameof");
		Reflection::Annotation limit = collider.FindAnnotation("Limit");
		assert_true(limit.ArgKind(0) == Reflection::AnnotationArg::Int ? 1 : 0, "a constant's name is the constant");
		assert_eq(10, (int32)limit.IntArg(0), "its value");
	}

	[test("type_arguments_everywhere")]
	public static void TestTypeArgumentsEverywhere() {
		assert_se("RaRender::RaMesh", Reflection::FindType("RaRender::RaRenderer").FindAnnotation("Requires").StringArg(0),
			"an unqualified name, from the declaration's namespace");
		Reflection::Type collider = Reflection::FindType("RaCollider");
		assert_se("RaRender::RaMesh", collider.FindField("shape").FindAnnotation("Of").StringArg(0), "a field's, through an alias");
		Reflection::Method attach = collider.FindMethod("Attach");
		assert_se("RaRender::RaRenderer", attach.FindAnnotation("Bind").StringArg(0), "a method's");
		assert_se("RaRender::RaMesh", attach.ParamAt(0).FindAnnotation("From").TypeArg(0).Name(), "a parameter's");
	}

	[test("declared_kinds_and_defaults")]
	public static void TestDeclaredKindsAndDefaults() {
		Reflection::Annotation level = Reflection::FindType("RaDial").FindField("level").FindAnnotation("Gauge");
		assert_eq(4, (int32)level.ArgCount(), "every parameter, its defaults too");
		assert_true(level.ArgKind(0) == Reflection::AnnotationArg::Float ? 1 : 0, "an integer for a double is a double");
		assert_true(level.FloatArg(1) == 10.0 ? 1 : 0, "its value");
		assert_true(level.FloatArg(2) == 0.25 ? 1 : 0, "a default left out");
		assert_se("m", level.StringArg(3), "a string default");
		Reflection::Annotation weight = Reflection::FindType("RaDial").FindField("weight").FindAnnotation("Gauge");
		assert_true(weight.FloatArg(2) == 0.5 ? 1 : 0, "a default written over");
		assert_se("kg", weight.StringArg(3), "every argument as written");
	}

	[test("declaration_and_definition")]
	public static void TestDeclarationAndDefinition() {
		Reflection::Function split = Reflection::FindFunction("RaSplit");
		assert_eq(2, (int32)split.AnnotationCount(), "the declaration's and the definition's");
		assert_se("Declared", split.AnnotationAt(0).Name(), "declaration first");
		assert_se("Defined", split.AnnotationAt(1).Name(), "then the definition");
	}
}
