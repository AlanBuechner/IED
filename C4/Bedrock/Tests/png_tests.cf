struct PngVector
{
	public const uint8* png;
	public int64 pngBytes;
	public const uint8* rgba;
	public int32 width;
	public int32 height;
}

PngVector Vector(const uint8* png, int64 pngBytes, const uint8* rgba, int32 width, int32 height) {
	PngVector vector;
	vector.png = png;
	vector.pngBytes = pngBytes;
	vector.rgba = rgba;
	vector.width = width;
	vector.height = height;
	return vector;
}

Core::Array<PngVector> Vectors() {
	Core::Array<PngVector> vectors;
	vectors.Push(Vector(&kGray1Png[0], (int64)sizeof(kGray1Png), &kGray1Rgba[0], 5, 3));
	vectors.Push(Vector(&kGray16InterlacedPng[0], (int64)sizeof(kGray16InterlacedPng), &kGray16InterlacedRgba[0], 5, 3));
	vectors.Push(Vector(&kRgb8Png[0], (int64)sizeof(kRgb8Png), &kRgb8Rgba[0], 5, 3));
	vectors.Push(Vector(&kRgb16InterlacedPng[0], (int64)sizeof(kRgb16InterlacedPng), &kRgb16InterlacedRgba[0], 5, 3));
	vectors.Push(Vector(&kPalette2Png[0], (int64)sizeof(kPalette2Png), &kPalette2Rgba[0], 5, 3));
	vectors.Push(Vector(&kPalette8InterlacedPng[0], (int64)sizeof(kPalette8InterlacedPng), &kPalette8InterlacedRgba[0], 17, 9));
	vectors.Push(Vector(&kGrayAlpha8Png[0], (int64)sizeof(kGrayAlpha8Png), &kGrayAlpha8Rgba[0], 5, 3));
	vectors.Push(Vector(&kRgba16Png[0], (int64)sizeof(kRgba16Png), &kRgba16Rgba[0], 5, 3));
	return vectors;
}

bool Holds(const Imaging::Rgba& image, const PngVector& vector) {
	return image.width == vector.width && image.height == vector.height &&
		image.pixels.Count() == (int64)(vector.width * vector.height * 4) &&
		memcmp((void*)image.pixels.Data(), (void*)vector.rgba, (uint64)image.pixels.Count()) == 0;
}

bool Fails(const uint8* data, int64 size, const char* why) {
	Imaging::Rgba image;
	Imaging::ReadResult read = Imaging::DecodePng(data, size, image);
	return !read.ok && read.error != nullptr && Core::StringView(read.error) == Core::StringView(why);
}

void PutBigEndian(Core::Array<uint8>& out, uint32 value) {
	for (int32 shift = 24; shift >= 0; shift -= 8) out.Push((uint8)((value >> (uint32)shift) & 0xffu));
}

void PutChunk(Core::Array<uint8>& out, const char* type, const Core::Array<uint8>& body) {
	PutBigEndian(out, (uint32)body.Count());
	const int64 typeAt = out.Count();
	out.Append((const uint8*)type, 4);
	out.Append(body.Data(), body.Count());
	PutBigEndian(out, Core::Crc32((const void*)(out.Data() + typeAt), body.Count() + 4));
}

// A PNG of one row of `width` pixels: the header's fields, its chunks after IHDR given by the caller.
Core::Array<uint8> Header(uint32 width, uint32 height, uint8 depth, uint8 color) {
	Core::Array<uint8> png;
	const uint8[8] signature = { 137u, 80u, 78u, 71u, 13u, 10u, 26u, 10u };
	png.Append(&signature[0], 8);
	Core::Array<uint8> ihdr;
	PutBigEndian(ihdr, width);
	PutBigEndian(ihdr, height);
	ihdr.Push(depth);
	ihdr.Push(color);
	ihdr.Push(0u);
	ihdr.Push(0u);
	ihdr.Push(0u);
	PutChunk(png, "IHDR", ihdr);
	return png;
}

[test("image.png")]
class PngTests {
	[test("every_kind_reads")]
	public static void TestEveryKindReads() {
		Core::Array<PngVector> vectors = Vectors();
		int32 wrong = 0;
		for (int64 i = 0; i < vectors.Count(); ++i) {
			Imaging::Rgba image;
			Imaging::ReadResult read = Imaging::DecodePng(vectors[i].png, vectors[i].pngBytes, image);
			if (!read.ok || !Holds(image, vectors[i])) wrong++;
		}
		assert_eq(0, wrong, "gray 1 and 16 bits, RGB 8 and 16, palettes of 2 and 8 bits, gray with alpha, RGBA 16, interlaced or not, with tRNS");
	}

	[test("written_reads_back")]
	public static void TestWrittenReadsBack() {
		Core::Array<PngVector> vectors = Vectors();
		int32 wrong = 0;
		for (int64 i = 0; i < vectors.Count(); ++i) {
			Imaging::Rgba image;
			Imaging::DecodePng(vectors[i].png, vectors[i].pngBytes, image);
			for (int32 level = Compression::kStoreLevel; level <= Compression::kBestLevel; level += 3) {
				Core::Array<uint8> png;
				Imaging::EncodePng(image, level, png);
				Imaging::Rgba back;
				if (!Imaging::DecodePng(png.Data(), png.Count(), back).ok || !Holds(back, vectors[i])) wrong++;
			}
		}
		assert_eq(0, wrong, "each image written at four levels reads back the same");
	}

	[test("opaque_writes_rgb")]
	public static void TestOpaqueWritesRgb() {
		Imaging::Rgba image;
		image.width = 3;
		image.height = 2;
		for (int32 i = 0; i < 6; ++i) {
			image.pixels.Push((uint8)(i * 40));
			image.pixels.Push(7u);
			image.pixels.Push(9u);
			image.pixels.Push(255u);
		}
		Core::Array<uint8> opaque;
		Imaging::EncodePng(image, 6, opaque);
		assert_true(opaque[25] == 2u, "every pixel opaque: RGB");
		image.pixels[3] = 128u;
		Core::Array<uint8> translucent;
		Imaging::EncodePng(image, 6, translucent);
		assert_true(translucent[25] == 6u, "one translucent pixel: RGBA");
		Imaging::Rgba back;
		assert_true(Imaging::DecodePng(translucent.Data(), translucent.Count(), back).ok && back.pixels[3] == 128u, "the alpha kept");
	}

	[test("damaged")]
	public static void TestDamaged() {
		Core::Array<uint8> png;
		png.Append(&kRgb8Png[0], (int64)sizeof(kRgb8Png));
		assert_true(Fails(png.Data(), 7, "not a PNG file"), "too short for the signature");
		png[0] = 0u;
		assert_true(Fails(png.Data(), png.Count(), "not a PNG file"), "another signature");
		png[0] = 137u;
		png[20] ^= 1u;
		assert_true(Fails(png.Data(), png.Count(), "a chunk whose CRC does not match"), "a changed header byte");
		png[20] ^= 1u;
		int32 cutsRead = 0;
		for (int64 cut = 0; cut < png.Count(); ++cut) {
			Imaging::Rgba image;
			if (Imaging::DecodePng(png.Data(), cut, image).ok) cutsRead++;
		}
		assert_eq(0, cutsRead, "a file cut anywhere fails");
		Core::Array<uint8> late;
		const uint8[8] signature = { 137u, 80u, 78u, 71u, 13u, 10u, 26u, 10u };
		late.Append(&signature[0], 8);
		Core::Array<uint8> nothing;
		PutChunk(late, "IEND", nothing);
		assert_true(Fails(late.Data(), late.Count(), "a chunk before IHDR"), "no IHDR first");
		Core::Array<uint8> huge = Header(70000u, 70000u, 8u, 6u);
		PutChunk(huge, "IEND", nothing);
		assert_true(Fails(huge.Data(), huge.Count(), "an image of more pixels than Imaging::kMostPixels"), "too many pixels");
		Core::Array<uint8> badDepth = Header(1u, 1u, 3u, 2u);
		PutChunk(badDepth, "IEND", nothing);
		assert_true(Fails(badDepth.Data(), badDepth.Count(), "a color type and bit depth PNG does not have"), "a depth PNG lacks");
	}

	[test("palette_index_past_palette")]
	public static void TestPaletteIndexPastPalette() {
		Core::Array<uint8> png = Header(2u, 1u, 8u, 3u);
		Core::Array<uint8> palette;
		palette.Push(1u);
		palette.Push(2u);
		palette.Push(3u);
		PutChunk(png, "PLTE", palette);
		const uint8[3] row = { 0u, 0u, 1u };   // filter none, index 0, then index 1 of a one-color palette
		Core::Array<uint8> compressed;
		Compression::ZlibCompress(&row[0], 3, 6, compressed);
		PutChunk(png, "IDAT", compressed);
		Core::Array<uint8> nothing;
		PutChunk(png, "IEND", nothing);
		assert_true(Fails(png.Data(), png.Count(), "a palette index past the palette"), "index 1 of one color");
	}
}
