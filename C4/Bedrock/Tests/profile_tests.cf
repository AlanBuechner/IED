// Profile: a session recorded to a trace file (IED_PROFILER=file:...) and read back event by event - the preamble and
// Hello, definitions before their first use, zones on two threads with times that only grow, frames, plots, messages,
// thread renames and the names the system knows, tasks, memory, each stop of a collection, censuses and sampled
// allocations, and Bye; nothing recorded outside a session.

include "bedrock.ch"
include "profile.ch"

// One event of a trace read back: its type, chunk, thread, absolute time, and up to six varint fields (a list: its
// count, then its first value).
struct TracedEvent
{
	public int32 type;
	public int32 chunk;
	public uint64 thread;
	public int64 ticks;
	public uint64[6] fields;
	public double number;
}

class TraceReader
{
	public Core::Array<uint8> bytes;
	public int64 at;

	public uint64 Varint() {
		uint64 value = 0;
		int32 shift = 0;
		while (at < bytes.Count()) {
			const uint64 b = (uint64)bytes[at];
			at += 1;
			value |= (b & 0x7F) << shift;
			if ((b & 0x80) == 0) break;
			shift += 7;
		}
		return value;
	}

	public int64 Zigzag() {
		const uint64 v = Varint();
		return (v & 1) == 0 ? (int64)(v >> 1) : -(int64)(v >> 1) - 1;
	}

	public void Skip(int64 n) { at += n; }
}

// Each event's fields after its type: t a time delta, v a varint, s text, f a double, l a count of varints.
static const char* LayoutOf(int32 type) {
	if (type == 0x01) return "vsvvvvvs";
	if (type == 0x02) return "vv";
	if (type == 0x03) return "v";
	if (type == 0x10) return "vs";
	if (type == 0x11) return "vvvvvv";
	if (type == 0x12) return "vvv";
	if (type == 0x23 || type == 0x24) return "v";
	if (type == 0x27) return "vv";
	if (type == 0x28) return "v";
	if (type == 0x6A) return "tvv";
	if (type == 0x6B) return "tv";
	if (type == 0x6C) return "vvv";
	if (type == 0x81) return "vl";
	if (type == 0x82) return "tvvvv";
	if (type == 0x83) return "vvvv";
	if (type == 0x13 || type == 0x20 || type == 0x31 || type == 0x32 || type == 0x33 || type == 0x40 || type == 0x41 || type == 0x42) return "tv";
	if (type == 0x22) return "t";
	if (type == 0x30) return "tvvv";
	if (type == 0x50) return "vvvv";
	if (type == 0x51) return "tvf";
	if (type == 0x52) return "tvvv";
	if (type == 0x60) return "vv";
	if (type == 0x61) return "tvvvvv";
	if (type == 0x62) return "tvvv";
	if (type == 0x63) return "tv";
	if (type == 0x68) return "tvv";
	if (type == 0x69) return "tvvvvv";
	if (type == 0x70) return "vvv";
	if (type == 0x71 || type == 0x72 || type == 0x73) return "tv";
	return null;
}

static Core::Array<TracedEvent> ReadTrace(const char* path, Core::HashMap<uint64, Core::String>& strings, bool& wellFormed) {
	Core::Array<TracedEvent> events;
	TraceReader r;
	FS::File file = FS::File(path, "rb");
	const int64 size = FS::FileSize(path);
	r.bytes.Resize(size);
	file.ReadAll((void*)r.bytes.Data(), size);
	wellFormed = size >= 8 && r.bytes[0] == (uint8)'I' && r.bytes[3] == (uint8)'1';
	r.at = 8;
	while (wellFormed && r.at + 4 <= r.bytes.Count()) {
		const int64 length = (int64)r.bytes[r.at] | ((int64)r.bytes[r.at + 1] << 8) | ((int64)r.bytes[r.at + 2] << 16) | ((int64)r.bytes[r.at + 3] << 24);
		r.at += 4;
		const int64 end = r.at + length;
		const int32 chunk = (int32)r.bytes[r.at];
		r.at += 1;
		const uint64 thread = r.Varint();
		int64 cursor = (int64)r.Varint();
		while (r.at < end) {
			TracedEvent event;
			event.type = (int32)r.bytes[r.at];
			r.at += 1;
			event.chunk = chunk;
			event.thread = thread;
			const char* layout = LayoutOf(event.type);
			if (!layout) {
				wellFormed = false;
				return events;
			}
			int32 field = 0;
			for (const char* c = layout; *c != (char)0; ++c) {
				if (*c == 't') {
					cursor += r.Zigzag();
					event.ticks = cursor;
				}
				else if (*c == 'v') {
					event.fields[field] = r.Varint();
					field += 1;
				}
				else if (*c == 's') {
					const int64 n = (int64)r.Varint();
					Core::String text = Core::String(Core::StringView((const char*)(r.bytes.Data() + r.at), n));
					r.Skip(n);
					if (event.type == 0x10) strings.Insert(event.fields[0], text);
				}
				else if (*c == 'l') {
					const uint64 n = r.Varint();
					event.fields[field] = n;
					for (uint64 i = 0; i < n; ++i) {
						const uint64 value = r.Varint();
						if (i == 0) event.fields[field + 1] = value;
					}
					field += 2;
				}
				else if (*c == 'f') {
					uint64 bits = 0;
					for (int32 i = 0; i < 8; ++i) bits |= (uint64)r.bytes[r.at + i] << (8 * i);
					r.Skip(8);
					event.number = reinterpret_cast<double>(bits);
				}
			}
			events.Push(event);
		}
		wellFormed = wellFormed && r.at == end;
	}
	return events;
}

static int64 CountOf(const Core::Array<TracedEvent>& events, int32 type) {
	int64 n = 0;
	for (const TracedEvent& e : events)
		if (e.type == type) n += 1;
	return n;
}

static const TracedEvent* First(const Core::Array<TracedEvent>& events, int32 type) {
	for (const TracedEvent& e : events)
		if (e.type == type) return &e;
	return null;
}

// The name a thread had last in the trace ("" for none).
static Core::String NameOn(const Core::Array<TracedEvent>& events, const Core::HashMap<uint64, Core::String>& strings, uint64 thread) {
	Core::String name;
	for (const TracedEvent& e : events)
		if (e.type == 0x13 && e.thread == thread) name = *strings.Find(e.fields[0]);
	return name;
}

// The text of the last event of `type`'s first field.
static Core::String LastName(const Core::Array<TracedEvent>& events, const Core::HashMap<uint64, Core::String>& strings, int32 type) {
	Core::String name;
	for (const TracedEvent& e : events)
		if (e.type == type) name = *strings.Find(e.fields[0]);
	return name;
}

static Core::String TracePath(const char* name) {
	FS::Path folder = FS::Path(Platform::GetEnvironmentVariable("TEMP").View());
	return Core::String((folder / name).View());
}

static void Busy() {
	int64 sum = 0;
	for (int64 i = 0; i < 1000; ++i) sum += i;
	assert_true(sum > 0, "work");
}

static Profile::Site s_update = Profile::Site("Update", "game.cf", 12);
static Core::String s_systemName;
static Profile::Mutex s_queue = Profile::Mutex("Queue", "game.cf", 30);
static int32 s_waiting = 0;

// 64 bytes the allocation test makes a hundred of, kept alive until it has read the trace.
class Blob
{
	public int64[8] payload;
}

static Blob*[101] s_blobs;

// Two megabytes in blobs, so the sampler takes about thirty of them here.
static void AllocateMany() {
	for (int32 i = 0; i < 32768; ++i) s_blobs[i % 101] = new Blob();
}

// The session's id of the calling thread, from its ThreadDef (0 when it has none).
static uint64 SessionIdOf(const Core::Array<TracedEvent>& events, uint64 systemId) {
	for (const TracedEvent& e : events)
		if (e.type == 0x12 && e.fields[1] == systemId) return e.fields[0];
	return 0;
}

static void TakeQueue() {
	atomic_store(&s_waiting, 1, MemoryOrder::Release);
	Profile::MutexGuard held(s_queue);
	Busy();
}

static void RecordWorker() {
	Profile::SetThreadName(Core::StringView("Worker"));
	for (int32 i = 0; i < 3; ++i) {
		Profile::Zone zone(Core::StringView("Job"));
		Busy();
	}
}

[test("profile")]
class ProfileTests {
	[test("records_every_kind_of_event_to_a_file")]
	public static void TestRecordsToFile() {
		Core::String path = TracePath("bedrock-profile-test.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "a session to a file starts");
		assert_true(Profile::IsActive(), "and is active");
		Profile::SetThreadName(Core::StringView("Main"));
		{
			Profile::Zone outer(s_update);
			outer.Text(Core::StringView("bodies=12"));
			outer.Value(42);
			{
				PROFILE_ZONE("Inner");
				Busy();
			}
		}
		Profile::Frame();
		Profile::Plot(Core::StringView("Entities"), 3.5);
		Profile::Message(Core::StringView("loaded"), Profile::Severity::Warning);
		const uint64 task = Profile::TaskBegin(Core::StringView("Physics"));
		Profile::TaskSuspend(task);
		Profile::TaskResume(task);
		Profile::TaskEnd(task);
		int32 block = 0;
		Profile::PoolName(3, Core::StringView("Arena"));
		Profile::Alloc((const void*)&block, 64, 3);
		Profile::Free((const void*)&block, 3);
		Threading::Thread worker = Threading::Thread::Run([]() { RecordWorker(); });
		worker.Join();
		GC::Collect();
		Profile::Stop();
		assert_true(!Profile::IsActive(), "stopped");

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "every chunk reads whole");
		assert_true(events.Count() > 0 && events[0].type == 0x01, "Hello first");
		assert_true((events[0].fields[5] & 1) == 1, "the client says it estimated its clock");
		assert_true(events[0].fields[2] > 100000000, "and measured its frequency (two reads of the counter around a sleep differ)");
		assert_true(events.Back().type == 0x03, "Bye last");
		assert_eq(2, CountOf(events, 0x12), "a ThreadDef for each thread");
		assert_eq(5, CountOf(events, 0x20), "every zone began");
		assert_eq(5, CountOf(events, 0x22), "and ended");
		assert_true(LastName(events, strings, 0x13) == "Worker", "the worker named last on its thread");
		assert_true(NameOn(events, strings, First(events, 0x20)->thread) == "Main", "the main thread named");
		assert_eq(1, CountOf(events, 0x40), "the frame");
		uint64 entities = 0;
		for (const TracedEvent& e : events)
			if (e.type == 0x50 && *strings.Find(e.fields[1]) == "Entities") entities = e.fields[0];
		bool plotted = false;
		for (const TracedEvent& e : events)
			if (e.type == 0x51 && e.fields[0] == entities && e.number == 3.5) plotted = true;
		assert_true(entities != 0 && plotted, "the plot and its value");
		bool processPlotted = false;
		for (const TracedEvent& e : events)
			if (e.type == 0x50 && *strings.Find(e.fields[1]) == "Process memory" && e.fields[2] == 1) processPlotted = true;
		bool nativePlotted = false;
		for (const TracedEvent& e : events)
			if (e.type == 0x50 && *strings.Find(e.fields[1]) == "Native memory" && e.fields[2] == 1) nativePlotted = true;
		assert_true(CountOf(events, 0x50) >= 4 && processPlotted && nativePlotted, "the GC heap, the process's memory and the native memory are plotted too");
		const TracedEvent* message = First(events, 0x52);
		assert_true(message && message->fields[0] == 3 && *strings.Find(message->fields[1]) == "loaded", "the message, its severity and text");
		assert_true(CountOf(events, 0x30) == 1 && CountOf(events, 0x32) == 1 && CountOf(events, 0x33) == 1 && CountOf(events, 0x31) == 1, "the task's life");
		assert_true(CountOf(events, 0x61) == 1 && CountOf(events, 0x62) == 1 && CountOf(events, 0x60) == 1, "the pool, an allocation and its free");
		assert_true(CountOf(events, 0x68) >= 1 && CountOf(events, 0x69) >= 1, "the collection");
		const TracedEvent* text = First(events, 0x23);
		assert_true(text && *strings.Find(text->fields[0]) == "bodies=12", "the zone's text");
		assert_true(First(events, 0x24)->fields[0] == 42, "and its value");
		FS::RemoveFile(path.CStr());
	}

	[test("threads_named_by_the_system_and_each_collection_stop")]
	public static void TestSystemNamesAndStops() {
		Core::String path = TracePath("bedrock-profile-system.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		Threading::Thread loader = Threading::Thread::Run([]() {
			Threading::Thread::SetCurrentName("Loader");
			Profile::Zone zone(Core::StringView("Load"));
			Busy();
		});
		loader.Join();
		Threading::Thread renamed = Threading::Thread::Run([]() {
			Profile::SetThreadName(Core::StringView("Renamed"));
			s_systemName = Threading::Thread::CurrentName();
		});
		renamed.Join();
		GC::Collect();
		GC::Pause[16] stops;
		const int32 stopCount = GC::LastPauses(&stops[0], 16);
		Profile::Stop();
		assert_true(s_systemName == "Renamed", "the profiler's thread name is the system's too");

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		const TracedEvent* load = First(events, 0x20);
		assert_true(load && NameOn(events, strings, load->thread) == "Loader", "a thread the system named starts with that name");
		assert_true(stopCount >= 1, "the collection stopped the program");
		assert_eq((int64)stopCount, CountOf(events, 0x68), "a GcBegin for each stop");
		assert_eq((int64)stopCount, CountOf(events, 0x69), "and a GcEnd");
		const int64 startTicks = (int64)events[0].fields[3];
		const int64 frequency = (int64)events[0].fields[2];
		bool ordered = true;
		int64 begin = 0;
		for (const TracedEvent& e : events) {
			if (e.type == 0x68) begin = e.ticks;
			if (e.type == 0x69 && (begin < startTicks || e.ticks < begin || e.ticks - begin > frequency)) ordered = false;
		}
		assert_true(ordered, "each stop begins after the session started, ends after it begins, and lasts under a second");
		FS::RemoveFile(path.CStr());
	}

	[test("a_mutex_records_its_waits_and_holds")]
	public static void TestMutex() {
		Core::String path = TracePath("bedrock-profile-locks.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		s_queue.Lock();
		Threading::Thread waiter = Threading::Thread::Run([]() { TakeQueue(); });
		while (atomic_load(&s_waiting, MemoryOrder::Acquire) == 0) Threading::Thread::Sleep(1000000);
		Threading::Thread::Sleep(20000000);
		s_queue.Unlock();
		waiter.Join();
		assert_true(s_queue.TryLock(), "a free mutex is taken without waiting");
		s_queue.Unlock();
		Profile::Stop();

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		const TracedEvent* def = First(events, 0x70);
		assert_true(def && *strings.Find(def->fields[1]) == "Queue" && def->fields[2] != 0, "the lock defined with its name and site");
		assert_eq(1, CountOf(events, 0x71), "only the waiter waited");
		assert_eq(3, CountOf(events, 0x72), "three holds");
		assert_eq(3, CountOf(events, 0x73), "each released");
		const TracedEvent* wait = First(events, 0x71);
		int64 obtained = -1;
		int64 releasedFirst = -1;
		for (const TracedEvent& e : events) {
			if (e.fields[0] != def->fields[0] * 2) continue;
			if (e.type == 0x72 && e.thread == wait->thread) obtained = e.ticks;
			if (e.type == 0x73 && e.thread != wait->thread && releasedFirst < 0) releasedFirst = e.ticks;
		}
		assert_true(wait->ticks < obtained && releasedFirst <= obtained, "the waiter got the lock only once the main thread let it go");
		FS::RemoveFile(path.CStr());
	}

	[test("zones_and_frames_count_what_is_allocated")]
	public static void TestAllocations() {
		Core::String path = TracePath("bedrock-profile-allocations.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		Profile::Frame();
		{
			Profile::Zone outer(Core::StringView("Outer"));
			{
				Profile::Zone inner(Core::StringView("Inner"));
				for (int32 i = 0; i < 100; ++i) s_blobs[i] = new Blob();
			}
			s_blobs[100] = new Blob();
		}
		{
			Profile::Zone quiet(Core::StringView("Quiet"));
		}
		{
			Profile::Zone grow(Core::StringView("Grow"));
			Core::Array<uint8> grown;
			grown.Resize(65536);
		}
		{
			Profile::Zone collects(Core::StringView("Collects"));
			GC::Collect();
		}
		Profile::Frame();
		Profile::Stop();

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		Core::Array<const TracedEvent*> counted;
		for (const TracedEvent& e : events)
			if (e.type == 0x27) counted.Push(&e);
		assert_eq(2, counted.Count(), "Inner and Outer said what they allocated; Quiet allocated nothing and said nothing");
		assert_true(counted[0]->fields[0] == 100 && counted[0]->fields[1] == 100 * 64, "Inner's hundred blobs, exactly: the profiler's own work in it is left out");
		assert_true(counted[1]->fields[0] == 101 && counted[1]->fields[1] == 101 * 64, "Outer's include Inner's and its own, not what the profiler took to name Inner");
		assert_eq(1, CountOf(events, 0x28), "only Grow took native memory: the profiler's own buffers, and the census its collection callback read on the collecting thread, are not the zones'");
		assert_true(First(events, 0x28)->fields[0] >= 65536, "Grow's array, 64 KiB");
		int64 frameCounts = 0;
		uint64 first = 0;
		uint64 last = 0;
		for (const TracedEvent& e : events) {
			if (e.type != 0x6A) continue;
			if (frameCounts == 0) first = e.fields[0];
			last = e.fields[0];
			frameCounts += 1;
		}
		assert_true(frameCounts >= 2, "each frame came with the process's count");
		assert_true(last >= first + 101, "the count grew by what the zones allocated");
		for (int32 i = 0; i <= 100; ++i) s_blobs[i] = null;
		FS::RemoveFile(path.CStr());
	}

	[test("a_census_of_live_objects_after_each_collection")]
	public static void TestCensus() {
		Core::String path = TracePath("bedrock-profile-census.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		for (int32 i = 0; i < 100; ++i) s_blobs[i] = new Blob();
		GC::Collect();
		Profile::Stop();
		assert_true(!GC::SetCensus(false), "the census is off again once the session stopped");

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		const TracedEvent* census = First(events, 0x6B);
		assert_true(census != null && census->fields[0] >= 1, "the collection's census, with its types");
		int64 lines = 0;
		uint64 blobs = 0;
		uint64 blobBytes = 0;
		bool unknownNamed = false;
		for (int64 i = 0; i < events.Count(); ++i) {
			if (&events[i] == census) {
				for (int64 k = 1; k <= (int64)census->fields[0]; ++k) {
					const TracedEvent& line = events[i + k];
					if (line.type != 0x6C) continue;
					lines += 1;
					if (*strings.Find(line.fields[0]) == "Blob") {
						blobs = line.fields[1];
						blobBytes = line.fields[2];
					}
					if (*strings.Find(line.fields[0]) == "(type not known)") unknownNamed = true;
				}
				break;
			}
		}
		assert_eq((int64)census->fields[0], lines, "one line a type right after it");
		assert_true(blobs >= 100 && blobBytes >= 100 * 64, "the hundred live blobs, by their type's name");
		assert_true(unknownNamed, "what was made before the census is counted under a name of its own");
		for (int32 i = 0; i < 100; ++i) s_blobs[i] = null;
		FS::RemoveFile(path.CStr());
	}

	[test("allocations_sampled_with_the_functions_that_made_them")]
	public static void TestSamples() {
		Core::String path = TracePath("bedrock-profile-samples.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		{
			Profile::Zone zone(Core::StringView("Spawn"));
			AllocateMany();
		}
		Profile::Stop();
		assert_eq(0, (int64)GC::SetAllocSampling(0), "sampling is off again once the session stopped");

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		const uint64 me = SessionIdOf(events, Threading::Thread::CurrentId());
		Core::HashMap<uint64, bool> stacks;
		Core::HashMap<uint64, Core::String> named;
		int64 samples = 0;
		bool defined = true;
		bool mine = true;
		bool weighed = true;
		bool namedAllocator = false;
		for (const TracedEvent& e : events) {
			if (e.type == 0x81) stacks.Insert(e.fields[0], true);
			if (e.type == 0x83) named.Insert(e.fields[0], *strings.Find(e.fields[1]));
			if (e.type != 0x82) continue;
			samples += 1;
			if (!stacks.Find(e.fields[1])) defined = false;
			if (e.fields[0] != me) mine = false;
			if (e.fields[2] != 2 || e.fields[3] != 65536) weighed = false;
		}
		for (const TracedEvent& e : events)
			if (e.type == 0x81 && named.Find(e.fields[2]) && (named.Find(e.fields[2])->View().EndsWith(Core::StringView("AllocateMany")) || named.Find(e.fields[2])->View().EndsWith(Core::StringView("TestSamples")))) namedAllocator = true;
		assert_true(samples >= 5, "two megabytes sampled every 64 KiB");
		assert_true(defined, "each sample's stack defined before it");
		assert_true(me != 0 && mine, "each the allocating thread's");
		assert_true(weighed, "each standing for 64 KiB allocated");
		assert_true(namedAllocator, "a stack's first address named by the function that allocated (the test, once it is inlined there)");
		for (int32 i = 0; i <= 100; ++i) s_blobs[i] = null;
		FS::RemoveFile(path.CStr());
	}

	[test("jobs_are_tasks_on_named_workers")]
	public static void TestJobs() {
		Core::String path = TracePath("bedrock-profile-jobs.iedtrace");
		Core::String problem;
		Threading::JobSystemDesc desc;
		desc.frameWorkers = 2;
		desc.backgroundWorkers = 1;
		Threading::JobSystem jobs(desc);
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		Threading::WaitGroup group;
		for (int32 i = 0; i < 6; i++) jobs.Submit([]() { Busy(); }, Threading::JobPriority::Normal, &group, "Decompress");
		jobs.Submit([]() { Busy(); }, Threading::JobPriority::Background, &group);
		group.Wait();
		Profile::Stop();
		Threading::WaitGroup after;
		jobs.Submit([]() { Busy(); }, Threading::JobPriority::Normal, &after, "Late");
		after.Wait();

		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		int64 decompress = 0;
		int64 unnamed = 0;
		for (const TracedEvent& e : events) {
			if (e.type != 0x30) continue;
			if (*strings.Find(e.fields[1]) == "Decompress") decompress += 1;
			if (*strings.Find(e.fields[1]) == "Job") unnamed += 1;
		}
		assert_eq(6, decompress, "each named job a task of its name");
		assert_eq(1, unnamed, "a job without one is a Job");
		assert_eq(7, CountOf(events, 0x31), "each ended");
		bool workerNamed = false;
		for (const TracedEvent& e : events)
			if (e.type == 0x13 && strings.Find(e.fields[0])->View().StartsWith(Core::StringView("Job Worker"))) workerNamed = true;
		assert_true(workerNamed, "the workers keep the names the job system gave them");
		FS::RemoveFile(path.CStr());
	}

	[test("definitions_come_before_their_use_and_times_grow")]
	public static void TestOrder() {
		Core::String path = TracePath("bedrock-profile-order.iedtrace");
		Core::String problem;
		assert_true(Profile::Start((Core::String("file:") + path.View()).View(), problem), "started");
		for (int32 i = 0; i < 200; ++i) {
			Profile::Zone zone(s_update);
			if (i % 50 == 0) Threading::Thread::Sleep(15000000);
		}
		Profile::Stop();
		Core::HashMap<uint64, Core::String> strings;
		bool wellFormed;
		Core::Array<TracedEvent> events = ReadTrace(path.CStr(), strings, wellFormed);
		assert_true(wellFormed, "read whole");
		bool sitesDefined = true;
		Core::HashMap<uint64, bool> defined;
		int64 last = 0;
		bool growing = true;
		for (const TracedEvent& e : events) {
			if (e.type == 0x11) defined.Insert(e.fields[0], true);
			if (e.type == 0x20 && !defined.Find(e.fields[0])) sitesDefined = false;
			if (e.chunk == 0 && (e.type == 0x20 || e.type == 0x22)) {
				if (e.ticks < last) growing = false;
				last = e.ticks;
			}
		}
		assert_true(sitesDefined, "each zone's site was defined before it");
		assert_true(growing, "a thread's times never step back, across chunks");
		assert_eq(200, CountOf(events, 0x20), "every zone");
		FS::RemoveFile(path.CStr());
	}

	[test("nothing_is_recorded_without_a_session")]
	public static void TestOff() {
		assert_true(!Profile::IsActive(), "no session");
		Profile::Zone zone(s_update);
		Profile::Frame();
		assert_eq(0, (int64)Profile::TaskBegin(Core::StringView("Idle")), "a task gets no id");
		Profile::Stop();
		Core::String problem;
		assert_true(!Profile::Start(Core::StringView("127.0.0.1:1;token=x"), problem) && !problem.IsEmpty(), "an unreachable profiler is said so");
		assert_true(!Profile::Start(Core::StringView("nonsense"), problem), "and an address that is none");
	}
}
