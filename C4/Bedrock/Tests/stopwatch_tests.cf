// Platform::Stopwatch measures forward, in ticks, seconds and nanoseconds, and laps restart it.

include "bedrock.ch"

[test("stopwatch")]
class StopwatchTests {
	[test("measures")]
	public static void TestMeasures() {
		Platform::Stopwatch watch;
		int64 ticks = 0;
		for (int32 i = 0; i < 100000000 && ticks == 0; ++i) ticks = watch.ElapsedTicks();
		assert_true(ticks > 0 && watch.Seconds() > 0.0, "forward, as the clock moves");
		int64 nanoseconds = watch.Nanoseconds();
		assert_true(nanoseconds > 0 && nanoseconds < 10000000000, "between nothing and ten seconds");
		double first = watch.Lap();
		double second = watch.Lap();
		assert_true(first >= 0.0 && second >= 0.0 && second < 1.0, "laps restart");
		watch.Restart();
		assert_true(watch.Milliseconds() < 1000.0, "restarted");
	}
}
