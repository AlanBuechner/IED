// Bedrock Format tests. Run with:  C4.exe c4/Bedrock/Tests -test
// Covers the Core::StringFormat-style positional formatter: verbatim text, default + typed kinds, width padding,
// float/double fraction digits, and multiple placeholders in one format string.

include "bedrock.ch"

[test("format.verbatim")]
public static void TestFormatVerbatim() {
	Core::StringBuilder* b = new Core::StringBuilder(16);
	Core::Format(b, "hello world");           // no placeholders at all
	assert_se("hello world", b->CStr(), "no-placeholder format copies verbatim");
}

[test("format.decimal_default")]
public static void TestFormatDecimalDefault() {
	Core::StringBuilder* b = new Core::StringBuilder(16);
	Core::Format(b, "{0}", 42);               // default kind d: signed decimal int32
	assert_se("42", b->CStr(), "default placeholder renders decimal");
	b->Clear();
	Core::Format(b, "n={0}", -7);
	assert_se("n=-7", b->CStr(), "negative default decimal");
}

[test("format.kinds")]
public static void TestFormatKinds() {
	Core::StringBuilder* b = new Core::StringBuilder(32);
	Core::Format(b, "{0:x}", 255u);           // hex
	assert_se("ff", b->CStr(), "hex kind");
	b->Clear();
	Core::Format(b, "{0:b}", 5u);             // binary
	assert_se("101", b->CStr(), "binary kind");
	b->Clear();
	Core::Format(b, "{0:o}", 8u);             // octal
	assert_se("10", b->CStr(), "octal kind");
	b->Clear();
	Core::Format(b, "{0:u}", 123456789u);     // unsigned decimal (uint64)
	assert_se("123456789", b->CStr(), "unsigned decimal kind");
}

[test("format.width_padding")]
public static void TestFormatWidthPadding() {
	Core::StringBuilder* b = new Core::StringBuilder(32);
	Core::Format(b, "{0:x.8}", 255u);         // hex zero-padded to 8 digits
	assert_se("000000ff", b->CStr(), "hex width-8 padding");
	b->Clear();
	Core::Format(b, "{0:d.4}", 255);          // decimal zero-padded to 4 digits
	assert_se("0255", b->CStr(), "decimal width-4 padding");
	b->Clear();
	Core::Format(b, "{0:b.8}", 5u);           // binary padded to 8 bits
	assert_se("00000101", b->CStr(), "binary width-8 padding");
}

[test("format.float_double")]
public static void TestFormatFloatDouble() {
	Core::StringBuilder* b = new Core::StringBuilder(32);
	Core::Format(b, "{0:f.2}", 1.5f);         // float, 2 fraction digits
	assert_se("1.50", b->CStr(), "float f.2");
	b->Clear();
	Core::Format(b, "{0:F.3}", 2.25);         // double, 3 fraction digits
	assert_se("2.250", b->CStr(), "double F.3");
	b->Clear();
	Core::Format(b, "{0:f}", 3.25f);          // no width -> 6 fraction digits, as C's %f (BUG-380)
	assert_se("3.250000", b->CStr(), "float f (6 decimals)");
	b->Clear();
	Core::Format(b, "{0:F}", 3.25);
	assert_se("3.250000", b->CStr(), "double F (6 decimals)");
	b->Clear();
	Core::Format(b, "{0:f.0}", 3.25);         // .0 written: none
	assert_se("3", b->CStr(), "f.0 (no decimals)");
}

[test("format.upper_hex")]
public static void TestFormatUpperHex() {
	Core::StringBuilder* b = new Core::StringBuilder(32);
	Core::Format(b, "{0:X}", 255u);           // A to F (BUG-380)
	assert_se("FF", b->CStr(), "upper hex");
	b->Clear();
	Core::Format(b, "{0:X.6}", 48879);
	assert_se("00BEEF", b->CStr(), "upper hex zero-padded");
	b->Clear();
	Core::Format(b, "{0:X}", -1);             // two's complement bits, as x
	assert_se("FFFFFFFFFFFFFFFF", b->CStr(), "upper hex of a negative");
}

[test("format.multiple")]
public static void TestFormatMultiple() {
	Core::StringBuilder* b = new Core::StringBuilder(64);
	Core::Format(b, "id={0:d.4} val={1:x.8}", 255, 4096u);   // two placeholders, mixed kinds + widths
	assert_se("id=0255 val=00001000", b->CStr(), "two placeholders with controls");
	b->Clear();
	Core::Format(b, "{0:f.2} + {1:F.3}", 1.5f, 2.25);        // float then double in one string
	assert_se("1.50 + 2.250", b->CStr(), "float and double in one format");
}

[test("format.order_and_repeat")]
public static void TestFormatOrderAndRepeat() {
	Core::StringBuilder b;
	Core::Format(&b, "{1} before {0}, {1} again", 10, 20);
	assert_se("20 before 10, 20 again", b.CStr(), "any order, any number of times");
	b.Clear();
	Core::Format(&b, "{2:F.1}", 1, 2.5, 3.25);
	assert_se("3.2", b.CStr(), "arguments a placeholder skips are not read (3.25 rounds to even)");
}

[test("format.escapes_and_strings")]
public static void TestFormatEscapesAndStrings() {
	Core::StringBuilder b;
	Core::Format(&b, "{{0}} is {0:s}, }} {{", "zero");
	assert_se("{0} is zero, } {", b.CStr(), "doubled braces are literal");
	b.Clear();
	Core::Format(&b, "{x} {0 {99} {0:d", 5);
	assert_se("{x} {0 {99} {0:d", b.CStr(), "malformed placeholders are written as text");
}

[test("format.each_argument_as_its_type")]
public static void TestFormatEachArgumentAsItsType() {
	Core::StringBuilder b;
	int64 big = 5000000000;
	Core::Format(&b, "{0} {1} {2}", big, (uint64)18446744073709551615u, (int16)-3);
	assert_se("5000000000 18446744073709551615 -3", b.CStr(), "integers keep their width and sign");
	b.Clear();
	Core::Format(&b, "{0:x} {1:x.4}", -1, (uint8)10);
	assert_se("ffffffffffffffff 000a", b.CStr(), "a negative integer in hex is its two's complement");
	b.Clear();
	Core::Format(&b, "{0} {1} [{2}]", true, false, 'z');
	assert_se("true false [z]", b.CStr(), "bool and char");
}

[test("format.reals_shortest")]
public static void TestFormatRealsShortest() {
	Core::StringBuilder b;
	Core::Format(&b, "{0} {1} {2}", 0.1f, 0.1, 2.5f);
	assert_se("0.1 0.1 2.5", b.CStr(), "{n} of a real is the shortest text that reads back as it");
	b.Clear();
	Core::Format(&b, "{0:x}", 1.25);
	assert_se("1.25", b.CStr(), "a kind of another family writes the value as {n} does");
}

[test("format.text_arguments")]
public static void TestFormatTextArguments() {
	Core::StringBuilder b;
	Core::String name = Core::String("ada");
	Core::StringView view = Core::StringView("lovelace");
	Core::Format(&b, "{0} {1} {2:s}", name, view, "count");
	assert_se("ada lovelace count", b.CStr(), "String, StringView and const char* are text");
	b.Clear();
	const char* none = nullptr;
	Core::Format(&b, "[{0}]", none);
	assert_se("[]", b.CStr(), "a null const char* is empty text");
}
