include "client.ch"
include "Text/stringbuilder.ch"

namespace Http
{
	const int64 kFetchReceiveBytes = 16 * 1024;

	FetchResult Failed(const char* why) {
		FetchResult result;
		result.error = Core::String(why);
		return result;
	}

	// --- connecting -----------------------------------------------------------------------------------------------------

	// The first of `addresses` that takes a connection within `timeoutMs` each; a closed stream with the last one's why.
	Net::TcpStream ConnectFirst(const Core::Array<Net::Address>& addresses, int32 timeoutMs, Core::String& why) {
		for (int64 i = 0; i < addresses.Count(); ++i) {
			Net::TcpStream stream = Net::TcpStream::Connect(addresses[i], timeoutMs);
			if (stream.IsOpen()) return stream;
			why = (Core::String("cannot connect to ") + addresses[i].ToString().View() + ": ") + stream.Error();
		}
		return Net::TcpStream();
	}

	Net::TcpStream ConnectTo(const Url& url, const Net::TlsClientOptions& tls, int32 timeoutMs, Core::String& why) {
		const Net::Resolution found = Net::Resolve(url.host.CStr(), url.port);
		if (!found.Found()) {
			why = (Core::String("cannot find ") + url.host.View() + ": ") + found.error.View();
			return Net::TcpStream();
		}
		Net::TcpStream stream = ConnectFirst(found.addresses, timeoutMs, why);
		if (!stream.IsOpen() || !url.secure) return stream;
		Net::TlsClientOptions checked = tls;
		if (checked.hostName.IsEmpty()) checked.hostName = url.host;
		if (!stream.StartTls(checked, timeoutMs)) why = Core::String(stream.Error());
		return stream;
	}

	// --- one exchange ---------------------------------------------------------------------------------------------------

	void WriteRequest(Core::StringBuilder& head, const Request& request, Core::StringView defaultHost) {
		head.Append(request.method.View());
		head.Append(" ");
		head.Append(request.target.IsEmpty() ? Core::StringView("/") : request.target.View());
		head.Append(" HTTP/1.1\r\n");
		if (!request.headers.Has(Core::StringView("Host"))) {
			head.Append("Host: ");
			head.Append(defaultHost);
			head.Append("\r\n");
		}
		for (int64 i = 0; i < request.headers.Count(); ++i) {
			const Header& header = request.headers.At(i);
			if (EqualsIgnoringCase(header.name.View(), Core::StringView("Content-Length")) ||
				EqualsIgnoringCase(header.name.View(), Core::StringView("Transfer-Encoding")) ||
				EqualsIgnoringCase(header.name.View(), Core::StringView("Connection"))) continue;
			head.Append(header.name.View());
			head.Append(": ");
			head.Append(header.value.View());
			head.Append("\r\n");
		}
		if (!request.body.IsEmpty() || request.method == "POST" || request.method == "PUT") {
			head.Append("Content-Length: ");
			head.AppendInt(request.body.Count());
			head.Append("\r\n");
		}
		head.Append("Connection: close\r\n\r\n");
	}

	// More bytes onto `received`: false when the connection ends, fails or the wait times out.
	bool ReceiveInto(Net::TcpStream& stream, Core::Array<uint8>& received, int32 timeoutMs) {
		uint8[kFetchReceiveBytes] buffer;
		const int64 got = stream.Receive((void*)&buffer[0], kFetchReceiveBytes, timeoutMs);
		if (got <= 0) return false;
		received.Append(&buffer[0], got);
		return true;
	}

	Core::StringView Received(const Core::Array<uint8>& received, int64 from) {
		return Core::StringView((const char*)received.Data() + from, received.Count() - from);
	}

	// The final head (past interim 1xx ones, but a 101 when `switching`) into `response`; where its body starts, or -1.
	int64 ReadFinalHead(Net::TcpStream& stream, Core::Array<uint8>& received, int32 timeoutMs, bool switching, Response& response, Core::String& why) {
		int64 start = 0;
		while (true) {
			const HeadParse head = ParseResponseHead(Received(received, start), kMaxFetchHeadBytes, response);
			if (head.status == ParseStatus::Complete && (response.status >= 200 || (switching && response.status == 101))) return start + head.length;
			if (head.status == ParseStatus::Complete) {
				start += head.length;
				continue;
			}
			if (head.status != ParseStatus::Incomplete) {
				why = head.error;
				return -1;
			}
			if (!ReceiveInto(stream, received, timeoutMs)) {
				why = Core::String("the connection ended before the response head");
				return -1;
			}
		}
	}

	// The body after `start`, framed as `framing` says; false with `why`.
	bool ReadResponseBody(Net::TcpStream& stream, Core::Array<uint8>& received, int64 start, const BodyFraming& framing, int32 timeoutMs,
		Response& response, Core::String& why) {
		if (framing.kind == BodyKind::Malformed || framing.kind == BodyKind::Unsupported) {
			why = framing.error;
			return false;
		}
		if (framing.kind == BodyKind::Chunked) {
			ChunkedDecoder decoder;
			int64 at = start;
			while (true) {
				const ChunkedStep step = decoder.Feed(Received(received, at), kMaxFetchBodyBytes, response.body);
				at += step.consumed;
				if (step.status == ParseStatus::Complete) return true;
				if (step.status != ParseStatus::Incomplete || !ReceiveInto(stream, received, timeoutMs)) {
					why = step.status == ParseStatus::Incomplete ? Core::String("the connection ended inside a chunked body") : step.error;
					return false;
				}
			}
		}
		const bool sized = framing.kind == BodyKind::Length;
		while ((sized && received.Count() - start < framing.length) || framing.kind == BodyKind::UntilClose) {
			if (received.Count() - start > kMaxFetchBodyBytes) {
				why = Core::String("the body is larger than the limit");
				return false;
			}
			if (!ReceiveInto(stream, received, timeoutMs)) {
				if (framing.kind == BodyKind::UntilClose && !stream.TimedOut() && stream.Error()[0] == 0) break;
				why = stream.Error()[0] != 0 ? Core::String(stream.Error()) : Core::String("the connection ended before the whole body");
				return false;
			}
		}
		const int64 length = sized ? framing.length : received.Count() - start;
		if (framing.kind != BodyKind::None) response.body.Append(received.Data() + start, length);
		return true;
	}

	// `request` sent on `stream` (with `defaultHost` as its Host unless it has one) and the response read.
	FetchResult Exchange(Net::TcpStream& stream, const Request& request, Core::StringView defaultHost, int32 timeoutMs) {
		Core::StringBuilder head;
		WriteRequest(head, request, defaultHost);
		if (!stream.SendText(head.View(), timeoutMs) || !stream.SendAll((const void*)request.body.Data(), request.body.Count(), timeoutMs))
			return Failed(stream.Error());
		FetchResult result;
		Core::Array<uint8> received;
		const int64 bodyStart = ReadFinalHead(stream, received, timeoutMs, false, result.response, result.error);
		if (bodyStart < 0) return result;
		const BodyFraming framing = ResponseFraming(result.response.headers, result.response.status, request.method.View());
		result.ok = ReadResponseBody(stream, received, bodyStart, framing, timeoutMs, result.response, result.error);
		return result;
	}

	FetchResult Fetch(const Net::Address& at, const Request& request, int32 timeoutMs) {
		Net::TcpStream stream = Net::TcpStream::Connect(at, timeoutMs);
		if (!stream.IsOpen()) return Failed(stream.Error());
		return Exchange(stream, request, at.ToString().View(), timeoutMs);
	}

	int64 ReadSwitchHead(Net::TcpStream& stream, Core::Array<uint8>& received, int32 timeoutMs, Response& response, Core::String& why) {
		return ReadFinalHead(stream, received, timeoutMs, true, response, why);
	}

	FetchResult FetchUrl(Core::StringView url, Request request, const Net::TlsClientOptions& tls, int32 timeoutMs) {
		const Url parsed = ParseUrl(url);
		if (!parsed.valid || parsed.webSocket) return Failed("not an http:// or https://host[:port]/path URL");
		Core::String why;
		Net::TcpStream stream = ConnectTo(parsed, tls, timeoutMs, why);
		if (!stream.IsOpen()) return Failed(why.CStr());
		request.target = parsed.target;
		const Core::String host = HostHeader(parsed);
		request.headers.Set(Core::StringView("Host"), host.View());
		return Exchange(stream, request, host.View(), timeoutMs);
	}

	FetchResult Get(Core::StringView url, int32 timeoutMs) {
		Request request;
		request.method = Core::String("GET");
		return FetchUrl(url, request, Net::TlsClientOptions(), timeoutMs);
	}

	FetchResult Post(Core::StringView url, Core::StringView contentType, Core::StringView body, int32 timeoutMs) {
		Request request;
		request.method = Core::String("POST");
		request.headers.Set(Core::StringView("Content-Type"), contentType);
		request.SetBody(body);
		return FetchUrl(url, request, Net::TlsClientOptions(), timeoutMs);
	}
}
