include "list.ch"

namespace Core
{
	// At most `count` nodes are followed: the census may read a list another thread stopped in the middle of linking.
	template<T>
	public int64 List::NativeBytes() const {
		int64 total = count * (int64)sizeof(ListNode<T>);
		if (holds_native_bytes(T)) {
			const ListNode<T>* node = head;
			for (int64 i = 0; i < count && node; ++i, node = node->next) total += native_bytes_of(node->value);
		}
		return total;
	}

	template<T>
	private ListNode<T>* List::NewNode(T value) {
		ListNode<T>* node = AllocateElements<ListNode<T>>(1);
		memset((void*)node, 0, (uint64)sizeof(ListNode<T>));
		if (holds_pointers(T)) gc_register_region((void*)node, (uint64)sizeof(ListNode<T>));
		new (&node->value) T(take(value));
		return node;
	}

	template<T>
	private void List::FreeNode(ListNode<T>* node) {
		destroy(&node->value);
		if (holds_pointers(T)) gc_unregister_region((void*)node);
		FreeElements<ListNode<T>>(node, 1);
	}

	template<T>
	private void List::Link(ListNode<T>* node, ListNode<T>* before) {
		ListNode<T>* after = before ? before->previous : tail;
		node->previous = after;
		node->next = before;
		if (after) after->next = node; else head = node;
		if (before) before->previous = node; else tail = node;
		count += 1;
	}

	template<T>
	private void List::Unlink(ListNode<T>* node) {
		if (node->previous) node->previous->next = node->next; else head = node->next;
		if (node->next) node->next->previous = node->previous; else tail = node->previous;
		node->next = nullptr;
		node->previous = nullptr;
		count -= 1;
	}

	template<T>
	public void List::Init(InitList<T> items) {
		for (int64 k = 0; k < (int64)items.size; ++k) PushBack(items[k]);
	}

	template<T>
	public void List::CopyFrom(const List<T>& other) {
		for (const ListNode<T>* node = other.head; node; node = node->next) PushBack(node->value);
	}

	template<T>
	public ListNode<T>* List::InsertBefore(ListNode<T>* position, T value) {
		ListNode<T>* node = NewNode(take(value));
		Link(node, position);
		return node;
	}

	template<T>
	public ListNode<T>* List::InsertAfter(ListNode<T>* position, T value) {
		return InsertBefore(position ? position->next : head, take(value));
	}

	template<T>
	public T List::PopFront() {
		if (!head) { T none; return none; }
		ListNode<T>* node = head;
		Unlink(node);
		T value = take(node->value);
		FreeNode(node);
		return value;
	}

	template<T>
	public T List::PopBack() {
		if (!tail) { T none; return none; }
		ListNode<T>* node = tail;
		Unlink(node);
		T value = take(node->value);
		FreeNode(node);
		return value;
	}

	template<T>
	public void List::Remove(ListNode<T>* node) {
		if (!node) return;
		Unlink(node);
		FreeNode(node);
	}

	template<T>
	public void List::Clear() {
		ListNode<T>* node = head;
		while (node) {
			ListNode<T>* next = node->next;
			FreeNode(node);
			node = next;
		}
		head = nullptr;
		tail = nullptr;
		count = 0;
	}

	template<T>
	public void List::MoveToFront(ListNode<T>* node) {
		if (!node || node == head) return;
		Unlink(node);
		Link(node, head);
	}

	template<T>
	public void List::MoveToBack(ListNode<T>* node) {
		if (!node || node == tail) return;
		Unlink(node);
		Link(node, nullptr);
	}

	template<T>
	public void List::Reverse() {
		ListNode<T>* node = head;
		while (node) {
			ListNode<T>* next = node->next;
			node->next = node->previous;
			node->previous = next;
			node = next;
		}
		ListNode<T>* first = head;
		head = tail;
		tail = first;
	}

	template<T>
	public ListNode<T>* List::Find(const T& value) {
		for (ListNode<T>* node = head; node; node = node->next)
			if (node->value == value) return node;
		return nullptr;
	}

	template<T>
	public const ListNode<T>* List::Find(const T& value) const {
		for (const ListNode<T>* node = head; node; node = node->next)
			if (node->value == value) return node;
		return nullptr;
	}
}
