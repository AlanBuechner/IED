include "array.ch"

// Elements [0, count) are live objects; [count, capacity) is raw storage. Moving the buffer copies bytes:
// objects are trivially relocatable (docs/language/06). Past 1 MiB the buffer grows in place instead.

namespace Core
{
	bool ResizeEmptyArray(void* array, int64 count, ElementStorage element) {
		ArrayLayout* layout = (ArrayLayout*)array;
		if (layout->count != 0 || count < 0) return false;
		if (count == 0) return true;
		const uint64 bytes = (uint64)(count * element.bytes);
		layout->data = ResizeElementBytes(layout->data, (uint64)(layout->capacity * element.bytes), 0u, bytes, (uint64)element.align, element.holdsPointers);
		memset(layout->data, 0, bytes);
		layout->count = count;
		layout->capacity = count;
		return true;
	}

	template<T>
	private void Array::Reallocate(int64 newCapacity) {
		data = ResizeElements<T>(data, capacity, count, newCapacity);
		capacity = newCapacity;
	}

	template<T>
	private void Array::Grow(int64 needed) {
		int64 grown = capacity < 2 ? 4 : capacity * 2;
		Reallocate(needed > grown ? needed : grown);
	}

	template<T>
	public void Array::Init(InitList<T> items) {
		const int64 n = (int64)items.size;
		Reserve(n);
		T* to = data;
		for (int64 k = 0; k < n; ++k) new (&to[k]) T(items[k]);
		count = n;
	}

	template<T>
	public void Array::CopyFrom(const Array<T>& other) {
		Reserve(other.count);
		CopyElements(data, other.data, other.count);
		count = other.count;
	}

	template<T>
	public void Array::Delete() {
		Clear();
		Reallocate(0);
	}

	template<T>
	public void Array::Clear() {
		DestroyElements(data, 0, count);
		ClearVacated(data, 0, count);
		count = 0;
	}

	template<T>
	public void Array::Reserve(int64 wanted) {
		if (wanted > capacity) Reallocate(wanted);
	}

	template<T>
	public void Array::Push(T value) {
		if (count == capacity) Grow(count + 1);   // `value` is the caller's copy: an element it came from may move
		new (&data[count]) T(take(value));
		count += 1;
	}

	template<T>
	public T Array::Pop() {
		if (count == 0) { T none; return none; }
		count -= 1;
		return take(data[count]);
	}

	template<T>
	public void Array::Insert(int64 index, T value) {
		if (index > count) index = count;
		if (count == capacity) Grow(count + 1);
		memmove((void*)&data[index + 1], (void*)&data[index], (uint64)((count - index) * (int64)sizeof(T)));
		new (&data[index]) T(take(value));
		count += 1;
	}

	template<T>
	public void Array::Append(const Array<T>& other) { Append(other.data, other.count); }

	// Grows as Push does (BUG-274: an exact reserve made repeated appends quadratic).
	template<T>
	public void Array::Append(const T* items, int64 n) {
		if (n <= 0) return;
		if (count > 0 && items >= data && items < data + count) {
			Array<T> copy;
			copy.Append(items, n);
			Append(copy.data, n);
			return;
		}
		if (count + n > capacity) Grow(count + n);
		CopyElements(data + count, items, n);
		count += n;
	}

	template<T>
	public void Array::RemoveAt(int64 index) {
		if (index < 0 || index >= count) return;
		destroy(&data[index]);
		memmove((void*)&data[index], (void*)&data[index + 1], (uint64)((count - index - 1) * (int64)sizeof(T)));
		count -= 1;
		ClearVacated(data, count, count + 1);
	}

	template<T>
	public void Array::RemoveRange(int64 first, int64 end) {
		if (first < 0) first = 0;
		if (end > count) end = count;
		if (first >= end) return;
		DestroyElements(data, first, end);
		memmove((void*)&data[first], (void*)&data[end], (uint64)((count - end) * (int64)sizeof(T)));
		ClearVacated(data, count - (end - first), count);
		count -= end - first;
	}

	template<T>
	public void Array::RemoveSwap(int64 index) {
		if (index < 0 || index >= count) return;
		destroy(&data[index]);
		count -= 1;
		if (index != count) relocate(&data[index], &data[count]);
		ClearVacated(data, count, count + 1);
	}

	// Growing default-creates each new element (zero for plain data); shrinking destroys the tail.
	template<T>
	public void Array::Resize(int64 newCount) {
		if (newCount < 0) newCount = 0;
		Reserve(newCount);
		CreateElements(data, count, newCount);
		DestroyElements(data, newCount, count);
		ClearVacated(data, newCount, count);
		count = newCount;
	}

	template<T>
	public void Array::ResizeUninitialized(int64 newCount) {
		if (newCount < 0) newCount = 0;
		Reserve(newCount);
		DestroyElements(data, newCount, count);
		ClearVacated(data, newCount, count);
		count = newCount;
	}

	template<T>
	public void Array::ShrinkToFit() {
		if (count < capacity) Reallocate(count);
	}

	template<T>
	public void Array::Swap(Array<T>& other) {
		T* d = data; data = other.data; other.data = d;
		int64 c = count; count = other.count; other.count = c;
		int64 cap = capacity; capacity = other.capacity; other.capacity = cap;
	}

	template<T>
	public int64 Array::IndexOf(const T& value) const {
		for (int64 k = 0; k < count; ++k)
			if (data[k] == value) return k;
		return -1;
	}

	template<T>
	public void Array::Reverse() {
		T* items = data;
		for (int64 i = 0, j = count - 1; i < j; ++i, --j) SwapElements(items, i, j);
	}
}
