include "hashmap.ch"

namespace Core
{
	template<K, V>
	public HashMapIterator<K, V> HashMapIterator::Next() {
		HashMapIterator<K, V> next = *this;
		next.index += 1;
		while (next.index < end && control[next.index] < (int8)0) next.index += 1;
		return next;
	}

	template<K, V>
	public ConstHashMapIterator<K, V> ConstHashMapIterator::Next() {
		ConstHashMapIterator<K, V> next = *this;
		next.index += 1;
		while (next.index < end && control[next.index] < (int8)0) next.index += 1;
		return next;
	}

	template<K, V, Traits>
	public void HashMap::CopyFrom(const HashMap<K, V, Traits>& other) {
		Reserve(other.table.count);
		const KeyValue<K, V>* from = other.entries;
		for (int64 i = NextLiveSlot(other.table, 0); i < other.table.capacity; i = NextLiveSlot(other.table, i + 1)) Insert(from[i].key, from[i].value);
	}

	template<K, V, Traits>
	public void HashMap::Delete() {
		Clear();
		FreeTable(table, (void*)entries, EntryStorageOf<KeyValue<K, V>>());
		entries = nullptr;
	}

	template<K, V, Traits>
	public void HashMap::Clear() {
		for (int64 i = NextLiveSlot(table, 0); i < table.capacity; i = NextLiveSlot(table, i + 1)) destroy(&entries[i]);
		EmptyTable(table);
	}

	// Moves every live entry into a table of the new capacity; the removed slots are left behind.
	template<K, V, Traits>
	private void HashMap::Rehash(int64 newCapacity) {
		HashTable old = table;
		KeyValue<K, V>* from = entries;
		entries = (KeyValue<K, V>*)AllocateTable(table, newCapacity, EntryStorageOf<KeyValue<K, V>>());
		KeyValue<K, V>* to = entries;
		for (int64 i = NextLiveSlot(old, 0); i < old.capacity; i = NextLiveSlot(old, i + 1)) {
			const uint64 hash = Traits::Hash(from[i].key);
			const int64 slot = FreeSlot(table, hash);
			relocate(&to[slot], &from[i]);
			Occupy(table, slot, hash);
		}
		FreeTable(old, (void*)from, EntryStorageOf<KeyValue<K, V>>());
	}

	template<K, V, Traits>
	public void HashMap::Reserve(int64 wanted) {
		const int64 needed = CapacityFor(wanted);
		if (needed > table.capacity) Rehash(needed);
	}

	template<K, V, Traits>
	private int64 HashMap::SlotForNew(uint64 hash) {
		if (NeedsRoom(table)) Rehash(GrownCapacity(table));
		const int64 slot = FreeSlot(table, hash);
		Occupy(table, slot, hash);
		return slot;
	}

	template<K, V, Traits>
	public bool HashMap::Insert(K key, V value) {
		const int64 found = SlotOf(key);
		if (found >= 0) { entries[found].value = take(value); return false; }
		const int64 slot = SlotForNew(Traits::Hash(key));
		KeyValue<K, V>* entry = &entries[slot];
		new (&entry->key) K(take(key));
		new (&entry->value) V(take(value));
		return true;
	}

	template<K, V, Traits>
	public V& HashMap::At(const K& key) {
		const int64 found = SlotOf(key);
		if (found >= 0) return entries[found].value;
		const int64 slot = SlotForNew(Traits::Hash(key));
		KeyValue<K, V>* entry = &entries[slot];
		new (&entry->key) K(key);
		new (&entry->value) V();
		return entry->value;
	}

	template<K, V, Traits>
	public V* HashMap::Find(const K& key) {
		const int64 slot = SlotOf(key);
		return slot >= 0 ? &entries[slot].value : nullptr;
	}

	template<K, V, Traits>
	public const V* HashMap::Find(const K& key) const {
		const int64 slot = SlotOf(key);
		return slot >= 0 ? &entries[slot].value : nullptr;
	}

	template<K, V, Traits>
	public bool HashMap::TryGet(const K& key, V& out) const {
		const int64 slot = SlotOf(key);
		if (slot < 0) return false;
		out = entries[slot].value;
		return true;
	}

	template<K, V, Traits>
	public V HashMap::Get(const K& key) const {
		const int64 slot = SlotOf(key);
		if (slot < 0) { V none; return none; }
		return entries[slot].value;
	}

	// The slot becomes removed, so the probes that pass through it go on.
	template<K, V, Traits>
	private bool HashMap::RemoveSlot(int64 slot) {
		if (slot < 0) return false;
		destroy(&entries[slot]);
		Vacate(table, slot);
		return true;
	}

	template<K, V, Traits>
	public HashMapIterator<K, V> HashMap::Begin() {
		HashMapIterator<K, V> it;
		it.entries = entries;
		it.control = table.control;
		it.end = table.capacity;
		it.index = NextLiveSlot(table, 0);
		return it;
	}

	template<K, V, Traits>
	public HashMapIterator<K, V> HashMap::End() {
		HashMapIterator<K, V> it;
		it.entries = entries;
		it.control = table.control;
		it.end = table.capacity;
		it.index = table.capacity;
		return it;
	}

	template<K, V, Traits>
	public ConstHashMapIterator<K, V> HashMap::Begin() const {
		ConstHashMapIterator<K, V> it;
		it.entries = entries;
		it.control = table.control;
		it.end = table.capacity;
		it.index = NextLiveSlot(table, 0);
		return it;
	}

	template<K, V, Traits>
	public ConstHashMapIterator<K, V> HashMap::End() const {
		ConstHashMapIterator<K, V> it;
		it.entries = entries;
		it.control = table.control;
		it.end = table.capacity;
		it.index = table.capacity;
		return it;
	}
}
