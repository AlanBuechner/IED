include "readresult.ch"

namespace Serialization
{
	ReadResult ReadFailure(Core::StringView text, int64 offset, const char* error) {
		ReadResult result;
		result.error = error;
		result.offset = offset;
		result.line = 1;
		int64 lineStart = 0;
		for (int64 i = 0; i < offset && i < text.ByteLength(); ++i)
			if (text.ByteAt(i) == '\n') { result.line += 1; lineStart = i + 1; }
		result.column = (int32)(offset - lineStart) + 1;
		return result;
	}

	bool IsDecimalDigit(int32 byte) { return byte >= '0' && byte <= '9'; }

	int32 HexDigitValue(int32 byte) {
		if (byte >= '0' && byte <= '9') return byte - '0';
		if (byte >= 'a' && byte <= 'f') return byte - 'a' + 10;
		if (byte >= 'A' && byte <= 'F') return byte - 'A' + 10;
		return -1;
	}

	ReadResult ReadSuccess(DomNode root) {
		ReadResult result;
		result.root = root;
		result.line = 1;
		result.column = 1;
		return result;
	}
}
