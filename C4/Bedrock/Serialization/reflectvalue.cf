include "reflectvalue.ch"

namespace Serialization
{
	static Reflection::Type FindType(const char* name) { return Reflection::Type(nullptr).FindByName(name); }

	// --- describing -------------------------------------------------------------------------------------------------

	static bool Is(const ValueType& value, const char* name) { return value.name.View() == name; }

	static bool DescribePrimitive(ValueType& value) {
		const char*[4] signedNames = { "int8", "int16", "int32", "int64" };
		const char*[7] unsignedNames = { "uint8", "uint16", "uint32", "uint64", "char8", "char16", "char32" };
		const int64[7] unsignedSizes = { 1, 2, 4, 8, 1, 2, 4 };
		for (int32 i = 0; i < 4; ++i)
			if (Is(value, signedNames[i])) {
				value.kind = ValueKind::Signed;
				value.size = (int64)1 << i;
			}
		for (int32 i = 0; i < 7; ++i)
			if (Is(value, unsignedNames[i])) {
				value.kind = ValueKind::Unsigned;
				value.size = unsignedSizes[i];
			}
		if (Is(value, "bool")) { value.kind = ValueKind::Bool; value.size = 1; }
		if (Is(value, "float")) { value.kind = ValueKind::Float; value.size = 4; }
		if (Is(value, "double")) { value.kind = ValueKind::Double; value.size = 8; }
		value.align = value.size;
		return value.kind != ValueKind::Unsupported;
	}

	// `T[N]`: N of T, laid out back to back.
	static ValueType DescribeFixedArray(ValueType value) {
		const Core::StringView text = value.name.View();
		int64 open = -1;
		for (int64 i = 0; i < text.ByteLength(); ++i)
			if (text.ByteAt(i) == '[') open = i;
		int64 count = 0;
		for (int64 i = open + 1; open >= 0 && i < text.ByteLength() - 1; ++i) count = count * 10 + (text.ByteAt(i) - '0');
		if (open <= 0) return value;
		value.element = Core::String(text.Substring(0, open));
		const ValueType element = DescribeValue(value.element.CStr());
		if (element.kind == ValueKind::Unsupported) return value;
		value.kind = ValueKind::FixedArray;
		value.count = count;
		value.size = element.size * count;
		value.align = element.align;
		return value;
	}

	// The type a pointer field points to: "Item*" is "Item".
	static Core::String Pointee(const char* pointer) {
		const Core::StringView text = Core::StringView(pointer);
		return Core::String(text.Substring(0, text.ByteLength() - 1));
	}

	static void DescribeArray(ValueType& value) {
		const Reflection::Field data = value.type.FindField("data");
		if (!data.IsValid()) return;
		value.element = Pointee(data.TypeName());
		value.kind = ValueKind::Array;
	}

	// A HashMap whose keys are Core::String: its KeyValue's layout, from the type of its `entries`, and where its
	// entries pointer and its table are.
	static void DescribeStringMap(ValueType& value) {
		const Reflection::Field entries = value.type.FindField("entries");
		const Reflection::Field table = value.type.FindField("table");
		if (!entries.IsValid() || !table.IsValid()) return;
		const Reflection::Type entry = FindType(Pointee(entries.TypeName()).CStr());
		const Reflection::Field key = entry.FindField("key");
		const Reflection::Field mapped = entry.FindField("value");
		if (!entry.IsValid() || !key.IsValid() || !mapped.IsValid() || key.Offset() != 0 || Core::StringView(key.TypeName()) != "Core::String") return;
		value.element = Core::String(mapped.TypeName());
		value.valueOffset = (int64)mapped.Offset();
		value.entrySize = (int64)entry.SizeOf();
		value.entryAlign = (int64)entry.AlignOf();
		value.entriesOffset = (int64)entries.Offset();
		value.tableOffset = (int64)table.Offset();
		value.kind = ValueKind::StringMap;
	}

	ValueType DescribeValue(const char* name) {
		ValueType value;
		value.name = Core::String(name);
		const Core::StringView text = value.name.View();
		if (text.EndsWith(Core::StringView("*"))) {
			value.kind = ValueKind::Pointer;
			value.size = 8;
			value.align = 8;
			return value;
		}
		if (DescribePrimitive(value)) return value;
		if (text.EndsWith(Core::StringView("]"))) return DescribeFixedArray(value);
		value.type = FindType(name);
		if (!value.type.IsValid()) return value;
		value.size = (int64)value.type.SizeOf();
		value.align = (int64)value.type.AlignOf();
		if (value.type.Kind() == Reflection::EntityKind::Enum) value.kind = ValueKind::Enum;
		else if (text == "Core::String") value.kind = ValueKind::String;
		else if (text.StartsWith(Core::StringView("Core::Array<"))) DescribeArray(value);
		else if (text.StartsWith(Core::StringView("Core::HashMap<Core::String,"))) DescribeStringMap(value);
		else if (value.type.Kind() == Reflection::EntityKind::Object || value.type.Kind() == Reflection::EntityKind::Union) value.kind = ValueKind::Object;
		return value;
	}

	// --- integers of any width --------------------------------------------------------------------------------------

	static int64 LoadSigned(const void* at, int64 size) {
		if (size == 1) return (int64)*(const int8*)at;
		if (size == 2) return (int64)*(const int16*)at;
		if (size == 4) return (int64)*(const int32*)at;
		return *(const int64*)at;
	}

	static uint64 LoadUnsigned(const void* at, int64 size) {
		if (size == 1) return (uint64)*(const uint8*)at;
		if (size == 2) return (uint64)*(const uint16*)at;
		if (size == 4) return (uint64)*(const uint32*)at;
		return *(const uint64*)at;
	}

	static void StoreInteger(void* at, int64 size, int64 value) {
		if (size == 1) *(int8*)at = (int8)value;
		else if (size == 2) *(int16*)at = (int16)value;
		else if (size == 4) *(int32*)at = (int32)value;
		else *(int64*)at = value;
	}

	// --- writing ----------------------------------------------------------------------------------------------------

	// An enumerator's name; its number when no enumerator has the value.
	static DomNode WriteEnum(DomDoc& doc, const ValueType& type, const void* at) {
		const int64 asSigned = LoadSigned(at, type.size);
		const int64 asUnsigned = (int64)LoadUnsigned(at, type.size);
		for (int64 i = 0; i < type.type.EnumCount(); ++i) {
			const int64 value = type.type.EnumAt(i).Value();
			if (value == asSigned || value == asUnsigned) return doc.NewString(type.type.EnumAt(i).Name());
		}
		return doc.NewInt(asSigned);
	}

	static DomNode WriteElements(DomDoc& doc, const char* elementName, const void* first, int64 count) {
		const ValueType element = DescribeValue(elementName);
		DomNode array = doc.NewArray();
		for (int64 i = 0; i < count; ++i) doc.Add(array, WriteValue(doc, element, (const void*)((const uint8*)first + i * element.size)));
		return array;
	}

	// The parts of the map at `at`, where reflection says they are: its entries pointer and its table.
	static void** MapEntries(const ValueType& type, const void* at) { return (void**)((uint8*)at + type.entriesOffset); }
	static Core::HashTable& MapTable(const ValueType& type, const void* at) { return *(Core::HashTable*)((uint8*)at + type.tableOffset); }

	// A map's entry at `slot`: a KeyValue<Core::String, V> of `entrySize` bytes, its key first.
	static uint8* EntryAt(void* entries, int64 slot, int64 entrySize) { return (uint8*)entries + slot * entrySize; }

	// A JSON object in the map's own order.
	static DomNode WriteStringMap(DomDoc& doc, const ValueType& type, const void* at) {
		const Core::HashTable& map = MapTable(type, at);
		void* entries = *MapEntries(type, at);
		const ValueType mapped = DescribeValue(type.element.CStr());
		DomNode object = doc.NewObject();
		for (int64 i = Core::NextLiveSlot(map, 0); i < map.capacity; i = Core::NextLiveSlot(map, i + 1)) {
			const uint8* entry = EntryAt(entries, i, type.entrySize);
			doc.AddMember(object, ((const Core::String*)entry)->View(), WriteValue(doc, mapped, (const void*)(entry + type.valueOffset)));
		}
		return object;
	}

	static DomNode WriteObject(DomDoc& doc, Reflection::Type type, const void* at) {
		DomNode object = doc.NewObject();
		for (Reflection::Field field : type) {
			if (field.IsAlias()) continue;
			const ValueType fieldType = DescribeValue(field.TypeName());
			doc.AddMember(object, field.Name(), WriteValue(doc, fieldType, (const void*)((const uint8*)at + field.Offset())));
		}
		return object;
	}

	DomNode WriteValue(DomDoc& doc, const ValueType& type, const void* at) {
		const ValueKind kind = type.kind;
		if (kind == ValueKind::Bool) return doc.NewBool(*(const bool*)at);
		if (kind == ValueKind::Signed) return doc.NewInt(LoadSigned(at, type.size));
		if (kind == ValueKind::Unsigned) return doc.NewInt((int64)LoadUnsigned(at, type.size));
		if (kind == ValueKind::Float) return doc.NewFloat((double)*(const float*)at);
		if (kind == ValueKind::Double) return doc.NewFloat(*(const double*)at);
		if (kind == ValueKind::String) return doc.NewString(((const Core::String*)at)->View());
		if (kind == ValueKind::Enum) return WriteEnum(doc, type, at);
		if (kind == ValueKind::Array) {
			const Core::ArrayLayout* array = (const Core::ArrayLayout*)at;
			return WriteElements(doc, type.element.CStr(), (const void*)array->data, array->count);
		}
		if (kind == ValueKind::FixedArray) return WriteElements(doc, type.element.CStr(), at, type.count);
		if (kind == ValueKind::StringMap) return WriteStringMap(doc, type, at);
		if (kind == ValueKind::Object) return WriteObject(doc, type.type, at);
		return doc.NewNull();
	}

	// --- reading ----------------------------------------------------------------------------------------------------

	static bool IsNumber(const DomNode& node) { return node.Kind() == DomKind::Int || node.Kind() == DomKind::Float; }

	// An enumerator's name, or a number.
	static bool ReadEnum(const DomNode& node, const ValueType& type, void* at) {
		if (node.Kind() == DomKind::Int) {
			StoreInteger(at, type.size, node.AsInt());
			return true;
		}
		if (node.Kind() != DomKind::String) return false;
		for (int64 i = 0; i < type.type.EnumCount(); ++i)
			if (node.AsView() == type.type.EnumAt(i).Name()) {
				StoreInteger(at, type.size, type.type.EnumAt(i).Value());
				return true;
			}
		return false;
	}

	static bool ReadElements(const DomNode& node, const ValueType& element, void* first) {
		for (int64 i = 0; i < node.Count(); ++i)
			if (!ReadValue(node.At(i), element, (void*)((uint8*)first + i * element.size))) return false;
		return true;
	}

	// A value the reader adds (an array's element, a map's value) at zero storage `at`, started as `new (at) T()` starts
	// it: an object's field initializers and creates run; every other kind starts zero. False when it cannot start.
	static bool Construct(const ValueType& type, void* at) {
		return type.kind != ValueKind::Object || type.type.Construct(at);
	}

	static bool ConstructElements(const ValueType& element, void* first, int64 count) {
		for (int64 i = 0; i < count; ++i)
			if (!Construct(element, (void*)((uint8*)first + i * element.size))) return false;
		return true;
	}

	static bool ReadArray(const DomNode& node, const ValueType& type, void* at) {
		const ValueType element = DescribeValue(type.element.CStr());
		if (node.Kind() != DomKind::Array || element.kind == ValueKind::Unsupported) return false;
		if (element.kind == ValueKind::Object && !element.type.IsDefaultConstructible()) return false;
		if (!Core::ResizeEmptyArray(at, node.Count(), element.size, element.align)) return false;
		void* first = ((Core::ArrayLayout*)at)->data;
		return ConstructElements(element, first, node.Count()) && ReadElements(node, element, first);
	}

	static bool ReadFixedArray(const DomNode& node, const ValueType& type, void* at) {
		if (node.Kind() != DomKind::Array || node.Count() > type.count) return false;
		return ReadElements(node, DescribeValue(type.element.CStr()), at);
	}

	// Room for `members` keys in an empty map, as HashMap::Reserve gives it.
	static void ReserveMap(Core::HashTable& map, void** entries, int64 members, const ValueType& type) {
		Core::FreeTable(map, *entries, type.entryAlign);
		*entries = Core::AllocateTable(map, Core::CapacityFor(members), type.entrySize, type.entryAlign);
	}

	// The live slot holding `key`, or -1; the key hashes as a Core::String does.
	static int64 SlotOfKey(const Core::HashTable& map, void* entries, Core::StringView key, int64 entrySize) {
		return Core::FindSlot(map, key.Hash(), [entries, key, entrySize](int64 slot) -> bool { return ((const Core::String*)EntryAt(entries, slot, entrySize))->View() == key; });
	}

	// A new entry for `key` (the map has room), its value zero.
	static uint8* AddKey(Core::HashTable& map, void* entries, Core::StringView key, int64 entrySize) {
		const uint64 hash = key.Hash();
		const int64 slot = Core::FreeSlot(map, hash);
		Core::Occupy(map, slot, hash);
		uint8* entry = EntryAt(entries, slot, entrySize);
		new ((Core::String*)entry) Core::String(key);
		return entry;
	}

	static bool ReadStringMap(const DomNode& node, const ValueType& type, void* at) {
		Core::HashTable& map = MapTable(type, at);
		void** entries = MapEntries(type, at);
		if (node.Kind() != DomKind::Object || map.count != 0) return false;
		if (node.Count() == 0) return true;
		const ValueType mapped = DescribeValue(type.element.CStr());
		if (mapped.kind == ValueKind::Object && !mapped.type.IsDefaultConstructible()) return false;
		ReserveMap(map, entries, node.Count(), type);
		for (int64 i = 0; i < node.Count(); ++i) {
			const Core::StringView key = node.KeyAt(i);
			if (SlotOfKey(map, *entries, key, type.entrySize) >= 0) continue;   // the first of duplicate keys stays
			uint8* entry = AddKey(map, *entries, key, type.entrySize);
			void* value = (void*)(entry + type.valueOffset);
			if (!Construct(mapped, value) || !ReadValue(node.ValueAt(i), mapped, value)) return false;
		}
		return true;
	}

	int32 ReadFields(const DomNode& node, Reflection::Type type, void* at) {
		if (node.Kind() != DomKind::Object) return -1;
		int32 applied = 0;
		for (Reflection::Field field : type) {
			if (field.IsAlias()) continue;
			const DomNode value = node.Member(field.Name());
			if (value.IsNull()) continue;
			const ValueType fieldType = DescribeValue(field.TypeName());
			if (fieldType.kind == ValueKind::Pointer || fieldType.kind == ValueKind::Unsupported) continue;
			if (!ReadValue(value, fieldType, (void*)((uint8*)at + field.Offset()))) return -1;
			applied += 1;
		}
		return applied;
	}

	bool ReadValue(const DomNode& node, const ValueType& type, void* at) {
		const ValueKind kind = type.kind;
		if (kind == ValueKind::Bool && node.Kind() == DomKind::Bool) *(bool*)at = node.AsBool();
		else if ((kind == ValueKind::Signed || kind == ValueKind::Unsigned) && IsNumber(node)) StoreInteger(at, type.size, node.AsInt());
		else if (kind == ValueKind::Float && IsNumber(node)) *(float*)at = (float)node.AsFloat();
		else if (kind == ValueKind::Double && IsNumber(node)) *(double*)at = node.AsFloat();
		else if (kind == ValueKind::String && node.Kind() == DomKind::String) *(Core::String*)at = Core::String(node.AsView());
		else if (kind == ValueKind::Enum) return ReadEnum(node, type, at);
		else if (kind == ValueKind::Array) return ReadArray(node, type, at);
		else if (kind == ValueKind::FixedArray) return ReadFixedArray(node, type, at);
		else if (kind == ValueKind::StringMap) return ReadStringMap(node, type, at);
		else if (kind == ValueKind::Object) return ReadFields(node, type.type, at) >= 0;
		else return kind == ValueKind::Pointer || kind == ValueKind::Unsupported;
		return true;
	}
}
