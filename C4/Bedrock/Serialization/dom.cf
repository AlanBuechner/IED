include "dom.ch"

namespace Serialization
{
	const int32 kMemberInts = 3;   // key offset, key length, value index

	// ---- DomNode -------------------------------------------------------------------------------------

	bool DomNode::IsValid() const { return doc != nullptr && index >= 0 && index < doc->recordCount; }

	DomKind DomNode::Kind() const { return IsValid() ? doc->records[index].kind : DomKind::Null; }

	int64 DomNode::AsInt() const {
		DomKind kind = Kind();
		if (kind == DomKind::Int) return doc->records[index].bits;
		if (kind == DomKind::Float) return (int64)AsFloat();
		return 0;
	}

	double DomNode::AsFloat() const {
		DomKind kind = Kind();
		if (kind == DomKind::Float) return reinterpret_cast<double>(doc->records[index].bits);
		if (kind == DomKind::Int) return (double)doc->records[index].bits;
		return 0.0;
	}

	bool DomNode::AsBool() const { return Kind() == DomKind::Bool && doc->records[index].bits != 0; }

	const char* DomNode::AsString() const { return Kind() == DomKind::String ? doc->pool + doc->records[index].offset : ""; }

	Core::StringView DomNode::AsView() const {
		if (Kind() != DomKind::String) return Core::StringView("");
		return Core::StringView(doc->pool + doc->records[index].offset, (int64)doc->records[index].count);
	}

	int64 DomNode::Count() const {
		DomKind kind = Kind();
		return kind == DomKind::Object || kind == DomKind::Array ? (int64)doc->records[index].count : 0;
	}

	DomNode DomNode::Member(const char* key) const {
		Core::StringView wanted = Core::StringView(key);
		for (int64 i = 0; i < Count() && Kind() == DomKind::Object; ++i)
			if (KeyAt(i) == wanted) return ValueAt(i);
		DomNode missing;
		missing.doc = doc;
		return missing;
	}

	Core::StringView DomNode::KeyAt(int64 i) const {
		if (Kind() != DomKind::Object || i < 0 || i >= Count()) return Core::StringView("");
		const int32* member = doc->records[index].children + i * kMemberInts;
		return Core::StringView(doc->pool + member[0], (int64)member[1]);
	}

	DomNode DomNode::ValueAt(int64 i) const {
		DomNode value;
		value.doc = doc;
		if (Kind() == DomKind::Object && i >= 0 && i < Count()) value.index = doc->records[index].children[i * kMemberInts + 2];
		return value;
	}

	DomNode DomNode::At(int64 i) const {
		DomNode element;
		element.doc = doc;
		if (Kind() == DomKind::Array && i >= 0 && i < Count()) element.index = doc->records[index].children[i];
		return element;
	}

	// ---- DomDoc: the arena ------------------------------------------------------------------------------

	[operator("delete")] void DomDoc::Delete() {
		for (int32 i = 0; i < recordCount; ++i) raw_free((void*)records[i].children);
		raw_free((void*)records);
		raw_free((void*)pool);
		records = nullptr;
		pool = nullptr;
		recordCount = 0;
		recordCapacity = 0;
		poolLength = 0;
		poolCapacity = 0;
	}

	void DomDoc::ReserveRecords(int64 count) {
		if (count <= recordCapacity) return;
		int32 grown = recordCapacity < 16 ? 16 : recordCapacity * 2;
		while (grown < count) grown *= 2;
		DomRecord* larger = (DomRecord*)raw_alloc((uint64)grown * sizeof(DomRecord));
		if (recordCount > 0) memcpy((void*)larger, (void*)records, (uint64)recordCount * sizeof(DomRecord));
		raw_free((void*)records);
		records = larger;
		recordCapacity = grown;
	}

	void DomDoc::ReserveChildren(DomRecord* record, int64 ints) {
		if (ints <= record->childCapacity) return;
		int32 grown = record->childCapacity < 4 ? 4 : record->childCapacity * 2;
		while (grown < ints) grown *= 2;
		int32* larger = (int32*)raw_alloc((uint64)grown * sizeof(int32));
		if (record->childCapacity > 0) memcpy((void*)larger, (void*)record->children, (uint64)record->childCapacity * sizeof(int32));
		raw_free((void*)record->children);
		record->children = larger;
		record->childCapacity = grown;
	}

	DomNode DomDoc::Append(DomKind kind, int64 bits) {
		ReserveRecords(recordCount + 1);
		DomRecord* record = &records[recordCount];
		record->kind = kind;
		record->bits = bits;
		record->offset = 0;
		record->count = 0;
		record->children = nullptr;
		record->childCapacity = 0;
		DomNode node;
		node.doc = this;
		node.index = recordCount;
		recordCount += 1;
		return node;
	}

	int32 DomDoc::Intern(Core::StringView text) {
		int64 needed = poolLength + text.ByteLength() + 1;
		if (needed > poolCapacity) {
			int32 grown = poolCapacity < 256 ? 256 : poolCapacity * 2;
			while (grown < needed) grown *= 2;
			char* larger = (char*)raw_alloc((uint64)grown);
			if (poolLength > 0) memcpy((void*)larger, (void*)pool, (uint64)poolLength);
			raw_free((void*)pool);
			pool = larger;
			poolCapacity = grown;
		}
		int32 offset = poolLength;
		memcpy((void*)(pool + offset), (void*)text.Data(), (uint64)text.ByteLength());
		pool[offset + text.ByteLength()] = (char)0;
		poolLength = (int32)needed;
		return offset;
	}

	DomNode DomDoc::NewString(Core::StringView text) {
		int32 offset = Intern(text);
		DomNode node = Append(DomKind::String, 0);
		records[node.index].offset = offset;
		records[node.index].count = (int32)text.ByteLength();
		return node;
	}

	void DomDoc::AddMember(const DomNode& object, Core::StringView key, const DomNode& value) {
		int32 keyOffset = Intern(key);
		DomRecord* record = &records[object.index];
		ReserveChildren(record, (record->count + 1) * kMemberInts);
		int32* member = record->children + record->count * kMemberInts;
		member[0] = keyOffset;
		member[1] = (int32)key.ByteLength();
		member[2] = value.index;
		record->count += 1;
	}

	void DomDoc::Add(const DomNode& array, const DomNode& value) {
		DomRecord* record = &records[array.index];
		ReserveChildren(record, record->count + 1);
		record->children[record->count] = value.index;
		record->count += 1;
	}

	// ---- reflection bridge -----------------------------------------------------------------------------

	DomNode DomDoc::ReflectFrom(Reflection::Type type, const void* object) {
		if (!type.IsValid() || type.FieldCount() == 0) return NewNull();
		const char* base = (const char*)object;
		DomNode result = NewObject();
		for (Reflection::Field field : type) {
			if (field.IsAlias()) continue;
			const char* at = base + field.Offset();
			Reflection::Type fieldType = field.TypeOf();
			const char* name = field.TypeName();
			DomNode value;
			if (fieldType.IsValid() && fieldType.FieldCount() > 0) value = ReflectFrom(fieldType, at);
			else if (strcmp(name, "bool") == 0) value = NewBool(*(const bool*)at);
			else if (strcmp(name, "float") == 0) value = NewFloat((double)*(const float*)at);
			else if (strcmp(name, "double") == 0) value = NewFloat(*(const double*)at);
			else if (field.SizeOf() == 1) value = NewInt((int64)*(const int8*)at);
			else if (field.SizeOf() == 2) value = NewInt((int64)*(const int16*)at);
			else if (field.SizeOf() == 4) value = NewInt((int64)*(const int32*)at);
			else if (field.SizeOf() == 8) value = NewInt(*(const int64*)at);
			else value = NewNull();
			AddMember(result, field.Name(), value);
		}
		return result;
	}

	int32 DomDoc::ReflectTo(Reflection::Type type, const DomNode& object, void* destination) {
		if (!type.IsValid() || object.Kind() != DomKind::Object) return -1;
		char* base = (char*)destination;
		int32 applied = 0;
		for (Reflection::Field field : type) {
			if (field.IsAlias()) continue;
			DomNode value = object.Member(field.Name());
			if (value.IsNull()) continue;
			char* at = base + field.Offset();
			Reflection::Type fieldType = field.TypeOf();
			const char* name = field.TypeName();
			if (fieldType.IsValid() && fieldType.FieldCount() > 0) {
				if (ReflectTo(fieldType, value, at) < 0) return -1;
			}
			else if (strcmp(name, "bool") == 0) *(bool*)at = value.AsBool();
			else if (strcmp(name, "float") == 0) *(float*)at = (float)value.AsFloat();
			else if (strcmp(name, "double") == 0) *(double*)at = value.AsFloat();
			else if (field.SizeOf() == 1) *(int8*)at = (int8)value.AsInt();
			else if (field.SizeOf() == 2) *(int16*)at = (int16)value.AsInt();
			else if (field.SizeOf() == 4) *(int32*)at = (int32)value.AsInt();
			else if (field.SizeOf() == 8) *(int64*)at = value.AsInt();
			else continue;
			applied += 1;
		}
		return applied;
	}
}
