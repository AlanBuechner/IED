include "json.ch"
include "jsontokens.ch"

namespace Serialization
{
	bool IsFinite(double value) { return value - value == 0.0; }

	// A sign and digits only: no point, exponent, `nan` or `inf`.
	static bool IsIntegerText(Core::StringView text) {
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			if ((c < '0' || c > '9') && c != '-') return false;
		}
		return true;
	}

	// A float reads back as one: `.0` goes after a value written as an integer.
	void WriteFloatText(double value, Core::StringBuilder* out) {
		int64 start = out->ByteLength();
		out->AppendDouble(value, -1);
		if (IsIntegerText(out->View().Substring(start, -1))) out->Append(".0");
	}

	// One byte a JSON string cannot hold as it is: a quote, a backslash or a control character.
	static void WriteJsonEscape(int32 c, Core::StringBuilder* out) {
		if (c == '"') out->Append("\\\"");
		else if (c == '\\') out->Append("\\\\");
		else if (c == '\n') out->Append("\\n");
		else if (c == '\r') out->Append("\\r");
		else if (c == '\t') out->Append("\\t");
		else if (c == 8) out->Append("\\b");
		else if (c == 12) out->Append("\\f");
		else { out->Append("\\u"); out->AppendUIntBase((uint64)c, 16, 4); }
	}

	// The runs of bytes that need no escape are found sixteen at a time and appended whole.
	void WriteJsonString(Core::StringView text, Core::StringBuilder* out) {
		if (!text.IsValidUtf8()) {
			Core::String valid = Core::ValidUtf8(text);
			WriteJsonString(valid.View(), out);
			return;
		}
		out->AppendByte('"');
		const char* bytes = text.Data();
		const int64 end = text.ByteLength();
		for (int64 at = 0; at < end;) {
			const int64 run = PlainStringRunEnd(bytes, at, end);
			out->AppendBytes(bytes + at, run - at);
			if (run == end) break;
			WriteJsonEscape(text.ByteAt(run), out);
			at = run + 1;
		}
		out->AppendByte('"');
	}

	void WriteJsonLine(Core::StringBuilder* out, int32 indent, int32 depth) {
		if (indent <= 0) return;
		out->AppendByte('\n');
		for (int32 s = 0; s < indent * depth; ++s) out->AppendByte(' ');
	}

	void WriteJsonAt(const DomNode& node, Core::StringBuilder* out, int32 indent, int32 depth) {
		DomKind kind = node.Kind();
		if (kind == DomKind::Null) { out->Append("null"); return; }
		if (kind == DomKind::Bool) { out->Append(node.AsBool() ? "true" : "false"); return; }
		if (kind == DomKind::Int) { out->AppendInt(node.AsInt()); return; }
		if (kind == DomKind::Float) { if (IsFinite(node.AsFloat())) WriteFloatText(node.AsFloat(), out); else out->Append("null"); return; }
		if (kind == DomKind::String) { WriteJsonString(node.AsView(), out); return; }
		bool array = kind == DomKind::Array;
		out->AppendByte(array ? '[' : '{');
		for (int64 i = 0; i < node.Count(); ++i) {
			if (i > 0) out->AppendByte(',');
			WriteJsonLine(out, indent, depth + 1);
			if (!array) { WriteJsonString(node.KeyAt(i), out); out->Append(indent > 0 ? ": " : ":"); }
			WriteJsonAt(array ? node.At(i) : node.ValueAt(i), out, indent, depth + 1);
		}
		if (node.Count() > 0) WriteJsonLine(out, indent, depth);
		out->AppendByte(array ? ']' : '}');
	}

	void WriteJson(const DomNode& node, Core::StringBuilder* out, int32 indent) { WriteJsonAt(node, out, indent, 0); }
}
