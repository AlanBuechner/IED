include "jsonreader.ch"
include "jsontokens.ch"

namespace Serialization
{
	// One pass over the text. A step that fails records the first error and returns an invalid node or false,
	// and every caller stops there.
	class JsonReader
	{
		[operator("create")] public void Init(Core::StringView text, DomDoc* doc) { this.text = text; this.doc = doc; }

		public ReadResult Read();

	private:
		private DomNode Value();
		private DomNode Object();
		private DomNode Array();
		private DomNode Number();
		private bool Word(const char* word);
		// The string at the opening quote, as a view of the text or of `scratch` (when it has escapes).
		private bool StringAt(Core::StringView& out);
		// The container whose children were pushed on `pending` from `start` on, made and taken off the stack.
		private DomNode CloseObject(int64 start);
		private DomNode CloseArray(int64 start);
		private bool Enter();
		private void Leave() { depth -= 1; }
		private void SkipSpace();
		private int32 Peek() const { return position < text.ByteLength() ? text.ByteAt(position) : -1; }
		private bool At(int32 byte) const { return Peek() == byte; }
		private DomNode Fail(const char* message) { return FailAt(position, message); }
		private DomNode FailAt(int64 offset, const char* message);
		private bool Failed() const { return error != nullptr; }

		private Core::StringView text;
		private DomDoc* doc;
		private int64 position;
		private int32 depth;
		private const char* error;
		private int64 errorAt;
		private Core::StringBuilder scratch;   // an escaped string being read; one at a time
		private Core::Array<int32> pending;    // the children of the open containers, innermost last
	}

	ReadResult JsonReader::Read() {
		int64 invalid = Core::InvalidUtf8Offset(text.Data(), text.ByteLength());
		if (invalid >= 0) return ReadFailure(text, invalid, "the text is not valid UTF-8");
		if (text.StartsWith(Core::StringView("\xEF\xBB\xBF"))) position = 3;
		SkipSpace();
		DomNode root = Value();
		SkipSpace();
		if (!Failed() && position < text.ByteLength()) Fail("unexpected text after the value");
		return Failed() ? ReadFailure(text, errorAt, error) : ReadSuccess(root);
	}

	DomNode JsonReader::Value() {
		int32 c = Peek();
		if (c == '{') return Object();
		if (c == '[') return Array();
		if (c == '-' || IsDecimalDigit(c)) return Number();
		if (c == '"') {
			Core::StringView value;
			return StringAt(value) ? doc->NewString(value) : DomNode();
		}
		if (c == 't') return Word("true") ? doc->NewBool(true) : DomNode();
		if (c == 'f') return Word("false") ? doc->NewBool(false) : DomNode();
		if (c == 'n') return Word("null") ? doc->NewNull() : DomNode();
		return Fail(c < 0 ? "the text ends where a value should be" : "a value cannot start here");
	}

	DomNode JsonReader::Object() {
		if (!Enter()) return DomNode();
		position += 1;
		const int64 start = pending.Count();
		SkipSpace();
		if (At('}')) { position += 1; Leave(); return CloseObject(start); }
		for (;;) {
			if (!At('"')) return Fail(Peek() < 0 ? "the text ends inside an object" : "a member's name must be a string");
			Core::StringView name;
			if (!StringAt(name)) return DomNode();
			pending.Push(doc->Key(name));   // into the pool now: the value's own strings reuse the scratch
			pending.Push((int32)name.ByteLength());
			SkipSpace();
			if (!At(':')) return Fail("expected ':' after a member's name");
			position += 1;
			SkipSpace();
			DomNode value = Value();
			if (Failed()) return DomNode();
			pending.Push(value.index);
			SkipSpace();
			if (At('}')) { position += 1; Leave(); return CloseObject(start); }
			if (!At(',')) return Fail(Peek() < 0 ? "the text ends inside an object" : "expected ',' or '}' after a member");
			position += 1;
			SkipSpace();
		}
	}

	DomNode JsonReader::Array() {
		if (!Enter()) return DomNode();
		position += 1;
		const int64 start = pending.Count();
		SkipSpace();
		if (At(']')) { position += 1; Leave(); return CloseArray(start); }
		for (;;) {
			DomNode element = Value();
			if (Failed()) return DomNode();
			pending.Push(element.index);
			SkipSpace();
			if (At(']')) { position += 1; Leave(); return CloseArray(start); }
			if (!At(',')) return Fail(Peek() < 0 ? "the text ends inside an array" : "expected ',' or ']' after an element");
			position += 1;
			SkipSpace();
		}
	}

	DomNode JsonReader::Number() {
		JsonNumber number;
		JsonFault fault;
		if (!ReadJsonNumber(text, position, number, fault)) return FailAt(fault.at, fault.error);
		return number.integral ? doc->NewInt(number.integer) : doc->NewFloat(number.real);
	}

	bool JsonReader::Word(const char* word) {
		Core::StringView expected = Core::StringView(word);
		if (!text.Substring(position, expected.ByteLength()).Equals(expected)) { Fail("a value cannot start here"); return false; }
		position += expected.ByteLength();
		return true;
	}

	bool JsonReader::StringAt(Core::StringView& out) {
		JsonFault fault;
		if (ReadJsonStringView(text, position, scratch, out, fault)) return true;
		FailAt(fault.at, fault.error);
		return false;
	}

	DomNode JsonReader::CloseObject(int64 start) {
		DomNode object = doc->NewObjectOf(pending.Data() + start, (pending.Count() - start) / kMemberInts);
		pending.RemoveRange(start, pending.Count());
		return object;
	}

	DomNode JsonReader::CloseArray(int64 start) {
		DomNode array = doc->NewArrayOf(pending.Data() + start, pending.Count() - start);
		pending.RemoveRange(start, pending.Count());
		return array;
	}

	bool JsonReader::Enter() {
		depth += 1;
		if (depth <= kMaxJsonDepth) return true;
		Fail("objects and arrays nest too deeply");
		return false;
	}

	void JsonReader::SkipSpace() {
		for (int32 c = Peek(); c == ' ' || c == '\t' || c == '\n' || c == '\r'; c = Peek()) position += 1;
	}

	DomNode JsonReader::FailAt(int64 offset, const char* message) {
		if (!error) { error = message; errorAt = offset; }
		return DomNode();
	}

	ReadResult ReadJson(Core::StringView text, DomDoc& doc) {
		JsonReader reader = JsonReader(text, &doc);
		return reader.Read();
	}
}
