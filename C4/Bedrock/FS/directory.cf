include "directory.ch"
include "info.ch"

namespace FS
{
	[operator("create")] void Directory::Init(const char* path) { handle = fs_directory_open(path); }

	void Directory::Close() {
		if (handle) fs_directory_close(handle);
		handle = nullptr;
	}

	bool Directory::Next(DirectoryEntry& entry) {
		if (!handle) return false;
		char[kMaxEntryNameBytes] name;
		int32 kind = 0;
		int32 length = fs_directory_next(handle, &name[0], kMaxEntryNameBytes, &kind);
		if (length <= 0) return false;
		entry.name = Core::String(Core::StringView(&name[0], (int64)length));
		entry.kind = (EntryKind)kind;
		return true;
	}

	DirectoryIterator Directory::Begin() {
		DirectoryIterator it;
		it.directory = this;
		it.done = !Next(it.entry);
		return it;
	}

	DirectoryIterator DirectoryIterator::Next() {
		DirectoryIterator next = *this;
		next.done = !directory->Next(next.entry);
		return next;
	}

	bool IsDirectory(const char* path) { return fs_is_directory(path) != 0; }

	bool IsLink(const char* path) { return fs_is_link(path) != 0; }

	bool MakeDirectory(const char* path) { return fs_make_directory(path) == 0; }

	bool MakeDirectories(const char* path) {
		if (IsDirectory(path)) return true;
		Path target = Path(path);
		Path parent = target.Parent();
		if (!parent.IsEmpty() && !(parent == target) && !MakeDirectories(parent.CStr())) return false;
		return MakeDirectory(path) || IsDirectory(path);
	}

	bool RemoveEmptyDirectory(const char* path) { return fs_remove_directory(path) == 0; }

	bool Rename(const char* from, const char* to) { return fs_rename(from, to) == 0; }

	// The paths of a directory's entries, read before any is removed.
	Core::Array<Path> EntryPaths(const char* directory) {
		Core::Array<Path> paths;
		Directory listing = Directory(directory);
		DirectoryEntry entry;
		while (listing.Next(entry)) paths.Push(Path(directory) / entry.name.View());
		return paths;
	}

	int64 RemoveTree(const char* path) {
		int64 removed = 0;
		Core::Array<Path> children = EntryPaths(path);
		for (const Path& child : children) {
			int64 count = RemoveAll(child.CStr());
			if (count < 0) return -1;
			removed += count;
		}
		return RemoveEmptyDirectory(path) ? removed + 1 : -1;
	}

	// A read-only file is made writable first, as a tool's own files often are (git's objects).
	static bool RemoveAnyFile(const char* path, bool readOnly) {
		if (readOnly) SetReadOnly(path, false);
		return RemoveFile(path);
	}

	// By what the entry itself is: a link goes, not what it points to.
	int64 RemoveAll(const char* path) {
		FileInfo info;
		if (!GetInfo(path, info, false)) return 0;
		if (info.kind == EntryKind::Link) return RemoveEmptyDirectory(path) || RemoveFile(path) ? 1 : -1;
		if (info.kind == EntryKind::Directory) return RemoveTree(path);
		return RemoveAnyFile(path, info.readOnly) ? 1 : -1;
	}
}
