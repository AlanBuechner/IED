include "file.ch"
include "../Platform/system.ch"
include "../Text/stringbuilder.ch"

namespace FS
{
	[operator("create")] void File::Init(const char* path, const char* mode) { handle = file_open(path, mode); }

	void File::Close() {
		if (handle) file_close(handle);
		handle = nullptr;
	}

	int64 File::Read(void* buffer, int64 count) {
		if (!handle || !buffer || count <= 0) return -1;
		return file_read(handle, buffer, count);
	}

	int64 File::Write(const void* bytes, int64 count) {
		if (!handle || !bytes || count <= 0) return -1;
		return file_write(handle, (void*)bytes, count);
	}

	bool File::Flush() { return handle && file_flush(handle) == 0; }

	[link("c4_file_sync")] int32 c4_file_sync(void* file);
	[link("c4_fs_replace")] int32 c4_fs_replace(const char* from, const char* to);

	bool File::Sync() { return handle && c4_file_sync(handle) == 0; }

	// "<path>.tmp-<8 random hex digits>": two writers of one file never share a temporary.
	static Core::String TemporaryBeside(const char* path) {
		uint8[4] bytes;
		Platform::RandomBytes((void*)&bytes[0], 4);
		Core::StringBuilder name;
		name.Append(path);
		name.Append(".tmp-");
		for (int32 i = 0; i < 4; ++i) name.AppendUIntBase((uint64)bytes[i], 16, 2);
		return name.ToString();
	}

	bool WriteFileAtomically(const char* path, const void* bytes, int64 count) {
		Core::String temporary = TemporaryBeside(path);
		File out = File(temporary.CStr(), "wb");
		if (!out.IsOpen()) return false;
		const bool written = (count == 0 || out.Write(bytes, count) == count) && out.Sync();
		out.Close();
		if (written && c4_fs_replace(temporary.CStr(), path) == 0) return true;
		RemoveFile(temporary.CStr());
		return false;
	}

	int64 File::Seek(int64 offset, SeekOrigin origin) {
		if (!handle) return -1;
		return file_seek_from(handle, offset, (int32)origin);
	}

	int64 File::Tell() const { return handle ? file_tell(handle) : -1; }

	int64 File::ReadAll(void* buffer, int64 capacity) {
		if (!handle || !buffer || capacity <= 0) return -1;
		int64 total = 0;
		while (total < capacity) {
			int64 got = file_read(handle, (char*)buffer + total, capacity - total);
			if (got <= 0) break;
			total += got;
		}
		return total;
	}

	Core::String File::ReadText() {
		Core::String text;
		char[kReadTextChunkBytes] chunk;
		while (handle) {
			int64 got = file_read(handle, &chunk[0], kReadTextChunkBytes);
			if (got <= 0) break;
			text.Append(Core::StringView(&chunk[0], got));
		}
		return text;
	}

	bool FileExists(const char* path) { return file_exists(path) != 0; }

	int64 FileSize(const char* path) { return file_size(path); }

	bool RemoveFile(const char* path) { return file_delete(path) == 0; }
}
