// The WebView2 side of a window (docs/27 "The page and its keys"): its controller and settings, where navigations
// go, the page's messages, permissions, and recovering from a crashed renderer.

include "window.ch"
include "app.ch"

namespace Desktop
{
	void Window::Attach(ICoreWebView2Environment* environment) {
		Window* self = this;
		Callback* ready = callbacks.Add(__uuidof(ICoreWebView2CreateCoreWebView2ControllerCompletedHandler),
			[self](void* error, void* created) -> int32 {
				self->ControllerReady(Hresult(error), created);
				return kOk;
			});
		const int32 started = environment->CreateCoreWebView2Controller(hwnd, (void*)ready);
		if (started != kOk) app->Report(Core::StringView("the WebView2 control could not be created"), started);
	}

	void Window::ControllerReady(int32 error, void* created) {
		if (error != kOk || created == null) {
			app->Report(Core::StringView("the WebView2 control could not be created"), error);
			return;
		}
		if (hwnd == null) return;
		controller = (ICoreWebView2Controller*)created;
		controller->AddRef();
		void* view = null;
		controller->get_CoreWebView2(&view);
		webview = (ICoreWebView2*)view;
		Configure();
		Listen();
		Fit();
		ShowPending();
	}

	void Window::Configure() {
		void* found = null;
		ICoreWebView2Settings* settings = null;
		webview->get_Settings((void**)&settings);
		settings->put_IsStatusBarEnabled(0);
		settings->put_IsZoomControlEnabled(0);
		settings->put_AreDevToolsEnabled(1);
		settings->put_AreDefaultContextMenusEnabled(1);
		if (settings->QueryInterface(__uuidof(ICoreWebView2Settings3), &found) == kOk) {
			ICoreWebView2Settings3* keys = (ICoreWebView2Settings3*)found;
			keys->put_AreBrowserAcceleratorKeysEnabled(0);
			keys->Release();
		}
		found = null;
		if (controller->QueryInterface(__uuidof(ICoreWebView2Controller2), &found) == kOk) {
			ICoreWebView2Controller2* colored = (ICoreWebView2Controller2*)found;
			COREWEBVIEW2_COLOR background;
			background.A = 255;
			background.R = 14;
			background.G = 14;
			background.B = 14;
			colored->put_DefaultBackgroundColor(background);
			colored->Release();
		}
		Core::Array<char16> script = Wide(BridgeScript(Core::StringView(kDesktopVersion)).View());
		webview->AddScriptToExecuteOnDocumentCreated(script.Data(), null);
	}

	void Window::Listen() {
		Window* self = this;
		EventRegistrationToken token;
		webview->add_DocumentTitleChanged((void*)callbacks.Add(__uuidof(ICoreWebView2DocumentTitleChangedEventHandler),
			[self](void* sender, void* args) -> int32 { self->TitleChanged(); return kOk; }), &token);
		webview->add_NavigationStarting((void*)callbacks.Add(__uuidof(ICoreWebView2NavigationStartingEventHandler),
			[self](void* sender, void* args) -> int32 { return self->NavigationStarting((ICoreWebView2NavigationStartingEventArgs*)args); }), &token);
		webview->add_NavigationCompleted((void*)callbacks.Add(__uuidof(ICoreWebView2NavigationCompletedEventHandler),
			[self](void* sender, void* args) -> int32 { return self->NavigationCompleted((ICoreWebView2NavigationCompletedEventArgs*)args); }), &token);
		webview->add_NewWindowRequested((void*)callbacks.Add(__uuidof(ICoreWebView2NewWindowRequestedEventHandler),
			[self](void* sender, void* args) -> int32 { return self->NewWindowRequested((ICoreWebView2NewWindowRequestedEventArgs*)args); }), &token);
		webview->add_WebMessageReceived((void*)callbacks.Add(__uuidof(ICoreWebView2WebMessageReceivedEventHandler),
			[self](void* sender, void* args) -> int32 { return self->MessageReceived((ICoreWebView2WebMessageReceivedEventArgs*)args); }), &token);
		webview->add_PermissionRequested((void*)callbacks.Add(__uuidof(ICoreWebView2PermissionRequestedEventHandler),
			[self](void* sender, void* args) -> int32 { return self->PermissionRequested((ICoreWebView2PermissionRequestedEventArgs*)args); }), &token);
		webview->add_ProcessFailed((void*)callbacks.Add(__uuidof(ICoreWebView2ProcessFailedEventHandler),
			[self](void* sender, void* args) -> int32 { return self->ProcessFailed((ICoreWebView2ProcessFailedEventArgs*)args); }), &token);
	}

	void Window::Fit() {
		if (controller == null || hwnd == null) return;
		tagRECT bounds;
		GetClientRect(hwnd, &bounds);
		controller->put_Bounds(bounds);
	}

	void Window::Show(Core::StringView url) {
		origin = OriginOf(url);
		pendingUrl = Core::String(url);
		pendingHtml = Core::String();
		ShowPending();
	}

	void Window::ShowStatus(Core::StringView title, Core::StringView detail) {
		pendingUrl = Core::String();
		pendingHtml = StatusPage(title, detail, true);
		ShowPending();
	}

	void Window::ShowPending() {
		if (webview == null) return;
		if (!pendingUrl.IsEmpty()) {
			Core::Array<char16> url = Wide(pendingUrl.View());
			pendingUrl = Core::String();
			showingStatus = false;
			webview->Navigate(url.Data());
		}
		else if (!pendingHtml.IsEmpty()) {
			Core::Array<char16> html = Wide(pendingHtml.View());
			pendingHtml = Core::String();
			showingStatus = true;
			webview->NavigateToString(html.Data());
		}
	}

	Core::String Window::CurrentUrl() const {
		if (!pageUrl.IsEmpty()) return pageUrl;
		if (webview == null) return Core::String();
		char16* raw = null;
		webview->get_Source(&raw);
		return TakeWide(raw);
	}

	void Window::Resolved(Core::StringView url, Core::StringView error, Arrival arrival) {
		if (!url.IsEmpty() && arrival == Arrival::ServerBack && !showingStatus && OriginOf(url).View() == origin.View()) return;
		Core::String shown = arrival == Arrival::StartPage ? StartPageUrl(url) : Core::String(url);
		if (!url.IsEmpty()) Show(shown.View());
		else if (arrival == Arrival::Folder) Alert((Core::String("IED could not open the folder: ") + error).View());
		else ShowStatus(Core::StringView("IED could not start its server"), error);
	}

	void Window::TitleChanged() {
		char16* title = null;
		webview->get_DocumentTitle(&title);
		Core::String text = TakeWide(title);
		// The app's own pages are titled "IED"; the web client names its workspace.
		Core::Array<char16> shown = Wide(text.IsEmpty() ? Core::StringView("IED") : text.View());
		SetWindowTextW(hwnd, shown.Data());
	}

	int32 Window::NavigationStarting(ICoreWebView2NavigationStartingEventArgs* args) {
		char16* raw = null;
		args->get_Uri(&raw);
		Core::String url = TakeWide(raw);
		Destination where = NavigationTarget(url.View(), origin.View());
		if (where == Destination::Here) return kOk;
		args->put_Cancel(1);
		if (where == Destination::External) Launch::OpenExternal(url.View());
		return kOk;
	}

	// A page of the server that cannot be reached: the server went away between asking for the URL and loading it.
	int32 Window::NavigationCompleted(ICoreWebView2NavigationCompletedEventArgs* args) {
		int32 succeeded = 0;
		args->get_IsSuccess(&succeeded);
		if (succeeded != 0 || showingStatus) return kOk;
		COREWEBVIEW2_WEB_ERROR_STATUS status = COREWEBVIEW2_WEB_ERROR_STATUS_UNKNOWN;
		args->get_WebErrorStatus(&status);
		if (status == COREWEBVIEW2_WEB_ERROR_STATUS_CANNOT_CONNECT || status == COREWEBVIEW2_WEB_ERROR_STATUS_SERVER_UNREACHABLE ||
			status == COREWEBVIEW2_WEB_ERROR_STATUS_CONNECTION_RESET || status == COREWEBVIEW2_WEB_ERROR_STATUS_CONNECTION_ABORTED ||
			status == COREWEBVIEW2_WEB_ERROR_STATUS_DISCONNECTED)
			ShowStatus(Core::StringView("IED could not reach its server"), Core::StringView("The page did not load. Retry starts the server again if it is not running."));
		return kOk;
	}

	int32 Window::NewWindowRequested(ICoreWebView2NewWindowRequestedEventArgs* args) {
		char16* raw = null;
		args->get_Uri(&raw);
		Core::String url = TakeWide(raw);
		args->put_Handled(1);
		Destination where = NewWindowTarget(url.View(), origin.View());
		if (where == Destination::NewWindow) app->OpenUrl(url.View());
		else if (where == Destination::External) Launch::OpenExternal(url.View());
		return kOk;
	}

	int32 Window::MessageReceived(ICoreWebView2WebMessageReceivedEventArgs* args) {
		char16* rawSource = null;
		args->get_Source(&rawSource);
		Core::String source = TakeWide(rawSource);
		char16* rawText = null;
		if (args->TryGetWebMessageAsString(&rawText) != kOk) return kOk;
		Core::String text = TakeWide(rawText);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(text.View(), *doc);
		if (!parsed.Ok()) return kOk;
		Core::StringView type = parsed.root.Member("type").AsView();
		// The app's own status page may only ask to retry; everything else must come from the server's pages.
		if (type == "retry") {
			app->Retry();
			return kOk;
		}
		if (NavigationTarget(source.View(), origin.View()) != Destination::Here || OriginOf(source.View()).IsEmpty()) return kOk;
		if (type == "devTools") webview->OpenDevToolsWindow();
		// The picker is modal: it runs from the window's own message, not inside WebView2's event.
		else if (type == "openFolder") PostMessageW(hwnd, kOpenFolderMessage, 0, 0);
		else if (type == "openInWeb") app->OpenInWeb(parsed.root.Member("path").AsView());
		else if (type == "location") pageUrl = Core::String(parsed.root.Member("url").AsView());
		else if (type == "relaunch") PostMessageW(hwnd, kRelaunchMessage, 0, 0);
		else if (type == "openExternal") Launch::OpenExternal(parsed.root.Member("url").AsView());
		else if (type == "newWindow") {
			Core::StringView url = parsed.root.Member("url").AsView();
			if (url.IsEmpty()) app->OpenHome();
			else if (NewWindowTarget(url, origin.View()) == Destination::NewWindow) app->OpenUrl(url);
		}
		return kOk;
	}

	// The server's pages may read the clipboard (paste in the terminal) and show notifications.
	int32 Window::PermissionRequested(ICoreWebView2PermissionRequestedEventArgs* args) {
		char16* raw = null;
		args->get_Uri(&raw);
		Core::String url = TakeWide(raw);
		COREWEBVIEW2_PERMISSION_KIND kind = COREWEBVIEW2_PERMISSION_KIND_UNKNOWN_PERMISSION;
		args->get_PermissionKind(&kind);
		const bool ours = !OriginOf(url.View()).IsEmpty() && NavigationTarget(url.View(), origin.View()) == Destination::Here;
		if (ours && (kind == COREWEBVIEW2_PERMISSION_KIND_CLIPBOARD_READ || kind == COREWEBVIEW2_PERMISSION_KIND_NOTIFICATIONS))
			args->put_State(COREWEBVIEW2_PERMISSION_STATE_ALLOW);
		return kOk;
	}

	int32 Window::ProcessFailed(ICoreWebView2ProcessFailedEventArgs* args) {
		COREWEBVIEW2_PROCESS_FAILED_KIND kind = COREWEBVIEW2_PROCESS_FAILED_KIND_BROWSER_PROCESS_EXITED;
		args->get_ProcessFailedKind(&kind);
		if (kind == COREWEBVIEW2_PROCESS_FAILED_KIND_BROWSER_PROCESS_EXITED) {
			controller = null;
			webview = null;
			app->BrowserExited();
		}
		else if (kind == COREWEBVIEW2_PROCESS_FAILED_KIND_RENDER_PROCESS_EXITED || kind == COREWEBVIEW2_PROCESS_FAILED_KIND_RENDER_PROCESS_UNRESPONSIVE)
			webview->Reload();
		return kOk;
	}
}
