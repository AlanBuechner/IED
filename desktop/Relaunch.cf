include "Relaunch.ch"
include "Native.ch"

namespace Desktop
{
	const uint32 c_Synchronize = 0x00100000;   // SYNCHRONIZE
	const uint32 c_WaitTimeout = 0x102;        // WAIT_TIMEOUT
	const int64 c_DockIdMaxBytes = 120;

	Core::String RelaunchJson(int64 pid, const Core::Array<RelaunchWindow>& windows) {
		Core::StringBuilder json;
		json.Append("{\"pid\":");
		json.AppendInt(pid);
		json.Append(",\"windows\":[");
		for (int64 i = 0; i < windows.Count(); ++i) {
			if (i > 0) json.AppendByte(',');
			json.Append("{\"root\":");
			Serialization::WriteJsonString(windows[i].m_Root.View(), &json);
			json.Append(",\"dock\":");
			Serialization::WriteJsonString(windows[i].m_DockQuery.View(), &json);
			json.Append(",\"placement\":");
			json.Append(PlacementJson(windows[i].m_Placement).View());
			json.AppendByte('}');
		}
		json.Append("]}");
		return json.ToString();
	}

	bool ParseRelaunch(Core::StringView text, int64& pid, Core::Array<RelaunchWindow>& windows) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text, *doc);
		if (!read.Ok() || read.root.Member("windows").Kind() != Serialization::DomKind::Array) return false;
		pid = read.root.Member("pid").AsInt();
		Serialization::DomNode list = read.root.Member("windows");
		for (int64 i = 0; i < list.Count(); ++i) {
			RelaunchWindow window;
			window.m_Root = Core::String(list.At(i).Member("root").AsView());
			window.m_DockQuery = Core::String(list.At(i).Member("dock").AsView());
			Core::StringBuilder placement;
			Serialization::WriteJson(list.At(i).Member("placement"), &placement, 0);
			window.m_Placement = ParsePlacement(placement.View());
			windows.Push(window);
		}
		return true;
	}

	static Core::String QueryValue(Core::StringView url, const char* name) {
		const int64 fragment = url.IndexOf(Core::StringView("#"));
		Core::StringView address = fragment < 0 ? url : url.Substring(0, fragment);
		const int64 query = address.IndexOf(Core::StringView("?"));
		if (query < 0) return Core::String();
		Core::String wanted = Core::String(name) + "=";
		Core::StringView rest = address.Substring(query + 1, address.ByteLength() - query - 1);
		while (!rest.IsEmpty()) {
			const int64 end = rest.IndexOf(Core::StringView("&"));
			Core::StringView pair = end < 0 ? rest : rest.Substring(0, end);
			if (pair.StartsWith(wanted.View())) return Core::String(pair.Substring(wanted.ByteLength(), pair.ByteLength() - wanted.ByteLength()));   // these values need no decoding
			rest = end < 0 ? Core::StringView("") : rest.Substring(end + 1, rest.ByteLength() - end - 1);
		}
		return Core::String();
	}

	Core::String WorkspaceOf(Core::StringView url) { return QueryValue(url, "ws"); }

	static bool NamesAFile(Core::StringView id) {
		if (id.IsEmpty() || id.ByteLength() > c_DockIdMaxBytes || id.ByteAt(0) == '.') return false;
		for (int64 i = 0; i < id.ByteLength(); ++i) {
			const int32 c = id.ByteAt(i);
			if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-')) return false;
		}
		return true;
	}

	Core::String DockWindowOf(Core::StringView url) {
		Core::String id = QueryValue(url, "win");
		return NamesAFile(id.View()) ? id : Core::String();
	}

	Core::String DockQueryOf(Core::StringView url) {
		Core::String id = DockWindowOf(url);
		if (id.IsEmpty()) return Core::String();
		return Core::String("win=") + id.View();
	}

	Core::String WithDockWindow(Core::StringView url, Core::StringView query) {
		if (query.IsEmpty() || !url.Contains(Core::StringView("#open="))) return Core::String(url);
		return (Core::String(url) + "?") + query;
	}

	Core::String RootOf(Core::StringView statusReply, Core::StringView wsId) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(statusReply, *doc);
		Serialization::DomNode workspaces = read.Ok() ? read.root.Member("result").Member("workspaces") : Serialization::DomNode();
		for (int64 i = 0; i < workspaces.Count(); ++i)
			if (workspaces.At(i).Member("wsId").AsView() == wsId) return Core::String(workspaces.At(i).Member("root").AsView());
		return Core::String();
	}

	bool ReplyFlag(Core::StringView reply, const char* name) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(reply, *doc);
		return read.Ok() && read.root.Member("result").Member(name).AsBool();
	}

	bool AwaitExit(int64 pid, int32 ms) {
		void* process = OpenProcess(c_Synchronize, 0, (uint32)pid);
		if (process == null) return true;
		const uint32 waited = WaitForSingleObject(process, (uint32)ms);
		CloseHandle(process);
		return waited != c_WaitTimeout;
	}
}
