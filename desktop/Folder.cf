include "Folder.ch"

namespace Desktop
{
	// CLSID_FileOpenDialog, {DC1C5A9C-E88A-4DDE-A5A1-60F82A20AEF7}.
	static _GUID FileOpenDialogClass() {
		_GUID id;
		id.Data1 = 0xDC1C5A9C;
		id.Data2 = 0xE88A;
		id.Data3 = 0x4DDE;
		id.Data4[0] = 0xA5;
		id.Data4[1] = 0xA1;
		id.Data4[2] = 0x60;
		id.Data4[3] = 0xF8;
		id.Data4[4] = 0x2A;
		id.Data4[5] = 0x20;
		id.Data4[6] = 0xAE;
		id.Data4[7] = 0xF7;
		return id;
	}

	static int32 PickedPath(IFileOpenDialog* dialog, Core::String& folder) {
		void* picked = null;
		int32 hr = dialog->GetResult((IShellItem**)&picked);
		if (hr != c_Ok || picked == null) return hr == c_Ok ? c_Failed : hr;
		IShellItem* item = (IShellItem*)picked;
		char16* path = null;
		hr = item->GetDisplayName(SIGDN_FILESYSPATH, &path);
		if (hr == c_Ok) folder = TakeWide(path);
		item->Release();
		return hr;
	}

	bool PickFolder(HWND__* owner, Core::String& folder, Core::String& error) {
		_GUID dialogClass = FileOpenDialogClass();
		void* made = null;
		int32 hr = CoCreateInstance((const void*)&dialogClass, null, (uint32)CLSCTX_INPROC_SERVER, (const void*)__uuidof(IFileOpenDialog), &made);
		if (hr != c_Ok || made == null) {
			error = Failure(Core::StringView("the folder picker did not open"), hr);
			return false;
		}
		IFileOpenDialog* dialog = (IFileOpenDialog*)made;
		uint32 options = 0;
		dialog->GetOptions(&options);
		dialog->SetOptions(options | (uint32)FOS_PICKFOLDERS | (uint32)FOS_FORCEFILESYSTEM | (uint32)FOS_PATHMUSTEXIST);
		Core::Array<char16> title = Wide(Core::StringView("Open Folder"));
		dialog->SetTitle(title.Data());
		hr = dialog->Show(owner);
		if (hr == c_Ok) hr = PickedPath(dialog, folder);
		dialog->Release();
		if (hr == c_Ok || hr == c_Cancelled) return hr == c_Ok;
		error = Failure(Core::StringView("the folder picker failed"), hr);
		return false;
	}
}
