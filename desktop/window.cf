// The Win32 side of a window: creation, placement, the dark frame, and the messages it answers.

include "window.ch"
include "app.ch"

namespace Desktop
{
	// The frame's colors, theme.css's (COLORREF is 0x00BBGGRR): --bg-0 caption, --border-0 border, --text-0 title.
	const uint32 kCaptionColor = 0x000E0E0E;
	const uint32 kBorderColor = 0x00262626;
	const uint32 kTitleColor = 0x00E8E8E8;

	Core::Array<char16> Wide(Core::StringView text) { return Core::ToUtf16(text, true); }

	Core::String TakeWide(char16* text) {
		if (text == null) return Core::String();
		int64 count = 0;
		while (text[count] != 0) count += 1;
		Core::String utf8 = Core::FromUtf16((const char16*)text, count);
		CoTaskMemFree((void*)text);
		return utf8;
	}

	Core::String Failure(Core::StringView what, int32 hresult) {
		Core::StringBuilder text;
		text.Append(what);
		text.Append(" (HRESULT ");
		text.AppendInt(hresult);
		text.AppendByte(')');
		return text.ToString();
	}

	static void DarkFrame(HWND__* hwnd) {
		int32 dark = 1;
		DwmSetWindowAttribute(hwnd, (uint32)DWMWA_USE_IMMERSIVE_DARK_MODE, (const void*)&dark, 4);
		// Windows 11 colors the caption and border; Windows 10 ignores the attributes and keeps the dark caption.
		uint32 caption = kCaptionColor;
		uint32 border = kBorderColor;
		uint32 title = kTitleColor;
		DwmSetWindowAttribute(hwnd, (uint32)DWMWA_CAPTION_COLOR, (const void*)&caption, 4);
		DwmSetWindowAttribute(hwnd, (uint32)DWMWA_BORDER_COLOR, (const void*)&border, 4);
		DwmSetWindowAttribute(hwnd, (uint32)DWMWA_TEXT_COLOR, (const void*)&title, 4);
	}

	static int32 Smaller(int32 a, int32 b) { return a < b ? a : b; }

	// The placement as Windows keeps it, or centered on the primary monitor's work area when there is none to keep or
	// it would land on no monitor.
	static tagWINDOWPLACEMENT PlacementOnScreen(const Placement& placement) {
		tagWINDOWPLACEMENT shown;
		shown.length = 44;
		shown.showCmd = (uint32)(placement.maximized ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL);
		tagRECT wanted;
		wanted.left = placement.x;
		wanted.top = placement.y;
		wanted.right = placement.x + placement.width;
		wanted.bottom = placement.y + placement.height;
		if (placement.known && MonitorFromRect(&wanted, (uint32)MONITOR_DEFAULTTONULL) != null) {
			shown.rcNormalPosition = wanted;
			return shown;
		}
		tagRECT work;
		SystemParametersInfoW((uint32)SPI_GETWORKAREA, 0, (void*)&work, 0);
		const int32 width = Smaller(kDefaultWidth, (work.right - work.left) * 9 / 10);
		const int32 height = Smaller(kDefaultHeight, (work.bottom - work.top) * 9 / 10);
		shown.rcNormalPosition.left = work.left + (work.right - work.left - width) / 2;
		shown.rcNormalPosition.top = work.top + (work.bottom - work.top - height) / 2;
		shown.rcNormalPosition.right = shown.rcNormalPosition.left + width;
		shown.rcNormalPosition.bottom = shown.rcNormalPosition.top + height;
		shown.showCmd = (uint32)SW_SHOWNORMAL;
		return shown;
	}

	bool Window::Create(HINSTANCE__* instance, const Placement& placement) {
		Core::Array<char16> className = Wide(Core::StringView(kWindowClass));
		Core::Array<char16> title = Wide(Core::StringView("IED"));
		hwnd = CreateWindowExW(0, className.Data(), title.Data(), (uint32)WS_OVERLAPPEDWINDOW, (int32)CW_USEDEFAULT, (int32)CW_USEDEFAULT,
			kDefaultWidth, kDefaultHeight, null, null, instance, (void*)this);
		if (hwnd == null) return false;
		DarkFrame(hwnd);
		tagWINDOWPLACEMENT shown = PlacementOnScreen(placement);
		SetWindowPlacement(hwnd, &shown);
		return true;
	}

	Placement Window::CurrentPlacement() const {
		Placement placement;
		tagWINDOWPLACEMENT now;
		now.length = 44;
		if (hwnd == null || GetWindowPlacement(hwnd, &now) == 0) return placement;
		placement.known = true;
		placement.x = now.rcNormalPosition.left;
		placement.y = now.rcNormalPosition.top;
		placement.width = now.rcNormalPosition.right - now.rcNormalPosition.left;
		placement.height = now.rcNormalPosition.bottom - now.rcNormalPosition.top;
		placement.maximized = IsZoomed(hwnd) != 0;
		return placement;
	}

	void Window::Close() {
		if (hwnd != null) PostMessageW(hwnd, (uint32)WM_CLOSE, 0, 0);
	}

	void Window::Alert(Core::StringView text) {
		Core::Array<char16> body = Wide(text);
		Core::Array<char16> caption = Wide(Core::StringView("IED"));
		MessageBoxW(hwnd, body.Data(), caption.Data(), (uint32)MB_ICONERROR);
	}

	bool Window::Handle(uint32 message, uint64 wParam, int64 lParam, int64& result) {
		result = 0;
		if (message == (uint32)WM_SIZE) {
			if (controller != null) {
				controller->put_IsVisible(wParam == (uint64)SIZE_MINIMIZED ? 0 : 1);
				if (wParam != (uint64)SIZE_MINIMIZED) Fit();
			}
			return true;
		}
		if (message == (uint32)WM_MOVE || message == (uint32)WM_MOVING) {
			if (controller != null) controller->NotifyParentWindowPositionChanged();
			return false;
		}
		if (message == (uint32)WM_SETFOCUS) {
			if (controller != null) controller->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
			return true;
		}
		if (message == (uint32)WM_GETMINMAXINFO) {
			tagMINMAXINFO* limits = (tagMINMAXINFO*)(void*)lParam;
			limits->ptMinTrackSize.x = kMinWidth;
			limits->ptMinTrackSize.y = kMinHeight;
			return true;
		}
		if (message == (uint32)WM_DPICHANGED) {
			const tagRECT* suggested = (const tagRECT*)(void*)lParam;
			SetWindowPos(hwnd, null, suggested->left, suggested->top, suggested->right - suggested->left, suggested->bottom - suggested->top,
				(uint32)(SWP_NOZORDER | SWP_NOACTIVATE));
			return true;
		}
		if (message == kResolvedMessage) {
			app->DeliverResolved(this);
			return true;
		}
		if (message == kOpenFolderMessage) {
			app->OpenFolder(this);
			return true;
		}
		if (message == kRelaunchMessage) {
			app->Relaunch();
			return true;
		}
		if (message == (uint32)WM_CLOSE) {
			app->Closing(this);
			if (controller != null) controller->Close();
			controller = null;
			webview = null;
			DestroyWindow(hwnd);
			return true;
		}
		if (message == (uint32)WM_NCDESTROY) {
			HWND__* gone = hwnd;
			hwnd = null;
			app->Closed(this, gone);
			return false;
		}
		return false;
	}

	int64 WindowProcedure(HWND__* hwnd, uint32 message, uint64 wParam, int64 lParam) {
		if (message == (uint32)WM_NCCREATE) {
			const tagCREATESTRUCTW* creating = (const tagCREATESTRUCTW*)(void*)lParam;
			Window* window = (Window*)creating->lpCreateParams;
			window->hwnd = hwnd;
			SetWindowLongPtrW(hwnd, GWLP_USERDATA, (int64)(void*)window);
		}
		Window* window = (Window*)(void*)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
		int64 result = 0;
		if (window != null && window->Handle(message, wParam, lParam, result)) return result;
		if (message == (uint32)WM_NCDESTROY) SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
		return DefWindowProcW(hwnd, message, wParam, lParam);
	}
}
