include "filetypes.ch"

namespace Desktop
{
	const uint32 kKeyRead = 0x20019;    // KEY_READ
	const uint32 kKeyWrite = 0x20006;   // KEY_WRITE
	const uint32 kRegSz = 1;            // REG_SZ
	const uint32 kOnlySz = 2;           // RRF_RT_REG_SZ
	const int32 kNotFound = 2;          // ERROR_FILE_NOT_FOUND

	struct FileType
	{
		public const char* extension;
		public const char* progId;
		public const char* name;
	}

	static FileType TypeOf(const char* extension, const char* progId, const char* name) {
		FileType type;
		type.extension = extension;
		type.progId = progId;
		type.name = name;
		return type;
	}

	static Core::Array<FileType> FileTypes() {
		Core::Array<FileType> types;
		types.Push(TypeOf(".iedsln", "IED.Solution", "IED Solution"));
		types.Push(TypeOf(".iedfed", "IED.Federation", "IED Federation"));
		return types;
	}

	// HKEY_CURRENT_USER: (HKEY)(ULONG_PTR)(LONG)0x80000001, sign-extended.
	static HKEY__* CurrentUser() { return (HKEY__*)(void*)(int64)(int32)0x80000001; }

	static Core::String KeyOf(Core::StringView classes, Core::StringView key) { return (Core::String(classes) + "\\") + key; }

	static bool SetDefault(Core::StringView key, Core::StringView value) {
		Core::Array<char16> path = Wide(key);
		HKEY__* opened = null;
		if (RegCreateKeyExW(CurrentUser(), path.Data(), 0, null, 0, kKeyWrite, null, &opened, null) != 0) return false;
		Core::Array<char16> data = Wide(value);
		const int32 status = RegSetValueExW(opened, null, 0, kRegSz, (const uint8*)(const void*)data.Data(), (uint32)(data.Count() * 2));
		RegCloseKey(opened);
		return status == 0;
	}

	static Core::String ReadDefault(Core::StringView key) {
		Core::Array<char16> path = Wide(key);
		Core::Array<char16> buffer;
		buffer.Resize(1024);
		uint32 size = (uint32)(buffer.Count() * 2);
		if (RegGetValueW(CurrentUser(), path.Data(), null, kOnlySz, null, (void*)buffer.Data(), &size) != 0) return Core::String();
		int64 length = 0;
		while (length < buffer.Count() && buffer[length] != 0) length += 1;
		return Core::FromUtf16((const char16*)buffer.Data(), length);
	}

	static bool DeleteTree(Core::StringView key) {
		Core::Array<char16> path = Wide(key);
		const int32 status = RegDeleteTreeW(CurrentUser(), path.Data());
		if (status != 0 && status != kNotFound) return false;
		const int32 gone = RegDeleteKeyW(CurrentUser(), path.Data());
		return gone == 0 || gone == kNotFound;
	}

	bool RegisterFileTypes(const FS::Path& program, Core::StringView classes, Core::String& error) {
		Core::String exe = (Core::String("\"") + program.View()) + "\"";
		Core::Array<FileType> types = FileTypes();
		for (const FileType& type : types) {
			Core::String progId = KeyOf(classes, Core::StringView(type.progId));
			const bool written = SetDefault(KeyOf(classes, Core::StringView(type.extension)).View(), Core::StringView(type.progId))
				&& SetDefault(progId.View(), Core::StringView(type.name))
				&& SetDefault((progId + "\\DefaultIcon").View(), (exe + ",0").View())
				&& SetDefault((progId + "\\shell\\open\\command").View(), (exe + " \"%1\"").View());
			if (!written) {
				error = Core::String("the file type ") + type.extension + " could not be registered";
				return false;
			}
		}
		return true;
	}

	bool UnregisterFileTypes(Core::StringView classes, Core::String& error) {
		Core::Array<FileType> types = FileTypes();
		for (const FileType& type : types) {
			Core::String extension = KeyOf(classes, Core::StringView(type.extension));
			const bool ours = ReadDefault(extension.View()).View() == Core::StringView(type.progId);
			if (!DeleteTree(KeyOf(classes, Core::StringView(type.progId)).View()) || (ours && !DeleteTree(extension.View()))) {
				error = Core::String("the file type ") + type.extension + " could not be removed";
				return false;
			}
		}
		return true;
	}

	Core::String OpenCommand(Core::StringView extension, Core::StringView classes) {
		Core::String progId = ReadDefault(KeyOf(classes, extension).View());
		if (progId.IsEmpty()) return progId;
		return ReadDefault((KeyOf(classes, progId.View()) + "\\shell\\open\\command").View());
	}

	// SHCNE_ASSOCCHANGED with SHCNF_IDLIST.
	void AssociationsChanged() { SHChangeNotify(0x08000000, 0, null, null); }
}
