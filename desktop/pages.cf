include "pages.ch"
include "launcher.ch"

namespace Desktop
{
	static bool StartsWithIgnoringCase(Core::StringView text, const char* prefix) {
		Core::StringView wanted = Core::StringView(prefix);
		return text.ByteLength() >= wanted.ByteLength() && Http::EqualsIgnoringCase(text.Substring(0, wanted.ByteLength()), wanted);
	}

	Core::String OriginOf(Core::StringView url) {
		Core::StringView rest = StartsWithIgnoringCase(url, "blob:") ? url.Substring(5, url.ByteLength() - 5) : url;
		const int64 scheme = rest.IndexOf(Core::StringView("://"));
		if (scheme <= 0) return Core::String();
		int64 end = scheme + 3;
		while (end < rest.ByteLength() && rest.ByteAt(end) != '/' && rest.ByteAt(end) != '?' && rest.ByteAt(end) != '#') end += 1;
		return end > scheme + 3 ? Core::String(rest.Substring(0, end)) : Core::String();
	}

	static bool SameOrigin(Core::StringView url, Core::StringView serverOrigin) {
		Core::String origin = OriginOf(url);
		return !origin.IsEmpty() && !serverOrigin.IsEmpty() && Http::EqualsIgnoringCase(origin.View(), serverOrigin);
	}

	Destination NavigationTarget(Core::StringView url, Core::StringView serverOrigin) {
		if (StartsWithIgnoringCase(url, "about:") || StartsWithIgnoringCase(url, "data:")) return Destination::Here;
		if (SameOrigin(url, serverOrigin)) return Destination::Here;
		return Launch::IsExternalUrl(url) ? Destination::External : Destination::Refused;
	}

	Destination NewWindowTarget(Core::StringView url, Core::StringView serverOrigin) {
		if (SameOrigin(url, serverOrigin)) return Destination::NewWindow;
		return Launch::IsExternalUrl(url) ? Destination::External : Destination::Refused;
	}

	Core::String StartPageUrl(Core::StringView url) {
		const int64 fragment = url.IndexOf(Core::StringView("#"));
		return Core::String(fragment < 0 ? url : url.Substring(0, fragment)) + "#start";
	}

	Core::String BridgeScript(Core::StringView version) {
		Core::StringBuilder script;
		script.Append("(() => {\n");
		script.Append("\tif (!window.chrome || !window.chrome.webview || window.iedDesktop) return;\n");
		script.Append("\tconst post = (type, extra) => window.chrome.webview.postMessage(JSON.stringify(Object.assign({ type }, extra || {})));\n");
		script.Append("\tObject.defineProperty(window, \"iedDesktop\", { value: Object.freeze({\n");
		script.Append("\t\tversion: ");
		Serialization::WriteJsonString(version, &script);
		script.Append(",\n");
		script.Append("\t\tnewWindow: (url) => post(\"newWindow\", { url: url ? String(url) : \"\" }),\n");
		script.Append("\t\tdevTools: () => post(\"devTools\"),\n");
		script.Append("\t\topenFolder: () => post(\"openFolder\"),\n");
		script.Append("\t\trelaunch: () => post(\"relaunch\"),\n");
		script.Append("\t\topenExternal: (url) => post(\"openExternal\", { url: String(url) }),\n");
		script.Append("\t\topenInWeb: (path) => post(\"openInWeb\", { path: String(path) }),\n");
		script.Append("\t\tretry: () => post(\"retry\"),\n");
		script.Append("\t\tfocus: () => post(\"focus\"),\n");
		script.Append("\t}) });\n");
		// The page's address as history changes it (WebView2's Source does not follow history.replaceState).
		script.Append("\tconst tell = () => post(\"location\", { url: location.href });\n");
		script.Append("\tfor (const name of [\"pushState\", \"replaceState\"]) {\n");
		script.Append("\t\tconst original = history[name];\n");
		script.Append("\t\thistory[name] = function () { const done = original.apply(this, arguments); tell(); return done; };\n");
		script.Append("\t}\n");
		script.Append("\twindow.addEventListener(\"popstate\", tell);\n");
		script.Append("\twindow.addEventListener(\"hashchange\", tell);\n");
		script.Append("\tdocument.addEventListener(\"DOMContentLoaded\", tell);\n");
		script.Append("})();\n");
		return script.ToString();
	}

	Core::String EscapeHtml(Core::StringView text) {
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			if (c == '<') out.Append("&lt;");
			else if (c == '>') out.Append("&gt;");
			else if (c == '&') out.Append("&amp;");
			else if (c == '"') out.Append("&quot;");
			else if (c == '\'') out.Append("&#39;");
			else out.AppendByte((char8)c);
		}
		return out.ToString();
	}

	// The server's theme cannot be fetched when the server is the problem, so these are theme.css's values, copied:
	// --bg-0, --bg-3, --border-1, --text-0, --text-1, --font-ui.
	Core::String StatusPage(Core::StringView title, Core::StringView detail, bool retry) {
		Core::StringBuilder html;
		html.Append("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"color-scheme\" content=\"dark\"><title>IED</title><style>");
		html.Append("html,body{margin:0;height:100%;background:#0e0e0e;color:#e8e8e8;font:13px \"Segoe UI\",system-ui,sans-serif}");
		html.Append("main{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;height:100%;max-width:640px;margin:0 auto;padding:0 24px;box-sizing:border-box}");
		html.Append("h1{font-size:15px;font-weight:600;margin:0 0 8px}p{color:#b4b4b4;margin:0 0 16px;white-space:pre-wrap;word-break:break-word}");
		html.Append("button{font:inherit;color:#0e0e0e;background:#e8e8e8;border:1px solid #363636;padding:4px 16px;cursor:pointer}button:focus{outline:1px solid #d0d0d0;outline-offset:2px}");
		html.Append("</style></head><body><main><h1>");
		html.Append(EscapeHtml(title).View());
		html.Append("</h1><p>");
		html.Append(EscapeHtml(detail).View());
		html.Append("</p>");
		if (retry) html.Append("<button autofocus onclick=\"window.iedDesktop && window.iedDesktop.retry()\">Retry</button>");
		html.Append("</main></body></html>");
		return html.ToString();
	}
}
