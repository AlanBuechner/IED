include "watch.ch"
include "app.ch"

namespace Desktop
{
	bool RestartBudget::Allow(int64 now) {
		Core::Array<int64> recent;
		for (int64 i = 0; i < starts.Count(); ++i)
			if (now - starts[i] < kRestartWindowNs) recent.Push(starts[i]);
		starts = recent;
		if (starts.Count() >= kServerRestarts) return false;
		starts.Push(now);
		return true;
	}

	void Watch::Start(App* app) {
		if (Running()) return;
		this.app = app;
		stopping.Store(false);
		Watch* self = this;
		thread = Threading::Thread::Run([self]() { self->Loop(); });
	}

	void Watch::Stop() {
		stopping.Store(true);
		if (thread.IsJoinable()) thread.Join();
	}

	void Watch::Reset() {
		Threading::LockGuard guard(mutex);
		budget.Reset();
		exhausted = false;
	}

	// The workspaces the server has open, while it answers, for the app to open again if it has to start it again.
	void Watch::Look() {
		Net::LocalStream stream = Net::LocalStream::Connect(Launch::ControlName(app->options.control.View()).CStr(), Launch::kConnectMs);
		if (!stream.IsOpen()) return;
		Launch::Reply reply = Launch::Ask(stream, Core::StringView("status"), Core::StringView(""));
		if (reply.ok) app->Remember(reply.result.View());
	}

	void Watch::Loop() {
		Look();
		while (!stopping.Load()) {
			for (int64 slept = 0; slept < kWatchIntervalNs && !stopping.Load(); slept += kWatchSliceNs) Threading::Thread::Sleep(kWatchSliceNs);
			if (!stopping.Load()) Check();
		}
	}

	void Watch::Check() {
		if (!Launch::ServerGone(app->options.control.View())) {
			Look();
			return;
		}
		{
			Threading::LockGuard guard(mutex);
			if (exhausted) return;
		}
		app->ServerGone();
		{
			Threading::LockGuard guard(mutex);
			if (!budget.Allow(clock_now_ns())) {
				exhausted = true;
				app->ServerFailed(Core::StringView("The server stopped three times in a minute, so it is not started again until you retry."));
				return;
			}
		}
		Core::String error;
		Net::LocalStream stream = app->EnsureServer(error);
		if (stream.IsOpen()) app->ServerBack();
		else app->ServerFailed(error.View());
	}
}
