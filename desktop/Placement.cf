include "Placement.ch"

namespace Desktop
{
	const int32 c_GrabFromLeft = 120;   // where on its caption a window dropped at the pointer hangs from it
	const int32 c_GrabFromTop = 16;

	Placement ParsePlacement(Core::StringView json) {
		Placement placement;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(json, *doc);
		if (!parsed.Ok()) return placement;
		Serialization::DomNode root = parsed.root;
		if (!root.Member("width").IsValid() || !root.Member("height").IsValid()) return placement;
		placement.m_X = (int32)root.Member("x").AsInt();
		placement.m_Y = (int32)root.Member("y").AsInt();
		placement.m_Width = (int32)root.Member("width").AsInt();
		placement.m_Height = (int32)root.Member("height").AsInt();
		placement.m_Maximized = root.Member("maximized").AsBool();
		placement.m_Known = placement.m_Width >= c_MinWidth && placement.m_Height >= c_MinHeight;
		return placement;
	}

	Core::String PlacementJson(const Placement& placement) {
		Core::StringBuilder json;
		json.Append("{\"x\":");
		json.AppendInt(placement.m_X);
		json.Append(",\"y\":");
		json.AppendInt(placement.m_Y);
		json.Append(",\"width\":");
		json.AppendInt(placement.m_Width);
		json.Append(",\"height\":");
		json.AppendInt(placement.m_Height);
		json.Append(",\"maximized\":");
		json.Append(placement.m_Maximized ? "true" : "false");
		json.Append("}\n");
		return json.ToString();
	}

	Placement Cascaded(const Placement& from) {
		Placement next = from;
		next.m_X += c_CascadeStep;
		next.m_Y += c_CascadeStep;
		return next;
	}

	Placement GrabbedAt(const Placement& from, int32 x, int32 y) {
		Placement next = from;
		next.m_X = x - c_GrabFromLeft;
		next.m_Y = y - c_GrabFromTop;
		next.m_Maximized = false;
		return next;
	}

	static Placement ReadPlacement(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Placement();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? ParsePlacement(opened.ReadText().View()) : Placement();
	}

	static bool WritePlacement(const FS::Path& folder, const FS::Path& file, const Placement& placement) {
		if (!FS::MakeDirectories(folder.CStr())) return false;
		Core::String json = PlacementJson(placement);
		return FS::WriteFileAtomically(file.CStr(), (const void*)json.CStr(), json.ByteLength());
	}

	static FS::Path DockedFile(const FS::Path& folder, Core::StringView id) {
		return folder / "windows" / (Core::String(id) + ".json").View();
	}

	Placement LoadPlacement(const FS::Path& folder) { return ReadPlacement(folder / "window.json"); }

	bool SavePlacement(const FS::Path& folder, const Placement& placement) { return WritePlacement(folder, folder / "window.json", placement); }

	Placement LoadDockedPlacement(const FS::Path& folder, Core::StringView id) { return ReadPlacement(DockedFile(folder, id)); }

	bool SaveDockedPlacement(const FS::Path& folder, Core::StringView id, const Placement& placement) {
		return WritePlacement(folder / "windows", DockedFile(folder, id), placement);
	}
}
