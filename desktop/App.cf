include "App.ch"

namespace Desktop
{
	const char* c_RuntimeLink = "https://go.microsoft.com/fwlink/p/?LinkId=2124703";

	static HICON__* LoadAppIcon(HINSTANCE__* instance, int32 size) {
		// The icon is resource 1 of the exe (ied.rc).
		return (HICON__*)LoadImageW(instance, (const char16*)(void*)(int64)1, (uint32)IMAGE_ICON, size, size, 0);
	}

	bool App::RegisterClasses() {
		Core::Array<char16> windowClass = Wide(Core::StringView(c_WindowClass));
		tagWNDCLASSEXW window;
		window.cbSize = 80;
		window.style = (uint32)(CS_HREDRAW | CS_VREDRAW);
		window.lpfnWndProc = WindowProcedure;
		window.hInstance = m_Instance;
		window.hCursor = LoadCursorW(null, (const char16*)(void*)(int64)32512);
		window.hbrBackground = CreateSolidBrush(0x000E0E0E);
		window.hIcon = LoadAppIcon(m_Instance, GetSystemMetrics(SM_CXICON));
		window.hIconSm = LoadAppIcon(m_Instance, GetSystemMetrics(SM_CXSMICON));
		window.lpszClassName = windowClass.Data();
		if (RegisterClassExW(&window) == 0) return false;
		Core::Array<char16> messageClass = Wide(Core::StringView(c_MessageClass));
		tagWNDCLASSEXW quiet;
		quiet.cbSize = 80;
		quiet.lpfnWndProc = MessageProcedure;
		quiet.hInstance = m_Instance;
		quiet.lpszClassName = messageClass.Data();
		return RegisterClassExW(&quiet) != 0;
	}

	bool App::RuntimeInstalled() {
		char16* version = null;
		const int32 asked = GetAvailableCoreWebView2BrowserVersionString(null, &version);
		Core::String text = TakeWide(version);
		return asked == c_Ok && !text.IsEmpty();
	}

	// No WebView2 Runtime: say so, and offer the default browser.
	int32 App::OpenInBrowserInstead() {
		Core::String text = Core::String("IED's desktop window needs the Microsoft Edge WebView2 Runtime, which is not installed (") + c_RuntimeLink +
			").\n\nOpen IED in your default browser instead?";
		Core::Array<char16> body = Wide(text.View());
		Core::Array<char16> caption = Wide(Core::StringView("IED"));
		if (MessageBoxW(null, body.Data(), caption.Data(), (uint32)(MB_YESNO | MB_ICONWARNING)) != IDYES) return 1;
		Core::String error;
		Net::LocalStream stream = EnsureServer(error);
		if (!stream.IsOpen()) return 1;
		Launch::Reply reply = m_Options.m_Path.IsEmpty() ? Launch::Ask(stream, Core::StringView("url"), Core::StringView(""))
			: Launch::Ask(stream, Core::StringView("open"), Launch::OpenParams(m_Options.m_Path.View(), m_Options.m_Line, m_Options.m_Col).View());
		return reply.m_Ok && Launch::OpenExternal(Launch::ResultField(reply, "url").View()) ? 0 : 1;
	}

	void App::CreateEnvironment() {
		App* self = this;
		Callback* done = m_Callbacks.Add(__uuidof(ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler),
			[self](void* error, void* created) -> int32 {
				self->EnvironmentReady(Hresult(error), created);
				return c_Ok;
			});
		Core::Array<char16> profile = Wide((m_Data / "webview").View());
		const int32 started = CreateCoreWebView2EnvironmentWithOptions(null, profile.Data(), null,
			(ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler*)(void*)done);
		if (started != c_Ok) Report(Core::StringView("the WebView2 environment could not be created"), started);
	}

	void App::EnvironmentReady(int32 error, void* created) {
		if (error != c_Ok || created == null) {
			Report(Core::StringView("the WebView2 environment could not be created"), error);
			return;
		}
		m_Environment = (ICoreWebView2Environment*)created;
		m_Environment->AddRef();
		for (int64 i = 0; i < m_Windows.Count(); ++i)
			if (m_Windows[i]->m_Controller == null) m_Windows[i]->Attach(m_Environment);
	}

	// The WebView2's browser process ended: a new environment, and each window asks for its page again.
	void App::BrowserExited() {
		if (m_Environment == null) return;
		m_Environment = null;
		CreateEnvironment();
		for (int64 i = 0; i < m_Windows.Count(); ++i) Resolve(m_Windows[i], Core::StringView("url"), Core::StringView(""), Arrival::First);
	}

	void App::Report(Core::StringView what, int32 hresult) {
		Core::StringBuilder text;
		text.Append("IED's desktop window failed: ");
		text.Append(what);
		text.Append(" (HRESULT ");
		text.AppendInt(hresult);
		text.Append(").");
		Core::Array<char16> body = Wide(text.View());
		Core::Array<char16> caption = Wide(Core::StringView("IED"));
		MessageBoxW(null, body.Data(), caption.Data(), (uint32)MB_ICONERROR);
	}

	Window* App::NewWindow() {
		return NewWindowAt(m_Windows.IsEmpty() ? LoadPlacement(m_Data) : Cascaded(m_Windows[m_Windows.Count() - 1]->CurrentPlacement()));
	}

	Window* App::NewWindowAt(const Placement& placement) {
		App* self = this;
		Window* window = new Window(self);
		if (!window->Create(m_Instance, placement)) return null;
		m_Windows.Push(window);
		if (m_Environment != null) window->Attach(m_Environment);
		return window;
	}

	void App::OpenHome() {
		Window* window = NewWindow();
		if (window != null) Resolve(window, Core::StringView("url"), Core::StringView(""), Arrival::StartPage);
	}

	void App::OpenLocation(Core::StringView path, int64 line, int64 col) {
		Window* window = NewWindow();
		if (window != null) Resolve(window, Core::StringView("open"), Launch::OpenParams(path, line, col).View(), Arrival::First);
	}

	void App::OpenFolder(Window* window) {
		Core::String folder;
		Core::String error;
		if (PickFolder(window->m_Hwnd, folder, error))
			Resolve(window, Core::StringView("open"), Launch::OpenParams(folder.View(), 0, 0).View(), Arrival::Folder);
		else if (!error.IsEmpty()) window->Alert((Core::String("IED could not open a folder: ") + error.View()).View());
	}

	void App::OpenUrl(Core::StringView url) {
		Window* window = NewWindow();
		if (window != null) window->Show(url);
	}

	Net::LocalStream App::EnsureServer(Core::String& error) {
		Threading::LockGuard guard(m_StartLock);
		Process::Child started;
		Net::LocalStream stream = Launch::Reach(m_Options.m_Control.View(), error, &started);
		if (started.IsOpen()) {
			Core::StringBuilder line;
			line.Append("started ied-server, pid ");
			line.AppendInt((int64)started.Id());
			m_Log.Write(line.View());
			m_Server = take(started);
		}
		else if (!stream.IsOpen()) m_Log.Write((Core::String("the server could not be reached: ") + error.View()).View());
		return stream;
	}

	void App::ServerGone() {
		Threading::LockGuard guard(m_StartLock);
		if (!m_Server.IsOpen()) {
			m_Log.Write(Core::StringView("the server stopped answering; another program started it, so how it ended is not known here"));
			return;
		}
		Core::StringBuilder line;
		line.Append("the server (pid ");
		line.AppendInt((int64)m_Server.Id());
		line.Append(") stopped answering: ");
		const int64 code = m_Server.Wait(c_ServerEndWaitMs);
		if (code < 0) line.Append("it still runs, but nobody listens on its control pipe");
		else {
			line.Append("it exited with ");
			line.Append(Launch::ExitCodeText(code).View());
		}
		if (code > 0) {
			line.Append("; its log says why: ");
			line.Append((Launch::LogsFolder() / "server.log").View());
		}
		m_Log.Write(line.View());
		m_Server.Close();
	}

	void App::Resolve(Window* window, Core::StringView method, Core::StringView params, Arrival arrival) {
		App* self = this;
		Core::String asked = Core::String(method);
		Core::String with = Core::String(params);
		Threading::Thread::Run([self, window, asked, with, arrival]() {
			Core::String url;
			Core::String error;
			Net::LocalStream stream = self->EnsureServer(error);
			if (stream.IsOpen()) {
				Launch::Reply reply = Launch::Ask(stream, asked.View(), with.View());
				if (reply.m_Ok) url = Launch::ResultField(reply, "url");
				else error = reply.m_Error;
			}
			{
				Threading::LockGuard guard(self->m_Lock);
				window->m_ResolvedUrl = url;
				window->m_ResolveError = error;
				window->m_ResolveArrival = arrival;
			}
			if (window->m_Hwnd != null) PostMessageW(window->m_Hwnd, c_ResolvedMessage, 0, 0);
		}).Detach();
	}

	void App::DeliverResolved(Window* window) {
		Core::String url;
		Core::String error;
		Arrival arrival = Arrival::First;
		{
			Threading::LockGuard guard(m_Lock);
			url = window->m_ResolvedUrl;
			error = window->m_ResolveError;
			arrival = window->m_ResolveArrival;
			window->m_ResolvedUrl = Core::String();
			window->m_ResolveError = Core::String();
		}
		window->Resolved(url.View(), error.View(), arrival);
		if (!url.IsEmpty()) m_Watch.Start(this);
	}

	void App::Closing(Window* window) {
		Placement placement = window->CurrentPlacement();
		if (placement.m_Known) SavePlacement(m_Data, placement);
	}

	void App::Closed(Window* window, HWND__* hwnd) {
		Core::Array<Window*> open;
		for (int64 i = 0; i < m_Windows.Count(); ++i)
			if (m_Windows[i] != window) open.Push(m_Windows[i]);
		m_Windows = open;
		if (m_Windows.IsEmpty() && !m_Quitting) {
			m_Quitting = true;
			PostQuitMessage(0);
		}
	}

	void App::OpenInWeb(Core::StringView root) {
		App* self = this;
		Core::String path = Core::String(root);
		Threading::Thread::Run([self, path]() {
			Core::String error;
			Net::LocalStream stream = self->EnsureServer(error);
			if (stream.IsOpen()) {
				Launch::Reply reply = Launch::Ask(stream, Core::StringView("open"), Launch::OpenParams(path.View(), 0, 0).View());
				if (reply.m_Ok) {
					Launch::OpenExternal(Launch::ResultField(reply, "url").View());
					return;
				}
				error = reply.m_Error;
			}
			Core::Array<char16> body = Wide((Core::String("IED could not open this workspace in the browser: ") + error.View()).View());
			Core::Array<char16> caption = Wide(Core::StringView("IED"));
			MessageBoxW(null, body.Data(), caption.Data(), (uint32)MB_ICONERROR);
		}).Detach();
	}

	// The windows and the workspace each shows go into <data>/relaunch.json; the watch stops first, so it does not start
	// the server again while it stops. A failure is told, and the app goes on with a server started again.
	void App::Relaunch() {
		Core::String error;
		Net::LocalStream stream = EnsureServer(error);
		Core::String status;
		if (stream.IsOpen()) {
			Launch::Reply reply = Launch::Ask(stream, Core::StringView("status"), Core::StringView(""));
			if (reply.m_Ok) status = reply.m_Result;
		}
		Core::Array<RelaunchWindow> kept;
		for (Window* window : m_Windows) {
			RelaunchWindow entry;
			entry.m_Placement = window->CurrentPlacement();
			entry.m_Root = RootOf(status.View(), WorkspaceOf(window->CurrentUrl().View()).View());
			kept.Push(entry);
		}
		FS::Path file = m_Data / "relaunch.json";
		Core::String json = RelaunchJson((int64)Platform::ProcessId(), kept);
		FS::MakeDirectories(m_Data.CStr());
		m_Watch.Stop();
		if (stream.IsOpen()) Launch::Ask(stream, Core::StringView("stop"), Core::StringView(""));
		Launch::AwaitGone(m_Options.m_Control.View());
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength()) || !StartAgain(file, error)) {
			Report(Core::StringView("IED could not relaunch"), c_Failed);
			m_Watch.Start(this);
			return;
		}
		m_Quitting = true;
		for (Window* window : m_Windows) window->Close();
		PostQuitMessage(0);
	}

	bool App::StartAgain(const FS::Path& file, Core::String& error) {
		Process::StartInfo info;
		info.program = Core::String(Platform::ExecutablePath().View());
		info.arguments.Push(Core::String("--relaunch"));
		info.arguments.Push(Core::String(file.View()));
		if (!m_Options.m_Control.IsEmpty()) {
			info.arguments.Push(Core::String("--control"));
			info.arguments.Push(m_Options.m_Control);
		}
		if (!m_Options.m_DataDir.IsEmpty()) {
			info.arguments.Push(Core::String("--data"));
			info.arguments.Push(m_Options.m_DataDir);
		}
		if (m_Options.m_DebugPort > 0) {
			Core::StringBuilder port;
			port.AppendInt(m_Options.m_DebugPort);
			info.arguments.Push(Core::String("--debug-port"));
			info.arguments.Push(port.ToString());
		}
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		info.killOnClose = false;
		Process::Child child = Process::Child::Start(info);
		if (!child.IsOpen()) error = Core::String(child.Error());
		return child.IsOpen();
	}

	Core::Array<RelaunchWindow> App::TakeRelaunch() {
		Core::Array<RelaunchWindow> relaunched;
		if (m_Options.m_Relaunch.IsEmpty() || !FS::FileExists(m_Options.m_Relaunch.CStr())) return relaunched;
		FS::File opened = FS::File(m_Options.m_Relaunch.CStr(), "rb");
		Core::String text = opened.ReadText();
		opened.Close();
		FS::RemoveFile(m_Options.m_Relaunch.CStr());
		int64 pid = 0;
		if (!ParseRelaunch(text.View(), pid, relaunched)) return Core::Array<RelaunchWindow>();
		AwaitExit(pid, c_OldProcessWaitMs);
		return relaunched;
	}

	void App::OpenRelaunched(const Core::Array<RelaunchWindow>& relaunched) {
		for (const RelaunchWindow& entry : relaunched) {
			Window* window = NewWindowAt(entry.m_Placement.m_Known ? entry.m_Placement : LoadPlacement(m_Data));
			if (window == null) continue;
			if (entry.m_Root.IsEmpty()) Resolve(window, Core::StringView("url"), Core::StringView(""), Arrival::StartPage);
			else Resolve(window, Core::StringView("open"), Launch::OpenParams(entry.m_Root.View(), 0, 0).View(), Arrival::First);
		}
	}

	void App::Retry() {
		m_Watch.Reset();
		for (int64 i = 0; i < m_Windows.Count(); ++i) Reconnect(m_Windows[i], Arrival::First);
	}

	void App::ServerBack() {
		m_Log.Write(Core::StringView("the server is back"));
		if (m_Messages != null) PostMessageW(m_Messages, c_ServerBackMessage, 0, 0);
	}

	void App::ServerAsksRelaunch() {
		m_Log.Write(Core::StringView("the server asked to be relaunched onto the newest install"));
		if (m_Messages != null) PostMessageW(m_Messages, c_ServerRelaunchMessage, 0, 0);
	}

	void App::Remember(Core::StringView status) {
		Threading::LockGuard guard(m_Lock);
		m_LastStatus = Core::String(status);
	}

	// A server started again has no workspace open: the one the window showed (its address's ?ws=, which the last
	// status names) is opened again - a workspace closed before is not in it, so it stays closed.
	void App::Reconnect(Window* window, Arrival arrival) {
		Core::String status;
		{
			Threading::LockGuard guard(m_Lock);
			status = m_LastStatus;
		}
		Core::String root = RootOf(status.View(), WorkspaceOf(window->CurrentUrl().View()).View());
		if (root.IsEmpty()) Resolve(window, Core::StringView("url"), Core::StringView(""), arrival);
		else Resolve(window, Core::StringView("open"), Launch::OpenParams(root.View(), 0, 0).View(), Arrival::Reopened);
	}

	void App::ServerFailed(Core::StringView why) {
		m_Log.Write((Core::String("the server could not be started again: ") + why).View());
		{
			Threading::LockGuard guard(m_Lock);
			m_WatchError = Core::String(why);
		}
		if (m_Messages != null) PostMessageW(m_Messages, c_ServerFailedMessage, 0, 0);
	}

	bool App::Handle(uint32 message) {
		if (message == c_ServerBackMessage) {
			for (int64 i = 0; i < m_Windows.Count(); ++i) Reconnect(m_Windows[i], Arrival::ServerBack);
			return true;
		}
		if (message == c_ServerRelaunchMessage) {
			Relaunch();
			return true;
		}
		if (message == c_ServerFailedMessage) {
			Core::String why;
			{
				Threading::LockGuard guard(m_Lock);
				why = m_WatchError;
			}
			for (int64 i = 0; i < m_Windows.Count(); ++i) m_Windows[i]->ShowStatus(Core::StringView("The IED server stopped"), why.View());
			return true;
		}
		return false;
	}

	int64 MessageProcedure(HWND__* hwnd, uint32 message, uint64 wParam, int64 lParam) {
		if (message == (uint32)WM_NCCREATE) {
			const tagCREATESTRUCTW* creating = (const tagCREATESTRUCTW*)(void*)lParam;
			SetWindowLongPtrW(hwnd, GWLP_USERDATA, (int64)creating->lpCreateParams);
		}
		App* app = (App*)(void*)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
		if (app != null && app->Handle(message)) return 0;
		return DefWindowProcW(hwnd, message, wParam, lParam);
	}

	int32 App::Run() {
		m_Log.Open(LogFilePath(m_Options).View());
		Platform::SetCrashLog(m_Log.File().View());
		m_Log.Write((((Core::String("start: ied-desktop ") + c_DesktopVersion) + " (") + Platform::ExecutablePath().View() + "), data " + m_Data.View()).View());
		OleInitialize(null);
		m_Instance = GetModuleHandleW(null);
		if (!RegisterClasses()) return 1;
		if (!RuntimeInstalled()) return OpenInBrowserInstead();
		Core::Array<char16> messageClass = Wide(Core::StringView(c_MessageClass));
		m_Messages = CreateWindowExW(0, messageClass.Data(), null, 0, 0, 0, 0, 0, (HWND__*)(void*)(int64)-3, null, m_Instance, (void*)this);
		if (m_Options.m_DebugPort > 0) {
			Core::StringBuilder arguments;
			arguments.Append("--remote-debugging-port=");
			arguments.AppendInt(m_Options.m_DebugPort);
			Platform::SetEnvironmentVariable("WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS", arguments.ToString().CStr());
		}
		Core::Array<RelaunchWindow> relaunched = TakeRelaunch();
		CreateEnvironment();
		if (!relaunched.IsEmpty()) OpenRelaunched(relaunched);
		else if (m_Options.m_Path.IsEmpty()) OpenHome();
		else OpenLocation(m_Options.m_Path.View(), m_Options.m_Line, m_Options.m_Col);
		if (m_Windows.IsEmpty()) return 1;
		tagMSG message;
		while (GetMessageW(&message, null, 0, 0) > 0) {
			TranslateMessage(&message);
			DispatchMessageW(&message);
		}
		m_Watch.Stop();
		m_Log.Write(Core::StringView("exit: the last window closed"));
		return 0;
	}
}
