include "placement.ch"

namespace Desktop
{
	Placement ParsePlacement(Core::StringView json) {
		Placement placement;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(json, *doc);
		if (!parsed.Ok()) return placement;
		Serialization::DomNode root = parsed.root;
		if (!root.Member("width").IsValid() || !root.Member("height").IsValid()) return placement;
		placement.x = (int32)root.Member("x").AsInt();
		placement.y = (int32)root.Member("y").AsInt();
		placement.width = (int32)root.Member("width").AsInt();
		placement.height = (int32)root.Member("height").AsInt();
		placement.maximized = root.Member("maximized").AsBool();
		placement.known = placement.width >= kMinWidth && placement.height >= kMinHeight;
		return placement;
	}

	Core::String PlacementJson(const Placement& placement) {
		Core::StringBuilder json;
		json.Append("{\"x\":");
		json.AppendInt(placement.x);
		json.Append(",\"y\":");
		json.AppendInt(placement.y);
		json.Append(",\"width\":");
		json.AppendInt(placement.width);
		json.Append(",\"height\":");
		json.AppendInt(placement.height);
		json.Append(",\"maximized\":");
		json.Append(placement.maximized ? "true" : "false");
		json.Append("}\n");
		return json.ToString();
	}

	Placement Cascaded(const Placement& from) {
		Placement next = from;
		next.x += kCascadeStep;
		next.y += kCascadeStep;
		return next;
	}

	Placement LoadPlacement(const FS::Path& folder) {
		FS::Path file = folder / "window.json";
		if (!FS::FileExists(file.CStr())) return Placement();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? ParsePlacement(opened.ReadText().View()) : Placement();
	}

	bool SavePlacement(const FS::Path& folder, const Placement& placement) {
		if (!FS::MakeDirectories(folder.CStr())) return false;
		Core::String json = PlacementJson(placement);
		return FS::WriteFileAtomically((folder / "window.json").CStr(), (const void*)json.CStr(), json.ByteLength());
	}
}
