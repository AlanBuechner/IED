// The GPU debugger (docs/22, docs/features/17-gpu-debugger.md): frame capture and replay for D3D12 and Vulkan on IED's
// own backend, Flashbang (native/). Programs launched for capture write captures into the workspace's
// .ied/local/gpu-captures; each capture opens as a document in PIX's layout - the timing timeline, the events grid,
// the Pipeline view with the resource viewer, and the docked API Calls, Messages and Warnings - replayed on the
// server by flashbang-replay, one process per open capture. Its server code (code/) runs on the plugin API (docs/26
// "Built-ins on the API"): the gpu.* methods, the gpu: and gpurs: topics, and the gpu_* AI tools.
{
	"manifestVersion": 1,
	"id": "ied.gpu",
	"name": "GPU Debugger",
	"version": "0.1.0",
	"description": "Frame capture and replay for D3D12 and Vulkan: events, pipeline state, resources, pixels, meshes, shaders and GPU timing.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "GpuDebug::Activate", "ui": "ui/index.js" },
	"permissions": ["process.spawn", "fs.read", "fs.write", "fs.watch", "ai.tools"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "GPU Debugger" },
		"bindings": {
			"provides": [
				{ "name": "gpu.query", "version": "1", "kind": "function", "description": "A gpu_* tool's answer: {wsId, tool: captures|capture|events|resources|state|shader|pixel|buffer|texture|scan|debug|timing|compare, args} -> {text, image?} (image: a PNG relative to the workspace root)." }
			],
			"consumes": [
				{ "name": "gpu.query", "version": "1" }
			]
		},
		"outputSources": [ { "id": "gpu", "title": "GPU" } ],
		"activities": [
			{ "id": "ied.gpu", "title": "GPU", "icon": "$(device-camera)", "order": 45 }
		],
		"toolWindows": [
			{ "id": "ied.gpu.library", "title": "Capture Library", "icon": "$(library)", "view": "CaptureLibrary", "defaultDock": "document", "activity": "ied.gpu" }
		],
		"fileIcons": [
			{ "extensions": [".flash"], "icon": "$(device-camera)", "color": "--hue-purple" }
		],
		"commands": [
			{ "id": "ied.gpu.show", "title": "GPU Debugger", "category": "View", "icon": "$(device-camera)" },
			{ "id": "ied.gpu.launch", "title": "Launch for Capture", "category": "Debug", "icon": "$(device-camera)" },
			{ "id": "ied.gpu.captureNext", "title": "Capture Next Frame", "category": "Debug", "icon": "$(record)" },
			{ "id": "ied.gpu.library", "title": "Capture Library", "category": "GPU", "icon": "$(library)" }
		],
		"menus": {
			"menubar/view": [
				{ "command": "ied.gpu.show", "group": "2_windows" }
			],
			"menubar/debug": [
				{ "command": "ied.gpu.launch", "group": "6_graphics" },
				{ "command": "ied.gpu.captureNext", "group": "6_graphics", "order": 1 }
			],
			"toolbar/main": [
				{ "command": "ied.gpu.launch", "group": "7_graphics" }
			]
		},
		"keybindings": [
			{ "command": "ied.gpu.launch", "key": "alt+f5" },
			{ "command": "ied.gpu.show", "key": "ctrl+alt+f5" }
		],
		"skills": ["skills"],
		"systemMessageSections": [
			{ "id": "gpu", "text": "The GPU debugger holds the workspace's frame captures (.ied/local/gpu-captures) from D3D12 and Vulkan programs. To find why a frame renders wrong or slowly, read them with the gpu_* tools: gpu_captures, then gpu_events, gpu_event_state, gpu_texture (which shows the image), gpu_pixel, gpu_buffer, gpu_shader, gpu_scan for the first event that wrote NaN, Inf or negative values, gpu_debug_shader to step a shader invocation with its values, gpu_timing, and gpu_compare to set two captures side by side (two builds, two frames). gpu_capture builds, runs and captures the startup project. Read the gpu skill before debugging a frame." }
		],
		"toolCalls": [
			{
				"name": "gpu_capture",
				"description": "Captures a frame: builds the startup project and launches the program its debug configuration names for capture (as GPU > Launch for Capture does), captures the next frame once the program's capture library answers, stops the program, and returns the new capture's id and events. A D3D12 program must hand its device to the capture library (the gpu skill says how); a Vulkan program needs nothing.",
				"class": "exec",
				"group": "gpu",
				"inputSchema": { "type": "object", "properties": { "project": { "type": "string" }, "configuration": { "type": "string", "description": "A debug configuration of the project; its default when left out." } }, "additionalProperties": false },
				"function": "GpuDebug::CaptureTool",
				"timeoutSeconds": 900
			},
			{
				"name": "gpu_captures",
				"description": "The workspace's GPU frame captures, newest first: id, program, API (D3D12 or Vulkan), frame, when, GPU, size and comment.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": {  }, "additionalProperties": false },
				"function": "GpuDebug::CapturesTool"
			},
			{
				"name": "gpu_events",
				"description": "A capture's events in order: EID, kind (marker, draw, dispatch, copy, clear, barrier, present, ...) and name (the API call with its arguments, or the marker's text), indented under their markers. `filter` keeps events whose name has every word, and `kind:draw` words keep those kinds; `all` adds the state-setting calls.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "filter": { "type": "string" }, "all": { "type": "boolean" }, "max": { "type": "integer", "minimum": 1, "maximum": 5000 } }, "additionalProperties": false },
				"function": "GpuDebug::EventsTool"
			},
			{
				"name": "gpu_resources",
				"description": "A capture's resources: id, name, type, format, size, the first event that uses it and how many do. `filter` keeps names that hold it.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "filter": { "type": "string" } }, "additionalProperties": false },
				"function": "GpuDebug::ResourcesTool"
			},
			{
				"name": "gpu_event_state",
				"description": "The pipeline state an event sees, by stage: input assembly with vertex and index buffers, the shaders, rasterizer, render and depth targets with blend and depth-stencil, the root signature or descriptor sets with every binding resolved to its resource and name, push constants. A marker shows its last action's state. Resources carry their [#id] and what the event writes is marked rt, depth or uav; buffers say their offset and layout.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The event, by its EID from gpu_events." }, "all": { "type": "boolean", "description": "Also list the descriptor heaps." } }, "required": ["eid"], "additionalProperties": false },
				"function": "GpuDebug::StateTool"
			},
			{
				"name": "gpu_shader",
				"description": "A pipeline stage's shader at an event: its kind (DXBC, DXIL or SPIR-V), bindings, constant buffers or uniform blocks with their members and offsets, and the disassembly (up to 300 lines).",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The event, by its EID from gpu_events." }, "stage": { "enum": ["vs", "hs", "ds", "gs", "ps", "fs", "cs", "as", "ms", "tcs", "tes", "task", "mesh"] } }, "required": ["eid", "stage"], "additionalProperties": false },
				"function": "GpuDebug::ShaderTool"
			},
			{
				"name": "gpu_pixel",
				"description": "One texel of a texture after an event, as stored: its typed value and raw bits, then its Pixel History - every event up to that one that wrote the pixel or tried to, the test that kept a draw out (outside the scissor, culled, depth or stencil test failed), the values before and after, and a summary sentence (history: false leaves it out). The texture defaults to what the event writes (its render target, else depth, else storage texture).",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The event, by its EID from gpu_events." }, "resource": { "type": "integer", "minimum": 1, "description": "A resource id ([#id] in gpu_event_state, or gpu_resources)." }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "mip": { "type": "integer", "minimum": 0 }, "slice": { "type": "integer", "minimum": 0 }, "history": { "type": "boolean" } }, "required": ["eid", "x", "y"], "additionalProperties": false },
				"function": "GpuDebug::PixelTool"
			},
			{
				"name": "gpu_texture",
				"description": "A texture after an event: its size and format, each channel's min, max and mean over every texel, NaN, Inf and negative counts with where the first NaN or Inf is, and the image itself (up to 1024 pixels on a side; a float texture brighter than 1 is scaled to its brightest). The texture defaults to what the event writes.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The event, by its EID from gpu_events." }, "resource": { "type": "integer", "minimum": 1, "description": "A resource id ([#id] in gpu_event_state, or gpu_resources)." }, "mip": { "type": "integer", "minimum": 0 }, "slice": { "type": "integer", "minimum": 0 } }, "required": ["eid"], "additionalProperties": false },
				"function": "GpuDebug::TextureTool"
			},
			{
				"name": "gpu_buffer",
				"description": "A buffer's bytes after an event, 16 a line, read as 32-bit floats (the default), uint, int or hex. Offsets are in bytes; gpu_event_state gives a binding's offset and layout.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The event, by its EID from gpu_events." }, "resource": { "type": "integer", "minimum": 1, "description": "A resource id ([#id] in gpu_event_state, or gpu_resources)." }, "offset": { "type": "integer", "minimum": 0 }, "size": { "type": "integer", "minimum": 1, "maximum": 4096 }, "as": { "enum": ["float", "uint", "int", "hex"] } }, "required": ["eid", "resource"], "additionalProperties": false },
				"function": "GpuDebug::BufferTool"
			},
			{
				"name": "gpu_scan",
				"description": "Finds the first action after which a texture holds NaN (the default), Inf or negative values: bisects the frame's draws, dispatches, copies and clears (or checks each one in a frame of up to 64 when the end is clean), and gives that event and the count before it. The texture defaults to what the frame's last action writes.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "resource": { "type": "integer", "minimum": 1, "description": "A resource id ([#id] in gpu_event_state, or gpu_resources)." }, "check": { "enum": ["nan", "inf", "negative"] } }, "additionalProperties": false },
				"function": "GpuDebug::ScanTool",
				"timeoutSeconds": 600
			},
			{
				"name": "gpu_debug_shader",
				"description": "Steps one invocation of a draw's or dispatch's shader on the replay GPU and gives every line it ran with the value it made, in order (texture samples and math are the GPU's own): a fragment at a pixel (stage fs, or ps; x, y), a vertex (stage vs; vertex, instance) or a compute thread (stage cs; thread [x, y, z]). A pixel can have several fragments (one per primitive covering it): `invocation` picks one. D3D12 shaders of Shader Model 5.1 (DXBC) and Vulkan shaders (SPIR-V); not yet DXIL.",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "eid": { "type": "integer", "minimum": 1, "description": "The draw or dispatch, by its EID from gpu_events." }, "stage": { "enum": ["vs", "fs", "ps", "cs"] }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "vertex": { "type": "integer", "minimum": 0 }, "instance": { "type": "integer", "minimum": 0 }, "thread": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "maxItems": 3 }, "invocation": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1, "maximum": 5000 } }, "required": ["eid", "stage"], "additionalProperties": false },
				"function": "GpuDebug::DebugShaderTool",
				"timeoutSeconds": 300
			},
			{
				"name": "gpu_compare",
				"description": "Compares a capture with another (two builds, two frames, or D3D12 against Vulkan): the events aligned by marker path and call (what only one has, calls whose arguments changed); with `eid`, the pipeline state that differs at that event and how many pixels of its output differ, where; and each pass's GPU time in both, measured on the replay GPU (`timing: false` skips it).",
				"class": "read",
				"group": "gpu",
				"parallelSafe": false,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "The capture compared, by id from gpu_captures, or \"latest\" (the default)." }, "other": { "type": "string", "description": "The capture to compare it with, by id from gpu_captures." }, "eid": { "type": "integer", "minimum": 1, "description": "An event of `capture`: compare the state and output image there with the aligned event of `other`." }, "timing": { "type": "boolean", "description": "Measure each pass's GPU time in both (default true)." }, "repeat": { "type": "integer", "minimum": 1, "maximum": 20 } }, "required": ["other"], "additionalProperties": false },
				"function": "GpuDebug::CompareTool",
				"timeoutSeconds": 600
			},
			{
				"name": "gpu_timing",
				"description": "GPU time of the frame on the replay GPU (the median of `repeat` replays with timestamps): by pass (the markers, nested) or by event (the costliest actions with their primitives and pixel and compute shader invocations).",
				"class": "read",
				"group": "gpu",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string", "description": "A capture id from gpu_captures, or \"latest\" (the default)." }, "by": { "enum": ["pass", "event"] }, "top": { "type": "integer", "minimum": 1, "maximum": 500 }, "repeat": { "type": "integer", "minimum": 1, "maximum": 25 } }, "additionalProperties": false },
				"function": "GpuDebug::TimingTool",
				"timeoutSeconds": 600
			}
		]
	}
}
