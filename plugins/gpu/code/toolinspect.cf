// The gpu_* answers that look inside one event (docs/13 T-GPU): its pipeline state, a shader, a pixel, a buffer's bytes,
// a texture's statistics with a picture of it, and the scan for the first event that left NaN, Inf or negative values.
include "tooltext.ch"

namespace GpuDebug
{
	const int64 kStateLines = 400;
	const int64 kShaderLines = 300;
	const int64 kBufferBytes = 256;
	const int64 kBufferBytesMax = 4096;
	const int64 kImageSize = 1024;
	const int64 kScanLinear = 64;
	const char* kImageFolder = ".ied/local/gpu-captures/ai";

	static Core::String EidParams(int64 eid) {
		Core::StringBuilder params;
		params.Append("{\"eid\":");
		params.AppendInt(eid);
		params.Append("}");
		return params.ToString();
	}

	static int64 RequiredInt(const Serialization::DomNode& args, const char* key) {
		Serialization::DomNode value = args.Member(key);
		if (!value.IsValid() || value.IsNull()) throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String(key) + " is required").View());
		return value.AsInt();
	}

	// --- gpu_event_state ----------------------------------------------------------------------------------------------

	static void AppendItems(Core::StringBuilder& text, const Serialization::DomNode& items, int64 depth, int64& lines) {
		for (int64 i = 0; i < items.Count() && lines < kStateLines; i += 1) {
			Serialization::DomNode item = items.At(i);
			lines += 1;
			for (int64 d = 0; d < depth; d += 1) text.Append("  ");
			text.Append(item.Member("label").AsView());
			text.Append(": ");
			text.Append(item.Member("value").AsView());
			if (item.Member("resource").IsValid()) {
				text.Append("  [#");
				text.AppendInt(item.Member("resource").AsInt());
				if (item.Member("role").IsValid()) {
					text.Append(", ");
					text.Append(item.Member("role").AsView());
				}
				if (item.Member("offset").IsValid()) {
					text.Append(", offset ");
					text.AppendInt(item.Member("offset").AsInt());
				}
				if (item.Member("layout").IsValid()) {
					text.Append(", layout ");
					text.Append(item.Member("layout").AsView());
				}
				text.Append("]");
			}
			if (item.Member("shader").IsValid()) {
				text.Append("  [stage ");
				text.Append(item.Member("shader").AsView());
				text.Append("]");
			}
			text.Append("\n");
			AppendItems(text, item.Member("children"), depth + 1, lines);
		}
	}

	Core::String StateText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		const int64 eid = RequiredInt(args, "eid");
		Serialization::DomNode state = AskTool(debugger, target, "state", EidParams(eid).View());
		const bool all = args.Member("all").AsBool();
		Core::StringBuilder text;
		text.Append("Pipeline state at EID ");
		text.AppendInt(eid);
		if (!state.Member("pipeline").AsView().IsEmpty()) {
			text.Append(", pipeline ");
			text.Append(state.Member("pipeline").AsView());
		}
		text.Append(". [#id] is a resource (gpu_texture, gpu_pixel, gpu_buffer take it); rt, depth and uav mark what the event writes; [stage x] is a shader (gpu_shader).\n");
		Serialization::DomNode groups = state.Member("groups");
		int64 lines = 0;
		for (int64 g = 0; g < groups.Count() && lines < kStateLines; g += 1) {
			Serialization::DomNode group = groups.At(g);
			if (!all && group.Member("name").AsView() == "Descriptor Heaps") continue;
			lines += 1;
			text.Append(group.Member("name").AsView());
			text.Append(": ");
			text.Append(group.Member("summary").AsView());
			text.Append("\n");
			AppendItems(text, group.Member("items"), 1, lines);
		}
		if (lines >= kStateLines) text.Append("... (cut at 400 lines)\n");
		return text.ToString();
	}

	// --- gpu_shader ---------------------------------------------------------------------------------------------------

	Core::String ShaderText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		const int64 eid = RequiredInt(args, "eid");
		Core::StringView stage = args.Member("stage").AsView();
		if (stage.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("stage is required: vs, ps (fs), cs, hs, ds, gs, as, ms"));
		Core::StringBuilder params;
		params.Append("{\"eid\":");
		params.AppendInt(eid);
		params.Append(",\"stage\":\"");
		params.Append(stage);
		params.Append("\"}");
		Serialization::DomNode shader = AskTool(debugger, target, "shader", params.View());
		Core::StringBuilder text;
		text.Append(stage);
		text.Append(" shader of pipeline ");
		text.Append(shader.Member("pipeline").AsView());
		text.Append(": ");
		text.Append(shader.Member("model").IsValid() ? shader.Member("model").AsView() : shader.Member("kind").AsView());
		text.Append(", ");
		text.AppendInt(shader.Member("size").AsInt());
		text.Append(" bytes\n");
		Serialization::DomNode bindings = shader.Member("bindings");
		for (int64 i = 0; i < bindings.Count(); i += 1) {
			Serialization::DomNode b = bindings.At(i);
			text.Append("binding ");
			text.Append(b.Member("register").AsView());
			if (b.Member("space").AsInt()) {
				text.Append(" space");
				text.AppendInt(b.Member("space").AsInt());
			}
			text.Append(": ");
			text.Append(b.Member("name").AsView());
			text.Append(" (");
			text.Append(b.Member("type").AsView());
			text.Append(")\n");
		}
		Serialization::DomNode buffers = shader.Member("constantBuffers");
		for (int64 i = 0; i < buffers.Count(); i += 1) {
			Serialization::DomNode c = buffers.At(i);
			text.Append("block ");
			text.Append(c.Member("name").AsView());
			text.Append(" (");
			text.AppendInt(c.Member("size").AsInt());
			text.Append(" B):");
			Serialization::DomNode variables = c.Member("variables");
			for (int64 v = 0; v < variables.Count(); v += 1) {
				text.Append(v ? "; " : " ");
				text.Append(variables.At(v).Member("type").AsView());
				text.Append(" ");
				text.Append(variables.At(v).Member("name").AsView());
				text.Append(" +");
				text.AppendInt(variables.At(v).Member("offset").AsInt());
			}
			text.Append("\n");
		}
		Core::StringView code = shader.Member("disassembly").AsView();
		if (code.IsEmpty()) {
			text.Append(shader.Member("problem").IsValid() ? shader.Member("problem").AsView() : Core::StringView("No disassembly: this shader's compiler is not available here."));
			text.Append("\n");
			return text.ToString();
		}
		text.Append("Disassembly:\n");
		int64 lines = 0, at = 0;
		while (at < code.ByteLength() && lines < kShaderLines) {
			int64 end = code.IndexOf('\n', at);
			if (end < 0) end = code.ByteLength();
			text.Append(code.Substring(at, end - at));
			text.Append("\n");
			at = end + 1;
			lines += 1;
		}
		if (at < code.ByteLength()) text.Append("... (cut at 300 lines)\n");
		return text.ToString();
	}

	// --- gpu_pixel ----------------------------------------------------------------------------------------------------

	Core::String PixelText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		const int64 eid = RequiredInt(args, "eid");
		const int64 x = RequiredInt(args, "x"), y = RequiredInt(args, "y");
		const int64 id = ResourceArg(debugger, target, args, eid);
		if (!id) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("the event writes no texture: name one with resource"));
		Core::StringBuilder params;
		params.Append("{\"id\":");
		params.AppendInt(id);
		params.Append(",\"eid\":");
		params.AppendInt(eid);
		params.Append(",\"x\":");
		params.AppendInt(x);
		params.Append(",\"y\":");
		params.AppendInt(y);
		params.Append(",\"mip\":");
		params.AppendInt(IntArg(args, "mip", 0));
		params.Append(",\"slice\":");
		params.AppendInt(IntArg(args, "slice", 0));
		params.Append("}");
		Serialization::DomNode pixel = AskTool(debugger, target, "pixel", params.View());
		Core::StringBuilder text;
		text.Append(ResourceName(debugger, target, id).View());
		text.Append(" [#");
		text.AppendInt(id);
		text.Append("] at (");
		text.AppendInt(x);
		text.Append(", ");
		text.AppendInt(y);
		text.Append(") after EID ");
		text.AppendInt(eid);
		text.Append(": ");
		text.Append(pixel.Member("text").AsView());
		if (pixel.Member("raw").IsValid()) {
			text.Append("  raw 0x");
			text.Append(pixel.Member("raw").AsView());
		}
		text.Append("  (");
		text.Append(pixel.Member("format").AsView());
		text.Append(")\n");
		return text.ToString();
	}

	// --- gpu_buffer ---------------------------------------------------------------------------------------------------

	Core::String BufferText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		const int64 eid = RequiredInt(args, "eid");
		const int64 id = RequiredInt(args, "resource");
		const int64 offset = IntArg(args, "offset", 0);
		int64 size = IntArg(args, "size", kBufferBytes);
		if (size > kBufferBytesMax) size = kBufferBytesMax;
		Core::StringView words = args.Member("as").AsView();
		if (words.IsEmpty()) words = Core::StringView("float");
		Core::StringBuilder params;
		params.Append("{\"id\":");
		params.AppendInt(id);
		params.Append(",\"eid\":");
		params.AppendInt(eid);
		params.Append(",\"offset\":");
		params.AppendInt(offset);
		params.Append(",\"size\":");
		params.AppendInt(size);
		params.Append("}");
		Core::Array<uint8> bytes;
		debugger->Ask(target.session, Core::StringView("buffer"), params.View(), bytes);
		Core::StringBuilder text;
		text.Append(ResourceName(debugger, target, id).View());
		text.Append(" [#");
		text.AppendInt(id);
		text.Append("] after EID ");
		text.AppendInt(eid);
		text.Append(", ");
		text.AppendInt(bytes.Count());
		text.Append(" bytes from offset ");
		text.AppendInt(offset);
		text.Append(" as ");
		text.Append(words);
		text.Append(" (16 bytes a line):\n");
		for (int64 line = 0; line < bytes.Count(); line += 16) {
			text.Append("+");
			text.AppendInt(offset + line);
			text.Append(":");
			if (words == "hex") {
				for (int64 i = line; i < line + 16 && i < bytes.Count(); i += 1) {
					text.Append(" ");
					text.AppendUIntBase((uint64)bytes[i], 16, 2);
				}
			}
			else
				for (int64 i = line; i + 4 <= line + 16 && i + 4 <= bytes.Count(); i += 4) {
					const uint32 word = (uint32)bytes[i] | ((uint32)bytes[i + 1] << 8) | ((uint32)bytes[i + 2] << 16) | ((uint32)bytes[i + 3] << 24);
					text.Append(" ");
					if (words == "uint") text.AppendUInt((uint64)word);
					else if (words == "int") text.AppendInt((int64)(int32)word);
					else AppendValue(text, (double)reinterpret_cast<float>(word));
				}
			text.Append("\n");
		}
		return text.ToString();
	}

	// --- gpu_texture --------------------------------------------------------------------------------------------------

	static void AppendChannels(Core::StringBuilder& text, const char* what, const Serialization::DomNode& values) {
		text.Append(what);
		for (int64 c = 0; c < values.Count(); c += 1) {
			text.Append(c ? ", " : " ");
			AppendValue(text, values.At(c).AsFloat());
		}
		text.Append("\n");
	}

	ToolAnswer TextureAnswer(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		const int64 eid = RequiredInt(args, "eid");
		const int64 id = ResourceArg(debugger, target, args, eid);
		if (!id) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("the event writes no texture: name one with resource"));
		const int64 mip = IntArg(args, "mip", 0), slice = IntArg(args, "slice", 0);
		Core::StringBuilder file;
		file.Append(kImageFolder);
		file.Append("/");
		file.Append(target.capture->id.View());
		file.Append("_e");
		file.AppendInt(eid);
		file.Append("_r");
		file.AppendInt(id);
		file.Append("_m");
		file.AppendInt(mip);
		file.Append("_s");
		file.AppendInt(slice);
		file.Append(".png");
		FS::Path folder = FS::Path(target.root.View()) / kImageFolder;
		FS::MakeDirectories(folder.CStr());
		FS::Path path = FS::Path(target.root.View()) / file.CStr();
		IED::JsonWriter params;
		params.BeginObject();
		params.IntField("id", id);
		params.IntField("eid", eid);
		params.IntField("mip", mip);
		params.IntField("slice", slice);
		params.IntField("maxSize", kImageSize);
		params.Field("path", path.View());
		params.EndObject();
		Serialization::DomNode answer = AskTool(debugger, target, "png", params.View());
		Serialization::DomNode texture = answer.Member("texture");
		Core::StringBuilder text;
		text.Append(texture.Member("name").AsView());
		text.Append(" [#");
		text.AppendInt(id);
		text.Append("] after EID ");
		text.AppendInt(eid);
		text.Append(": ");
		text.AppendInt(texture.Member("srcWidth").AsInt());
		text.Append("x");
		text.AppendInt(texture.Member("srcHeight").AsInt());
		text.Append(" ");
		text.Append(texture.Member("format").AsView());
		text.Append(", mip ");
		text.AppendInt(mip);
		text.Append(", slice ");
		text.AppendInt(slice);
		text.Append(". Channels R, G, B, A over every texel:\n");
		AppendChannels(text, "min", texture.Member("min"));
		AppendChannels(text, "max", texture.Member("max"));
		AppendChannels(text, "mean", texture.Member("mean"));
		text.Append("NaN ");
		text.AppendInt(texture.Member("nan").AsInt());
		text.Append(", Inf ");
		text.AppendInt(texture.Member("inf").AsInt());
		text.Append(", negative ");
		text.AppendInt(texture.Member("negative").AsInt());
		text.Append(" (component counts)");
		Serialization::DomNode bad = texture.Member("firstBad");
		if (bad.IsValid()) {
			text.Append("; the first NaN or Inf texel is at (");
			text.AppendInt(bad.Member("x").AsInt());
			text.Append(", ");
			text.AppendInt(bad.Member("y").AsInt());
			text.Append(")");
		}
		text.Append(".\nThe image (");
		text.AppendInt(texture.Member("width").AsInt());
		text.Append("x");
		text.AppendInt(texture.Member("height").AsInt());
		text.Append(") maps ");
		AppendValue(text, answer.Member("range").At(0).AsFloat());
		text.Append("..");
		AppendValue(text, answer.Member("range").At(1).AsFloat());
		text.Append(" to black..white; NaN shows black.\n");
		ToolAnswer result;
		result.text = text.ToString();
		result.image = file.ToString();
		return result;
	}

	// --- gpu_scan -----------------------------------------------------------------------------------------------------

	// How many components of `check` (nan, inf, negative) resource `id` holds after event `eid`.
	static int64 BadAfter(Debugger* debugger, const ToolCapture& target, int64 id, int64 eid, Core::StringView check) {
		Core::StringBuilder params;
		params.Append("{\"id\":");
		params.AppendInt(id);
		params.Append(",\"eid\":");
		params.AppendInt(eid);
		params.Append(",\"maxSize\":1}");
		Serialization::DomNode texture = AskTool(debugger, target, "texture", params.View());
		return check == "inf" ? texture.Member("inf").AsInt() : check == "negative" ? texture.Member("negative").AsInt() : texture.Member("nan").AsInt();
	}

	Core::String ScanText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		Core::StringView check = args.Member("check").AsView();
		if (check.IsEmpty()) check = Core::StringView("nan");
		if (check != "nan" && check != "inf" && check != "negative") throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("check is nan, inf or negative"));
		Serialization::DomNode rows = AskTool(debugger, target, "events", Core::StringView("{}")).Member("events");
		Core::Array<int64> actions;
		Core::HashMap<int64, int64> rowOf;
		for (int64 i = 0; i < rows.Count(); i += 1) {
			Core::StringView kind = rows.At(i).At(2).AsView();
			rowOf.Insert(rows.At(i).At(0).AsInt(), i);
			if (kind == "draw" || kind == "dispatch" || kind == "copy" || kind == "clear" || kind == "resolve") actions.Push(rows.At(i).At(0).AsInt());
		}
		if (!actions.Count()) return Core::String("The frame has no actions to scan.");
		const int64 last = actions[actions.Count() - 1];
		const int64 id = ResourceArg(debugger, target, args, last);
		if (!id) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("the frame's last action writes no texture: name one with resource"));
		Core::StringBuilder text;
		text.Append(ResourceName(debugger, target, id).View());
		text.Append(" [#");
		text.AppendInt(id);
		text.Append("], ");
		text.Append(check);
		text.Append(" values, over ");
		text.AppendInt(actions.Count());
		text.Append(" actions: ");
		int64 found = -1;
		if (BadAfter(debugger, target, id, last, check)) {
			// Bisect, as long as bad values stay once written.
			int64 lo = 0, hi = actions.Count() - 1;
			while (lo < hi) {
				const int64 mid = (lo + hi) / 2;
				if (BadAfter(debugger, target, id, actions[mid], check)) hi = mid;
				else lo = mid + 1;
			}
			found = lo;
		}
		else if (actions.Count() <= kScanLinear) {
			for (int64 i = 0; i < actions.Count() && found < 0; i += 1)
				if (BadAfter(debugger, target, id, actions[i], check)) found = i;
		}
		if (found < 0) {
			text.Append("none after the frame's last action");
			text.Append(actions.Count() <= kScanLinear ? " or any action before it.\n" : " (a frame this long is bisected, which finds values that stay once written).\n");
			return text.ToString();
		}
		const int64 eid = actions[found];
		int64* row = rowOf.Find(eid);
		text.Append("first after EID ");
		text.AppendInt(eid);
		text.Append(" ");
		text.Append(row ? rows.At(*row).At(6).AsView() : Core::StringView("?"));
		text.Append(" (");
		text.AppendInt(BadAfter(debugger, target, id, eid, check));
		text.Append(" components)");
		if (found > 0) {
			text.Append("; after EID ");
			text.AppendInt(actions[found - 1]);
			text.Append(" it had ");
			text.AppendInt(BadAfter(debugger, target, id, actions[found - 1], check));
		}
		else text.Append("; it is the frame's first action, so the values may come from before the frame");
		text.Append(".\nNext: gpu_event_state for that EID, gpu_texture to see where, gpu_shader for its shaders.\n");
		return text.ToString();
	}
}
