// Edit and Replay on the server (docs/22 "Edit and Replay"): a replay session's edited shaders - compiled from a
// workspace file as the editor holds it (IED::TextAsEdited, unsaved edits included) or from text the client sends -
// their list on the session's topic, and the file each shader was last edited from, kept per program and shader key
// beside the captures, so an edit of the same shader in the next capture starts from the same file.
include "gpu.ch"
include "api/documents.ch"

namespace GpuDebug
{
	const char* kLinksFile = "shader-links.json";

	static FS::Path LinksPath(const IED::Workspace& ws) { return FS::Path(ws.root.View()) / kCaptureFolder / kLinksFile; }

	static Core::String LinkName(Capture* capture, Core::StringView key) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode meta = Serialization::ReadJson(capture->sidecar.View(), *doc).root;
		return (Core::String(meta.Member("program").AsView()) + "|") + key;
	}

	static Serialization::DomNode ReadLinks(const IED::Workspace& ws, Serialization::DomDoc& doc) {
		FS::Path path = LinksPath(ws);
		Core::String text("{}");
		if (FS::FileExists(path.CStr())) {
			FS::File file = FS::File(path.CStr(), "rb");
			if (file.IsOpen()) text = file.ReadText();
		}
		return Serialization::ReadJson(text.View(), doc).root;
	}

	// The link of `key`: {path, entry, profile, language}; "" when the shader was never edited from a file.
	static Core::String LinkOf(const IED::Workspace& ws, Capture* capture, Core::StringView key) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode links = ReadLinks(ws, *doc);
		Core::String name = LinkName(capture, key);
		for (int64 i = 0; links.Kind() == Serialization::DomKind::Object && i < links.Count(); ++i)
			if (links.KeyAt(i) == name.View() && links.ValueAt(i).Kind() == Serialization::DomKind::Object) return IED::NodeJson(links.ValueAt(i));
		return Core::String();
	}

	static void SaveLink(const IED::Workspace& ws, Capture* capture, Core::StringView key, Core::StringView path, const Serialization::DomNode& edited, Core::StringView language) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode links = ReadLinks(ws, *doc);
		Core::String name = LinkName(capture, key);
		IED::JsonWriter json;
		json.BeginObject();
		for (int64 i = 0; links.Kind() == Serialization::DomKind::Object && i < links.Count(); ++i) {
			if (links.KeyAt(i) == name.View()) continue;
			json.Key(links.KeyAt(i));
			json.Raw(IED::NodeJson(links.ValueAt(i)).View());
		}
		json.Key(name.View());
		json.BeginObject();
		json.Field("path", path);
		json.Field("entry", edited.Member("entry").AsView());
		json.Field("profile", edited.Member("profile").AsView());
		json.Field("language", language);
		json.EndObject();
		json.EndObject();
		FS::Path file = LinksPath(ws);
		FS::WriteFileAtomically(file.CStr(), (const void*)json.View().Data(), json.View().ByteLength());
	}

	Core::String Debugger::ShaderSource(Session* session, const IED::Workspace& ws, Capture* capture, int64 eid, Core::StringView stage) {
		IED::JsonWriter params;
		params.BeginObject();
		params.IntField("eid", eid);
		params.Field("stage", stage);
		params.EndObject();
		Core::String blob;
		Core::String answer = Call(session, Core::StringView("shaderSource"), params.View(), blob);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String link = LinkOf(ws, capture, Serialization::ReadJson(answer.View(), *doc).root.Member("key").AsView());
		if (link.IsEmpty() || answer.View().ByteLength() < 2) return answer;
		Core::StringBuilder text;
		text.Append(answer.View().Substring(0, answer.View().ByteLength() - 1));
		text.Append(",\"link\":");
		text.Append(link.View());
		text.Append("}");
		return text.ToString();
	}

	Core::String Debugger::EditShader(Session* session, const IED::Workspace& ws, Capture* capture, const ShaderEditRequest& edit) {
		Core::String source = edit.text;
		if (!edit.path.IsEmpty()) {
			Core::String problem;
			if (!IED::TextAsEdited(ws, edit.path.View(), source, problem)) throw IED::RpcError(IED::ErrorCode::NotFound, problem.View());
		}
		IED::JsonWriter params;
		params.BeginObject();
		params.IntField("eid", edit.eid);
		params.Field("stage", edit.stage.View());
		params.Field("language", edit.language.View());
		params.Field("source", source.View());
		if (!edit.entry.IsEmpty()) params.Field("entry", edit.entry.View());
		if (!edit.profile.IsEmpty()) params.Field("profile", edit.profile.View());
		params.EndObject();
		Core::String blob;
		Core::String answer = Call(session, Core::StringView("editShader"), params.View(), blob);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode result = Serialization::ReadJson(answer.View(), *doc).root;
		if (result.Member("ok").AsBool() && !edit.path.IsEmpty()) SaveLink(ws, capture, result.Member("key").AsView(), edit.path.View(), result, edit.language.View());
		RefreshEdits(session);
		return answer;
	}

	Core::String Debugger::RevertShader(Session* session, Core::StringView key) {
		IED::JsonWriter params;
		params.BeginObject();
		if (!key.IsEmpty()) params.Field("key", key);
		params.EndObject();
		Core::String blob;
		Core::String answer = Call(session, Core::StringView("revertShader"), params.View(), blob);
		RefreshEdits(session);
		return answer;
	}

	void Debugger::RefreshEdits(Session* session) {
		Core::String blob;
		Core::String answer = Call(session, Core::StringView("edits"), Core::StringView("{}"), blob);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode list = Serialization::ReadJson(answer.View(), *doc).root.Member("edits");
		Core::String edits = list.IsValid() && list.Count() ? IED::NodeJson(list) : Core::String();
		context->Atomically([session, edits](IED::Events& events) {
			if (session->edits.View() != edits.View()) session->Edited();
			session->edits = edits;
			events.Publish(session->Topic().View(), "state", session->Json().View());
		});
	}
}
