// The gpu_* AI tools (docs/13 T-GPU, the manifest's toolCalls): each forwards to the gpu.query binding the plugin
// provides, which answers from the plugin's library and replay sessions; gpu_texture's answer carries a picture.
include "tooltext.ch"
include "api/bindings.ch"
include "api/tools.ch"

namespace GpuDebug
{
	const char* kQueryBinding = "gpu.query";

	void ProvideQuery(Debugger* debugger) {
		debugger->context->Provide(Core::StringView(kQueryBinding), [debugger](const Serialization::DomNode& call) -> IED::Result {
			IED::Workspace ws;
			if (!IED::FindWorkspace(call.Member("wsId").AsView(), ws)) return IED::Refusal(Core::StringView("no such workspace"));
			try {
				ToolAnswer answer = AnswerTool(debugger, ws, call.Member("tool").AsView(), call.Member("args"));
				IED::JsonWriter json;
				json.BeginObject();
				json.Field("text", answer.text.View());
				if (!answer.image.IsEmpty()) json.Field("image", answer.image.View());
				json.EndObject();
				return IED::Answer(json.View());
			}
			catch (IED::RpcError failed) {
				return IED::Refusal(failed.message.View());
			}
		});
	}

	static IED::ToolResult Through(const char* tool, const IED::ToolCall& call) {
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("wsId", call.workspace.id.View());
		args.Field("tool", tool);
		args.RawField("args", IED::NodeJson(call.args).View());
		args.EndObject();
		IED::Result answer = IED::CallBinding(Core::StringView(kQueryBinding), args.View());
		if (!answer.Ok()) return IED::ToolFailure(answer.error.View());
		Serialization::DomNode result = ParseAnswer(answer.json.View());
		IED::ToolResult tool = IED::ToolText(result.Member("text").AsView());
		if (result.Member("image").IsValid()) {
			IED::ToolImage image;
			image.mime = Core::String("image/png");
			image.path = Core::String(result.Member("image").AsView());
			tool.images.Push(image);
		}
		return tool;
	}

	IED::ToolResult CapturesTool(const IED::ToolCall& call) { return Through("captures", call); }
	IED::ToolResult CaptureTool(const IED::ToolCall& call) { return Through("capture", call); }
	IED::ToolResult EventsTool(const IED::ToolCall& call) { return Through("events", call); }
	IED::ToolResult ResourcesTool(const IED::ToolCall& call) { return Through("resources", call); }
	IED::ToolResult StateTool(const IED::ToolCall& call) { return Through("state", call); }
	IED::ToolResult ShaderTool(const IED::ToolCall& call) { return Through("shader", call); }
	IED::ToolResult PixelTool(const IED::ToolCall& call) { return Through("pixel", call); }
	IED::ToolResult BufferTool(const IED::ToolCall& call) { return Through("buffer", call); }
	IED::ToolResult TextureTool(const IED::ToolCall& call) { return Through("texture", call); }
	IED::ToolResult ScanTool(const IED::ToolCall& call) { return Through("scan", call); }
	IED::ToolResult DebugShaderTool(const IED::ToolCall& call) { return Through("debug", call); }
	IED::ToolResult CompareTool(const IED::ToolCall& call) { return Through("compare", call); }
	IED::ToolResult ReplayWithShaderTool(const IED::ToolCall& call) { return Through("edit", call); }
	IED::ToolResult TimingTool(const IED::ToolCall& call) { return Through("timing", call); }
}
