// The gpu.* methods (docs/22 "Server and protocol"). Library and target state is read and changed inside changes
// (Atomically); a replay request waits on its session, never the server's lock.
include "gpu.ch"

namespace GpuDebug
{
	static IED::Workspace WorkspaceOf(const IED::Request& request) {
		Core::String wsId = request.params.Str("wsId");
		IED::Workspace ws;
		if (!IED::FindWorkspace(wsId.View(), ws)) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no workspace ") + wsId.View()).View());
		return ws;
	}

	// A holder for what a change finds, read after it.
	class Found
	{
		public Capture* capture;
		public Target* target;
		public Session* session;
		public Core::String text;
	}

	static Capture* CaptureOf(Debugger* debugger, Core::StringView wsId, Core::StringView captureId) {
		Found* found = new Found();
		Core::String ws = Core::String(wsId);
		Core::String id = Core::String(captureId);
		debugger->context->Atomically([debugger, ws, id, found](IED::Events& events) {
			Library** library = debugger->libraries.Find(ws);
			if (library) found->capture = (*library)->Find(id.View());
		});
		if (!found->capture) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no capture ") + captureId).View());
		return found->capture;
	}

	static Target* TargetOf(Debugger* debugger, Core::StringView targetId) {
		Found* found = new Found();
		Core::String id = Core::String(targetId);
		debugger->context->Atomically([debugger, id, found](IED::Events& events) {
			for (Target* target : debugger->targets)
				if (target->id == id) found->target = target;
		});
		if (!found->target) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no program ") + targetId).View());
		return found->target;
	}

	static Session* SessionOf(Debugger* debugger, Core::StringView sessionId) {
		Found* found = new Found();
		Core::String id = Core::String(sessionId);
		debugger->context->Atomically([debugger, id, found](IED::Events& events) {
			for (Session* session : debugger->sessions)
				if (session->id == id) found->session = session;
		});
		if (!found->session) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no replay session ") + sessionId).View());
		return found->session;
	}

	static Core::String StatusMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		Found* found = new Found();
		Core::String wsId = ws.id;
		debugger->context->Atomically([debugger, wsId, found](IED::Events& events) { found->text = debugger->SnapshotJson(wsId.View()); });
		return found->text;
	}

	static Core::String RescanMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		debugger->Rescan(ws.id.View());
		return StatusMethod(debugger, request);
	}

	static void StringsOf(Serialization::DomNode node, Core::Array<Core::String>& out) {
		if (node.Kind() == Serialization::DomKind::String && !node.AsView().IsEmpty()) out.Push(Core::String(node.AsView()));
		for (int64 i = 0; node.Kind() == Serialization::DomKind::Array && i < node.Count(); ++i) out.Push(Core::String(node.At(i).AsView()));
	}

	Target* LaunchConfigured(Debugger* debugger, const IED::Workspace& ws, Core::StringView project, Core::StringView configurationName) {
		if (!ws.trusted) throw IED::RpcError(IED::ErrorCode::Forbidden, Core::StringView("the workspace is not trusted: nothing runs in it"));
		IED::Launch launch = IED::ResolveLaunch(ws, project, configurationName);
		if (!launch.problem.IsEmpty()) throw IED::RpcError(IED::ErrorCode::NotFound, launch.problem.View());
		if (!launch.preLaunchTask.IsEmpty()) {
			IED::TaskOutcome built = IED::RunTask(ws, launch.project.View(), launch.preLaunchTask.View(), Core::StringView(""));
			if (!built.problem.IsEmpty()) throw IED::RpcError(IED::ErrorCode::Unavailable, (Core::String("the build could not run: ") + built.problem.View()).View());
			if (!built.succeeded) throw IED::RpcError(IED::ErrorCode::Unavailable, (Core::String("the build failed: ") + built.label.View()).View());
		}
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode configuration = Serialization::ReadJson(launch.configuration.View(), *doc).root;
		Core::String program = Core::String(configuration.Member("program").AsView());
		if (program.IsEmpty()) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("the launch configuration of ") + launch.project.View() + " names no program").View());
		Core::Array<Core::String> args;
		Core::Array<Core::String> environment;
		StringsOf(configuration.Member("args"), args);
		Core::String cwd = configuration.Member("cwd").AsView().IsEmpty() ? ws.root : Core::String(configuration.Member("cwd").AsView());
		Serialization::DomNode env = configuration.Member("env");
		for (int64 i = 0; env.Kind() == Serialization::DomKind::Object && i < env.Count(); ++i)
			environment.Push((Core::String(env.KeyAt(i)) + "=") + env.ValueAt(i).AsView());
		return debugger->Launch(ws, program.View(), args, cwd.View(), environment);
	}

	void RequestCapture(Debugger* debugger, Target* target, int64 frames) {
		if (target->state.View() == "exited") throw IED::RpcError(IED::ErrorCode::Conflict, Core::StringView("the program has exited"));
		if (!target->connected)
			throw IED::RpcError(IED::ErrorCode::Unavailable, Core::StringView("the program has not loaded the capture library: a D3D12 program loads it through Gpu::Capture (C4) or flashbang_app.h; a Vulkan program gets it from the loader"));
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("cmd", "capture");
		json.IntField("frames", frames);
		json.EndObject();
		if (!debugger->Send(target, json.View())) throw IED::RpcError(IED::ErrorCode::Unavailable, Core::StringView("the program's control pipe closed"));
		target->capturing = true;
		debugger->Changed(target);
	}

	// The program to launch: given in the request, or the project's debug configuration (built first when it names a
	// pre-launch task).
	static Core::String LaunchMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		Core::String program = request.params.Str("program", Core::StringView(""));
		if (program.IsEmpty())
			return LaunchConfigured(debugger, ws, request.params.Str("project", Core::StringView("")).View(), request.params.Str("configuration", Core::StringView("")).View())->Json();
		if (!ws.trusted) throw IED::RpcError(IED::ErrorCode::Forbidden, Core::StringView("the workspace is not trusted: nothing runs in it"));
		Core::Array<Core::String> args;
		Core::Array<Core::String> environment;
		StringsOf(request.params.Field("args"), args);
		Core::String cwd = ws.root;
		Core::String within = request.params.Str("cwd", Core::StringView(""));
		if (!within.IsEmpty()) cwd = Core::String((FS::Path(ws.root.View()) / IED::NormalizePath(within.View()).View()).View());
		Target* target = debugger->Launch(ws, program.View(), args, cwd.View(), environment);
		return target->Json();
	}

	static Core::String CaptureMethod(Debugger* debugger, const IED::Request& request) {
		Target* target = TargetOf(debugger, request.params.Str("targetId").View());
		RequestCapture(debugger, target, request.params.Int("frames", 1));
		return target->Json();
	}

	static Core::String StopMethod(Debugger* debugger, const IED::Request& request) {
		Target* target = TargetOf(debugger, request.params.Str("targetId").View());
		if (target->child) target->child->Kill();
		return Core::String("{}");
	}

	static Core::String DeleteMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		Capture* capture = CaptureOf(debugger, ws.id.View(), request.params.Str("captureId").View());
		// Its replay ends first: the replayer has the file open.
		Core::Array<Session*>* open = new Core::Array<Session*>();
		Core::String path = capture->path;
		debugger->context->Atomically([debugger, path, open](IED::Events& events) {
			for (Session* session : debugger->sessions)
				if (session->path == path) open->Push(session);
		});
		for (Session* session : *open) debugger->Close(session, Core::StringView("the capture was deleted"));
		Core::String problem;
		Core::Array<Core::String> extensions = {Core::String(".flash"), Core::String(".json"), Core::String(".png")};
		for (const Core::String& extension : extensions) {
			Core::String relative = (((Core::String(kCaptureFolder) + "/") + capture->id.View()) + extension.View());
			if (FS::FileExists((FS::Path(ws.root.View()) / relative.View()).CStr()) && !IED::MoveToTrash(ws.id.View(), relative.View(), problem))
				throw IED::RpcError(IED::ErrorCode::Internal, problem.View());
		}
		debugger->Rescan(ws.id.View());
		return Core::String("{}");
	}

	static Core::String CommentMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		Capture* capture = CaptureOf(debugger, ws.id.View(), request.params.Str("captureId").View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode meta = Serialization::ReadJson(capture->sidecar.View(), *doc).root;
		IED::JsonWriter json;
		json.BeginObject();
		for (int64 i = 0; meta.Kind() == Serialization::DomKind::Object && i < meta.Count(); ++i) {
			if (meta.KeyAt(i) == "comment") continue;
			json.Key(meta.KeyAt(i));
			json.Raw(IED::NodeJson(meta.ValueAt(i)).View());
		}
		json.Field("comment", request.params.Str("text").View());
		json.EndObject();
		FS::Path sidecar = FS::Path(capture->path.View()).WithExtension(Core::StringView(".json"));
		if (!FS::WriteFileAtomically(sidecar.CStr(), (const void*)json.View().Data(), json.View().ByteLength()))
			throw IED::RpcError(IED::ErrorCode::Internal, Core::StringView("the comment could not be saved"));
		debugger->Rescan(ws.id.View());
		return Core::String("{}");
	}

	static Core::String OpenMethod(Debugger* debugger, const IED::Request& request) {
		IED::Workspace ws = WorkspaceOf(request);
		Capture* capture = CaptureOf(debugger, ws.id.View(), request.params.Str("captureId").View());
		Session* session = debugger->Open(ws.id.View(), capture);
		return session->Json();
	}

	static Core::String ReplayMethod(Debugger* debugger, const IED::Request& request) {
		Session* session = SessionOf(debugger, request.params.Str("sessionId").View());
		Core::String method = request.params.Str("method");
		// What names a file on the server stays the server's: the capture it opens, the PNG it writes.
		Core::StringView name = method.View();
		if (name == "initialize" || name == "png" || name == "compareOpen" || name == "compareClose")
			throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String("gpu.replay does not send ") + method.View()).View());
		Serialization::DomNode params = request.params.Field("params");
		Core::String blob;
		Core::String result = debugger->Call(session, method.View(), params.IsValid() ? IED::NodeJson(params).View() : Core::StringView("{}"), blob);
		IED::JsonWriter json;
		json.BeginObject();
		json.RawField("result", result.View());
		if (!blob.IsEmpty()) json.Field("blob", blob.View());
		json.EndObject();
		return json.ToString();
	}

	// gpu.compare {sessionId, captureId}: the session's capture compared with another of its workspace ("" stops):
	// {session, result} with compareOpen's result.
	static Core::String CompareMethod(Debugger* debugger, const IED::Request& request) {
		Session* session = SessionOf(debugger, request.params.Str("sessionId").View());
		Core::String captureId = request.params.Str("captureId");
		Capture* other = captureId.IsEmpty() ? nullptr : CaptureOf(debugger, session->wsId.View(), captureId.View());
		Core::String result = debugger->Compare(session, other);
		IED::JsonWriter json;
		json.BeginObject();
		json.RawField("session", session->Json().View());
		json.RawField("result", result.View());
		json.EndObject();
		return json.ToString();
	}

	static Core::String CloseMethod(Debugger* debugger, const IED::Request& request) {
		Session* session = SessionOf(debugger, request.params.Str("sessionId").View());
		debugger->Close(session, Core::StringView("closed"));
		return Core::String("{}");
	}

	static void Register(Debugger* debugger, const char* name, func<Core::String(Debugger*, const IED::Request&)> method) {
		Core::String problem;
		if (!debugger->context->Method(Core::StringView(name), [debugger, method](const IED::Request& request) -> Core::String { return method(debugger, request); }, problem))
			debugger->context->Log(problem.View());
	}

	void RegisterMethods(Debugger* debugger) {
		Register(debugger, "gpu.status", StatusMethod);
		Register(debugger, "gpu.rescan", RescanMethod);
		Register(debugger, "gpu.launch", LaunchMethod);
		Register(debugger, "gpu.capture", CaptureMethod);
		Register(debugger, "gpu.stop", StopMethod);
		Register(debugger, "gpu.delete", DeleteMethod);
		Register(debugger, "gpu.comment", CommentMethod);
		Register(debugger, "gpu.open", OpenMethod);
		Register(debugger, "gpu.replay", ReplayMethod);
		Register(debugger, "gpu.compare", CompareMethod);
		Register(debugger, "gpu.close", CloseMethod);
	}

	// Captures written by a program, or deleted by hand, show at once.
	static void FilesChanged(Debugger* debugger, const IED::FileChanges& changes) {
		Core::String prefix = Core::String(kCaptureFolder) + "/";
		for (const IED::FileChange& change : changes.changes) {
			if (change.path.View().StartsWith(prefix.View())) {
				debugger->Rescan(changes.wsId.View());
				return;
			}
		}
		if (changes.overflowed) debugger->Rescan(changes.wsId.View());
	}

	void Activate(IED::PluginContext& context) {
		Debugger* debugger = new Debugger(&context);
		RegisterMethods(debugger);
		ProvideQuery(debugger);
		context.OnWorkspace([debugger](const IED::Workspace& ws) { debugger->Opened(ws); });
		context.OnFilesChanged([debugger](const IED::FileChanges& changes) { FilesChanged(debugger, changes); });
	}
}
