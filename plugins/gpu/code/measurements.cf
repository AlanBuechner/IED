// What the replay measured (docs/22 "Performance"): a session keeps its last timing and compareTiming answers and each
// range's experiments, so a client that comes back - a reload, another device - shows them again (gpu.measurements).
include "gpu.ch"

namespace GpuDebug
{
	void Debugger::Keep(Session* session, Core::StringView method, Serialization::DomNode params, Core::StringView answer) {
		if (params.IsValid() && params.Member("side").AsView() == "b") return;
		Core::String name = Core::String(method);
		Core::String kept = Core::String(answer);
		const int64 eid = params.IsValid() ? params.Member("eid").AsInt() : 0;
		context->Atomically([session, name, kept, eid](IED::Events& events) {
			if (name.View() == "timing") {
				session->timing = kept;
				session->timingStale = false;
				session->compareTiming = Core::String();
				session->experiments.Clear();
			}
			else if (name.View() == "compareTiming") session->compareTiming = kept;
			else if (name.View() == "experiments") {
				for (int64 i = 0; i < session->experiments.Count(); ++i)
					if (session->experiments[i]->eid == eid) {
						session->experiments.RemoveAt(i);
						break;
					}
				Experimented* experimented = new Experimented();
				experimented->eid = eid;
				experimented->answer = kept;
				session->experiments.Push(experimented);
			}
		});
	}

	void Session::Edited() {
		if (!timing.IsEmpty()) timingStale = true;
		compareTiming = Core::String();
		experiments.Clear();
	}

	Core::String Debugger::Measurements(Session* session) {
		IED::JsonWriter* json = new IED::JsonWriter();
		context->Atomically([session, json](IED::Events& events) {
			json->BeginObject();
			if (!session->timing.IsEmpty()) json->RawField("timing", session->timing.View());
			json->BoolField("timingStale", session->timingStale);
			if (!session->compareTiming.IsEmpty()) json->RawField("compareTiming", session->compareTiming.View());
			json->Key(Core::StringView("experiments"));
			json->BeginArray();
			for (Experimented* experimented : session->experiments) json->Raw(experimented->answer.View());
			json->EndArray();
			json->EndObject();
		});
		return json->ToString();
	}
}
