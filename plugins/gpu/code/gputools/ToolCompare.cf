// gpu_compare (docs/13 T-GPU-8, docs/22 "Compare"): a capture beside another - their events aligned (what one has and
// the other not, calls whose arguments changed), at an event the state that differs and how much of its output image
// does, and each pass's GPU time in both.
include "ToolText.ch"

namespace GpuDebug
{
	const int64 c_CompareLines = 40;

	static void AppendEid(Core::StringBuilder& text, int64 eid) {
		text.Append("EID ");
		text.AppendInt(eid);
	}

	static void AppendEvents(Core::StringBuilder& text, const Serialization::DomNode& events) {
		Serialization::DomNode counts = events.Member("counts");
		text.Append("Events (markers and actions, aligned by marker path and call");
		if (!events.Member("sameApi").AsBool()) text.Append(", actions by kind across the two APIs");
		text.Append("): ");
		text.AppendInt(counts.Member("same").AsInt());
		text.Append(" same, ");
		text.AppendInt(counts.Member("changed").AsInt());
		text.Append(" changed, ");
		text.AppendInt(counts.Member("removed").AsInt());
		text.Append(" only here, ");
		text.AppendInt(counts.Member("added").AsInt());
		text.Append(" only in the other.\n");
		Serialization::DomNode rows = events.Member("rows");
		int64 shown = 0;
		for (int64 i = 0; i < rows.Count(); i += 1) {
			Serialization::DomNode row = rows.At(i);
			Core::StringView status = row.At(3).AsView();
			if (status == "same") continue;
			if (shown == c_CompareLines) {
				text.Append("  ... more (the Compare view lists every one)\n");
				break;
			}
			shown += 1;
			text.Append("  ");
			if (status == "changed") {
				text.Append("changed: ");
				AppendEid(text, row.At(0).AsInt());
				text.Append(" (other ");
				AppendEid(text, row.At(1).AsInt());
				text.Append("): ");
				text.Append(row.At(5).AsView());
				text.Append(" => ");
				text.Append(row.At(6).AsView());
			}
			else {
				const bool here = status == "removed";
				text.Append(here ? "only here: " : "only in the other: ");
				AppendEid(text, row.At(here ? 0 : 1).AsInt());
				text.Append(" ");
				text.Append(row.At(4).AsView());
				text.Append(" ");
				text.Append(row.At(here ? 5 : 6).AsView());
			}
			text.Append("\n");
		}
	}

	static void AppendState(Core::StringBuilder& text, const Serialization::DomNode& state) {
		Serialization::DomNode differences = state.Member("differences");
		text.Append("State: ");
		text.AppendInt(differences.Count());
		text.Append(" of ");
		text.AppendInt(state.Member("compared").AsInt());
		text.Append(" items differ");
		text.Append(differences.Count() ? " (path: here => other):\n" : ".\n");
		for (int64 i = 0; i < differences.Count() && i < c_CompareLines; i += 1) {
			Serialization::DomNode d = differences.At(i);
			text.Append("  ");
			text.Append(d.At(0).AsView());
			text.Append(": ");
			text.Append(d.At(1).AsView().IsEmpty() ? Core::StringView("(none)") : d.At(1).AsView());
			text.Append(" => ");
			text.Append(d.At(2).AsView().IsEmpty() ? Core::StringView("(none)") : d.At(2).AsView());
			text.Append("\n");
		}
		if (differences.Count() > c_CompareLines) text.Append("  ...\n");
	}

	void AppendImageDifference(Core::StringBuilder& text, const Serialization::DomNode& image) {
		const int64 changed = image.Member("changed").AsInt(), pixels = image.Member("pixels").AsInt();
		text.Append("Output ");
		text.Append(image.Member("a").Member("name").AsView());
		text.Append(" (");
		text.AppendInt(image.Member("width").AsInt());
		text.Append("x");
		text.AppendInt(image.Member("height").AsInt());
		// A volume's or an array's slices scanned (Edit and Replay): the one shown is the one that changed most.
		const int64 scanned = image.Member("slicesScanned").IsValid() ? image.Member("slicesScanned").AsInt() : 1;
		if (scanned > 1) {
			text.Append(", slice ");
			text.AppendInt(image.Member("slice").AsInt());
			text.Append(" - ");
			text.AppendInt(image.Member("slicesChanged").AsInt());
			text.Append(" of the ");
			text.AppendInt(scanned);
			text.Append(" slices changed, this one most");
		}
		text.Append("): ");
		if (!changed) {
			text.Append("the same in both (no channel differs by more than ");
			AppendValue(text, image.Member("threshold").AsFloat());
			text.Append(").\n");
			return;
		}
		text.AppendInt(changed);
		text.Append(" of ");
		text.AppendInt(pixels);
		text.Append(" pixels (");
		text.AppendDouble(100.0 * (double)changed / (double)(pixels ? pixels : 1), 2);
		text.Append("%) differ; the largest channel difference is ");
		AppendValue(text, image.Member("largest").AsFloat());
		text.Append(", the mean ");
		AppendValue(text, image.Member("mean").AsFloat());
		Serialization::DomNode box = image.Member("box");
		text.Append("; they lie in (");
		text.AppendInt(box.At(0).AsInt());
		text.Append(", ");
		text.AppendInt(box.At(1).AsInt());
		text.Append(") to (");
		text.AppendInt(box.At(2).AsInt());
		text.Append(", ");
		text.AppendInt(box.At(3).AsInt());
		text.Append(")");
		if (image.Member("nan").AsInt()) {
			text.Append("; ");
			text.AppendInt(image.Member("nan").AsInt());
			text.Append(" are NaN or Inf on one side only");
		}
		text.Append(".\n");
	}

	static void AppendTime(Core::StringBuilder& text, const Serialization::DomNode& value) {
		if (value.IsNull()) text.Append("-");
		else AppendMs(text, value.AsFloat());
	}

	static void AppendTiming(Core::StringBuilder& text, const Serialization::DomNode& timing) {
		Serialization::DomNode frame = timing.Member("frameMs");
		const double here = frame.At(0).AsFloat(), other = frame.At(1).AsFloat();
		text.Append("GPU time of the frame: ");
		AppendMs(text, here);
		text.Append(" here, ");
		AppendMs(text, other);
		text.Append(" in the other");
		if (here > 0.0) {
			text.Append(" (");
			if (other >= here) text.Append("+");
			text.AppendDouble(100.0 * (other - here) / here, 1);
			text.Append("%)");
		}
		text.Append(".\nPasses (nested by indent): here | other | name | EIDs\n");
		Serialization::DomNode markers = timing.Member("markers");
		for (int64 i = 0; i < markers.Count(); i += 1) {
			Serialization::DomNode row = markers.At(i);
			for (int64 d = 0; d < row.At(2).AsInt(); d += 1) text.Append("  ");
			AppendTime(text, row.At(3));
			text.Append(" | ");
			AppendTime(text, row.At(4));
			text.Append(" | ");
			text.Append(row.At(5).AsView());
			text.Append(" | ");
			text.AppendInt(row.At(0).AsInt());
			text.Append("/");
			text.AppendInt(row.At(1).AsInt());
			text.Append("\n");
		}
	}

	Core::String CompareText(Debugger* debugger, const IED::Workspace& ws, const ToolCapture& target, const Serialization::DomNode& args) {
		Core::StringView asked = args.Member("other").AsView();
		if (asked.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("other is required: the capture to compare with (gpu_captures lists them)"));
		Capture* other = CaptureNamed(debugger, ws, asked);
		if (other == target.m_Capture) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("other names the same capture"));
		if (target.m_Session->m_CompareId != other->m_Id) debugger->Compare(target.m_Session, other);
		Core::StringBuilder text;
		text.Append("Comparing ");
		text.Append(target.m_Capture->m_Id.View());
		text.Append(" (here) with ");
		text.Append(other->m_Id.View());
		text.Append(" (the other).\n");
		Serialization::DomNode events = AskTool(debugger, target, "compareEvents", Core::StringView("{}"));
		AppendEvents(text, events);
		const int64 eid = IntArg(args, "eid", 0);
		if (eid) {
			int64 otherEid = 0;
			Serialization::DomNode rows = events.Member("rows");
			for (int64 i = 0; i < rows.Count() && !otherEid; i += 1)
				if (rows.At(i).At(0).AsInt() == eid) otherEid = rows.At(i).At(1).AsInt();
			text.Append("\nAt ");
			AppendEid(text, eid);
			if (!otherEid) text.Append(": the other capture has no event aligned with it.\n");
			else {
				text.Append(" (other ");
				AppendEid(text, otherEid);
				text.Append("):\n");
				IED::JsonWriter params;
				params.BeginObject();
				params.IntField("eid", eid);
				params.IntField("otherEid", otherEid);
				params.EndObject();
				AppendState(text, AskTool(debugger, target, "compareState", params.View()));
				try {
					AppendImageDifference(text, AskTool(debugger, target, "compareTexture", params.View()));
				}
				catch (IED::RpcError failed) {
					text.Append("Output: ");
					text.Append(failed.m_Message.View());
					text.Append("\n");
				}
			}
		}
		if (args.Member("timing").IsValid() && !args.Member("timing").IsNull() && !args.Member("timing").AsBool()) return text.ToString();
		Core::StringBuilder params;
		params.Append("{\"repeat\":");
		params.AppendInt(IntArg(args, "repeat", c_TimingRepeat));
		params.Append("}");
		text.Append("\n");
		AppendTiming(text, AskTool(debugger, target, "compareTiming", params.View()));
		return text.ToString();
	}
}
