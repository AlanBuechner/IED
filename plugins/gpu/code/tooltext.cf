include "tooltext.ch"

namespace GpuDebug
{
	const int64 kEventLines = 400;
	const int64 kResourceLines = 300;
	const int64 kTopEvents = 20;
	const int64 kTimingRepeat = 5;

	// What a change finds, read after it.
	class ToolFound
	{
		public Capture* capture;
		public Core::Array<Capture*> captures;
	}

	Serialization::DomNode ParseAnswer(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json, *doc).root;
	}

	int64 IntArg(const Serialization::DomNode& args, const char* key, int64 fallback) {
		Serialization::DomNode value = args.Member(key);
		return value.IsValid() && !value.IsNull() ? value.AsInt() : fallback;
	}

	static int32 AsciiLower(int32 c) { return c >= (int32)'A' && c <= (int32)'Z' ? c + 32 : c; }

	bool HasFolded(Core::StringView text, Core::StringView part) {
		for (int64 at = 0; at + part.ByteLength() <= text.ByteLength(); at += 1) {
			int64 i = 0;
			while (i < part.ByteLength() && AsciiLower(text.ByteAt(at + i)) == AsciiLower(part.ByteAt(i))) i += 1;
			if (i == part.ByteLength()) return true;
		}
		return false;
	}

	void AppendValue(Core::StringBuilder& text, double value) {
		if (value != value) {
			text.Append("NaN");
			return;
		}
		if ((value - value) != (value - value)) {
			text.Append(value > 0.0 ? "Inf" : "-Inf");
			return;
		}
		const double magnitude = value < 0.0 ? -value : value;
		if (magnitude != 0.0 && (magnitude < 0.0001 || magnitude >= 1.0e15)) {
			double mantissa = magnitude;
			int64 exponent = 0;
			while (mantissa >= 10.0) {
				mantissa = mantissa / 10.0;
				exponent += 1;
			}
			while (mantissa < 1.0) {
				mantissa = mantissa * 10.0;
				exponent -= 1;
			}
			if (value < 0.0) text.Append("-");
			AppendValue(text, mantissa);
			text.Append("e");
			text.AppendInt(exponent);
			return;
		}
		if (magnitude == (double)(int64)magnitude) {
			text.AppendInt((int64)value);
			return;
		}
		double m = magnitude;
		int32 decimals = 5;
		while (m >= 10.0 && decimals > 0) {
			m = m / 10.0;
			decimals -= 1;
		}
		while (m < 1.0 && decimals < 12) {
			m = m * 10.0;
			decimals += 1;
		}
		Core::StringBuilder number;
		number.AppendDouble(value, decimals);
		Core::StringView digits = number.View();
		int64 end = digits.ByteLength();
		if (digits.IndexOf('.', 0) >= 0) {
			while (end > 0 && digits.ByteAt(end - 1) == (int32)'0') end -= 1;
			if (end > 0 && digits.ByteAt(end - 1) == (int32)'.') end -= 1;
		}
		text.Append(digits.Substring(0, end));
	}

	// --- The capture and its session -------------------------------------------------------------------------------

	ToolCapture OpenNamed(Debugger* debugger, const IED::Workspace& ws, const Serialization::DomNode& args) {
		Core::String asked = Core::String(args.Member("capture").AsView());
		if (asked.IsEmpty()) asked = Core::String("latest");
		ToolFound* found = new ToolFound();
		Core::String wsId = ws.id;
		debugger->context->Atomically([debugger, wsId, asked, found](IED::Events& events) {
			Library** library = debugger->libraries.Find(wsId);
			if (!library) return;
			if (asked.View() == "latest") found->capture = (*library)->captures.Count() ? (*library)->captures[0] : nullptr;
			else found->capture = (*library)->Find(asked.View());
		});
		if (!found->capture)
			throw IED::RpcError(IED::ErrorCode::NotFound, asked.View() == "latest" ? Core::StringView("the workspace has no GPU captures: launch the program for capture and capture a frame first")
				: (Core::String("no capture ") + asked.View() + " (gpu_captures lists them)").View());
		ToolCapture target;
		target.capture = found->capture;
		target.wsId = ws.id;
		target.root = ws.root;
		target.session = debugger->Open(ws.id.View(), found->capture);
		target.api = Core::String(ParseAnswer(target.session->summary.View()).Member("api").AsView());
		return target;
	}

	Serialization::DomNode AskTool(Debugger* debugger, const ToolCapture& target, const char* method, Core::StringView params) {
		Core::Array<uint8> binary;
		return ParseAnswer(debugger->Ask(target.session, Core::StringView(method), params, binary).View());
	}

	// The first item under `items` (and their children) with role `role` that names a resource.
	static int64 ItemWithRole(const Serialization::DomNode& items, Core::StringView role) {
		for (int64 i = 0; i < items.Count(); i += 1) {
			Serialization::DomNode item = items.At(i);
			if (item.Member("resource").IsValid() && item.Member("role").AsView() == role) return item.Member("resource").AsInt();
			const int64 child = ItemWithRole(item.Member("children"), role);
			if (child) return child;
		}
		return 0;
	}

	int64 ResourceArg(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args, int64 eid) {
		const int64 named = IntArg(args, "resource", 0);
		if (named) return named;
		Core::StringBuilder params;
		params.Append("{\"eid\":");
		params.AppendInt(eid);
		params.Append("}");
		Serialization::DomNode groups = AskTool(debugger, target, "state", params.View()).Member("groups");
		const char*[3] roles = {"rt", "depth", "uav"};
		for (int64 r = 0; r < 3; r += 1)
			for (int64 g = 0; g < groups.Count(); g += 1) {
				const int64 id = ItemWithRole(groups.At(g).Member("items"), Core::StringView(roles[r]));
				if (id) return id;
			}
		return 0;
	}

	Core::String ResourceName(Debugger* debugger, const ToolCapture& target, int64 id) {
		Serialization::DomNode resources = AskTool(debugger, target, "resources", Core::StringView("{}")).Member("resources");
		for (int64 i = 0; i < resources.Count(); i += 1)
			if (resources.At(i).Member("id").AsInt() == id) return Core::String(resources.At(i).Member("name").AsView());
		Core::StringBuilder text;
		text.Append("#");
		text.AppendInt(id);
		return text.ToString();
	}

	// --- gpu_captures -------------------------------------------------------------------------------------------------

	Core::String CapturesText(Debugger* debugger, const IED::Workspace& ws) {
		ToolFound* found = new ToolFound();
		Core::String wsId = ws.id;
		debugger->context->Atomically([debugger, wsId, found](IED::Events& events) {
			Library** library = debugger->libraries.Find(wsId);
			if (library)
				for (Capture* capture : (*library)->captures) found->captures.Push(capture);
		});
		if (!found->captures.Count()) return Core::String("No GPU captures in this workspace. The owner launches the program for capture (GPU > Launch for Capture) and captures a frame.");
		Core::StringBuilder text;
		text.Append("GPU captures, newest first (id | program | API | frame | captured | GPU | size | comment):\n");
		for (Capture* capture : found->captures) {
			Serialization::DomNode meta = ParseAnswer(capture->sidecar.View());
			text.Append(capture->id.View());
			text.Append(" | ");
			text.Append(meta.Member("program").AsView());
			text.Append(" | ");
			text.Append(meta.Member("api").AsView());
			text.Append(" | ");
			text.AppendInt(meta.Member("frame").AsInt());
			text.Append(" | ");
			text.Append(meta.Member("time").AsView());
			text.Append(" | ");
			text.Append(meta.Member("gpu").AsView());
			text.Append(" | ");
			text.AppendInt(capture->bytes / 1024);
			text.Append(" KiB | ");
			text.Append(meta.Member("comment").AsView());
			text.Append("\n");
		}
		return text.ToString();
	}

	// --- gpu_events ----------------------------------------------------------------------------------------------------

	// Whether event `row` ([eid, parent, kind, hidden, last, queue, name]) passes `filter`: "kind:draw" words name kinds,
	// other words must all be in its name.
	static bool Passes(const Serialization::DomNode& row, Core::StringView filter) {
		Core::StringView rest = filter.Trimmed();
		bool kindAsked = false, kindMatched = false;
		while (!rest.IsEmpty()) {
			int64 space = rest.IndexOf(' ', 0);
			Core::StringView word = space < 0 ? rest : rest.Substring(0, space);
			rest = space < 0 ? Core::StringView("") : rest.Substring(space + 1, rest.ByteLength() - space - 1).Trimmed();
			if (word.StartsWith(Core::StringView("kind:"))) {
				kindAsked = true;
				if (row.At(2).AsView() == word.Substring(5, word.ByteLength() - 5)) kindMatched = true;
			}
			else if (!HasFolded(row.At(6).AsView(), word)) return false;
		}
		return !kindAsked || kindMatched;
	}

	Core::String EventsText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		Serialization::DomNode answer = AskTool(debugger, target, "events", Core::StringView("{}"));
		Serialization::DomNode rows = answer.Member("events");
		Core::StringView filter = args.Member("filter").AsView();
		const bool all = args.Member("all").AsBool();
		const int64 limit = IntArg(args, "max", kEventLines);
		Core::HashMap<int64, int64> depthOf;
		int64 actions = 0;
		for (int64 i = 0; i < rows.Count(); i += 1) {
			Serialization::DomNode row = rows.At(i);
			int64* parentDepth = depthOf.Find(row.At(1).AsInt());
			depthOf.Insert(row.At(0).AsInt(), parentDepth ? *parentDepth + 1 : 0);
			if (!row.At(3).AsInt() && row.At(2).AsView() != "marker") actions += 1;
		}
		Core::StringBuilder text;
		text.Append(target.capture->id.View());
		text.Append(" (");
		text.Append(target.api.View());
		text.Append("): ");
		text.AppendInt(rows.Count());
		text.Append(" events, ");
		text.AppendInt(actions);
		text.Append(" actions. EID, kind, name; markers group what follows them");
		text.Append(all ? ".\n" : "; state-setting calls are left out (all: true lists them).\n");
		int64 shown = 0, matched = 0;
		for (int64 i = 0; i < rows.Count(); i += 1) {
			Serialization::DomNode row = rows.At(i);
			if (row.At(3).AsInt() && !all) continue;
			if (!Passes(row, filter)) continue;
			matched += 1;
			if (shown >= limit) continue;
			shown += 1;
			text.AppendInt(row.At(0).AsInt());
			text.Append("  ");
			int64* depth = depthOf.Find(row.At(0).AsInt());
			for (int64 d = 0; filter.Trimmed().IsEmpty() && depth && d < *depth; d += 1) text.Append("  ");
			text.Append(row.At(2).AsView());
			text.Append("  ");
			text.Append(row.At(6).AsView());
			text.Append("\n");
		}
		if (matched > shown) {
			text.Append("... ");
			text.AppendInt(matched - shown);
			text.Append(" more; narrow with filter or raise max.\n");
		}
		if (!matched) text.Append("No event matches the filter.\n");
		return text.ToString();
	}

	// --- gpu_resources ------------------------------------------------------------------------------------------------

	Core::String ResourcesText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		Serialization::DomNode resources = AskTool(debugger, target, "resources", Core::StringView("{}")).Member("resources");
		Core::StringView filter = args.Member("filter").AsView();
		Core::StringBuilder text;
		text.Append("Resources (id | name | type | format | size | first use EID | uses):\n");
		int64 shown = 0;
		for (int64 i = 0; i < resources.Count() && shown < kResourceLines; i += 1) {
			Serialization::DomNode r = resources.At(i);
			if (!filter.IsEmpty() && !HasFolded(r.Member("name").AsView(), filter)) continue;
			shown += 1;
			const bool buffer = r.Member("dimension").AsView() == "BUFFER";
			text.AppendInt(r.Member("id").AsInt());
			text.Append(" | ");
			text.Append(r.Member("name").AsView());
			text.Append(" | ");
			text.Append(buffer ? Core::StringView("buffer") : r.Member("dimension").AsView());
			text.Append(" | ");
			text.Append(buffer ? Core::StringView("-") : r.Member("format").AsView());
			text.Append(" | ");
			if (buffer) {
				text.AppendInt(r.Member("width").AsInt());
				text.Append(" B");
			}
			else {
				text.AppendInt(r.Member("width").AsInt());
				text.Append("x");
				text.AppendInt(r.Member("height").AsInt());
				if (r.Member("depthOrArraySize").AsInt() > 1) {
					text.Append("x");
					text.AppendInt(r.Member("depthOrArraySize").AsInt());
				}
				if (r.Member("mipLevels").AsInt() > 1) {
					text.Append(", ");
					text.AppendInt(r.Member("mipLevels").AsInt());
					text.Append(" mips");
				}
			}
			text.Append(" | ");
			if (r.Member("firstUse").IsValid()) text.AppendInt(r.Member("firstUse").AsInt());
			else text.Append("-");
			text.Append(" | ");
			text.AppendInt(r.Member("uses").AsInt());
			text.Append("\n");
		}
		if (!shown) text.Append("None match.\n");
		return text.ToString();
	}

	// --- gpu_timing ---------------------------------------------------------------------------------------------------

	static int64 Column(const Serialization::DomNode& columns, const char* name) {
		for (int64 i = 0; i < columns.Count(); i += 1)
			if (columns.At(i).AsView() == Core::StringView(name)) return i;
		return -1;
	}

	static void AppendMs(Core::StringBuilder& text, double ms) {
		text.AppendDouble(ms, ms < 0.01 ? 4 : ms < 1.0 ? 3 : 2);
		text.Append(" ms");
	}

	Core::String TimingText(Debugger* debugger, const ToolCapture& target, const Serialization::DomNode& args) {
		Core::StringBuilder params;
		params.Append("{\"repeat\":");
		params.AppendInt(IntArg(args, "repeat", kTimingRepeat));
		params.Append("}");
		Serialization::DomNode timing = AskTool(debugger, target, "timing", params.View());
		Serialization::DomNode events = AskTool(debugger, target, "events", Core::StringView("{}")).Member("events");
		Core::HashMap<int64, int64> rowOf;
		for (int64 i = 0; i < events.Count(); i += 1) rowOf.Insert(events.At(i).At(0).AsInt(), i);
		Serialization::DomNode statColumns = timing.Member("statColumns");
		const int64 prims = Column(statColumns, "iaPrimitives"), ps = Column(statColumns, "psInvocations"), cs = Column(statColumns, "csInvocations");
		Core::HashMap<int64, int64> statOf;
		Serialization::DomNode stats = timing.Member("stats");
		for (int64 i = 0; i < stats.Count(); i += 1) statOf.Insert(stats.At(i).At(0).AsInt(), i);
		Core::StringBuilder text;
		text.Append("GPU time of the frame: ");
		AppendMs(text, timing.Member("frameMs").AsFloat());
		text.Append(" (median of ");
		text.AppendInt(timing.Member("repeat").AsInt());
		text.Append(" replays on the replay GPU).\n");
		const bool byEvent = args.Member("by").AsView() == "event";
		if (!byEvent) {
			text.Append("Passes (markers, nested by indent): GPU ms | name | EID\n");
			Serialization::DomNode markers = timing.Member("markers");
			Core::HashMap<int64, int64> depthOf;
			for (int64 i = 0; i < events.Count(); i += 1) {
				int64* parent = depthOf.Find(events.At(i).At(1).AsInt());
				depthOf.Insert(events.At(i).At(0).AsInt(), parent ? *parent + 1 : 0);
			}
			for (int64 i = 0; i < markers.Count(); i += 1) {
				const int64 eid = markers.At(i).At(0).AsInt();
				int64* row = rowOf.Find(eid);
				int64* depth = depthOf.Find(eid);
				for (int64 d = 0; depth && d < *depth; d += 1) text.Append("  ");
				AppendMs(text, markers.At(i).At(1).AsFloat());
				text.Append(" | ");
				text.Append(row ? events.At(*row).At(6).AsView() : Core::StringView("?"));
				text.Append(" | ");
				text.AppendInt(eid);
				text.Append("\n");
			}
			return text.ToString();
		}
		// The costliest actions first.
		Serialization::DomNode rows = timing.Member("events");
		Core::Array<int64> order;
		for (int64 i = 0; i < rows.Count(); i += 1) order.Push(i);
		for (int64 i = 1; i < order.Count(); i += 1)
			for (int64 j = i; j > 0 && rows.At(order[j]).At(1).AsFloat() > rows.At(order[j - 1]).At(1).AsFloat(); j -= 1) {
				const int64 swap = order[j];
				order[j] = order[j - 1];
				order[j - 1] = swap;
			}
		const int64 top = IntArg(args, "top", kTopEvents);
		text.Append("Costliest actions: GPU ms | EID | name | primitives | PS invocations | CS invocations\n");
		for (int64 i = 0; i < order.Count() && i < top; i += 1) {
			Serialization::DomNode row = rows.At(order[i]);
			const int64 eid = row.At(0).AsInt();
			int64* at = rowOf.Find(eid);
			int64* stat = statOf.Find(eid);
			AppendMs(text, row.At(1).AsFloat());
			text.Append(" | ");
			text.AppendInt(eid);
			text.Append(" | ");
			text.Append(at ? events.At(*at).At(6).AsView() : Core::StringView("?"));
			const int64[3] columns = {prims, ps, cs};
			for (int64 c = 0; c < 3; c += 1) {
				text.Append(" | ");
				if (stat && columns[c] >= 0) text.AppendInt(stats.At(*stat).At(columns[c]).AsInt());
				else text.Append("-");
			}
			text.Append("\n");
		}
		return text.ToString();
	}

	// --- Dispatch -----------------------------------------------------------------------------------------------------

	ToolAnswer AnswerTool(Debugger* debugger, const IED::Workspace& ws, Core::StringView tool, const Serialization::DomNode& args) {
		ToolAnswer answer;
		if (tool == "captures" || tool == "capture") {
			answer.text = tool == "captures" ? CapturesText(debugger, ws) : CaptureText(debugger, ws, args);
			return answer;
		}
		ToolCapture target = OpenNamed(debugger, ws, args);
		if (tool == "events") answer.text = EventsText(debugger, target, args);
		else if (tool == "resources") answer.text = ResourcesText(debugger, target, args);
		else if (tool == "timing") answer.text = TimingText(debugger, target, args);
		else if (tool == "state") answer.text = StateText(debugger, target, args);
		else if (tool == "shader") answer.text = ShaderText(debugger, target, args);
		else if (tool == "pixel") answer.text = PixelText(debugger, target, args);
		else if (tool == "buffer") answer.text = BufferText(debugger, target, args);
		else if (tool == "texture") answer = TextureAnswer(debugger, target, args);
		else if (tool == "scan") answer.text = ScanText(debugger, target, args);
		else if (tool == "debug") answer.text = DebugText(debugger, target, args);
		else throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String("no GPU tool ") + tool).View());
		return answer;
	}
}
