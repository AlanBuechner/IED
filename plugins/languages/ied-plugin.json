// Basic languages: ids, file extensions, comment tokens and brackets for common languages, so documents get a
// language without a dedicated plugin. The ids are Monaco's, whose built-in tokenizers color them until a language
// plugin brings a grammar and semantic tokens. A language plugin that names the same extension later wins. Their file
// icons (docs/15 "Icons"): a short label in the language's hue, a header's an "h"; data, documents, scripts, shaders
// and media in their own hues; and projects by the marker files of their ecosystems.
{
	"manifestVersion": 1,
	"id": "ied.languages",
	"name": "Basic Languages",
	"version": "0.1.0",
	"description": "Language ids, extensions, comments and brackets for common languages.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"contributes": {
		"headerSourcePairs": [
			{ "extensions": [".h", ".c", ".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx", ".inl"], "searchPaths": ["../include", "../src", "../source"] }
		],
		"languages": [
			{ "id": "c", "aliases": ["C"], "extensions": [".c", ".h"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "cpp", "aliases": ["C++"], "extensions": [".cpp", ".cc", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h++", ".inl", ".ipp"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "csharp", "aliases": ["C#"], "extensions": [".cs", ".csx"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "python", "aliases": ["Python"], "extensions": [".py", ".pyw", ".pyi"], "lineComment": "#", "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "javascript", "aliases": ["JavaScript"], "extensions": [".js", ".mjs", ".cjs", ".jsx"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "typescript", "aliases": ["TypeScript"], "extensions": [".ts", ".mts", ".cts", ".tsx"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "json", "aliases": ["JSON"], "extensions": [".json", ".jsonc", ".sln", ".proj"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"]] },
			{ "id": "markdown", "aliases": ["Markdown"], "extensions": [".md", ".markdown"] },
			{ "id": "html", "aliases": ["HTML"], "extensions": [".html", ".htm"], "blockComment": ["<!--", "-->"] },
			{ "id": "css", "aliases": ["CSS"], "extensions": [".css"], "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "scss", "aliases": ["SCSS"], "extensions": [".scss"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "xml", "aliases": ["XML"], "extensions": [".xml", ".xaml", ".csproj", ".vcxproj", ".props", ".targets", ".svg"], "blockComment": ["<!--", "-->"] },
			{ "id": "yaml", "aliases": ["YAML"], "extensions": [".yaml", ".yml"], "lineComment": "#" },
			{ "id": "ini", "aliases": ["TOML", "INI"], "extensions": [".toml", ".ini", ".cfg", ".editorconfig"], "lineComment": "#" },
			{ "id": "shell", "aliases": ["Shell"], "extensions": [".sh", ".bash", ".zsh"], "lineComment": "#" },
			{ "id": "powershell", "aliases": ["PowerShell"], "extensions": [".ps1", ".psm1", ".psd1"], "lineComment": "#", "blockComment": ["<#", "#>"] },
			{ "id": "bat", "aliases": ["Batch"], "extensions": [".bat", ".cmd"], "lineComment": "rem" },
			{ "id": "go", "aliases": ["Go"], "extensions": [".go"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "rust", "aliases": ["Rust"], "extensions": [".rs"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "java", "aliases": ["Java"], "extensions": [".java"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "lua", "aliases": ["Lua"], "extensions": [".lua"], "lineComment": "--", "blockComment": ["--[[", "]]"] },
			{ "id": "sql", "aliases": ["SQL"], "extensions": [".sql"], "lineComment": "--", "blockComment": ["/*", "*/"] },
			{ "id": "hlsl", "aliases": ["HLSL"], "extensions": [".hlsl", ".hlsli", ".fx", ".usf", ".ush"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] },
			{ "id": "dockerfile", "aliases": ["Dockerfile"], "fileNames": ["Dockerfile"], "lineComment": "#" },
			{ "id": "plaintext", "aliases": ["Plain Text"], "extensions": [".txt", ".log"], "fileNames": [".gitignore", ".gitattributes", "LICENSE"] }
		],
		"fileIcons": [
			{ "languageId": "c", "extensions": [".c"], "label": "C", "color": "--hue-blue" },
			{ "languageId": "c", "extensions": [".h"], "label": "h", "color": "--hue-violet" },
			{ "languageId": "cpp", "extensions": [".cpp", ".cc", ".cxx", ".c++"], "label": "C++", "color": "--hue-violet" },
			{ "languageId": "cpp", "extensions": [".hpp", ".hh", ".hxx", ".h++", ".inl", ".ipp", ".tpp"], "label": "h", "color": "--hue-violet" },
			{ "languageId": "csharp", "extensions": [".cs", ".csx"], "label": "C#", "color": "--hue-green" },
			{ "languageId": "python", "extensions": [".py", ".pyw", ".pyi"], "label": "PY", "color": "--hue-cyan" },
			{ "languageId": "javascript", "extensions": [".js", ".mjs", ".cjs", ".jsx"], "label": "JS", "color": "--hue-yellow" },
			{ "languageId": "typescript", "extensions": [".ts", ".mts", ".cts", ".tsx"], "label": "TS", "color": "--hue-blue" },
			{ "languageId": "typescript", "extensions": [".d.ts"], "label": "DTS", "color": "--hue-blue" },
			{ "languageId": "json", "extensions": [".json", ".jsonc"], "label": "{}", "color": "--hue-amber" },
			{ "languageId": "json", "extensions": [".ied.sln"], "label": "SLN", "color": "--icon-solution" },
			{ "languageId": "json", "extensions": [".ied.proj"], "label": "PRJ", "color": "--icon-project" },
			{ "languageId": "markdown", "extensions": [".md", ".markdown"], "label": "MD", "color": "--hue-gray" },
			{ "languageId": "html", "extensions": [".html", ".htm"], "label": "<>", "color": "--hue-orange" },
			{ "languageId": "css", "extensions": [".css"], "label": "#", "color": "--hue-blue" },
			{ "languageId": "scss", "extensions": [".scss"], "label": "#", "color": "--hue-pink" },
			{ "languageId": "xml", "extensions": [".xml", ".xaml", ".props", ".targets"], "label": "XML", "color": "--hue-orange" },
			{ "languageId": "xml", "extensions": [".csproj", ".vcxproj", ".filters"], "label": "PRJ", "color": "--hue-violet" },
			{ "languageId": "yaml", "extensions": [".yaml", ".yml"], "label": "YML", "color": "--hue-red" },
			{ "languageId": "ini", "extensions": [".toml", ".ini", ".cfg", ".editorconfig"], "icon": "$(gear)", "color": "--hue-gray" },
			{ "languageId": "shell", "extensions": [".sh", ".bash", ".zsh"], "label": "$", "color": "--hue-green" },
			{ "languageId": "powershell", "extensions": [".ps1", ".psm1", ".psd1"], "label": "PS", "color": "--hue-blue" },
			{ "languageId": "bat", "extensions": [".bat", ".cmd"], "label": "BAT", "color": "--hue-lime" },
			{ "languageId": "go", "extensions": [".go"], "label": "GO", "color": "--hue-cyan" },
			{ "languageId": "go", "fileNames": ["go.mod", "go.sum", "go.work"], "icon": "$(package)", "color": "--hue-cyan" },
			{ "languageId": "rust", "extensions": [".rs"], "label": "RS", "color": "--hue-orange" },
			{ "languageId": "java", "extensions": [".java"], "label": "J", "color": "--hue-red" },
			{ "languageId": "lua", "extensions": [".lua"], "label": "LUA", "color": "--hue-indigo" },
			{ "languageId": "sql", "extensions": [".sql"], "label": "SQL", "color": "--hue-amber" },
			{ "languageId": "hlsl", "extensions": [".hlsl", ".fx", ".usf"], "label": "HL", "color": "--hue-pink" },
			{ "languageId": "hlsl", "extensions": [".hlsli", ".ush"], "label": "h", "color": "--hue-pink" },
			{ "extensions": [".glsl", ".vert", ".frag", ".comp", ".geom", ".tesc", ".tese"], "label": "GL", "color": "--hue-pink" },
			{ "extensions": [".wgsl"], "label": "WG", "color": "--hue-pink" },
			{ "languageId": "dockerfile", "fileNames": ["Dockerfile"], "label": "DK", "color": "--hue-cyan" },
			{ "extensions": [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tga", ".dds", ".ico", ".webp", ".svg", ".psd", ".exr", ".hdr"], "icon": "$(file-media)", "color": "--hue-teal" },
			{ "extensions": [".wav", ".mp3", ".ogg", ".flac"], "icon": "$(unmute)", "color": "--hue-teal" },
			{ "extensions": [".mp4", ".webm", ".mov"], "icon": "$(device-camera-video)", "color": "--hue-teal" },
			{ "extensions": [".ttf", ".otf", ".woff", ".woff2"], "icon": "$(text-size)", "color": "--hue-gray" },
			{ "extensions": [".zip", ".7z", ".tar", ".gz", ".rar"], "icon": "$(file-zip)", "color": "--hue-amber" },
			{ "extensions": [".exe", ".dll", ".lib", ".a", ".so", ".obj", ".o", ".pdb"], "icon": "$(file-binary)", "color": "--hue-gray" },
			{ "fileNames": ["LICENSE", "LICENSE.txt", "LICENSE.md"], "icon": "$(law)", "color": "--hue-amber" }
		],
		"projectIcons": [
			{ "languageId": "typescript", "label": "TS", "color": "--hue-blue", "markers": ["tsconfig.json"] },
			{ "languageId": "javascript", "label": "JS", "color": "--hue-yellow", "markers": ["package.json"] },
			{ "languageId": "python", "label": "PY", "color": "--hue-cyan", "markers": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt"] },
			{ "languageId": "go", "label": "GO", "color": "--hue-cyan", "markers": ["go.mod", "go.work"] },
			{ "languageId": "csharp", "label": "C#", "color": "--hue-green", "markers": ["*.csproj"] },
			{ "languageId": "java", "label": "J", "color": "--hue-red", "markers": ["pom.xml", "build.gradle", "build.gradle.kts"] }
		]
	}
}
