include "http.ch"

namespace Mcp
{
	const int64 kHttpReadBytes = 65536;
	const int64 kHttpMostHeadBytes = 65536;
	const int64 kHttpMostBodyBytes = 64 * 1024 * 1024;

	bool HttpExchange::Send(Core::StringView method, Core::StringView url, const Core::Array<Core::String>& headers, Core::StringView body, int32 connectMs, Core::String& error) {
		this.method = Core::String(method);
		const Http::Url parsed = Http::ParseUrl(url);
		if (!parsed.valid || parsed.webSocket) {
			error = Core::String("not an http://host[:port]/path URL: ") + url;
			return false;
		}
		const Net::Resolution found = Net::Resolve(parsed.host.CStr(), parsed.port);
		if (!found.Found()) {
			error = (Core::String("cannot find ") + parsed.host.View() + ": ") + found.error.View();
			return false;
		}
		stream = Net::TcpStream::Connect(found.addresses[0], connectMs);
		if (!stream.IsOpen()) {
			error = (Core::String("cannot connect to ") + Http::HostHeader(parsed).View() + ": ") + stream.Error();
			return false;
		}
		Core::StringBuilder request;
		request.Append(method);
		request.Append(" ");
		request.Append(parsed.target.View());
		request.Append(" HTTP/1.1\r\nHost: ");
		request.Append(Http::HostHeader(parsed).View());
		request.Append("\r\nAccept: application/json, text/event-stream\r\nConnection: close\r\n");
		if (!body.IsEmpty()) request.Append("Content-Type: application/json\r\n");
		request.Append("Content-Length: ");
		request.AppendInt(body.ByteLength());
		request.Append("\r\n");
		for (const Core::String& header : headers) {
			request.Append(header.View());
			request.Append("\r\n");
		}
		request.Append("\r\n");
		request.Append(body);
		if (!stream.SendText(request.View(), connectMs)) {
			error = Core::String("the request could not be sent: ") + stream.Error();
			return false;
		}
		return true;
	}

	BodyRead HttpExchange::Receive(int32 waitMs) {
		if (closed) return BodyRead::Ended;
		char[kHttpReadBytes] buffer;
		const int64 got = stream.Receive((void*)&buffer[0], kHttpReadBytes, waitMs);
		if (got > 0) {
			raw.Append(Core::StringView(&buffer[0], got));
			return BodyRead::Bytes;
		}
		if (got == 0) {
			closed = true;
			return BodyRead::Ended;
		}
		if (stream.TimedOut()) return BodyRead::Waiting;
		error = Core::String(stream.Error());
		return BodyRead::Failed;
	}

	BodyRead HttpExchange::ReadHead(int32 waitMs) {
		for (;;) {
			const Http::HeadParse parse = Http::ParseResponseHead(raw.View(), kHttpMostHeadBytes, head);
			if (parse.status == Http::ParseStatus::Complete && head.status >= 200) {
				raw = Core::String(raw.View().Substring(parse.length, raw.ByteLength() - parse.length));
				framing = Http::ResponseFraming(head.headers, head.status, method.View());
				headIn = true;
				return BodyRead::Bytes;
			}
			if (parse.status == Http::ParseStatus::Complete) {
				raw = Core::String(raw.View().Substring(parse.length, raw.ByteLength() - parse.length));
				continue;
			}
			if (parse.status != Http::ParseStatus::Incomplete) {
				error = parse.error;
				return BodyRead::Failed;
			}
			const BodyRead got = Receive(waitMs);
			if (got == BodyRead::Ended) {
				error = Core::String("the connection ended before the answer's head");
				return BodyRead::Failed;
			}
			if (got != BodyRead::Bytes) return got;
		}
	}

	BodyRead HttpExchange::Decode(Core::String& out) {
		if (framing.kind == Http::BodyKind::Chunked) {
			Core::Array<uint8> body;
			const Http::ChunkedStep step = chunks.Feed(raw.View(), kHttpMostBodyBytes, body);
			raw = Core::String(raw.View().Substring(step.consumed, raw.ByteLength() - step.consumed));
			out.Append(Core::StringView((const char*)body.Data(), body.Count()));
			if (step.status == Http::ParseStatus::Complete) return BodyRead::Ended;
			if (step.status != Http::ParseStatus::Incomplete) {
				error = step.error;
				return BodyRead::Failed;
			}
			return body.Count() > 0 ? BodyRead::Bytes : BodyRead::Waiting;
		}
		const int64 had = raw.ByteLength();
		out.Append(raw.View());
		bodyRead += had;
		raw = Core::String();
		if (framing.kind == Http::BodyKind::Length && bodyRead >= framing.length) return BodyRead::Ended;
		if (framing.kind == Http::BodyKind::None) return BodyRead::Ended;
		return had > 0 ? BodyRead::Bytes : BodyRead::Waiting;
	}

	BodyRead HttpExchange::Read(Core::String& out, int32 waitMs) {
		if (!headIn) {
			error = Core::String("the answer's head is not in");
			return BodyRead::Failed;
		}
		if (!raw.IsEmpty()) {
			const BodyRead decoded = Decode(out);
			if (decoded != BodyRead::Waiting) return decoded;
		}
		const BodyRead got = Receive(waitMs);
		if (got == BodyRead::Ended) {
			const BodyRead last = Decode(out);
			if (framing.kind == Http::BodyKind::Chunked && last != BodyRead::Ended) {
				error = Core::String("the connection ended inside a chunked body");
				return BodyRead::Failed;
			}
			return BodyRead::Ended;
		}
		if (got != BodyRead::Bytes) return got;
		return Decode(out);
	}

	Core::String HttpExchange::Header(Core::StringView name) const {
		const Core::String* value = head.headers.Find(name);
		return value ? *value : Core::String();
	}

	void EventReader::Feed(Core::StringView bytes) { pending.Append(bytes); }

	bool EventReader::Next(Core::String& done) {
		for (;;) {
			const int64 end = pending.View().IndexOf('\n', 0);
			if (end < 0) return false;
			Core::StringView line = pending.View().Substring(0, end);
			if (line.EndsWith(Core::StringView("\r"))) line = line.Substring(0, line.ByteLength() - 1);
			const Core::String kept = Core::String(line);
			pending = Core::String(pending.View().Substring(end + 1, pending.ByteLength() - end - 1));
			if (Line(kept.View(), done)) return true;
		}
	}

	// One line: true when it ends an event that had data.
	bool EventReader::Line(Core::StringView line, Core::String& done) {
		if (line.IsEmpty()) {
			if (!hasData) return false;
			done = data;
			data = Core::String();
			hasData = false;
			return true;
		}
		if (!line.StartsWith(Core::StringView("data:"))) return false;
		Core::StringView value = line.Substring(5, line.ByteLength() - 5);
		if (value.StartsWith(Core::StringView(" "))) value = value.Substring(1, value.ByteLength() - 1);
		if (hasData) data.Append("\n");
		data.Append(value);
		hasData = true;
		return false;
	}

	bool EventReader::Flush(Core::String& done) {
		if (!pending.IsEmpty()) {
			const Core::String last = pending;
			pending = Core::String();
			if (Line(last.View(), done)) return true;
		}
		return Line(Core::StringView(""), done);
	}
}
