include "Http.ch"

namespace Mcp
{
	const int64 c_HttpReadBytes = 65536;
	const int64 c_HttpMostHeadBytes = 65536;
	const int64 c_HttpMostBodyBytes = 64 * 1024 * 1024;

	bool HttpExchange::Send(Core::StringView method, Core::StringView url, const Net::TlsClientOptions& tls, const Core::Array<Core::String>& headers,
		Core::StringView body, int32 connectMs, Core::String& error) {
		this.m_Method = Core::String(method);
		const Http::Url parsed = Http::ParseUrl(url);
		if (!parsed.valid || parsed.webSocket) {
			error = Core::String("not an http:// or https://host[:port]/path URL: ") + url;
			return false;
		}
		m_Stream = Http::ConnectTo(parsed, tls, connectMs, error);
		if (!m_Stream.IsOpen()) return false;
		Core::StringBuilder request;
		request.Append(method);
		request.Append(" ");
		request.Append(parsed.target.View());
		request.Append(" HTTP/1.1\r\nHost: ");
		request.Append(Http::HostHeader(parsed).View());
		request.Append("\r\nAccept: application/json, text/event-stream\r\nConnection: close\r\n");
		if (!body.IsEmpty()) request.Append("Content-Type: application/json\r\n");
		request.Append("Content-Length: ");
		request.AppendInt(body.ByteLength());
		request.Append("\r\n");
		for (const Core::String& header : headers) {
			request.Append(header.View());
			request.Append("\r\n");
		}
		request.Append("\r\n");
		request.Append(body);
		if (!m_Stream.SendText(request.View(), connectMs)) {
			error = Core::String("the request could not be sent: ") + m_Stream.Error();
			return false;
		}
		return true;
	}

	BodyRead HttpExchange::Receive(int32 waitMs) {
		if (m_Closed) return BodyRead::Ended;
		char[c_HttpReadBytes] buffer;
		const int64 got = m_Stream.Receive((void*)&buffer[0], c_HttpReadBytes, waitMs);
		if (got > 0) {
			m_Raw.Append(Core::StringView(&buffer[0], got));
			return BodyRead::Bytes;
		}
		if (got == 0) {
			m_Closed = true;
			return BodyRead::Ended;
		}
		if (m_Stream.TimedOut()) return BodyRead::Waiting;
		m_Error = Core::String(m_Stream.Error());
		return BodyRead::Failed;
	}

	BodyRead HttpExchange::ReadHead(int32 waitMs) {
		for (;;) {
			const Http::HeadParse parse = Http::ParseResponseHead(m_Raw.View(), c_HttpMostHeadBytes, m_Head);
			if (parse.status == Http::ParseStatus::Complete && m_Head.status >= 200) {
				m_Raw = Core::String(m_Raw.View().Substring(parse.length, m_Raw.ByteLength() - parse.length));
				m_Framing = Http::ResponseFraming(m_Head.headers, m_Head.status, m_Method.View());
				m_HeadIn = true;
				return BodyRead::Bytes;
			}
			if (parse.status == Http::ParseStatus::Complete) {
				m_Raw = Core::String(m_Raw.View().Substring(parse.length, m_Raw.ByteLength() - parse.length));
				continue;
			}
			if (parse.status != Http::ParseStatus::Incomplete) {
				m_Error = parse.error;
				return BodyRead::Failed;
			}
			const BodyRead got = Receive(waitMs);
			if (got == BodyRead::Ended) {
				m_Error = Core::String("the connection ended before the answer's head");
				return BodyRead::Failed;
			}
			if (got != BodyRead::Bytes) return got;
		}
	}

	BodyRead HttpExchange::Decode(Core::String& out) {
		if (m_Framing.kind == Http::BodyKind::Chunked) {
			Core::Array<uint8> body;
			const Http::ChunkedStep step = m_Chunks.Feed(m_Raw.View(), c_HttpMostBodyBytes, body);
			m_Raw = Core::String(m_Raw.View().Substring(step.consumed, m_Raw.ByteLength() - step.consumed));
			out.Append(Core::StringView((const char*)body.Data(), body.Count()));
			if (step.status == Http::ParseStatus::Complete) return BodyRead::Ended;
			if (step.status != Http::ParseStatus::Incomplete) {
				m_Error = step.error;
				return BodyRead::Failed;
			}
			return body.Count() > 0 ? BodyRead::Bytes : BodyRead::Waiting;
		}
		const int64 had = m_Raw.ByteLength();
		out.Append(m_Raw.View());
		m_BodyRead += had;
		m_Raw = Core::String();
		if (m_Framing.kind == Http::BodyKind::Length && m_BodyRead >= m_Framing.length) return BodyRead::Ended;
		if (m_Framing.kind == Http::BodyKind::None) return BodyRead::Ended;
		return had > 0 ? BodyRead::Bytes : BodyRead::Waiting;
	}

	BodyRead HttpExchange::Read(Core::String& out, int32 waitMs) {
		if (!m_HeadIn) {
			m_Error = Core::String("the answer's head is not in");
			return BodyRead::Failed;
		}
		if (!m_Raw.IsEmpty()) {
			const BodyRead decoded = Decode(out);
			if (decoded != BodyRead::Waiting) return decoded;
		}
		const BodyRead got = Receive(waitMs);
		if (got == BodyRead::Ended) {
			const BodyRead last = Decode(out);
			if (m_Framing.kind == Http::BodyKind::Chunked && last != BodyRead::Ended) {
				m_Error = Core::String("the connection ended inside a chunked body");
				return BodyRead::Failed;
			}
			return BodyRead::Ended;
		}
		if (got != BodyRead::Bytes) return got;
		return Decode(out);
	}

	Core::String HttpExchange::Header(Core::StringView name) const {
		const Core::String* value = m_Head.headers.Find(name);
		return value ? *value : Core::String();
	}

	void EventReader::Feed(Core::StringView bytes) { m_Pending.Append(bytes); }

	bool EventReader::Next(Core::String& done) {
		for (;;) {
			const int64 end = m_Pending.View().IndexOf('\n', 0);
			if (end < 0) return false;
			Core::StringView line = m_Pending.View().Substring(0, end);
			if (line.EndsWith(Core::StringView("\r"))) line = line.Substring(0, line.ByteLength() - 1);
			const Core::String kept = Core::String(line);
			m_Pending = Core::String(m_Pending.View().Substring(end + 1, m_Pending.ByteLength() - end - 1));
			if (Line(kept.View(), done)) return true;
		}
	}

	// One line: true when it ends an event that had data.
	bool EventReader::Line(Core::StringView line, Core::String& done) {
		if (line.IsEmpty()) {
			if (!m_HasData) return false;
			done = m_Data;
			m_Data = Core::String();
			m_HasData = false;
			return true;
		}
		if (!line.StartsWith(Core::StringView("data:"))) return false;
		Core::StringView value = line.Substring(5, line.ByteLength() - 5);
		if (value.StartsWith(Core::StringView(" "))) value = value.Substring(1, value.ByteLength() - 1);
		if (m_HasData) m_Data.Append("\n");
		m_Data.Append(value);
		m_HasData = true;
		return false;
	}

	bool EventReader::Flush(Core::String& done) {
		if (!m_Pending.IsEmpty()) {
			const Core::String last = m_Pending;
			m_Pending = Core::String();
			if (Line(last.View(), done)) return true;
		}
		return Line(Core::StringView(""), done);
	}
}
