// The ied.mcp plugin's entry (runtime.entry "Mcp::Activate", docs/04 "MCP"): one McpService behind the mcp.* bindings
// (the chat's mcp.ensure; the tool function's mcp.call, mcp.result and mcp.cancel), the mcp.* protocol methods (Settings >
// AI > MCP Servers) and the AI tool function every MCP tool runs.

include "servers.ch"

namespace Mcp
{
	const int64 kResultPollMs = 250;

	static void Register(IED::PluginContext& context, const char* name, IED::MethodHandler handler) {
		Core::String problem;
		if (!context.Method(Core::StringView(name), handler, problem)) context.Log(problem.View());
	}

	static IED::Result Answered(Core::StringView json, Core::StringView error) { return error.IsEmpty() ? IED::Answer(json) : IED::Refusal(error); }

	static void RegisterMethods(IED::PluginContext& context, McpService* service) {
		Register(context, "mcp.status", [service](const IED::Request& request) -> Core::String { return service->StatusJson(request.params.Str("wsId").View()); });
		Register(context, "mcp.test", [service](const IED::Request& request) -> Core::String {
			Serialization::DomNode server = request.params.Field("server");
			Core::String entry = server.IsValid() ? IED::NodeJson(server) : Core::String();
			return service->Test(request.params.Str("wsId").View(), request.params.Str("name").View(), entry.View());
		});
		Register(context, "mcp.restart", [service](const IED::Request& request) -> Core::String { return service->Restart(request.params.Str("wsId").View(), request.params.Str("name").View()); });
		Register(context, "mcp.stop", [service](const IED::Request& request) -> Core::String { return service->StopServer(request.params.Str("wsId").View(), request.params.Str("name").View()); });
		Register(context, "mcp.resources", [service](const IED::Request& request) -> Core::String { return service->ResourcesJson(request.params.Str("wsId").View()); });
	}

	static void ProvideBindings(IED::PluginContext& context, McpService* service) {
		context.Provide(Core::StringView("mcp.ensure"), [service](const Serialization::DomNode& args) -> IED::Result { return IED::Answer(service->Ensure(args.Member("wsId").AsView()).View()); });
		context.Provide(Core::StringView("mcp.status"), [service](const Serialization::DomNode& args) -> IED::Result { return IED::Answer(service->StatusJson(args.Member("wsId").AsView()).View()); });
		context.Provide(Core::StringView("mcp.readResource"), [service](const Serialization::DomNode& args) -> IED::Result {
			Core::String error;
			Core::String text = service->ReadResource(args.Member("wsId").AsView(), args.Member("server").AsView(), args.Member("uri").AsView(), error);
			if (!error.IsEmpty()) return IED::Refusal(error.View());
			IED::JsonWriter json;
			json.BeginObject();
			json.Field("text", text.View());
			json.EndObject();
			return IED::Answer(json.View());
		});
		context.Provide(Core::StringView("mcp.tool"), [service](const Serialization::DomNode& args) -> IED::Result {
			Core::String error;
			Core::String json = service->DescribeTool(args.Member("wsId").AsView(), args.Member("tool").AsView(), error);
			return Answered(json.View(), error.View());
		});
		context.Provide(Core::StringView("mcp.call"), [service](const Serialization::DomNode& args) -> IED::Result {
			Core::String error;
			Core::String json = service->StartCall(args, error);
			return Answered(json.View(), error.View());
		});
		context.Provide(Core::StringView("mcp.result"), [service](const Serialization::DomNode& args) -> IED::Result {
			Core::String error;
			const int64 waitMs = args.Member("waitMs").IsValid() ? args.Member("waitMs").AsInt() : kResultPollMs;
			Core::String json = service->CallResult(args.Member("callId").AsView(), waitMs < 0 ? 0 : (waitMs > 5000 ? 5000 : waitMs), error);
			return Answered(json.View(), error.View());
		});
		context.Provide(Core::StringView("mcp.cancel"), [service](const Serialization::DomNode& args) -> IED::Result {
			service->CancelCall(args.Member("callId").AsView());
			return IED::Answer(Core::StringView("{}"));
		});
	}

	void Activate(IED::PluginContext& context) {
		McpService* service = new McpService(&context);
		service->Start();
		RegisterMethods(context, service);
		ProvideBindings(context, service);
		context.OnWorkspace([service](const IED::Workspace& ws) { service->Opened(ws); });
		context.OnTrustChanged([service](const IED::Workspace& ws) { service->Opened(ws); });
		context.Listen(Core::StringView("settings.changed"), [service](const IED::Event& event) {
			Core::StringView topic = event.topic.View();
			service->SettingsChanged(topic == "settings:app" ? Core::StringView("") : topic.Substring(9, topic.ByteLength() - 9));
		});
		context.OnDeactivate([service]() { service->Shutdown(); });
	}

	static Core::String CallArgs(const IED::ToolCall& call) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("wsId", call.workspace.id.View());
		json.Field("tool", call.name.View());
		json.Field("chatId", call.chatId.View());
		json.RawField("arguments", IED::NodeJson(call.args).View());
		json.EndObject();
		return json.ToString();
	}

	static Core::String CallIdArgs(Core::StringView callId, int64 waitMs) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("callId", callId);
		if (waitMs >= 0) json.IntField("waitMs", waitMs);
		json.EndObject();
		return json.ToString();
	}

	static IED::ToolResult ResultOf(const Serialization::DomNode& answer) {
		IED::ToolResult result = IED::ToolText(answer.Member("content").AsView());
		result.isError = answer.Member("isError").AsBool();
		result.reportsFailure = answer.Member("reportsFailure").AsBool();
		result.source = Core::String(answer.Member("source").AsView());
		Serialization::DomNode images = answer.Member("images");
		for (int64 i = 0; i < images.Count(); ++i) {
			IED::ToolImage image;
			image.mime = Core::String(images.At(i).Member("mime").AsView());
			image.path = Core::String(images.At(i).Member("path").AsView());
			result.images.Push(image);
		}
		return result;
	}

	// Every MCP tool's function (its toolCalls entry, ownThread): the call started through the plugin's own binding, then
	// its result waited for a quarter second at a time, the chat's Stop cancelling it at the server.
	IED::ToolResult CallTool(const IED::ToolCall& call) {
		IED::Result started = IED::CallBinding(Core::StringView("mcp.call"), CallArgs(call).View());
		if (!started.Ok()) return IED::ToolFailure(started.error.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode begun = Serialization::ReadJson(started.json.View(), *doc).root;
		Core::String callId = Core::String(begun.Member("callId").AsView());
		const int64 deadline = clock_now_ns() / 1000000 + begun.Member("waitMs").AsInt();
		bool cancelled = false;
		for (;;) {
			const bool late = clock_now_ns() / 1000000 > deadline;
			if ((call.Cancelled() || late) && !cancelled) {
				cancelled = true;
				IED::CallBinding(Core::StringView("mcp.cancel"), CallIdArgs(callId.View(), -1).View());
			}
			if (late && clock_now_ns() / 1000000 > deadline + 5000) return IED::ToolFailure(Core::StringView("the MCP call did not end by itself: it was cancelled"));
			IED::Result polled = IED::CallBinding(Core::StringView("mcp.result"), CallIdArgs(callId.View(), kResultPollMs).View());
			if (!polled.Ok()) return IED::ToolFailure(polled.error.View());
			Serialization::DomDoc* read = new Serialization::DomDoc();
			Serialization::DomNode answer = Serialization::ReadJson(polled.json.View(), *read).root;
			if (answer.Member("done").AsBool()) return ResultOf(answer);
		}
	}

	// What an MCP call that asks the owner will do, for its approval card: the server and its tool's own name.
	IED::ToolPlan PlanTool(const IED::ToolCall& call) {
		IED::ToolPlan plan;
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("wsId", call.workspace.id.View());
		args.Field("tool", call.name.View());
		args.EndObject();
		IED::Result described = IED::CallBinding(Core::StringView("mcp.tool"), args.View());
		if (!described.Ok()) {
			plan.error = described.error;
			return plan;
		}
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode tool = Serialization::ReadJson(described.json.View(), *doc).root;
		Core::StringBuilder summary;
		summary.Append("Call ");
		summary.Append(tool.Member("tool").AsView());
		if (!tool.Member("title").AsView().IsEmpty()) {
			summary.Append(" (");
			summary.Append(tool.Member("title").AsView());
			summary.Append(")");
		}
		summary.Append(" on the MCP server ");
		summary.Append(tool.Member("server").AsView());
		plan.summary = summary.ToString();
		return plan;
	}
}
