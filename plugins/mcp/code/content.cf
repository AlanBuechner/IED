include "content.ch"

namespace Mcp
{
	static ContentPart* Part(PartKind kind) {
		ContentPart* part = new ContentPart();
		part->kind = kind;
		return part;
	}

	static ContentPart* TextPart(Core::StringView text) {
		ContentPart* part = Part(PartKind::Text);
		part->text = Core::String(text);
		return part;
	}

	// An embedded resource: its text, or its blob as a file.
	static ContentPart* ResourcePart(const Serialization::DomNode& resource) {
		Core::StringView uri = resource.Member("uri").AsView();
		if (resource.Member("text").IsValid()) {
			Core::StringBuilder out;
			out.Append("[resource ");
			out.Append(uri);
			out.Append("]\n");
			out.Append(resource.Member("text").AsView());
			return TextPart(out.View());
		}
		ContentPart* part = Part(PartKind::File);
		part->text = (Core::String("resource ") + uri);
		part->mime = Core::String(resource.Member("mimeType").AsView().IsEmpty() ? Core::StringView("application/octet-stream") : resource.Member("mimeType").AsView());
		part->data = Core::String(resource.Member("blob").AsView());
		return part;
	}

	static ContentPart* BlockPart(const Serialization::DomNode& block) {
		Core::StringView type = block.Member("type").AsView();
		if (type == "text") return TextPart(block.Member("text").AsView());
		if (type == "image" || type == "audio") {
			ContentPart* part = Part(type == "image" && ShownImage(block.Member("mimeType").AsView()) ? PartKind::Image : PartKind::File);
			part->text = Core::String(type);
			part->mime = Core::String(block.Member("mimeType").AsView());
			part->data = Core::String(block.Member("data").AsView());
			return part;
		}
		if (type == "resource") return ResourcePart(block.Member("resource"));
		if (type == "resource_link") {
			ContentPart* part = Part(PartKind::Link);
			part->text = Core::String(block.Member("uri").AsView());
			Core::StringBuilder name;
			name.Append(block.Member("name").AsView());
			if (!block.Member("description").AsView().IsEmpty()) {
				name.Append(": ");
				name.Append(block.Member("description").AsView());
			}
			part->name = name.ToString();
			part->mime = Core::String(block.Member("mimeType").AsView());
			return part;
		}
		return TextPart(((Core::String("[content of a kind IED does not read: ") + IED::NodeJson(block).View()) + "]").View());
	}

	CallContent ReadCallResult(const Serialization::DomNode& result) {
		CallContent content;
		content.isError = result.Member("isError").AsBool();
		Serialization::DomNode blocks = result.Member("content");
		for (int64 i = 0; blocks.Kind() == Serialization::DomKind::Array && i < blocks.Count(); ++i) content.parts.Push(BlockPart(blocks.At(i)));
		if (content.parts.IsEmpty() && result.Member("structuredContent").IsValid()) content.parts.Push(TextPart(IED::NodeJson(result.Member("structuredContent")).View()));
		return content;
	}

	Core::String CallText(const CallContent& content, const Core::Array<Core::String>& paths) {
		Core::StringBuilder out;
		for (int64 i = 0; i < content.parts.Count(); ++i) {
			ContentPart* part = content.parts[i];
			if (part->kind == PartKind::Image) continue;
			if (out.ByteLength() > 0) out.Append("\n");
			if (part->kind == PartKind::Text) out.Append(part->text.View());
			else if (part->kind == PartKind::Link) {
				out.Append("[resource link ");
				out.Append(part->text.View());
				if (!part->name.IsEmpty()) {
					out.Append(" - ");
					out.Append(part->name.View());
				}
				out.Append("]");
			}
			else {
				const bool saved = i < paths.Count() && !paths[i].IsEmpty();
				out.Append("[");
				out.Append(part->text.View());
				if (saved) {
					out.Append(" saved as ");
					out.Append(paths[i].View());
				}
				out.Append(" (");
				out.Append(part->mime.View());
				out.Append(saved ? ")]" : ") could not be saved]");
			}
		}
		if (out.ByteLength() <= kResultMostBytes) return out.ToString();
		Core::StringView whole = out.View();
		int64 end = kResultMostBytes;
		while (end > 0 && (whole.ByteAt(end) & 0xC0) == 0x80) end -= 1;
		Core::StringBuilder cut;
		cut.Append(whole.Substring(0, end));
		cut.Append("\n[the server's answer was ");
		cut.AppendInt(whole.ByteLength());
		cut.Append(" bytes; the rest is left out]");
		return cut.ToString();
	}

	const char* ExtensionOf(Core::StringView mime) {
		if (mime == "image/png") return "png";
		if (mime == "image/jpeg" || mime == "image/jpg") return "jpg";
		if (mime == "image/gif") return "gif";
		if (mime == "image/webp") return "webp";
		if (mime == "audio/wav" || mime == "audio/x-wav") return "wav";
		if (mime == "audio/mpeg") return "mp3";
		if (mime == "audio/ogg") return "ogg";
		if (mime == "application/json") return "json";
		if (mime.StartsWith(Core::StringView("text/"))) return "txt";
		return "bin";
	}

	bool ShownImage(Core::StringView mime) { return mime == "image/png" || mime == "image/jpeg" || mime == "image/gif" || mime == "image/webp"; }
}
