include "Servers.ch"

namespace Mcp
{
	static int64 ServiceNowMs() { return clock_now_ns() / 1000000; }

	const char* ServerStateName(ServerState state) {
		if (state == ServerState::Starting) return "starting";
		if (state == ServerState::Running) return "running";
		if (state == ServerState::Failed) return "failed";
		return "stopped";
	}

	int64 RestartDelayMs(int64 exits) {
		int64 delay = 1000;
		for (int64 i = 1; i < exits && delay < c_MostRestartDelayMs; ++i) delay *= 2;
		return delay < c_MostRestartDelayMs ? delay : c_MostRestartDelayMs;
	}

	static bool NameTaken(const Core::Array<McpTool*>& tools, Core::StringView aiName) {
		for (McpTool* tool : tools)
			if (tool->m_AiName.View() == aiName) return true;
		return false;
	}

	// `base` made unique among `tools`: "_2", "_3" added, the base cut so the name stays within kToolNameMostBytes.
	static Core::String UniqueName(const Core::Array<McpTool*>& tools, Core::StringView base) {
		if (!NameTaken(tools, base)) return Core::String(base);
		for (int64 n = 2;; ++n) {
			Core::StringBuilder suffix;
			suffix.Append("_");
			suffix.AppendInt(n);
			Core::StringView kept = base.ByteLength() + suffix.ByteLength() > c_ToolNameMostBytes ? base.Substring(0, c_ToolNameMostBytes - suffix.ByteLength()) : base;
			Core::String name = Core::String(kept) + suffix.View();
			if (!NameTaken(tools, name.View())) return name;
		}
	}

	const char*[36] c_SchemaKeywords = { "$schema", "$id", "$defs", "$comment", "title", "description", "default", "examples",
		"deprecated", "readOnly", "writeOnly", "format", "markdownDescription", "enumDescriptions", "type", "enum", "const",
		"pattern", "minLength", "maxLength", "minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "required",
		"properties", "additionalProperties", "items", "minItems", "maxItems", "uniqueItems", "oneOf", "anyOf", "allOf", "not",
		"$ref" };

	static bool KnownKeyword(Core::StringView key) {
		if (key.StartsWith(Core::StringView("x-"))) return true;
		for (int64 i = 0; i < 36; ++i)
			if (key == c_SchemaKeywords[i]) return true;
		return false;
	}

	// `schema` as JSON with the keywords Bedrock's validator does not know left out (propertyNames, patternProperties,
	// multipleOf, if/then/else, a list of items, ...), at every depth; each one left out named in `dropped`.
	static void WriteLoadable(IED::JsonWriter& json, const Serialization::DomNode& schema, Core::Array<Core::String>& dropped) {
		if (schema.Kind() != Serialization::DomKind::Object) {
			json.Raw(IED::NodeJson(schema).View());
			return;
		}
		json.BeginObject();
		for (int64 i = 0; i < schema.Count(); ++i) {
			Core::StringView key = schema.KeyAt(i);
			Serialization::DomNode value = schema.ValueAt(i);
			const bool named = key == "properties" || key == "$defs";
			const bool single = key == "items" || key == "additionalProperties" || key == "not";
			const bool list = key == "oneOf" || key == "anyOf" || key == "allOf";
			if (!KnownKeyword(key) || (key == "items" && value.Kind() == Serialization::DomKind::Array)) {
				if (!dropped.Contains(Core::String(key))) dropped.Push(Core::String(key));
				continue;
			}
			json.Key(key);
			if (named && value.Kind() == Serialization::DomKind::Object) {
				json.BeginObject();
				for (int64 j = 0; j < value.Count(); ++j) {
					json.Key(value.KeyAt(j));
					WriteLoadable(json, value.ValueAt(j), dropped);
				}
				json.EndObject();
			}
			else if (single) WriteLoadable(json, value, dropped);
			else if (list && value.Kind() == Serialization::DomKind::Array) {
				json.BeginArray();
				for (int64 j = 0; j < value.Count(); ++j) WriteLoadable(json, value.At(j), dropped);
				json.EndArray();
			}
			else json.Raw(IED::NodeJson(value).View());
		}
		json.EndObject();
	}

	// A schema the chat's validator can load and a model takes for a function's parameters: the server's, less the
	// keywords the validator does not know (said in `note`); `{"type":"object"}` with `note` when even that does not load.
	Core::String UsableSchema(const Serialization::DomNode& schema, Core::String& note) {
		if (schema.Kind() != Serialization::DomKind::Object) {
			if (schema.IsValid()) note = Core::String("its inputSchema is not an object");
			return Core::String("{\"type\":\"object\"}");
		}
		Core::Array<Core::String> dropped;
		IED::JsonWriter json;
		WriteLoadable(json, schema, dropped);
		Core::String text = json.ToString();
		Serialization::SchemaRegistry* registry = new Serialization::SchemaRegistry();
		Core::String error;
		if (!registry->Add(Core::StringView("tool"), text.View(), error)) {
			note = Core::String("its inputSchema does not load (") + error.View() + "), so the model is shown no parameters and its arguments are not checked";
			return Core::String("{\"type\":\"object\"}");
		}
		if (!dropped.IsEmpty()) {
			Core::StringBuilder said;
			said.Append("its inputSchema's ");
			for (int64 i = 0; i < dropped.Count(); ++i) {
				if (i > 0) said.Append(", ");
				said.Append(dropped[i].View());
			}
			said.Append(" are left out: IED's schema validator does not know them");
			note = said.ToString();
		}
		return text;
	}

	Core::Array<McpTool*> ReadToolsPage(Core::StringView server, const Serialization::DomNode& result, Core::String& cursor) {
		Core::Array<McpTool*> found;
		Serialization::DomNode tools = result.Member("tools");
		for (int64 i = 0; tools.Kind() == Serialization::DomKind::Array && i < tools.Count(); ++i) {
			Serialization::DomNode given = tools.At(i);
			Core::StringView name = given.Member("name").AsView();
			if (name.IsEmpty()) continue;
			McpTool* tool = new McpTool();
			tool->m_Name = Core::String(name);
			tool->m_AiName = ToolName(server, name);
			tool->m_Title = Core::String(given.Member("title").AsView().IsEmpty() ? given.Member("annotations").Member("title").AsView() : given.Member("title").AsView());
			tool->m_Description = Core::String(given.Member("description").AsView().Trimmed());
			Core::String note;
			tool->m_Schema = UsableSchema(given.Member("inputSchema"), note);
			tool->m_Note = note;
			tool->m_ReadOnlyHint = given.Member("annotations").Member("readOnlyHint").AsBool();
			found.Push(tool);
		}
		cursor = Core::String(result.Member("nextCursor").AsView());
		return found;
	}

	// --- Workspaces and their configurations -------------------------------------------------------------------------

	WorkspaceServers* McpService::Find(Core::StringView wsId) {
		for (WorkspaceServers* place : m_Places)
			if (place->m_Ws.m_Id.View() == wsId) return place;
		return nullptr;
	}

	Core::Array<ServerConfig*> McpService::Configs(WorkspaceServers* place, Core::Array<Core::String>& problems) {
		Core::String wsId = place->m_Ws.m_Id;
		Core::Array<ServerConfig*> configs = ReadServers(m_Context->Setting(Core::StringView("mcp.servers"), wsId.View()).View(), problems);
		for (const IED::Contribution& given : IED::Contributions(wsId.View(), Core::StringView("mcpServers"))) {
			Core::String error;
			if (!IED::WhenHolds(place->m_Ws, given.m_Entry.Member("when").AsView(), error)) continue;
			Core::StringView id = given.m_Entry.Member("id").AsView();
			bool named = false;
			for (ServerConfig* config : configs) named = named || config->m_Name.View() == id;
			if (named) continue;
			Core::String problem;
			ServerConfig* config = ReadContributedServer(given.m_Entry, given.m_PluginId.View(), given.m_Folder.View(), problem);
			if (config) configs.Push(config);
			else problems.Push(((Core::String("plugin ") + given.m_PluginId.View() + ": the MCP server ") + id + ": ") + problem.View());
		}
		return configs;
	}

	static int64 IdleMs(IED::PluginContext* context, Core::StringView wsId) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode value = Serialization::ReadJson(context->Setting(Core::StringView("mcp.idleMinutes"), wsId).View(), *doc).root;
		const int64 minutes = value.IsValid() ? value.AsInt() : 10;
		return minutes > 0 ? minutes * 60000 : 0;
	}

	void McpService::Reread(WorkspaceServers* place) {
		Core::Array<Core::String> problems;
		Core::Array<ServerConfig*> configs = Configs(place, problems);
		const int64 idle = IdleMs(m_Context, place->m_Ws.m_Id.View());
		Core::Array<ServerEntry*> halted;
		{
			Threading::LockGuard guard(m_Lock);
			place->m_Problems = problems;
			place->m_IdleMs = idle;
			Core::Array<ServerEntry*> next;
			for (ServerConfig* config : configs) {
				ServerEntry* entry = nullptr;
				for (ServerEntry* each : place->m_Servers)
					if (each->m_Config->m_Name == config->m_Name) entry = each;
				if (!entry) {
					entry = new ServerEntry();
					entry->m_State = ServerState::Stopped;
				}
				else if (entry->m_Config->m_Hash != config->m_Hash || (!config->m_Enabled && entry->m_State != ServerState::Stopped)) {
					halted.Push(entry);
					if (entry->m_Config->m_Hash != config->m_Hash) {
						entry->m_Tools.Clear();
						entry->m_Resources.Clear();
						entry->m_ToolsKnown = false;
					}
				}
				entry->m_Config = config;
				if (!entry->m_ToolsKnown) LoadCached(place, entry);
				next.Push(entry);
			}
			for (ServerEntry* old : place->m_Servers)
				if (!next.Contains(old)) halted.Push(old);
			place->m_Servers = next;
		}
		for (ServerEntry* entry : halted) Halt(place, entry, Core::StringView("its configuration changed"), false);
	}

	void McpService::Opened(const IED::Workspace& ws) {
		WorkspaceServers* place = nullptr;
		bool first = false;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(ws.m_Id.View());
			if (!place) {
				place = new WorkspaceServers();
				m_Places.Push(place);
				first = true;
			}
			place->m_Ws = ws;
		}
		if (first) ReadCacheFile(place);
		Reread(place);
		if (!ws.m_Trusted) {
			Core::Array<ServerEntry*> all;
			{
				Threading::LockGuard guard(m_Lock);
				all = place->m_Servers;
			}
			for (ServerEntry* entry : all) Halt(place, entry, Core::StringView("the workspace is not trusted"), true);
		}
		Changed(place);
	}

	void McpService::SettingsChanged(Core::StringView wsId) {
		Core::Array<WorkspaceServers*> affected;
		{
			Threading::LockGuard guard(m_Lock);
			for (WorkspaceServers* place : m_Places)
				if (wsId.IsEmpty() || place->m_Ws.m_Id.View() == wsId) affected.Push(place);
		}
		for (WorkspaceServers* place : affected) {
			Reread(place);
			Changed(place);
		}
	}

	// --- Starting and stopping ---------------------------------------------------------------------------------------

	// `entry` marked as starting, with its new generation; false when it is starting or running already, or may not
	// start. Under `lock`.
	bool McpService::Begin(WorkspaceServers* place, ServerEntry* entry, int64& generation) {
		if (m_Stopping || !place->m_Ws.m_Trusted || !entry->m_Config->m_Enabled) return false;
		if (entry->m_State == ServerState::Starting || entry->m_State == ServerState::Running) return false;
		entry->m_State = ServerState::Starting;
		entry->m_Generation += 1;
		generation = entry->m_Generation;
		entry->m_StartByMs = ServiceNowMs() + entry->m_Config->m_StartSeconds * 1000 + 2000;
		entry->m_RestartAtMs = 0;
		entry->m_Error = Core::String();
		m_Changed.NotifyAll();
		return true;
	}

	// The start of an entry Begin marked: connected and its tools listed, or failed with why.
	void McpService::Launch(WorkspaceServers* place, ServerEntry* entry, int64 generation) {
		Changed(place);
		McpClient* client = nullptr;
		Core::Array<McpTool*> tools;
		Core::Array<McpResource*> resources;
		Core::String error;
		bool ok = Connect(place, entry->m_Config, generation, client, tools, resources, new StartLog(), error);
		bool stale = false;
		Core::String line;
		{
			Threading::LockGuard guard(m_Lock);
			stale = entry->m_Generation != generation;
			if (!stale && ok && !client->Alive()) {
				ok = false;
				error = Core::String("it exited right after it started");
			}
			if (!stale && ok) {
				entry->m_Client = client;
				entry->m_State = ServerState::Running;
				entry->m_Tools = tools;
				entry->m_Resources = resources;
				entry->m_ToolsKnown = true;
				entry->m_ToolsHash = entry->m_Config->m_Hash;
				entry->m_ServerName = client->m_ServerName;
				entry->m_ServerVersion = client->m_ServerVersion;
				entry->m_ProtocolVersion = client->m_ProtocolVersion;
				entry->m_Instructions = client->m_Instructions;
				entry->m_StartedMs = ServiceNowMs();
				entry->m_LastUsedMs = entry->m_StartedMs;
				Core::StringBuilder said;
				said.Append("running: ");
				said.Append(client->m_ServerName.IsEmpty() ? Core::StringView("a server") : client->m_ServerName.View());
				if (!client->m_ServerVersion.IsEmpty()) {
					said.Append(" ");
					said.Append(client->m_ServerVersion.View());
				}
				said.Append(", MCP ");
				said.Append(client->m_ProtocolVersion.View());
				said.Append(", ");
				said.AppendInt(tools.Count());
				said.Append(tools.Count() == 1 ? " tool" : " tools");
				if (client->Pid() != 0) {
					said.Append(", pid ");
					said.AppendInt(client->Pid());
				}
				line = said.ToString();
			}
			else if (!stale) {
				const bool restarting = entry->m_QuickExits > 0;
				if (restarting) entry->m_QuickExits += 1;
				entry->m_Error = error;
				if (restarting && entry->m_QuickExits < c_MostQuickExits) {
					entry->m_State = ServerState::Stopped;
					entry->m_RestartAtMs = ServiceNowMs() + RestartDelayMs(entry->m_QuickExits);
				}
				else entry->m_State = ServerState::Failed;
				line = Core::String("did not start: ") + error.View();
			}
			m_Changed.NotifyAll();
		}
		if (stale) {
			if (client) client->Close();
			return;
		}
		Note(place, entry, line.View(), entry->m_Config->m_Name.View());
		Changed(place);
	}

	// The values of `env` or `headers`, each read from IED's environment when it says {env}; false with `error` for a
	// variable IED's environment does not have.
	static bool Resolved(const Core::Array<ConfigValue>& values, const char* separator, Core::Array<Core::String>& out, Core::String& error) {
		for (const ConfigValue& value : values) {
			Core::String text = value.m_Text;
			if (!value.m_FromEnv.IsEmpty() && !Platform::TryGetEnvironmentVariable(value.m_FromEnv.CStr(), text)) {
				error = ((Core::String(value.m_Name) + " takes %") + value.m_FromEnv.View() + "%, which IED's environment does not have");
				return false;
			}
			out.Push((value.m_Name + separator) + text.View());
		}
		return true;
	}

	static bool IsAbsolute(Core::StringView path) {
		return path.StartsWith(Core::StringView("/")) || path.StartsWith(Core::StringView("\\")) || (path.ByteLength() > 1 && path.ByteAt(1) == ':');
	}

	// What a connection to `config` starts or reaches, in workspace `ws`; false with `error`.
	static bool LaunchOf(const ServerConfig* config, const IED::Workspace& ws, ServerLaunch& launch, Core::String& error) {
		if (config->IsHttp()) {
			launch.m_Url = config->m_Url;
			return Resolved(config->m_Headers, ": ", launch.m_Headers, error);
		}
		launch.m_Cwd = config->m_Cwd.IsEmpty() ? ws.m_Root : IsAbsolute(config->m_Cwd.View()) ? config->m_Cwd : Core::String((FS::Path(ws.m_Root.View()) / config->m_Cwd.View()).View());
		if (!FS::IsDirectory(launch.m_Cwd.CStr())) {
			error = Core::String("its folder (cwd) is not there: ") + launch.m_Cwd.View();
			return false;
		}
		if (!Resolved(config->m_Env, "=", launch.m_Environment, error)) return false;
		Core::StringView command = config->m_Command.View();
		const bool placed = command.IndexOf('/', 0) >= 0 || command.IndexOf('\\', 0) >= 0;
		Core::String asked = placed && !IsAbsolute(command) ? Core::String((FS::Path(ws.m_Root.View()) / command).View()) : Core::String(command);
		Core::String program = FindProgram(asked.View(), Platform::GetEnvironmentVariable("PATH").View());
		if (program.IsEmpty()) {
			error = placed ? Core::String("there is no program ") + asked.View() : (Core::String("there is no program ") + command) + " on PATH (nor .exe, .cmd or .bat of it)";
			return false;
		}
		if (!IsBatchFile(program.View())) {
			launch.m_Program = program;
			launch.m_Arguments = config->m_Args;
			return true;
		}
		Core::Array<Core::String> argv;
		argv.Push(program);
		for (const Core::String& arg : config->m_Args) argv.Push(arg);
		return BatchLine(argv, launch.m_ShellLine, error);
	}

	void StartLog::Add(Core::StringView line) {
		Threading::LockGuard guard(m_Mutex);
		m_Lines.Push(Core::String(line));
		if (m_Lines.Count() > c_LogLinesKept) m_Lines.RemoveAt(0);
	}

	Core::String StartLog::Tail(int64 count) {
		Threading::LockGuard guard(m_Mutex);
		Core::StringBuilder out;
		int64 from = m_Lines.Count() - count;
		for (int64 i = from < 0 ? 0 : from; i < m_Lines.Count(); ++i) {
			if (out.ByteLength() > 0) out.Append(" | ");
			out.Append(m_Lines[i].View());
		}
		return out.ToString();
	}

	Core::Array<McpResource*> ReadResourcesPage(const Serialization::DomNode& result, Core::String& cursor) {
		Core::Array<McpResource*> found;
		Serialization::DomNode listed = result.Member("resources");
		for (int64 i = 0; listed.Kind() == Serialization::DomKind::Array && i < listed.Count(); ++i) {
			Serialization::DomNode given = listed.At(i);
			if (given.Member("uri").AsView().IsEmpty()) continue;
			McpResource* resource = new McpResource();
			resource->m_Uri = Core::String(given.Member("uri").AsView());
			resource->m_Name = Core::String(given.Member("name").AsView().IsEmpty() ? given.Member("uri").AsView() : given.Member("name").AsView());
			resource->m_Title = Core::String(given.Member("title").AsView());
			resource->m_Description = Core::String(given.Member("description").AsView());
			resource->m_MimeType = Core::String(given.Member("mimeType").AsView());
			found.Push(resource);
		}
		cursor = Core::String(result.Member("nextCursor").AsView());
		return found;
	}

	// Every page of a server's resources/list; false with `error`.
	static bool ListResources(McpClient* client, const ServerConfig* config, Core::Array<McpResource*>& resources, Core::String& error) {
		Core::String cursor;
		for (int64 page = 0; page < c_ListPagesMost; ++page) {
			IED::JsonWriter params;
			params.BeginObject();
			if (!cursor.IsEmpty()) params.Field("cursor", cursor.View());
			params.EndObject();
			Serialization::DomNode result = client->Call(Core::StringView("resources/list"), params.View(), (int32)(config->m_StartSeconds * 1000), nullptr, error);
			if (!result.IsValid()) {
				error = Core::String("resources/list: ") + error.View();
				return false;
			}
			for (McpResource* resource : ReadResourcesPage(result, cursor)) resources.Push(resource);
			if (cursor.IsEmpty()) return true;
		}
		return true;
	}

	// Every page of a server's tools/list, the excluded ones left out, each named uniquely; false with `error`.
	static bool ListTools(McpClient* client, const ServerConfig* config, Core::Array<McpTool*>& tools, Core::String& error) {
		Core::String cursor;
		for (int64 page = 0; page < c_ListPagesMost; ++page) {
			IED::JsonWriter params;
			params.BeginObject();
			if (!cursor.IsEmpty()) params.Field("cursor", cursor.View());
			params.EndObject();
			Serialization::DomNode result = client->Call(Core::StringView("tools/list"), params.View(), (int32)(config->m_StartSeconds * 1000), nullptr, error);
			if (!result.IsValid()) {
				error = Core::String("tools/list: ") + error.View();
				return false;
			}
			for (McpTool* tool : ReadToolsPage(config->m_Name.View(), result, cursor))
				if (!config->Excludes(tool->m_Name.View())) {
					tool->m_AiName = UniqueName(tools, tool->m_AiName.View());
					tools.Push(tool);
				}
			if (cursor.IsEmpty()) return true;
		}
		return true;
	}

	bool McpService::Connect(WorkspaceServers* place, ServerConfig* config, int64 generation, McpClient*& client, Core::Array<McpTool*>& tools, Core::Array<McpResource*>& resources, StartLog* printed, Core::String& error) {
		ServerLaunch launch;
		IED::Workspace ws;
		{
			Threading::LockGuard guard(m_Lock);
			ws = place->m_Ws;
		}
		Core::String name = config->m_Name;
		ServerEntry* entry = generation > 0 ? FindEntry(place, name.View(), generation) : nullptr;
		Note(place, entry, (Core::String("starting: ") + Display(config).View()).View(), name.View());
		if (!LaunchOf(config, ws, launch, error)) return false;
		McpService* self = this;
		Core::String wsId = ws.m_Id;
		client = new McpClient();
		LogHandler logged = [self, wsId, name, generation, printed](Core::StringView line) {
			printed->Add(line);
			self->ServerLog(wsId.View(), name.View(), generation, line);
		};
		NotifyHandler notified = [self, wsId, name, generation](Message* message) { self->Notified(wsId.View(), name.View(), generation, message); };
		EndHandler ended = [self, wsId, name, generation](int64 exitCode) { self->Ended(wsId.View(), name.View(), generation, exitCode); };
		if (!client->Open(launch, logged, notified, ended, error)) return false;
		if (!client->Initialize((int32)(config->m_StartSeconds * 1000), nullptr, error)) {
			Threading::Thread::Sleep(100000000);
			if (client->ExitCode() >= 0) {
				Core::StringBuilder exited;
				exited.Append(error.View());
				exited.Append(" (it exited with code ");
				exited.AppendInt(client->ExitCode());
				exited.Append(")");
				error = exited.ToString();
			}
			if (error.View().Contains(Core::StringView("did not answer within"))) error = (error + " (mcp.servers.") + name.View() + ".startSeconds)";
			Core::String tail = printed->Tail(3);
			if (!tail.IsEmpty()) error = (error + "; it printed: ") + tail.View();
			client->Close();
			return false;
		}
		if (!ListTools(client, config, tools, error)) {
			client->Close();
			return false;
		}
		for (McpTool* tool : tools)
			if (!tool->m_Note.IsEmpty()) Note(place, entry, ((tool->m_Name + ": ") + tool->m_Note.View()).View(), name.View());
		Core::String listing;
		if (client->m_HasResources && !ListResources(client, config, resources, listing)) Note(place, entry, (Core::String("its resources are not listed: ") + listing.View()).View(), name.View());
		return true;
	}

	void McpService::Halt(WorkspaceServers* place, ServerEntry* entry, Core::StringView why, bool keepFailed) {
		McpClient* client = nullptr;
		bool was = false;
		{
			Threading::LockGuard guard(m_Lock);
			was = entry->m_State == ServerState::Running || entry->m_State == ServerState::Starting;
			client = entry->m_Client;
			entry->m_Client = nullptr;
			entry->m_Generation += 1;
			entry->m_RestartAtMs = 0;
			entry->m_QuickExits = 0;
			if (entry->m_State != ServerState::Failed || !keepFailed) entry->m_State = ServerState::Stopped;
			m_Changed.NotifyAll();
		}
		if (client) client->Close();
		if (was) Note(place, entry, (Core::String("stopped: ") + why).View(), entry->m_Config->m_Name.View());
	}

	void McpService::Ended(Core::StringView wsId, Core::StringView name, int64 generation, int64 exitCode) {
		WorkspaceServers* place = nullptr;
		ServerEntry* entry = nullptr;
		Core::String line;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			entry = place ? FindEntryLocked(place, name, generation) : nullptr;
			if (!entry || entry->m_State != ServerState::Running) return;
			const int64 now = ServiceNowMs();
			entry->m_QuickExits = now - entry->m_StartedMs < c_QuickExitMs ? entry->m_QuickExits + 1 : 1;
			entry->m_Restarts += 1;
			entry->m_Client = nullptr;
			entry->m_Generation += 1;
			Core::StringBuilder said;
			said.Append("exited with code ");
			said.AppendInt(exitCode);
			Core::String tail = TailLocked(entry, 3);
			if (!tail.IsEmpty()) {
				said.Append("; it printed: ");
				said.Append(tail.View());
			}
			entry->m_Error = said.ToString();
			if (entry->m_QuickExits >= c_MostQuickExits) {
				entry->m_State = ServerState::Failed;
				entry->m_Error = entry->m_Error + "; it exited 5 times in a row, each within a minute of its start, so it is not started again until you Restart it in Settings > AI > MCP Servers";
				line = entry->m_Error;
			}
			else {
				entry->m_State = ServerState::Stopped;
				entry->m_RestartAtMs = now + RestartDelayMs(entry->m_QuickExits);
				Core::StringBuilder restart;
				restart.Append(entry->m_Error.View());
				restart.Append("; starting it again in ");
				restart.AppendInt(RestartDelayMs(entry->m_QuickExits) / 1000);
				restart.Append(" s");
				line = restart.ToString();
			}
			m_Changed.NotifyAll();
		}
		Note(place, entry, line.View(), name);
		Changed(place);
	}

	void McpService::Notified(Core::StringView wsId, Core::StringView name, int64 generation, Message* message) {
		if (message->m_Method == "notifications/tools/list_changed") {
			McpService* self = this;
			Core::String ws = Core::String(wsId);
			Core::String server = Core::String(name);
			m_Context->StartThread([self, ws, server, generation]() { self->Relist(ws.View(), server.View(), generation); });
			return;
		}
		if (message->m_Method == "notifications/resources/list_changed") {
			McpService* self = this;
			Core::String ws = Core::String(wsId);
			Core::String server = Core::String(name);
			m_Context->StartThread([self, ws, server, generation]() { self->RelistResources(ws.View(), server.View(), generation); });
			return;
		}
		if (message->m_Method == "notifications/message") {
			Serialization::DomNode data = message->m_Params.Member("data");
			Core::String text = data.Kind() == Serialization::DomKind::String ? Core::String(data.AsView()) : IED::NodeJson(data);
			ServerLog(wsId, name, generation, ((Core::String(message->m_Params.Member("level").AsView()) + ": ") + text.View()).View());
		}
	}

	void McpService::Relist(Core::StringView wsId, Core::StringView name, int64 generation) {
		WorkspaceServers* place = nullptr;
		McpClient* client = nullptr;
		ServerConfig* config = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			ServerEntry* entry = place ? FindEntryLocked(place, name, generation) : nullptr;
			if (!entry || entry->m_State != ServerState::Running) return;
			client = entry->m_Client;
			config = entry->m_Config;
		}
		Core::Array<McpTool*> tools;
		Core::String error;
		if (!ListTools(client, config, tools, error)) {
			Note(place, nullptr, (Core::String("its tools changed, but ") + error.View()).View(), name);
			return;
		}
		ServerEntry* entry = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			entry = FindEntryLocked(place, name, generation);
			if (!entry) return;
			entry->m_Tools = tools;
		}
		Core::StringBuilder said;
		said.Append("its tools changed: ");
		said.AppendInt(tools.Count());
		said.Append(tools.Count() == 1 ? " tool; a chat's next turn has them" : " tools; a chat's next turn has them");
		Note(place, entry, said.View(), name);
		Changed(place);
	}

	void McpService::RelistResources(Core::StringView wsId, Core::StringView name, int64 generation) {
		WorkspaceServers* place = nullptr;
		McpClient* client = nullptr;
		ServerConfig* config = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			ServerEntry* entry = place ? FindEntryLocked(place, name, generation) : nullptr;
			if (!entry || entry->m_State != ServerState::Running) return;
			client = entry->m_Client;
			config = entry->m_Config;
		}
		Core::Array<McpResource*> resources;
		Core::String error;
		if (!ListResources(client, config, resources, error)) {
			Note(place, nullptr, (Core::String("its resources changed, but ") + error.View()).View(), name);
			return;
		}
		{
			Threading::LockGuard guard(m_Lock);
			ServerEntry* entry = FindEntryLocked(place, name, generation);
			if (!entry) return;
			entry->m_Resources = resources;
		}
		Changed(place);
	}

	// --- Lookups (under `lock` where they say) -----------------------------------------------------------------------

	ServerEntry* McpService::FindEntryLocked(WorkspaceServers* place, Core::StringView name, int64 generation) {
		for (ServerEntry* entry : place->m_Servers)
			if (entry->m_Config->m_Name.View() == name && (generation == c_AnyGeneration || entry->m_Generation == generation)) return entry;
		return nullptr;
	}

	ServerEntry* McpService::FindEntry(WorkspaceServers* place, Core::StringView name, int64 generation) {
		Threading::LockGuard guard(m_Lock);
		return FindEntryLocked(place, name, generation);
	}

	Core::String McpService::TailLocked(ServerEntry* entry, int64 lines) {
		Core::Array<Core::String> kept;
		for (int64 i = entry->m_Log.Count() - 1; i >= 0 && kept.Count() < lines; --i)
			if (!entry->m_Log[i].View().StartsWith(Core::StringView("[IED]"))) kept.Insert(0, entry->m_Log[i]);
		Core::StringBuilder out;
		for (const Core::String& line : kept) {
			if (out.ByteLength() > 0) out.Append(" | ");
			out.Append(line.View());
		}
		return out.ToString();
	}

	// --- The output --------------------------------------------------------------------------------------------------

	static void Keep(ServerEntry* entry, Core::StringView line) {
		entry->m_Log.Push(Core::String(line));
		if (entry->m_Log.Count() > c_LogLinesKept) entry->m_Log.RemoveAt(0);
	}

	void McpService::ServerLog(Core::StringView wsId, Core::StringView name, int64 generation, Core::StringView line) {
		{
			Threading::LockGuard guard(m_Lock);
			WorkspaceServers* place = Find(wsId);
			ServerEntry* entry = place ? FindEntryLocked(place, name, generation) : nullptr;
			if (entry) Keep(entry, line);
		}
		Output(wsId, ((Core::String("[") + name) + "] " + line).View());
	}

	void McpService::Note(WorkspaceServers* place, ServerEntry* entry, Core::StringView line, Core::StringView name) {
		Core::String wsId;
		{
			Threading::LockGuard guard(m_Lock);
			wsId = place->m_Ws.m_Id;
			if (entry) Keep(entry, (Core::String("[IED] ") + line).View());
		}
		Output(wsId.View(), ((Core::String("[") + name) + "] " + line).View());
	}

	void McpService::Output(Core::StringView wsId, Core::StringView line) {
		Platform::CalendarTime now = Platform::LocalCalendar(Platform::UnixTimeNs());
		Core::StringBuilder text;
		text.AppendIntBase(now.hour, 10, 2);
		text.Append(":");
		text.AppendIntBase(now.minute, 10, 2);
		text.Append(":");
		text.AppendIntBase(now.second, 10, 2);
		text.Append(" ");
		text.Append(line);
		text.Append("\r\n");
		m_Context->Output(wsId, Core::StringView("mcp"), text.View());
	}

	// --- The watcher -------------------------------------------------------------------------------------------------

	void McpService::Start() {
		McpService* self = this;
		m_Context->StartThread([self]() { self->Watch(); });
	}

	void McpService::Watch() {
		for (;;) {
			Core::Array<WorkspaceServers*> idlePlaces;
			Core::Array<ServerEntry*> idle;
			Core::Array<WorkspaceServers*> duePlaces;
			Core::Array<ServerEntry*> due;
			Core::Array<int64> generations;
			{
				Threading::LockGuard guard(m_Lock);
				if (m_Stopping) return;
				m_Changed.WaitFor(m_Lock, c_WatchTickMs * 1000000);
				if (m_Stopping) return;
				const int64 now = ServiceNowMs();
				for (WorkspaceServers* place : m_Places)
					for (ServerEntry* entry : place->m_Servers) {
						if (entry->m_State == ServerState::Running && entry->m_Calls == 0 && place->m_IdleMs > 0 && now - entry->m_LastUsedMs > place->m_IdleMs) {
							idlePlaces.Push(place);
							idle.Push(entry);
						}
						int64 generation = 0;
						if (entry->m_State == ServerState::Stopped && entry->m_RestartAtMs > 0 && now >= entry->m_RestartAtMs) {
							if (Begin(place, entry, generation)) {
								duePlaces.Push(place);
								due.Push(entry);
								generations.Push(generation);
							}
							else entry->m_RestartAtMs = 0;
						}
					}
			}
			for (int64 i = 0; i < idle.Count(); ++i) {
				Halt(idlePlaces[i], idle[i], Core::StringView("no call used it for mcp.idleMinutes; its tools stay offered and the next call starts it"), true);
				Changed(idlePlaces[i]);
			}
			for (int64 i = 0; i < due.Count(); ++i) {
				McpService* self = this;
				WorkspaceServers* place = duePlaces[i];
				ServerEntry* entry = due[i];
				const int64 generation = generations[i];
				m_Context->StartThread([self, place, entry, generation]() { self->Launch(place, entry, generation); });
			}
		}
	}

	void McpService::Shutdown() {
		Core::Array<WorkspaceServers*> owners;
		Core::Array<ServerEntry*> all;
		{
			Threading::LockGuard guard(m_Lock);
			m_Stopping = true;
			m_Changed.NotifyAll();
			for (WorkspaceServers* place : m_Places)
				for (ServerEntry* entry : place->m_Servers) {
					owners.Push(place);
					all.Push(entry);
				}
		}
		for (int64 i = 0; i < all.Count(); ++i) Halt(owners[i], all[i], Core::StringView("IED stops"), true);
	}

	// --- What a turn and Settings ask --------------------------------------------------------------------------------

	Core::String McpService::Ensure(Core::StringView wsId) {
		Core::Array<ServerEntry*> starting;
		Core::Array<int64> generations;
		WorkspaceServers* place = nullptr;
		int64 waitMs = 0;
		IED::JsonWriter json;
		json.BeginObject();
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			const int64 now = ServiceNowMs();
			json.Key(Core::StringView("servers"));
			json.BeginArray();
			for (int64 i = 0; place && place->m_Ws.m_Trusted && i < place->m_Servers.Count(); ++i) {
				ServerEntry* entry = place->m_Servers[i];
				if (!entry->m_Config->m_Enabled || entry->m_ToolsKnown) continue;
				int64 generation = 0;
				if (entry->m_State == ServerState::Stopped && Begin(place, entry, generation)) {
					starting.Push(entry);
					generations.Push(generation);
				}
				if (entry->m_State == ServerState::Starting) {
					const int64 left = entry->m_StartByMs - now;
					if (left > waitMs) waitMs = left;
				}
				json.BeginObject();
				json.Field("name", entry->m_Config->m_Name.View());
				json.Field("state", ServerStateName(entry->m_State));
				json.EndObject();
			}
			json.EndArray();
		}
		json.IntField("waitMs", waitMs < c_EnsureMostWaitMs ? waitMs : c_EnsureMostWaitMs);
		json.EndObject();
		for (int64 i = 0; i < starting.Count(); ++i) {
			McpService* self = this;
			ServerEntry* entry = starting[i];
			const int64 generation = generations[i];
			m_Context->StartThread([self, place, entry, generation]() { self->Launch(place, entry, generation); });
		}
		return json.ToString();
	}

	static Core::String Refused(Core::StringView why) {
		IED::JsonWriter json;
		json.BeginObject();
		json.BoolField("ok", false);
		json.Field("error", why);
		json.EndObject();
		return json.ToString();
	}

	// What a test came to, from a connection that started (or `error`).
	static Core::String TestJson(bool ok, int64 ms, McpClient* client, const Core::Array<McpTool*>& tools, Core::StringView error, Core::StringView log) {
		IED::JsonWriter json;
		json.BeginObject();
		json.BoolField("ok", ok);
		json.IntField("ms", ms);
		if (ok && client) {
			json.Field("serverName", client->m_ServerName.View());
			json.Field("serverVersion", client->m_ServerVersion.View());
			json.Field("protocolVersion", client->m_ProtocolVersion.View());
			json.Field("instructions", client->m_Instructions.View());
		}
		json.Key(Core::StringView("tools"));
		json.BeginArray();
		for (McpTool* tool : tools) {
			json.BeginObject();
			json.Field("name", tool->m_Name.View());
			json.Field("aiName", tool->m_AiName.View());
			json.Field("description", tool->m_Description.View());
			json.EndObject();
		}
		json.EndArray();
		if (!error.IsEmpty()) json.Field("error", error);
		json.Field("log", log);
		json.EndObject();
		return json.ToString();
	}

	Core::String McpService::Test(Core::StringView wsId, Core::StringView name, Core::StringView entryJson) {
		WorkspaceServers* place = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
		}
		if (!place) return Refused(Core::StringView("no such workspace"));
		if (!place->m_Ws.m_Trusted) return Refused(Core::StringView("the workspace is not trusted: MCP servers start only in a trusted workspace (trust it first)"));
		const int64 started = ServiceNowMs();
		if (!entryJson.IsEmpty()) {
			Serialization::DomDoc* doc = new Serialization::DomDoc();
			Core::String problem;
			ServerConfig* config = ReadServer(name.IsEmpty() ? Core::StringView("test") : name, Serialization::ReadJson(entryJson, *doc).root, problem);
			if (!config) return Refused(problem.View());
			McpClient* client = nullptr;
			Core::Array<McpTool*> tools;
			Core::Array<McpResource*> resources;
			Core::String error;
			StartLog* printed = new StartLog();
			const bool ok = Connect(place, config, c_TestGeneration, client, tools, resources, printed, error);
			Core::String json = TestJson(ok, ServiceNowMs() - started, client, tools, error.View(), printed->Tail(8).View());
			if (ok) client->Close();
			return json;
		}
		Restart(wsId, name);
		Threading::LockGuard guard(m_Lock);
		ServerEntry* entry = FindEntryLocked(place, name, c_AnyGeneration);
		if (!entry) return Refused((Core::String("there is no MCP server ") + name + " in this workspace").View());
		return TestJson(entry->m_State == ServerState::Running, ServiceNowMs() - started, entry->m_Client, entry->m_Tools, entry->m_Error.View(), TailLocked(entry, 8).View());
	}

	Core::String McpService::Restart(Core::StringView wsId, Core::StringView name) {
		WorkspaceServers* place = nullptr;
		ServerEntry* entry = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			entry = place ? FindEntryLocked(place, name, c_AnyGeneration) : nullptr;
		}
		if (!entry) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("there is no MCP server ") + name + " in this workspace").View());
		Halt(place, entry, Core::StringView("restarted from Settings"), false);
		int64 generation = 0;
		bool begun = false;
		{
			Threading::LockGuard guard(m_Lock);
			entry->m_QuickExits = 0;
			begun = Begin(place, entry, generation);
			if (!begun && !place->m_Ws.m_Trusted) entry->m_Error = Core::String("the workspace is not trusted");
			else if (!begun && !entry->m_Config->m_Enabled) entry->m_Error = Core::String("it is turned off (enabled: false)");
		}
		if (begun) Launch(place, entry, generation);
		else Changed(place);
		return StatusJson(wsId);
	}

	Core::String McpService::StopServer(Core::StringView wsId, Core::StringView name) {
		WorkspaceServers* place = nullptr;
		ServerEntry* entry = nullptr;
		{
			Threading::LockGuard guard(m_Lock);
			place = Find(wsId);
			entry = place ? FindEntryLocked(place, name, c_AnyGeneration) : nullptr;
		}
		if (!entry) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("there is no MCP server ") + name + " in this workspace").View());
		Halt(place, entry, Core::StringView("stopped from Settings"), false);
		Changed(place);
		return StatusJson(wsId);
	}
}
