include "ServerConfig.ch"

namespace Mcp
{
	bool ServerConfig::Preloads(Core::StringView tool) const {
		if (m_PreloadAll) return true;
		for (const Core::String& name : m_Preload)
			if (name.View() == tool) return true;
		return false;
	}

	bool ServerConfig::Excludes(Core::StringView tool) const {
		for (const Core::String& name : m_Exclude)
			if (name.View() == tool) return true;
		return false;
	}

	bool ValidServerName(Core::StringView name) {
		if (name.IsEmpty() || name.ByteLength() > 32) return false;
		for (int64 i = 0; i < name.ByteLength(); ++i) {
			const int32 c = name.ByteAt(i);
			const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
			if (!ok) return false;
		}
		return true;
	}

	static Core::String Lowered(Core::StringView text) {
		Core::StringBuilder out;
		bool underscore = false;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			int32 c = text.ByteAt(i);
			if (c >= 'A' && c <= 'Z') c += 32;
			const bool kept = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
			if (kept) {
				out.AppendByte(c);
				underscore = false;
			}
			else if (!underscore) {
				out.AppendByte('_');
				underscore = true;
			}
		}
		return out.ToString();
	}

	Core::String ToolGroup(Core::StringView server) { return Core::String("mcp_") + Lowered(server).View(); }

	Core::String ToolName(Core::StringView server, Core::StringView tool) {
		Core::String name = (ToolGroup(server) + "_") + Lowered(tool).View();
		Core::StringView view = name.View();
		while (view.EndsWith(Core::StringView("_")) && view.ByteLength() > 1) view = view.Substring(0, view.ByteLength() - 1);
		if (view.ByteLength() > c_ToolNameMostBytes) view = view.Substring(0, c_ToolNameMostBytes);
		return Core::String(view);
	}

	const char* PermissionName(Permission permission) {
		if (permission == Permission::Auto) return "auto";
		if (permission == Permission::Read) return "read";
		return "ask";
	}

	Core::String DefaultPrivacy(Core::StringView url) {
		if (url.IsEmpty()) return Core::String("local");
		const Http::Url parsed = Http::ParseUrl(url.StartsWith(Core::StringView("https://")) ? (Core::String("http://") + url.Substring(8, url.ByteLength() - 8)).View() : url);
		Core::StringView host = parsed.host.View();
		const bool loopback = host == "localhost" || host == "::1" || host.StartsWith(Core::StringView("127."));
		return Core::String(loopback ? "local" : "cloud");
	}

	static Core::Array<Core::String> Strings(const Serialization::DomNode& list) {
		Core::Array<Core::String> out;
		for (int64 i = 0; list.Kind() == Serialization::DomKind::Array && i < list.Count(); ++i) out.Push(Core::String(list.At(i).AsView()));
		return out;
	}

	// The members of an env or headers object; false with `problem` for a value that is neither text nor {env}.
	static bool Values(const Serialization::DomNode& object, Core::Array<ConfigValue>& values, Core::String& problem) {
		if (!object.IsValid()) return true;
		if (object.Kind() != Serialization::DomKind::Object) {
			problem = Core::String("must be an object of names and values");
			return false;
		}
		for (int64 i = 0; i < object.Count(); ++i) {
			ConfigValue value;
			value.m_Name = Core::String(object.KeyAt(i));
			Serialization::DomNode given = object.ValueAt(i);
			if (given.Kind() == Serialization::DomKind::String) value.m_Text = Core::String(given.AsView());
			else if (given.Kind() == Serialization::DomKind::Object && !given.Member("env").AsView().IsEmpty()) value.m_FromEnv = Core::String(given.Member("env").AsView());
			else {
				problem = (Core::String("the value of ") + value.m_Name.View()) + " must be text or {\"env\": \"NAME\"}";
				return false;
			}
			values.Push(value);
		}
		return true;
	}

	static int64 Seconds(const Serialization::DomNode& node, int64 fallback, int64 most) {
		if (!node.IsValid()) return fallback;
		const int64 value = node.AsInt();
		if (value < 1) return 1;
		return value > most ? most : value;
	}

	// What a start uses - the command or URL and what goes with it - so a change of permission, preload or privacy keeps
	// the server running and its tools known.
	static Core::String HashOf(Core::StringView name, const Serialization::DomNode& entry) {
		Core::StringBuilder text;
		text.Append(name);
		const char*[6] keys = { "command", "args", "env", "cwd", "url", "headers" };
		for (int64 i = 0; i < 6; ++i) {
			text.Append("\n");
			text.Append(keys[i]);
			text.Append("=");
			if (entry.Member(keys[i]).IsValid()) text.Append(IED::NodeJson(entry.Member(keys[i])).View());
		}
		return Crypto::Sha256((const void*)text.View().Data(), text.ByteLength()).ToHex();
	}

	ServerConfig* ReadServer(Core::StringView name, const Serialization::DomNode& entry, Core::String& problem) {
		if (!ValidServerName(name)) {
			problem = Core::String("a name is 1 to 32 letters, digits, '_' and '-'");
			return nullptr;
		}
		if (entry.Kind() != Serialization::DomKind::Object) {
			problem = Core::String("must be an object: {command, args?} or {url}");
			return nullptr;
		}
		ServerConfig* config = new ServerConfig();
		config->m_Name = Core::String(name);
		config->m_Source = Core::String("settings");
		config->m_Command = Core::String(entry.Member("command").AsView().Trimmed());
		config->m_Args = Strings(entry.Member("args"));
		config->m_Cwd = Core::String(entry.Member("cwd").AsView());
		config->m_Url = Core::String(entry.Member("url").AsView().Trimmed());
		if (config->m_Command.IsEmpty() == config->m_Url.IsEmpty()) {
			problem = Core::String("give a command (a program IED starts) or a url (a running server), not both");
			return nullptr;
		}
		if (!Values(entry.Member("env"), config->m_Env, problem)) {
			problem = Core::String("env ") + problem.View();
			return nullptr;
		}
		if (!Values(entry.Member("headers"), config->m_Headers, problem)) {
			problem = Core::String("headers ") + problem.View();
			return nullptr;
		}
		config->m_Enabled = !entry.Member("enabled").IsValid() || entry.Member("enabled").AsBool();
		Core::StringView permission = entry.Member("permission").AsView();
		if (permission.IsEmpty() || permission == "ask") config->m_Permission = Permission::Ask;
		else if (permission == "auto") config->m_Permission = Permission::Auto;
		else if (permission == "read") config->m_Permission = Permission::Read;
		else {
			problem = Core::String("permission must be ask, auto or read");
			return nullptr;
		}
		Serialization::DomNode preload = entry.Member("preload");
		config->m_PreloadAll = preload.Kind() == Serialization::DomKind::Bool && preload.AsBool();
		config->m_Preload = Strings(preload);
		Core::StringView privacy = entry.Member("privacy").AsView();
		config->m_Privacy = privacy.IsEmpty() ? DefaultPrivacy(config->m_Url.View()) : Core::String(privacy);
		if (config->m_Privacy != "local" && config->m_Privacy != "lan" && config->m_Privacy != "cloud") {
			problem = Core::String("privacy must be local, lan or cloud");
			return nullptr;
		}
		config->m_TimeoutSeconds = Seconds(entry.Member("timeoutSeconds"), c_DefaultTimeoutSeconds, c_MostTimeoutSeconds);
		config->m_StartSeconds = Seconds(entry.Member("startSeconds"), c_DefaultStartSeconds, c_MostStartSeconds);
		config->m_Exclude = Strings(entry.Member("exclude"));
		config->m_Hash = HashOf(name, entry);
		return config;
	}

	Core::Array<ServerConfig*> ReadServers(Core::StringView json, Core::Array<Core::String>& problems) {
		Core::Array<ServerConfig*> servers;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode root = Serialization::ReadJson(json, *doc).root;
		for (int64 i = 0; root.Kind() == Serialization::DomKind::Object && i < root.Count(); ++i) {
			Core::String problem;
			ServerConfig* config = ReadServer(root.KeyAt(i), root.ValueAt(i), problem);
			if (config) servers.Push(config);
			else problems.Push(((Core::String("mcp.servers.") + root.KeyAt(i)) + ": ") + problem.View());
		}
		return servers;
	}

	static Core::String WithFolder(Core::StringView text, Core::StringView folder) {
		Core::StringBuilder out;
		Core::StringView rest = text;
		const Core::StringView mark = Core::StringView("${pluginFolder}");
		for (;;) {
			const int64 at = rest.IndexOf(mark);
			if (at < 0) break;
			out.Append(rest.Substring(0, at));
			out.Append(folder);
			rest = rest.Substring(at + mark.ByteLength(), rest.ByteLength() - at - mark.ByteLength());
		}
		out.Append(rest);
		return out.ToString();
	}

	static Core::String Slashes(Core::StringView path) {
		Core::StringBuilder out;
		for (int64 i = 0; i < path.ByteLength(); ++i) out.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return out.ToString();
	}

	ServerConfig* ReadContributedServer(const Serialization::DomNode& entry, Core::StringView pluginId, Core::StringView folder, Core::String& problem) {
		Core::String slashes = Slashes(folder);
		IED::JsonWriter json;
		json.BeginObject();
		if (!entry.Member("command").AsView().IsEmpty()) json.Field("command", WithFolder(entry.Member("command").AsView(), slashes.View()).View());
		if (!entry.Member("url").AsView().IsEmpty()) json.Field("url", entry.Member("url").AsView());
		Serialization::DomNode args = entry.Member("args");
		if (args.IsValid()) {
			json.Key(Core::StringView("args"));
			json.BeginArray();
			for (int64 i = 0; i < args.Count(); ++i) json.String(WithFolder(args.At(i).AsView(), slashes.View()).View());
			json.EndArray();
		}
		if (entry.Member("env").IsValid()) json.RawField("env", IED::NodeJson(entry.Member("env")).View());
		if (!entry.Member("cwd").AsView().IsEmpty()) json.Field("cwd", WithFolder(entry.Member("cwd").AsView(), slashes.View()).View());
		if (!entry.Member("privacyClass").AsView().IsEmpty()) json.Field("privacy", entry.Member("privacyClass").AsView());
		if (!entry.Member("permission").AsView().IsEmpty()) json.Field("permission", entry.Member("permission").AsView());
		if (entry.Member("preload").IsValid()) json.BoolField("preload", entry.Member("preload").AsBool());
		json.EndObject();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		ServerConfig* config = ReadServer(entry.Member("id").AsView(), Serialization::ReadJson(json.View(), *doc).root, problem);
		if (config) config->m_Source = Core::String("plugin ") + pluginId;
		return config;
	}

	Core::String Display(const ServerConfig* config) {
		if (config->IsHttp()) return config->m_Url;
		Core::StringBuilder out;
		out.Append(config->m_Command.View());
		for (const Core::String& arg : config->m_Args) {
			out.AppendByte(' ');
			const bool quote = arg.IsEmpty() || arg.View().IndexOf(' ', 0) >= 0;
			if (quote) out.AppendByte('"');
			out.Append(arg.View());
			if (quote) out.AppendByte('"');
		}
		return out.ToString();
	}
}
