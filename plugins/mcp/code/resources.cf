// Resources (docs/04 "MCP" Resources): what the workspace's servers list with resources/list, for the composer's @ list,
// and one read with resources/read when a turn that mentions it starts (the chat's mention kind "mcp").

include "servers.ch"

namespace Mcp
{
	const int64 kResourceReadMostMs = 25000;   // within a binding's 30 s

	static int64 ResourcesNowMs() { return clock_now_ns() / 1000000; }

	Core::String McpService::ResourcesJson(Core::StringView wsId) {
		Ensure(wsId);
		Threading::LockGuard guard(lock);
		WorkspaceServers* place = Find(wsId);
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("resources"));
		json.BeginArray();
		for (int64 i = 0; place && place->ws.trusted && i < place->servers.Count(); ++i) {
			ServerEntry* entry = place->servers[i];
			if (!entry->config->enabled) continue;
			for (McpResource* resource : entry->resources) {
				json.BeginObject();
				json.Field("server", entry->config->name.View());
				json.Field("uri", resource->uri.View());
				json.Field("name", resource->name.View());
				if (!resource->title.IsEmpty()) json.Field("title", resource->title.View());
				if (!resource->description.IsEmpty()) json.Field("description", resource->description.View());
				if (!resource->mimeType.IsEmpty()) json.Field("mimeType", resource->mimeType.View());
				json.EndObject();
			}
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	Core::String McpService::ReadResource(Core::StringView wsId, Core::StringView server, Core::StringView uri, Core::String& error) {
		WorkspaceServers* place = nullptr;
		ServerEntry* entry = nullptr;
		{
			Threading::LockGuard guard(lock);
			place = Find(wsId);
			entry = place ? FindEntryLocked(place, server, kAnyGeneration) : nullptr;
			if (!entry) error = (Core::String("there is no MCP server ") + server) + " in this workspace";
			else if (!place->ws.trusted) error = Core::String("the workspace is not trusted: MCP servers start only in a trusted workspace");
			else if (!entry->config->enabled) error = (Core::String("the MCP server ") + server) + " is turned off";
		}
		if (!error.IsEmpty()) return Core::String();
		bool cancelled = false;
		if (!AwaitRunning(place, entry, &cancelled, error)) {
			error = ((Core::String("the MCP server ") + server) + " is not running: ") + error.View();
			return Core::String();
		}
		McpClient* client = nullptr;
		int64 waitMs = 0;
		IED::Workspace ws;
		{
			Threading::LockGuard guard(lock);
			client = entry->client;
			waitMs = entry->config->timeoutSeconds * 1000;
			ws = place->ws;
		}
		IED::JsonWriter params;
		params.BeginObject();
		params.Field("uri", uri);
		params.EndObject();
		Serialization::DomNode answer = client ? client->Call(Core::StringView("resources/read"), params.View(), (int32)(waitMs < kResourceReadMostMs ? waitMs : kResourceReadMostMs), &cancelled, error) : Serialization::DomNode();
		{
			Threading::LockGuard guard(lock);
			entry->calls -= 1;
			entry->lastUsedMs = ResourcesNowMs();
		}
		if (!answer.IsValid()) {
			error = ((Core::String(server) + ": resources/read ") + uri + " failed: ") + (client ? error.View() : Core::StringView("it stopped"));
			return Core::String();
		}
		CallContent content = ReadResourceResult(answer);
		Core::Array<Core::String> paths;
		for (ContentPart* part : content.parts) paths.Push(part->kind == PartKind::File ? SaveMedia(ws, server, part) : Core::String());
		Core::String text = CallText(content, paths);
		return text.IsEmpty() ? Core::String("(the resource is empty)") : text;
	}
}
