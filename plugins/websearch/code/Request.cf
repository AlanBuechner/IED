// A search's arguments checked and completed from the settings (docs/29 "web_search"): every error says what to give
// instead.

include "Searx.ch"

namespace WebSearch
{
	const int64 c_QueryBytes = 400;
	const int64 c_MostResults = 20;
	const int64 c_MostPages = 10;

	static Serialization::DomNode SettingOf(IED::PluginContext* context, const char* key) {
		Core::String json = context->Setting(Core::StringView(key), Core::StringView(""));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json.View(), *doc).root;
	}

	static Core::String Listed(const Core::Array<Core::String>& names) {
		Core::StringBuilder text;
		for (int64 i = 0; i < names.Count(); ++i) {
			if (i > 0) text.Append(", ");
			text.Append(names[i].View());
		}
		return text.ToString();
	}

	static bool Contains(const Core::Array<Core::String>& names, Core::StringView name) {
		for (const Core::String& known : names)
			if (known.View() == name) return true;
		return false;
	}

	static bool ReadEngines(const Serialization::DomNode& asked, const Core::Array<Core::String>& configured, SearchRequest& request, Core::String& error) {
		Core::Array<Core::String> wanted = EngineNames(asked);
		if (wanted.IsEmpty()) {
			request.m_Engines = configured;
			return true;
		}
		Core::Array<Core::String> missing;
		for (const Core::String& name : wanted) {
			if (Contains(configured, name.View())) request.m_Engines.Push(name);
			else missing.Push(name);
		}
		if (missing.IsEmpty()) return true;
		error = ((Core::String("no engine ") + Listed(missing).View()) + " here; the engines are " + Listed(configured).View()) + " (the owner adds more in Settings > Web > Search)";
		return false;
	}

	bool SearxService::Prepare(const Serialization::DomNode& args, SearchRequest& request, Core::String& error) {
		request.m_Query = Core::String(args.Member("query").AsView().Trimmed());
		if (request.m_Query.IsEmpty()) {
			error = Core::String("give the words to search for: query");
			return false;
		}
		if (request.m_Query.ByteLength() > c_QueryBytes) {
			error = Core::String("the query is too long: at most 400 bytes; search for the few words that matter");
			return false;
		}
		Core::Array<Core::String> unknown;
		if (!ReadEngines(args.Member("engines"), Engines(unknown), request, error)) return false;
		Serialization::DomNode count = args.Member("count");
		const int64 wanted = count.IsValid() && !count.IsNull() ? count.AsInt() : SettingOf(m_Context, "websearch.results").AsInt();
		request.m_Count = (int32)(wanted < 1 ? 8 : wanted > c_MostResults ? c_MostResults : wanted);
		Serialization::DomNode page = args.Member("page");
		const int64 pageNumber = page.IsValid() && !page.IsNull() ? page.AsInt() : 1;
		if (pageNumber < 1 || pageNumber > c_MostPages) {
			error = Core::String("page is 1 to 10");
			return false;
		}
		request.m_Page = (int32)pageNumber;
		request.m_TimeRange = Core::String(args.Member("time_range").AsView());
		const Core::StringView range = request.m_TimeRange.View();
		if (!range.IsEmpty() && range != "day" && range != "week" && range != "month" && range != "year") {
			error = Core::String("time_range is day, week, month or year (or none)");
			return false;
		}
		Core::StringView language = args.Member("language").AsView();
		request.m_Language = Core::String(language.IsEmpty() ? SettingOf(m_Context, "websearch.language").AsView() : language);
		request.m_SafeSearch = SafeSearchLevel(SettingOf(m_Context, "websearch.safeSearch").AsView());
		Serialization::DomNode wait = args.Member("wait");
		const int64 seconds = wait.IsValid() && !wait.IsNull() ? wait.AsInt() : c_StartWaitSeconds;
		request.m_StartWaitNs = (seconds < 0 ? 0 : seconds > c_LongestStartWaitSeconds ? c_LongestStartWaitSeconds : seconds) * 1000000000;
		return true;
	}
}
