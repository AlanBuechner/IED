// websearch: the settings.yml SearXNG starts with, the search URL, SearXNG's JSON answer and what the model reads of it.

include "config.ch"
include "results.ch"

static Core::Array<Core::String> Names(const char* a, const char* b, const char* c) {
	Core::Array<Core::String> names;
	if (a) names.Push(Core::String(a));
	if (b) names.Push(Core::String(b));
	if (c) names.Push(Core::String(c));
	return names;
}

// A SearXNG answer as /search?format=json gives it (trimmed).
const char* kSearxAnswer = "{\"query\": \"rust borrow\", \"number_of_results\": 0, \"results\": ["
	"{\"url\": \"https://doc.rust-lang.org/book/ch04-02.html\", \"title\": \"References and\\n Borrowing\", \"content\": \"A reference is   like a pointer.\", \"engine\": \"brave\", \"engines\": [\"brave\", \"bing\"], \"publishedDate\": \"2024-05-01T00:00:00\"},"
	"{\"url\": \"https://stackoverflow.com/q/1\", \"title\": \"Why?\", \"content\": \"\", \"engine\": \"stackoverflow\", \"engines\": [], \"publishedDate\": null},"
	"{\"title\": \"no url\"}],"
	"\"answers\": [{\"answer\": \"42\", \"url\": null}, \"plain\"], \"corrections\": [], \"infoboxes\": [], \"suggestions\": [\"rust borrow checker\"],"
	"\"unresponsive_engines\": [[\"google\", \"access denied\"], [\"duckduckgo\", \"Suspended: CAPTCHA\"], [\"wikipedia\", \"timeout\"]]}";

[test("server.websearch.config")]
class WebSearchConfigTests {
	[test("settings.yml without Tor")]
	public static void TestDirect() {
		WebSearch::SearxConfig config;
		config.engines = Names("brave", "google news", null);
		config.safeSearch = 1;
		config.timeoutSeconds = 8;
		Core::String yaml = WebSearch::SettingsYaml(config);
		Serialization::DomDoc doc;
		Serialization::ReadResult read = Serialization::ReadYaml(yaml.View(), doc);
		assert_true(read.Ok(), yaml.CStr());
		Serialization::DomNode keep = read.root.Member("use_default_settings").Member("engines").Member("keep_only");
		assert_eq((int64)2, keep.Count(), "keep_only");
		assert_true(keep.At(1).AsView() == "google news", "a name with a space");
		assert_eq((int64)1, read.root.Member("search").Member("safe_search").AsInt(), "safe_search");
		assert_eq((int64)2, read.root.Member("search").Member("formats").Count(), "html and json");
		assert_true(read.root.Member("search").Member("formats").At(1).AsView() == "json", "json");
		assert_true(!read.root.Member("server").Member("limiter").AsBool(), "no limiter");
		assert_true(!read.root.Member("outgoing").Member("proxies").IsValid(), "no proxy");
		assert_true(read.root.Member("engines").At(1).Member("name").AsView() == "google news", "turned on");
		assert_true(read.root.Member("engines").At(1).Member("disabled").Kind() == Serialization::DomKind::Bool, "disabled: false");
		assert_true(!read.root.Member("server").Member("secret_key").IsValid(), "the secret is the launcher's");
	}

	[test("settings.yml through Tor")]
	public static void TestTor() {
		WebSearch::SearxConfig config;
		config.engines = Names("brave", null, null);
		config.timeoutSeconds = 10;
		config.proxy = Core::String("socks5h://ied3:ied@127.0.0.1:9050");
		Core::String yaml = WebSearch::SettingsYaml(config);
		Serialization::DomDoc doc;
		Serialization::ReadResult read = Serialization::ReadYaml(yaml.View(), doc);
		assert_true(read.Ok(), yaml.CStr());
		Serialization::DomNode outgoing = read.root.Member("outgoing");
		assert_true(outgoing.Member("proxies").Member("all://").At(0).AsView() == "socks5h://ied3:ied@127.0.0.1:9050", yaml.CStr());
		assert_true(!outgoing.Member("using_tor_proxy").IsValid(), "no start-up check of its own");
		assert_eq((int64)10, (int64)outgoing.Member("request_timeout").AsFloat(), "timeout");
		assert_eq((int64)300, read.root.Member("search").Member("suspended_times").Member("SearxEngineAccessDenied").AsInt(), "a short rest");
	}

	[test("engine names and safe search")]
	public static void TestNames() {
		Serialization::DomDoc doc;
		Serialization::DomNode list = Serialization::ReadJson(Core::StringView("[\" Brave \", \"bing\", \"\", \"BRAVE\", \"GitHub\"]"), doc).root;
		Core::Array<Core::String> names = WebSearch::EngineNames(list);
		assert_eq((int64)3, names.Count(), "trimmed, lowercased, no empties or repeats");
		assert_true(names[0].View() == "brave" && names[2].View() == "github", names[2].CStr());
		assert_eq((int64)0, (int64)WebSearch::SafeSearchLevel(Core::StringView("off")), "off");
		assert_eq((int64)2, (int64)WebSearch::SafeSearchLevel(Core::StringView("strict")), "strict");
		assert_eq((int64)0, (int64)WebSearch::SafeSearchLevel(Core::StringView("bogus")), "bogus");
	}
}

[test("server.websearch.results")]
class WebSearchResultTests {
	[test("the search URL")]
	public static void TestTarget() {
		WebSearch::SearchRequest request;
		request.query = Core::String("c++ std::variant & co");
		request.engines = Names("brave", "google news", null);
		request.page = 2;
		request.safeSearch = 0;
		request.timeRange = Core::String("week");
		request.language = Core::String("auto");
		Core::String target = WebSearch::SearchTarget(request);
		assert_se("/search?q=c%2B%2B%20std%3A%3Avariant%20%26%20co&format=json&pageno=2&safesearch=0&engines=brave%2Cgoogle%20news&time_range=week", target.CStr(), "target");
	}

	[test("SearXNG's answer read")]
	public static void TestParse() {
		WebSearch::SearchResults results;
		Core::String error;
		assert_true(WebSearch::ParseResults(Core::StringView(kSearxAnswer), results, error), error.CStr());
		assert_eq((int64)2, results.hits.Count(), "a result without a URL is left out");
		assert_true(results.hits[0].title.View() == "References and Borrowing", results.hits[0].title.CStr());
		assert_true(results.hits[0].content.View() == "A reference is like a pointer.", results.hits[0].content.CStr());
		assert_true(results.hits[0].published.View() == "2024-05-01", results.hits[0].published.CStr());
		assert_eq((int64)1, results.hits[1].engines.Count(), "engine when engines is empty");
		assert_eq((int64)2, results.answers.Count(), "an object's answer and a plain one");
		assert_eq((int64)3, results.failed.Count(), "failed engines");
		assert_eq((int64)2, WebSearch::BlockedCount(results), "access denied and CAPTCHA are blocks, a timeout is not");
		assert_true(!WebSearch::ParseResults(Core::StringView("<html>"), results, error), "not JSON");
	}

	[test("what the model reads")]
	public static void TestText() {
		WebSearch::SearchResults results;
		Core::String error;
		WebSearch::ParseResults(Core::StringView(kSearxAnswer), results, error);
		WebSearch::SearchRequest request;
		request.query = Core::String("rust borrow");
		request.engines = Names("brave", "bing", null);
		request.count = 1;
		request.page = 1;
		Core::String text = WebSearch::ResultsText(request, results, true);
		assert_true(text.View().StartsWith(Core::StringView("Results for \"rust borrow\" (through Tor; brave, bing)\n\n1. References and Borrowing\n   https://doc.rust-lang.org/book/ch04-02.html\n   A reference is like a pointer.\n   brave, bing | 2024-05-01\n\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("Answer: 42\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("Suggestions: rust borrow checker\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("Engines that failed: google (access denied), duckduckgo (Suspended: CAPTCHA), wikipedia (timeout)\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("Showing 1 of 2 results; page=2 gives more")), text.CStr());
		WebSearch::SearchResults none;
		Core::String empty = WebSearch::ResultsText(request, none, false);
		assert_true(empty.View().StartsWith(Core::StringView("No results for \"rust borrow\" (brave, bing)")), empty.CStr());
	}
}
