include "Searx.ch"

namespace WebSearch
{
	const char* SearxStateName(SearxState state) {
		if (state == SearxState::Starting) return "starting";
		if (state == SearxState::Ready) return "ready";
		if (state == SearxState::Failed) return "failed";
		if (state == SearxState::External) return "external";
		return "stopped";
	}

	static Core::String Slashes(Core::StringView path) {
		Core::StringBuilder text;
		for (int64 i = 0; i < path.ByteLength(); ++i) text.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return text.ToString();
	}

	static Core::String ReadText(Core::StringView path) {
		Core::String file = Core::String(path);
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? opened.ReadText() : Core::String();
	}

	static Serialization::DomNode SettingNode(IED::PluginContext* context, const char* key) {
		Core::String json = context->Setting(Core::StringView(key), Core::StringView(""));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json.View(), *doc).root;
	}

	static int64 SettingInt(IED::PluginContext* context, const char* key, int64 fallback) {
		Serialization::DomNode node = SettingNode(context, key);
		return node.Kind() == Serialization::DomKind::Int ? node.AsInt() : fallback;
	}

	static bool SettingBool(IED::PluginContext* context, const char* key, bool fallback) {
		Serialization::DomNode node = SettingNode(context, key);
		return node.Kind() == Serialization::DomKind::Bool ? node.AsBool() : fallback;
	}

	static Core::String SecondsText(int64 ns) {
		Core::StringBuilder text;
		text.AppendInt(ns / 1000000000);
		text.Append(" s");
		return text.ToString();
	}

	// Whether a log line says what went wrong: SearXNG's "ERROR:" lines and a traceback's last line ("RuntimeError: ...").
	static bool Telling(Core::StringView line) {
		if (line.Contains(Core::StringView("ERROR:"))) return true;
		const int64 colon = line.IndexOf(Core::StringView(": "));
		if (colon <= 0 || line.ByteAt(0) == ' ') return false;
		Core::StringView name = line.Substring(0, colon);
		return (name.EndsWith(Core::StringView("Error")) || name.EndsWith(Core::StringView("Exception"))) && name.IndexOf(' ', 0) < 0;
	}

	// SearXNG's last `lines` telling lines in its log `text` (else its last lines), joined by " | ".
	static Core::String TailLines(Core::StringView text, int32 lines) {
		Core::Array<Core::StringView> all;
		Core::Array<Core::StringView> telling;
		Core::StringView rest = text;
		while (!rest.IsEmpty()) {
			const int64 end = rest.IndexOf('\n', 0);
			Core::StringView line = (end < 0 ? rest : rest.Substring(0, end)).Trimmed();
			rest = end < 0 ? Core::StringView("") : rest.Substring(end + 1, rest.ByteLength() - end - 1);
			if (line.IsEmpty()) continue;
			all.Push(line);
			if (Telling(line)) telling.Push(line);
		}
		const Core::Array<Core::StringView>* chosen = telling.IsEmpty() ? &all : &telling;
		Core::StringBuilder tail;
		for (int64 i = chosen->Count() > lines ? chosen->Count() - lines : 0; i < chosen->Count(); ++i) {
			if (!tail.IsEmpty()) tail.Append(" | ");
			tail.Append(chosen->At(i));
		}
		return tail.ToString();
	}

	void SearxService::Start() {
		m_State = SearxState::Stopped;
		Publish();
		SearxService* self = this;
		m_Context->StartThread([self]() { self->Watch(); });
	}

	// --- Engines ----------------------------------------------------------------------------------------------------

	Core::String SearxService::Folder(const char* setting, const char* bundled) const {
		Core::StringView configured = SettingNode(m_Context, setting).AsView();
		return configured.IsEmpty() ? Slashes(IED::HomeFolder().View()) + bundled : Slashes(configured);
	}

	Core::Array<Core::String> SearxService::Engines(Core::Array<Core::String>& unknown) { return KnownEngines(unknown); }

	// The configured engines SearXNG has, its names read once from its settings.yml. Not under `starting`: a search
	// prepares while a start waits for Tor.
	Core::Array<Core::String> SearxService::KnownEngines(Core::Array<Core::String>& unknown) {
		Core::Array<Core::String> catalog;
		{
			Threading::LockGuard guard(m_CatalogLock);
			if (!m_CatalogRead) {
				m_CatalogRead = true;
				Serialization::DomDoc* doc = new Serialization::DomDoc();
				Core::String yaml = ReadText((Folder("websearch.searxngFolder", "/vendor/searxng") + "/searx/settings.yml").View());
				Serialization::DomNode list = Serialization::ReadYaml(yaml.View(), *doc).root.Member("engines");
				for (int64 i = 0; i < list.Count(); ++i) m_CatalogNames.Push(Lowercase(list.At(i).Member("name").AsView()));
			}
			catalog = m_CatalogNames;
		}
		Core::Array<Core::String> known;
		Core::Array<Core::String> configured = EngineNames(SettingNode(m_Context, "websearch.engines"));
		for (const Core::String& name : configured) {
			bool found = catalog.IsEmpty();
			for (const Core::String& entry : catalog)
				if (entry.View() == name.View()) found = true;
			if (found) known.Push(name);
			else unknown.Push(name);
		}
		return known;
	}

	Core::String SearxService::CatalogJson() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String yaml = ReadText((Folder("websearch.searxngFolder", "/vendor/searxng") + "/searx/settings.yml").View());
		Serialization::ReadResult read = Serialization::ReadYaml(yaml.View(), *doc);
		IED::JsonWriter json;
		json.BeginObject();
		if (!read.Ok()) json.Field("error", Core::StringView("SearXNG's settings.yml cannot be read: is SearXNG installed?"));
		json.Key(Core::StringView("engines"));
		json.BeginArray();
		Serialization::DomNode list = read.root.Member("engines");
		for (int64 i = 0; i < list.Count(); ++i) {
			Serialization::DomNode entry = list.At(i);
			if (entry.Member("name").AsView().IsEmpty()) continue;
			json.BeginObject();
			json.Field("name", Lowercase(entry.Member("name").AsView()).View());
			json.Field("shortcut", entry.Member("shortcut").AsView());
			json.Key(Core::StringView("categories"));
			json.BeginArray();
			Serialization::DomNode categories = entry.Member("categories");
			if (categories.Kind() == Serialization::DomKind::String) json.String(categories.AsView());
			for (int64 j = 0; j < categories.Count(); ++j) json.String(categories.At(j).AsView());
			json.EndArray();
			json.BoolField("off", entry.Member("disabled").AsBool() || entry.Member("inactive").AsBool());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Starting ---------------------------------------------------------------------------------------------------

	// Ready, or ready within `waitNs`: a start runs on a thread of its own, so one that takes longer goes on while the
	// caller hears that web search is starting. False with `error`: that, or why the start failed.
	bool SearxService::Started(int64 waitNs, Core::String& error) {
		int64 run;
		bool launch = false;
		{
			Threading::LockGuard guard(m_Fields);
			if (m_State == SearxState::Ready || m_State == SearxState::External) return true;
			run = m_StartsDone;
			launch = !m_StartRunning;
			m_StartRunning = true;
		}
		SearxService* self = this;
		if (launch) m_Context->StartThread([self]() { self->StartInBackground(); });
		const int64 deadline = clock_now_ns() + waitNs;
		while (true) {
			{
				Threading::LockGuard guard(m_Fields);
				if (m_StartsDone > run) {
					error = m_StartProblem;
					return m_StartProblem.IsEmpty();
				}
				if (clock_now_ns() >= deadline) {
					Core::StringView now = m_State == SearxState::Starting && !m_Summary.IsEmpty() ? m_Summary.View() : Core::StringView("starting SearXNG");
					error = (Core::String("web search is starting (") + now) + "); ask again in a few seconds";
					return false;
				}
			}
			Threading::Thread::Sleep(c_StartPollNs);
		}
	}

	void SearxService::StartInBackground() {
		Core::String base;
		bool viaTor = false;
		Core::String problem;
		{
			Threading::LockGuard guard(m_Starting);
			if (m_Stopping) problem = Core::String("web search stopped");
			else Ensure(base, viaTor, problem);
		}
		Threading::LockGuard guard(m_Fields);
		m_StartRunning = false;
		m_StartsDone += 1;
		m_StartProblem = problem;
	}

	// Under `starting`: the instance a search uses now, started or restarted when needed.
	bool SearxService::Ensure(Core::String& base, bool& viaTor, Core::String& error) {
		{
			Threading::LockGuard guard(m_Fields);
			m_UsedNs = clock_now_ns();
		}
		Core::String instance = Core::String(SettingNode(m_Context, "websearch.instanceUrl").AsView().Trimmed());
		viaTor = false;
		if (!instance.IsEmpty()) return External(instance.View(), base, error);
		const bool useTor = SettingBool(m_Context, "websearch.useTor", true);
		SearxConfig config;
		Core::Array<Core::String> unknown;
		config.m_Engines = KnownEngines(unknown);
		{
			Threading::LockGuard guard(m_Fields);
			m_Engines = config.m_Engines;
			m_UnknownEngines = unknown;
		}
		if (config.m_Engines.IsEmpty()) {
			error = Core::String("websearch.engines names no engine SearXNG has: add some in Settings > Web > Search");
			SetState(SearxState::Failed, Core::StringView(""), error.View());
			return false;
		}
		config.m_SafeSearch = SafeSearchLevel(SettingNode(m_Context, "websearch.safeSearch").AsView());
		config.m_TimeoutSeconds = (int32)SettingInt(m_Context, "websearch.timeoutSeconds", 8);
		if (useTor && !TorProxy(config.m_Proxy, error)) {
			Halt(SearxState::Failed, error.View());
			return false;
		}
		Core::String yaml = SettingsYaml(config);
		const bool alive = m_Process != null && m_Process->Wait(0) == Process::kTimedOut;
		if (!alive || yaml.View() != m_RunningYaml.View()) {
			if (m_Process != null) Halt(SearxState::Stopped, alive ? Core::StringView("its settings changed") : Core::StringView("it had stopped"));
			if (!Launch(yaml.View(), error)) return false;
		}
		else SetState(SearxState::Ready, Core::StringView(""), Core::StringView(""));
		Threading::LockGuard guard(m_Fields);
		base = m_Url;
		viaTor = useTor;
		m_ViaTorNow = useTor;
		return true;
	}

	bool SearxService::External(Core::StringView instance, Core::String& base, Core::String& error) {
		if (m_Process != null) Halt(SearxState::Stopped, Core::StringView("websearch.instanceUrl names another SearXNG"));
		const Http::Url parsed = Http::ParseUrl(instance);
		if (!parsed.valid || parsed.webSocket) {
			error = Core::String("websearch.instanceUrl must be an http:// or https:// address: ") + instance;
			SetState(SearxState::Failed, Core::StringView(""), error.View());
			return false;
		}
		base = Core::String(instance.EndsWith(Core::StringView("/")) ? instance.Substring(0, instance.ByteLength() - 1) : instance);
		{
			Threading::LockGuard guard(m_Fields);
			m_Url = base;
			m_ViaTorNow = false;
		}
		SetState(SearxState::External, Core::StringView("the owner's SearXNG"), Core::StringView(""));
		return true;
	}

	// Under `starting`: asks the Tor plugin for its proxy until Tor is ready (it answers at once, so this polls).
	bool SearxService::TorProxy(Core::String& proxy, Core::String& error) {
		const int64 deadline = clock_now_ns() + c_TorWaitNs;
		const char* advice = " (or turn websearch.useTor off to search without Tor)";
		while (true) {
			IED::Result answer = IED::CallBinding(Core::StringView("tor.proxy"), Core::StringView("{}"));
			if (!answer.Ok()) {
				error = (Core::String("web search goes through Tor, and the Tor plugin did not answer: ") + answer.m_Error.View()) + advice;
				return false;
			}
			Serialization::DomDoc* doc = new Serialization::DomDoc();
			Serialization::DomNode tor = Serialization::ReadJson(answer.m_Json.View(), *doc).root;
			Core::StringView torState = tor.Member("state").AsView();
			if (torState == "ready") {
				Core::StringBuilder text;
				text.Append("socks5h://ied");
				text.AppendInt(m_Circuit);
				text.Append(":ied@");
				text.Append(tor.Member("host").AsView());
				text.Append(":");
				text.AppendInt(tor.Member("port").AsInt());
				proxy = text.ToString();
				return true;
			}
			if (torState == "failed") {
				error = (Core::String("web search goes through Tor, which failed: ") + tor.Member("error").AsView()) + advice;
				return false;
			}
			Core::StringBuilder waiting;
			waiting.Append("waiting for Tor: ");
			waiting.AppendInt(tor.Member("progress").AsInt());
			waiting.Append("% ");
			waiting.Append(tor.Member("summary").AsView());
			SetState(SearxState::Starting, waiting.View(), Core::StringView(""));
			if (clock_now_ns() > deadline) {
				error = (Core::String("Tor was not ready within ") + SecondsText(c_TorWaitNs).View() + " (" + waiting.View()) + ")" + advice;
				return false;
			}
			Threading::Thread::Sleep(c_TorPollNs);
		}
	}

	// Under `starting`.
	bool SearxService::Launch(Core::StringView yaml, Core::String& error) {
		Core::String python = Folder("websearch.python", "/vendor/python/python.exe");
		Core::String searxng = Folder("websearch.searxngFolder", "/vendor/searxng");
		Core::String packages = Slashes(FS::Path(searxng.View()).Parent().View()) + "/searxng-packages";
		if (!FS::FileExists(python.CStr()) || !FS::FileExists((searxng + "/searx/webapp.py").CStr()) || !FS::IsDirectory((packages + "/waitress").CStr())) {
			error = Core::String("SearXNG is not installed: run setup.bat (it installs SearXNG, its Python packages and Tor into vendor/), or set websearch.instanceUrl");
			SetState(SearxState::Failed, Core::StringView(""), error.View());
			return false;
		}
		Core::String folder = Slashes(m_Context->StateFolder().View());
		FS::MakeDirectories(folder.CStr());
		Core::String settings = folder + "/settings.yml";
		Core::String portFile = folder + "/port";
		FS::RemoveFile(portFile.CStr());
		if (!FS::WriteFileAtomically(settings.CStr(), (const void*)yaml.Data(), yaml.ByteLength())) {
			error = Core::String("SearXNG's settings cannot be written: ") + settings.View();
			SetState(SearxState::Failed, Core::StringView(""), error.View());
			return false;
		}
		Process::StartInfo info;
		info.program = python;
		info.arguments.Push(Core::String("-I"));
		info.arguments.Push(Slashes(m_Context->Folder().View()) + "/service/serve.py");
		info.arguments.Push(Core::String("--searxng"));
		info.arguments.Push(searxng);
		info.arguments.Push(Core::String("--packages"));
		info.arguments.Push(packages);
		info.arguments.Push(Core::String("--settings"));
		info.arguments.Push(settings);
		info.arguments.Push(Core::String("--state"));
		info.arguments.Push(folder);
		info.arguments.Push(Core::String("--port-file"));
		info.arguments.Push(portFile);
		info.arguments.Push(Core::String("--log"));
		info.arguments.Push(folder + "/searxng.log");
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			error = Core::String("SearXNG did not start: ") + started.Error();
			SetState(SearxState::Failed, Core::StringView(""), error.View());
			return false;
		}
		m_Process = new Process::Child(take(started));
		SetState(SearxState::Starting, Core::StringView("starting SearXNG"), Core::StringView(""));
		const int64 begun = clock_now_ns();
		while (clock_now_ns() - begun < c_StartLimitNs) {
			if (m_Process->Wait(100) != Process::kTimedOut) {
				error = Core::String("SearXNG stopped as it started: ") + LogTailText().View();
				Halt(SearxState::Failed, error.View());
				return false;
			}
			int64 port = 0;
			if (!Core::ParseInt64(ReadText(portFile.View()).View().Trimmed(), port) || port <= 0) continue;
			m_RunningYaml = Core::String(yaml);
			Core::StringBuilder address;
			address.Append("http://127.0.0.1:");
			address.AppendInt(port);
			{
				Threading::LockGuard guard(m_Fields);
				m_Url = address.ToString();
			}
			SetState(SearxState::Ready, Core::StringView(""), Core::StringView(""));
			m_Context->Log(((Core::String("SearXNG is ready in ") + SecondsText(clock_now_ns() - begun).View()) + " at " + address.View()).View());
			return true;
		}
		error = (Core::String("SearXNG did not start within ") + SecondsText(c_StartLimitNs).View() + ": ") + LogTailText().View();
		Halt(SearxState::Failed, error.View());
		return false;
	}

	// Under `starting`.
	void SearxService::Halt(SearxState next, Core::StringView why) {
		if (m_Process != null) {
			m_Process->Kill();
			m_Process->Close();
			m_Process = null;
		}
		m_RunningYaml = Core::String();
		if (next == SearxState::Failed) m_Context->Log((Core::String("SearXNG failed: ") + why).View());
		else if (!why.IsEmpty()) m_Context->Log((Core::String("SearXNG stopped: ") + why).View());
		SetState(next, Core::StringView(""), next == SearxState::Failed ? why : Core::StringView(""));
	}

	Core::String SearxService::LogTailText() const {
		Core::String tail = TailLines(ReadText((Slashes(m_Context->StateFolder().View()) + "/searxng.log").View()).View(), 3);
		return tail.IsEmpty() ? Core::String("it wrote nothing to its log") : tail;
	}

	// --- Searching --------------------------------------------------------------------------------------------------

	bool SearxService::Query(Core::StringView base, const SearchRequest& request, SearchResults& results, Core::String& error) {
		const int32 timeoutMs = (int32)SettingInt(m_Context, "websearch.timeoutSeconds", 8) * 2000 + c_SearchSlackMs;
		Http::FetchResult got = Http::Get((Core::String(base) + SearchTarget(request).View()).View(), timeoutMs);
		if (!got.ok) {
			error = Core::String("SearXNG did not answer: ") + got.error.View();
			return false;
		}
		if (got.response.status != 200) {
			Core::StringBuilder text;
			text.Append("SearXNG answered ");
			text.AppendInt(got.response.status);
			text.Append(": ");
			Core::StringView body = got.response.BodyText();
			text.Append(body.ByteLength() > 300 ? body.Substring(0, 300) : body);
			error = text.ToString();
			return false;
		}
		return ParseResults(got.response.BodyText(), results, error);
	}

	// Under `starting`: the next start gets circuits of its own (another SOCKS user), and Tor new ones for everything.
	void SearxService::NewCircuit() {
		m_Circuit += 1;
		IED::CallBinding(Core::StringView("tor.newCircuit"), Core::StringView("{}"));
	}

	bool SearxService::Search(const SearchRequest& request, SearchResults& results, bool& viaTor, Core::String& error) {
		const int64 begun = clock_now_ns();
		Core::String base;
		bool ready = Started(request.m_StartWaitNs, error);
		if (ready) {
			Threading::LockGuard guard(m_Starting);
			ready = Ensure(base, viaTor, error);
		}
		if (!ready || !Query(base.View(), request, results, error)) {
			Record(request, results, (clock_now_ns() - begun) / 1000000, error.View(), false);
			return false;
		}
		const int64 few = request.m_Count < 3 ? request.m_Count : 3;
		const int64 blocked = BlockedCount(results);
		const bool refused = viaTor && blocked > 0 && (results.m_Hits.Count() < few || blocked * 2 >= request.m_Engines.Count())
			&& SettingBool(m_Context, "websearch.newCircuitOnBlock", true);
		// Every engine failing otherwise (timeouts: the first circuits after Tor starts are slow) is worth one more try.
		const bool unanswered = results.m_Hits.IsEmpty() && !results.m_Failed.IsEmpty();
		const bool retry = refused || unanswered;
		if (retry) {
			const char* why = refused ? "\"; engines refused this Tor exit, again on new circuits" : "\"; no engine answered, once more";
			m_Context->Log(((Core::String("web search for \"") + request.m_Query.View()) + why).View());
			SearchResults again;
			Core::String problem;
			{
				Threading::LockGuard guard(m_Starting);
				if (refused) NewCircuit();
				ready = Ensure(base, viaTor, problem);
			}
			if (ready && Query(base.View(), request, again, problem) && again.m_Hits.Count() > results.m_Hits.Count()) results = again;
		}
		Record(request, results, (clock_now_ns() - begun) / 1000000, Core::StringView(""), retry);
		return true;
	}

	bool SearxService::Restart(bool newCircuit, Core::String& error) {
		Threading::LockGuard guard(m_Starting);
		if (newCircuit) NewCircuit();
		Halt(SearxState::Stopped, newCircuit ? Core::StringView("restarted on new circuits") : Core::StringView("restarted"));
		Core::String base;
		bool viaTor = false;
		return Ensure(base, viaTor, error);
	}

	void SearxService::Stop(bool final) {
		Threading::LockGuard guard(m_Starting);
		if (final) m_Stopping = true;
		Halt(SearxState::Stopped, final ? Core::StringView("") : Core::StringView("asked to stop"));
	}

	// --- Watching ---------------------------------------------------------------------------------------------------

	// Notices a SearXNG that died and stops one unused for websearch.stopAfterSeconds; never waits on a start.
	void SearxService::Watch() {
		while (true) {
			Threading::Thread::Sleep(c_WatchTickNs);
			if (!m_Starting.TryLock()) continue;
			if (m_Stopping) {
				m_Starting.Unlock();
				return;
			}
			if (m_Process != null && m_Process->Wait(0) != Process::kTimedOut) Halt(SearxState::Failed, (Core::String("SearXNG stopped: ") + LogTailText().View()).View());
			else if (m_Process != null) {
				int64 idleNs;
				{
					Threading::LockGuard guard(m_Fields);
					idleNs = clock_now_ns() - m_UsedNs;
				}
				const int64 stopAfter = SettingInt(m_Context, "websearch.stopAfterSeconds", c_DefaultStopAfterSeconds);
				if (stopAfter > 0 && idleNs > stopAfter * 1000000000) Halt(SearxState::Stopped, (Core::String("unused for ") + SecondsText(idleNs).View()).View());
			}
			m_Starting.Unlock();
		}
	}

	// --- Status -----------------------------------------------------------------------------------------------------

	void SearxService::SetState(SearxState next, Core::StringView text, Core::StringView problem) {
		{
			Threading::LockGuard guard(m_Fields);
			m_State = next;
			m_Summary = Core::String(text);
			m_Error = Core::String(problem);
			if (next != SearxState::Ready && next != SearxState::External && next != SearxState::Starting) m_Url = Core::String();
		}
		Publish();
	}

	void SearxService::Record(const SearchRequest& request, const SearchResults& results, int64 ms, Core::StringView problem, bool retried) {
		{
			Threading::LockGuard guard(m_Fields);
			m_Searched = true;
			m_Last.m_Query = request.m_Query;
			m_Last.m_Results = results.m_Hits.Count();
			m_Last.m_Ms = ms;
			m_Last.m_Failed = results.m_Failed;
			m_Last.m_Error = Core::String(problem);
			m_Last.m_Retried = retried;
		}
		Publish();
	}

	static void Names(IED::JsonWriter& json, const char* key, const Core::Array<Core::String>& names) {
		json.Key(Core::StringView(key));
		json.BeginArray();
		for (const Core::String& name : names) json.String(name.View());
		json.EndArray();
	}

	// Under `fields`.
	static Core::String StatusText(SearxState state, Core::StringView url, Core::StringView summary, Core::StringView error, bool viaTor,
		const Core::Array<Core::String>& engines, const Core::Array<Core::String>& unknown, bool searched, const LastSearch& last) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("state", SearxStateName(state));
		if (!url.IsEmpty()) json.Field("url", url);
		if (!summary.IsEmpty()) json.Field("summary", summary);
		if (!error.IsEmpty()) json.Field("error", error);
		json.BoolField("viaTor", viaTor && state != SearxState::External);
		Names(json, "engines", engines);
		Names(json, "unknownEngines", unknown);
		if (searched) {
			json.Key(Core::StringView("lastSearch"));
			json.BeginObject();
			json.Field("query", last.m_Query.View());
			json.IntField("results", last.m_Results);
			json.IntField("ms", last.m_Ms);
			json.BoolField("retried", last.m_Retried);
			if (!last.m_Error.IsEmpty()) json.Field("error", last.m_Error.View());
			json.Key(Core::StringView("failed"));
			json.BeginArray();
			for (const EngineFailure& failure : last.m_Failed) {
				json.BeginArray();
				json.String(failure.m_Engine.View());
				json.String(failure.m_Reason.View());
				json.EndArray();
			}
			json.EndArray();
			json.EndObject();
		}
		json.EndObject();
		return json.ToString();
	}

	Core::String SearxService::StatusJson() {
		Threading::LockGuard guard(m_Fields);
		return StatusText(m_State, m_Url.View(), m_Summary.View(), m_Error.View(), m_ViaTorNow, m_Engines, m_UnknownEngines, m_Searched, m_Last);
	}

	// The topic's snapshot and a status event, when the status changed (`fields`, then the server's lock).
	void SearxService::Publish() {
		Threading::LockGuard guard(m_Fields);
		Core::String json = StatusText(m_State, m_Url.View(), m_Summary.View(), m_Error.View(), m_ViaTorNow, m_Engines, m_UnknownEngines, m_Searched, m_Last);
		if (json.View() == m_Published.View()) return;
		m_Published = json;
		m_Context->Topic(Core::StringView(c_StatusTopic), json.View());
		m_Context->Publish(Core::StringView(c_StatusTopic), "status", json.View());
	}
}
