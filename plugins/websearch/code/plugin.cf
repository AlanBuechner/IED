// The ied.websearch plugin's entry (runtime.entry "WebSearch::Activate"): one SearxService behind the websearch.*
// bindings (other plugins, the web_search tool), the websearch.* protocol methods (the Search settings page) and the
// web_search tool.

include "searx.ch"

namespace WebSearch
{
	const char* kTestQuery = "open source software";
	// How long the Search page and the web_search tool wait for SearXNG and Tor to start; a binding call waits
	// kStartWaitSeconds, within its 30 s.
	const int64 kPatientWaitSeconds = 100;
	const char*[6] kSearchArgs = { "query", "engines", "count", "page", "time_range", "language" };

	static IED::RpcError Unavailable(Core::StringView why) { return IED::RpcError(IED::ErrorCode::Unavailable, why); }

	// The results of a search with `args` as JSON (ResultsJson), or false with `error`.
	static bool SearchJson(SearxService* searx, const Serialization::DomNode& args, Core::String& json, Core::String& error) {
		SearchRequest request;
		if (!searx->Prepare(args, request, error)) return false;
		SearchResults results;
		bool viaTor = false;
		if (!searx->Search(request, results, viaTor, error)) return false;
		json = ResultsJson(request, results, viaTor);
		return true;
	}

	// A method's params as the arguments of a search that waits for a start.
	static Serialization::DomNode SearchArgs(const IED::Params& params) {
		IED::JsonWriter json;
		json.BeginObject();
		for (int64 i = 0; i < 6; ++i)
			if (params.Has(kSearchArgs[i])) json.RawField(kSearchArgs[i], IED::NodeJson(params.Field(kSearchArgs[i])).View());
		json.IntField("wait", kPatientWaitSeconds);
		json.EndObject();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json.View(), *doc).root;
	}

	// The web_search tool's arguments as those of a search that waits for a start, as JSON.
	static Core::String ToolArgs(const Serialization::DomNode& args) {
		IED::JsonWriter json;
		json.BeginObject();
		for (int64 i = 0; i < 6; ++i)
			if (args.Member(kSearchArgs[i]).IsValid()) json.RawField(kSearchArgs[i], IED::NodeJson(args.Member(kSearchArgs[i])).View());
		json.IntField("wait", kPatientWaitSeconds);
		json.EndObject();
		return json.ToString();
	}

	// Every configured engine in one search: what each found, or why it failed.
	static Core::String TestEngines(SearxService* searx) {
		SearchRequest request;
		Core::String error;
		IED::JsonWriter asked;
		asked.BeginObject();
		asked.Field("query", Core::StringView(kTestQuery));
		asked.IntField("count", 20);
		asked.IntField("wait", kPatientWaitSeconds);
		asked.EndObject();
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		if (!searx->Prepare(Serialization::ReadJson(asked.View(), *doc).root, request, error)) throw Unavailable(error.View());
		SearchResults results;
		bool viaTor = false;
		const int64 begun = clock_now_ns();
		if (!searx->Search(request, results, viaTor, error)) throw Unavailable(error.View());
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("query", Core::StringView(kTestQuery));
		json.BoolField("viaTor", viaTor);
		json.IntField("ms", (clock_now_ns() - begun) / 1000000);
		json.Key(Core::StringView("engines"));
		json.BeginArray();
		for (const Core::String& engine : request.engines) {
			int64 found = 0;
			for (const SearchHit& hit : results.hits)
				for (const Core::String& by : hit.engines)
					if (Lowercase(by.View()).View() == engine.View()) found += 1;
			json.BeginObject();
			json.Field("name", engine.View());
			json.IntField("results", found);
			for (const EngineFailure& failure : results.failed)
				if (Lowercase(failure.engine.View()).View() == engine.View()) json.Field("error", failure.reason.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	static void Register(IED::PluginContext& context, const char* name, IED::MethodHandler handler) {
		Core::String problem;
		if (!context.Method(Core::StringView(name), handler, problem)) context.Log(problem.View());
	}

	static void RegisterMethods(IED::PluginContext& context, SearxService* searx) {
		Register(context, "websearch.status", [searx](const IED::Request& request) -> Core::String { return searx->StatusJson(); });
		Register(context, "websearch.catalog", [searx](const IED::Request& request) -> Core::String { return searx->CatalogJson(); });
		Register(context, "websearch.search", [searx](const IED::Request& request) -> Core::String {
			Core::String json;
			Core::String error;
			if (!SearchJson(searx, SearchArgs(request.params), json, error)) throw Unavailable(error.View());
			return json;
		});
		Register(context, "websearch.testEngines", [searx](const IED::Request& request) -> Core::String { return TestEngines(searx); });
		Register(context, "websearch.restart", [searx](const IED::Request& request) -> Core::String {
			Core::String error;
			if (!searx->Restart(request.params.Bool("newCircuit", false), error)) throw Unavailable(error.View());
			return searx->StatusJson();
		});
	}

	void Activate(IED::PluginContext& context) {
		SearxService* searx = new SearxService(&context);
		searx->Start();
		RegisterMethods(context, searx);
		context.Provide(Core::StringView("websearch.search"), [searx](const Serialization::DomNode& args) -> IED::Result {
			Core::String json;
			Core::String error;
			return SearchJson(searx, args, json, error) ? IED::Answer(json.View()) : IED::Refusal(error.View());
		});
		context.Provide(Core::StringView("websearch.status"), [searx](const Serialization::DomNode& args) -> IED::Result { return IED::Answer(searx->StatusJson().View()); });
		context.OnDeactivate([searx]() { searx->Stop(true); });
	}

	// web_search (docs/13 T-WEB-1): through the websearch.search binding, which runs here at once.
	IED::ToolResult SearchTool(const IED::ToolCall& call) {
		IED::Result answer = IED::CallBinding(Core::StringView("websearch.search"), ToolArgs(call.args).View());
		if (!answer.Ok()) return IED::ToolFailure(answer.error.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return IED::ToolText(Serialization::ReadJson(answer.json.View(), *doc).root.Member("text").AsView());
	}
}
