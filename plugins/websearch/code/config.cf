include "config.ch"

namespace WebSearch
{
	Core::String Lowercase(Core::StringView text) {
		Core::StringBuilder lower;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			lower.AppendByte(c >= 'A' && c <= 'Z' ? c + 32 : c);
		}
		return lower.ToString();
	}

	static void Quoted(Core::StringBuilder& text, Core::StringView value) {
		text.Append("\"");
		for (int64 i = 0; i < value.ByteLength(); ++i) {
			const int32 c = value.ByteAt(i);
			if (c == '"' || c == '\\') text.AppendByte('\\');
			text.AppendByte(c);
		}
		text.Append("\"");
	}

	int32 SafeSearchLevel(Core::StringView name) {
		if (name == "moderate") return 1;
		if (name == "strict") return 2;
		return 0;
	}

	Core::Array<Core::String> EngineNames(const Serialization::DomNode& list) {
		Core::Array<Core::String> names;
		for (int64 i = 0; i < list.Count(); ++i) {
			Core::String name = Lowercase(list.At(i).AsView().Trimmed());
			if (name.IsEmpty()) continue;
			bool seen = false;
			for (const Core::String& known : names)
				if (known.View() == name.View()) seen = true;
			if (!seen) names.Push(name);
		}
		return names;
	}

	Core::String SettingsYaml(const SearxConfig& config) {
		Core::StringBuilder text;
		text.Append("# Written by IED's web search plugin (docs/29) at each start of SearXNG; edits here are lost.\n");
		text.Append("use_default_settings:\n  engines:\n    keep_only:\n");
		for (const Core::String& engine : config.engines) {
			text.Append("      - ");
			Quoted(text, engine.View());
			text.Append("\n");
		}
		text.Append("general:\n  instance_name: \"IED\"\n  enable_metrics: false\n");
		text.Append("server:\n  limiter: false\n  public_instance: false\n  image_proxy: false\n  method: \"GET\"\n");
		text.Append("search:\n  safe_search: ");
		text.AppendInt(config.safeSearch);
		text.Append("\n  autocomplete: \"\"\n  formats: [html, json]\n");
		text.Append("  suspended_times:\n");
		text.Append("    SearxEngineAccessDenied: 300\n    SearxEngineCaptcha: 600\n    SearxEngineTooManyRequests: 300\n");
		text.Append("    cf_SearxEngineCaptcha: 1800\n    cf_SearxEngineAccessDenied: 1800\n    recaptcha_SearxEngineCaptcha: 1800\n");
		text.Append("outgoing:\n  request_timeout: ");
		text.AppendInt(config.timeoutSeconds);
		text.Append(".0\n  max_request_timeout: ");
		text.AppendInt(config.timeoutSeconds * 2);
		text.Append(".0\n");
		if (!config.proxy.IsEmpty()) {
			text.Append("  proxies:\n    all://:\n      - ");
			Quoted(text, config.proxy.View());
			text.Append("\n");
		}
		text.Append("engines:\n");
		for (const Core::String& engine : config.engines) {
			text.Append("  - name: ");
			Quoted(text, engine.View());
			text.Append("\n    disabled: false\n    inactive: false\n");
		}
		return text.ToString();
	}
}
