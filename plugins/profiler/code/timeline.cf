include "timeline.ch"
include "analysis.ch"
include "locks.ch"

namespace Profiler
{
	const int32 kMostGcBands = 500;
	const int32 kFramesPerPixelShown = 3;
	const int64 kPixelsPerRename = 4;
	const int32 kMostLockRows = 12;

	// What every lane of one answer shares.
	class TimelineWriter
	{
		public const Capture* capture;
		public IED::JsonWriter* json;
		public NameTable names;
		public Range range;
		public int64 pixel;        // ticks one pixel covers, at least 1
		public int32 mostDepth;
		public Core::HashMap<uint64, LockWaits*> waitsOf;

		public int64 Ns(int64 ticks) const { return capture->clock.Ns(ticks); }
	}

	// --- Zones of one depth -----------------------------------------------------------------------------------------

	static void WriteZone(TimelineWriter& w, const ThreadTrack* track, int64 trackIndex, const ZoneLevel* level, int64 depth, int64 shownDepth, int64 i) {
		IED::JsonWriter& json = *w.json;
		json.BeginArray();
		json.Int(shownDepth);
		json.Int(w.Ns(level->starts[i]));
		json.Int(w.Ns(level->EndOr(i, w.capture->lastTicks)));
		json.Int(w.names.Index(w.capture->ZoneName(track, level, i)));
		json.String(ZoneRef::Of(trackIndex, depth, i).Text().View());
		json.EndArray();
	}

	static void WriteMerged(TimelineWriter& w, const ZoneLevel* level, int64 shownDepth, int64 first, int64 last) {
		IED::JsonWriter& json = *w.json;
		json.BeginArray();
		json.Int(shownDepth);
		json.Int(w.Ns(level->starts[first]));
		json.Int(w.Ns(level->EndOr(last, w.capture->lastTicks)));
		json.Int(-1);
		json.Int(last - first + 1);
		json.EndArray();
	}

	// The zones of one depth that start in [from, to) - or, with `overlapping`, that overlap the range - with zones
	// narrower than a pixel merged into runs.
	static void WriteLevel(TimelineWriter& w, const ThreadTrack* track, int64 trackIndex, int64 depth, int64 shownDepth, int64 from, int64 to, bool overlapping) {
		const ZoneLevel* level = track->levels[depth];
		const int64 now = w.capture->lastTicks;
		const int64 stop = level->FirstStartingAt(to);
		int64 i = overlapping ? level->FirstEndingAfter(from) : level->FirstStartingAt(from);
		while (i < stop) {
			const int64 start = level->starts[i];
			if (level->EndOr(i, now) - start >= w.pixel) {
				WriteZone(w, track, trackIndex, level, depth, shownDepth, i);
				i += 1;
				continue;
			}
			int64 next = level->FirstStartingAt(start + w.pixel);
			if (next > stop) next = stop;
			if (next <= i) next = i + 1;
			int64 last = next - 1;
			if (last > i && level->EndOr(last, now) - level->starts[last] >= w.pixel) last -= 1;
			if (last == i) WriteZone(w, track, trackIndex, level, depth, shownDepth, i);
			else WriteMerged(w, level, shownDepth, i, last);
			i = last + 1;
		}
	}

	// --- Lock rows of a thread lane -----------------------------------------------------------------------------------

	// One lock row's segments as written: [start, end, state, hold index] - a wait (blocked) and the hold after it - or
	// a run of segments narrower than a pixel merged as [start, end, its worst state, -count].
	class LockRowWriter
	{
		public TimelineWriter* w;
		public int64 start;
		public int64 end;
		public int32 state;
		public int64 index;
		public int64 count;

		public void Add(int64 from, int64 to, LockState kind, int64 hold) {
			if (to - from >= w->pixel) {
				Flush();
				Write(from, to, (int32)kind, hold);
				return;
			}
			if (count > 0 && from - end < w->pixel && end - start < w->pixel) {
				if (to > end) end = to;
				if ((int32)kind > state) state = (int32)kind;
				count += 1;
				return;
			}
			Flush();
			start = from;
			end = to;
			state = (int32)kind;
			index = hold;
			count = 1;
		}

		public void Flush() {
			if (count == 0) return;
			Write(start, end, state, count == 1 ? index : -count);
			count = 0;
		}

		private void Write(int64 from, int64 to, int32 kind, int64 ref) {
			IED::JsonWriter& json = *w->json;
			json.BeginArray();
			json.Int(w->Ns(from));
			json.Int(w->Ns(to));
			json.Int((int64)kind);
			json.Int(ref);
			json.EndArray();
		}
	}

	static LockWaits* WaitsOf(TimelineWriter& w, const LockInfo* lock) {
		LockWaits* waits = nullptr;
		if (w.waitsOf.TryGet(lock->id, waits)) return waits;
		waits = new LockWaits();
		waits->Build(*w.capture, lock, w.range);
		w.waitsOf.Insert(lock->id, waits);
		return waits;
	}

	static void WriteLockRow(TimelineWriter& w, const LockInfo* lock, const LockTrack* holder) {
		IED::JsonWriter& json = *w.json;
		const int64 now = w.capture->lastTicks;
		const LockWaits* waits = WaitsOf(w, lock);
		json.BeginObject();
		json.IntField("lock", (int64)lock->id);
		json.Field("name", LockName(*w.capture, lock).View());
		json.Key(Core::StringView("items"));
		json.BeginArray();
		LockRowWriter row;
		row.w = &w;
		for (int64 i = FirstReleasedAfter(holder, w.range.begin, now); i < holder->spans.Count(); ++i) {
			const LockSpan& span = holder->spans[i];
			if (span.wait >= w.range.end) break;
			if (span.obtain > span.wait) row.Add(span.wait, span.obtain, LockState::Blocked, i);
			const bool contended = span.release != kOpen && waits->Covers(span.release);
			row.Add(span.obtain, ReleaseOr(span, now), contended ? LockState::Contended : LockState::Held, i);
		}
		if (holder->waitingSince >= 0 && holder->waitingSince < w.range.end) row.Add(holder->waitingSince, now, LockState::Blocked, holder->spans.Count());
		row.Flush();
		json.EndArray();
		json.EndObject();
	}

	// The locks a thread used, in the order they appeared, each a row under its zones (at most kMostLockRows, so a
	// thread's rows stay put as the view moves; "locksHidden" says how many more).
	static void WriteLockRows(TimelineWriter& w, int64 trackIndex) {
		IED::JsonWriter& json = *w.json;
		int64 hidden = 0;
		int32 written = 0;
		json.Key(Core::StringView("locks"));
		json.BeginArray();
		for (const LockInfo* lock : w.capture->lockList) {
			LockTrack* holder = nullptr;
			if (!lock->trackOf.TryGet((int32)trackIndex, holder)) continue;
			if (written >= kMostLockRows) hidden += 1;
			else {
				WriteLockRow(w, lock, holder);
				written += 1;
			}
		}
		json.EndArray();
		json.IntField("locksHidden", hidden);
	}

	// --- Thread lanes -------------------------------------------------------------------------------------------------

	// The renames in the range, unless there are more than a quarter of the pixels: then each would be a sliver, and
	// "renamesDense" says how many there were.
	static void WriteRenames(TimelineWriter& w, const ThreadTrack* track) {
		IED::JsonWriter& json = *w.json;
		const int64 first = track->nameTimes.UpperBound(w.range.begin);
		const int64 end = track->nameTimes.LowerBound(w.range.end);
		const bool dense = (end - first) * kPixelsPerRename > w.range.Length() / w.pixel;
		json.IntField("renamesInRange", end - first);
		json.Key(Core::StringView("renames"));
		json.BeginArray();
		for (int64 i = first; !dense && i < end; ++i) {
			json.BeginArray();
			json.Int(w.Ns(track->nameTimes[i]));
			json.String(w.capture->Text(track->nameStrs[i]));
			json.EndArray();
		}
		json.EndArray();
	}

	static void WriteThreadLane(TimelineWriter& w, int64 trackIndex) {
		const ThreadTrack* track = w.capture->tracks[trackIndex];
		IED::JsonWriter& json = *w.json;
		json.BeginObject();
		Core::StringBuilder id;
		id.Append("thread:");
		id.AppendInt(trackIndex);
		json.Field("id", id.View());
		json.Field("kind", "thread");
		json.Field("label", TrackLabel(*w.capture, track, w.range.begin).View());
		json.IntField("track", trackIndex);
		json.IntField("osId", (int64)track->osId);
		json.Field("group", w.capture->Text(track->groupStr));
		json.IntField("renamed", track->nameTimes.Count() > 1 ? track->nameTimes.Count() - 1 : 0);
		json.IntField("depth", track->levels.Count() < (int64)w.mostDepth ? track->levels.Count() : (int64)w.mostDepth);
		WriteRenames(w, track);
		json.Key(Core::StringView("zones"));
		json.BeginArray();
		for (int64 depth = 0; depth < track->levels.Count() && depth < (int64)w.mostDepth; ++depth) WriteLevel(w, track, trackIndex, depth, depth, w.range.begin, w.range.end, true);
		json.EndArray();
		WriteLockRows(w, trackIndex);
		json.EndObject();
	}

	// --- Task lanes ---------------------------------------------------------------------------------------------------

	// One interval in which a task ran on a thread, as a task lane shows it.
	struct Slice
	{
		public int64 start;
		public int64 end;
		public int32 track;
		public int32 row;
	}

	// The shallowest depth with a zone starting in [from, to): the task's own zones begin there.
	static int64 BaseDepth(const ThreadTrack* track, int64 from, int64 to) {
		for (int64 depth = 0; depth < track->levels.Count(); ++depth) {
			const ZoneLevel* level = track->levels[depth];
			const int64 i = level->FirstStartingAt(from);
			if (i < level->Count() && level->starts[i] < to) return depth;
		}
		return -1;
	}

	// The deepest the task's zones go below their base in [from, to), plus one.
	static int64 DepthBelow(const ThreadTrack* track, int64 base, int64 from, int64 to) {
		int64 depth = base;
		while (depth < track->levels.Count()) {
			const ZoneLevel* level = track->levels[depth];
			const int64 i = level->FirstStartingAt(from);
			if (i >= level->Count() || level->starts[i] >= to) break;
			depth += 1;
		}
		return depth - base;
	}

	// Rows for slices that overlap: each slice takes the first row free at its start.
	static int32 AssignRows(Core::Array<Slice>& slices) {
		slices.SortBy([](const Slice& a, const Slice& b) -> bool { return a.start < b.start; });
		Core::Array<int64> rowEnds;
		for (Slice& slice : slices) {
			int32 row = 0;
			while ((int64)row < rowEnds.Count() && rowEnds[row] > slice.start) row += 1;
			if ((int64)row == rowEnds.Count()) rowEnds.Push(slice.end);
			else rowEnds[row] = slice.end;
			slice.row = row;
		}
		return (int32)rowEnds.Count();
	}

	static void WriteTaskZones(TimelineWriter& w, const Slice& slice, int64 rowDepth) {
		const ThreadTrack* track = w.capture->tracks[slice.track];
		const int64 from = slice.start > w.range.begin ? slice.start : w.range.begin;
		const int64 to = slice.end < w.range.end ? slice.end : w.range.end;
		const int64 base = BaseDepth(track, slice.start, slice.end);
		if (base < 0) return;
		for (int64 depth = base; depth < track->levels.Count() && depth - base < rowDepth; ++depth)
			WriteLevel(w, track, slice.track, depth, (int64)slice.row * rowDepth + depth - base, from, to, false);
	}

	static void WriteSliceLane(TimelineWriter& w, Core::StringView id, Core::StringView label, int64 runs, Core::Array<Slice>& slices) {
		IED::JsonWriter& json = *w.json;
		const int32 rows = AssignRows(slices);
		int64 rowDepth = 1;
		Core::HashSet<int32> threads;
		for (const Slice& slice : slices) {
			threads.Add(slice.track);
			const ThreadTrack* track = w.capture->tracks[slice.track];
			const int64 base = BaseDepth(track, slice.start, slice.end);
			const int64 below = base < 0 ? 0 : DepthBelow(track, base, slice.start, slice.end);
			if (below > rowDepth) rowDepth = below;
		}
		if (rowDepth > (int64)w.mostDepth) rowDepth = w.mostDepth;
		json.BeginObject();
		json.Field("id", id);
		json.Field("kind", "task");
		json.Field("label", label);
		json.IntField("runs", runs);
		json.IntField("threads", threads.Count());
		json.IntField("rows", rows);
		json.IntField("rowDepth", rowDepth);
		json.IntField("depth", (int64)(rows < 1 ? 1 : rows) * rowDepth);
		json.Key(Core::StringView("slices"));
		json.BeginArray();
		for (const Slice& slice : slices) {
			json.BeginArray();
			json.Int(w.Ns(slice.start));
			json.Int(w.Ns(slice.end));
			json.Int(slice.track);
			json.Int(slice.row);
			json.EndArray();
		}
		json.EndArray();
		json.Key(Core::StringView("zones"));
		json.BeginArray();
		for (const Slice& slice : slices) WriteTaskZones(w, slice, rowDepth);
		json.EndArray();
		json.EndObject();
	}

	static void SlicesOf(const TimelineWriter& w, const TaskLane* lane, Core::Array<Slice>& slices) {
		for (const TaskRuns* runs : lane->runs) {
			int64 i = runs->starts.UpperBound(w.range.begin);
			while (i > 0 && (runs->ends[i - 1] == kOpen || runs->ends[i - 1] > w.range.begin)) i -= 1;
			for (; i < runs->starts.Count() && runs->starts[i] < w.range.end; ++i) {
				Slice slice;
				slice.start = runs->starts[i];
				slice.end = runs->ends[i] == kOpen ? w.capture->lastTicks : runs->ends[i];
				slice.track = runs->track;
				if (slice.end > w.range.begin) slices.Push(slice);
			}
		}
	}

	// The by-task fallback for captures without task events: a renamed thread's segments, grouped by name.
	static void RenamedSegments(const TimelineWriter& w, Core::HashMap<Core::String, Core::Array<Slice>*>& byName, Core::Array<Core::String>& order) {
		for (int64 t = 0; t < w.capture->tracks.Count(); ++t) {
			const ThreadTrack* track = w.capture->tracks[t];
			if (track->nameTimes.Count() < 2) continue;
			for (int64 i = 0; i < track->nameTimes.Count(); ++i) {
				Slice slice;
				slice.start = track->nameTimes[i];
				slice.end = i + 1 < track->nameTimes.Count() ? track->nameTimes[i + 1] : w.capture->lastTicks;
				slice.track = (int32)t;
				if (!w.range.Overlaps(slice.start, slice.end)) continue;
				Core::String name = Core::String(w.capture->Text(track->nameStrs[i]));
				Core::Array<Slice>** found = byName.Find(name);
				if (!found) {
					byName.Insert(name, new Core::Array<Slice>());
					order.Push(name);
					found = byName.Find(name);
				}
				(*found)->Push(slice);
			}
		}
	}

	static bool RanTasks(const Capture& capture, int64 trackIndex) {
		for (const TaskLane* lane : capture.taskLanes)
			if (lane->runsOf.Find((int32)trackIndex)) return true;
		return false;
	}

	static void WriteTaskModeLanes(TimelineWriter& w) {
		const Capture& capture = *w.capture;
		const bool fromRenames = capture.taskLanes.IsEmpty();
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const bool replaced = fromRenames ? capture.tracks[t]->nameTimes.Count() > 1 : RanTasks(capture, t);
			if (!replaced && capture.tracks[t]->zones > 0) WriteThreadLane(w, t);
		}
		if (!fromRenames) {
			for (const TaskLane* lane : capture.taskLanes) {
				Core::Array<Slice> slices;
				SlicesOf(w, lane, slices);
				Core::String id = Core::String("task:") + capture.Text(lane->nameStr);
				WriteSliceLane(w, id.View(), capture.Text(lane->nameStr), lane->count, slices);
			}
			return;
		}
		Core::HashMap<Core::String, Core::Array<Slice>*> byName;
		Core::Array<Core::String> order;
		RenamedSegments(w, byName, order);
		for (const Core::String& name : order) {
			Core::Array<Slice>* slices = *byName.Find(name);
			Core::String id = Core::String("task:") + name.View();
			WriteSliceLane(w, id.View(), name.View(), slices->Count(), *slices);
		}
	}

	// --- GPU, frames, collections, messages, plots --------------------------------------------------------------------

	static void WriteGpuLanes(TimelineWriter& w) {
		IED::JsonWriter& json = *w.json;
		json.Key(Core::StringView("gpu"));
		json.BeginArray();
		for (const GpuContext* gpu : w.capture->gpus) {
			json.BeginObject();
			Core::StringBuilder id;
			id.Append("gpu:");
			id.AppendUInt(gpu->id);
			json.Field("id", id.View());
			Core::StringView name = w.capture->Text(gpu->nameStr);
			json.Field("label", name.IsEmpty() ? Core::StringView("GPU") : name);
			int64 depth = 0;
			json.Key(Core::StringView("zones"));
			json.BeginArray();
			for (const GpuZone& zone : gpu->zones) {
				int64 cpuBegin;
				int64 cpuEnd;
				if (!gpu->Span(zone, w.capture->clock, w.capture->clockFreqHz, cpuBegin, cpuEnd)) continue;
				if (!w.range.Overlaps(cpuBegin, cpuEnd)) continue;
				if ((int64)zone.depth + 1 > depth) depth = (int64)zone.depth + 1;
				json.BeginArray();
				json.Int(zone.depth);
				json.Int(w.Ns(cpuBegin));
				json.Int(w.Ns(cpuEnd));
				json.Int(w.names.Index(w.capture->SiteName((uint64)zone.site)));
				json.Int(w.Ns(zone.cpuBegin));
				json.EndArray();
			}
			json.EndArray();
			json.IntField("depth", depth < 1 ? 1 : depth);
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteFrames(TimelineWriter& w) {
		IED::JsonWriter& json = *w.json;
		json.Key(Core::StringView("frames"));
		const FrameSet* set = MainFrameSet(*w.capture);
		if (!set) {
			json.Null();
			return;
		}
		int64 first = set->starts.UpperBound(w.range.begin);
		if (first > 0) first -= 1;
		const int64 last = set->starts.LowerBound(w.range.end);
		json.BeginObject();
		json.Field("set", w.capture->Text(set->nameStr).IsEmpty() ? Core::StringView("Frame") : w.capture->Text(set->nameStr));
		const bool dense = (last - first) * kFramesPerPixelShown > w.range.Length() / w.pixel;
		json.BoolField("dense", dense);
		json.Key(Core::StringView("items"));
		json.BeginArray();
		if (!dense) {
			for (int64 i = first; i < last; ++i) {
				if (set->ends[i] == kOpen) continue;
				json.BeginArray();
				json.Int(i);
				json.Int(w.Ns(set->starts[i]));
				json.Int(w.Ns(set->ends[i]));
				json.EndArray();
			}
		}
		json.EndArray();
		json.EndObject();
	}

	static void WriteCollections(TimelineWriter& w) {
		IED::JsonWriter& json = *w.json;
		json.Key(Core::StringView("gc"));
		json.BeginArray();
		int32 written = 0;
		for (const GcRecord& gc : w.capture->gcs) {
			const int64 end = gc.end == kOpen ? w.capture->lastTicks : gc.end;
			if (!w.range.Overlaps(gc.begin, end + 1) || written >= kMostGcBands) continue;
			json.BeginArray();
			json.Int(w.Ns(gc.begin));
			json.Int(w.Ns(end));
			json.Int(gc.kind);
			json.Int(gc.generation);
			json.Int(gc.Freed());
			json.EndArray();
			written += 1;
		}
		json.EndArray();
	}

	static int64 FirstMessageAt(const Capture& capture, int64 t) {
		int64 low = 0;
		int64 high = capture.messages.Count();
		while (low < high) {
			const int64 mid = (low + high) / 2;
			if (capture.messages[mid].t < t) low = mid + 1;
			else high = mid;
		}
		return low;
	}

	static void WriteMessages(TimelineWriter& w, int32 most) {
		IED::JsonWriter& json = *w.json;
		const int64 first = FirstMessageAt(*w.capture, w.range.begin);
		const int64 end = FirstMessageAt(*w.capture, w.range.end);
		json.IntField("messagesInRange", end - first);
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		for (int64 i = first; i < end && i - first < (int64)most; ++i) {
			const MessageRecord& message = w.capture->messages[i];
			json.BeginArray();
			json.Int(w.Ns(message.t));
			json.Int(message.severity);
			json.String(w.capture->Text(message.textStr));
			json.Int(message.track);
			json.EndArray();
		}
		json.EndArray();
	}

	static void WritePoint(IED::JsonWriter& json, int64 ns, double low, double high) {
		json.BeginArray();
		json.Int(ns);
		WriteNumber(json, low, -1);
		WriteNumber(json, high, -1);
		json.EndArray();
	}

	// A plot's values in the range, as [time, lowest, highest] per pixel when there are more than the pixels hold; one
	// value on each side of the range keeps the line running to the edges.
	static void WritePlotPoints(TimelineWriter& w, const Core::Array<int64>& times, const Core::Array<double>& values) {
		IED::JsonWriter& json = *w.json;
		int64 first = times.LowerBound(w.range.begin);
		if (first > 0) first -= 1;
		int64 end = times.LowerBound(w.range.end);
		if (end < times.Count()) end += 1;
		json.BeginArray();
		int64 i = first;
		while (i < end) {
			const int64 bucketEnd = times[i] - (times[i] - w.range.begin) % w.pixel + w.pixel;
			double low = values[i];
			double high = values[i];
			const int64 t = times[i];
			i += 1;
			while (i < end && times[i] < bucketEnd && times[i] >= w.range.begin && times[i] < w.range.end) {
				if (values[i] < low) low = values[i];
				if (values[i] > high) high = values[i];
				i += 1;
			}
			WritePoint(json, w.Ns(t), low, high);
		}
		json.EndArray();
	}

	static void WritePlots(TimelineWriter& w) {
		IED::JsonWriter& json = *w.json;
		json.Key(Core::StringView("plots"));
		json.BeginArray();
		for (const Plot* plot : w.capture->plots) {
			json.BeginObject();
			json.IntField("id", (int64)plot->id);
			json.Field("name", w.capture->Text(plot->nameStr));
			json.IntField("kind", (int64)plot->kind);
			json.Key(Core::StringView("points"));
			WritePlotPoints(w, plot->times, plot->values);
			json.EndObject();
		}
		for (const Pool* pool : w.capture->pools) {
			if (pool->times.IsEmpty()) continue;
			Core::Array<double> bytes;
			for (int64 value : pool->bytes) bytes.Push((double)value);
			json.BeginObject();
			Core::StringBuilder id;
			id.Append("pool:");
			id.AppendUInt(pool->id);
			json.Field("id", id.View());
			Core::String name = Core::String("Memory: ") + (w.capture->Text(pool->nameStr).IsEmpty() ? Core::StringView("heap") : w.capture->Text(pool->nameStr));
			json.Field("name", name.View());
			json.IntField("kind", 1);
			json.Key(Core::StringView("points"));
			WritePlotPoints(w, pool->times, bytes);
			json.EndObject();
		}
		json.EndArray();
	}

	// --- The answer ---------------------------------------------------------------------------------------------------

	Core::String Timeline(const Capture& capture, const TimelineAsk& ask) {
		IED::JsonWriter json;
		TimelineWriter w;
		w.capture = &capture;
		w.json = &json;
		w.range = RangeOfNs(capture, ask.fromNs, ask.toNs);
		w.pixel = w.range.Length() / (int64)(ask.width < 1 ? 1 : ask.width);
		if (w.pixel < 1) w.pixel = 1;
		w.mostDepth = ask.mostDepth < 1 ? 1 : (ask.mostDepth > kMostDepth + 1 ? kMostDepth + 1 : ask.mostDepth);
		json.BeginObject();
		json.IntField("from", capture.clock.Ns(w.range.begin));
		json.IntField("to", capture.clock.Ns(w.range.end));
		json.IntField("durationNs", capture.DurationNs());
		json.BoolField("live", !capture.ended);
		json.IntField("pixelNs", capture.clock.Ns(w.pixel));
		json.Key(Core::StringView("lanes"));
		json.BeginArray();
		if (ask.mode == LaneMode::Tasks) WriteTaskModeLanes(w);
		else
			for (int64 t = 0; t < capture.tracks.Count(); ++t)
				if (capture.tracks[t]->zones > 0 || capture.tracks[t]->nameTimes.Count() > 0) WriteThreadLane(w, t);
		json.EndArray();
		WriteGpuLanes(w);
		WriteFrames(w);
		WriteCollections(w);
		WriteMessages(w, ask.mostMessages);
		WritePlots(w);
		json.Key(Core::StringView("names"));
		w.names.Write(json);
		json.EndObject();
		return json.ToString();
	}
}
