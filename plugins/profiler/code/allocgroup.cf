// Telling allocations apart (T-PRF-5, T-PRF-13): live clients send no call stacks with their allocations, so an
// allocation is placed by the zone its thread was in when it allocated - the innermost one, or the path down to it.
include "analysis.ch"

namespace Profiler
{
	const int32 kSizeClasses = 8;

	bool InnermostZoneAt(const Capture& capture, int32 track, int64 t, int64& depth, int64& index) {
		if (track < 0 || (int64)track >= capture.tracks.Count()) return false;
		const ThreadTrack* thread = capture.tracks[(int64)track];
		bool found = false;
		for (int64 d = 0; d < thread->levels.Count(); ++d) {
			const ZoneLevel* level = thread->levels[d];
			const int64 i = level->FirstEndingAfter(t);
			if (i >= level->Count() || level->starts[i] > t) break;
			depth = d;
			index = i;
			found = true;
		}
		return found;
	}

	int64 FrameAt(const FrameSet* set, int64 t) {
		if (!set) return -1;
		const int64 i = set->starts.UpperBound(t) - 1;
		if (i < 0 || (set->ends[i] != kOpen && set->ends[i] <= t)) return -1;
		return i;
	}

	bool AllocationsHaveCallstacks(const Capture& capture) {
		for (const Allocation& allocation : capture.allocations)
			if (allocation.callstack != 0) return true;
		return false;
	}

	bool AllocGroupNamed(Core::StringView name, AllocGroup& out) {
		if (name == "zone") out = AllocGroup::Zone;
		else if (name == "path") out = AllocGroup::Path;
		else if (name == "thread") out = AllocGroup::Thread;
		else if (name == "pool") out = AllocGroup::Pool;
		else if (name == "size") out = AllocGroup::Size;
		else if (name == "callstack") out = AllocGroup::Callstack;
		else return false;
		return true;
	}

	AllocGroup DefaultAllocGroup(const Capture& capture) {
		return AllocationsHaveCallstacks(capture) ? AllocGroup::Callstack : AllocGroup::Zone;
	}

	static int64 SizeClass(int64 size) {
		const int64[7] bounds = { 16, 64, 256, 1024, 4096, 65536, 1048576 };
		for (int64 i = 0; i < kSizeClasses - 1; ++i)
			if (size <= bounds[i]) return i;
		return kSizeClasses - 1;
	}

	static const char* SizeLabel(int64 sizeClass) {
		const char*[8] labels = { "1-16 B", "17-64 B", "65-256 B", "257 B-1 KiB", "1-4 KiB", "4-64 KiB", "64 KiB-1 MiB", "over 1 MiB" };
		return labels[sizeClass];
	}

	void AllocGrouper::Init(const Capture& of, AllocGroup groupBy) {
		capture = &of;
		by = groupBy;
	}

	uint64 AllocGrouper::KeyOf(const Allocation& allocation) {
		if (by == AllocGroup::Thread) return (uint64)allocation.track;
		if (by == AllocGroup::Pool) return allocation.pool;
		if (by == AllocGroup::Size) return (uint64)SizeClass(allocation.size);
		if (by == AllocGroup::Callstack) return allocation.callstack;
		int64 depth;
		int64 index;
		if (!InnermostZoneAt(*capture, allocation.track, allocation.t, depth, index)) return 0;
		return KeyOfZone((int64)allocation.track, depth, index);
	}

	uint64 AllocGrouper::KeyOfZone(int64 trackIndex, int64 depth, int64 index) {
		const ThreadTrack* track = capture->tracks[trackIndex];
		if (by == AllocGroup::Thread) return (uint64)trackIndex;
		if (by != AllocGroup::Path) return (uint64)track->levels[depth]->sites[index];
		const int64 at = track->levels[depth]->starts[index];
		Core::StringBuilder path;
		for (int64 d = 0; d <= depth; ++d) {
			const ZoneLevel* level = track->levels[d];
			const int64 i = d == depth ? index : level->FirstEndingAfter(at);
			if (d > 0) path.Append(" > ");
			path.Append(capture->SiteName((uint64)level->sites[i]));
		}
		Core::String text = path.ToString();
		uint64 id;
		if (pathIds.TryGet(text, id)) return id;
		paths.Push(text);
		pathSites.Push((uint64)track->levels[depth]->sites[index]);
		id = (uint64)paths.Count();
		pathIds.Insert(text, id);
		return id;
	}

	void AllocGrouper::WriteLabel(IED::JsonWriter& json, uint64 key, uint64 callstack) const {
		if (by == AllocGroup::Thread) json.Field("label", TrackLabel(*capture, capture->tracks[(int64)key], capture->lastTicks).View());
		else if (by == AllocGroup::Pool) {
			Pool* pool = nullptr;
			capture->poolOf.TryGet(key, pool);
			Core::StringView name = pool ? capture->Text(pool->nameStr) : Core::StringView("");
			json.Field("label", name.IsEmpty() ? Core::StringView("heap") : name);
		}
		else if (by == AllocGroup::Size) json.Field("label", SizeLabel((int64)key));
		else if (by == AllocGroup::Zone || by == AllocGroup::Path) {
			const uint64 site = by == AllocGroup::Path ? (key == 0 ? 0 : pathSites[(int64)key - 1]) : key;
			if (by == AllocGroup::Path) json.Field("label", key == 0 ? Core::StringView("(outside any zone)") : paths[(int64)key - 1].View());
			else json.Field("label", key == 0 ? Core::StringView("(outside any zone)") : capture->SiteName(key));
			const SrcLoc* loc = site == 0 ? nullptr : capture->srclocs.Find(site);
			json.Field("file", loc ? capture->Text(loc->fileStr) : Core::StringView(""));
			json.IntField("line", loc ? (int64)loc->line : 0);
		}
		else json.Field("label", callstack == 0 ? Core::StringView("(no call stack)") : Core::StringView("call stack"));
		json.Key(Core::StringView("callstack"));
		WriteCallstack(json, *capture, by == AllocGroup::Callstack ? callstack : 0);
	}
}
