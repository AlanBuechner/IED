include "service.ch"
include "analysis.ch"
include "api/tasks.ch"

namespace Profiler
{
	const int32 kAcceptWaitMs = 500;
	const int32 kReceiveWaitMs = 500;
	const int64 kHelloWaitNs = 10000000000;
	const int64 kReceiveBytes = 65536;
	const int32 kTokenBytes = 16;
	const char* kConnectVariable = "profiler.connect";

	static Core::String StatusJson(const CaptureEntry* entry, const Capture& capture);

	void ProfilerPlugin::Init(IED::PluginContext* context) {
		this.context = context;
	}

	static Core::String Hex(const uint8* bytes, int64 count) {
		Core::StringBuilder text;
		for (int64 i = 0; i < count; ++i) text.AppendUIntBase((uint64)bytes[i], 16, 2);
		return text.ToString();
	}

	static Core::String NewToken() {
		uint8[16] bytes;
		Platform::RandomBytes((void*)&bytes[0], kTokenBytes);
		return Hex(&bytes[0], kTokenBytes);
	}

	Core::String CaptureIdFor(Core::StringView wsId, Core::StringView relativePath) {
		Core::StringBuilder id;
		id.Append(wsId);
		id.AppendByte(':');
		id.AppendUIntBase(Core::String(relativePath).Hash(), 16, 16);
		return id.ToString();
	}

	Core::String CaptureFileName(Core::StringView app, int64 unixNs) {
		Core::StringBuilder name;
		for (int64 i = 0; i < app.ByteLength() && name.ByteLength() < 48; ++i) {
			const char c = app.Data()[i];
			const bool plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.';
			name.AppendByte(plain ? (int32)c : (int32)'_');
		}
		if (name.ByteLength() == 0) name.Append("capture");
		const Platform::CalendarTime at = Platform::LocalCalendar(unixNs);
		name.AppendByte('-');
		name.AppendIntBase(at.year, 10, 4);
		name.AppendIntBase(at.month, 10, 2);
		name.AppendIntBase(at.day, 10, 2);
		name.AppendByte('-');
		name.AppendIntBase(at.hour, 10, 2);
		name.AppendIntBase(at.minute, 10, 2);
		name.AppendIntBase(at.second, 10, 2);
		name.Append(kTraceExtension);
		return name.ToString();
	}

	// --- Workspaces and the library ---------------------------------------------------------------------------------

	ProfWorkspace* ProfilerPlugin::Workspace(Core::StringView wsId) const {
		ProfWorkspace* ws = nullptr;
		workspaces.TryGet(Core::String(wsId), ws);
		return ws;
	}

	ProfWorkspace* ProfilerPlugin::WorkspaceOfToken(Core::StringView token) const {
		if (token.IsEmpty()) return nullptr;
		for (const Core::KeyValue<Core::String, ProfWorkspace*>& entry : workspaces)
			if (entry.value->token.View() == token) return entry.value;
		return nullptr;
	}

	CaptureEntry* ProfilerPlugin::Entry(Core::StringView captureId) const {
		CaptureEntry* entry = nullptr;
		captures.TryGet(Core::String(captureId), entry);
		return entry;
	}

	CaptureEntry* ProfilerPlugin::EntryForPath(ProfWorkspace* ws, Core::StringView absolutePath) {
		Core::String relative;
		Core::String kept;
		if (IED::RelativeTo(ws->workspace.localState.View(), absolutePath, kept)) relative = Core::String(".ied/local/") + kept.View();
		else if (!IED::RelativeTo(ws->workspace.root.View(), absolutePath, relative)) relative = Core::String(absolutePath);
		relative = IED::NormalizePath(relative.View());
		Core::String id = CaptureIdFor(ws->wsId.View(), relative.View());
		CaptureEntry* entry = Entry(id.View());
		if (entry) return entry;
		entry = new CaptureEntry();
		entry->id = id;
		entry->wsId = ws->wsId;
		entry->path = Core::String(absolutePath);
		entry->relative = relative;
		captures.Insert(id, entry);
		return entry;
	}

	static bool InLibrary(const ProfWorkspace* ws, const CaptureEntry* entry) {
		return entry->wsId.View() == ws->wsId.View() && entry->relative.View().StartsWith(Core::StringView(kCapturesFolder));
	}

	void ProfilerPlugin::Rescan(ProfWorkspace* ws) {
		FS::Path folder = ws->Captures();
		Core::HashSet<Core::String> present;
		for (FS::DirectoryEntry& file : FS::Directory(folder.CStr())) {
			if (file.kind != FS::EntryKind::File || !file.name.View().EndsWith(Core::StringView(kTraceExtension))) continue;
			FS::Path path = folder / file.name.View();
			CaptureEntry* entry = EntryForPath(ws, path.View());
			present.Add(entry->id);
			FS::FileInfo info;
			if (entry->live || !FS::GetInfo(path.CStr(), info)) continue;
			if (info.size == entry->sizeBytes && info.modifiedNs == entry->modifiedNs) continue;
			entry->sizeBytes = info.size;
			entry->modifiedNs = info.modifiedNs;
			TraceLayout layout;
			Core::String problem;
			entry->metadata = ReadLayout(path.CStr(), layout, problem) ? layout.metadata : Core::String();
		}
		Core::Array<Core::String> gone;
		for (const Core::KeyValue<Core::String, CaptureEntry*>& entry : captures)
			if (InLibrary(ws, entry.value) && !entry.value->live && !present.Contains(entry.key)) gone.Push(entry.key);
		for (const Core::String& id : gone) captures.Remove(id);
	}

	static void WriteEntry(IED::JsonWriter& json, const CaptureEntry* entry) {
		json.BeginObject();
		json.Field("captureId", entry->id.View());
		json.Field("path", entry->relative.View());
		FS::Path path = FS::Path(entry->path.View());
		json.Field("name", path.FileName());
		json.BoolField("live", entry->live);
		json.BoolField("loaded", entry->capture != nullptr);
		json.Field("app", entry->live && entry->capture ? entry->capture->appName.View() : Core::StringView(""));
		json.IntField("sizeBytes", entry->sizeBytes);
		json.IntField("modifiedNs", entry->modifiedNs);
		json.RawField("metadata", entry->metadata.IsEmpty() ? Core::StringView("null") : entry->metadata.View());
		json.EndObject();
	}

	Core::String ProfilerPlugin::LibraryJson(ProfWorkspace* ws) {
		Core::Array<CaptureEntry*> list;
		for (const Core::KeyValue<Core::String, CaptureEntry*>& entry : captures)
			if (entry.value->wsId.View() == ws->wsId.View()) list.Push(entry.value);
		list.SortBy([](CaptureEntry* a, CaptureEntry* b) -> bool { return a->live != b->live ? a->live : a->modifiedNs > b->modifiedNs; });
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("captures"));
		json.BeginArray();
		for (const CaptureEntry* entry : list) WriteEntry(json, entry);
		json.EndArray();
		json.Key(Core::StringView("connect"));
		json.BeginObject();
		json.IntField("port", port);
		json.Field("env", ConnectEnvironment(ws).View());
		json.Field("folder", kCapturesFolder);
		json.EndObject();
		json.EndObject();
		return json.ToString();
	}

	Core::String ProfilerPlugin::ConnectEnvironment(const ProfWorkspace* ws) const {
		Core::StringBuilder text;
		text.Append("127.0.0.1:");
		text.AppendInt(port);
		text.Append(";token=");
		text.Append(ws->token.View());
		return text.ToString();
	}

	void ProfilerPlugin::PublishLibrary(ProfWorkspace* ws) {
		Core::String library = LibraryJson(ws);
		Core::String topic = Core::String("profs:") + ws->wsId.View();
		context->Topic(topic.View(), library.View());
		context->Publish(topic.View(), "captures.changed", library.View());
	}

	void ProfilerPlugin::Opened(const IED::Workspace& ws) {
		Threading::LockGuard guard(lock);
		if (Workspace(ws.id.View())) return;
		ProfWorkspace* p = new ProfWorkspace();
		p->wsId = ws.id;
		p->workspace = ws;
		p->token = NewToken();
		workspaces.Insert(ws.id, p);
		Rescan(p);
		IED::SetTaskVariable(ws.id.View(), Core::StringView(kConnectVariable), ConnectEnvironment(p).View());
		PublishLibrary(p);
	}

	// --- Loading ------------------------------------------------------------------------------------------------------

	// The least recently used captures that are neither live nor the one just loaded go, beyond the most kept.
	static void Unload(ProfilerPlugin* profiler, CaptureEntry* keep) {
		Core::Array<CaptureEntry*> loaded;
		for (const Core::KeyValue<Core::String, CaptureEntry*>& entry : profiler->captures)
			if (entry.value->capture && !entry.value->live && entry.value != keep) loaded.Push(entry.value);
		loaded.SortBy([](CaptureEntry* a, CaptureEntry* b) -> bool { return a->lastUsed < b->lastUsed; });
		for (int64 i = 0; i + (int64)kMostLoadedCaptures <= loaded.Count(); ++i) loaded[i]->capture = nullptr;
	}

	Capture* ProfilerPlugin::Loaded(Core::StringView captureId) {
		Core::String path;
		{
			Threading::LockGuard guard(lock);
			CaptureEntry* entry = Entry(captureId);
			if (!entry) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no capture ") + captureId).View());
			clock += 1;
			entry->lastUsed = clock;
			if (entry->capture) return entry->capture;
			path = entry->path;
		}
		Capture* capture = new Capture();
		TraceLayout layout;
		Core::String problem;
		if (!LoadTraceFile(path.CStr(), *capture, layout, problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
		Threading::LockGuard guard(lock);
		CaptureEntry* entry = Entry(captureId);
		if (!entry) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no capture ") + captureId).View());
		if (!entry->capture) entry->capture = capture;
		Unload(this, entry);
		{
			Threading::LockGuard held(entry->capture->lock);
			context->Topic(entry->Topic().View(), StatusJson(entry, *entry->capture).View());
		}
		return entry->capture;
	}

	void ProfilerPlugin::ForgetCapture(Core::StringView captureId) {
		Threading::LockGuard guard(lock);
		CaptureEntry* entry = Entry(captureId);
		if (entry && !entry->live) entry->capture = nullptr;
	}

	// --- Connections --------------------------------------------------------------------------------------------------

	Core::String MetadataJson(const Capture& capture, Core::StringView ended) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("app", capture.appName.View());
		json.IntField("pid", (int64)capture.pid);
		json.IntField("startUnixNs", capture.startUnixNs);
		json.IntField("durationNs", capture.DurationNs());
		json.IntField("events", capture.events);
		json.IntField("zones", capture.ZoneCount());
		const FrameSet* frames = MainFrameSet(capture);
		json.IntField("frames", frames ? frames->Completed() : 0);
		json.IntField("warnings", capture.warningCount);
		json.Field("ended", ended);
		json.Key(Core::StringView("annotations"));
		json.BeginArray();
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	static Core::String StatusJson(const CaptureEntry* entry, const Capture& capture) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("captureId", entry->id.View());
		json.BoolField("live", entry->live);
		json.Field("app", capture.appName.View());
		json.IntField("durationNs", capture.DurationNs());
		json.IntField("events", capture.events);
		json.IntField("zones", capture.ZoneCount());
		json.IntField("bytes", capture.bytes);
		json.IntField("warnings", capture.warningCount);
		json.EndObject();
		return json.ToString();
	}

	// The token a stream's first chunk says hello with; false when the chunk is not a Hello.
	static bool HelloOf(const uint8* chunk, int64 length, Core::String& token, Core::String& app, int64& startUnixNs) {
		bool found = false;
		bool* seen = &found;
		Core::String* tokenOut = &token;
		Core::String* appOut = &app;
		int64* startOut = &startUnixNs;
		Core::String problem;
		DecodeChunk(chunk, length, [seen, tokenOut, appOut, startOut](const Event& event) {
			if (*seen || event.type != EventType::Hello) return;
			*seen = true;
			*appOut = Core::String(event.text);
			*tokenOut = Core::String(event.text2);
			*startOut = (int64)event.fields[4];
		}, problem);
		return found;
	}

	// Makes the capture's entry and trace file once its Hello names a workspace; null when it names none.
	static CaptureEntry* Begin(ProfilerPlugin* profiler, Net::TcpStream* stream, Capture* capture, Core::StringView token, Core::StringView app, int64 startUnixNs, TraceWriter& writer) {
		Threading::LockGuard guard(profiler->lock);
		ProfWorkspace* ws = profiler->WorkspaceOfToken(token);
		if (!ws) return nullptr;
		FS::Path folder = ws->Captures();
		FS::MakeDirectories(folder.CStr());
		const int64 when = startUnixNs > 0 ? startUnixNs : Platform::UnixTimeNs();
		FS::Path path = folder / CaptureFileName(app, when).View();
		for (int32 n = 2; FS::FileExists(path.CStr()); ++n) {
			Core::StringBuilder name;
			name.Append(path.Stem());
			name.AppendByte('_');
			name.AppendInt(n);
			name.Append(kTraceExtension);
			path = folder / name.View();
		}
		Core::String problem;
		if (!writer.Open(path.CStr(), problem)) {
			profiler->context->Log(problem.View());
			return nullptr;
		}
		CaptureEntry* entry = profiler->EntryForPath(ws, path.View());
		entry->capture = capture;
		entry->live = true;
		entry->connection = stream;
		entry->modifiedNs = when;
		profiler->context->Topic(entry->Topic().View(), StatusJson(entry, *capture).View());
		profiler->PublishLibrary(ws);
		return entry;
	}

	static void End(ProfilerPlugin* profiler, CaptureEntry* entry, Capture* capture, TraceWriter& writer, Core::StringView why) {
		Core::String metadata;
		{
			Threading::LockGuard held(capture->lock);
			Finish(*capture);
			metadata = MetadataJson(*capture, why);
		}
		Threading::LockGuard guard(profiler->lock);
		metadata = MetadataWith(metadata.View(), profiler->AnnotationsOf(entry));
		writer.Finish(metadata.View());
		entry->live = false;
		entry->connection = nullptr;
		entry->metadata = metadata;
		FS::FileInfo info;
		if (FS::GetInfo(entry->path.CStr(), info)) {
			entry->sizeBytes = info.size;
			entry->modifiedNs = info.modifiedNs;
		}
		Core::String status = StatusJson(entry, *capture);
		profiler->context->Topic(entry->Topic().View(), status.View());
		profiler->context->Publish(entry->Topic().View(), "ended", status.View());
		ProfWorkspace* ws = profiler->Workspace(entry->wsId.View());
		if (ws) profiler->PublishLibrary(ws);
	}

	static void ApplyWhole(Capture* capture, ChunkStream& chunks) {
		Threading::LockGuard held(capture->lock);
		const uint8* chunk;
		int64 length;
		while (chunks.Next(chunk, length)) ApplyChunk(*capture, chunk, length);
	}

	void ProfilerPlugin::Serve(Net::TcpStream* stream) {
		Capture* capture = new Capture();
		ChunkStream chunks;
		TraceWriter writer;
		CaptureEntry* entry = nullptr;
		Core::Array<uint8> early;
		Core::Array<uint8> block;
		block.Resize(kReceiveBytes);
		const int64 deadline = clock_now_ns() + kHelloWaitNs;
		Core::StringView why = Core::StringView("closed");
		while (!stopping) {
			const int64 got = stream->Receive((void*)block.Data(), kReceiveBytes, kReceiveWaitMs);
			if (got == Net::kTimedOut) {
				if (!entry && clock_now_ns() > deadline) break;
				continue;
			}
			if (got <= 0) break;
			if (entry) {
				writer.Append(block.Data(), got);
				chunks.Feed(block.Data(), got);
				ApplyWhole(capture, chunks);
				if (capture->ended) {
					why = Core::StringView("bye");
					break;
				}
				continue;
			}
			early.Append(block.Data(), got);
			chunks.Feed(block.Data(), got);
			const uint8* first;
			int64 length;
			if (!chunks.Next(first, length)) {
				if (!chunks.Problem().IsEmpty()) break;
				continue;
			}
			Core::String token;
			Core::String app;
			int64 startUnixNs = 0;
			if (!HelloOf(first, length, token, app, startUnixNs)) break;
			entry = Begin(this, stream, capture, token.View(), app.View(), startUnixNs, writer);
			if (!entry) break;
			writer.Append(early.Data(), early.Count());
			{
				Threading::LockGuard held(capture->lock);
				ApplyChunk(*capture, first, length);
			}
			ApplyWhole(capture, chunks);
			if (capture->ended) {
				why = Core::StringView("bye");
				break;
			}
		}
		if (stopping) why = Core::StringView("stopped");
		if (entry) End(this, entry, capture, writer, why);
		stream->Close();
	}

	// --- Threads ------------------------------------------------------------------------------------------------------

	static void AcceptLoop(ProfilerPlugin* profiler) {
		while (!profiler->stopping) {
			Net::TcpStream accepted = profiler->listener->Accept(kAcceptWaitMs);
			if (!accepted.IsOpen()) continue;
			Net::TcpStream* stream = new Net::TcpStream(take(accepted));
			profiler->context->StartThread([profiler, stream]() { profiler->Serve(stream); });
		}
	}

	// Publishes each live capture's progress a few times a second.
	static void Ticker(ProfilerPlugin* profiler) {
		while (!profiler->stopping) {
			Threading::Thread::Sleep(kTickerNs);
			Threading::LockGuard guard(profiler->lock);
			for (const Core::KeyValue<Core::String, CaptureEntry*>& item : profiler->captures) {
				CaptureEntry* entry = item.value;
				if (!entry->live || !entry->capture) continue;
				Core::String status;
				{
					Threading::LockGuard held(entry->capture->lock);
					if (entry->capture->events == entry->publishedEvents) continue;
					entry->publishedEvents = entry->capture->events;
					status = StatusJson(entry, *entry->capture);
				}
				profiler->context->Topic(entry->Topic().View(), status.View());
				profiler->context->Publish(entry->Topic().View(), "stats", status.View());
			}
		}
	}

	static int32 ConfiguredPort(IED::PluginContext* context) {
		Core::String text = context->Setting(Core::StringView("profiler.port"), Core::StringView(""));
		int64 value = 0;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const char c = text.View().Data()[i];
			if (c < '0' || c > '9') return 0;
			value = value * 10 + (int64)(c - '0');
		}
		return value > 65535 ? 0 : (int32)value;
	}

	void ProfilerPlugin::Start() {
		listener = new Net::TcpListener();
		if (!listener->Listen(Net::Address::Loopback(ConfiguredPort(context))) && !listener->Listen(Net::Address::Loopback(0))) {
			context->Log((Core::String("the profiler cannot listen: ") + listener->Error()).View());
			return;
		}
		port = listener->LocalAddress().port;
		ProfilerPlugin* self = this;
		context->StartThread([self]() { AcceptLoop(self); });
		context->StartThread([self]() { Ticker(self); });
	}

	void ProfilerPlugin::Stop() {
		Threading::LockGuard guard(lock);
		stopping = true;
		if (listener) listener->Close();
		for (const Core::KeyValue<Core::String, CaptureEntry*>& entry : captures)
			if (entry.value->connection) entry.value->connection->Shutdown(Net::Shutdown::Both);
	}
}
