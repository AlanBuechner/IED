// Memory and counters over time (T-PRF-14, T-PRF-20). A series - a pool's bytes in use, a plot - is read at evenly
// spaced points; its floor is the lowest it got in each step between them, which for a collected heap is about what
// stayed alive. A floor that keeps rising is memory the program keeps.
include "investigate.ch"

namespace Profiler
{
	const int32 kMostPoints = 100;
	const int32 kLongestCollections = 5;

	// A pool's or a plot's samples, read as numbers.
	struct SeriesView
	{
		public const Core::Array<int64>* times;
		public const Core::Array<int64>* whole;     // a pool's bytes
		public const Core::Array<double>* real;     // a plot's values

		public int64 Count() const { return times->Count(); }
		public double At(int64 i) const { return whole ? (double)(*whole)[i] : (*real)[i]; }
	}

	static SeriesView PoolSeries(const Pool* pool) {
		SeriesView view;
		view.times = &pool->times;
		view.whole = &pool->bytes;
		view.real = nullptr;
		return view;
	}

	static SeriesView PlotSeries(const Plot* plot) {
		SeriesView view;
		view.times = &plot->times;
		view.whole = nullptr;
		view.real = &plot->values;
		return view;
	}

	// The value at `t`: the last sample at or before it, else the first after it.
	static double ValueAt(const SeriesView& series, int64 t) {
		const int64 i = series.times->UpperBound(t) - 1;
		return series.At(i < 0 ? 0 : i);
	}

	static int32 PointsOf(int32 asked) {
		return asked < 2 ? 10 : (asked > kMostPoints ? kMostPoints : asked);
	}

	static int64 PointTime(Range range, int32 points, int32 k) {
		return range.begin + (range.Length() - 1) * (int64)k / (int64)points;
	}

	static void WriteSeries(IED::JsonWriter& json, const Capture& capture, const SeriesView& series, Range range, int32 points) {
		Core::Array<double> values;
		Core::Array<double> floors;
		for (int32 k = 0; k <= points; ++k) values.Push(ValueAt(series, PointTime(range, points, k)));
		double peak = values[0];
		int64 peakAt = range.begin;
		for (int32 k = 0; k < points; ++k) {
			const int64 begin = PointTime(range, points, k);
			const int64 end = PointTime(range, points, k + 1);
			double floor = values[k] < values[k + 1] ? values[k] : values[k + 1];
			const int64 stop = series.times->UpperBound(end);
			for (int64 i = series.times->LowerBound(begin); i < stop; ++i) {
				const double v = series.At(i);
				if (v < floor) floor = v;
				if (v > peak) {
					peak = v;
					peakAt = (*series.times)[i];
				}
			}
			floors.Push(floor);
		}
		int64 rises = 0;
		int64 floorRises = 0;
		int32 highest = 0;
		for (int32 k = 1; k < points; ++k)
			if (floors[k] > floors[highest]) highest = k;
		for (int32 k = 1; k <= points; ++k)
			if (values[k] > values[k - 1]) rises += 1;
		for (int32 k = 1; k < points; ++k)
			if (floors[k] > floors[k - 1]) floorRises += 1;
		const double seconds = (double)capture.clock.Ns(range.Length()) / 1e9;
		NumberField(json, "start", values[0], 1);
		NumberField(json, "end", values[points], 1);
		NumberField(json, "perSecond", seconds > 0.0 ? (values[points] - values[0]) / seconds : 0.0, 1);
		json.IntField("rises", rises);
		json.IntField("steps", points);
		NumberField(json, "peak", peak, 1);
		json.IntField("peakNs", capture.clock.Ns(peakAt));
		NumberField(json, "floorStart", floors[0], 1);
		NumberField(json, "floorEnd", floors[points - 1], 1);
		json.IntField("floorRises", floorRises);
		NumberField(json, "floorPeak", floors[highest], 1);
		json.IntField("floorPeakNs", capture.clock.Ns(PointTime(range, points, highest)));
		json.Key(Core::StringView("values"));
		json.BeginArray();
		for (int32 k = 0; k <= points; ++k) {
			json.BeginArray();
			json.Int(capture.clock.Ns(PointTime(range, points, k)));
			WriteNumber(json, values[k], 1);
			json.EndArray();
		}
		json.EndArray();
		json.Key(Core::StringView("floors"));
		json.BeginArray();
		for (double floor : floors) WriteNumber(json, floor, 1);
		json.EndArray();
	}

	static void WriteCollections(IED::JsonWriter& json, const Capture& capture, Range range) {
		Core::Array<int64> slow;
		int64 threshold;
		int64 median;
		const FrameSet* set = MainFrameSet(capture);
		SlowFrames(capture, set, -1, slow, threshold, median);
		Core::HashMap<int64, bool> isSlow;
		for (int64 f : slow) isSlow.Insert(f, true);
		Core::Array<int64> chosen;
		int64 pause = 0;
		int64 inSlow = 0;
		int64 afterCount = 0;
		int64 afterRises = 0;
		int64 firstAfter = 0;
		int64 lastAfter = 0;
		for (int64 i = 0; i < capture.gcs.Count(); ++i) {
			const GcRecord& gc = capture.gcs[i];
			if (gc.end == kOpen || !range.Overlaps(gc.begin, gc.end + 1)) continue;
			chosen.Push(i);
			pause += gc.end - gc.begin;
			if (isSlow.Contains(FrameAt(set, gc.begin))) inSlow += 1;
			if (gc.bytesAfter <= 0) continue;
			if (afterCount == 0) firstAfter = gc.bytesAfter;
			else if (gc.bytesAfter > lastAfter) afterRises += 1;
			lastAfter = gc.bytesAfter;
			afterCount += 1;
		}
		const double seconds = (double)capture.clock.Ns(range.Length()) / 1e9;
		json.Key(Core::StringView("gc"));
		json.BeginObject();
		json.IntField("count", chosen.Count());
		NumberField(json, "perSecond", seconds > 0.0 ? (double)chosen.Count() / seconds : 0.0, 2);
		json.IntField("pauseNs", capture.clock.Ns(pause));
		json.IntField("inSlowFrames", inSlow);
		json.Key(Core::StringView("heapAfter"));
		if (afterCount < 2) json.Null();
		else {
			json.BeginObject();
			json.IntField("count", afterCount);
			json.IntField("first", firstAfter);
			json.IntField("last", lastAfter);
			json.IntField("rises", afterRises);
			json.EndObject();
		}
		chosen.SortBy([&capture](const int64& a, const int64& b) -> bool { return capture.gcs[a].end - capture.gcs[a].begin > capture.gcs[b].end - capture.gcs[b].begin; });
		json.Key(Core::StringView("longest"));
		json.BeginArray();
		for (int64 k = 0; k < chosen.Count() && k < (int64)kLongestCollections; ++k) {
			const GcRecord& gc = capture.gcs[chosen[k]];
			const int64 frame = FrameAt(set, gc.begin);
			json.BeginObject();
			json.IntField("startNs", capture.clock.Ns(gc.begin));
			json.IntField("pauseNs", capture.clock.Ns(gc.end - gc.begin));
			json.IntField("generation", gc.generation);
			json.IntField("freedBytes", gc.Freed());
			json.IntField("frame", frame);
			json.BoolField("slowFrame", isSlow.Contains(frame));
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
	}

	Core::String MemoryTrend(const Capture& capture, int64 fromNs, int64 toNs, int32 points) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		const int32 n = PointsOf(points);
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("fromNs", capture.clock.Ns(range.begin));
		json.IntField("toNs", capture.clock.Ns(range.end > capture.lastTicks ? capture.lastTicks : range.end));
		json.Key(Core::StringView("series"));
		json.BeginArray();
		for (const Pool* pool : capture.pools) {
			if (pool->times.IsEmpty()) continue;
			json.BeginObject();
			json.Field("kind", "pool");
			Core::StringView name = capture.Text(pool->nameStr);
			json.Field("name", name.IsEmpty() ? Core::StringView("heap") : name);
			json.IntField("allocs", pool->allocs);
			json.IntField("frees", pool->frees);
			WriteSeries(json, capture, PoolSeries(pool), range, n);
			json.EndObject();
		}
		for (const Plot* plot : capture.plots) {
			if (plot->kind != 1 || plot->times.IsEmpty()) continue;
			json.BeginObject();
			json.Field("kind", "plot");
			json.Field("name", capture.Text(plot->nameStr));
			WriteSeries(json, capture, PlotSeries(plot), range, n);
			json.EndObject();
		}
		json.EndArray();
		WriteCollections(json, capture, range);
		const int64 teardown = TeardownAt(capture);
		json.IntField("teardownNs", teardown < 0 ? -1 : capture.clock.Ns(teardown));
		json.EndObject();
		return json.ToString();
	}

	Core::String Plots(const Capture& capture, Core::StringView name, int64 fromNs, int64 toNs, int32 points) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		const int32 n = PointsOf(points);
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("plots"));
		json.BeginArray();
		for (const Plot* plot : capture.plots) {
			if (plot->times.IsEmpty() || (name.IsEmpty() ? plot->kind == 1 : !ContainsNoCase(capture.Text(plot->nameStr), name))) continue;
			const SeriesView series = PlotSeries(plot);
			double least = 0.0;
			double most = 0.0;
			double sum = 0.0;
			int64 count = 0;
			const int64 stop = plot->times.LowerBound(range.end);
			for (int64 i = plot->times.LowerBound(range.begin); i < stop; ++i) {
				const double v = plot->values[i];
				if (count == 0 || v < least) least = v;
				if (count == 0 || v > most) most = v;
				sum += v;
				count += 1;
			}
			json.BeginObject();
			json.Field("name", capture.Text(plot->nameStr));
			json.IntField("kind", (int64)plot->kind);
			json.IntField("samples", count);
			NumberField(json, "min", least, 3);
			NumberField(json, "mean", count == 0 ? 0.0 : sum / (double)count, 3);
			NumberField(json, "max", most, 3);
			NumberField(json, "last", ValueAt(series, range.end - 1), 3);
			json.Key(Core::StringView("values"));
			json.BeginArray();
			for (int32 k = 0; k <= n; ++k) {
				json.BeginArray();
				json.Int(capture.clock.Ns(PointTime(range, n, k)));
				WriteNumber(json, ValueAt(series, PointTime(range, n, k)), 3);
				json.EndArray();
			}
			json.EndArray();
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
