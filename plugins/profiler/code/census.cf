// Live objects by type over the collections (docs/16 HeapCensus): in a collected heap a leak is objects still
// reachable, so the types whose live count keeps rising from one census to the next are what the program keeps.
include "investigate.ch"

namespace Profiler
{
	const double kCensusRises = 0.7;           // of the steps between censuses
	const double kCensusGrowth = 1.2;
	const int64 kCensusLeastGrowthBytes = 65536;
	const int64 kCensusLeastGrowthObjects = 500;   // small objects that each hold native memory leak by count, not size

	// One type across the censuses: its live objects and bytes in each (0 where it had none).
	class TypeSeries
	{
		public uint64 nameStr;
		public Core::Array<int64> objects;
		public Core::Array<int64> bytes;

		public int64 Rises() const {
			int64 rises = 0;
			for (int64 k = 1; k < bytes.Count(); ++k)
				if (bytes[k] > bytes[k - 1]) rises += 1;
			return rises;
		}

		public int64 Peak() const {
			int64 peak = 0;
			for (int64 b : bytes)
				if (b > peak) peak = b;
			return peak;
		}

		public int64 Growth() const { return bytes.Back() - bytes[0]; }

		public bool Accumulating() const {
			const int64 steps = bytes.Count() - 1;
			const bool grewEnough = Growth() >= kCensusLeastGrowthBytes || objects.Back() - objects[0] >= kCensusLeastGrowthObjects;
			return steps >= 2 && (double)Rises() >= kCensusRises * (double)steps && (double)bytes.Back() >= (double)bytes[0] * kCensusGrowth && grewEnough;
		}
	}

	static void GatherTypes(const Core::Array<const HeapCensus*>& chosen, Core::Array<TypeSeries*>& out) {
		Core::HashMap<uint64, TypeSeries*> seriesOf;
		for (int64 k = 0; k < chosen.Count(); ++k) {
			for (const CensusType& type : chosen[k]->types) {
				TypeSeries* series = nullptr;
				if (!seriesOf.TryGet(type.nameStr, series)) {
					series = new TypeSeries();
					series->nameStr = type.nameStr;
					series->objects.Resize(chosen.Count());
					series->bytes.Resize(chosen.Count());
					seriesOf.Insert(type.nameStr, series);
					out.Push(series);
				}
				series->objects[k] += type.objects;
				series->bytes[k] += type.bytes;
			}
		}
		out.SortBy([](TypeSeries* a, TypeSeries* b) -> bool { return a->Growth() != b->Growth() ? a->Growth() > b->Growth() : a->bytes.Back() > b->bytes.Back(); });
	}

	Core::String CensusTrend(const Capture& capture, int64 fromNs, int64 toNs, int32 limit) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		Core::Array<const HeapCensus*> chosen;
		for (const HeapCensus* census : capture.censuses)
			if (range.Holds(census->t)) chosen.Push(census);
		Core::Array<TypeSeries*> series;
		GatherTypes(chosen, series);
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("censuses", chosen.Count());
		json.IntField("firstNs", chosen.IsEmpty() ? -1 : capture.clock.Ns(chosen[0]->t));
		json.IntField("lastNs", chosen.IsEmpty() ? -1 : capture.clock.Ns(chosen.Back()->t));
		json.IntField("typeCount", series.Count());
		json.Key(Core::StringView("types"));
		json.BeginArray();
		for (int64 i = 0; i < series.Count() && i < (int64)limit; ++i) {
			const TypeSeries* s = series[i];
			json.BeginObject();
			json.Field("name", capture.Text(s->nameStr));
			json.IntField("firstObjects", s->objects[0]);
			json.IntField("lastObjects", s->objects.Back());
			json.IntField("firstBytes", s->bytes[0]);
			json.IntField("lastBytes", s->bytes.Back());
			json.IntField("peakBytes", s->Peak());
			json.IntField("rises", s->Rises());
			json.IntField("steps", s->bytes.Count() - 1);
			json.BoolField("accumulating", s->Accumulating());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
