// The profile_* AI tools (docs/13 T-PRF, the manifest's toolCalls): each forwards to the profiler.query binding the
// plugin provides, which answers from the plugin's state; profile_capture runs the Profile task and records.
include "tooltext.ch"
include "api/bindings.ch"
include "api/tools.ch"
include "api/tasks.ch"

namespace Profiler
{
	const char* kQueryBinding = "profiler.query";
	const int64 kCaptureStartWaitNs = 600000000000;
	const int64 kCaptureEndWaitNs = 10000000000;
	const int64 kPollNs = 100000000;
	const double kDefaultCaptureSeconds = 5.0;

	// --- Recording ----------------------------------------------------------------------------------------------------

	// The newest live capture of the workspace that started after `since`, or empty.
	static Core::String LiveSince(ProfilerPlugin* profiler, Core::StringView wsId, int64 since) {
		Threading::LockGuard guard(profiler->lock);
		for (const Core::KeyValue<Core::String, CaptureEntry*>& item : profiler->captures) {
			CaptureEntry* entry = item.value;
			if (entry->live && entry->wsId.View() == wsId && entry->modifiedNs >= since) return entry->id;
		}
		return Core::String();
	}

	static bool StillLive(ProfilerPlugin* profiler, Core::StringView id) {
		Threading::LockGuard guard(profiler->lock);
		CaptureEntry* entry = profiler->Entry(id);
		return entry && entry->live;
	}

	static void StopLive(ProfilerPlugin* profiler, Core::StringView id) {
		Threading::LockGuard guard(profiler->lock);
		CaptureEntry* entry = profiler->Entry(id);
		if (entry && entry->connection) entry->connection->Shutdown(Net::Shutdown::Both);
	}

	static Core::String RunFailure(const IED::TaskOutcome& outcome) {
		Core::StringBuilder text;
		text.Append("The Profile task ended before the program connected to the profiler");
		text.Append(outcome.succeeded ? " (it succeeded: is the program instrumented with an ITP client and does it read IED_PROFILER?)" : " (it failed)");
		text.Append(".\nThe end of its output:\n");
		text.Append(outcome.tail.View());
		return text.ToString();
	}

	// The program stopped before the answer says it is: its run ends once its process has (at most kCaptureEndWaitNs).
	static void StopRun(Core::StringView runId) {
		IED::CancelTask(runId);
		const int64 endBy = clock_now_ns() + kCaptureEndWaitNs;
		IED::TaskOutcome outcome;
		while (!IED::TaskEnded(runId, outcome) && outcome.problem.IsEmpty() && clock_now_ns() < endBy) Threading::Thread::Sleep(kPollNs);
	}

	static Core::String Record(ProfilerPlugin* profiler, Core::StringView wsId, const Serialization::DomNode& args) {
		IED::Workspace ws;
		if (!IED::FindWorkspace(wsId, ws)) throw IED::RpcError(IED::ErrorCode::NotFound, Core::StringView("no such workspace"));
		const double seconds = args.Member("seconds").IsValid() ? args.Member("seconds").AsFloat() : kDefaultCaptureSeconds;
		const int64 since = Platform::UnixTimeNs();
		Core::String problem;
		Core::String runId = IED::StartTask(ws, args.Member("project").AsView(), Core::StringView(""), Core::StringView("profile"), problem);
		if (runId.IsEmpty()) throw IED::RpcError(IED::ErrorCode::Unavailable, (Core::String("cannot start the Profile task: ") + problem.View()).View());
		const int64 deadline = clock_now_ns() + kCaptureStartWaitNs;
		Core::String id;
		while (id.IsEmpty()) {
			IED::TaskOutcome outcome;
			if (IED::TaskEnded(runId.View(), outcome)) throw IED::RpcError(IED::ErrorCode::Unavailable, RunFailure(outcome).View());
			if (clock_now_ns() > deadline) {
				IED::CancelTask(runId.View());
				throw IED::RpcError(IED::ErrorCode::Timeout, Core::StringView("the program did not connect to the profiler within 10 minutes"));
			}
			Threading::Thread::Sleep(kPollNs);
			id = LiveSince(profiler, wsId, since);
		}
		const int64 until = clock_now_ns() + (int64)(seconds * 1000000000.0);
		while (clock_now_ns() < until && StillLive(profiler, id.View())) Threading::Thread::Sleep(kPollNs);
		StopLive(profiler, id.View());
		const int64 endBy = clock_now_ns() + kCaptureEndWaitNs;
		while (StillLive(profiler, id.View()) && clock_now_ns() < endBy) Threading::Thread::Sleep(kPollNs);
		StopRun(runId.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String asked = Core::String("{\"capture\":\"") + id.View() + "\"}";
		return ToolAnswer(profiler, wsId, Core::StringView("summary"), Serialization::ReadJson(asked.View(), *doc).root);
	}

	// --- The binding --------------------------------------------------------------------------------------------------

	void ProvideQuery(ProfilerPlugin* profiler) {
		profiler->context->Provide(Core::StringView(kQueryBinding), [profiler](const Serialization::DomNode& call) -> IED::Result {
			Core::StringView wsId = call.Member("wsId").AsView();
			Core::StringView tool = call.Member("tool").AsView();
			try {
				Core::String text = tool == "capture" ? Record(profiler, wsId, call.Member("args")) : ToolAnswer(profiler, wsId, tool, call.Member("args"));
				IED::JsonWriter json;
				json.BeginObject();
				json.Field("text", text.View());
				json.EndObject();
				return IED::Answer(json.View());
			}
			catch (IED::RpcError failed) {
				return IED::Refusal(failed.message.View());
			}
		});
	}

	// --- The tools ----------------------------------------------------------------------------------------------------

	static IED::ToolResult Through(const char* tool, const IED::ToolCall& call) {
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("wsId", call.workspace.id.View());
		args.Field("tool", tool);
		args.RawField("args", IED::NodeJson(call.args).View());
		args.EndObject();
		IED::Result answer = IED::CallBinding(Core::StringView(kQueryBinding), args.View());
		if (!answer.Ok()) return IED::ToolFailure(answer.error.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return IED::ToolText(Serialization::ReadJson(answer.json.View(), *doc).root.Member("text").AsView());
	}

	IED::ToolResult ListTool(const IED::ToolCall& call) { return Through("list", call); }
	IED::ToolResult SummaryTool(const IED::ToolCall& call) { return Through("summary", call); }
	IED::ToolResult TopZonesTool(const IED::ToolCall& call) { return Through("top_zones", call); }
	IED::ToolResult FrameTool(const IED::ToolCall& call) { return Through("frame", call); }
	IED::ToolResult FindZoneTool(const IED::ToolCall& call) { return Through("find_zone", call); }
	IED::ToolResult FlameTool(const IED::ToolCall& call) { return Through("flame", call); }
	IED::ToolResult MessagesTool(const IED::ToolCall& call) { return Through("messages", call); }
	IED::ToolResult LeaksTool(const IED::ToolCall& call) { return Through("leaks", call); }
	IED::ToolResult CompareTool(const IED::ToolCall& call) { return Through("compare", call); }
	IED::ToolResult LocksTool(const IED::ToolCall& call) { return Through("locks", call); }
	IED::ToolResult AnnotateTool(const IED::ToolCall& call) { return Through("annotate", call); }
	IED::ToolResult AllocationsTool(const IED::ToolCall& call) { return Through("allocations", call); }
	IED::ToolResult MemoryTool(const IED::ToolCall& call) { return Through("memory", call); }
	IED::ToolResult PlotsTool(const IED::ToolCall& call) { return Through("plots", call); }
	IED::ToolResult HitchesTool(const IED::ToolCall& call) { return Through("hitches", call); }
	IED::ToolResult ThreadsTool(const IED::ToolCall& call) { return Through("threads", call); }
	IED::ToolResult ZoneTool(const IED::ToolCall& call) { return Through("zone", call); }
	IED::ToolResult TimelineTool(const IED::ToolCall& call) { return Through("timeline", call); }
	IED::ToolResult DiagnoseTool(const IED::ToolCall& call) { return Through("diagnose", call); }
	IED::ToolResult CaptureTool(const IED::ToolCall& call) { return Through("capture", call); }
}
