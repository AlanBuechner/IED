// The Chrome trace event format (the Trace Event Format document): complete (X) and begin/end (B/E) events become
// zones on their thread, instant events messages, counters plots, async begin/end (b/e) tasks, and the metadata events
// name the threads and the process. Times are microseconds, floats; the stream's clock counts nanoseconds.
include "importers.ch"
include "api/protocol.ch"

namespace Profiler
{
	const int64 kChromeEventsPerChunk = 100000;
	const int64 kMostArgsText = 240;

	// One thing that happens on a thread, in the order it is written: a zone's begin or end, a message, a task event.
	struct ChromeItem
	{
		public int64 t;
		public int64 sequence;
		public EventType type;
		public uint64 a;
		public uint64 b;
	}

	struct ChromeSpan
	{
		public int64 start;
		public int64 end;
		public uint64 site;
		public uint64 text;
	}

	class ChromeThread
	{
		public uint64 id;
		public Core::String name;
		public Core::Array<ChromeSpan> spans;
		public Core::Array<ChromeSpan> open;      // B events waiting for their E
		public Core::Array<ChromeItem> items;
	}

	class ChromeImport
	{
		public StreamBuilder* builder;
		public Core::HashMap<Core::String, ChromeThread*> threadOf;   // "pid/tid"
		public Core::Array<ChromeThread*> threads;
		public Core::HashMap<Core::String, uint64> plotOf;
		public Core::Array<int64> plotTimes;
		public Core::Array<uint64> plotIds;
		public Core::Array<double> plotValues;
		public Core::HashMap<Core::String, uint64> asyncTask;        // "cat/id/name" -> task id
		public Core::String app;
		public int64 sequence;
		public int64 earliest = -1;
	}

	static Core::String IdText(const Serialization::DomNode& node) {
		if (node.Kind() == Serialization::DomKind::String) return Core::String(node.AsView());
		Core::StringBuilder text;
		text.AppendInt(node.AsInt());
		return text.ToString();
	}

	static ChromeThread* ThreadOf(ChromeImport& import, const Serialization::DomNode& event) {
		Core::String key = IdText(event.Member("pid")) + "/" + IdText(event.Member("tid")).View();
		ChromeThread* thread = nullptr;
		if (import.threadOf.TryGet(key, thread)) return thread;
		thread = new ChromeThread();
		thread->id = (uint64)import.threads.Count() + 1;
		import.threads.Push(thread);
		import.threadOf.Insert(key, thread);
		return thread;
	}

	static int64 Nanoseconds(const Serialization::DomNode& micros) {
		return (int64)(micros.AsFloat() * 1000.0 + 0.5);
	}

	// A short text of an event's args, for its zone.
	static uint64 ArgsText(ChromeImport& import, const Serialization::DomNode& args) {
		if (args.Kind() != Serialization::DomKind::Object || args.Count() == 0) return 0;
		Core::String json = IED::NodeJson(args);
		if (json.ByteLength() > kMostArgsText) json = Core::String(json.View().Substring(0, kMostArgsText)) + "...";
		return import.builder->String(json.View());
	}

	static void AddItem(ChromeImport& import, ChromeThread* thread, int64 t, EventType type, uint64 a, uint64 b) {
		ChromeItem item;
		item.t = t;
		item.sequence = import.sequence;
		item.type = type;
		item.a = a;
		item.b = b;
		import.sequence += 1;
		thread->items.Push(item);
	}

	static void Counter(ChromeImport& import, const Serialization::DomNode& event, int64 t) {
		const Serialization::DomNode args = event.Member("args");
		for (int64 i = 0; i < args.Count(); ++i) {
			const Serialization::DomNode value = args.ValueAt(i);
			if (value.Kind() != Serialization::DomKind::Int && value.Kind() != Serialization::DomKind::Float) continue;
			Core::String name = Core::String(event.Member("name").AsView());
			if (args.Count() > 1) name = (name + ".") + args.KeyAt(i);
			uint64 id;
			if (!import.plotOf.TryGet(name, id)) {
				id = (uint64)import.plotOf.Count() + 1;
				import.plotOf.Insert(name, id);
			}
			import.plotTimes.Push(t);
			import.plotIds.Push(id);
			import.plotValues.Push(value.AsFloat());
		}
	}

	static void AsyncTask(ChromeImport& import, ChromeThread* thread, const Serialization::DomNode& event, Core::StringView phase, int64 t) {
		Core::String key = (IdText(event.Member("cat")) + "/") + IdText(event.Member("id")).View();
		key = (key + "/") + event.Member("name").AsView();
		if (phase == "b") {
			const uint64 id = (uint64)import.asyncTask.Count() + 1;
			import.asyncTask.Remove(key);
			import.asyncTask.Insert(key, id);
			AddItem(import, thread, t, EventType::TaskBegin, id, import.builder->String(event.Member("name").AsView()));
			return;
		}
		uint64 id;
		if (import.asyncTask.TryGet(key, id)) AddItem(import, thread, t, EventType::TaskEnd, id, 0);
	}

	static void ReadEvent(ChromeImport& import, const Serialization::DomNode& event) {
		Core::StringView phase = event.Member("ph").AsView();
		if (phase == "M") {
			const Core::StringView name = event.Member("args").Member("name").AsView();
			if (event.Member("name").AsView() == "thread_name") ThreadOf(import, event)->name = Core::String(name);
			else if (event.Member("name").AsView() == "process_name" && import.app.IsEmpty()) import.app = Core::String(name);
			return;
		}
		if (!event.Member("ts").IsValid()) return;
		const int64 t = Nanoseconds(event.Member("ts"));
		if (import.earliest < 0 || t < import.earliest) import.earliest = t;
		if (phase == "C") {
			Counter(import, event, t);
			return;
		}
		ChromeThread* thread = ThreadOf(import, event);
		if (phase == "X" || phase == "B") {
			ChromeSpan span;
			span.start = t;
			span.end = phase == "X" ? t + Nanoseconds(event.Member("dur")) : -1;
			span.site = import.builder->Site(event.Member("name").AsView(), Core::StringView(""), event.Member("cat").AsView(), 0);
			span.text = ArgsText(import, event.Member("args"));
			if (phase == "X") thread->spans.Push(span);
			else thread->open.Push(span);
		}
		else if (phase == "E") {
			if (thread->open.IsEmpty()) return;
			ChromeSpan span = thread->open.Pop();
			span.end = t < span.start ? span.start : t;
			thread->spans.Push(span);
		}
		else if (phase == "i" || phase == "I" || phase == "R" || phase == "n") AddItem(import, thread, t, EventType::Message, import.builder->String(event.Member("name").AsView()), 0);
		else if (phase == "b" || phase == "e") AsyncTask(import, thread, event, phase, t);
	}

	// A thread's spans as begin and end items in nesting order: by start, the longer first, each ended before the
	// next one that starts after it ends. A span that overlaps its parent's end is cut there.
	static void Nest(ChromeImport& import, ChromeThread* thread) {
		for (ChromeSpan& span : thread->open) span.end = span.start;
		thread->spans.Append(thread->open);
		thread->spans.SortBy([](const ChromeSpan& a, const ChromeSpan& b) -> bool { return a.start != b.start ? a.start < b.start : a.end > b.end; });
		Core::Array<int64> ends;
		for (ChromeSpan& span : thread->spans) {
			while (!ends.IsEmpty() && ends.Back() <= span.start) AddItem(import, thread, ends.Pop(), EventType::ZoneEnd, 0, 0);
			if (!ends.IsEmpty() && span.end > ends.Back()) span.end = ends.Back();
			AddItem(import, thread, span.start, EventType::ZoneBegin, span.site, span.text);
			ends.Push(span.end);
		}
		while (!ends.IsEmpty()) AddItem(import, thread, ends.Pop(), EventType::ZoneEnd, 0, 0);
	}

	static void WriteItem(WireWriter& w, const ChromeItem& item) {
		w.Type(item.type);
		w.Time(item.t);
		if (item.type == EventType::ZoneBegin) {
			w.Varint(item.a);
			if (item.b != 0) {
				w.Type(EventType::ZoneText);
				w.Varint(item.b);
			}
		}
		else if (item.type == EventType::Message) {
			w.Varint(2);
			w.Varint(item.a);
			w.Varint(0);
		}
		else if (item.type == EventType::TaskBegin) {
			w.Varint(item.a);
			w.Varint(item.b);
			w.Varint(0);
		}
		else if (item.type == EventType::TaskEnd) w.Varint(item.a);
	}

	static void WriteThread(ChromeImport& import, ChromeThread* thread) {
		Nest(import, thread);
		thread->items.SortBy([](const ChromeItem& a, const ChromeItem& b) -> bool { return a.t != b.t ? a.t < b.t : a.sequence < b.sequence; });
		StreamBuilder& builder = *import.builder;
		const uint64 name = thread->name.IsEmpty() ? 0 : builder.String(thread->name.View());
		for (int64 first = 0; first < thread->items.Count() || first == 0; first += kChromeEventsPerChunk) {
			const int64 base = thread->items.IsEmpty() ? import.earliest : thread->items[first].t;
			builder.BeginChunk(thread->id, base);
			if (first == 0 && name != 0) {
				builder.Body().Type(EventType::ThreadName);
				builder.Body().Time(base);
				builder.Body().Varint(name);
			}
			for (int64 i = first; i < thread->items.Count() && i < first + kChromeEventsPerChunk; ++i) WriteItem(builder.Body(), thread->items[i]);
			builder.EndChunk();
			if (thread->items.IsEmpty()) break;
		}
	}

	static void WritePlots(ChromeImport& import) {
		if (import.plotIds.IsEmpty()) return;
		StreamBuilder& builder = *import.builder;
		Core::Array<int64> order;
		for (int64 i = 0; i < import.plotIds.Count(); ++i) order.Push(i);
		order.SortBy([&import](const int64& a, const int64& b) -> bool { return import.plotTimes[a] < import.plotTimes[b]; });
		builder.BeginChunk(0, import.earliest);
		for (const Core::KeyValue<Core::String, uint64>& plot : import.plotOf) {
			builder.Body().Type(EventType::PlotDef);
			builder.Body().Varint(plot.value);
			builder.Body().Varint(builder.String(plot.key.View()));
			builder.Body().Varint(0);
			builder.Body().Varint(0);
		}
		for (int64 i : order) {
			builder.Body().Type(EventType::PlotValue);
			builder.Body().Time(import.plotTimes[i]);
			builder.Body().Varint(import.plotIds[i]);
			builder.Body().Double(import.plotValues[i]);
		}
		builder.EndChunk();
	}

	bool ImportChromeTrace(Core::StringView json, Core::StringView app, Core::Array<uint8>& stream, Core::String& problem) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode root = Serialization::ReadJson(json, *doc).root;
		Serialization::DomNode events = root.Kind() == Serialization::DomKind::Array ? root : root.Member("traceEvents");
		if (events.Kind() != Serialization::DomKind::Array) {
			problem = Core::String("not a Chrome trace: no traceEvents array");
			return false;
		}
		ChromeImport import;
		StreamBuilder* builder = new StreamBuilder();
		import.builder = builder;
		for (int64 i = 0; i < events.Count(); ++i) ReadEvent(import, events.At(i));
		if (import.earliest < 0) import.earliest = 0;
		builder->Hello(import.app.IsEmpty() ? app : import.app.View(), 0, 1000000000, import.earliest, 0);
		for (ChromeThread* thread : import.threads) WriteThread(import, thread);
		WritePlots(import);
		stream = builder->Bytes();
		return true;
	}
}
