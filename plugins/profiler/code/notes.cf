// Annotations of captures (F-PRF-19, docs/16 "Annotations"): the plugin keeps them with each capture's entry, writes
// them into its trace file's metadata, and pushes the whole list on the capture's topic when it changes. The prof.*
// methods that add, change and remove them; the AI's profile_annotate goes through AddAnnotation too.
include "service.ch"

namespace Profiler
{
	Core::Array<Annotation>& ProfilerPlugin::AnnotationsOf(CaptureEntry* entry) {
		if (!entry->annotationsRead) {
			entry->annotations = ReadAnnotations(entry->metadata.View());
			entry->annotationsRead = true;
		}
		return entry->annotations;
	}

	static Core::String AnnotationsJson(const Core::Array<Annotation>& annotations) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("annotations"));
		WriteAnnotations(json, annotations);
		json.EndObject();
		return json.ToString();
	}

	// The metadata a file's annotations are written into: its own, else (a file that never got an index block) the
	// capture's as it is loaded.
	static Core::String BaseMetadata(CaptureEntry* entry) {
		if (!entry->metadata.IsEmpty() || !entry->capture) return entry->metadata;
		Threading::LockGuard held(entry->capture->lock);
		return MetadataJson(*entry->capture, Core::StringView("closed"));
	}

	void ProfilerPlugin::SaveAnnotations(CaptureEntry* entry) {
		if (!entry->live) {
			Core::String metadata = MetadataWith(BaseMetadata(entry).View(), entry->annotations);
			Core::String problem;
			if (!RewriteMetadata(entry->path.CStr(), metadata.View(), problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
			entry->metadata = metadata;
			FS::FileInfo info;
			if (FS::GetInfo(entry->path.CStr(), info)) entry->sizeBytes = info.size;
		}
		context->Publish(entry->Topic().View(), "annotations", AnnotationsJson(entry->annotations).View());
		ProfWorkspace* ws = Workspace(entry->wsId.View());
		if (ws) PublishLibrary(ws);
	}

	// --- Changing them ------------------------------------------------------------------------------------------------

	static CaptureEntry* EntryOrThrow(ProfilerPlugin* profiler, Core::StringView captureId) {
		CaptureEntry* entry = profiler->Entry(captureId);
		if (!entry) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no capture ") + captureId).View());
		return entry;
	}

	static int64 IndexOf(const Core::Array<Annotation>& annotations, Core::StringView id) {
		for (int64 i = 0; i < annotations.Count(); ++i)
			if (annotations[i].id.View() == id) return i;
		throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no annotation ") + id).View());
	}

	// [from, to] in order and not before the capture's start.
	static void SetRange(Annotation& annotation, int64 fromNs, int64 toNs) {
		if (fromNs < 0) fromNs = 0;
		if (toNs < fromNs) toNs = fromNs;
		annotation.fromNs = fromNs;
		annotation.toNs = toNs;
	}

	static void SortByTime(Core::Array<Annotation>& annotations) {
		annotations.SortBy([](const Annotation& a, const Annotation& b) -> bool { return a.fromNs != b.fromNs ? a.fromNs < b.fromNs : a.toNs < b.toNs; });
	}

	// Saves a change to the entry's annotations, or puts them back as they were (`before`) when the file refuses it.
	static void Commit(ProfilerPlugin* profiler, CaptureEntry* entry, const Core::Array<Annotation>& before) {
		SortByTime(entry->annotations);
		try {
			profiler->SaveAnnotations(entry);
		}
		catch (IED::RpcError failed) {
			entry->annotations = before;
			throw failed;
		}
	}

	static Core::String TextOrThrow(Core::StringView given) {
		Core::String text;
		Core::String problem;
		if (!AnnotationText(given, text, problem)) throw IED::RpcError(IED::ErrorCode::BadRequest, problem.View());
		return text;
	}

	Annotation AddAnnotation(ProfilerPlugin* profiler, Core::StringView captureId, int64 fromNs, int64 toNs, Core::StringView text, Core::StringView by) {
		Threading::LockGuard guard(profiler->lock);
		CaptureEntry* entry = EntryOrThrow(profiler, captureId);
		Core::Array<Annotation>& annotations = profiler->AnnotationsOf(entry);
		if (annotations.Count() >= (int64)kMostAnnotations) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("a capture keeps at most 500 annotations"));
		Annotation annotation;
		annotation.id = NextAnnotationId(annotations);
		annotation.text = TextOrThrow(text);
		annotation.by = Core::String(by);
		annotation.createdUnixNs = Platform::UnixTimeNs();
		SetRange(annotation, fromNs < toNs ? fromNs : toNs, fromNs < toNs ? toNs : fromNs);
		Core::Array<Annotation> before = annotations;
		annotations.Push(annotation);
		Commit(profiler, entry, before);
		return annotation;
	}

	// --- The methods --------------------------------------------------------------------------------------------------

	static Core::String AnnotationAnswer(const Annotation& annotation) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("annotation"));
		WriteAnnotation(json, annotation);
		json.EndObject();
		return json.ToString();
	}

	static Core::String AnnotationsMethod(ProfilerPlugin* profiler, const IED::Params& params) {
		Threading::LockGuard guard(profiler->lock);
		return AnnotationsJson(profiler->AnnotationsOf(EntryOrThrow(profiler, params.Str("captureId").View())));
	}

	static Core::String AnnotateMethod(ProfilerPlugin* profiler, const IED::Params& params) {
		const int64 from = params.Int("from", 0);
		return AnnotationAnswer(AddAnnotation(profiler, params.Str("captureId").View(), from, params.Int("to", from), params.Str("text").View(), Core::StringView("owner")));
	}

	static Core::String UpdateAnnotationMethod(ProfilerPlugin* profiler, const IED::Params& params) {
		Threading::LockGuard guard(profiler->lock);
		CaptureEntry* entry = EntryOrThrow(profiler, params.Str("captureId").View());
		Core::Array<Annotation>& annotations = profiler->AnnotationsOf(entry);
		const int64 index = IndexOf(annotations, params.Str("id").View());
		Core::Array<Annotation> before = annotations;
		Annotation& annotation = annotations[index];
		if (params.Has("text")) annotation.text = TextOrThrow(params.Str("text").View());
		if (params.Has("from") || params.Has("to")) SetRange(annotation, params.Int("from", annotation.fromNs), params.Int("to", annotation.toNs));
		Annotation changed = annotation;
		Commit(profiler, entry, before);
		return AnnotationAnswer(changed);
	}

	static Core::String DeleteAnnotationMethod(ProfilerPlugin* profiler, const IED::Params& params) {
		Threading::LockGuard guard(profiler->lock);
		CaptureEntry* entry = EntryOrThrow(profiler, params.Str("captureId").View());
		Core::Array<Annotation>& annotations = profiler->AnnotationsOf(entry);
		const int64 index = IndexOf(annotations, params.Str("id").View());
		Core::Array<Annotation> before = annotations;
		annotations.RemoveAt(index);
		Commit(profiler, entry, before);
		return Core::String("{}");
	}

	void RegisterAnnotationMethods(ProfilerPlugin* profiler) {
		RegisterMethod(profiler, "prof.annotations", AnnotationsMethod);
		RegisterMethod(profiler, "prof.annotate", AnnotateMethod);
		RegisterMethod(profiler, "prof.updateAnnotation", UpdateAnnotationMethod);
		RegisterMethod(profiler, "prof.deleteAnnotation", DeleteAnnotationMethod);
	}
}
