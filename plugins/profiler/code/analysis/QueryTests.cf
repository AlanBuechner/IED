// The profiler's queries (docs/16, docs/features/12-profiler.md): what the timeline, the analysis windows and the AI
// tools are answered from, checked on small captures built event by event.

include "Timeline.ch"
include "Analysis.ch"
include "capture/Ingest.ch"

// A capture writer that keeps the chunk bookkeeping out of the tests.
class TraceBuilder
{
	public Profiler::WireWriter m_W;
	public uint64 m_NextString = 1;

	[operator("create")] public void Init() {
		m_W.BeginChunk(Profiler::c_GlobalChunk, 0, 0);
		m_W.Type(Profiler::EventType::Hello);
		m_W.Varint(1);
		m_W.Text(Core::StringView("game"));
		m_W.Varint(7);
		m_W.Varint(1000000000);
		m_W.Varint(0);
		m_W.Varint(0);
		m_W.Varint(0);
		m_W.Text(Core::StringView(""));
		m_W.EndChunk();
	}

	// A string and a source location of that name, both with id `id`.
	public void Site(uint64 id, const char* name) {
		m_W.BeginChunk(Profiler::c_GlobalChunk, 0, 0);
		m_W.Type(Profiler::EventType::StringDef);
		m_W.Varint(id);
		m_W.Text(Core::StringView(name));
		m_W.Type(Profiler::EventType::SrcLocDef);
		m_W.Varint(id);
		m_W.Varint(id);
		m_W.Varint(0);
		m_W.Varint(0);
		m_W.Varint(id * 10);
		m_W.Varint(0);
		m_W.EndChunk();
	}

	public void Thread(uint64 thread) { m_W.BeginChunk(Profiler::c_ThreadChunk, thread, 0); }
	public void Global() { m_W.BeginChunk(Profiler::c_GlobalChunk, 0, 0); }
	public void Done() { m_W.EndChunk(); }

	public void Zone(int64 begin, uint64 site) {
		m_W.Type(Profiler::EventType::ZoneBegin);
		m_W.Time(begin);
		m_W.Varint(site);
	}

	public void End(int64 at) {
		m_W.Type(Profiler::EventType::ZoneEnd);
		m_W.Time(at);
	}

	public void Frame(int64 at) {
		m_W.Type(Profiler::EventType::FrameMark);
		m_W.Time(at);
		m_W.Varint(0);
	}

	public Profiler::Capture* Read() {
		Profiler::Capture* capture = new Profiler::Capture();
		Profiler::ChunkStream stream;
		stream.Feed(m_W.Bytes().Data(), m_W.Length());
		const uint8* chunk;
		int64 length;
		while (stream.Next(chunk, length)) Profiler::ApplyChunk(*capture, chunk, length);
		Profiler::Finish(*capture);
		return capture;
	}
}

static Serialization::DomNode Parse(const Core::String& json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Serialization::ReadJson(json.View(), *doc).root;
}

// Frame 0 [0, 100): Update [10, 60) with two Physics [20, 30) and [40, 55); Render [60, 90). Frame 1 [100, 300):
// Update [110, 290) with Physics [120, 280). Thread 2 runs Physics [50, 70).
static Profiler::Capture* Sample() {
	TraceBuilder b;
	b.Site(1, "Update");
	b.Site(2, "Physics");
	b.Site(3, "Render");
	b.Thread(1);
	b.Frame(0);
	b.Zone(10, 1);
	b.Zone(20, 2);
	b.End(30);
	b.Zone(40, 2);
	b.End(55);
	b.End(60);
	b.Zone(60, 3);
	b.End(90);
	b.Frame(100);
	b.Zone(110, 1);
	b.Zone(120, 2);
	b.End(280);
	b.End(290);
	b.Frame(300);
	b.Done();
	b.Thread(2);
	b.Zone(50, 2);
	b.End(70);
	b.Done();
	return b.Read();
}

[test("server.profiler.query")]
class ProfilerQueryTests {
	[test("timeline_lanes_and_zones")]
	public static void TestTimeline() {
		Profiler::Capture* capture = Sample();
		Profiler::TimelineAsk ask;
		ask.m_Width = 300;
		Serialization::DomNode answer = Parse(Profiler::Timeline(*capture, ask));
		Serialization::DomNode lanes = answer.Member("lanes");
		assert_true(lanes.Count() == 2, "a lane per thread with zones");
		Serialization::DomNode zones = lanes.At(0).Member("zones");
		assert_true(zones.Count() == 6 && lanes.At(0).Member("depth").AsInt() == 2, "every zone of the first thread, two deep");
		Serialization::DomNode first = zones.At(0);
		assert_true(first.At(0).AsInt() == 0 && first.At(1).AsInt() == 10 && first.At(2).AsInt() == 60, "depth, start and end");
		assert_true(answer.Member("names").At(first.At(3).AsInt()).AsView() == "Update" && first.At(4).AsView() == "0:0:0", "its name and reference");
		assert_true(answer.Member("frames").Member("items").Count() == 2, "both whole frames");
	}

	[test("timeline_merges_zones_narrower_than_a_pixel")]
	public static void TestMerging() {
		TraceBuilder b;
		b.Site(1, "Tiny");
		b.Thread(1);
		for (int64 i = 0; i < 1000; ++i) {
			b.Zone(i * 10, 1);
			b.End(i * 10 + 5);
		}
		b.Done();
		Profiler::Capture* capture = b.Read();
		Profiler::TimelineAsk ask;
		ask.m_Width = 10;
		Serialization::DomNode zones = Parse(Profiler::Timeline(*capture, ask)).Member("lanes").At(0).Member("zones");
		int64 covered = 0;
		for (int64 i = 0; i < zones.Count(); ++i) covered += zones.At(i).At(3).AsInt() == -1 ? zones.At(i).At(4).AsInt() : 1;
		assert_true(zones.Count() <= 20, "about one span per pixel");
		assert_true(covered == 1000, "and every zone counted once");
	}

	[test("timeline_range")]
	public static void TestTimelineRange() {
		Profiler::Capture* capture = Sample();
		Profiler::TimelineAsk ask;
		ask.m_FromNs = 100;
		ask.m_ToNs = 300;
		Serialization::DomNode zones = Parse(Profiler::Timeline(*capture, ask)).Member("lanes").At(0).Member("zones");
		assert_true(zones.Count() == 2, "only the zones overlapping the range");
	}

	[test("timeline_by_task_from_renames")]
	public static void TestTasksFromRenames() {
		TraceBuilder b;
		b.Site(1, "Work");
		b.Global();
		b.m_W.Type(Profiler::EventType::StringDef);
		b.m_W.Varint(50);
		b.m_W.Text(Core::StringView("Physics"));
		b.m_W.Type(Profiler::EventType::StringDef);
		b.m_W.Varint(51);
		b.m_W.Text(Core::StringView("Audio"));
		b.Done();
		b.Thread(1);
		b.m_W.Type(Profiler::EventType::ThreadName);
		b.m_W.Time(0);
		b.m_W.Varint(50);
		b.Zone(5, 1);
		b.End(20);
		b.m_W.Type(Profiler::EventType::ThreadName);
		b.m_W.Time(30);
		b.m_W.Varint(51);
		b.Zone(35, 1);
		b.End(40);
		b.Done();
		Profiler::Capture* capture = b.Read();
		Profiler::TimelineAsk ask;
		ask.m_Mode = Profiler::LaneMode::Tasks;
		Serialization::DomNode lanes = Parse(Profiler::Timeline(*capture, ask)).Member("lanes");
		assert_true(lanes.Count() == 2 && lanes.At(0).Member("label").AsView() == "Physics" && lanes.At(1).Member("label").AsView() == "Audio", "a renamed thread's segments become task lanes");
		assert_true(lanes.At(0).Member("zones").Count() == 1 && lanes.At(0).Member("slices").Count() == 1, "with the zones of their segment");
	}

	[test("stats")]
	public static void TestStats() {
		Profiler::Capture* capture = Sample();
		Profiler::StatsAsk ask;
		Serialization::DomNode rows = Parse(Profiler::Stats(*capture, ask)).Member("rows");
		assert_true(rows.Count() == 3, "a row per site");
		Serialization::DomNode top = rows.At(0);
		assert_true(top.Member("name").AsView() == "Update" && top.Member("count").AsInt() == 2 && top.Member("totalNs").AsInt() == 230, "sorted by total time");
		assert_true(top.Member("selfNs").AsInt() == 230 - 25 - 160, "self leaves out the children");
		Serialization::DomNode physics = rows.At(1);
		assert_true(physics.Member("count").AsInt() == 4 && physics.Member("maxNs").AsInt() == 160 && physics.Member("minNs").AsInt() == 10, "every thread's instances");
		ask.m_GroupBy = Profiler::GroupBy::Thread;
		ask.m_FromNs = 0;
		ask.m_ToNs = 100;
		ask.m_Filter = Core::String("phys");
		Serialization::DomNode byThread = Parse(Profiler::Stats(*capture, ask)).Member("rows");
		assert_true(byThread.Count() == 2 && byThread.At(0).Member("count").AsInt() == 2, "grouped by thread, in a range, filtered by name");
	}

	[test("find_zone")]
	public static void TestFindZone() {
		Profiler::Capture* capture = Sample();
		Profiler::FindAsk ask;
		ask.m_Name = Core::String("Physics");
		ask.m_Bins = 4;
		Serialization::DomNode answer = Parse(Profiler::FindZone(*capture, ask));
		assert_true(answer.Member("count").AsInt() == 4 && answer.Member("maxNs").AsInt() == 160, "every instance of the name");
		Serialization::DomNode bins = answer.Member("bins");
		int64 counted = 0;
		for (int64 i = 0; i < bins.Count(); ++i) counted += bins.At(i).At(2).AsInt();
		assert_true(bins.Count() == 4 && counted == 4, "a histogram that holds them all");
		assert_true(answer.Member("instances").At(0).Member("durationNs").AsInt() == 160, "the slowest first");
		ask.m_LowNs = 12;
		ask.m_HighNs = 20;
		Serialization::DomNode chosen = Parse(Profiler::FindZone(*capture, ask)).Member("instances");
		assert_true(chosen.Count() == 2, "instances limited to a duration range");
	}

	[test("zone_details")]
	public static void TestZoneDetails() {
		Profiler::Capture* capture = Sample();
		Serialization::DomNode zone = Parse(Profiler::ZoneDetails(*capture, Profiler::ZoneRef::Of(0, 1, 1)));
		assert_true(zone.Member("name").AsView() == "Physics" && zone.Member("durationNs").AsInt() == 15 && zone.Member("line").AsInt() == 20, "name, time and source line");
		assert_true(zone.Member("parents").Count() == 1 && zone.Member("parents").At(0).Member("name").AsView() == "Update", "its parent chain");
		assert_true(zone.Member("frame").Member("index").AsInt() == 0, "the frame it fell in");
		Serialization::DomNode update = Parse(Profiler::ZoneDetails(*capture, Profiler::ZoneRef::Of(0, 0, 0)));
		assert_true(update.Member("childCount").AsInt() == 2 && update.Member("children").At(0).Member("totalNs").AsInt() == 25, "children by name");
		assert_true(Profiler::ZoneDetails(*capture, Profiler::ZoneRef::Of(0, 5, 0)).IsEmpty(), "a reference to nothing");
	}

	[test("flame")]
	public static void TestFlame() {
		Profiler::Capture* capture = Sample();
		Profiler::FlameAsk ask;
		Serialization::DomNode root = Parse(Profiler::Flame(*capture, ask)).Member("root");
		assert_true(root.Member("total").AsInt() == 230 + 30 + 20, "the root holds every top-level zone");
		Serialization::DomNode update = root.Member("children").At(0);
		assert_true(update.Member("name").AsView() == "Update" && update.Member("count").AsInt() == 2, "zones of one name merge");
		assert_true(update.Member("children").At(0).Member("total").AsInt() == 185, "and so do their children");
	}

	[test("frames")]
	public static void TestFrames() {
		Profiler::Capture* capture = Sample();
		Serialization::DomNode graph = Parse(Profiler::FrameGraph(*capture, 100));
		assert_true(graph.Member("count").AsInt() == 2 && graph.Member("maxNs").AsInt() == 200 && graph.Member("bars").Count() == 2, "a bar per frame");
		Serialization::DomNode worst = Parse(Profiler::FrameBreakdown(*capture, -1));
		assert_true(worst.Member("index").AsInt() == 1 && worst.Member("durationNs").AsInt() == 200, "the longest frame");
		assert_true(worst.Member("topZones").Member("rows").At(0).Member("name").AsView() == "Physics", "its costliest zone by self time");
		assert_true(Profiler::FrameBreakdown(*capture, 9).IsEmpty(), "no such frame");
	}

	[test("leaks")]
	public static void TestLeaks() {
		TraceBuilder b;
		b.Global();
		for (int64 i = 0; i < 4; ++i) {
			b.m_W.Type(Profiler::EventType::Alloc);
			b.m_W.Time(i);
			b.m_W.Varint(1);
			b.m_W.Varint(0);
			b.m_W.Varint((uint64)(4096 + i * 64));
			b.m_W.Varint(64);
			b.m_W.Varint(i < 3 ? 9 : 8);
		}
		b.m_W.Type(Profiler::EventType::Free);
		b.m_W.Time(10);
		b.m_W.Varint(1);
		b.m_W.Varint(0);
		b.m_W.Varint(4096);
		b.Done();
		Profiler::Capture* capture = b.Read();
		Profiler::LeakAsk ask;
		ask.m_GroupBy = Profiler::AllocGroup::Callstack;
		Serialization::DomNode answer = Parse(Profiler::Leaks(*capture, ask));
		assert_true(answer.Member("count").AsInt() == 3 && answer.Member("bytes").AsInt() == 192, "what is live at the end");
		assert_true(answer.Member("groups").Count() == 2 && answer.Member("groups").At(0).Member("count").AsInt() == 2, "grouped by call stack, largest first");
		ask.m_AtNs = 5;
		assert_true(Parse(Profiler::Leaks(*capture, ask)).Member("count").AsInt() == 4, "what was live at a time");
	}

	[test("summary_and_compare")]
	public static void TestSummary() {
		Profiler::Capture* capture = Sample();
		Serialization::DomNode summary = Parse(Profiler::Summary(*capture));
		assert_true(summary.Member("app").AsView() == "game" && summary.Member("zones").AsInt() == 7, "the app and its zones");
		assert_true(summary.Member("frames").Member("count").AsInt() == 2 && summary.Member("threads").Count() == 2, "frames and threads");
		assert_true(summary.Member("topBySelf").Member("rows").Count() == 3, "the costliest zones");
		Serialization::DomNode compared = Parse(Profiler::Compare(*capture, *Sample(), 10));
		assert_true(compared.Member("zones").Count() == 3 && compared.Member("zones").At(0).Member("totalChangeNs").AsInt() == 0, "a capture against itself changes nothing");
	}

	[test("messages")]
	public static void TestMessages() {
		TraceBuilder b;
		b.Global();
		b.m_W.Type(Profiler::EventType::StringDef);
		b.m_W.Varint(1);
		b.m_W.Text(Core::StringView("loaded arena"));
		b.m_W.Type(Profiler::EventType::StringDef);
		b.m_W.Varint(2);
		b.m_W.Text(Core::StringView("frame budget blown"));
		b.Done();
		b.Thread(1);
		b.m_W.Type(Profiler::EventType::Message);
		b.m_W.Time(20);
		b.m_W.Varint(2);
		b.m_W.Varint(1);
		b.m_W.Varint(0);
		b.Done();
		b.Thread(2);
		b.m_W.Type(Profiler::EventType::Message);
		b.m_W.Time(10);
		b.m_W.Varint(3);
		b.m_W.Varint(2);
		b.m_W.Varint(0);
		b.Done();
		Profiler::Capture* capture = b.Read();
		Serialization::DomNode all = Parse(Profiler::Messages(*capture, -1, -1, 0, Core::StringView(""), 0, 50)).Member("messages");
		assert_true(all.Count() == 2 && all.At(0).Member("timeNs").AsInt() == 10, "in time order, whichever thread sent them first");
		Serialization::DomNode warnings = Parse(Profiler::Messages(*capture, -1, -1, 3, Core::StringView("BUDGET"), 0, 50));
		assert_true(warnings.Member("total").AsInt() == 1, "filtered by severity and text");
	}
}
