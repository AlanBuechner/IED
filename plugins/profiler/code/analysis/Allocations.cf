// Where a program allocates (T-PRF-13): each group's allocations and bytes in all and per frame, its churn - blocks
// freed within the frame they were made in, the garbage a frame leaves - and what it still holds at the range's end.
// A client that counts allocations instead of sending each one (C4's collector: ZoneAllocs, AllocCount) is read by
// what each zone allocated itself; a capture with only allocation samples (a pprof heap profile, the Go client) by
// the function each sample was taken in.
include "Investigate.ch"

namespace Profiler
{
	const int64 c_ChurnWindowNs = 10000000;

	class AllocRow
	{
		public uint64 m_Key;
		public uint64 m_Callstack;
		public int64 m_Count;
		public int64 m_Bytes;
		public int64 m_NativeBytes;   // native memory the zones took (a collected program's counts)
		public int64 m_NativeFreed;   // and gave back
		public int64 m_Churn;
		public int64 m_Live;
		public int64 m_LiveBytes;
		public int32 m_FirstTrack = -1;
		public Core::HashMap<int32, bool> m_Tracks;
	}

	// The range's allocations per frame, over the frames that began in it.
	class FrameTally
	{
		public const FrameSet* m_Set;
		public int64 m_First;
		public int64 m_Last;                  // one past
		public Core::Array<int64> m_Counts;
		public Core::Array<int64> m_Bytes;

		public int64 Frames() const { return m_Last - m_First; }

		public void Init(const Capture& capture, Range range) {
			m_Set = MainFrameSet(capture);
			m_First = m_Set ? m_Set->m_Starts.LowerBound(range.m_Begin) : 0;
			m_Last = m_Set ? m_Set->m_Starts.LowerBound(range.m_End) : 0;
			while (m_Last > m_First && m_Set->m_Ends[m_Last - 1] == c_Open) m_Last -= 1;
			m_Counts.Resize(Frames());
			m_Bytes.Resize(Frames());
		}

		// The frame an allocation fell in, counted; -1 outside the tallied frames.
		public int64 Add(const Allocation& allocation) {
			const int64 f = FrameAt(m_Set, allocation.m_T);
			if (f < m_First || f >= m_Last) return -1;
			m_Counts[f - m_First] += 1;
			m_Bytes[f - m_First] += allocation.m_Size;
			return f;
		}
	}

	static AllocRow* RowFor(Core::HashMap<uint64, AllocRow*>& rowOf, Core::Array<AllocRow*>& rows, uint64 key, uint64 callstack) {
		AllocRow* row = nullptr;
		if (rowOf.TryGet(key, row)) return row;
		row = new AllocRow();
		row->m_Key = key;
		row->m_Callstack = callstack;
		rows.Push(row);
		rowOf.Insert(key, row);
		return row;
	}

	static void WriteFrameTally(IED::JsonWriter& json, const Capture& capture, const FrameTally& tally) {
		json.Key(Core::StringView("frames"));
		if (tally.Frames() == 0) {
			json.Null();
			return;
		}
		Core::Array<int64> sorted;
		for (int64 n : tally.m_Counts) sorted.Push(n);
		sorted.Sort();
		int64 total = 0;
		int64 totalBytes = 0;
		int64 worst = 0;
		for (int64 i = 0; i < tally.Frames(); ++i) {
			total += tally.m_Counts[i];
			totalBytes += tally.m_Bytes[i];
			if (tally.m_Counts[i] > tally.m_Counts[worst]) worst = i;
		}
		json.BeginObject();
		json.IntField("count", tally.Frames());
		NumberField(json, "meanCount", (double)total / (double)tally.Frames(), 1);
		json.IntField("medianCount", Quantile(sorted, 0.5));
		json.IntField("p95Count", Quantile(sorted, 0.95));
		json.IntField("maxCount", tally.m_Counts[worst]);
		json.IntField("maxIndex", tally.m_First + worst);
		json.IntField("maxStartNs", capture.m_Clock.Ns(tally.m_Set->m_Starts[tally.m_First + worst]));
		json.IntField("meanBytes", totalBytes / tally.Frames());
		json.IntField("maxBytes", tally.m_Bytes[worst]);
		json.EndObject();
	}

	static void WriteAllocRow(IED::JsonWriter& json, const Capture& capture, const AllocGrouper& grouper, const AllocRow* row, int64 frames) {
		json.BeginObject();
		grouper.WriteLabel(json, row->m_Key, row->m_Callstack);
		json.IntField("count", row->m_Count);
		json.IntField("bytes", row->m_Bytes);
		json.IntField("meanSize", row->m_Count == 0 ? 0 : row->m_Bytes / row->m_Count);
		NumberField(json, "perFrame", frames == 0 ? 0.0 : (double)row->m_Count / (double)frames, 1);
		json.IntField("bytesPerFrame", frames == 0 ? 0 : row->m_Bytes / frames);
		json.IntField("nativeBytes", row->m_NativeBytes);
		json.IntField("nativeBytesPerFrame", frames == 0 ? 0 : row->m_NativeBytes / frames);
		json.IntField("nativeFreed", row->m_NativeFreed);
		json.IntField("churn", row->m_Churn);
		json.IntField("live", row->m_Live);
		json.IntField("liveBytes", row->m_LiveBytes);
		json.Field("thread", row->m_FirstTrack < 0 ? Core::StringView("") : TrackLabel(capture, capture.m_Tracks[(int64)row->m_FirstTrack], capture.m_LastTicks).View());
		json.IntField("threads", row->m_Tracks.Count());
		json.EndObject();
	}

	static void FromEvents(IED::JsonWriter& json, const Capture& capture, const AllocAsk& ask, Range range) {
		AllocGrouper grouper(capture, ask.m_GroupBy);
		FrameTally tally;
		tally.Init(capture, range);
		const int64 churnTicks = capture.m_Clock.Ticks(c_ChurnWindowNs);
		Core::HashMap<uint64, AllocRow*> rowOf;
		Core::Array<AllocRow*> rows;
		int64 count = 0;
		int64 bytes = 0;
		int64 churn = 0;
		int64 live = 0;
		int64 liveBytes = 0;
		for (const Allocation& allocation : capture.m_Allocations) {
			if (!range.Holds(allocation.m_T)) continue;
			AllocRow* row = RowFor(rowOf, rows, grouper.KeyOf(allocation), allocation.m_Callstack);
			const int64 f = tally.Add(allocation);
			const bool freedSoon = allocation.m_Freed != c_Open && (tally.m_Set ? f >= 0 && allocation.m_Freed < tally.m_Set->m_Ends[f] : allocation.m_Freed - allocation.m_T <= churnTicks);
			const bool stays = allocation.m_Freed == c_Open || allocation.m_Freed >= range.m_End;
			row->m_Count += 1;
			row->m_Bytes += allocation.m_Size;
			if (freedSoon) row->m_Churn += 1;
			if (stays) {
				row->m_Live += 1;
				row->m_LiveBytes += allocation.m_Size;
			}
			if (row->m_FirstTrack < 0) row->m_FirstTrack = allocation.m_Track;
			if (!row->m_Tracks.Contains(allocation.m_Track)) row->m_Tracks.Insert(allocation.m_Track, true);
			count += 1;
			bytes += allocation.m_Size;
			churn += freedSoon ? 1 : 0;
			live += stays ? 1 : 0;
			liveBytes += stays ? allocation.m_Size : 0;
		}
		if (ask.m_ByBytes) rows.SortBy([](AllocRow* a, AllocRow* b) -> bool { return a->m_Bytes > b->m_Bytes; });
		else rows.SortBy([](AllocRow* a, AllocRow* b) -> bool { return a->m_Count > b->m_Count; });
		const double seconds = (double)capture.m_Clock.Ns(range.Length()) / 1e9;
		json.Field("source", "events");
		json.IntField("count", count);
		json.IntField("bytes", bytes);
		NumberField(json, "perSecond", seconds > 0.0 ? (double)count / seconds : 0.0, 1);
		NumberField(json, "bytesPerSecond", seconds > 0.0 ? (double)bytes / seconds : 0.0, 0);
		json.IntField("churn", churn);
		json.Field("churnWindow", tally.m_Set ? "frame" : "10 ms");
		json.IntField("live", live);
		json.IntField("liveBytes", liveBytes);
		WriteFrameTally(json, capture, tally);
		json.IntField("groupCount", rows.Count());
		json.Key(Core::StringView("groups"));
		json.BeginArray();
		for (int64 i = 0; i < rows.Count() && i < (int64)ask.m_Limit; ++i) WriteAllocRow(json, capture, grouper, rows[i], tally.Frames());
		json.EndArray();
	}

	// --- From samples -------------------------------------------------------------------------------------------------

	static bool IsAllocationSample(const SampleRecord& sample) {
		return sample.m_Kind == 2 || sample.m_Kind == 3;
	}

	// The allocation samples the capture has (a program's sampler, an imported heap profile).
	static int64 AllocationSampleCount(const Capture& capture) {
		int64 count = 0;
		for (const SampleRecord& sample : capture.m_Samples)
			if (IsAllocationSample(sample)) count += 1;
		return count;
	}

	static void WriteSampleLabel(IED::JsonWriter& json, const Capture& capture, const AllocAsk& ask, uint64 key, uint64 callstack) {
		if (ask.m_GroupBy == AllocGroup::Thread) {
			json.Field("label", TrackLabel(capture, capture.m_Tracks[(int64)key], capture.m_LastTicks).View());
			return;
		}
		const SymbolRecord* symbol = capture.m_Symbols.Find(LeafAddress(capture, callstack));
		json.Field("label", symbol ? capture.Text(symbol->m_FunctionStr) : Core::StringView("(unknown function)"));
		json.Field("file", symbol ? capture.SourceText(symbol->m_FileStr).View() : Core::StringView(""));
		json.IntField("line", symbol ? (int64)symbol->m_Line : 0);
		json.Key(Core::StringView("callstack"));
		WriteCallstack(json, capture, ask.m_GroupBy == AllocGroup::Callstack ? callstack : 0);
	}

	static void FromSamples(IED::JsonWriter& json, const Capture& capture, const AllocAsk& ask, Range range) {
		Core::HashMap<uint64, AllocRow*> rowOf;
		Core::Array<AllocRow*> rows;
		int64 weight = 0;
		int64 count = 0;
		int32 kind = 2;
		for (const SampleRecord& sample : capture.m_Samples) {
			if (!IsAllocationSample(sample) || !range.Holds(sample.m_T)) continue;
			kind = sample.m_Kind;
			const uint64 key = ask.m_GroupBy == AllocGroup::Thread ? (uint64)sample.m_Track : (ask.m_GroupBy == AllocGroup::Callstack ? sample.m_Callstack : LeafAddress(capture, sample.m_Callstack));
			AllocRow* row = RowFor(rowOf, rows, key, sample.m_Callstack);
			row->m_Count += 1;
			row->m_Bytes += sample.m_Weight;
			weight += sample.m_Weight;
			count += 1;
		}
		rows.SortBy([](AllocRow* a, AllocRow* b) -> bool { return a->m_Bytes > b->m_Bytes; });
		json.Field("source", count > 0 ? "samples" : "none");
		json.Field("unit", kind == 3 ? "objects" : "bytes");
		json.IntField("samples", count);
		json.IntField("weight", weight);
		json.IntField("groupCount", rows.Count());
		json.Key(Core::StringView("groups"));
		json.BeginArray();
		for (int64 i = 0; i < rows.Count() && i < (int64)ask.m_Limit; ++i) {
			json.BeginObject();
			WriteSampleLabel(json, capture, ask, rows[i]->m_Key, rows[i]->m_Callstack);
			json.IntField("samples", rows[i]->m_Count);
			json.IntField("weight", rows[i]->m_Bytes);
			NumberField(json, "share", weight == 0 ? 0.0 : (double)rows[i]->m_Bytes / (double)weight, 4);
			json.EndObject();
		}
		json.EndArray();
	}

	// --- From the zones' counts ----------------------------------------------------------------------------------

	static void FromZones(IED::JsonWriter& json, const Capture& capture, const AllocAsk& ask, Range range) {
		AllocAsk asked = ask;
		if (asked.m_GroupBy != AllocGroup::Path && asked.m_GroupBy != AllocGroup::Thread) asked.m_GroupBy = AllocGroup::Zone;
		AllocGrouper grouper(capture, asked.m_GroupBy);
		Core::HashMap<uint64, AllocRow*> rowOf;
		Core::Array<AllocRow*> rows;
		ZoneCounts inZones;
		AllocGrouper* g = &grouper;
		Core::HashMap<uint64, AllocRow*>* of = &rowOf;
		Core::Array<AllocRow*>* all = &rows;
		ZoneSelfAllocations(capture, range, [g, of, all, &inZones](int64 t, int64 d, int64 i, const ZoneCounts& counts) {
			AllocRow* row = RowFor(*of, *all, g->KeyOfZone(t, d, i), 0);
			row->m_Count += counts.m_Objects;
			row->m_Bytes += counts.m_Bytes;
			row->m_NativeBytes += counts.m_NativeBytes;
			row->m_NativeFreed += counts.m_NativeFreed;
			if (row->m_FirstTrack < 0) row->m_FirstTrack = (int32)t;
			if (!row->m_Tracks.Contains((int32)t)) row->m_Tracks.Insert((int32)t, true);
			inZones.m_Objects += counts.m_Objects;
			inZones.m_Bytes += counts.m_Bytes;
			inZones.m_NativeBytes += counts.m_NativeBytes;
			inZones.m_NativeFreed += counts.m_NativeFreed;
		});
		int64 count = inZones.m_Objects;
		int64 bytes = inZones.m_Bytes;
		if (!capture.m_AllocCounter.m_Times.IsEmpty()) CountedBetween(capture, range, count, bytes);
		FrameTally tally;
		tally.Init(capture, range);
		Core::Array<int64> frameObjects;
		Core::Array<int64> frameBytes;
		if (tally.Frames() > 0 && FrameAllocations(capture, tally.m_Set, frameObjects, frameBytes))
			for (int64 f = tally.m_First; f < tally.m_Last; ++f) {
				tally.m_Counts[f - tally.m_First] = frameObjects[f];
				tally.m_Bytes[f - tally.m_First] = frameBytes[f];
			}
		if (asked.m_ByBytes) rows.SortBy([](AllocRow* a, AllocRow* b) -> bool { return a->m_Bytes + a->m_NativeBytes > b->m_Bytes + b->m_NativeBytes; });
		else rows.SortBy([](AllocRow* a, AllocRow* b) -> bool { return a->m_Count > b->m_Count; });
		const double seconds = (double)capture.m_Clock.Ns(range.Length()) / 1e9;
		json.Field("source", "zones");
		json.IntField("count", count);
		json.IntField("bytes", bytes);
		json.IntField("inZones", inZones.m_Objects);
		json.IntField("inZoneBytes", inZones.m_Bytes);
		json.IntField("inZoneNativeBytes", inZones.m_NativeBytes);
		json.IntField("inZoneNativeFreed", inZones.m_NativeFreed);
		json.IntField("samples", AllocationSampleCount(capture));
		NumberField(json, "perSecond", seconds > 0.0 ? (double)count / seconds : 0.0, 1);
		NumberField(json, "bytesPerSecond", seconds > 0.0 ? (double)bytes / seconds : 0.0, 0);
		WriteFrameTally(json, capture, tally);
		json.IntField("groupCount", rows.Count());
		json.Key(Core::StringView("groups"));
		json.BeginArray();
		for (int64 i = 0; i < rows.Count() && i < (int64)asked.m_Limit; ++i) WriteAllocRow(json, capture, grouper, rows[i], tally.Frames());
		json.EndArray();
	}

	bool AllocSourceNamed(Core::StringView name, AllocSource& out) {
		if (name == "events") out = AllocSource::Events;
		else if (name == "zones") out = AllocSource::Zones;
		else if (name == "samples") out = AllocSource::Samples;
		else return false;
		return true;
	}

	static AllocSource SourceFor(const Capture& capture, const AllocAsk& ask) {
		if (ask.m_Source != AllocSource::Best) return ask.m_Source;
		if (!capture.m_Allocations.IsEmpty()) return AllocSource::Events;
		const bool counted = capture.m_ZoneAllocs > 0 || !capture.m_AllocCounter.m_Times.IsEmpty();
		if (counted && !((ask.m_GroupBy == AllocGroup::Callstack || ask.m_GroupBy == AllocGroup::Function) && AllocationSampleCount(capture) > 0)) return AllocSource::Zones;
		return AllocSource::Samples;
	}

	Core::String Allocations(const Capture& capture, const AllocAsk& ask) {
		const Range range = RangeOfNs(capture, ask.m_FromNs, ask.m_ToNs);
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("fromNs", capture.m_Clock.Ns(range.m_Begin));
		json.IntField("toNs", capture.m_Clock.Ns(range.m_End > capture.m_LastTicks ? capture.m_LastTicks : range.m_End));
		const AllocSource source = SourceFor(capture, ask);
		if (source == AllocSource::Events) FromEvents(json, capture, ask, range);
		else if (source == AllocSource::Zones) FromZones(json, capture, ask, range);
		else FromSamples(json, capture, ask, range);
		json.EndObject();
		return json.ToString();
	}
}
