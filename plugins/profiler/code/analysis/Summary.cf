// A capture at a glance (T-PRF-2), two captures compared (F-PRF-23, T-PRF-6), and the messages window (F-PRF-16).
include "Analysis.ch"
include "Locks.ch"

namespace Profiler
{
	const int32 c_SummaryZones = 10;
	const int32 c_SummaryWarnings = 10;
	const int32 c_SummaryLocks = 3;

	static void WriteThreads(IED::JsonWriter& json, const Capture& capture) {
		json.Key(Core::StringView("threads"));
		json.BeginArray();
		for (int64 i = 0; i < capture.m_Tracks.Count(); ++i) {
			const ThreadTrack* track = capture.m_Tracks[i];
			if (track->m_Zones == 0 && track->m_NameTimes.IsEmpty()) continue;
			json.BeginObject();
			json.IntField("track", i);
			json.Field("name", TrackLabel(capture, track, track->m_FirstTicks < 0 ? 0 : track->m_FirstTicks).View());
			json.IntField("zones", track->m_Zones);
			json.IntField("renames", track->m_NameTimes.Count() > 1 ? track->m_NameTimes.Count() - 1 : 0);
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteTopZones(IED::JsonWriter& json, const Capture& capture, const char* key, StatsOrder order) {
		StatsAsk ask;
		ask.m_Order = order;
		ask.m_Limit = c_SummaryZones;
		json.RawField(key, Stats(capture, ask).View());
	}

	static void WriteTasks(IED::JsonWriter& json, const Capture& capture) {
		json.Key(Core::StringView("tasks"));
		json.BeginArray();
		for (const TaskLane* lane : capture.m_TaskLanes) {
			int64 busy = 0;
			for (const TaskRuns* runs : lane->m_Runs)
				for (int64 i = 0; i < runs->m_Starts.Count(); ++i) busy += (runs->m_Ends[i] == c_Open ? capture.m_LastTicks : runs->m_Ends[i]) - runs->m_Starts[i];
			json.BeginObject();
			json.Field("name", capture.Text(lane->m_NameStr));
			json.IntField("runs", lane->m_Count);
			json.IntField("threads", lane->m_Runs.Count());
			json.IntField("busyNs", capture.m_Clock.Ns(busy));
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteMemory(IED::JsonWriter& json, const Capture& capture) {
		int64 live = 0;
		int64 liveBytes = 0;
		for (const Pool* pool : capture.m_Pools) {
			live += pool->m_Live.Count();
			liveBytes += pool->m_InUse;
		}
		int64 pause = 0;
		int64 longest = 0;
		for (const GcRecord& gc : capture.m_Gcs) {
			if (gc.m_End == c_Open) continue;
			pause += gc.m_End - gc.m_Begin;
			if (gc.m_End - gc.m_Begin > longest) longest = gc.m_End - gc.m_Begin;
		}
		json.Key(Core::StringView("memory"));
		json.BeginObject();
		json.IntField("pools", capture.m_Pools.Count());
		json.IntField("allocations", AllocationTotal(capture));
		json.IntField("censuses", capture.m_Censuses.Count());
		json.IntField("liveAtEnd", live);
		json.IntField("liveBytesAtEnd", liveBytes);
		json.IntField("collections", capture.m_Gcs.Count());
		json.IntField("gcPauseNs", capture.m_Clock.Ns(pause));
		json.IntField("gcLongestNs", capture.m_Clock.Ns(longest));
		json.EndObject();
	}

	static void WriteWarnings(IED::JsonWriter& json, const Capture& capture) {
		json.IntField("warningCount", capture.m_WarningCount);
		json.Key(Core::StringView("warnings"));
		json.BeginArray();
		for (int64 i = 0; i < capture.m_Warnings.Count() && i < (int64)c_SummaryWarnings; ++i) json.String(capture.m_Warnings[i].m_Text.View());
		json.EndArray();
	}

	Core::String Summary(const Capture& capture) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("app", capture.m_AppName.View());
		json.IntField("pid", (int64)capture.m_Pid);
		json.IntField("startUnixNs", capture.m_StartUnixNs);
		json.IntField("durationNs", capture.DurationNs());
		json.BoolField("live", !capture.m_Ended);
		json.IntField("events", capture.m_Events);
		json.IntField("bytes", capture.m_Bytes);
		json.IntField("zones", capture.ZoneCount());
		json.IntField("samples", capture.m_Samples.Count());
		json.IntField("messages", capture.m_Messages.Count());
		json.IntField("eventsDropped", (int64)capture.m_EventsDropped);
		json.Key(Core::StringView("frames"));
		const FrameSet* set = MainFrameSet(capture);
		if (!set) json.Null();
		else {
			Core::String frames = FrameGraph(capture, 1);
			json.Raw(frames.View());
		}
		WriteThreads(json, capture);
		WriteTopZones(json, capture, "topBySelf", StatsOrder::Self);
		WriteTopZones(json, capture, "topByTotal", StatsOrder::Total);
		WriteTasks(json, capture);
		WriteMemory(json, capture);
		json.Key(Core::StringView("gpu"));
		json.BeginArray();
		for (const GpuContext* gpu : capture.m_Gpus) {
			json.BeginObject();
			json.Field("queue", capture.Text(gpu->m_NameStr));
			json.IntField("zones", gpu->m_Zones.Count());
			json.BoolField("calibrated", !gpu->m_CalibrationGpu.IsEmpty());
			json.EndObject();
		}
		json.EndArray();
		WriteTopLocks(json, capture, c_SummaryLocks);
		WriteWarnings(json, capture);
		json.EndObject();
		return json.ToString();
	}

	// --- Compare ------------------------------------------------------------------------------------------------------

	struct SideTotals
	{
		public int64 m_Count;
		public int64 m_Total;
		public int64 m_Self;
	}

	static void TotalsByName(const Capture& capture, Core::HashMap<Core::String, SideTotals>& out) {
		for (const Core::KeyValue<uint64, SiteStats*>& entry : capture.m_Sites) {
			Core::String name = Core::String(capture.SiteName(entry.key));
			SideTotals* totals = out.Find(name);
			if (!totals) {
				SideTotals fresh;
				out.Insert(name, fresh);
				totals = out.Find(name);
			}
			totals->m_Count += entry.value->m_Count;
			totals->m_Total += capture.m_Clock.Ns(entry.value->m_Total);
			totals->m_Self += capture.m_Clock.Ns(entry.value->m_Self);
		}
	}

	static void WriteSide(IED::JsonWriter& json, const char* key, const SideTotals& side) {
		json.Key(Core::StringView(key));
		json.BeginObject();
		json.IntField("count", side.m_Count);
		json.IntField("totalNs", side.m_Total);
		json.IntField("selfNs", side.m_Self);
		json.IntField("meanNs", side.m_Count == 0 ? 0 : side.m_Total / side.m_Count);
		json.EndObject();
	}

	// One side's memory for a comparison: its allocations (and per frame), the highest any pool or memory plot got,
	// and its collections.
	static void WriteMemorySide(IED::JsonWriter& json, const char* key, const Capture& capture) {
		int64 peak = 0;
		for (const Pool* pool : capture.m_Pools)
			if (pool->m_Peak > peak) peak = pool->m_Peak;
		for (const Plot* plot : capture.m_Plots)
			if (plot->m_Kind == 1)
				for (double value : plot->m_Values)
					if ((int64)value > peak) peak = (int64)value;
		int64 pause = 0;
		int64 longest = 0;
		for (const GcRecord& gc : capture.m_Gcs) {
			if (gc.m_End == c_Open) continue;
			pause += gc.m_End - gc.m_Begin;
			if (gc.m_End - gc.m_Begin > longest) longest = gc.m_End - gc.m_Begin;
		}
		const FrameSet* set = MainFrameSet(capture);
		const int64 frames = set ? set->Completed() : 0;
		json.Key(Core::StringView(key));
		json.BeginObject();
		const int64 allocations = AllocationTotal(capture);
		json.IntField("allocations", allocations);
		NumberField(json, "allocationsPerFrame", frames == 0 ? 0.0 : (double)allocations / (double)frames, 1);
		json.IntField("peakBytes", peak);
		json.IntField("collections", capture.m_Gcs.Count());
		json.IntField("gcPauseNs", capture.m_Clock.Ns(pause));
		json.IntField("gcLongestNs", capture.m_Clock.Ns(longest));
		json.EndObject();
	}

	Core::String Compare(const Capture& a, const Capture& b, int32 limit) {
		Core::HashMap<Core::String, SideTotals> left;
		Core::HashMap<Core::String, SideTotals> right;
		TotalsByName(a, left);
		TotalsByName(b, right);
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, SideTotals>& entry : left) names.Push(entry.key);
		for (const Core::KeyValue<Core::String, SideTotals>& entry : right)
			if (!left.Find(entry.key)) names.Push(entry.key);
		Core::Array<int64> change;
		for (const Core::String& name : names) {
			SideTotals none;
			const SideTotals* l = left.Find(name);
			const SideTotals* r = right.Find(name);
			change.Push((r ? r->m_Total : 0) - (l ? l->m_Total : 0));
		}
		Core::Array<int64> order;
		for (int64 i = 0; i < names.Count(); ++i) order.Push(i);
		order.SortBy([&change](const int64& x, const int64& y) -> bool {
			const int64 cx = change[x] < 0 ? -change[x] : change[x];
			const int64 cy = change[y] < 0 ? -change[y] : change[y];
			return cx > cy;
		});
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("frames"));
		json.BeginObject();
		json.RawField("a", FrameGraph(a, 1).View());
		json.RawField("b", FrameGraph(b, 1).View());
		json.EndObject();
		json.IntField("durationANs", a.DurationNs());
		json.IntField("durationBNs", b.DurationNs());
		json.Key(Core::StringView("memory"));
		json.BeginObject();
		WriteMemorySide(json, "a", a);
		WriteMemorySide(json, "b", b);
		json.EndObject();
		json.Key(Core::StringView("zones"));
		json.BeginArray();
		for (int64 k = 0; k < order.Count() && k < (int64)limit; ++k) {
			const Core::String& name = names[order[k]];
			SideTotals none;
			const SideTotals* l = left.Find(name);
			const SideTotals* r = right.Find(name);
			json.BeginObject();
			json.Field("name", name.View());
			WriteSide(json, "a", l ? *l : none);
			WriteSide(json, "b", r ? *r : none);
			json.IntField("totalChangeNs", change[order[k]]);
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Messages -----------------------------------------------------------------------------------------------------

	Core::String Messages(const Capture& capture, int64 fromNs, int64 toNs, int32 leastSeverity, Core::StringView text, int64 offset, int32 limit) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		int64 matched = 0;
		for (const MessageRecord& message : capture.m_Messages) {
			if (!range.Holds(message.m_T) || message.m_Severity < leastSeverity || !ContainsNoCase(capture.Text(message.m_TextStr), text)) continue;
			matched += 1;
			if (matched <= offset || matched > offset + (int64)limit) continue;
			json.BeginObject();
			json.IntField("timeNs", capture.m_Clock.Ns(message.m_T));
			json.IntField("severity", message.m_Severity);
			json.Field("text", capture.Text(message.m_TextStr));
			json.Field("thread", TrackLabel(capture, capture.m_Tracks[message.m_Track], message.m_T).View());
			json.EndObject();
		}
		json.EndArray();
		json.IntField("total", matched);
		json.EndObject();
		return json.ToString();
	}
}
