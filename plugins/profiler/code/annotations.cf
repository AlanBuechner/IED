include "annotations.ch"

namespace Profiler
{
	static Annotation ReadOne(const Serialization::DomNode& node) {
		Annotation annotation;
		annotation.id = Core::String(node.Member("id").AsView());
		annotation.fromNs = node.Member("fromNs").AsInt();
		annotation.toNs = node.Member("toNs").IsValid() ? node.Member("toNs").AsInt() : annotation.fromNs;
		annotation.text = Core::String(node.Member("text").AsView());
		annotation.by = Core::String(node.Member("by").AsView().IsEmpty() ? Core::StringView("owner") : node.Member("by").AsView());
		annotation.createdUnixNs = node.Member("createdUnixNs").AsInt();
		return annotation;
	}

	Core::Array<Annotation> ReadAnnotations(Core::StringView metadata) {
		Core::Array<Annotation> annotations;
		if (metadata.Trimmed().IsEmpty()) return annotations;
		Serialization::DomDoc doc;
		Serialization::DomNode list = Serialization::ReadJson(metadata, doc).root.Member("annotations");
		for (int64 i = 0; i < list.Count(); ++i)
			if (!list.At(i).Member("id").AsView().IsEmpty()) annotations.Push(ReadOne(list.At(i)));
		return annotations;
	}

	void WriteAnnotation(IED::JsonWriter& json, const Annotation& annotation) {
		json.BeginObject();
		json.Field("id", annotation.id.View());
		json.IntField("fromNs", annotation.fromNs);
		json.IntField("toNs", annotation.toNs);
		json.Field("text", annotation.text.View());
		json.Field("by", annotation.by.View());
		json.IntField("createdUnixNs", annotation.createdUnixNs);
		json.EndObject();
	}

	void WriteAnnotations(IED::JsonWriter& json, const Core::Array<Annotation>& annotations) {
		json.BeginArray();
		for (const Annotation& annotation : annotations) WriteAnnotation(json, annotation);
		json.EndArray();
	}

	Core::String MetadataWith(Core::StringView metadata, const Core::Array<Annotation>& annotations) {
		Serialization::DomDoc doc;
		Serialization::DomNode root = metadata.Trimmed().IsEmpty() ? Serialization::DomNode() : Serialization::ReadJson(metadata, doc).root;
		IED::JsonWriter json;
		json.BeginObject();
		if (root.Kind() == Serialization::DomKind::Object)
			for (int64 i = 0; i < root.Count(); ++i) {
				if (root.KeyAt(i) == "annotations") continue;
				json.Key(root.KeyAt(i));
				json.Raw(IED::NodeJson(root.ValueAt(i)).View());
			}
		json.Key(Core::StringView("annotations"));
		WriteAnnotations(json, annotations);
		json.EndObject();
		return json.ToString();
	}

	static int64 NumberAfterN(Core::StringView id) {
		if (id.ByteLength() < 2 || id.ByteAt(0) != (int32)'n') return 0;
		int64 value = 0;
		for (int64 i = 1; i < id.ByteLength(); ++i) {
			const int32 c = id.ByteAt(i);
			if (c < (int32)'0' || c > (int32)'9') return 0;
			value = value * 10 + (int64)(c - (int32)'0');
		}
		return value;
	}

	Core::String NextAnnotationId(const Core::Array<Annotation>& annotations) {
		int64 most = 0;
		for (const Annotation& annotation : annotations) {
			const int64 n = NumberAfterN(annotation.id.View());
			if (n > most) most = n;
		}
		Core::StringBuilder id;
		id.AppendByte('n');
		id.AppendInt(most + 1);
		return id.ToString();
	}

	bool AnnotationText(Core::StringView given, Core::String& text, Core::String& problem) {
		Core::StringView trimmed = given.Trimmed();
		if (trimmed.IsEmpty()) problem = Core::String("an annotation needs text");
		else if (trimmed.ByteLength() > kMostAnnotationBytes) problem = Core::String("an annotation's text is at most 2000 bytes");
		else text = Core::String(trimmed);
		return problem.IsEmpty();
	}
}
