// Frames (F-PRF-10, F-PRF-11, T-PRF-4): the frame time graph over the whole capture, and one frame's breakdown - the
// work each thread did in it, its costliest zones, the collections and GPU work that fell in it.
include "analysis/Analysis.ch"

namespace Profiler
{
	const int32 c_BreakdownZones = 15;
	const int32 c_BreakdownTopLevel = 40;

	const FrameSet* MainFrameSet(const Capture& capture) {
		for (const FrameSet* set : capture.m_FrameSets)
			if (set->m_NameStr == 0 || capture.Text(set->m_NameStr).IsEmpty()) return set;
		return capture.m_FrameSets.IsEmpty() ? nullptr : capture.m_FrameSets[0];
	}

	static void FrameDurations(const FrameSet* set, Core::Array<int64>& out) {
		for (int64 i = 0; i < set->m_Starts.Count(); ++i)
			if (set->m_Ends[i] != c_Open) out.Push(set->m_Ends[i] - set->m_Starts[i]);
	}

	static void WriteFrameStats(IED::JsonWriter& json, const Capture& capture, const FrameSet* set) {
		Core::Array<int64> durations;
		if (set) FrameDurations(set, durations);
		int64 total = 0;
		for (int64 duration : durations) total += duration;
		durations.Sort();
		json.IntField("count", durations.Count());
		json.IntField("meanNs", durations.IsEmpty() ? 0 : capture.m_Clock.Ns(total / durations.Count()));
		json.IntField("medianNs", capture.m_Clock.Ns(Quantile(durations, 0.5)));
		json.IntField("p95Ns", capture.m_Clock.Ns(Quantile(durations, 0.95)));
		json.IntField("p99Ns", capture.m_Clock.Ns(Quantile(durations, 0.99)));
		json.IntField("maxNs", durations.IsEmpty() ? 0 : capture.m_Clock.Ns(durations.Back()));
		json.IntField("minNs", durations.IsEmpty() ? 0 : capture.m_Clock.Ns(durations[0]));
	}

	Core::String FrameGraph(const Capture& capture, int32 width) {
		const FrameSet* set = MainFrameSet(capture);
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("set", set && !capture.Text(set->m_NameStr).IsEmpty() ? capture.Text(set->m_NameStr) : Core::StringView("Frame"));
		WriteFrameStats(json, capture, set);
		json.Key(Core::StringView("bars"));
		json.BeginArray();
		const int64 count = set ? set->Completed() : 0;
		const int64 perBar = count <= (int64)width ? 1 : (count + (int64)width - 1) / (int64)width;
		for (int64 first = 0; first < count; first += perBar) {
			int64 worst = first;
			for (int64 i = first; i < first + perBar && i < count; ++i)
				if (set->m_Ends[i] - set->m_Starts[i] > set->m_Ends[worst] - set->m_Starts[worst]) worst = i;
			const int64 last = first + perBar < count ? first + perBar - 1 : count - 1;
			json.BeginArray();
			json.Int(worst);
			json.Int(capture.m_Clock.Ns(set->m_Ends[worst] - set->m_Starts[worst]));
			json.Int(capture.m_Clock.Ns(set->m_Starts[first]));
			json.Int(capture.m_Clock.Ns(set->m_Ends[last]));
			json.EndArray();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- One frame ----------------------------------------------------------------------------------------------------

	static int64 WorstFrame(const FrameSet* set) {
		int64 worst = -1;
		for (int64 i = 0; i < set->m_Starts.Count(); ++i) {
			if (set->m_Ends[i] == c_Open) continue;
			if (worst < 0 || set->m_Ends[i] - set->m_Starts[i] > set->m_Ends[worst] - set->m_Starts[worst]) worst = i;
		}
		return worst;
	}

	static void WriteThreadWork(IED::JsonWriter& json, const Capture& capture, Range frame) {
		json.Key(Core::StringView("threads"));
		json.BeginArray();
		for (int64 t = 0; t < capture.m_Tracks.Count(); ++t) {
			const ThreadTrack* track = capture.m_Tracks[t];
			if (track->m_Levels.IsEmpty()) continue;
			const ZoneLevel* top = track->m_Levels[0];
			int64 busy = 0;
			const int64 stop = top->FirstStartingAt(frame.m_End);
			int64 first = top->FirstEndingAfter(frame.m_Begin);
			if (first >= stop) continue;
			json.BeginObject();
			json.Field("thread", TrackLabel(capture, track, frame.m_Begin).View());
			json.Key(Core::StringView("zones"));
			json.BeginArray();
			for (int64 i = first; i < stop; ++i) {
				const int64 start = top->m_Starts[i] < frame.m_Begin ? frame.m_Begin : top->m_Starts[i];
				int64 end = top->EndOr(i, capture.m_LastTicks);
				if (end > frame.m_End) end = frame.m_End;
				busy += end - start;
				if (i - first >= (int64)c_BreakdownTopLevel) continue;
				json.BeginObject();
				json.Field("name", capture.ZoneName(track, top, i));
				json.Field("ref", ZoneRef::Of(t, 0, i).Text().View());
				json.IntField("startNs", capture.m_Clock.Ns(top->m_Starts[i]));
				json.IntField("durationNs", capture.m_Clock.Ns(top->EndOr(i, capture.m_LastTicks) - top->m_Starts[i]));
				json.EndObject();
			}
			json.EndArray();
			json.IntField("busyNs", capture.m_Clock.Ns(busy));
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteFrameGcs(IED::JsonWriter& json, const Capture& capture, Range frame) {
		json.Key(Core::StringView("gc"));
		json.BeginArray();
		for (const GcRecord& gc : capture.m_Gcs) {
			if (gc.m_End == c_Open || !frame.Overlaps(gc.m_Begin, gc.m_End + 1)) continue;
			json.BeginObject();
			json.IntField("startNs", capture.m_Clock.Ns(gc.m_Begin));
			json.IntField("pauseNs", capture.m_Clock.Ns(gc.m_End - gc.m_Begin));
			json.IntField("generation", gc.m_Generation);
			json.IntField("freedBytes", gc.Freed());
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteFrameGpu(IED::JsonWriter& json, const Capture& capture, Range frame) {
		json.Key(Core::StringView("gpu"));
		json.BeginArray();
		for (const GpuContext* gpu : capture.m_Gpus) {
			for (const GpuZone& zone : gpu->m_Zones) {
				int64 cpuBegin;
				int64 cpuEnd;
				if (zone.m_Depth != 0 || !gpu->Span(zone, capture.m_Clock, capture.m_ClockFreqHz, cpuBegin, cpuEnd)) continue;
				if (!frame.Holds(zone.m_CpuBegin)) continue;
				json.BeginObject();
				json.Field("queue", capture.Text(gpu->m_NameStr));
				json.Field("name", capture.SiteName((uint64)zone.m_Site));
				json.IntField("durationNs", capture.m_Clock.Ns(cpuEnd - cpuBegin));
				json.EndObject();
			}
		}
		json.EndArray();
	}

	Core::String FrameBreakdown(const Capture& capture, int64 index) {
		const FrameSet* set = MainFrameSet(capture);
		if (!set) return Core::String();
		const int64 i = index < 0 ? WorstFrame(set) : index;
		if (i < 0 || i >= set->m_Starts.Count() || set->m_Ends[i] == c_Open) return Core::String();
		Range frame;
		frame.m_Begin = set->m_Starts[i];
		frame.m_End = set->m_Ends[i];
		StatsAsk top;
		top.m_FromNs = capture.m_Clock.Ns(frame.m_Begin);
		top.m_ToNs = capture.m_Clock.Ns(frame.m_End);
		top.m_Order = StatsOrder::Self;
		top.m_Limit = c_BreakdownZones;
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("index", i);
		json.IntField("startNs", capture.m_Clock.Ns(frame.m_Begin));
		json.IntField("durationNs", capture.m_Clock.Ns(frame.Length()));
		json.Key(Core::StringView("frames"));
		json.BeginObject();
		WriteFrameStats(json, capture, set);
		json.EndObject();
		WriteThreadWork(json, capture, frame);
		json.RawField("topZones", Stats(capture, top).View());
		WriteFrameGcs(json, capture, frame);
		WriteFrameGpu(json, capture, frame);
		json.EndObject();
		return json.ToString();
	}
}
