// The investigation analyses (T-PRF-13 to T-PRF-18): allocations by zone and path, churn and what stays live, leaks
// that keep accumulating, a pool's rising floor and a teardown, slow frames and their causes, thread use, a window in
// order, what happened inside a zone, and allocation samples by function - checked on a capture built event by event.

include "investigate.ch"
include "ingest.ch"

// Sites (strings of the same ids): 1 Frame, 2 Spawn, 3 Cache, 4 Stream, 5 Work.
//   main (thread 1) marks a frame every 100 ns from 0 to 1100, but frame 5 runs 500..800: there Stream (4) takes 200 ns.
//     Each frame: Frame 0..50 (260 in frame 5), in it Spawn 10..20 and Cache 30..31.
//     Spawn allocates two 100-byte blocks at +15, freed at +25; Cache allocates 1000 bytes at +30, never freed.
//   worker (thread 2) runs Work 40 ns of every 50, all the time.
static Profiler::Capture* InvestigateCapture() {
	Profiler::WireWriter w;
	w.BeginChunk(Profiler::kGlobalChunk, 0, 0);
	w.Type(Profiler::EventType::Hello);
	w.Varint(1);
	w.Text(Core::StringView("game"));
	w.Varint(9);
	w.Varint(1000000000);
	w.Varint(0);
	w.Varint(0);
	w.Varint(0);
	w.Text(Core::StringView(""));
	const char*[6] names = { "", "Frame", "Spawn", "Cache", "Stream", "Work" };
	for (uint64 id = 1; id <= 5; ++id) {
		w.Type(Profiler::EventType::StringDef);
		w.Varint(id);
		w.Text(Core::StringView(names[id]));
		w.Type(Profiler::EventType::SrcLocDef);
		w.Varint(id);
		w.Varint(id);
		w.Varint(0);
		w.Varint(0);
		w.Varint(id * 10);
		w.Varint(0);
	}
	w.EndChunk();
	MainThread(w);
	WorkerThread(w);
	Allocations(w);
	return Applied(w);
}

static int64 FrameStart(int64 f) {
	return f <= 5 ? f * 100 : f * 100 + 200;
}

static void Zone(Profiler::WireWriter& w, uint64 site, int64 begin, int64 end) {
	w.Type(Profiler::EventType::ZoneBegin);
	w.Time(begin);
	w.Varint(site);
	w.Type(Profiler::EventType::ZoneEnd);
	w.Time(end);
}

static void MainThread(Profiler::WireWriter& w) {
	w.BeginChunk(Profiler::kThreadChunk, 1, 0);
	for (int64 f = 0; f < 10; ++f) {
		const int64 t = FrameStart(f);
		w.Type(Profiler::EventType::FrameMark);
		w.Time(t);
		w.Varint(0);
		if (f == 9) break;
		w.Type(Profiler::EventType::ZoneBegin);
		w.Time(t);
		w.Varint(1);
		Zone(w, 2, t + 10, t + 20);
		Zone(w, 3, t + 30, t + 31);
		if (f == 5) Zone(w, 4, t + 40, t + 240);
		w.Type(Profiler::EventType::ZoneEnd);
		w.Time(f == 5 ? t + 260 : t + 50);
	}
	w.EndChunk();
}

static void WorkerThread(Profiler::WireWriter& w) {
	w.BeginChunk(Profiler::kThreadChunk, 2, 0);
	for (int64 t = 0; t < 1100; t += 50) Zone(w, 5, t, t + 40);
	w.EndChunk();
}

static void Alloc(Profiler::WireWriter& w, int64 t, uint64 address, uint64 size) {
	w.Type(Profiler::EventType::Alloc);
	w.Time(t);
	w.Varint(1);
	w.Varint(0);
	w.Varint(address);
	w.Varint(size);
	w.Varint(0);
}

static void Free(Profiler::WireWriter& w, int64 t, uint64 address) {
	w.Type(Profiler::EventType::Free);
	w.Time(t);
	w.Varint(1);
	w.Varint(0);
	w.Varint(address);
}

static void Allocations(Profiler::WireWriter& w) {
	w.BeginChunk(Profiler::kGlobalChunk, 0, 0);
	for (int64 f = 0; f < 9; ++f) {
		const int64 t = FrameStart(f);
		const uint64 base = 0x10000 + (uint64)f * 0x100;
		Alloc(w, t + 15, base, 100);
		Alloc(w, t + 15, base + 0x40, 100);
		Free(w, t + 25, base);
		Free(w, t + 25, base + 0x40);
		Alloc(w, t + 30, 0x90000 + (uint64)f * 0x1000, 1000);
	}
	w.EndChunk();
}

static Profiler::Capture* Applied(const Profiler::WireWriter& w) {
	Profiler::Capture* capture = new Profiler::Capture();
	Profiler::ChunkStream stream;
	stream.Feed(w.Bytes().Data(), w.Length());
	const uint8* chunk;
	int64 length;
	while (stream.Next(chunk, length)) Profiler::ApplyChunk(*capture, chunk, length);
	Profiler::Finish(*capture);
	return capture;
}

static Serialization::DomNode Read(const Core::String& json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Serialization::ReadJson(json.View(), *doc).root;
}

[test("server.profiler.investigate")]
class ProfilerInvestigateTests {
	[test("allocations_by_zone")]
	public static void TestAllocationsByZone() {
		Profiler::Capture* capture = InvestigateCapture();
		Profiler::AllocAsk ask;
		ask.groupBy = Profiler::AllocGroup::Zone;
		Serialization::DomNode a = Read(Profiler::Allocations(*capture, ask));
		assert_true(a.Member("source").AsView() == "events" && a.Member("count").AsInt() == 27, "every allocation counted");
		assert_true(a.Member("churn").AsInt() == 18 && a.Member("live").AsInt() == 9, "Spawn's blocks die in their frame, Cache's live on");
		assert_true(a.Member("frames").Member("count").AsInt() == 9 && a.Member("frames").Member("medianCount").AsInt() == 3, "three a frame");
		Serialization::DomNode first = a.Member("groups").At(0);
		assert_true(first.Member("label").AsView() == "Spawn" && first.Member("count").AsInt() == 18 && first.Member("line").AsInt() == 20, "most from Spawn, with its line");
		assert_true(first.Member("perFrame").AsFloat() == 2.0 && first.Member("churn").AsInt() == 18 && first.Member("live").AsInt() == 0, "two a frame, all churn");
		ask.byBytes = true;
		assert_true(Read(Profiler::Allocations(*capture, ask)).Member("groups").At(0).Member("label").AsView() == "Cache", "the most bytes from Cache");
		ask.groupBy = Profiler::AllocGroup::Path;
		assert_true(Read(Profiler::Allocations(*capture, ask)).Member("groups").At(0).Member("label").AsView() == "Frame > Cache", "the path down to it");
		ask.groupBy = Profiler::AllocGroup::Size;
		assert_true(Read(Profiler::Allocations(*capture, ask)).Member("groups").At(0).Member("label").AsView() == "257 B-1 KiB", "by size class");
	}

	[test("leaks_that_keep_accumulating")]
	public static void TestLeaks() {
		Profiler::Capture* capture = InvestigateCapture();
		Profiler::LeakAsk ask;
		ask.groupBy = Profiler::AllocGroup::Zone;
		Serialization::DomNode leaks = Read(Profiler::Leaks(*capture, ask));
		Serialization::DomNode cache = leaks.Member("groups").At(0);
		assert_true(leaks.Member("count").AsInt() == 9 && cache.Member("label").AsView() == "Cache", "Cache's blocks are what is live");
		assert_true(cache.Member("accumulating").AsBool() == false, "nine are too few to call a leak");
		ask.fromNs = 400;
		ask.toNs = 900;
		assert_true(Read(Profiler::Leaks(*capture, ask)).Member("count").AsInt() == 3, "only those made in the window");
		assert_true(Profiler::TeardownAt(*capture) == -1, "no teardown: nothing was freed at the end");
	}

	[test("memory_over_time")]
	public static void TestMemoryTrend() {
		Profiler::Capture* capture = InvestigateCapture();
		Serialization::DomNode m = Read(Profiler::MemoryTrend(*capture, -1, -1, 10));
		Serialization::DomNode heap = m.Member("series").At(0);
		assert_true(heap.Member("kind").AsView() == "pool" && heap.Member("name").AsView() == "heap", "the default pool");
		assert_true(heap.Member("floorRises").AsInt() >= 7 && heap.Member("floorPeak").AsFloat() >= 7000.0, "its floor keeps rising: Cache's blocks");
		assert_true(heap.Member("peak").AsFloat() == 9000.0, "its peak");
		assert_true(m.Member("gc").Member("count").AsInt() == 0 && m.Member("teardownNs").AsInt() == -1, "no collections, no teardown");
	}

	[test("slow_frames_and_their_causes")]
	public static void TestHitches() {
		Profiler::Capture* capture = InvestigateCapture();
		Profiler::HitchAsk ask;
		Serialization::DomNode h = Read(Profiler::Hitches(*capture, ask));
		assert_true(h.Member("frames").AsInt() == 9 && h.Member("medianNs").AsInt() == 100 && h.Member("slow").AsInt() == 1, "frame 5 is the slow one");
		Serialization::DomNode frame = h.Member("list").At(0);
		assert_true(frame.Member("index").AsInt() == 5 && frame.Member("durationNs").AsInt() == 300, "its index and length");
		assert_true(frame.Member("zones").At(0).Member("name").AsView() == "Stream" && frame.Member("zones").At(0).Member("selfNs").AsInt() == 200, "Stream made it slow");
		assert_true(frame.Member("frameThreadBusyNs").AsInt() == 260, "main was busy 260 of its 300 ns");
		bool workBlamed = false;
		for (int64 i = 0; i < frame.Member("zones").Count(); ++i)
			if (frame.Member("zones").At(i).Member("name").AsView() == "Work") workBlamed = true;
		assert_true(!workBlamed, "the worker did more in a longer frame, which slowed nothing");
		assert_true(h.Member("causes").At(0).Member("name").AsView() == "Stream" && h.Member("causes").At(0).Member("frames").AsInt() == 1, "the causes counted");
		ask.thresholdNs = 1000;
		assert_true(Read(Profiler::Hitches(*capture, ask)).Member("slow").AsInt() == 0, "none over a higher threshold");
	}

	[test("threads_busy_and_idle")]
	public static void TestThreads() {
		Profiler::Capture* capture = InvestigateCapture();
		Serialization::DomNode t = Read(Profiler::Threads(*capture, -1, -1));
		Serialization::DomNode worker = t.Member("threads").At(0);
		Serialization::DomNode main = t.Member("threads").At(1);
		assert_true(worker.Member("busyNs").AsInt() == 880 && worker.Member("longestIdleNs").AsInt() == 10, "the worker is busiest, idle 10 ns at a time");
		assert_true(main.Member("marksFrames").AsBool() && !worker.Member("marksFrames").AsBool(), "main marks the frames");
		assert_true(main.Member("top").At(0).Member("name").AsView() == "Frame" && main.Member("top").At(1).Member("name").AsView() == "Stream", "main's costliest zones by their own time");
	}

	[test("a_window_in_order")]
	public static void TestWindow() {
		Profiler::Capture* capture = InvestigateCapture();
		Profiler::WindowAsk ask;
		ask.fromNs = 500;
		ask.toNs = 800;
		ask.depth = 1;
		ask.thread = Core::String("Thread 1");
		Serialization::DomNode w = Read(Profiler::Window(*capture, ask));
		Serialization::DomNode entries = w.Member("threads").At(0).Member("entries");
		assert_true(w.Member("threads").Count() == 1 && entries.Count() == 4, "main's Frame and its three zones");
		assert_true(entries.At(0).Member("name").AsView() == "Frame" && entries.At(0).Member("allocations").AsInt() == 3, "the frame's zone first, with its allocations");
		assert_true(entries.At(3).Member("name").AsView() == "Stream" && entries.At(3).Member("ref").AsView() == "0:1:12", "then in time order, with refs");
		ask.limit = 2;
		assert_true(Read(Profiler::Window(*capture, ask)).Member("left").AsInt() == 2, "the rest counted when they do not fit");
	}

	[test("inside_a_zone")]
	public static void TestInside() {
		Profiler::Capture* capture = InvestigateCapture();
		Profiler::ZoneRef ref;
		assert_true(Profiler::ZoneRef::Parse(Core::StringView("0:0:5"), ref), "a ref");
		Serialization::DomNode inside = Read(Profiler::ZoneDetails(*capture, ref)).Member("inside");
		assert_true(inside.Member("allocations").Member("count").AsInt() == 3 && inside.Member("allocations").Member("freedInside").AsInt() == 2, "the frame zone's three allocations, two freed in it");
		assert_true(inside.Member("waitNs").AsInt() == 0 && inside.Member("gcCount").AsInt() == 0, "no waits, no collections");
	}

	[test("allocation_samples_by_function")]
	public static void TestSamples() {
		Profiler::WireWriter w;
		w.BeginChunk(Profiler::kGlobalChunk, 0, 0);
		w.Type(Profiler::EventType::Hello);
		w.Varint(1);
		w.Text(Core::StringView("go"));
		w.Varint(1);
		w.Varint(1000000000);
		w.Varint(0);
		w.Varint(0);
		w.Varint(0);
		w.Text(Core::StringView(""));
		const char*[3] functions = { "", "main.spawn", "main.load" };
		for (uint64 id = 1; id <= 2; ++id) {
			w.Type(Profiler::EventType::StringDef);
			w.Varint(id);
			w.Text(Core::StringView(functions[id]));
			w.Type(Profiler::EventType::SymbolDef);
			w.Varint(id);
			w.Varint(id);
			w.Varint(0);
			w.Varint(id * 7);
			w.Type(Profiler::EventType::CallstackDef);
			w.Varint(id);
			w.Varint(1);
			w.Varint(id);
		}
		const int64[3] weights = { 0, 3000, 1000 };
		for (int64 i = 0; i < 4; ++i) {
			w.Type(Profiler::EventType::Sample);
			w.Time(i * 10);
			w.Varint(0);
			w.Varint((uint64)(i % 2 + 1));
			w.Varint(2);
			w.Varint((uint64)weights[i % 2 + 1]);
		}
		w.EndChunk();
		Profiler::AllocAsk ask;
		ask.groupBy = Profiler::AllocGroup::Zone;
		Serialization::DomNode a = Read(Profiler::Allocations(*Applied(w), ask));
		assert_true(a.Member("source").AsView() == "samples" && a.Member("weight").AsInt() == 8000, "the samples' bytes");
		Serialization::DomNode top = a.Member("groups").At(0);
		assert_true(top.Member("label").AsView() == "main.spawn" && top.Member("weight").AsInt() == 6000 && top.Member("line").AsInt() == 7, "by function, the most first");
	}
}
