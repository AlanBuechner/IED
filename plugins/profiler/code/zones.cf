include "zones.ch"

namespace Profiler
{
	int64 ZoneLevel::FirstStartingAt(int64 t) const {
		return starts.LowerBound(t);
	}

	int64 ZoneLevel::FirstEndingAfter(int64 t) const {
		const int64 i = starts.UpperBound(t);
		if (i == 0) return 0;
		const int64 before = i - 1;
		return ends[before] == kOpen || ends[before] > t ? before : i;
	}

	ZoneRef ZoneRef::Of(int64 track, int64 depth, int64 index) {
		ZoneRef ref;
		ref.bits = ((uint64)track << 48) | (((uint64)depth & 0xFF) << 40) | ((uint64)index & 0xFFFFFFFFFF);
		return ref;
	}

	Core::String ZoneRef::Text() const {
		Core::StringBuilder text;
		text.AppendInt(Track());
		text.AppendByte(':');
		text.AppendInt(Depth());
		text.AppendByte(':');
		text.AppendInt(Index());
		return text.ToString();
	}

	static bool ReadNumber(Core::StringView text, int64& at, int64& out) {
		const int64 start = at;
		int64 value = 0;
		while (at < text.ByteLength() && text.Data()[at] >= '0' && text.Data()[at] <= '9' && at - start < 15) {
			value = value * 10 + (int64)(text.Data()[at] - '0');
			at += 1;
		}
		out = value;
		return at > start;
	}

	bool ZoneRef::Parse(Core::StringView text, ZoneRef& out) {
		int64 at = 0;
		int64 track;
		int64 depth;
		int64 index;
		if (!ReadNumber(text, at, track) || at >= text.ByteLength() || text.Data()[at] != ':') return false;
		at += 1;
		if (!ReadNumber(text, at, depth) || at >= text.ByteLength() || text.Data()[at] != ':') return false;
		at += 1;
		if (!ReadNumber(text, at, index) || at != text.ByteLength()) return false;
		if (track > 0xFFFF || depth > kMostDepth) return false;
		out = Of(track, depth, index);
		return true;
	}
}
