// Allocations a client counted instead of sending each one (docs/16 ZoneAllocs, ZoneNative, AllocCount): what each
// zone allocated itself - its counts less its children's - and the allocations in each frame, from whichever the
// capture has.
include "investigate.ch"

namespace Profiler
{
	ZoneCounts ZoneCountsOf(const ThreadTrack* track, const ZoneLevel* level, int64 i) {
		ZoneCounts counts;
		const uint32 index = level->extras[i];
		if (index == 0) return counts;
		const ZoneExtra& extra = track->extras[(int64)index - 1];
		counts.objects = (int64)extra.allocObjects;
		counts.bytes = (int64)extra.allocBytes;
		counts.nativeBytes = (int64)extra.nativeBytes;
		counts.nativeFreed = (int64)extra.nativeFreed;
		return counts;
	}

	static void TakeChild(ZoneCounts& parent, const ZoneCounts& child) {
		parent.objects -= child.objects;
		parent.bytes -= child.bytes;
		parent.nativeBytes -= child.nativeBytes;
		parent.nativeFreed -= child.nativeFreed;
	}

	// A zone's own counts can only fall below zero by a client's rounding; none is taken as none.
	static ZoneCounts NoneBelowZero(ZoneCounts counts) {
		if (counts.objects < 0) counts.objects = 0;
		if (counts.bytes < 0) counts.bytes = 0;
		if (counts.nativeBytes < 0) counts.nativeBytes = 0;
		if (counts.nativeFreed < 0) counts.nativeFreed = 0;
		return counts;
	}

	void ZoneSelfAllocations(const Capture& capture, Range range, const func<void(int64, int64, int64, const ZoneCounts&)>& visit) {
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const ThreadTrack* track = capture.tracks[t];
			Core::Array<Core::Array<ZoneCounts>*> own;
			for (int64 d = 0; d < track->levels.Count(); ++d) {
				const ZoneLevel* level = track->levels[d];
				Core::Array<ZoneCounts>* counts = new Core::Array<ZoneCounts>();
				for (int64 i = 0; i < level->Count(); ++i) counts->Push(ZoneCountsOf(track, level, i));
				own.Push(counts);
			}
			for (int64 d = 1; d < track->levels.Count(); ++d) {
				const ZoneLevel* parents = track->levels[d - 1];
				const ZoneLevel* level = track->levels[d];
				for (int64 j = 0; j < level->Count(); ++j) {
					const ZoneCounts child = ZoneCountsOf(track, level, j);
					if (child.IsEmpty()) continue;
					const int64 i = parents->FirstEndingAfter(level->starts[j]);
					if (i >= parents->Count() || parents->starts[i] > level->starts[j]) continue;
					TakeChild((*own[d - 1])[i], child);
				}
			}
			for (int64 d = 0; d < track->levels.Count(); ++d) {
				const ZoneLevel* level = track->levels[d];
				const int64 stop = level->FirstStartingAt(range.end);
				for (int64 i = level->FirstStartingAt(range.begin); i < stop; ++i) {
					const ZoneCounts counts = NoneBelowZero((*own[d])[i]);
					if (!counts.IsEmpty()) visit(t, d, i, counts);
				}
			}
		}
	}

	ZoneCounts ZoneOwnCounts(const Capture& capture, ZoneRef ref) {
		const ThreadTrack* track = capture.tracks[ref.Track()];
		const ZoneLevel* level = track->levels[ref.Depth()];
		const int64 i = ref.Index();
		ZoneCounts counts = ZoneCountsOf(track, level, i);
		if (ref.Depth() + 1 < track->levels.Count()) {
			const ZoneLevel* children = track->levels[ref.Depth() + 1];
			const int64 end = level->EndOr(i, capture.lastTicks);
			for (int64 j = children->FirstStartingAt(level->starts[i]); j < children->Count() && children->starts[j] < end; ++j) TakeChild(counts, ZoneCountsOf(track, children, j));
		}
		return NoneBelowZero(counts);
	}

	// The process's allocations so far at `t`: the last count at or before it.
	static void CountedAt(const AllocCounter& counter, int64 t, int64& objects, int64& bytes) {
		const int64 i = counter.times.UpperBound(t) - 1;
		objects = i < 0 ? 0 : counter.objects[i];
		bytes = i < 0 ? 0 : counter.bytes[i];
	}

	void CountedBetween(const Capture& capture, Range range, int64& objects, int64& bytes) {
		int64 beginObjects;
		int64 beginBytes;
		CountedAt(capture.allocCounter, range.begin, beginObjects, beginBytes);
		CountedAt(capture.allocCounter, range.end, objects, bytes);
		objects -= beginObjects;
		bytes -= beginBytes;
	}

	bool FrameAllocations(const Capture& capture, const FrameSet* set, Core::Array<int64>& objects, Core::Array<int64>& bytes) {
		if (!set) return false;
		objects.Resize(set->starts.Count());
		bytes.Resize(set->starts.Count());
		if (!capture.allocations.IsEmpty()) {
			for (const Allocation& allocation : capture.allocations) {
				const int64 f = FrameAt(set, allocation.t);
				if (f < 0) continue;
				objects[f] += 1;
				bytes[f] += allocation.size;
			}
			return true;
		}
		if (!capture.allocCounter.times.IsEmpty()) {
			for (int64 f = 0; f < set->starts.Count(); ++f) {
				if (set->ends[f] == kOpen) continue;
				Range frame;
				frame.begin = set->starts[f];
				frame.end = set->ends[f];
				CountedBetween(capture, frame, objects[f], bytes[f]);
			}
			return true;
		}
		if (capture.zoneAllocs == 0) return false;
		Core::Array<int64>* o = &objects;
		Core::Array<int64>* b = &bytes;
		ZoneSelfAllocations(capture, Everything(capture), [&capture, set, o, b](int64 t, int64 d, int64 i, const ZoneCounts& counts) {
			const int64 f = FrameAt(set, capture.tracks[t]->levels[d]->starts[i]);
			if (f < 0) return;
			(*o)[f] += counts.objects;
			(*b)[f] += counts.bytes;
		});
		return true;
	}

	int64 AllocationTotal(const Capture& capture) {
		if (!capture.allocations.IsEmpty()) return capture.allocations.Count();
		if (!capture.allocCounter.objects.IsEmpty()) return capture.allocCounter.objects.Back();
		int64 total = 0;
		ZoneSelfAllocations(capture, Everything(capture), [&total](int64 t, int64 d, int64 i, const ZoneCounts& counts) { total += counts.objects; });
		return total;
	}
}
