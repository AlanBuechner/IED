// Statistics per zone (F-PRF-20, F-PRF-24) and find zone (F-PRF-21).
include "analysis.ch"

namespace Profiler
{
	// The durations and totals of one row: a site, or a site on one thread or in one task.
	class StatsRow
	{
		public uint64 site;
		public uint64 group;             // track index + 1, or a task name id; 0 when not grouped
		public int64 count;
		public int64 total;
		public int64 self;
		public int64 least = -1;
		public int64 most;
		public Core::Array<int64> durations;

		public void Add(int64 duration, int64 selfTicks) {
			count += 1;
			total += duration;
			self += selfTicks;
			if (least < 0 || duration < least) least = duration;
			if (duration > most) most = duration;
			durations.Push(duration);
		}
	}

	bool ContainsNoCase(Core::StringView text, Core::StringView part) {
		if (part.IsEmpty()) return true;
		const int64 n = text.ByteLength();
		const int64 m = part.ByteLength();
		for (int64 i = 0; i + m <= n; ++i) {
			int64 j = 0;
			while (j < m) {
				char a = text.Data()[i + j];
				char b = part.Data()[j];
				if (a >= 'A' && a <= 'Z') a = (char)(a + 32);
				if (b >= 'A' && b <= 'Z') b = (char)(b + 32);
				if (a != b) break;
				j += 1;
			}
			if (j == m) return true;
		}
		return false;
	}

	// Calls `visit(trackIndex, depth, index)` for each zone that starts in `range`.
	static void EachZoneIn(const Capture& capture, Range range, const func<void(int64, int64, int64)>& visit) {
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const ThreadTrack* track = capture.tracks[t];
			for (int64 depth = 0; depth < track->levels.Count(); ++depth) {
				const ZoneLevel* level = track->levels[depth];
				const int64 stop = level->FirstStartingAt(range.end);
				for (int64 i = level->FirstStartingAt(range.begin); i < stop; ++i) visit(t, depth, i);
			}
		}
	}

	static uint64 GroupOf(const Capture& capture, GroupBy groupBy, int64 track, int64 start) {
		if (groupBy == GroupBy::Thread) return (uint64)track + 1;
		if (groupBy == GroupBy::Task) return TaskNameAt(capture, (int32)track, start);
		return 0;
	}

	static void Gather(const Capture& capture, const StatsAsk& ask, Range range, Core::Array<StatsRow*>& rows) {
		Core::HashMap<uint64, StatsRow*> rowOf;
		Core::HashMap<uint64, bool> matches;
		const int64 now = capture.lastTicks;
		EachZoneIn(capture, range, [&capture, &ask, &rows, &rowOf, &matches, now](int64 t, int64 depth, int64 i) {
			const ZoneLevel* level = capture.tracks[t]->levels[depth];
			const uint64 site = (uint64)level->sites[i];
			bool shown;
			if (!matches.TryGet(site, shown)) {
				shown = ContainsNoCase(capture.SiteName(site), ask.filter.View());
				matches.Insert(site, shown);
			}
			if (!shown || level->ends[i] == kOpen) return;
			const uint64 group = GroupOf(capture, ask.groupBy, t, level->starts[i]);
			const uint64 key = (site << 24) ^ group;
			StatsRow* row = nullptr;
			if (!rowOf.TryGet(key, row)) {
				row = new StatsRow();
				row->site = site;
				row->group = group;
				rows.Push(row);
				rowOf.Insert(key, row);
			}
			row->Add(level->EndOr(i, now) - level->starts[i], level->selfs[i]);
		});
	}

	static int64 Mean(const StatsRow* row) { return row->count == 0 ? 0 : row->total / row->count; }

	static bool Before(const Capture& capture, StatsOrder order, const StatsRow* a, const StatsRow* b) {
		if (order == StatsOrder::Self) return a->self > b->self;
		if (order == StatsOrder::Count) return a->count > b->count;
		if (order == StatsOrder::Mean) return Mean(a) > Mean(b);
		if (order == StatsOrder::Max) return a->most > b->most;
		if (order == StatsOrder::Name) return capture.SiteName(a->site) < capture.SiteName(b->site);
		return a->total > b->total;
	}

	static void WriteGroup(IED::JsonWriter& json, const Capture& capture, GroupBy groupBy, uint64 group, int64 t) {
		json.Key(Core::StringView("group"));
		if (groupBy == GroupBy::Zone) json.Null();
		else if (groupBy == GroupBy::Thread) json.String(TrackLabel(capture, capture.tracks[(int64)group - 1], t).View());
		else json.String(group == 0 ? Core::StringView("(no task)") : capture.Text(group));
	}

	static void WriteSite(IED::JsonWriter& json, const Capture& capture, uint64 site) {
		json.Field("name", capture.SiteName(site));
		json.IntField("site", (int64)site);
		const SrcLoc* loc = capture.srclocs.Find(site);
		json.Field("function", loc ? capture.Text(loc->functionStr) : Core::StringView(""));
		json.Field("file", loc ? capture.Text(loc->fileStr) : Core::StringView(""));
		json.IntField("line", loc ? (int64)loc->line : 0);
	}

	static void WriteRow(IED::JsonWriter& json, const Capture& capture, const StatsAsk& ask, StatsRow* row, Range range) {
		row->durations.Sort();
		json.BeginObject();
		WriteSite(json, capture, row->site);
		WriteGroup(json, capture, ask.groupBy, row->group, range.begin);
		json.IntField("count", row->count);
		json.IntField("totalNs", capture.clock.Ns(row->total));
		json.IntField("selfNs", capture.clock.Ns(row->self));
		json.IntField("meanNs", capture.clock.Ns(Mean(row)));
		json.IntField("medianNs", capture.clock.Ns(Quantile(row->durations, 0.5)));
		json.IntField("p95Ns", capture.clock.Ns(Quantile(row->durations, 0.95)));
		json.IntField("minNs", capture.clock.Ns(row->least < 0 ? 0 : row->least));
		json.IntField("maxNs", capture.clock.Ns(row->most));
		NumberField(json, "share", (double)row->total / (double)range.Length(), 4);
		json.EndObject();
	}

	Core::String Stats(const Capture& capture, const StatsAsk& ask) {
		const Range range = RangeOfNs(capture, ask.fromNs, ask.toNs);
		Core::Array<StatsRow*> rows;
		Gather(capture, ask, range, rows);
		const StatsOrder order = ask.order;
		if (order == StatsOrder::Median || order == StatsOrder::P95) {
			for (StatsRow* row : rows) row->durations.Sort();
			const double fraction = order == StatsOrder::Median ? 0.5 : 0.95;
			rows.SortBy([fraction](StatsRow* a, StatsRow* b) -> bool { return Quantile(a->durations, fraction) > Quantile(b->durations, fraction); });
		}
		else {
			const Capture* source = &capture;
			rows.SortBy([source, order](StatsRow* a, StatsRow* b) -> bool { return Before(*source, order, a, b); });
		}
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("from", capture.clock.Ns(range.begin));
		json.IntField("to", capture.clock.Ns(range.end));
		json.IntField("rowCount", rows.Count());
		json.Key(Core::StringView("rows"));
		json.BeginArray();
		for (int64 i = 0; i < rows.Count() && i < (int64)ask.limit; ++i) WriteRow(json, capture, ask, rows[i], range);
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Find zone ----------------------------------------------------------------------------------------------------

	struct Instance
	{
		public uint64 ref;
		public int64 start;
		public int64 duration;
	}

	static bool SiteMatches(const Capture& capture, const FindAsk& ask, uint64 site) {
		if (ask.site != 0) return site == ask.site;
		return capture.SiteName(site) == ask.name.View();
	}

	static void Instances(const Capture& capture, const FindAsk& ask, Range range, Core::Array<Instance>& out) {
		for (const Core::KeyValue<uint64, SiteStats*>& entry : capture.sites) {
			if (!SiteMatches(capture, ask, entry.key)) continue;
			for (uint64 bits : entry.value->refs) {
				ZoneRef ref;
				ref.bits = bits;
				const ThreadTrack* track;
				const ZoneLevel* level;
				if (!ZoneAt(capture, ref, track, level)) continue;
				const int64 i = ref.Index();
				if (level->ends[i] == kOpen || !range.Holds(level->starts[i])) continue;
				Instance instance;
				instance.ref = bits;
				instance.start = level->starts[i];
				instance.duration = level->ends[i] - level->starts[i];
				out.Push(instance);
			}
		}
	}

	// Bin edges in ticks: logarithmic when the durations span more than two decades, else even.
	static int64 BinOf(int64 duration, int64 least, int64 most, int32 bins, bool logarithmic) {
		if (most <= least) return 0;
		double at;
		if (logarithmic) at = (log((double)duration + 1.0) - log((double)least + 1.0)) / (log((double)most + 1.0) - log((double)least + 1.0));
		else at = (double)(duration - least) / (double)(most - least);
		int64 bin = (int64)(at * (double)bins);
		return bin >= (int64)bins ? (int64)bins - 1 : (bin < 0 ? 0 : bin);
	}

	static double EdgeNs(const Capture& capture, int64 bin, int64 least, int64 most, int32 bins, bool logarithmic) {
		const double at = (double)bin / (double)bins;
		if (!logarithmic) return (double)capture.clock.Ns(least) + at * (double)capture.clock.Ns(most - least);
		const double low = log((double)least + 1.0);
		const double high = log((double)most + 1.0);
		return (exp(low + at * (high - low)) - 1.0) * capture.clock.nsPerTick;
	}

	static void WriteHistogram(IED::JsonWriter& json, const Capture& capture, const Core::Array<int64>& sorted, int32 bins) {
		const int64 least = sorted.IsEmpty() ? 0 : sorted[0];
		const int64 most = sorted.IsEmpty() ? 0 : sorted.Back();
		const bool logarithmic = least >= 0 && most > (least + 1) * 100;
		Core::Array<int64> counts;
		counts.Resize(bins);
		for (int64 duration : sorted) counts[BinOf(duration, least, most, bins, logarithmic)] += 1;
		json.BoolField("logarithmic", logarithmic);
		json.Key(Core::StringView("bins"));
		json.BeginArray();
		for (int64 b = 0; b < (int64)bins; ++b) {
			json.BeginArray();
			WriteNumber(json, EdgeNs(capture, b, least, most, bins, logarithmic), 0);
			WriteNumber(json, EdgeNs(capture, b + 1, least, most, bins, logarithmic), 0);
			json.Int(counts[b]);
			json.EndArray();
		}
		json.EndArray();
	}

	static void WriteInstances(IED::JsonWriter& json, const Capture& capture, const FindAsk& ask, Core::Array<Instance>& instances) {
		instances.SortBy([](const Instance& a, const Instance& b) -> bool { return a.duration > b.duration; });
		json.Key(Core::StringView("instances"));
		json.BeginArray();
		int32 written = 0;
		for (const Instance& instance : instances) {
			const int64 ns = capture.clock.Ns(instance.duration);
			if ((ask.lowNs >= 0 && ns < ask.lowNs) || (ask.highNs >= 0 && ns > ask.highNs)) continue;
			if (written >= ask.limit) break;
			ZoneRef ref;
			ref.bits = instance.ref;
			json.BeginObject();
			json.Field("ref", ref.Text().View());
			json.IntField("startNs", capture.clock.Ns(instance.start));
			json.IntField("durationNs", ns);
			json.Field("thread", TrackLabel(capture, capture.tracks[ref.Track()], instance.start).View());
			json.EndObject();
			written += 1;
		}
		json.EndArray();
	}

	Core::String FindZone(const Capture& capture, const FindAsk& ask) {
		const Range range = RangeOfNs(capture, ask.fromNs, ask.toNs);
		Core::Array<Instance> instances;
		Instances(capture, ask, range, instances);
		Core::Array<int64> sorted;
		int64 total = 0;
		for (const Instance& instance : instances) {
			sorted.Push(instance.duration);
			total += instance.duration;
		}
		sorted.Sort();
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("name", ask.site != 0 ? capture.SiteName(ask.site) : ask.name.View());
		json.IntField("count", sorted.Count());
		json.IntField("totalNs", capture.clock.Ns(total));
		json.IntField("meanNs", sorted.IsEmpty() ? 0 : capture.clock.Ns(total / sorted.Count()));
		json.IntField("medianNs", capture.clock.Ns(Quantile(sorted, 0.5)));
		json.IntField("p95Ns", capture.clock.Ns(Quantile(sorted, 0.95)));
		json.IntField("minNs", sorted.IsEmpty() ? 0 : capture.clock.Ns(sorted[0]));
		json.IntField("maxNs", sorted.IsEmpty() ? 0 : capture.clock.Ns(sorted.Back()));
		WriteHistogram(json, capture, sorted, ask.bins < 1 ? 1 : ask.bins);
		WriteInstances(json, capture, ask, instances);
		json.EndObject();
		return json.ToString();
	}
}
