include "ingest.ch"

namespace Profiler
{
	const double kNsPerSecond = 1000000000.0;
	const double kCalibrationLeastSeconds = 0.5;

	// --- Finding or making the capture's parts -------------------------------------------------------------------------

	static int32 TrackFor(Capture& capture, uint64 clientId) {
		int32 index;
		if (capture.trackOf.TryGet(clientId, index)) return index;
		ThreadTrack* track = new ThreadTrack();
		track->clientId = clientId;
		capture.tracks.Push(track);
		index = (int32)(capture.tracks.Count() - 1);
		capture.trackOf.Insert(clientId, index);
		return index;
	}

	static FrameSet* FrameSetFor(Capture& capture, uint64 nameStr) {
		FrameSet* set = nullptr;
		if (capture.frameSetOf.TryGet(nameStr, set)) return set;
		set = new FrameSet();
		set->nameStr = nameStr;
		capture.frameSets.Push(set);
		capture.frameSetOf.Insert(nameStr, set);
		return set;
	}

	static Plot* PlotFor(Capture& capture, uint64 id) {
		Plot* plot = nullptr;
		if (capture.plotOf.TryGet(id, plot)) return plot;
		plot = new Plot();
		plot->id = id;
		capture.plots.Push(plot);
		capture.plotOf.Insert(id, plot);
		return plot;
	}

	static Pool* PoolFor(Capture& capture, uint64 id) {
		Pool* pool = nullptr;
		if (capture.poolOf.TryGet(id, pool)) return pool;
		pool = new Pool();
		pool->id = id;
		capture.pools.Push(pool);
		capture.poolOf.Insert(id, pool);
		return pool;
	}

	static TaskLane* LaneFor(Capture& capture, uint64 nameStr) {
		TaskLane* lane = nullptr;
		if (capture.taskLaneOf.TryGet(nameStr, lane)) return lane;
		lane = new TaskLane();
		lane->nameStr = nameStr;
		capture.taskLanes.Push(lane);
		capture.taskLaneOf.Insert(nameStr, lane);
		return lane;
	}

	static TaskRuns* RunsFor(TaskLane* lane, int32 track) {
		TaskRuns* runs = nullptr;
		if (lane->runsOf.TryGet(track, runs)) return runs;
		runs = new TaskRuns();
		runs->track = track;
		lane->runs.Push(runs);
		lane->runsOf.Insert(track, runs);
		return runs;
	}

	static GpuContext* GpuFor(Capture& capture, uint64 id) {
		GpuContext* gpu = nullptr;
		if (capture.gpuOf.TryGet(id, gpu)) return gpu;
		gpu = new GpuContext();
		gpu->id = id;
		capture.gpus.Push(gpu);
		capture.gpuOf.Insert(id, gpu);
		return gpu;
	}

	static LockInfo* LockFor(Capture& capture, uint64 id) {
		LockInfo* lock = nullptr;
		if (capture.locks.TryGet(id, lock)) return lock;
		lock = new LockInfo();
		lock->id = id;
		capture.locks.Insert(id, lock);
		return lock;
	}

	static SiteStats* StatsFor(Capture& capture, uint64 site) {
		SiteStats* stats = nullptr;
		if (capture.sites.TryGet(site, stats)) return stats;
		stats = new SiteStats();
		capture.sites.Insert(site, stats);
		return stats;
	}

	// Where `t` goes in a time-sorted array: after every time not later than it (most events arrive in order, so the
	// search starts from the end).
	static int64 SortedSlot(const Core::Array<int64>& times, int64 t) {
		int64 at = times.Count();
		while (at > 0 && times[at - 1] > t) at -= 1;
		return at;
	}

	static void Set(Core::HashMap<uint64, Core::String>& map, uint64 key, Core::StringView value) {
		Core::String* existing = map.Find(key);
		if (existing) *existing = Core::String(value);
		else map.Insert(key, Core::String(value));
	}

	// --- Session ------------------------------------------------------------------------------------------------------

	static void Hello(Capture& capture, const Event& event) {
		capture.hello = true;
		capture.appName = Core::String(event.text);
		capture.pid = event.fields[1];
		capture.clockFreqHz = (int64)event.fields[2];
		capture.clock.startTicks = (int64)event.fields[3];
		capture.startUnixNs = (int64)event.fields[4];
		capture.flags = event.fields[5];
		capture.clock.nsPerTick = capture.clockFreqHz > 0 ? kNsPerSecond / (double)capture.clockFreqHz : 1.0;
	}

	// A client that estimated its clock's frequency is corrected by its calibration pairs, once they span enough time.
	static void Calibrate(Capture& capture, const Event& event) {
		capture.calibrationTicks.Push((int64)event.fields[0]);
		capture.calibrationUnixNs.Push((int64)event.fields[1]);
		if ((capture.flags & kEstimatedClockFlag) == 0 || capture.calibrationTicks.Count() < 2) return;
		const int64 ticks = capture.calibrationTicks.Back() - capture.calibrationTicks[0];
		const int64 ns = capture.calibrationUnixNs.Back() - capture.calibrationUnixNs[0];
		if (ticks <= 0 || (double)ns < kCalibrationLeastSeconds * kNsPerSecond) return;
		capture.clock.nsPerTick = (double)ns / (double)ticks;
	}

	// --- Zones --------------------------------------------------------------------------------------------------------

	static ZoneLevel* LevelAt(ThreadTrack* track, int32 depth) {
		while (track->levels.Count() <= (int64)depth) track->levels.Push(new ZoneLevel());
		return track->levels[depth];
	}

	static void BeginZone(Capture& capture, int32 trackIndex, int64 t, uint64 site, uint64 nameStr) {
		ThreadTrack* track = capture.tracks[trackIndex];
		const int32 depth = (int32)track->open.Count();
		if (depth > kMostDepth) {
			track->overflow += 1;
			if (track->overflow == 1) capture.Warn(t, Core::StringView("zones nested deeper than 255 levels were left out"));
			return;
		}
		ZoneLevel* level = LevelAt(track, depth);
		int64 start = t;
		if (level->Count() > 0 && level->ends.Back() != kOpen && level->ends.Back() > start) start = level->ends.Back();
		level->starts.Push(start);
		level->ends.Push(kOpen);
		level->selfs.Push(0);
		level->sites.Push((uint32)site);
		level->extras.Push(0);
		OpenZone zone;
		zone.depth = depth;
		zone.index = level->Count() - 1;
		track->open.Push(zone);
		track->zones += 1;
		StatsFor(capture, site)->refs.Push(ZoneRef::Of(trackIndex, depth, zone.index).bits);
		if (nameStr != 0) track->InnermostExtra()->nameStr = nameStr;
	}

	static void EndZone(Capture& capture, int32 trackIndex, int64 t) {
		ThreadTrack* track = capture.tracks[trackIndex];
		if (track->overflow > 0) {
			track->overflow -= 1;
			return;
		}
		if (track->open.IsEmpty()) {
			capture.Warn(t, Core::StringView("a zone ended that never began; the end was left out"));
			return;
		}
		const OpenZone zone = track->open.Pop();
		ZoneLevel* level = track->levels[zone.depth];
		const int64 start = level->starts[zone.index];
		const int64 end = t < start ? start : t;
		const int64 duration = end - start;
		const int64 self = duration - zone.childTicks < 0 ? 0 : duration - zone.childTicks;
		level->ends[zone.index] = end;
		level->selfs[zone.index] = self;
		if (!track->open.IsEmpty()) track->open.Back().childTicks += duration;
		SiteStats* stats = StatsFor(capture, (uint64)level->sites[zone.index]);
		stats->count += 1;
		stats->total += duration;
		stats->self += self;
		if (duration > stats->most) stats->most = duration;
		if (stats->least < 0 || duration < stats->least) stats->least = duration;
	}

	static void DescribeZone(Capture& capture, int32 trackIndex, const Event& event) {
		ZoneExtra* extra = capture.tracks[trackIndex]->InnermostExtra();
		if (!extra) {
			capture.Warn(capture.lastTicks, Core::StringView("zone text or a value came with no zone open"));
			return;
		}
		if (event.type == EventType::ZoneText) extra->textStr = event.fields[0];
		else if (event.type == EventType::ZoneValue) {
			extra->value = event.fields[0];
			extra->hasValue = true;
		}
		else if (event.type == EventType::ZoneColor) extra->color = (uint32)event.fields[0];
		else extra->callstack = event.fields[0];
	}

	// --- Tasks --------------------------------------------------------------------------------------------------------

	static void StopRunning(TaskInfo* task, int64 t) {
		if (!task->running) return;
		const int64 start = task->running->starts[task->runningEntry];
		task->running->ends[task->runningEntry] = t < start ? start : t;
		task->running = nullptr;
	}

	static void StartRunning(Capture& capture, TaskInfo* task, int32 track, int64 t) {
		StopRunning(task, t);
		TaskLane* lane = LaneFor(capture, task->nameStr);
		TaskRuns* runs = RunsFor(lane, track);
		runs->starts.Push(t);
		runs->ends.Push(kOpen);
		runs->tasks.Push(task->id);
		lane->count += 1;
		task->running = runs;
		task->runningEntry = runs->starts.Count() - 1;
		task->runs += 1;
	}

	static TaskInfo* KnownTask(Capture& capture, uint64 id, int64 t) {
		TaskInfo* task = nullptr;
		if (capture.tasks.TryGet(id, task)) return task;
		capture.Warn(t, Core::StringView("an event named a task that never began"));
		return nullptr;
	}

	static void TaskEvent(Capture& capture, int32 track, const Event& event, int64 t) {
		if (event.type == EventType::TaskBegin) {
			TaskInfo* task = new TaskInfo();
			task->id = event.fields[0];
			task->nameStr = event.fields[1];
			task->parent = event.fields[2];
			task->begin = t;
			if (!capture.tasks.Insert(task->id, task)) {
				capture.Warn(t, Core::StringView("a task id was used twice; the second task was left out"));
				return;
			}
			StartRunning(capture, task, track, t);
			return;
		}
		TaskInfo* task = KnownTask(capture, event.fields[0], t);
		if (!task) return;
		if (event.type == EventType::TaskResume) StartRunning(capture, task, track, t);
		else StopRunning(task, t);
		if (event.type == EventType::TaskEnd) task->end = t;
	}

	// --- Frames, plots, messages --------------------------------------------------------------------------------------

	static void FrameEvent(Capture& capture, const Event& event, int64 t) {
		FrameSet* set = FrameSetFor(capture, event.fields[0]);
		const bool open = !set->ends.IsEmpty() && set->ends.Back() == kOpen;
		if (event.type == EventType::FrameEnd) {
			if (open) set->ends.Back() = t;
			else capture.Warn(t, Core::StringView("a frame ended that never began"));
			return;
		}
		if (event.type == EventType::FrameBegin) set->discontinuous = true;
		if (open) set->ends.Back() = t;
		set->starts.Push(t);
		set->ends.Push(kOpen);
	}

	static void PlotValue(Capture& capture, const Event& event, int64 t) {
		Plot* plot = PlotFor(capture, event.fields[0]);
		const int64 at = SortedSlot(plot->times, t);
		plot->times.Insert(at, t);
		plot->values.Insert(at, event.number);
	}

	static void Message(Capture& capture, int32 track, const Event& event, int64 t) {
		MessageRecord message;
		message.t = t;
		message.track = track;
		message.severity = (int32)event.fields[0];
		message.textStr = event.fields[1];
		message.color = (uint32)event.fields[2];
		int64 at = capture.messages.Count();
		while (at > 0 && capture.messages[at - 1].t > t) at -= 1;
		capture.messages.Insert(at, message);
	}

	// --- Memory -------------------------------------------------------------------------------------------------------

	static void Used(Pool* pool, int64 t, int64 change) {
		pool->inUse += change;
		if (pool->inUse > pool->peak) pool->peak = pool->inUse;
		const int64 when = !pool->times.IsEmpty() && pool->times.Back() > t ? pool->times.Back() : t;
		pool->times.Push(when);
		pool->bytes.Push(pool->inUse);
	}

	static void Release(Capture& capture, Pool* pool, int64 index, int64 t) {
		Allocation& allocation = capture.allocations[index];
		allocation.freed = t < allocation.t ? allocation.t : t;
		pool->frees += 1;
		Used(pool, t, -allocation.size);
	}

	static void Alloc(Capture& capture, int32 track, const Event& event, int64 t) {
		Pool* pool = PoolFor(capture, event.fields[1]);
		const uint64 address = event.fields[2];
		int64 existing;
		if (pool->live.TryGet(address, existing)) {
			capture.Warn(t, Core::StringView("an address was allocated again before it was freed; the first allocation is taken as freed"));
			Release(capture, pool, existing, t);
			pool->live.Remove(address);
		}
		Allocation allocation;
		allocation.t = t;
		allocation.address = address;
		allocation.size = (int64)event.fields[3];
		allocation.track = track;
		allocation.callstack = event.fields[4];
		allocation.pool = pool->id;
		capture.allocations.Push(allocation);
		pool->live.Insert(address, capture.allocations.Count() - 1);
		pool->allocs += 1;
		Used(pool, t, allocation.size);
	}

	static void Free(Capture& capture, const Event& event, int64 t) {
		Pool* pool = PoolFor(capture, event.fields[1]);
		const uint64 address = event.fields[2];
		int64 index;
		if (!pool->live.TryGet(address, index)) {
			pool->earlierFrees += 1;
			return;
		}
		pool->live.Remove(address);
		Release(capture, pool, index, t);
	}

	static void ResetPool(Capture& capture, const Event& event, int64 t) {
		Pool* pool = PoolFor(capture, event.fields[0]);
		for (Core::KeyValue<uint64, int64>& entry : pool->live) Release(capture, pool, entry.value, t);
		pool->live.Clear();
	}

	static void GcEvent(Capture& capture, const Event& event, int64 t) {
		if (event.type == EventType::GcBegin) {
			GcRecord gc;
			gc.begin = t;
			gc.kind = (int32)event.fields[0];
			gc.generation = (int32)event.fields[1];
			capture.gcs.Push(gc);
			return;
		}
		if (capture.gcs.IsEmpty() || capture.gcs.Back().end != kOpen) {
			GcRecord unbegun;
			unbegun.begin = t;
			capture.gcs.Push(unbegun);
		}
		GcRecord& gc = capture.gcs.Back();
		gc.end = t < gc.begin ? gc.begin : t;
		gc.bytesBefore = (int64)event.fields[0];
		gc.bytesAfter = (int64)event.fields[1];
		gc.objectsFreed = (int64)event.fields[2];
		gc.pinned = (int64)event.fields[3];
		gc.roots = (int64)event.fields[4];
	}

	// --- GPU ----------------------------------------------------------------------------------------------------------

	static void GpuEvent(Capture& capture, int32 track, const Event& event, int64 t) {
		GpuContext* gpu = GpuFor(capture, event.fields[0]);
		if (event.type == EventType::GpuContextDef) {
			gpu->api = event.fields[1];
			gpu->nameStr = event.fields[2];
			gpu->periodPs = event.fields[3] == 0 ? 1.0 : (double)event.fields[3];
		}
		else if (event.type == EventType::GpuCalibration) {
			gpu->calibrationCpu.Push((int64)event.fields[1]);
			gpu->calibrationGpu.Push((int64)event.fields[2]);
		}
		else if (event.type == EventType::GpuTime) {
			int64* known = gpu->times.Find(event.fields[1]);
			if (known) *known = (int64)event.fields[2];
			else gpu->times.Insert(event.fields[1], (int64)event.fields[2]);
		}
		else if (event.type == EventType::GpuZoneBegin) {
			GpuZone zone;
			zone.cpuBegin = t;
			zone.beginQuery = event.fields[1];
			zone.site = (uint32)event.fields[2];
			zone.depth = (int32)gpu->open.Count();
			zone.track = track;
			gpu->zones.Push(zone);
			gpu->open.Push(gpu->zones.Count() - 1);
		}
		else if (gpu->open.IsEmpty()) capture.Warn(t, Core::StringView("a GPU zone ended that never began"));
		else {
			GpuZone& zone = gpu->zones[gpu->open.Pop()];
			zone.cpuEnd = t;
			zone.endQuery = event.fields[1];
		}
	}

	// --- Definitions --------------------------------------------------------------------------------------------------

	static void Define(Capture& capture, const Event& event) {
		if (event.type == EventType::StringDef) Set(capture.strings, event.fields[0], event.text);
		else if (event.type == EventType::SrcLocDef) {
			SrcLoc loc;
			loc.nameStr = event.fields[1];
			loc.functionStr = event.fields[2];
			loc.fileStr = event.fields[3];
			loc.line = event.fields[4];
			loc.color = (uint32)event.fields[5];
			SrcLoc* existing = capture.srclocs.Find(event.fields[0]);
			if (existing) *existing = loc;
			else capture.srclocs.Insert(event.fields[0], loc);
		}
		else if (event.type == EventType::ThreadDef) {
			ThreadTrack* track = capture.tracks[TrackFor(capture, event.fields[0])];
			track->osId = event.fields[1];
			track->groupStr = event.fields[2];
		}
		else if (event.type == EventType::PlotDef) {
			Plot* plot = PlotFor(capture, event.fields[0]);
			plot->nameStr = event.fields[1];
			plot->kind = event.fields[2];
		}
		else if (event.type == EventType::PoolDef) PoolFor(capture, event.fields[0])->nameStr = event.fields[1];
		else if (event.type == EventType::LockDef) {
			LockInfo* lock = LockFor(capture, event.fields[0]);
			lock->nameStr = event.fields[1];
			lock->site = event.fields[2];
		}
		else if (event.type == EventType::ModuleDef) {
			ModuleRecord module;
			module.base = event.fields[0];
			module.size = event.fields[1];
			module.pathStr = event.fields[2];
			module.debugIdStr = event.fields[3];
			capture.modules.Push(module);
		}
		else if (event.type == EventType::CallstackDef) {
			Core::Array<uint64> frames;
			if (event.list) frames.Append(*event.list);
			Core::Array<uint64>* existing = capture.callstacks.Find(event.fields[0]);
			if (existing) *existing = frames;
			else capture.callstacks.Insert(event.fields[0], frames);
		}
		else if (event.type == EventType::SymbolDef) {
			SymbolRecord symbol;
			symbol.functionStr = event.fields[1];
			symbol.fileStr = event.fields[2];
			symbol.line = event.fields[3];
			SymbolRecord* existing = capture.symbols.Find(event.fields[0]);
			if (existing) *existing = symbol;
			else capture.symbols.Insert(event.fields[0], symbol);
		}
	}

	static void Lock(Capture& capture, int32 track, const Event& event, int64 t) {
		LockInfo* lock = LockFor(capture, event.fields[0] >> 1);
		LockEventRecord record;
		record.t = t;
		record.track = track;
		record.kind = event.type == EventType::LockWait ? 0 : (event.type == EventType::LockObtain ? 1 : 2);
		record.shared = (event.fields[0] & 1) != 0;
		lock->events.Push(record);
	}

	static void Sample(Capture& capture, int32 track, const Event& event, int64 t) {
		SampleRecord sample;
		sample.t = t;
		sample.track = track;
		sample.callstack = event.fields[1];
		sample.kind = (int32)event.fields[2];
		sample.weight = (int64)event.fields[3];
		capture.samples.Push(sample);
	}

	// --- Dispatch -----------------------------------------------------------------------------------------------------

	static bool IsDefinition(EventType type) {
		return type == EventType::StringDef || type == EventType::SrcLocDef || type == EventType::ThreadDef || type == EventType::PlotDef || type == EventType::PoolDef || type == EventType::LockDef || type == EventType::ModuleDef || type == EventType::CallstackDef || type == EventType::SymbolDef;
	}

	static bool Within(EventType type, EventType first, EventType last) {
		return (uint8)type >= (uint8)first && (uint8)type <= (uint8)last;
	}

	static bool IsGpu(EventType type) { return Within(type, EventType::GpuContextDef, EventType::GpuTime); }

	// Events that happen on a thread make its track; the global chunk's thread 0 is the process itself.
	static int32 TrackOfEvent(Capture& capture, const Event& event) {
		return TrackFor(capture, event.thread);
	}

	static void ApplyTimed(Capture& capture, const Event& event, int64 t) {
		const EventType type = event.type;
		if (type == EventType::ZoneBegin) BeginZone(capture, TrackOfEvent(capture, event), t, event.fields[0], 0);
		else if (type == EventType::ZoneBeginNamed) BeginZone(capture, TrackOfEvent(capture, event), t, event.fields[0], event.fields[1]);
		else if (type == EventType::ZoneEnd) EndZone(capture, TrackOfEvent(capture, event), t);
		else if (type == EventType::ThreadName) {
			ThreadTrack* track = capture.tracks[TrackOfEvent(capture, event)];
			track->nameTimes.Push(t);
			track->nameStrs.Push(event.fields[0]);
		}
		else if (Within(type, EventType::TaskBegin, EventType::TaskResume)) TaskEvent(capture, TrackOfEvent(capture, event), event, t);
		else if (Within(type, EventType::FrameMark, EventType::FrameEnd)) FrameEvent(capture, event, t);
		else if (type == EventType::PlotValue) PlotValue(capture, event, t);
		else if (type == EventType::Message) Message(capture, TrackOfEvent(capture, event), event, t);
		else if (type == EventType::Alloc) Alloc(capture, TrackOfEvent(capture, event), event, t);
		else if (type == EventType::Free) Free(capture, event, t);
		else if (type == EventType::PoolReset) ResetPool(capture, event, t);
		else if (type == EventType::GcBegin || type == EventType::GcEnd) GcEvent(capture, event, t);
		else if (Within(type, EventType::LockWait, EventType::LockRelease)) Lock(capture, TrackOfEvent(capture, event), event, t);
		else if (type == EventType::Sample) Sample(capture, TrackOfEvent(capture, event), event, t);
		else if (IsGpu(type)) GpuEvent(capture, TrackOfEvent(capture, event), event, t);
	}

	static void NoteTime(Capture& capture, const Event& event, int64 t) {
		if (t > capture.lastTicks) capture.lastTicks = t;
		if (event.chunkKind != kThreadChunk) return;
		ThreadTrack* track = capture.tracks[TrackFor(capture, event.thread)];
		if (track->firstTicks < 0 || t < track->firstTicks) track->firstTicks = t;
		if (t > track->lastTicks) track->lastTicks = t;
	}

	void Apply(Capture& capture, const Event& event) {
		capture.events += 1;
		const EventType type = event.type;
		if (type == EventType::Hello) Hello(capture, event);
		else if (type == EventType::Calibration) Calibrate(capture, event);
		else if (type == EventType::Bye) {
			capture.ended = true;
			capture.byeReason = event.fields[0];
		}
		else if (type == EventType::Warning) capture.Warn(capture.lastTicks, (Core::String("the client said: ") + capture.Text(event.fields[1])).View());
		else if (type == EventType::Stats) capture.eventsDropped = event.fields[1];
		else if (IsDefinition(type)) Define(capture, event);
		else if (Within(type, EventType::ZoneText, EventType::ZoneCallstack)) DescribeZone(capture, TrackOfEvent(capture, event), event);
		else if (event.timed || IsGpu(type)) {
			const int64 t = event.timed ? event.ticks - capture.clock.startTicks : capture.lastTicks;
			if (event.timed) NoteTime(capture, event, t);
			ApplyTimed(capture, event, t);
		}
	}

	void ApplyChunk(Capture& capture, const uint8* chunk, int64 length) {
		Core::String problem;
		Capture* target = &capture;
		if (!DecodeChunk(chunk, length, [target](const Event& event) { Apply(*target, event); }, problem)) capture.Warn(capture.lastTicks, problem.View());
		capture.bytes += length + kChunkHeaderLength;
	}

	// --- The end ------------------------------------------------------------------------------------------------------

	static int64 CloseOpenZones(Capture& capture) {
		int64 closed = 0;
		for (int64 i = 0; i < capture.tracks.Count(); ++i) {
			ThreadTrack* track = capture.tracks[i];
			track->overflow = 0;
			while (!track->open.IsEmpty()) {
				EndZone(capture, (int32)i, capture.lastTicks);
				closed += 1;
			}
		}
		return closed;
	}

	void Finish(Capture& capture) {
		capture.ended = true;
		const int64 closed = CloseOpenZones(capture);
		if (closed > 0) {
			Core::StringBuilder text;
			text.AppendInt(closed);
			text.Append(closed == 1 ? " zone was still open at the end and was closed there" : " zones were still open at the end and were closed there");
			capture.Warn(capture.lastTicks, text.View());
		}
		for (Core::KeyValue<uint64, TaskInfo*>& entry : capture.tasks) StopRunning(entry.value, capture.lastTicks);
		for (FrameSet* set : capture.frameSets)
			if (set->discontinuous && !set->ends.IsEmpty() && set->ends.Back() == kOpen) set->ends.Back() = capture.lastTicks;
		for (GcRecord& gc : capture.gcs)
			if (gc.end == kOpen) gc.end = capture.lastTicks;
	}
}
