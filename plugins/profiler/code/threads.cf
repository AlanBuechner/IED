// How busy each thread is (T-PRF-16): the time inside its top-level zones, the longest stretch between them, the time
// it waited for locks and its costliest zones; and how many threads were busy at once on average, which says whether
// the work runs side by side or one thread at a time.
include "investigate.ch"

namespace Profiler
{
	const int32 kThreadTopZones = 3;

	class ThreadUse
	{
		public int64 track;
		public int64 busy;
		public int64 zones;
		public int64 longestIdle;
		public int64 longestIdleAt = -1;
		public int64 wait;
		public Core::HashMap<uint64, int64> selfOf;
		public Core::Array<uint64> sites;
	}

	// The time a thread spent waiting for locks within a range.
	static int64 WaitingIn(const Capture& capture, int64 track, Range range) {
		int64 total = 0;
		for (const LockInfo* lock : capture.lockList) {
			LockTrack* holder = nullptr;
			if (!lock->trackOf.TryGet((int32)track, holder)) continue;
			for (int64 i = FirstReleasedAfter(holder, range.begin, capture.lastTicks); i < holder->spans.Count(); ++i) {
				const LockSpan& span = holder->spans[i];
				if (span.wait >= range.end) break;
				const int64 from = span.wait > range.begin ? span.wait : range.begin;
				const int64 to = span.obtain < range.end ? span.obtain : range.end;
				if (to > from) total += to - from;
			}
			if (holder->waitingSince >= 0 && holder->waitingSince < range.end) total += range.end - (holder->waitingSince > range.begin ? holder->waitingSince : range.begin);
		}
		return total;
	}

	static void TopLevelUse(const Capture& capture, const ZoneLevel* top, Range range, ThreadUse* use) {
		const int64 stop = top->FirstStartingAt(range.end);
		int64 previousEnd = -1;
		for (int64 i = top->FirstEndingAfter(range.begin); i < stop; ++i) {
			const int64 start = top->starts[i] > range.begin ? top->starts[i] : range.begin;
			int64 end = top->EndOr(i, capture.lastTicks);
			if (end > range.end) end = range.end;
			use->busy += end - start;
			if (previousEnd >= 0 && start - previousEnd > use->longestIdle) {
				use->longestIdle = start - previousEnd;
				use->longestIdleAt = previousEnd;
			}
			previousEnd = end;
		}
	}

	static void SelfBySite(const ThreadTrack* track, Range range, ThreadUse* use) {
		for (const ZoneLevel* level : track->levels) {
			const int64 stop = level->FirstStartingAt(range.end);
			const int64 first = level->FirstStartingAt(range.begin);
			use->zones += stop - first;
			for (int64 i = first; i < stop; ++i) {
				if (level->ends[i] == kOpen) continue;
				const uint64 site = (uint64)level->sites[i];
				int64* known = use->selfOf.Find(site);
				if (known) *known += level->selfs[i];
				else {
					use->selfOf.Insert(site, level->selfs[i]);
					use->sites.Push(site);
				}
			}
		}
		use->sites.SortBy([use](const uint64& a, const uint64& b) -> bool { return *use->selfOf.Find(a) > *use->selfOf.Find(b); });
	}

	static void WriteUse(IED::JsonWriter& json, const Capture& capture, const ThreadUse* use, Range range) {
		json.BeginObject();
		json.IntField("track", use->track);
		const FrameSet* frames = MainFrameSet(capture);
		json.BoolField("marksFrames", frames && (int64)frames->track == use->track);
		json.Field("name", TrackLabel(capture, capture.tracks[use->track], range.begin).View());
		json.IntField("busyNs", capture.clock.Ns(use->busy));
		NumberField(json, "share", (double)use->busy / (double)range.Length(), 4);
		json.IntField("zones", use->zones);
		json.IntField("longestIdleNs", capture.clock.Ns(use->longestIdle));
		json.IntField("longestIdleAtNs", use->longestIdleAt < 0 ? -1 : capture.clock.Ns(use->longestIdleAt));
		json.IntField("waitNs", capture.clock.Ns(use->wait));
		json.Key(Core::StringView("top"));
		json.BeginArray();
		for (int64 k = 0; k < use->sites.Count() && k < (int64)kThreadTopZones; ++k) {
			json.BeginObject();
			json.Field("name", capture.SiteName(use->sites[k]));
			json.IntField("selfNs", capture.clock.Ns(*use->selfOf.Find(use->sites[k])));
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
	}

	Core::String Threads(const Capture& capture, int64 fromNs, int64 toNs) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		Core::Array<ThreadUse*> uses;
		int64 busy = 0;
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const ThreadTrack* track = capture.tracks[t];
			if (track->levels.IsEmpty()) continue;
			ThreadUse* use = new ThreadUse();
			use->track = t;
			TopLevelUse(capture, track->levels[0], range, use);
			SelfBySite(track, range, use);
			if (use->busy == 0 && use->zones == 0) continue;
			use->wait = WaitingIn(capture, t, range);
			busy += use->busy;
			uses.Push(use);
		}
		uses.SortBy([](ThreadUse* a, ThreadUse* b) -> bool { return a->busy > b->busy; });
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("fromNs", capture.clock.Ns(range.begin));
		json.IntField("toNs", capture.clock.Ns(range.end > capture.lastTicks ? capture.lastTicks : range.end));
		NumberField(json, "meanBusyThreads", (double)busy / (double)range.Length(), 2);
		json.Key(Core::StringView("threads"));
		json.BeginArray();
		for (const ThreadUse* use : uses) WriteUse(json, capture, use, range);
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
