// What happened in a stretch of time (T-PRF-17, T-PRF-18): a window's zones, lock waits and messages per thread in
// time order, and what happened inside one zone on its thread - the allocations it made, the locks it waited for, what
// it logged and the collections that stopped it.
include "investigate.ch"

namespace Profiler
{
	const int32 kInsideWaits = 5;
	const int32 kInsideMessages = 5;

	struct WindowEntry
	{
		public int64 t;
		public int32 kind;                  // 0 zone, 1 lock wait, 2 message
		public int64 depth;
		public int64 index;                 // the zone's index at its depth, the lock's id or the message's index
		public int64 ns;
	}

	// The times of a thread's allocations in a range, sorted, so the allocations inside a zone are counted by search.
	static void AllocationTimes(const Capture& capture, int64 track, Range range, Core::Array<int64>& out) {
		for (const Allocation& allocation : capture.allocations)
			if ((int64)allocation.track == track && range.Holds(allocation.t)) out.Push(allocation.t);
		out.Sort();
	}

	static void ZoneEntries(const ThreadTrack* track, Range range, int32 depth, Core::Array<WindowEntry>& out) {
		for (int64 d = 0; d < track->levels.Count() && d <= (int64)depth; ++d) {
			const ZoneLevel* level = track->levels[d];
			const int64 stop = level->FirstStartingAt(range.end);
			for (int64 i = level->FirstEndingAfter(range.begin); i < stop; ++i) {
				WindowEntry entry;
				entry.t = level->starts[i];
				entry.kind = 0;
				entry.depth = d;
				entry.index = i;
				out.Push(entry);
			}
		}
	}

	static void WaitEntries(const Capture& capture, int64 track, Range range, Core::Array<WindowEntry>& out) {
		for (const LockInfo* lock : capture.lockList) {
			LockTrack* holder = nullptr;
			if (!lock->trackOf.TryGet((int32)track, holder)) continue;
			for (int64 i = FirstReleasedAfter(holder, range.begin, capture.lastTicks); i < holder->spans.Count(); ++i) {
				const LockSpan& span = holder->spans[i];
				if (span.wait >= range.end) break;
				if (span.obtain <= span.wait || span.obtain <= range.begin) continue;
				WindowEntry entry;
				entry.t = span.wait;
				entry.kind = 1;
				entry.index = (int64)lock->id;
				entry.ns = span.obtain - span.wait;
				out.Push(entry);
			}
		}
	}

	static void MessageEntries(const Capture& capture, int64 track, Range range, Core::Array<WindowEntry>& out) {
		for (int64 i = 0; i < capture.messages.Count(); ++i) {
			const MessageRecord& message = capture.messages[i];
			if ((int64)message.track != track || !range.Holds(message.t)) continue;
			WindowEntry entry;
			entry.t = message.t;
			entry.kind = 2;
			entry.index = i;
			out.Push(entry);
		}
	}


	static int64 CountBetween(const Core::Array<int64>& sorted, int64 begin, int64 end) {
		return sorted.LowerBound(end) - sorted.LowerBound(begin);
	}

	static void WriteEntry(IED::JsonWriter& json, const Capture& capture, int64 t, const WindowEntry& entry, const Core::Array<int64>& allocs) {
		const ThreadTrack* track = capture.tracks[t];
		json.BeginObject();
		json.IntField("startNs", capture.clock.Ns(entry.t));
		if (entry.kind == 0) {
			const ZoneLevel* level = track->levels[entry.depth];
			const int64 end = level->EndOr(entry.index, capture.lastTicks);
			json.Field("kind", "zone");
			json.Field("name", capture.ZoneName(track, level, entry.index));
			json.Field("site", capture.SiteName((uint64)level->sites[entry.index]));
			json.IntField("depth", entry.depth);
			json.IntField("durationNs", capture.clock.Ns(end - entry.t));
			json.Field("ref", ZoneRef::Of(t, entry.depth, entry.index).Text().View());
			json.IntField("allocations", capture.allocations.IsEmpty() ? ZoneCountsOf(track, level, entry.index).objects : CountBetween(allocs, entry.t, end));
		}
		else if (entry.kind == 1) {
			LockInfo* lock = nullptr;
			capture.locks.TryGet((uint64)entry.index, lock);
			json.Field("kind", "wait");
			json.Field("lock", LockName(capture, lock).View());
			json.IntField("durationNs", capture.clock.Ns(entry.ns));
		}
		else {
			const MessageRecord& message = capture.messages[entry.index];
			json.Field("kind", "message");
			json.IntField("severity", message.severity);
			json.Field("text", capture.Text(message.textStr));
		}
		json.EndObject();
	}

	Core::String Window(const Capture& capture, const WindowAsk& ask) {
		const Range range = RangeOfNs(capture, ask.fromNs, ask.toNs);
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("fromNs", capture.clock.Ns(range.begin));
		json.IntField("toNs", capture.clock.Ns(range.end > capture.lastTicks ? capture.lastTicks : range.end));
		int64 written = 0;
		int64 left = 0;
		json.Key(Core::StringView("threads"));
		json.BeginArray();
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const ThreadTrack* track = capture.tracks[t];
			Core::String name = TrackLabel(capture, track, range.begin);
			if (!ContainsNoCase(name.View(), ask.thread.View())) continue;
			Core::Array<WindowEntry> entries;
			ZoneEntries(track, range, ask.depth, entries);
			WaitEntries(capture, t, range, entries);
			MessageEntries(capture, t, range, entries);
			if (entries.IsEmpty()) continue;
			entries.SortBy([](const WindowEntry& a, const WindowEntry& b) -> bool { return a.t != b.t ? a.t < b.t : a.depth < b.depth; });
			Core::Array<int64> allocs;
			AllocationTimes(capture, t, range, allocs);
			json.BeginObject();
			json.Field("name", name.View());
			json.IntField("track", t);
			json.Key(Core::StringView("entries"));
			json.BeginArray();
			for (const WindowEntry& entry : entries) {
				if (written >= (int64)ask.limit) {
					left += 1;
					continue;
				}
				WriteEntry(json, capture, t, entry, allocs);
				written += 1;
			}
			json.EndArray();
			json.EndObject();
		}
		json.EndArray();
		json.IntField("left", left);
		json.Key(Core::StringView("gc"));
		json.BeginArray();
		for (const GcRecord& gc : capture.gcs) {
			if (gc.end == kOpen || !range.Overlaps(gc.begin, gc.end + 1)) continue;
			json.BeginObject();
			json.IntField("startNs", capture.clock.Ns(gc.begin));
			json.IntField("pauseNs", capture.clock.Ns(gc.end - gc.begin));
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Inside one zone ----------------------------------------------------------------------------------------------

	// `all` its children's included, `own` without them; `freedInside` -1 when not known.
	static void WriteAllocationsObject(IED::JsonWriter& json, const ZoneCounts& all, const ZoneCounts& own, int64 freedInside) {
		json.Key(Core::StringView("allocations"));
		json.BeginObject();
		json.IntField("count", all.objects);
		json.IntField("bytes", all.bytes);
		json.IntField("nativeBytes", all.nativeBytes);
		json.IntField("selfCount", own.objects);
		json.IntField("selfBytes", own.bytes);
		json.IntField("selfNativeBytes", own.nativeBytes);
		json.IntField("freedInside", freedInside);
		json.EndObject();
	}

	// Whether one of the zones of `children` (the level under the zone asked about) holds `t`.
	static bool InChild(const ZoneLevel* children, int64 t) {
		if (!children) return false;
		const int64 j = children->FirstEndingAfter(t);
		return j < children->Count() && children->starts[j] <= t;
	}

	// The zone's allocations, its children's included, and its own: the events its thread made in it, else what it
	// counted itself (what was freed in it is not known then, -1).
	static void WriteInsideAllocations(IED::JsonWriter& json, const Capture& capture, ZoneRef ref, Range span) {
		const int32 track = (int32)ref.Track();
		const ThreadTrack* thread = capture.tracks[ref.Track()];
		if (capture.allocations.IsEmpty() && capture.zoneAllocs > 0) {
			WriteAllocationsObject(json, ZoneCountsOf(thread, thread->levels[ref.Depth()], ref.Index()), ZoneOwnCounts(capture, ref), -1);
			return;
		}
		const ZoneLevel* children = ref.Depth() + 1 < thread->levels.Count() ? thread->levels[ref.Depth() + 1] : nullptr;
		ZoneCounts all;
		ZoneCounts own;
		int64 freedInside = 0;
		for (const Allocation& allocation : capture.allocations) {
			if (allocation.track != track || !span.Holds(allocation.t)) continue;
			all.objects += 1;
			all.bytes += allocation.size;
			if (!InChild(children, allocation.t)) {
				own.objects += 1;
				own.bytes += allocation.size;
			}
			if (allocation.freed != kOpen && allocation.freed < span.end) freedInside += 1;
		}
		WriteAllocationsObject(json, all, own, freedInside);
	}

	void WriteInside(IED::JsonWriter& json, const Capture& capture, ZoneRef ref, int64 begin, int64 end) {
		const int32 track = (int32)ref.Track();
		Range span;
		span.begin = begin;
		span.end = end > begin ? end : begin + 1;
		json.Key(Core::StringView("inside"));
		json.BeginObject();
		WriteInsideAllocations(json, capture, ref, span);
		Core::Array<int64> noAllocations;
		Core::Array<WindowEntry> waits;
		WaitEntries(capture, (int64)track, span, waits);
		waits.SortBy([](const WindowEntry& a, const WindowEntry& b) -> bool { return a.ns > b.ns; });
		int64 waited = 0;
		for (const WindowEntry& wait : waits) waited += wait.ns;
		json.IntField("waitNs", capture.clock.Ns(waited));
		json.Key(Core::StringView("waits"));
		json.BeginArray();
		for (int64 k = 0; k < waits.Count() && k < (int64)kInsideWaits; ++k) WriteEntry(json, capture, (int64)track, waits[k], noAllocations);
		json.EndArray();
		Core::Array<WindowEntry> messages;
		MessageEntries(capture, (int64)track, span, messages);
		json.IntField("messageCount", messages.Count());
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		for (int64 k = 0; k < messages.Count() && k < (int64)kInsideMessages; ++k) WriteEntry(json, capture, (int64)track, messages[k], noAllocations);
		json.EndArray();
		int64 gcPause = 0;
		int64 gcCount = 0;
		for (const GcRecord& gc : capture.gcs) {
			if (gc.end == kOpen || !span.Overlaps(gc.begin, gc.end)) continue;
			gcPause += gc.end - gc.begin;
			gcCount += 1;
		}
		json.IntField("gcCount", gcCount);
		json.IntField("gcPauseNs", capture.clock.Ns(gcPause));
		json.EndObject();
	}
}
