// A capture at a glance (T-PRF-2), two captures compared (F-PRF-23, T-PRF-6), and the messages window (F-PRF-16).
include "analysis.ch"

namespace Profiler
{
	const int32 kSummaryZones = 10;
	const int32 kSummaryWarnings = 10;

	static void WriteThreads(IED::JsonWriter& json, const Capture& capture) {
		json.Key(Core::StringView("threads"));
		json.BeginArray();
		for (int64 i = 0; i < capture.tracks.Count(); ++i) {
			const ThreadTrack* track = capture.tracks[i];
			if (track->zones == 0 && track->nameTimes.IsEmpty()) continue;
			json.BeginObject();
			json.IntField("track", i);
			json.Field("name", TrackLabel(capture, track, track->firstTicks < 0 ? 0 : track->firstTicks).View());
			json.IntField("zones", track->zones);
			json.IntField("renames", track->nameTimes.Count() > 1 ? track->nameTimes.Count() - 1 : 0);
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteTopZones(IED::JsonWriter& json, const Capture& capture, const char* key, StatsOrder order) {
		StatsAsk ask;
		ask.order = order;
		ask.limit = kSummaryZones;
		json.RawField(key, Stats(capture, ask).View());
	}

	static void WriteTasks(IED::JsonWriter& json, const Capture& capture) {
		json.Key(Core::StringView("tasks"));
		json.BeginArray();
		for (const TaskLane* lane : capture.taskLanes) {
			int64 busy = 0;
			for (const TaskRuns* runs : lane->runs)
				for (int64 i = 0; i < runs->starts.Count(); ++i) busy += (runs->ends[i] == kOpen ? capture.lastTicks : runs->ends[i]) - runs->starts[i];
			json.BeginObject();
			json.Field("name", capture.Text(lane->nameStr));
			json.IntField("runs", lane->count);
			json.IntField("threads", lane->runs.Count());
			json.IntField("busyNs", capture.clock.Ns(busy));
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteMemory(IED::JsonWriter& json, const Capture& capture) {
		int64 live = 0;
		int64 liveBytes = 0;
		for (const Pool* pool : capture.pools) {
			live += pool->live.Count();
			liveBytes += pool->inUse;
		}
		int64 pause = 0;
		int64 longest = 0;
		for (const GcRecord& gc : capture.gcs) {
			if (gc.end == kOpen) continue;
			pause += gc.end - gc.begin;
			if (gc.end - gc.begin > longest) longest = gc.end - gc.begin;
		}
		json.Key(Core::StringView("memory"));
		json.BeginObject();
		json.IntField("pools", capture.pools.Count());
		json.IntField("allocations", capture.allocations.Count());
		json.IntField("liveAtEnd", live);
		json.IntField("liveBytesAtEnd", liveBytes);
		json.IntField("collections", capture.gcs.Count());
		json.IntField("gcPauseNs", capture.clock.Ns(pause));
		json.IntField("gcLongestNs", capture.clock.Ns(longest));
		json.EndObject();
	}

	static void WriteWarnings(IED::JsonWriter& json, const Capture& capture) {
		json.IntField("warningCount", capture.warningCount);
		json.Key(Core::StringView("warnings"));
		json.BeginArray();
		for (int64 i = 0; i < capture.warnings.Count() && i < (int64)kSummaryWarnings; ++i) json.String(capture.warnings[i].text.View());
		json.EndArray();
	}

	Core::String Summary(const Capture& capture) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("app", capture.appName.View());
		json.IntField("pid", (int64)capture.pid);
		json.IntField("startUnixNs", capture.startUnixNs);
		json.IntField("durationNs", capture.DurationNs());
		json.BoolField("live", !capture.ended);
		json.IntField("events", capture.events);
		json.IntField("bytes", capture.bytes);
		json.IntField("zones", capture.ZoneCount());
		json.IntField("samples", capture.samples.Count());
		json.IntField("messages", capture.messages.Count());
		json.IntField("eventsDropped", (int64)capture.eventsDropped);
		json.Key(Core::StringView("frames"));
		const FrameSet* set = MainFrameSet(capture);
		if (!set) json.Null();
		else {
			Core::String frames = FrameGraph(capture, 1);
			json.Raw(frames.View());
		}
		WriteThreads(json, capture);
		WriteTopZones(json, capture, "topBySelf", StatsOrder::Self);
		WriteTopZones(json, capture, "topByTotal", StatsOrder::Total);
		WriteTasks(json, capture);
		WriteMemory(json, capture);
		json.Key(Core::StringView("gpu"));
		json.BeginArray();
		for (const GpuContext* gpu : capture.gpus) {
			json.BeginObject();
			json.Field("queue", capture.Text(gpu->nameStr));
			json.IntField("zones", gpu->zones.Count());
			json.BoolField("calibrated", !gpu->calibrationGpu.IsEmpty());
			json.EndObject();
		}
		json.EndArray();
		WriteWarnings(json, capture);
		json.EndObject();
		return json.ToString();
	}

	// --- Compare ------------------------------------------------------------------------------------------------------

	struct SideTotals
	{
		public int64 count;
		public int64 total;
		public int64 self;
	}

	static void TotalsByName(const Capture& capture, Core::HashMap<Core::String, SideTotals>& out) {
		for (const Core::KeyValue<uint64, SiteStats*>& entry : capture.sites) {
			Core::String name = Core::String(capture.SiteName(entry.key));
			SideTotals* totals = out.Find(name);
			if (!totals) {
				SideTotals fresh;
				out.Insert(name, fresh);
				totals = out.Find(name);
			}
			totals->count += entry.value->count;
			totals->total += capture.clock.Ns(entry.value->total);
			totals->self += capture.clock.Ns(entry.value->self);
		}
	}

	static void WriteSide(IED::JsonWriter& json, const char* key, const SideTotals& side) {
		json.Key(Core::StringView(key));
		json.BeginObject();
		json.IntField("count", side.count);
		json.IntField("totalNs", side.total);
		json.IntField("selfNs", side.self);
		json.IntField("meanNs", side.count == 0 ? 0 : side.total / side.count);
		json.EndObject();
	}

	Core::String Compare(const Capture& a, const Capture& b, int32 limit) {
		Core::HashMap<Core::String, SideTotals> left;
		Core::HashMap<Core::String, SideTotals> right;
		TotalsByName(a, left);
		TotalsByName(b, right);
		Core::Array<Core::String> names;
		for (const Core::KeyValue<Core::String, SideTotals>& entry : left) names.Push(entry.key);
		for (const Core::KeyValue<Core::String, SideTotals>& entry : right)
			if (!left.Find(entry.key)) names.Push(entry.key);
		Core::Array<int64> change;
		for (const Core::String& name : names) {
			SideTotals none;
			const SideTotals* l = left.Find(name);
			const SideTotals* r = right.Find(name);
			change.Push((r ? r->total : 0) - (l ? l->total : 0));
		}
		Core::Array<int64> order;
		for (int64 i = 0; i < names.Count(); ++i) order.Push(i);
		order.SortBy([&change](const int64& x, const int64& y) -> bool {
			const int64 cx = change[x] < 0 ? -change[x] : change[x];
			const int64 cy = change[y] < 0 ? -change[y] : change[y];
			return cx > cy;
		});
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("frames"));
		json.BeginObject();
		json.RawField("a", FrameGraph(a, 1).View());
		json.RawField("b", FrameGraph(b, 1).View());
		json.EndObject();
		json.IntField("durationANs", a.DurationNs());
		json.IntField("durationBNs", b.DurationNs());
		json.Key(Core::StringView("zones"));
		json.BeginArray();
		for (int64 k = 0; k < order.Count() && k < (int64)limit; ++k) {
			const Core::String& name = names[order[k]];
			SideTotals none;
			const SideTotals* l = left.Find(name);
			const SideTotals* r = right.Find(name);
			json.BeginObject();
			json.Field("name", name.View());
			WriteSide(json, "a", l ? *l : none);
			WriteSide(json, "b", r ? *r : none);
			json.IntField("totalChangeNs", change[order[k]]);
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// --- Messages -----------------------------------------------------------------------------------------------------

	Core::String Messages(const Capture& capture, int64 fromNs, int64 toNs, int32 leastSeverity, Core::StringView text, int64 offset, int32 limit) {
		const Range range = RangeOfNs(capture, fromNs, toNs);
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		int64 matched = 0;
		for (const MessageRecord& message : capture.messages) {
			if (!range.Holds(message.t) || message.severity < leastSeverity || !ContainsNoCase(capture.Text(message.textStr), text)) continue;
			matched += 1;
			if (matched <= offset || matched > offset + (int64)limit) continue;
			json.BeginObject();
			json.IntField("timeNs", capture.clock.Ns(message.t));
			json.IntField("severity", message.severity);
			json.Field("text", capture.Text(message.textStr));
			json.Field("thread", TrackLabel(capture, capture.tracks[message.track], message.t).View());
			json.EndObject();
		}
		json.EndArray();
		json.IntField("total", matched);
		json.EndObject();
		return json.ToString();
	}
}
