// Locks (F-PRF-18): holds per thread from wait, obtain and release events, which holds were contended, the waits,
// statistics, one hold's details and the timeline's lock rows; a release without a hold is a warning.

include "locks.ch"
include "timeline.ch"
include "ingest.ch"

// A capture of one lock, "Queue", used by two threads (1 ns ticks):
//   thread 1: holds it 10..50 (thread 2 waits from 20, so the hold is contended), then 70..80 (obtained twice)
//   thread 2: waits 20..50, holds 50..60, waits again from 90 and never gets it
//   thread 3: releases it without holding it; its zone ends at 100, the capture's end
static Profiler::Capture* LockCapture() {
	Profiler::WireWriter w;
	w.BeginChunk(Profiler::kGlobalChunk, 0, 0);
	w.Type(Profiler::EventType::Hello);
	w.Varint(1);
	w.Text(Core::StringView("game"));
	w.Varint(42);
	w.Varint(1000000000);
	w.Varint(0);
	w.Varint(0);
	w.Varint(0);
	w.Text(Core::StringView("token"));
	w.EndChunk();
	w.BeginChunk(Profiler::kGlobalChunk, 0, 0);
	w.Type(Profiler::EventType::StringDef);
	w.Varint(1);
	w.Text(Core::StringView("Queue"));
	w.Type(Profiler::EventType::StringDef);
	w.Varint(2);
	w.Text(Core::StringView("Work"));
	w.Type(Profiler::EventType::SrcLocDef);
	w.Varint(1);
	w.Varint(2);
	for (int32 i = 0; i < 4; ++i) w.Varint(0);
	w.Type(Profiler::EventType::LockDef);
	w.Varint(1);
	w.Varint(1);
	w.Varint(0);
	w.EndChunk();
	ThreadOfLocks(w, 1, Core::Array<int64>{ 0, 10, 1, 10, 2, 50, 0, 70, 1, 70, 1, 71, 2, 72, 2, 80 });
	ThreadOfLocks(w, 2, Core::Array<int64>{ 0, 20, 1, 50, 2, 60, 0, 90 });
	ThreadOfLocks(w, 3, Core::Array<int64>{ 2, 30 });
	Profiler::Capture* capture = new Profiler::Capture();
	Profiler::ChunkStream stream;
	stream.Feed(w.Bytes().Data(), w.Length());
	const uint8* chunk;
	int64 length;
	while (stream.Next(chunk, length)) Profiler::ApplyChunk(*capture, chunk, length);
	return capture;
}

// A thread's chunk: a zone 0..100, and lock events as (kind, time) pairs - 0 wait, 1 obtain, 2 release - of lock 1.
static void ThreadOfLocks(Profiler::WireWriter& w, uint64 thread, Core::Array<int64> events) {
	w.BeginChunk(Profiler::kThreadChunk, thread, 0);
	w.Type(Profiler::EventType::ZoneBegin);
	w.Time(0);
	w.Varint(1);
	for (int64 i = 0; i + 1 < events.Count(); i += 2) {
		w.Type(events[i] == 0 ? Profiler::EventType::LockWait : (events[i] == 1 ? Profiler::EventType::LockObtain : Profiler::EventType::LockRelease));
		w.Time(events[i + 1]);
		w.Varint(2);
	}
	w.Type(Profiler::EventType::ZoneEnd);
	w.Time(100);
	w.EndChunk();
}

static Serialization::DomNode Parsed(const Core::String& json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Serialization::ReadJson(json.View(), *doc).root;
}

[test("server.profiler.locks")]
class ProfilerLockTests {
	[test("holds")]
	public static void TestHolds() {
		Profiler::Capture* capture = LockCapture();
		Profiler::LockInfo* lock = capture->lockList[0];
		assert_true(lock->tracks.Count() == 3 && lock->acquisitions == 3, "three threads touched it, two held it three times");
		const Profiler::LockTrack* first = lock->tracks[0];
		assert_true(first->spans.Count() == 2, "a recursive obtain deepens the hold instead of making another");
		assert_true(first->spans[0].wait == 10 && first->spans[0].obtain == 10 && first->spans[0].release == 50, "a hold without a wait");
		assert_true(first->spans[1].obtain == 70 && first->spans[1].release == 80, "the recursive hold ends with its last release");
		const Profiler::LockTrack* second = lock->tracks[1];
		assert_true(second->spans.Count() == 1 && second->spans[0].wait == 20 && second->spans[0].obtain == 50, "a wait, then the hold");
		assert_true(second->waitingSince == 90, "a wait that never got the lock");
		assert_true(capture->warningCount == 1, "a release without a hold is a warning");
	}

	[test("statistics")]
	public static void TestStatistics() {
		Profiler::Capture* capture = LockCapture();
		Profiler::LockAsk ask;
		Serialization::DomNode row = Parsed(Profiler::Locks(*capture, ask)).Member("rows").At(0);
		assert_true(row.Member("name").AsView() == "Queue", "named by its LockDef");
		assert_true(row.Member("acquisitions").AsInt() == 3 && row.Member("contended").AsInt() == 1, "one of three holds was contended");
		assert_true(row.Member("blocked").AsInt() == 2 && row.Member("waitNs").AsInt() == 40 && row.Member("maxWaitNs").AsInt() == 30, "two waits, 30 ns and 10 ns still open at the end");
		assert_true(row.Member("holdNs").AsInt() == 60 && row.Member("maxHoldNs").AsInt() == 40, "held 40 + 10 + 10 ns");
		assert_true(row.Member("threads").AsInt() == 2 && row.Member("stuck").AsInt() == 1, "two threads used it; one still waits");
		Serialization::DomNode worst = row.Member("worst");
		assert_true(worst.Member("track").AsInt() == 1 && worst.Member("fromNs").AsInt() == 20 && worst.Member("toNs").AsInt() == 50, "the longest wait");
		ask.fromNs = 60;
		ask.toNs = 85;
		Serialization::DomNode later = Parsed(Profiler::Locks(*capture, ask)).Member("rows").At(0);
		assert_true(later.Member("acquisitions").AsInt() == 1 && later.Member("blocked").AsInt() == 0, "a range counts the holds obtained in it");
	}

	[test("one_hold")]
	public static void TestOneHold() {
		Profiler::Capture* capture = LockCapture();
		Serialization::DomNode holder = Parsed(Profiler::LockHold(*capture, 1, 0, 0));
		assert_true(holder.Member("state").AsView() == "contended" && holder.Member("holdNs").AsInt() == 40, "thread 1's first hold was contended");
		Serialization::DomNode waiters = holder.Member("waitedBy");
		assert_true(waiters.Count() == 1 && waiters.At(0).Member("fromNs").AsInt() == 20 && waiters.At(0).Member("toNs").AsInt() == 50, "thread 2 waited for it");
		Serialization::DomNode waiter = Parsed(Profiler::LockHold(*capture, 1, 1, 0));
		assert_true(waiter.Member("state").AsView() == "held" && waiter.Member("waitNs").AsInt() == 30, "thread 2 waited 30 ns, then held it alone");
		assert_true(waiter.Member("heldBy").Count() == 1 && waiter.Member("heldBy").At(0).Member("track").AsInt() == 0, "while thread 1 held it");
		Serialization::DomNode stuck = Parsed(Profiler::LockHold(*capture, 1, 1, 1));
		assert_true(stuck.Member("state").AsView() == "waiting" && stuck.Member("obtainNs").IsNull() && stuck.Member("waitNs").AsInt() == 10, "the wait still open");
		assert_true(Profiler::LockHold(*capture, 1, 0, 5).IsEmpty() && Profiler::LockHold(*capture, 9, 0, 0).IsEmpty(), "nothing for a hold or a lock that is not there");
	}

	[test("timeline_rows")]
	public static void TestTimelineRows() {
		Profiler::Capture* capture = LockCapture();
		Profiler::TimelineAsk ask;
		ask.width = 1000;
		Serialization::DomNode lanes = Parsed(Profiler::Timeline(*capture, ask)).Member("lanes");
		Serialization::DomNode first = lanes.At(0).Member("locks").At(0);
		assert_true(first.Member("name").AsView() == "Queue", "a row per lock the thread used");
		Serialization::DomNode items = first.Member("items");
		assert_true(items.Count() == 2, "two holds, no waits");
		assert_true(items.At(0).At(0).AsInt() == 10 && items.At(0).At(1).AsInt() == 50 && items.At(0).At(2).AsInt() == 1 && items.At(0).At(3).AsInt() == 0, "[start, end, contended, hold 0]");
		assert_true(items.At(1).At(2).AsInt() == 0 && items.At(1).At(3).AsInt() == 1, "the second hold uncontended");
		Serialization::DomNode second = lanes.At(1).Member("locks").At(0).Member("items");
		assert_true(second.Count() == 3, "a wait, a hold, the wait still open");
		assert_true(second.At(0).At(2).AsInt() == 2 && second.At(0).At(0).AsInt() == 20 && second.At(0).At(1).AsInt() == 50, "blocked 20..50");
		assert_true(second.At(2).At(2).AsInt() == 2 && second.At(2).At(1).AsInt() == 100 && second.At(2).At(3).AsInt() == 1, "the open wait runs to the end, one past the holds");
		ask.width = 2;
		Serialization::DomNode narrow = Parsed(Profiler::Timeline(*capture, ask)).Member("lanes").At(0).Member("locks").At(0).Member("items");
		assert_true(narrow.Count() == 1 && narrow.At(0).At(3).AsInt() == -2 && narrow.At(0).At(2).AsInt() == 1, "holds narrower than a pixel merge, keeping the worst state");
	}
}
