// Why the slow frames are slow (T-PRF-15). A frame is slow past a threshold - twice the median frame when none is
// asked. In each, every zone's self time on its thread is set against what that zone takes in a frame on average - on
// the thread that marks the frames as it is, on another thread scaled by the frame's length, since a worker that runs
// all the time does more of it in a longer frame without slowing it: the zones far past their usual time, the
// collections, lock waits and allocations against their usual, and the warnings logged in it are the causes. Then the
// causes are counted over every slow frame.
include "investigate.ch"

namespace Profiler
{
	const int32 kHitchZones = 4;
	const int32 kHitchWaits = 2;
	const int32 kHitchMessages = 3;
	const int32 kHitchCauses = 10;
	const int32 kWarningSeverity = 3;

	void SlowFrames(const Capture& capture, const FrameSet* set, int64 thresholdTicks, Core::Array<int64>& out, int64& threshold, int64& median) {
		out.Clear();
		threshold = 0;
		median = 0;
		if (!set) return;
		Core::Array<int64> durations;
		for (int64 i = 0; i < set->starts.Count(); ++i)
			if (set->ends[i] != kOpen) durations.Push(set->ends[i] - set->starts[i]);
		durations.Sort();
		median = Quantile(durations, 0.5);
		threshold = thresholdTicks >= 0 ? thresholdTicks : median * 2;
		if (threshold <= 0) return;
		for (int64 i = 0; i < set->starts.Count(); ++i)
			if (set->ends[i] != kOpen && set->ends[i] - set->starts[i] > threshold) out.Push(i);
		out.SortBy([set](const int64& a, const int64& b) -> bool { return set->ends[a] - set->starts[a] > set->ends[b] - set->starts[b]; });
	}

	static uint64 TrackSite(int64 track, uint64 site) {
		return ((uint64)track << 32) | site;
	}

	// What each zone (per thread) takes in a frame on average, over every completed frame.
	class UsualTimes
	{
		public Core::HashMap<uint64, int64> selfOf;
		public int64 frames;
		public int64 meanFrame;                 // ticks
		public int64 frameTrack = -1;
		public Core::Array<int64> allocsOf;     // allocations in each frame
		public double allocMean;

		public void Build(const Capture& capture, const FrameSet* set) {
			frames = set->Completed();
			frameTrack = (int64)set->track;
			allocsOf.Resize(set->starts.Count());
			if (frames == 0) return;
			const int64 begin = set->starts[0];
			const int64 end = set->ends[frames - 1];
			meanFrame = (end - begin) / frames;
			for (int64 t = 0; t < capture.tracks.Count(); ++t) {
				const ThreadTrack* track = capture.tracks[t];
				for (const ZoneLevel* level : track->levels) {
					const int64 stop = level->FirstStartingAt(end);
					for (int64 i = level->FirstStartingAt(begin); i < stop; ++i) {
						if (level->ends[i] == kOpen) continue;
						const uint64 key = TrackSite(t, (uint64)level->sites[i]);
						int64* known = selfOf.Find(key);
						if (known) *known += level->selfs[i];
						else selfOf.Insert(key, level->selfs[i]);
					}
				}
			}
			int64 allocs = 0;
			for (const Allocation& allocation : capture.allocations) {
				const int64 f = FrameAt(set, allocation.t);
				if (f < 0 || f >= frames) continue;
				allocsOf[f] += 1;
				allocs += 1;
			}
			allocMean = (double)allocs / (double)frames;
		}

		public int64 PerFrame(uint64 key) const {
			int64 total = 0;
			selfOf.TryGet(key, total);
			return frames == 0 ? 0 : total / frames;
		}

		// What a zone usually takes in a frame `length` long: as much on the frame thread, in proportion elsewhere.
		public int64 Usual(uint64 key, int64 track, int64 length) const {
			const int64 perFrame = PerFrame(key);
			if (frameTrack < 0 || track == frameTrack || meanFrame <= 0) return perFrame;
			return (int64)((double)perFrame * (double)length / (double)meanFrame);
		}
	}

	// A zone's time in one frame on one thread, and its longest instance there.
	class FrameZone
	{
		public uint64 key;
		public int64 track;
		public uint64 site;
		public int64 self;
		public int64 excess;
		public int64 longest = -1;
		public ZoneRef ref;
	}

	class LockWaitIn
	{
		public uint64 lock;
		public int32 track;
		public int64 ns;
	}

	// A cause counted over the slow frames.
	class Cause
	{
		public Core::String kind;
		public Core::String name;
		public Core::String thread;
		public int64 frames;
		public int64 total;
	}

	class CauseTally
	{
		public Core::HashMap<Core::String, int64> slotOf;
		public Core::Array<Cause*> causes;

		public void Add(const char* kind, Core::StringView name, Core::StringView thread, int64 ticks) {
			Core::String key = Core::String(kind) + ":" + name + "@" + thread;
			int64 slot;
			if (!slotOf.TryGet(key, slot)) {
				Cause* cause = new Cause();
				cause->kind = Core::String(kind);
				cause->name = Core::String(name);
				cause->thread = Core::String(thread);
				slot = causes.Count();
				causes.Push(cause);
				slotOf.Insert(key, slot);
			}
			causes[slot]->frames += 1;
			causes[slot]->total += ticks;
		}
	}

	static void ZonesInFrame(const Capture& capture, const UsualTimes& usual, Range frame, Core::Array<FrameZone*>& out) {
		Core::HashMap<uint64, FrameZone*> zoneOf;
		for (int64 t = 0; t < capture.tracks.Count(); ++t) {
			const ThreadTrack* track = capture.tracks[t];
			for (int64 depth = 0; depth < track->levels.Count(); ++depth) {
				const ZoneLevel* level = track->levels[depth];
				const int64 stop = level->FirstStartingAt(frame.end);
				for (int64 i = level->FirstStartingAt(frame.begin); i < stop; ++i) {
					if (level->ends[i] == kOpen) continue;
					const uint64 key = TrackSite(t, (uint64)level->sites[i]);
					FrameZone* zone = nullptr;
					if (!zoneOf.TryGet(key, zone)) {
						zone = new FrameZone();
						zone->key = key;
						zone->track = t;
						zone->site = (uint64)level->sites[i];
						out.Push(zone);
						zoneOf.Insert(key, zone);
					}
					zone->self += level->selfs[i];
					if (level->ends[i] - level->starts[i] > zone->longest) {
						zone->longest = level->ends[i] - level->starts[i];
						zone->ref = ZoneRef::Of(t, depth, i);
					}
				}
			}
		}
		for (FrameZone* zone : out) zone->excess = zone->self - usual.Usual(zone->key, zone->track, frame.Length());
		out.SortBy([](FrameZone* a, FrameZone* b) -> bool { return a->excess > b->excess; });
	}

	static int64 Overlap(Range range, int64 begin, int64 end) {
		const int64 from = begin > range.begin ? begin : range.begin;
		const int64 to = end < range.end ? end : range.end;
		return to > from ? to - from : 0;
	}

	static void WaitsInFrame(const Capture& capture, Range frame, Core::Array<LockWaitIn*>& out) {
		for (const LockInfo* lock : capture.lockList) {
			for (const LockTrack* holder : lock->tracks) {
				int64 ns = 0;
				for (int64 i = FirstReleasedAfter(holder, frame.begin, capture.lastTicks); i < holder->spans.Count(); ++i) {
					const LockSpan& span = holder->spans[i];
					if (span.wait >= frame.end) break;
					ns += Overlap(frame, span.wait, span.obtain);
				}
				if (holder->waitingSince >= 0) ns += Overlap(frame, holder->waitingSince, capture.lastTicks);
				if (ns == 0) continue;
				LockWaitIn* wait = new LockWaitIn();
				wait->lock = lock->id;
				wait->track = holder->track;
				wait->ns = ns;
				out.Push(wait);
			}
		}
		out.SortBy([](LockWaitIn* a, LockWaitIn* b) -> bool { return a->ns > b->ns; });
	}

	static int64 GcInFrame(const Capture& capture, Range frame, int64& count) {
		int64 ns = 0;
		count = 0;
		for (const GcRecord& gc : capture.gcs) {
			if (gc.end == kOpen) continue;
			const int64 overlap = Overlap(frame, gc.begin, gc.end);
			if (overlap == 0) continue;
			ns += overlap;
			count += 1;
		}
		return ns;
	}

	// The time the frame thread spent inside its top-level zones during a frame.
	static int64 FrameThreadBusy(const Capture& capture, int64 track, Range frame) {
		if (track < 0 || track >= capture.tracks.Count() || capture.tracks[track]->levels.IsEmpty()) return -1;
		const ZoneLevel* top = capture.tracks[track]->levels[0];
		int64 busy = 0;
		const int64 stop = top->FirstStartingAt(frame.end);
		for (int64 i = top->FirstEndingAfter(frame.begin); i < stop; ++i) busy += Overlap(frame, top->starts[i], top->EndOr(i, capture.lastTicks));
		return busy;
	}

	static int64 FirstMessageAt(const Capture& capture, int64 t) {
		int64 low = 0;
		int64 high = capture.messages.Count();
		while (low < high) {
			const int64 mid = (low + high) / 2;
			if (capture.messages[mid].t < t) low = mid + 1;
			else high = mid;
		}
		return low;
	}

	static void WriteSlowFrame(IED::JsonWriter& json, const Capture& capture, const FrameSet* set, const UsualTimes& usual, int64 f, int64 median, CauseTally& causes, bool detail) {
		Range frame;
		frame.begin = set->starts[f];
		frame.end = set->ends[f];
		Core::Array<FrameZone*> zones;
		ZonesInFrame(capture, usual, frame, zones);
		Core::Array<LockWaitIn*> waits;
		WaitsInFrame(capture, frame, waits);
		int64 gcCount;
		const int64 gcNs = GcInFrame(capture, frame, gcCount);
		const int64 least = frame.Length() / 100;
		for (int64 k = 0; k < zones.Count() && k < (int64)kHitchZones && zones[k]->excess > least; ++k)
			causes.Add("zone", capture.SiteName(zones[k]->site), TrackLabel(capture, capture.tracks[zones[k]->track], frame.begin).View(), zones[k]->excess);
		if (gcCount > 0) causes.Add("gc", Core::StringView("collections"), Core::StringView(""), gcNs);
		for (int64 k = 0; k < waits.Count() && k < (int64)kHitchWaits; ++k) {
			LockInfo* lock = nullptr;
			capture.locks.TryGet(waits[k]->lock, lock);
			causes.Add("lock", LockName(capture, lock).View(), TrackLabel(capture, capture.tracks[(int64)waits[k]->track], frame.begin).View(), waits[k]->ns);
		}
		const int64 allocs = usual.allocsOf[f];
		if (usual.allocMean > 0.0 && (double)allocs > usual.allocMean * 2.0) causes.Add("allocations", Core::StringView("allocations"), Core::StringView(""), 0);
		if (!detail) return;
		json.BeginObject();
		json.IntField("index", f);
		json.IntField("startNs", capture.clock.Ns(frame.begin));
		json.IntField("durationNs", capture.clock.Ns(frame.Length()));
		json.IntField("overNs", capture.clock.Ns(frame.Length() - median));
		const int64 busy = FrameThreadBusy(capture, (int64)set->track, frame);
		json.Field("frameThread", busy < 0 ? Core::StringView("") : TrackLabel(capture, capture.tracks[(int64)set->track], frame.begin).View());
		json.IntField("frameThreadBusyNs", busy < 0 ? -1 : capture.clock.Ns(busy));
		json.Key(Core::StringView("zones"));
		json.BeginArray();
		for (int64 k = 0; k < zones.Count() && k < (int64)kHitchZones && zones[k]->excess > least; ++k) {
			const FrameZone* zone = zones[k];
			const SrcLoc* loc = capture.srclocs.Find(zone->site);
			json.BeginObject();
			json.Field("name", capture.SiteName(zone->site));
			json.Field("thread", TrackLabel(capture, capture.tracks[zone->track], frame.begin).View());
			json.Field("ref", zone->ref.Text().View());
			json.Field("file", loc ? capture.Text(loc->fileStr) : Core::StringView(""));
			json.IntField("line", loc ? (int64)loc->line : 0);
			json.IntField("selfNs", capture.clock.Ns(zone->self));
			json.IntField("usualNs", capture.clock.Ns(usual.Usual(zone->key, zone->track, frame.Length())));
			json.EndObject();
		}
		json.EndArray();
		json.Key(Core::StringView("gc"));
		json.BeginObject();
		json.IntField("count", gcCount);
		json.IntField("ns", capture.clock.Ns(gcNs));
		json.EndObject();
		json.Key(Core::StringView("waits"));
		json.BeginArray();
		for (int64 k = 0; k < waits.Count() && k < (int64)kHitchWaits; ++k) {
			LockInfo* lock = nullptr;
			capture.locks.TryGet(waits[k]->lock, lock);
			json.BeginObject();
			json.Field("lock", LockName(capture, lock).View());
			json.Field("thread", TrackLabel(capture, capture.tracks[(int64)waits[k]->track], frame.begin).View());
			json.IntField("ns", capture.clock.Ns(waits[k]->ns));
			json.EndObject();
		}
		json.EndArray();
		json.Key(Core::StringView("allocations"));
		json.BeginObject();
		json.IntField("count", allocs);
		NumberField(json, "usual", usual.allocMean, 1);
		json.EndObject();
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		int64 written = 0;
		for (int64 i = FirstMessageAt(capture, frame.begin); i < capture.messages.Count() && capture.messages[i].t < frame.end && written < (int64)kHitchMessages; ++i) {
			const MessageRecord& message = capture.messages[i];
			if (message.severity < kWarningSeverity) continue;
			json.BeginObject();
			json.IntField("timeNs", capture.clock.Ns(message.t));
			json.IntField("severity", message.severity);
			json.Field("text", capture.Text(message.textStr));
			json.EndObject();
			written += 1;
		}
		json.EndArray();
		json.EndObject();
	}

	Core::String Hitches(const Capture& capture, const HitchAsk& ask) {
		const FrameSet* set = MainFrameSet(capture);
		Core::Array<int64> slow;
		int64 threshold;
		int64 median;
		SlowFrames(capture, set, ask.thresholdNs < 0 ? -1 : capture.clock.Ticks(ask.thresholdNs), slow, threshold, median);
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("frames", set ? set->Completed() : 0);
		json.IntField("medianNs", capture.clock.Ns(median));
		json.IntField("thresholdNs", capture.clock.Ns(threshold));
		json.IntField("slow", slow.Count());
		json.IntField("worstNs", slow.IsEmpty() ? 0 : capture.clock.Ns(set->ends[slow[0]] - set->starts[slow[0]]));
		CauseTally causes;
		json.Key(Core::StringView("list"));
		json.BeginArray();
		if (!slow.IsEmpty()) {
			UsualTimes usual;
			usual.Build(capture, set);
			for (int64 k = 0; k < slow.Count(); ++k) WriteSlowFrame(json, capture, set, usual, slow[k], median, causes, k < (int64)ask.limit);
		}
		json.EndArray();
		causes.causes.SortBy([](Cause* a, Cause* b) -> bool { return a->frames != b->frames ? a->frames > b->frames : a->total > b->total; });
		json.Key(Core::StringView("causes"));
		json.BeginArray();
		for (int64 k = 0; k < causes.causes.Count() && k < (int64)kHitchCauses; ++k) {
			const Cause* cause = causes.causes[k];
			json.BeginObject();
			json.Field("kind", cause->kind.View());
			json.Field("name", cause->name.View());
			json.Field("thread", cause->thread.View());
			json.IntField("frames", cause->frames);
			json.IntField("meanNs", capture.clock.Ns(cause->total / cause->frames));
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}
}
