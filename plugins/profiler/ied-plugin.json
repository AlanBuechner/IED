// The profiler (docs/16, docs/features/12-profiler.md): programs instrumented with an ITP client (Bedrock Profile::,
// the C/C++, Go and Rust clients) connect to the listener its server code opens and stream captures into the
// workspace's .ied/local/captures; Chrome traces and pprof profiles import. The Profiler activity shows the capture
// library and opens each capture as a document: the frame graph, the timeline by thread or by task, statistics, find
// zone, the flame graph, messages and memory. The AI reads captures through the profile_* tools.
{
	"manifestVersion": 1,
	"id": "ied.profiler",
	"name": "Profiler",
	"version": "0.1.0",
	"description": "A Tracy-class profiler on the IED trace protocol: live captures, timeline, statistics, flame graph, memory, and AI tools.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "Profiler::Activate", "ui": "ui/index.js" },
	"permissions": ["profiler", "net.listen", "fs.read", "fs.write", "process.spawn", "ai.tools"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Profiler" },
		"skills": ["skills"],
		"bindings": {
			"provides": [
				{ "name": "profiler.query", "version": "1", "kind": "function", "description": "A profile_* tool's answer as text: {wsId, tool: list|summary|diagnose|top_zones|frame|hitches|threads|zone|timeline|find_zone|flame|messages|allocations|leaks|memory|plots|locks|annotate|compare|capture, args} -> {text}." }
			],
			"consumes": [
				{ "name": "profiler.query", "version": "1" }
			]
		},
		"activities": [
			{ "id": "ied.profiler", "title": "Profiler", "icon": "$(pulse)", "order": 40 }
		],
		"toolWindows": [
			{ "id": "ied.profiler.captures", "title": "Captures", "icon": "$(history)", "view": "CaptureLibrary", "defaultDock": "left", "activity": "ied.profiler" }
		],
		"statusBarItems": [
			{ "id": "ied.profiler.status", "alignment": "left", "priority": 20, "view": "ProfilerStatus" }
		],
		"fileIcons": [
			{ "extensions": [".iedtrace"], "icon": "$(pulse)", "color": "--hue-orange" }
		],
		"commands": [
			{ "id": "ied.profiler.show", "title": "Profiler", "category": "View", "icon": "$(pulse)" },
			{ "id": "ied.profiler.profile", "title": "Start Profiling", "category": "Debug", "icon": "$(pulse)" },
			{ "id": "ied.profiler.stop", "title": "Stop Profiling", "category": "Debug", "icon": "$(debug-stop)" },
			{ "id": "ied.profiler.open", "title": "Open in Profiler", "category": "Solution Explorer", "icon": "$(pulse)" },
			{ "id": "ied.profiler.import", "title": "Import into Profiler", "category": "Solution Explorer", "icon": "$(pulse)" },
			{ "id": "ied.profiler.connect", "title": "Connect a Program to the Profiler...", "category": "Debug", "icon": "$(plug)" }
		],
		"menus": {
			"menubar/view": [
				{ "command": "ied.profiler.show", "group": "2_windows" }
			],
			"menubar/debug": [
				{ "command": "ied.profiler.profile", "group": "5_profile" },
				{ "command": "ied.profiler.stop", "group": "5_profile" },
				{ "command": "ied.profiler.connect", "group": "5_profile" }
			],
			"explorer/context": [
				{ "command": "ied.profiler.open", "group": "1_open", "when": "explorerItemKind == 'file' && explorerItemExtension == '.iedtrace'" },
				{ "command": "ied.profiler.import", "group": "1_open", "when": "explorerItemKind == 'file' && (explorerItemExtension == '.json' || explorerItemExtension == '.pprof' || explorerItemExtension == '.pb' || explorerItemExtension == '.gz' || explorerItemExtension == '.prof')" }
			]
		},
		"keybindings": [
			{ "command": "ied.profiler.profile", "key": "alt+f2" },
			{ "command": "ied.profiler.show", "key": "ctrl+alt+f2" }
		],
		"systemMessageSections": [
			{ "id": "profiler", "text": "The profiler holds the workspace's captures (.ied/local/captures); the profile_* tools read them. Start with profile_diagnose: it lists the problems that stand out (slow frames, hot zones, work on one thread, lock contention, allocations every frame, memory that keeps growing, collections), each with its evidence and the tool that looks closer. Slow or stuttering: profile_hitches, profile_frame, profile_top_zones, profile_find_zone, profile_flame, profile_threads, profile_locks. Memory: profile_memory (growth, a rising floor, collections), profile_leaks (what is never freed), profile_allocations (who allocates, per frame, churn). Drill down with profile_zone (a [ref] other tools print) and profile_timeline (a window in order); profile_plots reads the program's counters, profile_messages its log; profile_compare checks a fix against the capture before it. profile_capture runs the project's Profile task and records; profile_annotate marks a finding on the capture's timeline. Report numbers with their source lines. Read the profiler skill before instrumenting code." }
		],
		"toolCalls": [
			{
				"name": "profile_list",
				"description": "The workspace's profiler captures, newest first: id, app, when, duration, zones, frames, and whether it is still recording.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
				"function": "Profiler::ListTool"
			},
			{
				"name": "profile_summary",
				"description": "One capture at a glance: duration, frame times (mean, median, p95, max), threads, the costliest zones by self and by total time, tasks, memory and GC, warnings. `capture` is a capture id from profile_list, a .iedtrace path, or \"latest\" (the default).",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" } }, "additionalProperties": false },
				"function": "Profiler::SummaryTool"
			},
			{
				"name": "profile_top_zones",
				"description": "Zones ranked by time: count, total, self, mean, median, p95 and max per zone, optionally per thread or per task, over the whole capture or a time range in milliseconds.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "by": { "enum": ["self", "total", "count", "mean", "median", "p95", "max"] }, "group_by": { "enum": ["zone", "thread", "task"] }, "from_ms": { "type": "number" }, "to_ms": { "type": "number" }, "filter": { "type": "string" }, "n": { "type": "integer", "minimum": 1, "maximum": 200 } }, "additionalProperties": false },
				"function": "Profiler::TopZonesTool"
			},
			{
				"name": "profile_frame",
				"description": "One frame's breakdown: its time against the capture's frame times, each thread's top-level zones and busy time in it, its costliest zones by self time, collections and GPU work in it. `index` is a frame number or \"worst\" (the default).",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "index": { "type": ["integer", "string"] } }, "additionalProperties": false },
				"function": "Profiler::FrameTool"
			},
			{
				"name": "profile_find_zone",
				"description": "Every instance of one zone (by name): count, mean, median, p95, min and max, the distribution, and the slowest instances with when and on which thread they ran.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "name": { "type": "string" }, "from_ms": { "type": "number" }, "to_ms": { "type": "number" } }, "required": ["name"], "additionalProperties": false },
				"function": "Profiler::FindZoneTool"
			},
			{
				"name": "profile_flame",
				"description": "The call tree merged by name (a flame graph as text): each node's total and self time and count, children by cost, small nodes pruned. From zones, or from call stack samples for imported pprof profiles.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "from_ms": { "type": "number" }, "to_ms": { "type": "number" }, "depth": { "type": "integer", "minimum": 1, "maximum": 64 }, "min_percent": { "type": "number", "minimum": 0, "maximum": 100 } }, "additionalProperties": false },
				"function": "Profiler::FlameTool"
			},
			{
				"name": "profile_messages",
				"description": "The capture's log messages in time order, filtered by least severity (0 trace .. 5 fatal) and text.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "severity": { "type": "integer", "minimum": 0, "maximum": 5 }, "text": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 500 } }, "additionalProperties": false },
				"function": "Profiler::MessagesTool"
			},
			{
				"name": "profile_leaks",
				"description": "Allocations still live at the end of a capture (or at at_ms), only those made between from_ms and to_ms when given (a level loaded and unloaded), grouped by zone (the default without call stacks), zone path, call stack, pool, thread or size, the most bytes first; each group's first and last allocation and whether it keeps accumulating (a likely leak) or was made at once (a cache); plus each pool's peak. For a collected program (C4): the types whose live objects keep accumulating from one collection's census to the next.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "group_by": { "enum": ["zone", "path", "callstack", "pool", "thread", "size"] }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "at_ms": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
				"function": "Profiler::LeaksTool"
			},
			{
				"name": "profile_allocations",
				"description": "Where a program allocates: per zone (the innermost zone open on the allocating thread; the default without call stacks), zone path, thread, pool, size class or call stack - allocations and bytes in all and per frame, mean size, churn (the share freed within the frame it was made in) and what is still live at the range's end; the range's allocations per frame (mean, median, p95, the worst frame) and per second. A collected program (C4) that counts its allocations is read by each zone's own count; a capture with only allocation samples, by function.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "group_by": { "enum": ["zone", "path", "thread", "pool", "size", "callstack"] }, "by": { "enum": ["count", "bytes"] }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "n": { "type": "integer", "minimum": 1, "maximum": 200 } }, "additionalProperties": false },
				"function": "Profiler::AllocationsTool"
			},
			{
				"name": "profile_memory",
				"description": "Memory over time: each pool and memory plot (the GC heap, the Go heap) at evenly spaced points with its growth, peak and floor (the lowest it got in each step - a floor that keeps rising is memory the program keeps), the heap left after each collection, and collections: how many, how often, their pauses, the longest and how many fell in slow frames.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "points": { "type": "integer", "minimum": 2, "maximum": 100 } }, "additionalProperties": false },
				"function": "Profiler::MemoryTool"
			},
			{
				"name": "profile_plots",
				"description": "The program's own counters (plots: entities, draw calls, queue lengths) over time: each one's min, mean, max and last, and its values at evenly spaced points; `name` picks one (memory plots are in profile_memory).",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "name": { "type": "string" }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "points": { "type": "integer", "minimum": 2, "maximum": 100 } }, "additionalProperties": false },
				"function": "Profiler::PlotsTool"
			},
			{
				"name": "profile_hitches",
				"description": "The slow frames (over threshold_ms, else twice the median), the slowest first, and what made each slow: the zones far past their usual time a frame (own time, thread, [ref], source line), collections, lock waits, allocations against the usual and warnings logged; then the causes counted over every slow frame.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "threshold_ms": { "type": "number", "minimum": 0 }, "n": { "type": "integer", "minimum": 1, "maximum": 50 } }, "additionalProperties": false },
				"function": "Profiler::HitchesTool"
			},
			{
				"name": "profile_threads",
				"description": "Each thread's busy time and share of the range (time inside its top-level zones), its longest idle gap, its lock waits and its costliest zones; and how many threads were busy at once on average - whether the work runs side by side or on one thread.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
				"function": "Profiler::ThreadsTool"
			},
			{
				"name": "profile_zone",
				"description": "One zone up close by the [ref] other tools print (track:depth:index): its time and own time, thread, task, frame, text and value, source, the zones it is inside, its children by name, and the allocations, lock waits, messages and collections inside it.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "ref": { "type": "string", "pattern": "^[0-9]+:[0-9]+:[0-9]+$" } }, "required": ["ref"], "additionalProperties": false },
				"function": "Profiler::ZoneTool"
			},
			{
				"name": "profile_timeline",
				"description": "What happened between from_ms and to_ms, per thread in time order: zones down to `depth` (0 a thread's top level; default 2) with their times, [refs] and allocations, lock waits and messages; collections. `thread` keeps the threads whose name holds it.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "depth": { "type": "integer", "minimum": 0, "maximum": 64 }, "thread": { "type": "string" } }, "required": ["from_ms", "to_ms"], "additionalProperties": false },
				"function": "Profiler::TimelineTool"
			},
			{
				"name": "profile_diagnose",
				"description": "The first look at a capture: the problems that stand out, most costly first, each with its evidence and the tool call that looks closer - slow frames and their causes, memory that keeps growing, allocations never freed, lock contention, allocations every frame and churn, collections, hot zones, work serialized on one thread, dropped events. `focus` keeps one area.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "focus": { "enum": ["all", "frames", "cpu", "memory", "locks"] } }, "additionalProperties": false },
				"function": "Profiler::DiagnoseTool"
			},
			{
				"name": "profile_locks",
				"description": "Lock contention in a capture: each lock's waits (time threads were blocked), contended holds (another thread waited as it was released), holds, threads and source, most waited for first; and the longest waits with who waited and when.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "by": { "enum": ["wait", "max_wait", "contended", "hold", "acquisitions"] }, "from_ms": { "type": "number" }, "to_ms": { "type": "number" }, "n": { "type": "integer", "minimum": 1, "maximum": 200 } }, "additionalProperties": false },
				"function": "Profiler::LocksTool"
			},
			{
				"name": "profile_annotate",
				"description": "Adds a note to a capture's time range (from_ms to to_ms; to_ms left out for a moment), kept in its trace file: mark a finding where the owner will see it on the timeline. The summary lists a capture's notes.",
				"class": "write",
				"group": "profiler",
				"inputSchema": { "type": "object", "properties": { "capture": { "type": "string" }, "from_ms": { "type": "number", "minimum": 0 }, "to_ms": { "type": "number", "minimum": 0 }, "text": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "required": ["from_ms", "text"], "additionalProperties": false },
				"function": "Profiler::AnnotateTool"
			},
			{
				"name": "profile_compare",
				"description": "Two captures compared (a before b): frame times side by side, allocations, peak memory and collection pauses, and the zones whose total time changed most.",
				"class": "read",
				"group": "profiler",
				"parallelSafe": true,
				"inputSchema": { "type": "object", "properties": { "a": { "type": "string" }, "b": { "type": "string" }, "n": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": ["a", "b"], "additionalProperties": false },
				"function": "Profiler::CompareTool"
			},
			{
				"name": "profile_capture",
				"description": "Builds and runs the startup project's Profile task (its program started with IED_PROFILER), records for `seconds`, stops the program and returns the new capture's summary. The program must be instrumented with an ITP client.",
				"class": "exec",
				"group": "profiler",
				"inputSchema": { "type": "object", "properties": { "seconds": { "type": "number", "minimum": 0.5, "maximum": 600 }, "project": { "type": "string" } }, "additionalProperties": false },
				"function": "Profiler::CaptureTool",
				"timeoutSeconds": 900
			}
		]
	}
}
