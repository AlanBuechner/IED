// The plans of the git tools that change a repository (docs/13 "What the approval card shows"): what a call will do,
// read from the repository as the tool will find it, for the owner to approve before it runs. They only read.

include "Tools.ch"

namespace Git
{
	const char* c_EmptyTree = "4b825dc642cb6eb9a060e54bf8d69288fbee4904";

	// --- The card's diff ---------------------------------------------------------------------------------------------

	static bool StartsBody(Core::StringView line) {
		return line.StartsWith(Core::StringView("@@")) || line.StartsWith(Core::StringView("Binary files "));
	}

	void PlanDiff::AddFile(Core::StringView section) {
		int64 bodyAt = -1;
		int64 at = 0;
		int64 added = 0;
		int64 removed = 0;
		for (Core::StringView line : SplitOn(section, '\n')) {
			if (bodyAt < 0 && StartsBody(line)) bodyAt = at;
			else if (bodyAt >= 0 && line.StartsWith(Core::StringView("+"))) added += 1;
			else if (bodyAt >= 0 && line.StartsWith(Core::StringView("-"))) removed += 1;
			at += line.ByteLength() + 1;
		}
		m_Files += 1;
		m_Plus += added;
		m_Minus += removed;
		const bool fits = m_Text.ByteLength() + section.ByteLength() <= m_Most;
		if (!fits && bodyAt >= 0) m_Named += 1;
		m_Text.Append(fits || bodyAt < 0 ? section : section.Substring(0, bodyAt));
	}

	void PlanDiff::AddDiff(Core::StringView diff) {
		int64 start = -1;
		int64 at = 0;
		for (Core::StringView line : SplitOn(diff, '\n')) {
			if (line.StartsWith(Core::StringView("diff --git ")) || line.StartsWith(Core::StringView("diff --cc "))) {
				if (start >= 0) AddFile(diff.Substring(start, at - start));
				start = at;
			}
			at += line.ByteLength() + 1;
		}
		if (start >= 0 && start < diff.ByteLength()) AddFile(diff.Substring(start, diff.ByteLength() - start));
	}

	void PlanDiff::AddNewFile(Core::StringView path, Core::StringView noIndex) {
		Core::StringBuilder section;
		section.Append("diff --git a/");
		section.Append(path);
		section.Append(" b/");
		section.Append(path);
		section.Append("\nnew file mode 100644\n--- /dev/null\n+++ b/");
		section.Append(path);
		section.Append("\n");
		bool body = false;
		for (Core::StringView line : SplitOn(noIndex, '\n')) {
			body = body || StartsBody(line);
			if (!body || line.IsEmpty()) continue;
			if (line.StartsWith(Core::StringView("Binary files "))) {
				section.Append("Binary files /dev/null and b/");
				section.Append(path);
				section.Append(" differ\n");
				continue;
			}
			section.Append(line);
			section.Append("\n");
		}
		AddFile(section.View());
		if (noIndex.IsEmpty()) m_Named += 1;
	}

	Core::String HunksDiff(const GitDiff& diff, Core::StringView path, const Core::Array<int64>& hunks) {
		const bool created = diff.m_FileHeader.Contains(Core::String("--- /dev/null"));
		const bool deleted = diff.m_FileHeader.Contains(Core::String("+++ /dev/null"));
		Core::StringBuilder out;
		out.Append("diff --git a/");
		out.Append(path);
		out.Append(" b/");
		out.Append(path);
		out.Append(created ? "\n--- /dev/null\n+++ b/" : "\n--- a/");
		if (!created) {
			out.Append(path);
			out.Append(deleted ? "\n+++ /dev/null" : "\n+++ b/");
		}
		if (!deleted) out.Append(path);
		out.Append("\n");
		for (int64 hunk : hunks) {
			out.Append(diff.m_Hunks[hunk - 1].m_Header.View());
			out.Append(" (hunk ");
			out.AppendInt(hunk);
			out.Append(")\n");
			for (const Core::String& line : diff.m_Hunks[hunk - 1].m_Lines) {
				out.Append(line.View());
				out.Append("\n");
			}
		}
		return out.ToString();
	}

	Core::String CountWords(int64 files, int64 plus, int64 minus) {
		Core::StringBuilder out;
		out.AppendInt(files);
		out.Append(files == 1 ? " file, +" : " files, +");
		out.AppendInt(plus);
		out.Append(" -");
		out.AppendInt(minus);
		return out.ToString();
	}

	Core::String PathWords(const Core::Array<Core::String>& paths) {
		Core::StringBuilder out;
		for (int64 i = 0; i < paths.Count() && i < c_PlanPathsNamed; ++i) {
			if (i > 0) out.Append(", ");
			out.Append(paths[i].View());
		}
		if (paths.Count() > c_PlanPathsNamed) {
			out.Append(" and ");
			out.AppendInt(paths.Count() - c_PlanPathsNamed);
			out.Append(" more");
		}
		return out.ToString();
	}

	static void AppendShown(Core::StringBuilder& out, const PlanDiff& diff) {
		if (diff.m_Named == 0) return;
		out.Append("; ");
		out.AppendInt(diff.m_Named);
		out.Append(diff.m_Named == 1 ? " file named without its lines (past " : " files named without their lines (past ");
		out.AppendInt(diff.m_Most / 1024);
		out.Append(" KB)");
	}

	// --- Reading the repository --------------------------------------------------------------------------------------

	static GitToolPlan Planned(Core::StringView summary, const PlanDiff& diff) {
		GitToolPlan plan;
		Core::StringBuilder said;
		said.Append(summary);
		AppendShown(said, diff);
		plan.m_Summary = said.ToString();
		plan.m_Diff = diff.m_Text.ToString();
		plan.m_Plus = diff.m_Plus;
		plan.m_Minus = diff.m_Minus;
		return plan;
	}

	static Core::Array<Core::String> DiffCommand(const ToolRepo& target) {
		Core::Array<Core::String> arguments = GitArgs("diff", "--no-ext-diff", "-M", "-U3");
		AddArgs(arguments, target.m_Place.DiffOptions());
		return arguments;
	}

	// The tracked files' diff `extra` names (--cached, a revision), of `inside` only when it is not empty.
	static void AddTracked(GitPlugin* git, const ToolRepo& target, const Core::Array<Core::String>& extra, const Core::Array<Core::String>& inside, PlanDiff& diff) {
		Core::Array<Core::String> arguments = DiffCommand(target);
		AddArgs(arguments, extra);
		arguments.Push(Core::String("--"));
		AddArgs(arguments, inside);
		diff.AddDiff(git->RunOrThrow(target.m_Repo, arguments, c_GitReadTimeoutMs, IED::ErrorCode::Unavailable).m_Output.View());
	}

	// The untracked files `add -A` would take from `inside`, as new files: their text while the diff has room.
	static void AddUntracked(GitPlugin* git, const ToolRepo& target, const Core::Array<Core::String>& inside, PlanDiff& diff) {
		Core::Array<Core::String> arguments = GitArgs("ls-files", "-z", "--others", "--exclude-standard");
		arguments.Push(Core::String("--"));
		AddArgs(arguments, inside);
		GitRun run = git->RunOrThrow(target.m_Repo, arguments, c_GitReadTimeoutMs, IED::ErrorCode::Unavailable);
		for (Core::StringView repoPath : SplitOn(run.m_Output.View(), (char)0)) {
			Core::String path;
			if (repoPath.IsEmpty() || !target.m_Place.FromRepo(repoPath, path)) continue;
			if (diff.m_Files >= c_ToolListMost) {
				diff.m_Unlisted += 1;
				continue;
			}
			Core::Array<Core::String> read = GitArgs("diff", "--no-index", "--no-ext-diff", "-U3");
			read.Push(Core::String("--"));
			read.Push(Core::String("/dev/null"));
			read.Push(Core::String(repoPath));
			const bool room = diff.m_Text.ByteLength() < diff.m_Most;
			diff.AddNewFile(path.View(), room ? TryRun(git, target.m_Repo, read).m_Output.View() : Core::StringView(""));
		}
	}

	// --- The plans ---------------------------------------------------------------------------------------------------

	static GitToolPlan HunksPlan(GitPlugin* git, const ToolRepo& target, Core::StringView path, Core::StringView repoPath, const Serialization::DomNode& args, bool stage) {
		GitRun read = git->RunOrThrow(target.m_Repo, GitDiffArgs(repoPath, Core::StringView(""), Core::StringView(""), false, !stage, 3), c_GitReadTimeoutMs, IED::ErrorCode::Unavailable);
		GitDiff parsed = ParseDiff(read.m_Output.View());
		RequireHunks(parsed, path, !stage);
		Core::Array<int64> lastFirst = HunksArg(args, parsed.m_Hunks.Count(), path);
		Core::Array<int64> hunks;
		for (int64 i = lastFirst.Count() - 1; i >= 0; --i) hunks.Push(lastFirst[i]);
		PlanDiff diff;
		diff.AddFile(HunksDiff(parsed, path, hunks).View());
		Core::StringBuilder summary;
		summary.Append(stage ? "Stage " : "Unstage ");
		summary.Append(hunks.Count() == 1 ? "hunk " : "hunks ");
		for (int64 i = 0; i < hunks.Count(); ++i) {
			if (i > 0) summary.Append(", ");
			summary.AppendInt(hunks[i]);
		}
		summary.Append(" of ");
		summary.Append(path);
		return Planned(summary.View(), diff);
	}

	GitToolPlan PlanStage(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args, bool stage) {
		Core::Array<Core::String> paths = ListArg(args, "paths");
		if (paths.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "name the paths; \".\" is the whole workspace");
		ToolRepo target = ToolRepoFor(found, args, paths);
		Core::Array<Core::String> inside = RepoPaths(target, paths);
		if (args.Member("hunks").IsValid()) {
			if (paths.Count() != 1) throw IED::RpcError(IED::ErrorCode::BadRequest, "hunks are of one file: name one path with them");
			return HunksPlan(git, target, paths[0].View(), inside[0].View(), args, stage);
		}
		PlanDiff diff;
		AddTracked(git, target, stage ? Core::Array<Core::String>() : GitArgs("--cached"), inside, diff);
		if (stage) AddUntracked(git, target, inside, diff);
		Core::StringBuilder summary;
		summary.Append(stage ? "Stage " : "Unstage ");
		summary.Append(PathWords(paths).View());
		summary.Append(": ");
		if (diff.m_Files == 0) summary.Append(stage ? "nothing to stage" : "nothing staged");
		else summary.Append(CountWords(diff.m_Files + diff.m_Unlisted, diff.m_Plus, diff.m_Minus).View());
		return Planned(summary.View(), diff);
	}

	static Core::String Subject(Core::StringView message) {
		const int64 end = message.IndexOf('\n', 0);
		return Core::String((end < 0 ? message : message.Substring(0, end)).Trimmed());
	}

	static Core::String BranchWords(GitPlugin* git, GitRepo* repo) {
		Core::String branch = Core::String(TryRun(git, repo, GitArgs("symbolic-ref", "--short", "-q", "HEAD")).m_Output.View().Trimmed());
		return branch.IsEmpty() ? Core::String("a detached HEAD") : branch;
	}

	// The staged files a repository above the workspace's folder has outside it, which a commit takes too.
	static int64 StagedOutside(GitPlugin* git, const ToolRepo& target, int64 shown) {
		if (target.m_Place.m_Within.IsEmpty()) return 0;
		GitRun names = git->RunOrThrow(target.m_Repo, GitArgs("diff", "--cached", "--name-only", "-z"), c_GitReadTimeoutMs, IED::ErrorCode::Unavailable);
		int64 all = 0;
		for (Core::StringView name : SplitOn(names.m_Output.View(), (char)0))
			if (!name.IsEmpty()) all += 1;
		return all > shown ? all - shown : 0;
	}

	GitToolPlan PlanCommit(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		Core::Array<Core::String> paths = ListArg(args, "paths");
		ToolRepo target = ToolRepoFor(found, args, paths);
		Core::String subject = Subject(args.Member("message").AsView().Trimmed());
		const bool amend = args.Member("amend").AsBool();
		if (subject.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "a commit needs a message");
		if (amend) RequireUnpushed(git, target.m_Repo);
		Core::Array<Core::String> inside = RepoPaths(target, paths);
		PlanDiff diff;
		int64 outside = 0;
		if (!inside.IsEmpty()) {
			AddTracked(git, target, GitArgs(IsUnborn(git, target.m_Repo) ? c_EmptyTree : "HEAD"), inside, diff);
			AddUntracked(git, target, inside, diff);
		}
		else {
			AddTracked(git, target, GitArgs("--cached"), inside, diff);
			outside = StagedOutside(git, target, diff.m_Files);
			if (diff.m_Files + outside == 0 && !amend) throw IED::RpcError(IED::ErrorCode::BadRequest, "nothing is staged: git_stage the changes first, or name them in paths");
		}
		Core::StringBuilder summary;
		if (amend) {
			summary.Append("Amend ");
			summary.Append(TryRun(git, target.m_Repo, GitArgs("log", "-1", "--format=%h")).m_Output.View().Trimmed());
			summary.Append(" on ");
		}
		else summary.Append("Commit to ");
		summary.Append(BranchWords(git, target.m_Repo).View());
		summary.Append(": ");
		summary.Append(subject.View());
		summary.Append(" (");
		if (diff.m_Files + diff.m_Unlisted + outside == 0) summary.Append("the message only");
		else summary.Append(CountWords(diff.m_Files + diff.m_Unlisted + outside, diff.m_Plus, diff.m_Minus).View());
		if (outside > 0) {
			summary.Append(", ");
			summary.AppendInt(outside);
			summary.Append(" outside the workspace's folder");
		}
		summary.Append(")");
		return Planned(summary.View(), diff);
	}

	// "1a2b3c4 subject" of a revision, or "" when it names none.
	static Core::String CommitWords(GitPlugin* git, GitRepo* repo, Core::StringView rev) {
		GitRun run = TryRun(git, repo, GitArgs("log", "-1", "--format=%h %s", (Core::String(rev) + "^{commit}").CStr()));
		return run.Ok() ? Core::String(run.m_Output.View().Trimmed()) : Core::String("");
	}

	static GitToolPlan Said(Core::StringView summary) {
		GitToolPlan plan;
		plan.m_Summary = Core::String(summary);
		return plan;
	}

	GitToolPlan PlanBranch(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		ToolRepo target = ToolRepoFor(found, args, Core::Array<Core::String>());
		Core::StringView action = args.Member("action").AsView();
		Core::String name = NameArg(args, "name");
		Core::String from = NameArg(args, "from");
		if (name.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "name the branch");
		const bool local = HasRef(git, target.m_Repo, (Core::String("refs/heads/") + name.View()).View());
		if (action == "create") {
			if (local) throw IED::RpcError(IED::ErrorCode::Conflict, (Core::String("a branch ") + name.View() + " already exists; git_branch switch goes to it").View());
			Core::String at = from.IsEmpty() ? Core::String("HEAD") : from;
			Core::String commit = CommitWords(git, target.m_Repo, at.View());
			if (commit.IsEmpty()) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("there is no commit ") + at.View()).View());
			Core::String said = ((((Core::String("Create branch ") + name.View()) + " at ") + at.View()) + " (") + commit.View();
			return Said(((said + ")") + (args.Member("switch").AsBool() ? Core::StringView(" and switch to it") : Core::StringView(""))).View());
		}
		const bool remote = !local && HasRef(git, target.m_Repo, (Core::String("refs/remotes/") + name.View()).View());
		if (!local && !remote) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("there is no branch ") + name.View() + "; git_branches lists them").View());
		Core::String commit = CommitWords(git, target.m_Repo, name.View());
		if (action == "delete") {
			if (!local) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String(name) + " is a remote branch; only a local one is deleted").View());
			return Said(((((Core::String("Delete branch ") + name.View()) + " (") + commit.View()) + "); git keeps it unless it is merged").View());
		}
		Core::String said = ((Core::String("Switch from ") + BranchWords(git, target.m_Repo).View()) + " to ") + name.View();
		if (remote) said = said + ", a new local branch tracking it";
		return Said((((said + " (") + commit.View()) + ")").View());
	}

	static void AddNumstat(Core::StringView numstat, int64& files, int64& plus, int64& minus) {
		for (Core::StringView line : SplitOn(numstat, '\n')) {
			Core::Array<Core::StringView> fields = SplitOn(line, '\t');
			if (fields.Count() < 3) continue;
			int64 added = 0;
			int64 removed = 0;
			Core::ParseInt64(fields[0], added);
			Core::ParseInt64(fields[1], removed);
			files += 1;
			plus += added;
			minus += removed;
		}
	}

	GitToolPlan PlanStash(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		ToolRepo target = ToolRepoFor(found, args, Core::Array<Core::String>());
		Core::StringView action = args.Member("action").AsView();
		GitToolPlan plan;
		int64 files = 0;
		if (action == "push") {
			if (IsUnborn(git, target.m_Repo)) throw IED::RpcError(IED::ErrorCode::BadRequest, "there is no commit yet to stash against");
			AddNumstat(git->RunOrThrow(target.m_Repo, GitArgs("diff", "HEAD", "--numstat"), c_GitReadTimeoutMs, IED::ErrorCode::Unavailable).m_Output.View(), files, plan.m_Plus, plan.m_Minus);
			int64 untracked = 0;
			if (args.Member("untracked").AsBool())
				for (Core::StringView path : SplitOn(TryRun(git, target.m_Repo, GitArgs("ls-files", "-z", "--others", "--exclude-standard")).m_Output.View(), (char)0))
					if (!path.IsEmpty()) untracked += 1;
			if (files + untracked == 0) throw IED::RpcError(IED::ErrorCode::BadRequest, "there are no local changes to stash");
			Core::StringBuilder summary;
			summary.Append("Stash the local changes: ");
			summary.Append(CountWords(files, plan.m_Plus, plan.m_Minus).View());
			if (untracked > 0) {
				summary.Append(", ");
				summary.AppendInt(untracked);
				summary.Append(untracked == 1 ? " untracked file" : " untracked files");
			}
			Core::StringView message = args.Member("message").AsView().Trimmed();
			if (!message.IsEmpty()) {
				summary.Append(", as \"");
				summary.Append(message);
				summary.Append("\"");
			}
			plan.m_Summary = summary.ToString();
			return plan;
		}
		Core::String name = StashName(args.Member("index").IsValid() ? args.Member("index").AsInt() : 0);
		if (!HasRef(git, target.m_Repo, name.View())) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("there is no ") + name.View() + "; git_branches lists the stashes").View());
		Core::String subject = Core::String(TryRun(git, target.m_Repo, GitArgs("log", "-1", "--format=%s", name.CStr())).m_Output.View().Trimmed());
		AddNumstat(TryRun(git, target.m_Repo, GitArgs("diff", "--numstat", (name + "^1").CStr(), name.CStr())).m_Output.View(), files, plan.m_Plus, plan.m_Minus);
		Core::StringBuilder summary;
		summary.Append(action == "pop" ? "Pop " : "Apply ");
		summary.Append(name.View());
		summary.Append(" (");
		summary.Append(subject.View());
		summary.Append("): ");
		summary.Append(CountWords(files, plan.m_Plus, plan.m_Minus).View());
		summary.Append(action == "pop" ? ", taken off the list" : ", kept on the list");
		plan.m_Summary = summary.ToString();
		return plan;
	}
}
