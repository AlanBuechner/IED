// The git tools that change a repository (docs/13 T-GIT-4, T-GIT-5): git_stage and git_unstage, whole files or
// numbered hunks; git_commit; git_branch; git_stash. Each answers with the repository's status after it.

include "tools.ch"
include "patch.ch"

namespace Git
{
	static Core::String Done(GitPlugin* git, GitRepo* repo, Core::StringView what) {
		return ((Core::String(what) + "\n") + RepoStatus(git, repo).View());
	}

	Core::Array<int64> HunksArg(const Serialization::DomNode& args, int64 count, Core::StringView path) {
		Core::Array<int64> hunks;
		Serialization::DomNode given = args.Member("hunks");
		for (int64 i = 0; i < given.Count(); ++i) {
			const int64 hunk = given.At(i).AsInt();
			if (hunk < 1 || hunk > count) {
				Core::StringBuilder why;
				why.Append(path);
				why.Append(" has ");
				why.AppendInt(count);
				why.Append(count == 1 ? " hunk" : " hunks");
				why.Append(" in git_diff; there is no hunk ");
				why.AppendInt(hunk);
				throw IED::RpcError(IED::ErrorCode::BadRequest, why.View());
			}
			if (!hunks.Contains(hunk)) hunks.Push(hunk);
		}
		for (int64 i = 1; i < hunks.Count(); ++i)
			for (int64 j = i; j > 0 && hunks[j - 1] < hunks[j]; --j) {
				const int64 swapped = hunks[j];
				hunks[j] = hunks[j - 1];
				hunks[j - 1] = swapped;
			}
		return hunks;
	}

	// Stages (or with `staged`, unstages) some hunks of one file, the last first so the earlier ones stay where they are.
	static void ApplyHunks(GitPlugin* git, const ToolRepo& target, Core::StringView path, Core::StringView repoPath, const Serialization::DomNode& args, bool staged) {
		GitRun read = git->RunOrThrow(target.repo, GitDiffArgs(repoPath, Core::StringView(""), Core::StringView(""), false, staged, 3), kGitReadTimeoutMs, IED::ErrorCode::BadRequest);
		GitDiff diff = ParseDiff(read.output.View());
		RequireHunks(diff, path, staged);
		for (int64 hunk : HunksArg(args, diff.hunks.Count(), path)) {
			FS::Path file = GitTempFile((Core::String("ied-") + target.repo->repoId.View() + "-tool-hunk.patch").View(), HunkPatch(diff, hunk - 1, Core::Array<int64>(), staged).View());
			Core::Array<Core::String> arguments = GitArgs("apply", "--cached", "--recount");
			if (staged) arguments.Push(Core::String("-R"));
			arguments.Push(Core::String(file.View()));
			try {
				git->RunChange(target.repo, arguments, IED::ErrorCode::Conflict);
			}
			catch (IED::RpcError& error) {
				FS::RemoveFile(file.CStr());
				throw error;
			}
			FS::RemoveFile(file.CStr());
		}
	}

	void RequireHunks(const GitDiff& diff, Core::StringView path, bool staged) {
		if (diff.hunks.IsEmpty() && staged) throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String(path) + " has nothing staged").View());
		if (diff.hunks.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String(path) + " has no unstaged changes to tracked lines; an untracked file is staged whole, without hunks").View());
	}

	static Core::Array<Core::String> WithPaths(Core::Array<Core::String> arguments, const Core::Array<Core::String>& paths) {
		arguments.Push(Core::String("--"));
		for (const Core::String& path : paths) arguments.Push(path);
		return arguments;
	}

	Core::String StageAnswer(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args, bool stage) {
		Core::Array<Core::String> paths = ListArg(args, "paths");
		if (paths.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "name the paths; \".\" is the whole workspace");
		ToolRepo target = ToolRepoFor(found, args, paths);
		Core::Array<Core::String> inside = RepoPaths(target, paths);
		if (args.Member("hunks").IsValid()) {
			if (paths.Count() != 1) throw IED::RpcError(IED::ErrorCode::BadRequest, "hunks are of one file: name one path with them");
			ApplyHunks(git, target, paths[0].View(), inside[0].View(), args, !stage);
		}
		else if (stage) git->RunChange(target.repo, WithPaths(GitArgs("add", "-A"), inside), IED::ErrorCode::BadRequest);
		else if (IsUnborn(git, target.repo)) git->RunChange(target.repo, WithPaths(GitArgs("rm", "--cached", "-r", "--quiet"), inside), IED::ErrorCode::BadRequest);
		else git->RunChange(target.repo, WithPaths(GitArgs("restore", "--staged"), inside), IED::ErrorCode::BadRequest);
		return Done(git, target.repo, WhatStaged(stage, paths, args.Member("hunks")).View());
	}

	void RequireUnpushed(GitPlugin* git, GitRepo* repo) {
		if (IsUnborn(git, repo)) throw IED::RpcError(IED::ErrorCode::BadRequest, "there is no commit to amend yet");
		if (!TryRun(git, repo, GitArgs("merge-base", "--is-ancestor", "HEAD", "@{upstream}")).Ok()) return;
		throw IED::RpcError(IED::ErrorCode::Conflict, "HEAD is already on its upstream (pushed); amending it would rewrite pushed history, so make a new commit instead");
	}

	static void Commit(GitPlugin* git, GitRepo* repo, Core::StringView message, bool amend, const Core::Array<Core::String>& inside) {
		FS::Path file = GitTempFile((Core::String("ied-") + repo->repoId.View() + "-tool-message.txt").View(), (Core::String(message) + "\n").View());
		Core::Array<Core::String> arguments = GitArgs("commit", "-F", file.CStr());
		if (amend) arguments.Push(Core::String("--amend"));
		if (!inside.IsEmpty()) {
			arguments.Push(Core::String("--only"));
			arguments = WithPaths(arguments, inside);
		}
		try {
			git->RunChange(repo, arguments, IED::ErrorCode::BadRequest);
		}
		catch (IED::RpcError& error) {
			FS::RemoveFile(file.CStr());
			throw error;
		}
		FS::RemoveFile(file.CStr());
	}

	Core::String CommitAnswer(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		Core::Array<Core::String> paths = ListArg(args, "paths");
		ToolRepo target = ToolRepoFor(found, args, paths);
		Core::String message = Core::String(args.Member("message").AsView().Trimmed());
		const bool amend = args.Member("amend").AsBool();
		if (message.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "a commit needs a message");
		if (amend) RequireUnpushed(git, target.repo);
		Core::Array<Core::String> inside = RepoPaths(target, paths);
		if (!inside.IsEmpty()) git->RunChange(target.repo, WithPaths(GitArgs("add", "-A"), inside), IED::ErrorCode::BadRequest);
		else if (!amend && TryRun(git, target.repo, GitArgs("diff", "--cached", "--quiet")).Ok())
			throw IED::RpcError(IED::ErrorCode::BadRequest, "nothing is staged: git_stage the changes first, or name them in paths");
		Commit(git, target.repo, message.View(), amend, inside);
		Core::Array<Core::String> stat = GitArgs("show", "--stat", "--format=committed %h: %s");
		AddArgs(stat, target.place.DiffOptions());
		stat.Push(Core::String("HEAD"));
		return Done(git, target.repo, WithoutBlankLines(git->RunOrThrow(target.repo, stat, kGitReadTimeoutMs, IED::ErrorCode::Internal).output.View()).View());
	}

	static Core::String WithoutBlankLines(Core::StringView text) {
		Core::StringBuilder out;
		for (Core::StringView line : SplitOn(text, '\n')) {
			if (line.Trimmed().IsEmpty()) continue;
			if (!out.IsEmpty()) out.Append("\n");
			out.Append(line);
		}
		return out.ToString();
	}

	// "staged a.txt, b.txt", or "staged hunks 1, 3 of a.txt".
	static Core::String WhatStaged(bool stage, const Core::Array<Core::String>& paths, const Serialization::DomNode& hunks) {
		Core::StringBuilder out;
		out.Append(stage ? "staged " : "unstaged ");
		if (hunks.IsValid()) {
			out.Append(hunks.Count() == 1 ? "hunk " : "hunks ");
			for (int64 i = 0; i < hunks.Count(); ++i) {
				if (i > 0) out.Append(", ");
				out.AppendInt(hunks.At(i).AsInt());
			}
			out.Append(" of ");
		}
		for (int64 i = 0; i < paths.Count(); ++i) {
			if (i > 0) out.Append(", ");
			out.Append(paths[i].View());
		}
		return out.ToString();
	}

	// What git said when a checkout or a stash would lose local changes, with what to do about it.
	static IED::RpcError Taught(IED::RpcError error) {
		if (error.message.View().Contains(Core::StringView("would be overwritten"))) return IED::RpcError(error.code, (error.message + "\ncommit or git_stash the local changes first").View());
		if (error.message.View().Contains(Core::StringView("not fully merged"))) return IED::RpcError(error.code, (error.message + "\nits commits are on no other branch; only the owner deletes it (the Git activity)").View());
		return error;
	}

	bool HasRef(GitPlugin* git, GitRepo* repo, Core::StringView ref) {
		return TryRun(git, repo, GitArgs("rev-parse", "--verify", "--quiet", (Core::String(ref) + "^{commit}").CStr())).Ok();
	}

	// `switch <name>`, or for a remote branch nothing local is named after, `switch --track` (a local branch made).
	static Core::Array<Core::String> SwitchArgs(GitPlugin* git, GitRepo* repo, Core::StringView name) {
		const bool remote = !HasRef(git, repo, (Core::String("refs/heads/") + name).View()) && HasRef(git, repo, (Core::String("refs/remotes/") + name).View());
		Core::Array<Core::String> arguments = remote ? GitArgs("switch", "--track") : GitArgs("switch");
		arguments.Push(Core::String(name));
		return arguments;
	}

	Core::String BranchAnswer(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		ToolRepo target = ToolRepoFor(found, args, Core::Array<Core::String>());
		Core::StringView action = args.Member("action").AsView();
		Core::String name = NameArg(args, "name");
		Core::String from = NameArg(args, "from");
		if (name.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "name the branch");
		Core::Array<Core::String> arguments;
		if (action == "switch") arguments = SwitchArgs(git, target.repo, name.View());
		else if (action == "delete") arguments = GitArgs("branch", "-d", name.CStr());
		else arguments = args.Member("switch").AsBool() ? GitArgs("switch", "-c", name.CStr()) : GitArgs("branch", name.CStr());
		if (action == "create" && !from.IsEmpty()) arguments.Push(from);
		try {
			git->RunChange(target.repo, arguments, IED::ErrorCode::Conflict);
		}
		catch (IED::RpcError& error) {
			throw Taught(error);
		}
		if (action == "delete") return Done(git, target.repo, (Core::String("deleted branch ") + name.View()).View());
		if (action == "switch") return Done(git, target.repo, (Core::String("switched to ") + name.View()).View());
		return Done(git, target.repo, (Core::String("created branch ") + name.View()).View());
	}

	Core::String StashName(int64 index) {
		Core::StringBuilder name;
		name.Append("stash@{");
		name.AppendInt(index);
		name.Append("}");
		return name.ToString();
	}

	Core::String StashAnswer(GitPlugin* git, GitWorkspace* found, const Serialization::DomNode& args) {
		ToolRepo target = ToolRepoFor(found, args, Core::Array<Core::String>());
		Core::StringView action = args.Member("action").AsView();
		if (action == "push") {
			Core::Array<Core::String> arguments = GitArgs("stash", "push");
			if (args.Member("untracked").AsBool()) arguments.Push(Core::String("--include-untracked"));
			Core::String message = Core::String(args.Member("message").AsView().Trimmed());
			if (!message.IsEmpty()) {
				arguments.Push(Core::String("-m"));
				arguments.Push(message);
			}
			GitRun run = git->RunChange(target.repo, arguments, IED::ErrorCode::BadRequest);
			if (run.output.View().Contains(Core::StringView("No local changes to save"))) throw IED::RpcError(IED::ErrorCode::BadRequest, "there are no local changes to stash");
			return Done(git, target.repo, Core::StringView("stashed the local changes as stash@{0}"));
		}
		const int64 index = args.Member("index").IsValid() ? args.Member("index").AsInt() : 0;
		Core::String name = StashName(index);
		try {
			git->RunChange(target.repo, GitArgs("stash", action == "pop" ? "pop" : "apply", name.CStr()), IED::ErrorCode::Conflict);
		}
		catch (IED::RpcError& error) {
			throw Taught(error);
		}
		return Done(git, target.repo, ((Core::String(action == "pop" ? "popped " : "applied ") + name.View())).View());
	}
}
