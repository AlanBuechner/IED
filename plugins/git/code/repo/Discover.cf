include "Discover.ch"
include "Parse.ch"
include "api/Plugin.ch"

namespace Git
{
	// What `rev-parse` says of `folder`: its repository, or false when it is in none.
	static bool RepositoryOf(const GitCli& cli, const FS::Path& folder, GitFound& found, Core::String& error) {
		Core::Array<Core::String> arguments = GitArgs("rev-parse", "--path-format=absolute", "--show-toplevel");
		arguments.Push(Core::String("--git-dir"));
		arguments.Push(Core::String("--git-common-dir"));
		GitRun run = cli.Run(folder, arguments, c_GitReadTimeoutMs);
		if (run.m_ExitCode == Process::kError) {
			error = run.Problem();
			return false;
		}
		Core::Array<Core::StringView> lines = SplitOn(run.m_Output.View(), '\n');
		if (!run.Ok() || lines.Count() < 3) return false;
		found.m_Root = FS::Path(lines[0].Trimmed());
		found.m_GitDir = FS::Path(lines[1].Trimmed());
		found.m_CommonDir = FS::Path(lines[2].Trimmed());
		found.m_Submodule = found.m_GitDir.View().Contains(Core::StringView("/modules/"));
		return true;
	}

	static bool Skipped(Core::StringView name) {
		for (const Core::String& pattern : IED::DefaultExcludes())
			if (pattern.View().Substring(3, pattern.View().ByteLength() - 3) == name) return true;
		return false;
	}

	static bool Known(const Core::Array<GitFound>& found, const FS::Path& root) {
		Core::String relative;
		for (const GitFound& each : found)
			if (IED::RelativeTo(each.m_Root.View(), root.View(), relative) && relative.IsEmpty()) return true;
		return false;
	}

	// The folders under `folder` with a .git of their own, `depth` levels down.
	static void Scan(const GitCli& cli, const FS::Path& folder, int32 depth, Core::Array<GitFound>& found) {
		if (depth <= 0) return;
		for (FS::DirectoryEntry& entry : FS::Directory(folder.CStr())) {
			if (entry.kind != FS::EntryKind::Directory || Skipped(entry.name.View())) continue;
			FS::Path child = folder / entry.name.View();
			FS::Path marker = child / ".git";
			GitFound repository;
			Core::String ignored;
			const bool hasGit = FS::IsDirectory(marker.CStr()) || FS::FileExists(marker.CStr());
			if (hasGit && RepositoryOf(cli, child, repository, ignored) && !Known(found, repository.m_Root)) found.Push(repository);
			Scan(cli, child, depth - 1, found);
		}
	}

	bool FindRepositories(const GitCli& cli, const FS::Path& folder, int32 depth, Core::Array<GitFound>& found, Core::String& error) {
		GitFound outer;
		if (RepositoryOf(cli, folder, outer, error)) found.Push(outer);
		if (!error.IsEmpty()) return false;
		Scan(cli, folder, depth, found);
		return true;
	}

	bool GitMarkerHolder(Core::StringView path, Core::String& holder) {
		Core::Array<Core::StringView> parts = SplitOn(path, '/');
		Core::StringBuilder folder;
		for (Core::StringView part : parts) {
			if (part == ".git") {
				holder = folder.ToString();
				return true;
			}
			if (Skipped(part)) return false;
			if (!folder.IsEmpty()) folder.AppendByte('/');
			folder.Append(part);
		}
		return false;
	}

	// `path` is the folder `folder` or in it.
	static bool InFolder(Core::StringView path, const char* folder) {
		Core::StringView name(folder);
		return path == name || (path.StartsWith(name) && path.ByteLength() > name.ByteLength() && path.ByteAt(name.ByteLength()) == '/');
	}

	// The writes of a read alone, at the top of a git dir.
	static bool GitDirNoise(Core::StringView inside) {
		if (inside.EndsWith(Core::StringView(".lock"))) return true;
		if (InFolder(inside, "objects") || InFolder(inside, "lfs") || InFolder(inside, "fsmonitor--daemon")) return true;
		if (InFolder(inside, "logs")) return inside != "logs/refs/stash";
		return false;
	}

	bool GitDirMatters(Core::StringView inside) {
		if (GitDirNoise(inside)) return false;
		if (!inside.StartsWith(Core::StringView("modules/")) && !inside.StartsWith(Core::StringView("worktrees/"))) return true;
		// A submodule's name may hold slashes: the rules from each folder down.
		for (int64 slash = inside.IndexOf('/', 0); slash >= 0; slash = inside.IndexOf('/', slash + 1))
			if (GitDirNoise(inside.Substring(slash + 1, inside.ByteLength() - slash - 1))) return false;
		return true;
	}

	bool GitIgnoredPath(const Core::HashSet<Core::String>& ignored, Core::StringView path) {
		if (ignored.IsEmpty() || path.IsEmpty()) return false;
		if (ignored.Contains(Core::String(path)) || ignored.Contains(Core::String(path) + "/")) return true;
		for (int64 slash = path.IndexOf('/', 0); slash >= 0; slash = path.IndexOf('/', slash + 1))
			if (ignored.Contains(Core::String(path.Substring(0, slash + 1)))) return true;
		return false;
	}

	bool DeletionTakesRepo(Core::StringView path, Core::StringView repo) {
		if (repo == "..") return false;   // above the workspace: nothing deleted in it takes it
		Core::String marker = repo.IsEmpty() ? Core::String(".git") : Core::String(repo) + "/.git";
		if (path == marker.View()) return true;
		Core::String inside;
		return !repo.IsEmpty() && IED::RelativeTo(path, repo, inside);
	}

	bool GitRelative(const FS::Path& root, const FS::Path& path, Core::String& relative) {
		if (IED::RelativeTo(root.View(), path.View(), relative)) return true;
		Core::String inside;
		if (!IED::RelativeTo(path.View(), root.View(), inside)) return false;
		relative = Core::String("..");
		return true;
	}
}
