include "Parse.ch"

namespace Git
{
	const char c_UnitSeparator = (char)31;

	Core::Array<Core::StringView> SplitOn(Core::StringView text, char separator) {
		Core::Array<Core::StringView> pieces;
		int64 start = 0;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			if (text.ByteAt(i) != (int32)separator) continue;
			pieces.Push(text.Substring(start, i - start));
			start = i + 1;
		}
		if (start < text.ByteLength()) pieces.Push(text.Substring(start, text.ByteLength() - start));
		return pieces;
	}

	static Core::StringView After(Core::StringView text, Core::StringView prefix) {
		return text.Substring(prefix.ByteLength(), text.ByteLength() - prefix.ByteLength());
	}

	// What follows the `count`th space: a status entry's path, after its fixed fields.
	static Core::StringView AfterSpaces(Core::StringView entry, int32 count) {
		int64 at = 0;
		for (int32 seen = 0; seen < count; ++seen) {
			at = entry.IndexOf(' ', at);
			if (at < 0) return Core::StringView("");
			at += 1;
		}
		return entry.Substring(at, entry.ByteLength() - at);
	}

	// The number right after `word` in `text` ("ahead 3" in "[ahead 3, behind 1]"); 0 when it is not there.
	static int64 NumberAfter(Core::StringView text, Core::StringView word) {
		const int64 at = text.IndexOf(word);
		if (at < 0) return 0;
		int64 end = at + word.ByteLength();
		int64 value = 0;
		while (end < text.ByteLength() && text.ByteAt(end) >= '0' && text.ByteAt(end) <= '9') {
			value = value * 10 + (text.ByteAt(end) - '0');
			end += 1;
		}
		return value;
	}

	static GitChange MakeChange(Core::StringView path, Core::StringView oldPath, Core::StringView status) {
		GitChange change;
		change.m_Path = Core::String(path);
		change.m_OldPath = Core::String(oldPath);
		change.m_Status = Core::String(status);
		return change;
	}

	static void ReadBranchLine(Core::StringView line, GitHead& head) {
		if (line.StartsWith(Core::StringView("# branch.oid "))) {
			Core::StringView oid = After(line, Core::StringView("# branch.oid "));
			head.m_Oid = oid == "(initial)" ? Core::String("") : Core::String(oid);
		}
		else if (line.StartsWith(Core::StringView("# branch.head "))) {
			Core::StringView name = After(line, Core::StringView("# branch.head "));
			head.m_Detached = name == "(detached)";
			head.m_Branch = head.m_Detached ? Core::String("") : Core::String(name);
		}
		else if (line.StartsWith(Core::StringView("# branch.upstream "))) head.m_Upstream = Core::String(After(line, Core::StringView("# branch.upstream ")));
		else if (line.StartsWith(Core::StringView("# branch.ab "))) {
			head.m_Ahead = NumberAfter(line, Core::StringView("+"));
			head.m_Behind = NumberAfter(line, Core::StringView("-"));
		}
	}

	// An ordinary ("1") or renamed ("2") entry: its index side staged, its work tree side not.
	static void ReadTracked(Core::StringView entry, Core::StringView oldPath, GitStatus& status) {
		Core::StringView xy = entry.Substring(2, 2);
		Core::StringView path = AfterSpaces(entry, oldPath.IsEmpty() ? 8 : 9);
		if (xy.ByteAt(0) != '.') status.m_Staged.Push(MakeChange(path, oldPath, xy.Substring(0, 1)));
		if (xy.ByteAt(1) != '.') status.m_Unstaged.Push(MakeChange(path, Core::StringView(""), xy.Substring(1, 1)));
	}

	GitStatus ParseStatus(Core::StringView porcelain) {
		GitStatus status;
		bool compared = false;
		Core::Array<Core::StringView> entries = SplitOn(porcelain, (char)0);
		for (int64 i = 0; i < entries.Count(); ++i) {
			Core::StringView entry = entries[i];
			if (entry.IsEmpty()) continue;
			const int32 kind = entry.ByteAt(0);
			if (kind == '#') {
				ReadBranchLine(entry, status.m_Head);
				compared = compared || entry.StartsWith(Core::StringView("# branch.ab "));
			}
			else if (kind == '1') ReadTracked(entry, Core::StringView(""), status);
			else if (kind == '2' && i + 1 < entries.Count()) {
				ReadTracked(entry, entries[i + 1], status);
				i += 1;
			}
			else if (kind == 'u') status.m_Conflicted.Push(MakeChange(AfterSpaces(entry, 10), Core::StringView(""), entry.Substring(2, 2)));
			else if (kind == '?') status.m_Untracked.Push(MakeChange(entry.Substring(2, entry.ByteLength() - 2), Core::StringView(""), Core::StringView("?")));
		}
		status.m_Head.m_Gone = !status.m_Head.m_Upstream.IsEmpty() && !compared;
		return status;
	}

	static GitRef Ref(Core::StringView name, Core::StringView oid) {
		GitRef ref;
		ref.m_Name = Core::String(name);
		ref.m_Oid = Core::String(oid);
		return ref;
	}

	GitRefs ParseRefs(Core::StringView text) {
		GitRefs refs;
		for (Core::StringView line : SplitOn(text, '\n')) {
			Core::Array<Core::StringView> fields = SplitOn(line, c_UnitSeparator);
			if (fields.Count() < 2) continue;
			Core::StringView name = fields[0];
			if (name.StartsWith(Core::StringView("refs/heads/"))) {
				GitRef branch = Ref(After(name, Core::StringView("refs/heads/")), fields[1]);
				if (fields.Count() > 3) branch.m_Upstream = Core::String(fields[3]);
				if (fields.Count() > 4) {
					branch.m_Ahead = NumberAfter(fields[4], Core::StringView("ahead "));
					branch.m_Behind = NumberAfter(fields[4], Core::StringView("behind "));
					branch.m_Gone = fields[4].Contains(Core::StringView("gone"));
				}
				branch.m_Current = fields.Count() > 5 && fields[5] == "*";
				refs.m_Branches.Push(branch);
			}
			else if (name.StartsWith(Core::StringView("refs/remotes/")) && !name.EndsWith(Core::StringView("/HEAD"))) refs.m_RemoteBranches.Push(Ref(After(name, Core::StringView("refs/remotes/")), fields[1]));
			else if (name.StartsWith(Core::StringView("refs/tags/"))) refs.m_Tags.Push(Ref(After(name, Core::StringView("refs/tags/")), fields.Count() > 2 && !fields[2].IsEmpty() ? fields[2] : fields[1]));
		}
		return refs;
	}

	Core::Array<GitCommit> ParseLog(Core::StringView text) {
		Core::Array<GitCommit> commits;
		for (Core::StringView record : SplitOn(text, (char)0)) {
			Core::Array<Core::StringView> fields = SplitOn(record.Trimmed(), c_UnitSeparator);
			if (fields.Count() < 5) continue;
			GitCommit commit;
			commit.m_Oid = Core::String(fields[0]);
			for (Core::StringView parent : SplitOn(fields[1], ' ')) commit.m_Parents.Push(Core::String(parent));
			commit.m_Author = Core::String(fields[2]);
			commit.m_Email = Core::String(fields[3]);
			int64 seconds = 0;
			Core::ParseInt64(fields[4], seconds);
			commit.m_AuthorMs = seconds * 1000;
			if (fields.Count() > 5) commit.m_Subject = Core::String(fields[5]);
			commits.Push(commit);
		}
		return commits;
	}

	Core::Array<GitFileChange> ParseNameStatus(Core::StringView text) {
		Core::Array<GitFileChange> files;
		Core::Array<Core::StringView> pieces = SplitOn(text, (char)0);
		for (int64 i = 0; i + 1 < pieces.Count(); i += 2) {
			GitFileChange file;
			Core::StringView status = pieces[i].Trimmed();
			if (status.IsEmpty()) continue;
			file.m_Status = Core::String(status.Substring(0, 1));
			const bool moved = status.ByteAt(0) == 'R' || status.ByteAt(0) == 'C';
			if (moved && i + 2 < pieces.Count()) {
				file.m_OldPath = Core::String(pieces[i + 1]);
				file.m_Path = Core::String(pieces[i + 2]);
				i += 1;
			}
			else file.m_Path = Core::String(pieces[i + 1]);
			files.Push(file);
		}
		return files;
	}

	static void SetCounts(Core::Array<GitFileChange>& files, Core::StringView path, Core::StringView added, Core::StringView removed) {
		for (GitFileChange& file : files) {
			if (file.m_Path.View() != path) continue;
			file.m_Binary = added == "-";
			Core::ParseInt64(added, file.m_Added);
			Core::ParseInt64(removed, file.m_Removed);
			return;
		}
	}

	void AddNumstat(Core::Array<GitFileChange>& files, Core::StringView text) {
		Core::Array<Core::StringView> pieces = SplitOn(text, (char)0);
		for (int64 i = 0; i < pieces.Count(); ++i) {
			Core::StringView piece = pieces[i].Trimmed();
			Core::Array<Core::StringView> counts = SplitOn(pieces[i], '\t');
			if (piece.IsEmpty() || counts.Count() < 2) continue;
			Core::StringView added = counts[0].Trimmed();
			if (counts.Count() >= 3) {
				SetCounts(files, counts[2], added, counts[1]);
				continue;
			}
			if (i + 2 < pieces.Count()) SetCounts(files, pieces[i + 2], added, counts[1]);
			i += 2;
		}
	}

	static bool ReadNumber(Core::StringView text, int64& at, int64& value) {
		const int64 start = at;
		value = 0;
		while (at < text.ByteLength() && text.ByteAt(at) >= '0' && text.ByteAt(at) <= '9') {
			value = value * 10 + (text.ByteAt(at) - '0');
			at += 1;
		}
		return at > start;
	}

	// "a,b" or "a" (b is then 1) at `at`.
	static bool ReadRange(Core::StringView text, int64& at, int64& start, int64& count) {
		if (!ReadNumber(text, at, start)) return false;
		count = 1;
		if (at < text.ByteLength() && text.ByteAt(at) == ',') {
			at += 1;
			return ReadNumber(text, at, count);
		}
		return true;
	}

	bool ParseHunkHeader(Core::StringView line, GitHunk& hunk) {
		if (!line.StartsWith(Core::StringView("@@ -"))) return false;
		int64 at = 4;
		if (!ReadRange(line, at, hunk.m_OldStart, hunk.m_OldLines)) return false;
		if (!line.Substring(at, 2).Equals(Core::StringView(" +"))) return false;
		at += 2;
		if (!ReadRange(line, at, hunk.m_NewStart, hunk.m_NewLines)) return false;
		hunk.m_Header = Core::String(line);
		return true;
	}

	GitDiff ParseDiff(Core::StringView text) {
		GitDiff diff;
		for (Core::StringView line : SplitOn(text, '\n')) {
			GitHunk next;
			if (ParseHunkHeader(line, next)) diff.m_Hunks.Push(next);
			else if (!diff.m_Hunks.IsEmpty()) diff.m_Hunks[diff.m_Hunks.Count() - 1].m_Lines.Push(Core::String(line));
			else {
				if (line.StartsWith(Core::StringView("Binary files ")) || line.StartsWith(Core::StringView("GIT binary patch"))) diff.m_Binary = true;
				diff.m_FileHeader.Push(Core::String(line));
			}
		}
		return diff;
	}

	Core::Array<GitStash> ParseStashes(Core::StringView text) {
		Core::Array<GitStash> stashes;
		for (Core::StringView record : SplitOn(text, (char)0)) {
			Core::Array<Core::StringView> fields = SplitOn(record.Trimmed(), c_UnitSeparator);
			if (fields.Count() < 1 || fields[0].IsEmpty()) continue;
			GitStash stash;
			stash.m_Index = stashes.Count();
			stash.m_Oid = Core::String(fields[0]);
			if (fields.Count() > 1) stash.m_Message = Core::String(fields[1]);
			stashes.Push(stash);
		}
		return stashes;
	}

	Core::Array<GitWorktree> ParseWorktrees(Core::StringView text) {
		Core::Array<GitWorktree> worktrees;
		for (Core::StringView piece : SplitOn(text, (char)0)) {
			if (piece.StartsWith(Core::StringView("worktree "))) {
				GitWorktree worktree;
				worktree.m_Path = Core::String(After(piece, Core::StringView("worktree ")));
				worktrees.Push(worktree);
				continue;
			}
			if (worktrees.IsEmpty()) continue;
			GitWorktree& current = worktrees[worktrees.Count() - 1];
			if (piece.StartsWith(Core::StringView("HEAD "))) current.m_Oid = Core::String(After(piece, Core::StringView("HEAD ")));
			else if (piece.StartsWith(Core::StringView("branch refs/heads/"))) current.m_Branch = Core::String(After(piece, Core::StringView("branch refs/heads/")));
			else if (piece == "locked" || piece.StartsWith(Core::StringView("locked "))) current.m_Locked = true;
			else if (piece == "bare") current.m_Bare = true;
		}
		return worktrees;
	}

	Core::Array<GitRemote> ParseRemotes(Core::StringView text) {
		Core::Array<GitRemote> remotes;
		for (Core::StringView line : SplitOn(text, '\n')) {
			const int64 space = line.IndexOf(' ', 0);
			Core::StringView key = space < 0 ? line : line.Substring(0, space);
			if (!key.StartsWith(Core::StringView("remote.")) || !key.EndsWith(Core::StringView(".url"))) continue;
			GitRemote remote;
			remote.m_Name = Core::String(key.Substring(7, key.ByteLength() - 11));
			remote.m_Url = space < 0 ? Core::String("") : Core::String(line.Substring(space + 1, line.ByteLength() - space - 1).Trimmed());
			remotes.Push(remote);
		}
		return remotes;
	}
}
