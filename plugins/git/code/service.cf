include "service.ch"
include "discover.ch"

namespace Git
{
	Core::String GitWorkspace::SnapshotJson() const {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("repos"));
		json.BeginArray();
		for (GitRepo* repo : repos) json.Raw(repo->SummaryJson().View());
		json.EndArray();
		json.Field("error", error.View());
		json.BoolField("discovering", discover);
		json.EndObject();
		return json.ToString();
	}

	void GitPlugin::Init(IED::PluginContext* context) {
		this.context = context;
		GitPlugin* self = this;
		thread = Threading::Thread::Run([self]() { self->RefreshLoop(); });
	}

	void GitPlugin::Stop() {
		{
			Threading::LockGuard guard(lock);
			stopping = true;
			wake.NotifyAll();
		}
		thread.Join();
	}

	Core::String GitPlugin::SettingText(Core::StringView key, Core::StringView wsId) const {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Core::String(Serialization::ReadJson(context->Setting(key, wsId).View(), *doc).root.AsView());
	}

	GitCli GitPlugin::CliFor(Core::StringView wsId) const {
		GitCli cli;
		Core::String path = SettingText(Core::StringView("git.path"), wsId);
		if (!path.View().Trimmed().IsEmpty()) cli.program = Core::String(path.View().Trimmed());
		return cli;
	}

	GitWorkspace* GitPlugin::Find(Core::StringView wsId) const {
		for (GitWorkspace* git : workspaces)
			if (git->wsId.View() == wsId) return git;
		return nullptr;
	}

	void GitPlugin::Opened(const IED::Workspace& ws) {
		Threading::LockGuard guard(lock);
		if (Find(ws.id.View())) return;
		GitWorkspace* git = new GitWorkspace();
		git->wsId = ws.id;
		git->root = FS::Path(ws.root.View());
		workspaces.Push(git);
		context->Topic(git->Topic().View(), git->SnapshotJson().View());
		Trusted(git, ws.trusted);
	}

	void GitPlugin::TrustChanged(const IED::Workspace& ws) {
		Threading::LockGuard guard(lock);
		GitWorkspace* git = Find(ws.id.View());
		if (git) Trusted(git, ws.trusted);
	}

	// Untrusted: its repositories go; trusted: they are found again.
	void GitPlugin::Trusted(GitWorkspace* git, bool trusted) {
		git->trusted = trusted;
		if (!trusted) {
			Forget(git);
			git->error = Core::String("untrusted");
		}
		else if (git->repos.IsEmpty()) {
			git->error = Core::String("");
			git->discover = true;
			wake.NotifyAll();
		}
		Listed(git);
	}

	// The workspace's repositories changed: its topic's snapshot and a repos.changed event.
	void GitPlugin::Listed(GitWorkspace* git) {
		Core::String snapshot = git->SnapshotJson();
		context->Topic(git->Topic().View(), snapshot.View());
		context->Publish(git->Topic().View(), "repos.changed", snapshot.View());
	}

	// A forgotten repository's own watcher, if it has one, keeps marking it; nothing reads it again.
	void GitPlugin::Forget(GitWorkspace* git) {
		for (GitRepo* repo : git->repos) context->RemoveTopic(repo->Topic().View());
		git->repos.Clear();
		git->discover = false;
	}

	// --- Which repositories a change touches ---------------------------------------------------------------------------

	// A path inside a git dir: whether it changes the status (and the refs). Objects, logs and lock files do not.
	static bool GitDirMatters(Core::StringView inside) {
		if (inside.StartsWith(Core::StringView("objects/")) || inside.EndsWith(Core::StringView(".lock"))) return false;
		if (inside.StartsWith(Core::StringView("logs/"))) return inside == "logs/refs/stash";
		return true;
	}

	void GitPlugin::Mark(GitRepo* repo, Core::StringView path, bool inGitDir) {
		if (inGitDir && !GitDirMatters(path)) return;
		repo->statusDirty = true;
		repo->refsDirty = repo->refsDirty || inGitDir;
		repo->changedNs = clock_now_ns();
	}

	void GitPlugin::FilesChanged(const IED::FileChanges& changes) {
		Threading::LockGuard guard(lock);
		GitWorkspace* git = Find(changes.wsId.View());
		if (!git || git->repos.IsEmpty()) return;
		for (GitRepo* repo : git->repos) {
			Core::String gitDir;
			const bool gitDirInside = IED::RelativeTo(git->root.View(), repo->commonDir.View(), gitDir);
			for (const IED::FileChange& change : changes.changes) {
				Core::String inside;
				if (gitDirInside && IED::RelativeTo(gitDir.View(), change.path.View(), inside)) Mark(repo, inside.View(), true);
				else if (repo->relative.IsEmpty() || repo->relative == ".." || IED::RelativeTo(repo->relative.View(), change.path.View(), inside)) Mark(repo, change.path.View(), false);
			}
			if (changes.overflowed) {
				repo->statusDirty = true;
				repo->refsDirty = true;
			}
		}
		wake.NotifyAll();
	}

	// A repository whose refs live outside the workspace folder (it is above it, or a worktree's) gets a watcher of
	// its own on them; it marks the repository from a thread of its own.
	void GitPlugin::Watch(GitRepo* repo) {
		Core::String inside;
		if (IED::RelativeTo(repo->wsRoot.View(), repo->commonDir.View(), inside)) return;
		GitPlugin* self = this;
		Core::String error;
		if (!context->WatchFolder(repo->commonDir.View(), [self, repo](const Core::Array<Core::String>& paths) {
			Threading::LockGuard guard(self->lock);
			for (const Core::String& path : paths) self->Mark(repo, path.View(), true);
			self->wake.NotifyAll();
		}, error))
			Log(repo, (Core::String("not watching ") + repo->commonDir.View() + ": " + error.View() + "\n").View());
	}

	// --- The thread ------------------------------------------------------------------------------------------------------

	void GitPlugin::RefreshLoop() {
		Threading::LockGuard guard(lock);
		while (!stopping) {
			if (DiscoverNext()) continue;
			int64 waitNs = -1;
			if (RefreshDue(waitNs)) continue;
			if (waitNs < 0) wake.Wait(lock);
			else wake.WaitFor(lock, waitNs);
		}
	}

	bool GitPlugin::DiscoverNext() {
		for (GitWorkspace* git : workspaces) {
			if (!git->discover) continue;
			git->discover = false;
			Discover(git);
			return true;
		}
		return false;
	}

	void GitPlugin::Discover(GitWorkspace* git) {
		GitCli cli = CliFor(git->wsId.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		const int64 depth = Serialization::ReadJson(context->Setting(Core::StringView("git.scanDepth"), git->wsId.View()).View(), *doc).root.AsInt();
		FS::Path folder = FS::IsDirectory(git->root.CStr()) ? git->root : git->root.Parent();
		Core::Array<GitFound> found;
		Core::String error;
		{
			Threading::UnlockGuard released(lock);
			FindRepositories(cli, folder, (int32)depth, found, error);
		}
		if (!git->trusted) return;
		Forget(git);
		git->error = error;
		for (const GitFound& each : found) {
			GitRepo* repo = new GitRepo();
			repoCount += 1;
			Core::StringBuilder id;
			id.AppendByte('r');
			id.AppendInt(repoCount);
			repo->repoId = id.ToString();
			repo->wsId = git->wsId;
			repo->wsRoot = git->root;
			repo->root = each.root;
			repo->gitDir = each.gitDir;
			repo->commonDir = each.commonDir;
			repo->kind = Core::String(each.submodule ? "submodule" : "repo");
			repo->name = Core::String(each.root.FileName());
			GitRelative(git->root, each.root, repo->relative);
			repo->statusDirty = true;
			repo->refsDirty = true;
			git->repos.Push(repo);
			Snapshot(repo);
			Watch(repo);
		}
		Listed(git);
	}

	bool GitPlugin::RefreshDue(int64& waitNs) {
		const int64 now = clock_now_ns();
		for (GitWorkspace* git : workspaces) {
			for (GitRepo* repo : git->repos) {
				if (!repo->statusDirty && !repo->refsDirty) continue;
				int64 due = repo->changedNs + kGitQuietNs;
				if (repo->readNs + kGitStatusEveryNs > due) due = repo->readNs + kGitStatusEveryNs;
				if (repo->headJson.IsEmpty() || due <= now) {
					Refresh(repo, false);
					return true;
				}
				if (waitNs < 0 || due - now < waitNs) waitNs = due - now;
			}
		}
		return false;
	}

	// The refs as git lists them: branches and tags, the remotes, the stashes, the worktrees, the submodules.
	static GitRefsRead ReadRefs(const GitCli& cli, const FS::Path& root) {
		GitRefsRead read;
		Core::Array<Core::String> refs = GitArgs("for-each-ref", (Core::String("--format=") + kGitRefFormat).CStr());
		refs.Push(Core::String("refs/heads"));
		refs.Push(Core::String("refs/remotes"));
		refs.Push(Core::String("refs/tags"));
		read.refs = ParseRefs(cli.Run(root, refs, kGitReadTimeoutMs).output.View());
		read.remotes = ParseRemotes(cli.Run(root, GitArgs("config", "--get-regexp", "^remote\\..*\\.url$"), kGitReadTimeoutMs).output.View());
		read.stashes = ParseStashes(cli.Run(root, GitArgs("stash", "list", "-z", (Core::String("--format=") + kGitStashFormat).CStr()), kGitReadTimeoutMs).output.View());
		read.worktrees = ParseWorktrees(cli.Run(root, GitArgs("worktree", "list", "--porcelain", "-z"), kGitReadTimeoutMs).output.View());
		FS::Path modules = root / ".gitmodules";
		if (FS::FileExists(modules.CStr())) {
			Core::Array<Core::String> paths = GitArgs("config", "--file", ".gitmodules");
			paths.Push(Core::String("--get-regexp"));
			paths.Push(Core::String("^submodule\\..*\\.path$"));
			GitRun listed = cli.Run(root, paths, kGitReadTimeoutMs);
			for (Core::StringView line : SplitOn(listed.output.View(), '\n')) {
				const int64 space = line.IndexOf(' ', 0);
				if (space < 0) continue;
				GitSubmodule submodule;
				submodule.path = Core::String(line.Substring(space + 1, line.ByteLength() - space - 1).Trimmed());
				read.submodules.Push(submodule);
			}
		}
		return read;
	}

	void GitPlugin::Refresh(GitRepo* repo, bool refs) {
		const bool readRefs = refs || repo->refsDirty || repo->refsJson.IsEmpty();
		repo->statusDirty = false;
		repo->refsDirty = false;
		repo->readNs = clock_now_ns();
		repo->readGeneration += 1;
		const int64 generation = repo->readGeneration;
		GitCli cli = CliFor(repo->wsId.View());
		FS::Path root = repo->root;
		FS::Path gitDir = repo->gitDir;
		Core::String head;
		Core::String changes;
		Core::String refsJson;
		Core::String problem;
		{
			Threading::UnlockGuard released(lock);
			Core::Array<Core::String> arguments = GitArgs("status", "--porcelain=v2", "-z");
			arguments.Push(Core::String("--branch"));
			arguments.Push(Core::String("--untracked-files=all"));
			GitRun status = cli.Run(root, arguments, kGitReadTimeoutMs);
			if (status.Ok()) {
				GitStatus parsed = ParseStatus(status.output.View());
				head = GitHeadJson(parsed.head, GitRepoState(gitDir).View());
				changes = GitChangesJson(parsed);
			}
			else problem = status.Problem();
			if (readRefs) refsJson = GitRefsJson(ReadRefs(cli, root), root);
		}
		if (!problem.IsEmpty()) Log(repo, (Core::String("git status: ") + problem.View() + "\n").View());
		if (generation < repo->statusGeneration) head = Core::String("");
		if (generation < repo->refsGeneration) refsJson = Core::String("");
		if (!head.IsEmpty()) repo->statusGeneration = generation;
		if (!refsJson.IsEmpty()) repo->refsGeneration = generation;
		PublishRead(repo, head, changes, refsJson);
	}

	void GitPlugin::PublishRead(GitRepo* repo, const Core::String& head, const Core::String& changes, const Core::String& refs) {
		const bool status = !head.IsEmpty() && (head.View() != repo->headJson.View() || changes.View() != repo->changesJson.View());
		const bool refsChanged = !refs.IsEmpty() && refs.View() != repo->refsJson.View();
		if (status) {
			repo->headJson = head;
			repo->changesJson = changes;
		}
		if (refsChanged) repo->refsJson = refs;
		if (status || refsChanged) Snapshot(repo);
		if (status) Publish(repo, "status.changed", ((((Core::String("{\"head\":") + head.View()) + ",\"changes\":") + changes.View()) + "}").View());
		if (refsChanged) Publish(repo, "refs.changed", ((Core::String("{\"refs\":") + refs.View()) + "}").View());
	}

	void GitPlugin::Snapshot(GitRepo* repo) { context->Topic(repo->Topic().View(), repo->SnapshotJson().View()); }

	void GitPlugin::Publish(GitRepo* repo, const char* kind, Core::StringView data) { context->Publish(repo->Topic().View(), kind, data); }

	void GitPlugin::Log(GitRepo* repo, Core::StringView text) { context->Output(repo->wsId.View(), Core::StringView(kGitOutput), text); }

	Core::String GitRepoState(const FS::Path& gitDir) {
		if (FS::FileExists((gitDir / "MERGE_HEAD").CStr())) return Core::String("merging");
		if (FS::IsDirectory((gitDir / "rebase-merge").CStr()) || FS::IsDirectory((gitDir / "rebase-apply").CStr())) return Core::String("rebasing");
		if (FS::FileExists((gitDir / "CHERRY_PICK_HEAD").CStr())) return Core::String("cherryPicking");
		if (FS::FileExists((gitDir / "REVERT_HEAD").CStr())) return Core::String("reverting");
		if (FS::FileExists((gitDir / "BISECT_LOG").CStr())) return Core::String("bisecting");
		return Core::String("");
	}
}
