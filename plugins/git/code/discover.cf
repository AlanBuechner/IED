include "discover.ch"
include "parse.ch"
include "api/plugin.ch"

namespace Git
{
	// What `rev-parse` says of `folder`: its repository, or false when it is in none.
	static bool RepositoryOf(const GitCli& cli, const FS::Path& folder, GitFound& found, Core::String& error) {
		Core::Array<Core::String> arguments = GitArgs("rev-parse", "--path-format=absolute", "--show-toplevel");
		arguments.Push(Core::String("--git-dir"));
		arguments.Push(Core::String("--git-common-dir"));
		GitRun run = cli.Run(folder, arguments, kGitReadTimeoutMs);
		if (run.exitCode == Process::kError) {
			error = run.Problem();
			return false;
		}
		Core::Array<Core::StringView> lines = SplitOn(run.output.View(), '\n');
		if (!run.Ok() || lines.Count() < 3) return false;
		found.root = FS::Path(lines[0].Trimmed());
		found.gitDir = FS::Path(lines[1].Trimmed());
		found.commonDir = FS::Path(lines[2].Trimmed());
		found.submodule = found.gitDir.View().Contains(Core::StringView("/modules/"));
		return true;
	}

	static bool Skipped(Core::StringView name) {
		for (const Core::String& pattern : IED::DefaultExcludes())
			if (pattern.View().Substring(3, pattern.View().ByteLength() - 3) == name) return true;
		return false;
	}

	static bool Known(const Core::Array<GitFound>& found, const FS::Path& root) {
		Core::String relative;
		for (const GitFound& each : found)
			if (IED::RelativeTo(each.root.View(), root.View(), relative) && relative.IsEmpty()) return true;
		return false;
	}

	// The folders under `folder` with a .git of their own, `depth` levels down.
	static void Scan(const GitCli& cli, const FS::Path& folder, int32 depth, Core::Array<GitFound>& found) {
		if (depth <= 0) return;
		for (FS::DirectoryEntry& entry : FS::Directory(folder.CStr())) {
			if (entry.kind != FS::EntryKind::Directory || Skipped(entry.name.View())) continue;
			FS::Path child = folder / entry.name.View();
			FS::Path marker = child / ".git";
			GitFound repository;
			Core::String ignored;
			const bool hasGit = FS::IsDirectory(marker.CStr()) || FS::FileExists(marker.CStr());
			if (hasGit && RepositoryOf(cli, child, repository, ignored) && !Known(found, repository.root)) found.Push(repository);
			Scan(cli, child, depth - 1, found);
		}
	}

	bool FindRepositories(const GitCli& cli, const FS::Path& folder, int32 depth, Core::Array<GitFound>& found, Core::String& error) {
		GitFound outer;
		if (RepositoryOf(cli, folder, outer, error)) found.Push(outer);
		if (!error.IsEmpty()) return false;
		Scan(cli, folder, depth, found);
		return true;
	}

	bool GitRelative(const FS::Path& root, const FS::Path& path, Core::String& relative) {
		if (IED::RelativeTo(root.View(), path.View(), relative)) return true;
		Core::String inside;
		if (!IED::RelativeTo(path.View(), root.View(), inside)) return false;
		relative = Core::String("..");
		return true;
	}
}
