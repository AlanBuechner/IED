// The git methods that change a repository (docs/10 "Git"): staging, discarding, committing, branches and stashes.
// Each logs its command and git's words to the workspace's Git output and reads the repository again before it
// answers, so the caller's next snapshot already shows the change.

include "service.ch"
include "patch.ch"

namespace Git
{
	GitRun GitPlugin::RunChange(GitRepo* repo, const Core::Array<Core::String>& arguments, IED::ErrorCode code) {
		GitCli cli = CliFor(repo->wsId.View());
		FS::Path root = repo->root;
		GitRun run;
		{
			Threading::UnlockGuard released(lock);
			run = cli.Run(root, arguments, kGitWriteTimeoutMs);
		}
		Core::StringBuilder log;
		log.Append("> ");
		log.Append(GitCommandLine(arguments).View());
		log.AppendByte('\n');
		log.Append(run.output.View());
		log.Append(run.errors.View());
		Log(repo, log.View());
		Refresh(repo, true);
		if (!run.Ok()) throw IED::RpcError(run.exitCode == Process::kError ? IED::ErrorCode::Unavailable : code, run.Problem().View());
		return run;
	}

	// A name git takes as an argument: never one it would read as an option.
	static Core::String NameParam(const IED::Params& params, const char* key) {
		Core::String name = Core::String(params.Str(key).View().Trimmed());
		if (name.IsEmpty() || name.View().StartsWith(Core::StringView("-"))) throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String(key) + " is not a name git takes").View());
		return name;
	}

	static Core::Array<Core::String> PathsParam(const IED::Params& params) {
		Serialization::DomNode given = params.List("paths");
		Core::Array<Core::String> paths;
		for (int64 i = 0; i < given.Count(); ++i) {
			Core::StringView path = given.At(i).AsView();
			if (path.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "an empty path");
			paths.Push(Core::String(path));
		}
		if (paths.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "no paths");
		return paths;
	}

	static Core::Array<Core::String> WithPaths(Core::Array<Core::String> arguments, const Core::Array<Core::String>& paths) {
		arguments.Push(Core::String("--"));
		for (const Core::String& path : paths) arguments.Push(path);
		return arguments;
	}

	static bool Unborn(const GitRepo* repo) {
		return repo->headJson.View().Contains(Core::StringView("\"oid\":\"\""));
	}

	static Core::String Empty() {
		return Core::String("{}");
	}

	static Core::String StageMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		git->RunChange(repo, WithPaths(GitArgs("add", "-A"), PathsParam(params)), IED::ErrorCode::BadRequest);
		return Empty();
	}

	static Core::String UnstageMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::Array<Core::String> arguments = Unborn(repo) ? GitArgs("rm", "--cached", "-r") : GitArgs("restore", "--staged");
		if (Unborn(repo)) arguments.Push(Core::String("--quiet"));
		git->RunChange(repo, WithPaths(arguments, PathsParam(params)), IED::ErrorCode::BadRequest);
		return Empty();
	}

	FS::Path GitTempFile(Core::StringView name, Core::StringView text) {
		FS::Path file = FS::TempDirectory() / name;
		if (!FS::WriteFileAtomically(file.CStr(), (const void*)text.Data(), text.ByteLength())) throw IED::RpcError(IED::ErrorCode::Unavailable, (Core::String("cannot write ") + file.View()).View());
		return file;
	}

	// The work tree diff's hunk staged, or the staged diff's unstaged (`staged`); with `discard`, the work tree diff's
	// hunk taken out of the work tree. The caller names the hunk by its index and header as it saw them.
	static void ApplyHunk(GitPlugin* git, const IED::Params& params, bool discard) {
		GitRepo* repo = git->RepoFor(params);
		Core::String path = params.Str("path");
		const bool staged = !discard && params.Bool("staged", false);
		const int64 hunk = params.Int("hunk");
		Core::Array<int64> chosen;
		if (params.Has("lines")) {
			Serialization::DomNode lines = params.List("lines");
			for (int64 i = 0; i < lines.Count(); ++i) chosen.Push(lines.At(i).AsInt());
			if (chosen.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "no lines chosen");
		}
		GitDiff diff = ParseDiff(git->RunOrThrow(repo, GitDiffArgs(path.View(), Core::StringView(""), Core::StringView(""), false, staged, 3), kGitReadTimeoutMs, IED::ErrorCode::BadRequest).output.View());
		if (hunk < 0 || hunk >= diff.hunks.Count() || diff.hunks[hunk].header.View() != params.Str("header").View())
			throw IED::RpcError(IED::ErrorCode::Conflict, "the file changed since its diff was read; look again");
		Core::String patch = HunkPatch(diff, hunk, chosen, staged || discard);
		if (patch.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "the chosen lines change nothing");
		FS::Path file = GitTempFile((Core::String("ied-") + repo->repoId.View() + "-hunk.patch").View(), patch.View());
		Core::Array<Core::String> arguments = GitArgs("apply", "--recount");
		if (!discard) arguments.Push(Core::String("--cached"));
		if (staged || discard) arguments.Push(Core::String("-R"));
		arguments.Push(Core::String(file.View()));
		try {
			git->RunChange(repo, arguments, IED::ErrorCode::Conflict);
		}
		catch (IED::RpcError& error) {
			FS::RemoveFile(file.CStr());
			throw error;
		}
		FS::RemoveFile(file.CStr());
	}

	static Core::String StagePatchMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		ApplyHunk(git, params, false);
		return Empty();
	}

	static Core::String DiscardPatchMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		ApplyHunk(git, params, true);
		return Empty();
	}

	// Untracked paths go to the IED trash (when they are in the workspace folder); the others back to the index.
	static Core::String DiscardMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::Array<Core::String> paths = PathsParam(params);
		Core::Array<Core::String> status = WithPaths(GitArgs("status", "--porcelain=v2", "-z"), paths);
		status.Insert(3, Core::String("--untracked-files=all"));
		GitStatus read = ParseStatus(git->RunOrThrow(repo, status, kGitReadTimeoutMs, IED::ErrorCode::BadRequest).output.View());
		Core::Array<Core::String> tracked;
		for (const Core::String& path : paths) {
			bool untracked = false;
			for (const GitChange& change : read.untracked) untracked = untracked || change.path == path;
			if (!untracked) {
				tracked.Push(path);
				continue;
			}
			Core::String relative;
			if (repo->relative == ".." || !IED::RelativeTo(repo->wsRoot.View(), (repo->root / path.View()).View(), relative))
				throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String("an untracked file outside the workspace folder is not discarded: ") + path.View()).View());
			Core::String problem;
			if (!IED::MoveToTrash(repo->wsId.View(), relative.View(), problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
		}
		if (!tracked.IsEmpty()) git->RunChange(repo, WithPaths(GitArgs("restore", "--worktree"), tracked), IED::ErrorCode::BadRequest);
		else git->Refresh(repo, false);
		return Empty();
	}

	static Core::String CommitMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String message = Core::String(params.Str("message").View().Trimmed());
		const bool amend = params.Bool("amend", false);
		if (message.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "a commit needs a message");
		if (!amend && repo->changesJson.View().Contains(Core::StringView("\"staged\":[]"))) throw IED::RpcError(IED::ErrorCode::BadRequest, "nothing is staged");
		FS::Path file = GitTempFile((Core::String("ied-") + repo->repoId.View() + "-message.txt").View(), (message + "\n").View());
		Core::Array<Core::String> arguments = GitArgs("commit", "-F", file.CStr());
		if (amend) arguments.Push(Core::String("--amend"));
		if (params.Bool("signoff", false)) arguments.Push(Core::String("--signoff"));
		try {
			git->RunChange(repo, arguments, IED::ErrorCode::BadRequest);
		}
		catch (IED::RpcError& error) {
			FS::RemoveFile(file.CStr());
			throw error;
		}
		FS::RemoveFile(file.CStr());
		GitRun head = git->RunOrThrow(repo, GitArgs("rev-parse", "HEAD"), kGitReadTimeoutMs, IED::ErrorCode::Internal);
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("oid", head.output.View().Trimmed());
		json.EndObject();
		return json.ToString();
	}

	// The files git names when a checkout would overwrite local changes (its tab-indented lines).
	static Core::String OverwrittenJson(Core::StringView problem) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("files"));
		json.BeginArray();
		for (Core::StringView line : SplitOn(problem, '\n'))
			if (line.StartsWith(Core::StringView("\t"))) json.String(line.Trimmed());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	// A local branch, or with `remote` a remote one ("origin/x"): a local branch tracking it is made.
	static Core::String CheckoutMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String branch = NameParam(params, "branch");
		Core::Array<Core::String> arguments = GitArgs("switch");
		if (params.Bool("remote", false)) arguments.Push(Core::String("--track"));
		arguments.Push(branch);
		try {
			git->RunChange(repo, arguments, IED::ErrorCode::Conflict);
		}
		catch (IED::RpcError& error) {
			if (error.code == IED::ErrorCode::Conflict && error.message.View().Contains(Core::StringView("would be overwritten"))) throw IED::RpcError(IED::ErrorCode::Conflict, error.message.View(), OverwrittenJson(error.message.View()).View());
			throw error;
		}
		return Empty();
	}

	static Core::String BranchMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String name = NameParam(params, "name");
		Core::Array<Core::String> arguments = params.Bool("checkout", false) ? GitArgs("switch", "-c", name.CStr()) : GitArgs("branch", name.CStr());
		if (params.Has("from")) arguments.Push(NameParam(params, "from"));
		git->RunChange(repo, arguments, IED::ErrorCode::BadRequest);
		return Empty();
	}

	static Core::String BranchDeleteMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String name = NameParam(params, "name");
		git->RunChange(repo, GitArgs("branch", params.Bool("force", false) ? "-D" : "-d", name.CStr()), IED::ErrorCode::Conflict);
		return Empty();
	}

	static Core::String BranchRenameMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::Array<Core::String> arguments = GitArgs("branch", "-m", NameParam(params, "name").CStr());
		arguments.Push(NameParam(params, "to"));
		git->RunChange(repo, arguments, IED::ErrorCode::BadRequest);
		return Empty();
	}

	static Core::String StashMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		Core::Array<Core::String> arguments = GitArgs("stash", "push");
		if (params.Bool("untracked", false)) arguments.Push(Core::String("--include-untracked"));
		if (params.Bool("keepIndex", false)) arguments.Push(Core::String("--keep-index"));
		Core::String message = Core::String(params.Str("message", Core::StringView("")).View().Trimmed());
		if (!message.IsEmpty()) {
			arguments.Push(Core::String("-m"));
			arguments.Push(message);
		}
		GitRun run = git->RunChange(repo, arguments, IED::ErrorCode::BadRequest);
		if (run.output.View().Contains(Core::StringView("No local changes to save"))) throw IED::RpcError(IED::ErrorCode::BadRequest, "no local changes to stash");
		return Empty();
	}

	static Core::String StashName(const IED::Params& params) {
		const int64 index = params.Int("index");
		if (index < 0) throw IED::RpcError(IED::ErrorCode::BadRequest, "a stash index is 0 or more");
		Core::StringBuilder name;
		name.Append("stash@{");
		name.AppendInt(index);
		name.AppendByte('}');
		return name.ToString();
	}

	static Core::String StashApplyMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		git->RunChange(repo, GitArgs("stash", params.Bool("pop", false) ? "pop" : "apply", StashName(params).CStr()), IED::ErrorCode::Conflict);
		return Empty();
	}

	static Core::String StashDropMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->lock);
		GitRepo* repo = git->RepoFor(params);
		git->RunChange(repo, GitArgs("stash", "drop", StashName(params).CStr()), IED::ErrorCode::NotFound);
		return Empty();
	}

	void RegisterChangeMethods(GitPlugin* git) {
		RegisterMethod(git, "git.stage", [git](const IED::Request& request) -> Core::String { return StageMethod(git, request.params); });
		RegisterMethod(git, "git.unstage", [git](const IED::Request& request) -> Core::String { return UnstageMethod(git, request.params); });
		RegisterMethod(git, "git.stagePatch", [git](const IED::Request& request) -> Core::String { return StagePatchMethod(git, request.params); });
		RegisterMethod(git, "git.discardPatch", [git](const IED::Request& request) -> Core::String { return DiscardPatchMethod(git, request.params); });
		RegisterMethod(git, "git.discard", [git](const IED::Request& request) -> Core::String { return DiscardMethod(git, request.params); });
		RegisterMethod(git, "git.commit", [git](const IED::Request& request) -> Core::String { return CommitMethod(git, request.params); });
		RegisterMethod(git, "git.checkout", [git](const IED::Request& request) -> Core::String { return CheckoutMethod(git, request.params); });
		RegisterMethod(git, "git.branch", [git](const IED::Request& request) -> Core::String { return BranchMethod(git, request.params); });
		RegisterMethod(git, "git.branchDelete", [git](const IED::Request& request) -> Core::String { return BranchDeleteMethod(git, request.params); });
		RegisterMethod(git, "git.branchRename", [git](const IED::Request& request) -> Core::String { return BranchRenameMethod(git, request.params); });
		RegisterMethod(git, "git.stash", [git](const IED::Request& request) -> Core::String { return StashMethod(git, request.params); });
		RegisterMethod(git, "git.stashApply", [git](const IED::Request& request) -> Core::String { return StashApplyMethod(git, request.params); });
		RegisterMethod(git, "git.stashDrop", [git](const IED::Request& request) -> Core::String { return StashDropMethod(git, request.params); });
	}
}
