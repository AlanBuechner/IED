// The git methods that read (docs/10 "Git"): repos, log, show, diff, fileAt and lastMessage.

include "GitService.ch"

namespace Git
{
	void RegisterMethod(GitPlugin* git, const char* name, IED::MethodHandler handler) {
		Core::String problem;
		if (!git->m_Context->Method(Core::StringView(name), handler, problem)) git->m_Context->Log(problem.View());
	}

	void RegisterMethods(GitPlugin* git) {
		RegisterReadMethods(git);
		RegisterChangeMethods(git);
		RegisterOpMethods(git);
	}


	GitRepo* GitPlugin::RepoFor(const IED::Params& params) const {
		Core::String repoId = params.Str("repoId");
		for (GitWorkspace* each : m_Workspaces)
			for (GitRepo* repo : each->m_Repos)
				if (repo->m_RepoId == repoId) {
					if (!each->m_Trusted) throw IED::RpcError(IED::ErrorCode::Untrusted, "git does not run in an untrusted workspace");
					return repo;
				}
		throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no repository ") + repoId.View()).View());
	}

	GitRun GitPlugin::RunOrThrow(GitRepo* repo, const Core::Array<Core::String>& arguments, int32 timeoutMs, IED::ErrorCode code) {
		GitCli cli = CliFor(repo->m_WsId.View());
		FS::Path root = repo->m_Root;
		GitRun run;
		{
			Threading::UnlockGuard released(m_Lock);
			run = cli.Run(root, arguments, timeoutMs);
		}
		if (!run.Ok()) throw IED::RpcError(run.m_ExitCode == Process::kError ? IED::ErrorCode::Unavailable : code, run.Problem().View());
		return run;
	}

	static Core::String ReposMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitWorkspace* found = git->Find(params.Str("wsId").View());
		if (!found) throw IED::RpcError(IED::ErrorCode::NotFound, "the workspace has no git side");
		return found->SnapshotJson();
	}

	static int32 Folded(int32 c) {
		return c >= 'A' && c <= 'Z' ? c + 32 : c;
	}

	// Whether `text` has `query` in it, ASCII letters in any case.
	static bool HasFolded(Core::StringView text, Core::StringView query) {
		for (int64 start = 0; start + query.ByteLength() <= text.ByteLength(); ++start) {
			int64 i = 0;
			while (i < query.ByteLength() && Folded(text.ByteAt(start + i)) == Folded(query.ByteAt(i))) i += 1;
			if (i == query.ByteLength()) return true;
		}
		return false;
	}

	// A log record (kGitLogFormat and the body) that a search keeps: the message, the author or the email has the
	// query, or the hash starts with it.
	static bool Matches(Core::StringView record, Core::StringView query) {
		Core::Array<Core::StringView> fields = SplitOn(record.Trimmed(), (char)31);
		if (fields.Count() < 6) return false;
		if (fields[0].StartsWith(query)) return true;
		for (int64 i = 2; i < fields.Count(); ++i)
			if (i != 4 && HasFolded(fields[i], query)) return true;
		return false;
	}

	// Every commit, newest first, the stashes left out; `limit` + 1 of them after `skip` when there is no search.
	static Core::Array<Core::String> LogArgs(int64 skip, int64 limit, bool search) {
		Core::Array<Core::String> arguments = GitArgs("log", "--date-order", "-z");
		arguments.Push(Core::String("--exclude=refs/stash"));
		arguments.Push(Core::String("--all"));
		arguments.Push(Core::String("--format=") + c_GitLogFormat + (search ? "%x1f%b" : ""));
		if (search) return arguments;
		Core::StringBuilder count;
		count.Append("--max-count=");
		count.AppendInt(limit + 1);
		arguments.Push(count.ToString());
		Core::StringBuilder skipped;
		skipped.Append("--skip=");
		skipped.AppendInt(skip);
		arguments.Push(skipped.ToString());
		return arguments;
	}

	static Core::String LogMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitRepo* repo = git->RepoFor(params);
		int64 limit = params.Int("limit", c_GitLogDefault);
		if (limit < 1 || limit > c_GitLogMost) throw IED::RpcError(IED::ErrorCode::BadRequest, "limit is 1 to 2000");
		const int64 skip = params.Int("skip", 0);
		Core::String query = Core::String(params.Str("query", Core::StringView("")).View().Trimmed());
		if (repo->m_HeadJson.IsEmpty() || repo->m_HeadJson.View().Contains(Core::StringView("\"oid\":\"\""))) return GitLogJson(Core::Array<GitCommit>(), false);
		GitRun run = git->RunOrThrow(repo, LogArgs(skip, limit, !query.IsEmpty()), c_GitReadTimeoutMs, IED::ErrorCode::BadRequest);
		if (query.IsEmpty()) {
			Core::Array<GitCommit> commits = ParseLog(run.m_Output.View());
			const bool more = commits.Count() > limit;
			if (more) commits.RemoveAt(commits.Count() - 1);
			return GitLogJson(commits, more);
		}
		Core::StringBuilder kept;
		int64 found = 0;
		for (Core::StringView record : SplitOn(run.m_Output.View(), (char)0)) {
			if (!Matches(record, query.View())) continue;
			found += 1;
			if (found <= skip || found > skip + limit) continue;
			kept.Append(record);
			kept.AppendByte(0);
		}
		return GitLogJson(ParseLog(kept.View()), found > skip + limit);
	}

	// A commit's change against its first parent (a root commit's against nothing), renames found.
	static void AddRange(Core::Array<Core::String>& arguments, Core::StringView oid, bool hasParent) {
		arguments.Push(Core::String("-M"));
		if (hasParent) arguments.Push(Core::String(oid) + "^1");
		arguments.Push(Core::String(oid));
	}

	static Core::String ShowMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String oid = params.Str("oid");
		Core::Array<Core::String> show = GitArgs("show", "-s");
		show.Push(Core::String("--format=%H%x1f%P%x1f%an%x1f%ae%x1f%at%x1f%cn%x1f%ce%x1f%ct%x1f%s%x1f%b"));
		show.Push(Core::String(oid));
		GitRun shown = git->RunOrThrow(repo, show, c_GitReadTimeoutMs, IED::ErrorCode::NotFound);
		Core::Array<Core::StringView> fields = SplitOn(shown.m_Output.View(), (char)31);
		if (fields.Count() < 10) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no commit ") + oid.View()).View());
		const bool hasParent = !fields[1].Trimmed().IsEmpty();
		Core::Array<Core::String> names = hasParent ? GitArgs("diff", "--name-status", "-z") : GitArgs("diff-tree", "-r", "--root", "--no-commit-id");
		Core::Array<Core::String> counts = hasParent ? GitArgs("diff", "--numstat", "-z") : GitArgs("diff-tree", "-r", "--root", "--no-commit-id");
		if (!hasParent) {
			names.Push(Core::String("--name-status"));
			names.Push(Core::String("-z"));
			counts.Push(Core::String("--numstat"));
			counts.Push(Core::String("-z"));
		}
		AddRange(names, fields[0].Trimmed(), hasParent);
		AddRange(counts, fields[0].Trimmed(), hasParent);
		Core::Array<GitFileChange> files = ParseNameStatus(git->RunOrThrow(repo, names, c_GitReadTimeoutMs, IED::ErrorCode::NotFound).m_Output.View());
		AddNumstat(files, git->RunOrThrow(repo, counts, c_GitReadTimeoutMs, IED::ErrorCode::NotFound).m_Output.View());
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("oid", fields[0].Trimmed());
		json.Key(Core::StringView("parents"));
		json.BeginArray();
		for (Core::StringView parent : SplitOn(fields[1], ' ')) json.String(parent);
		json.EndArray();
		json.Field("author", fields[2]);
		json.Field("email", fields[3]);
		int64 seconds = 0;
		Core::ParseInt64(fields[4], seconds);
		json.IntField("authorMs", seconds * 1000);
		json.Field("committer", fields[5]);
		json.Field("committerEmail", fields[6]);
		Core::ParseInt64(fields[7], seconds);
		json.IntField("commitMs", seconds * 1000);
		json.Field("subject", fields[8]);
		json.Field("body", fields[9].Trimmed());
		json.RawField("files", GitFilesJson(files).View());
		json.EndObject();
		return json.ToString();
	}

	Core::Array<Core::String> GitDiffArgs(Core::StringView path, Core::StringView oldPath, Core::StringView oid, bool hasParent, bool staged, int64 context) {
		Core::Array<Core::String> arguments = oid.IsEmpty() || hasParent ? GitArgs("diff", "--no-ext-diff") : GitArgs("diff-tree", "-p", "--root", "--no-commit-id");
		Core::StringBuilder unified;
		unified.Append("-U");
		unified.AppendInt(context);
		arguments.Push(unified.ToString());
		arguments.Push(Core::String("-M"));
		if (oid.IsEmpty() && staged) arguments.Push(Core::String("--cached"));
		if (!oid.IsEmpty() && hasParent) arguments.Push(Core::String(oid) + "^1");
		if (!oid.IsEmpty()) arguments.Push(Core::String(oid));
		arguments.Push(Core::String("--"));
		if (!oldPath.IsEmpty()) arguments.Push(Core::String(oldPath));
		arguments.Push(Core::String(path));
		return arguments;
	}

	static bool HasParent(Core::StringView showParents) {
		return !showParents.Trimmed().IsEmpty();
	}

	static Core::String DiffMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String path = params.Str("path");
		Core::String oldPath = params.Str("oldPath", Core::StringView(""));
		Core::String oid = params.Str("oid", Core::StringView(""));
		int64 context = params.Int("context", 3);
		if (context < 0 || context > 1000) throw IED::RpcError(IED::ErrorCode::BadRequest, "context is 0 to 1000");
		bool hasParent = false;
		if (!oid.IsEmpty()) hasParent = HasParent(git->RunOrThrow(repo, GitArgs("show", "-s", "--format=%P", oid.CStr()), c_GitReadTimeoutMs, IED::ErrorCode::NotFound).m_Output.View());
		GitRun run = git->RunOrThrow(repo, GitDiffArgs(path.View(), oldPath.View(), oid.View(), hasParent, params.Bool("staged", false), context), c_GitReadTimeoutMs, IED::ErrorCode::BadRequest);
		const bool truncated = run.m_Output.View().ByteLength() > c_GitDiffMostBytes;
		Core::StringView text = truncated ? run.m_Output.View().Substring(0, c_GitDiffMostBytes) : run.m_Output.View();
		return GitDiffJson(path.View(), oldPath.View(), ParseDiff(text), truncated);
	}

	static bool LooksBinary(Core::StringView text) {
		const int64 probe = text.ByteLength() < 8000 ? text.ByteLength() : 8000;
		for (int64 i = 0; i < probe; ++i)
			if (text.ByteAt(i) == 0) return true;
		return false;
	}

	// A side of a side-by-side diff: the file in a commit (`rev`), the index (":") or the work tree ("").
	static Core::String FileAtMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitRepo* repo = git->RepoFor(params);
		Core::String path = params.Str("path");
		Core::String rev = params.Str("rev", Core::StringView(""));
		Core::String text;
		bool missing = false;
		if (rev.IsEmpty()) {
			FS::Path file = repo->m_Root / path.View();
			missing = !FS::FileExists(file.CStr());
			if (!missing) text = FS::File(file.CStr(), "rb").ReadText();
		}
		else {
			GitCli cli = git->CliFor(repo->m_WsId.View());
			FS::Path root = repo->m_Root;
			GitRun run;
			{
				Threading::UnlockGuard released(git->m_Lock);
				run = cli.Run(root, GitArgs("show", (rev == ":" ? (Core::String(":") + path.View()) : ((rev + ":") + path.View())).CStr()), c_GitReadTimeoutMs);
			}
			missing = !run.Ok();
			text = run.m_Output;
		}
		const bool binary = LooksBinary(text.View());
		const bool truncated = text.View().ByteLength() > c_GitFileMostBytes;
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("text", binary || missing ? Core::StringView("") : (truncated ? text.View().Substring(0, c_GitFileMostBytes) : text.View()));
		json.BoolField("binary", binary);
		json.BoolField("missing", missing);
		json.BoolField("truncated", truncated);
		json.EndObject();
		return json.ToString();
	}

	static Core::String LastMessageMethod(GitPlugin* git, const IED::Params& params) {
		Threading::LockGuard guard(git->m_Lock);
		GitRepo* repo = git->RepoFor(params);
		GitRun run = git->RunOrThrow(repo, GitArgs("log", "-1", "--format=%B"), c_GitReadTimeoutMs, IED::ErrorCode::NotFound);
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("message", run.m_Output.View().Trimmed());
		json.EndObject();
		return json.ToString();
	}

	void RegisterReadMethods(GitPlugin* git) {
		RegisterMethod(git, "git.repos", [git](const IED::Request& request) -> Core::String { return ReposMethod(git, request.m_Params); });
		RegisterMethod(git, "git.log", [git](const IED::Request& request) -> Core::String { return LogMethod(git, request.m_Params); });
		RegisterMethod(git, "git.show", [git](const IED::Request& request) -> Core::String { return ShowMethod(git, request.m_Params); });
		RegisterMethod(git, "git.diff", [git](const IED::Request& request) -> Core::String { return DiffMethod(git, request.m_Params); });
		RegisterMethod(git, "git.fileAt", [git](const IED::Request& request) -> Core::String { return FileAtMethod(git, request.m_Params); });
		RegisterMethod(git, "git.lastMessage", [git](const IED::Request& request) -> Core::String { return LastMessageMethod(git, request.m_Params); });
	}
}
