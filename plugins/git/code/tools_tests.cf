// git: the AI's git tools' paths between the workspace and a repository, and their answers' text.

include "tooltext.ch"
include "api/protocol.ch"

// `text` with '|' standing for NUL and '^' for the unit separator, as the formats print them.
static Core::String Printed(const char* text) {
	Core::StringBuilder out;
	for (int64 i = 0; text[i] != 0; ++i) {
		const char c = text[i];
		if (c == '|') out.AppendByte(0);
		else if (c == '^') out.AppendByte(31);
		else out.AppendByte(c);
	}
	return out.ToString();
}

static bool Has(const Core::String& text, const char* part) { return text.View().Contains(Core::StringView(part)); }

static const char* kTwoFileDiff = "diff --git a/a.txt b/a.txt\nindex 1..2 100644\n--- a/a.txt\n+++ b/a.txt\n@@ -1,3 +1,4 @@ intro\n one\n-two\n+TWO\n+2.5\n three\n@@ -10 +11 @@\n-ten\n+TEN\ndiff --git a/logo.png b/logo.png\nindex 3..4 100644\nBinary files a/logo.png and b/logo.png differ\n";

[test("server.git.tools")]
class GitToolTests {
	[test("places")]
	public static void TestPlaces() {
		Core::String inside;
		Git::GitPlace own = Git::PlaceFrom(Core::StringView(""), Core::StringView(""));
		assert_true(own.ToRepo(Core::StringView("./src/a.c"), inside) && inside == "src/a.c", "the workspace's own: paths as they are");
		assert_true(own.ToRepo(Core::StringView("."), inside) && inside == "." && own.Name() == ".", "the folder itself");
		Git::GitPlace sub = Git::PlaceFrom(Core::StringView("lib/third"), Core::StringView(""));
		assert_true(sub.ToRepo(Core::StringView("lib/third/x.c"), inside) && inside == "x.c", "a repository in a folder: its paths under it");
		assert_true(sub.ToRepo(Core::StringView("lib/third"), inside) && inside == ".", "its folder is its root");
		assert_true(!sub.ToRepo(Core::StringView("lib/thirdparty/x.c"), inside) && !sub.ToRepo(Core::StringView("src/a.c"), inside), "a path outside it is not its");
		assert_true(sub.FromRepo(Core::StringView("x.c"), inside) && inside == "lib/third/x.c", "and back");
		Git::GitPlace above = Git::PlaceFrom(Core::StringView(".."), Core::StringView("plugins/git"));
		assert_true(above.ToRepo(Core::StringView("code/git.cf"), inside) && inside == "plugins/git/code/git.cf", "a repository above the folder");
		assert_true(above.ToRepo(Core::StringView(""), inside) && inside == "plugins/git", "the folder itself is its path in it");
		assert_true(above.FromRepo(Core::StringView("plugins/git/ui/a.js"), inside) && inside == "ui/a.js", "its paths inside the folder");
		assert_true(!above.FromRepo(Core::StringView("src/main.cf"), inside), "and none outside");
		assert_true(above.DiffOptions().Count() == 1 && above.DiffOptions()[0] == "--relative=plugins/git", "its diffs relative to the folder");
		assert_true(sub.DiffOptions().Count() == 2 && sub.DiffOptions()[0] == "--src-prefix=a/lib/third/", "a sub-repository's diffs under its folder");
		bool refused = false;
		try {
			own.ToRepo(Core::StringView("../outside.c"), inside);
		}
		catch (IED::RpcError& error) {
			refused = error.code == IED::ErrorCode::BadRequest;
		}
		assert_true(refused, "no path out of the workspace");
	}

	[test("status")]
	public static void TestStatus() {
		Git::GitStatus status = Git::ParseStatus(Printed("# branch.oid 6d4a1b2c3d|# branch.head main|# branch.upstream origin/main|# branch.ab +2 -1|1 .M N... 100644 100644 100644 814f 814f a.txt|2 R. N... 100644 100644 100644 587b 587b R100 new.c|old.c|u UU N... 100644 100644 100644 100644 aaaa bbbb cccc both.c|? notes.txt|").View());
		Core::String text = Git::StatusText(status, Core::StringView("merging"), Git::PlaceFrom(Core::StringView(""), Core::StringView("")), Core::StringView("Game"));
		assert_true(Has(text, "repository . (Game): on branch main, tracking origin/main (2 ahead, 1 behind)\n"), "the branch line");
		assert_true(Has(text, "a merge is in progress"), "the state");
		assert_true(Has(text, "conflicted (1):\n  both modified: both.c\n"), "a conflict in words");
		assert_true(Has(text, "staged (1):\n  renamed: new.c (from old.c)\n"), "a rename with its source");
		assert_true(Has(text, "not staged (1):\n  modified: a.txt\n") && Has(text, "untracked (1):\n  notes.txt\n"), "the other lists");
		Git::GitStatus clean = Git::ParseStatus(Printed("# branch.oid 6d4a1b2c3d|# branch.head feat|# branch.upstream origin/feat|").View());
		assert_true(clean.head.gone, "an upstream with no ahead/behind line is gone");
		Core::String cleanText = Git::StatusText(clean, Core::StringView(""), Git::PlaceFrom(Core::StringView("lib"), Core::StringView("")), Core::StringView("lib"));
		assert_true(Has(cleanText, "repository lib (lib): on branch feat, tracking origin/feat (gone)\nnothing to commit, the work tree is clean\n"), "gone, and clean");
		Git::GitStatus upToDate = Git::ParseStatus(Printed("# branch.oid 6d4a|# branch.head main|# branch.upstream origin/main|# branch.ab +0 -0|").View());
		assert_true(!upToDate.head.gone && Has(Git::StatusText(upToDate, Core::StringView(""), Git::PlaceFrom(Core::StringView(""), Core::StringView("")), Core::StringView("")), "(up to date)"), "up to date");
		Git::GitStatus detached = Git::ParseStatus(Printed("# branch.oid 94cd0e1f22|# branch.head (detached)|").View());
		assert_true(Has(Git::StatusText(detached, Core::StringView(""), Git::PlaceFrom(Core::StringView(""), Core::StringView("")), Core::StringView("")), "HEAD detached at 94cd0e1\n"), "detached");
		Git::GitStatus unborn = Git::ParseStatus(Printed("# branch.oid (initial)|# branch.head main|").View());
		assert_true(Has(Git::StatusText(unborn, Core::StringView(""), Git::PlaceFrom(Core::StringView(""), Core::StringView("")), Core::StringView("")), "on branch main, no commits yet\n"), "before the first commit");
	}

	[test("status_above_the_folder")]
	public static void TestStatusAboveTheFolder() {
		Git::GitStatus status = Git::ParseStatus(Printed("# branch.oid 6d4a|# branch.head main|1 .M N... 100644 100644 100644 814f 814f plugins/git/code/git.cf|1 .M N... 100644 100644 100644 814f 814f src/main.cf|").View());
		Core::String text = Git::StatusText(status, Core::StringView(""), Git::PlaceFrom(Core::StringView(".."), Core::StringView("plugins/git")), Core::StringView("IED"));
		assert_true(Has(text, "not staged (1):\n  modified: code/git.cf\n"), "the folder's change as its path");
		assert_true(Has(text, "1 changes outside the workspace's folder are not shown"), "the others counted");
	}

	[test("diff")]
	public static void TestDiff() {
		Core::String text = Git::DiffText(Core::StringView(kTwoFileDiff), true, 24576);
		assert_true(Has(text, "2 files changed, +3 -2:\n  a.txt  +3 -2\n  logo.png  binary\n\n"), "counts first");
		assert_true(Has(text, "@@ -1,3 +1,4 @@ intro (hunk 1)\n") && Has(text, "@@ -10 +11 @@ (hunk 2)\n"), "hunks numbered in their file");
		assert_true(Has(text, "Binary files a/logo.png and b/logo.png differ\n"), "the rest as git printed it");
		Core::String plain = Git::DiffText(Core::StringView(kTwoFileDiff), false, 24576);
		assert_true(!Has(plain, "(hunk"), "a revision's diff is not numbered");
		Core::String cut = Git::DiffText(Core::StringView(kTwoFileDiff), true, 120);
		assert_true(Has(cut, "[the diff is cut at 0 KB: a.txt is shown in part and 1 more file is not shown; ask for fewer paths to see the rest]"), "what a cut left out");
		assert_true(!Has(cut, "Binary files"), "cut at a line");
		assert_true(Git::DiffText(Core::StringView(""), true, 24576).IsEmpty(), "no diff, no text");
		Core::String renamed = Git::DiffText(Core::StringView("diff --git a/sub/old name.c b/sub/new name.c\nsimilarity index 100%\nrename from old name.c\nrename to new name.c\n"), true, 24576);
		assert_true(Has(renamed, "1 file changed, +0 -0\n"), "a pure rename");
	}

	[test("log")]
	public static void TestLog() {
		Core::String records = Printed("6d4a1b2^2026-10-21 14:03^Owner^HEAD -> main, origin/main^Second: line two|94cd0e1^2026-10-20 09:00^Owner^^First|1111111^2026-10-19 08:00^Other^^Zero|");
		Core::String two = Git::LogText(records.View(), 2, 0);
		assert_true(Has(two, "6d4a1b2 2026-10-21 14:03 Owner: Second: line two  (HEAD -> main, origin/main)\n94cd0e1 2026-10-20 09:00 Owner: First\n"), "a line a commit");
		assert_true(!Has(two, "Zero") && Has(two, "[more: skip 2 for the next ones]"), "paged");
		assert_true(!Has(Git::LogText(records.View(), 3, 5), "[more"), "no more");
		assert_true(Git::LogText(Core::StringView(""), 30, 0) == "no commits\n", "none");
	}

	[test("blame")]
	public static void TestBlame() {
		Core::String porcelain = Core::String("94cd0e1f2233445566778899aabbccddeeff0011 1 1 1\nauthor Owner\nauthor-mail <o@x>\nauthor-time 1792540800\nauthor-tz -0500\nsummary First: the files\nfilename a.txt\n\tline 1\n6d4a1b2c3d4e5f60718293a4b5c6d7e8f9012345 2 2 1\nauthor Owner\nauthor-time 1792592576\nauthor-tz -0500\nsummary Second: line two\nfilename a.txt\n\tline two\n0000000000000000000000000000000000000000 3 3 1\nauthor Not Committed Yet\nauthor-time 1792600000\nauthor-tz +0000\nsummary Version of a.txt from a.txt\nfilename a.txt\n\tnew line\n94cd0e1f2233445566778899aabbccddeeff0011 3 4\n\tline 3\n");
		Core::String text = Git::BlameText(porcelain.View(), Core::StringView("a.txt"));
		assert_true(Has(text, "a.txt, lines 1-4, from 3 commits:\n"), "the header");
		assert_true(Has(text, "  94cd0e1 2026-10-20 Owner: First: the files\n"), "a commit once, its date in its author's zone");
		assert_true(Has(text, "  0000000 not committed yet\n"), "uncommitted lines");
		assert_true(Has(text, "1 94cd0e1\tline 1\n2 6d4a1b2\tline two\n3 0000000\tnew line\n4 94cd0e1\tline 3\n"), "each line, a commit seen before named again");
	}

	[test("branches")]
	public static void TestBranches() {
		Core::String refs = Printed("refs/heads/feat^94cd0e1f22^^origin/feat^[ahead 3, behind 1]^ ^Add the feature\nrefs/heads/main^6d4a1b2c3d^^origin/main^^*^Second: line two\nrefs/heads/old^1111111222^^origin/old^[gone]^ ^Old work\nrefs/heads/topic^2222222333^^^^ ^\nrefs/remotes/origin/HEAD^6d4a^^^^ ^\nrefs/remotes/origin/main^6d4a^^^^ ^\nrefs/tags/v1^94cd^^^^ ^First\n");
		Core::Array<Git::GitStash> stashes = Git::ParseStashes(Printed("aaaa^On main: wip|").View());
		Core::String text = Git::BranchesText(refs.View(), stashes);
		assert_true(Has(text, "  feat, tracking origin/feat (3 ahead, 1 behind): 94cd0e1 Add the feature\n"), "a branch with its upstream and last commit");
		assert_true(Has(text, "* main, tracking origin/main (up to date): 6d4a1b2 Second: line two\n"), "the current one marked");
		assert_true(Has(text, "  old, tracking origin/old (gone): 1111111 Old work\n") && Has(text, "  topic, no upstream: 2222222 \n"), "gone, and none");
		assert_true(Has(text, "remote branches (1): origin/main\n") && Has(text, "tags (1): v1\n"), "remote branches and tags by name");
		assert_true(Has(text, "stashes (1):\n  0: On main: wip\n"), "the stashes");
	}

	[test("file_text")]
	public static void TestFileText() {
		Core::String text = Git::FileText(Core::StringView("one\r\ntwo\nthree\n"), 1, 2);
		assert_true(text == "1\tone\n2\ttwo\n[lines 1-2 of 3; git_show with offset 3 reads on]\n", "numbered, a CR dropped, how to read on");
		assert_true(Git::FileText(Core::StringView("one\ntwo\nthree\n"), 3, 400) == "3\tthree\n", "from a line");
		assert_true(Git::FileText(Core::StringView(""), 1, 400) == "[the file is empty]\n", "empty");
	}
}
