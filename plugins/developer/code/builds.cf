include "builds.ch"

namespace Developer
{
	const char* kStateTopic = "ied.developer/state";
	const int64 kBuildPollMs = 200;
	const int64 kBuildDrainMs = 2000;

	static int64 NowMs() { return Platform::UnixTimeNs() / 1000000; }

	const char* BuildStateName(BuildState state) {
		const char*[5] names = { "idle", "running", "succeeded", "failed", "canceled" };
		return names[(int32)state];
	}

	Core::Array<Core::String> CompleteLines(Core::String& pending, Core::StringView text) {
		Core::Array<Core::String> complete;
		pending.Append(text);
		Core::StringView all = pending.View();
		int64 start = 0;
		for (int64 end = all.IndexOf('\n', 0); end >= 0; end = all.IndexOf('\n', start)) {
			const int64 stop = end > start && all.ByteAt(end - 1) == '\r' ? end - 1 : end;
			complete.Push(Core::String(all.Substring(start, stop - start)));
			start = end + 1;
		}
		pending = Core::String(all.Substring(start, all.ByteLength() - start));
		return complete;
	}

	void Builds::Init(IED::PluginContext* context, Core::String source) {
		this.context = context;
		this.source = source;
		installed = ReadInstallRecord(IED::HomeFolder().View(), record);
		behind = -1;
		state = BuildState::Idle;
		startedMs = 0;
		endedMs = 0;
		exitCode = 0;
		canceled.Store(false);
	}

	Core::String Builds::SnapshotJson() const {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("source", source.View());
		json.Key(Core::StringView("install"));
		if (installed) {
			json.BeginObject();
			json.Field("commit", record.commit.View());
			json.BoolField("dirty", record.dirty);
			json.IntField("installedMs", record.installedMs);
			json.EndObject();
		}
		else json.Null();
		json.Field("head", head.View());
		json.IntField("behind", behind);
		json.Key(Core::StringView("build"));
		WriteBuild(json);
		json.EndObject();
		return json.ToString();
	}

	void Builds::WriteBuild(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("state", BuildStateName(state));
		json.IntField("startedMs", startedMs);
		json.IntField("endedMs", endedMs);
		json.IntField("exitCode", exitCode);
		json.Key(Core::StringView("lines"));
		json.BeginArray();
		for (const Core::String& line : lines) json.String(line.View());
		json.EndArray();
		json.EndObject();
	}

	void Builds::Refresh() {
		Core::String found = HeadCommit(source.View());
		InstallRecord now;
		const bool has = ReadInstallRecord(IED::HomeFolder().View(), now);
		const int64 count = has ? CommitsSince(source.View(), now.commit.View()) : -1;
		Builds* self = this;
		context->Atomically([self, found, now, has, count](IED::Events& events) {
			self->head = found;
			self->record = now;
			self->installed = has;
			self->behind = count;
			events.Publish(Core::StringView(kStateTopic), "changed", self->SnapshotJson().View());
		});
	}

	bool Builds::Start(Core::String& problem) {
		bool started = false;
		Builds* self = this;
		context->Atomically([self, &started](IED::Events& events) {
			if (self->state == BuildState::Running) return;
			self->state = BuildState::Running;
			self->startedMs = NowMs();
			self->endedMs = 0;
			self->exitCode = 0;
			self->lines.Clear();
			self->canceled.Store(false);
			started = true;
			events.Publish(Core::StringView(kStateTopic), "changed", self->SnapshotJson().View());
		});
		if (!started) {
			problem = Core::String("a rebuild is already running");
			return false;
		}
		context->StartThread([self]() { self->Run(); });
		return true;
	}

	void Builds::Cancel() { canceled.Store(true); }

	static Core::String LastLines(const Core::Array<Core::String>& lines, int64 most) {
		Core::StringBuilder tail;
		for (int64 i = lines.Count() > most ? lines.Count() - most : 0; i < lines.Count(); ++i) {
			tail.Append(lines[i].View());
			tail.Append("\n");
		}
		return tail.ToString();
	}

	BuildState Builds::AwaitInstall(int64& code, Core::String& tail, int64 most) {
		Core::String running;
		Start(running);
		for (;;) {
			{
				IED::HostLock guard(*context);
				if (state != BuildState::Running) {
					code = exitCode;
					tail = LastLines(lines, most);
					return state;
				}
			}
			Threading::Thread::Sleep(kInstallPollNs);
		}
	}

	// `cmd /c <checkout>\nuke.bat install-ied`, its output published as it comes.
	void Builds::Run() {
		Process::StartInfo info;
		info.program = Core::String("cmd.exe");
		info.arguments.Push(Core::String("/d"));
		info.arguments.Push(Core::String("/c"));
		info.arguments.Push(Core::String((FS::Path(source.View()) / Core::StringView("nuke.bat")).View()));
		info.arguments.Push(Core::String("install-ied"));
		info.workingDirectory = source;
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::ToOutput;
		Process::Child child = Process::Child::Start(info);
		if (!child.IsOpen()) {
			Core::Array<Core::String> said;
			said.Push(Core::String("nuke install-ied did not start: ") + child.Error());
			Publish(said);
			Finish(BuildState::Failed, -1);
			return;
		}
		const int64 deadline = NowMs() + kBuildMostSeconds * 1000;
		int64 exitedAt = -1;
		Core::String pending;
		char8[16384] buffer;
		while (child.HasOutput()) {
			if (canceled.Load() || NowMs() > deadline) {
				child.Kill();
				break;
			}
			if (exitedAt < 0 && child.Wait(0) != Process::kTimedOut) exitedAt = NowMs();
			if (exitedAt >= 0 && NowMs() - exitedAt > kBuildDrainMs) break;
			Process::Stream from;
			const int64 got = child.ReadAny((void*)&buffer[0], 16384, from, kBuildPollMs);
			if (got > 0) Publish(CompleteLines(pending, Core::StringView(&buffer[0], got)));
			else if (got != Process::kTimedOut && got != 0) break;
		}
		if (!pending.IsEmpty()) Publish(CompleteLines(pending, Core::StringView("\n")));
		const int64 code = child.Wait(5000);
		if (canceled.Load()) Finish(BuildState::Canceled, code);
		else Finish(code == 0 ? BuildState::Succeeded : BuildState::Failed, code);
		Refresh();
	}

	void Builds::Publish(const Core::Array<Core::String>& added) {
		if (added.IsEmpty()) return;
		Builds* self = this;
		context->Atomically([self, added](IED::Events& events) {
			IED::JsonWriter json;
			json.BeginObject();
			json.Key(Core::StringView("lines"));
			json.BeginArray();
			for (const Core::String& line : added) {
				self->lines.Push(line);
				json.String(line.View());
			}
			json.EndArray();
			json.EndObject();
			while (self->lines.Count() > kBuildLogLines) self->lines.RemoveAt(0);
			events.Publish(Core::StringView(kStateTopic), "build.lines", json.View());
		});
	}

	void Builds::Finish(BuildState finished, int64 code) {
		Builds* self = this;
		context->Atomically([self, finished, code](IED::Events& events) {
			self->state = finished;
			self->exitCode = code;
			self->endedMs = NowMs();
			events.Publish(Core::StringView(kStateTopic), "changed", self->SnapshotJson().View());
		});
	}
}
