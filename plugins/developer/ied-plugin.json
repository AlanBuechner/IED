// Developer mode (docs/28): when IED runs from its source checkout, a chat can fix the C4 compiler, Bedrock, Nuke or
// IED itself where a bug lives instead of working around it - the source as the root "ied:/" of its file tools (the
// ai.roots binding, which the chat plugin consumes), a system-message section that says how, and the tools ied_rebuild,
// ied_gates, ied_relaunch and ied_known_bugs, loaded on demand - and Rebuild and relaunch in its settings page, which
// keeps the desktop build current with the checkout. Off by default, and offered only where IED is built from source. Its server code (code/) is compiled into the server; an installed IED finds its
// checkout through install.json, and one with none contributes nothing.
{
	"manifestVersion": 1,
	"id": "ied.developer",
	"name": "Developer Mode",
	"version": "0.1.0",
	"description": "When IED is built from its source, chats can fix IED and the C4 toolchain as they work, and Settings rebuilds and relaunches it.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "Developer::Activate", "ui": "ui/index.js", "servers": ["master", "workspace"] },
	"permissions": ["process.spawn", "fs.read", "workspace.open", "server.relaunch"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Environment/Developer" },
		"settingsPages": [
			{ "id": "ied.developer", "page": "Environment", "title": "Developer", "view": "DeveloperSettings", "keys": ["developer.enabled"] }
		],
		"bindings": {
			"consumes": [
				{ "name": "ied.developer.install", "version": "1.0.0", "optional": true }
			],
			"provides": [
				{
					"name": "ai.roots",
					"version": "1.0.0",
					"kind": "function",
					"description": "Other workspaces a chat of `wsId` may reach by an alias: {wsId, open?: alias} -> {roots: [{alias, title, folder, confirm, wsId?}]}; `open` opens the alias's folder as a workspace and gives its wsId (docs/28)."
				},
				{
					"name": "ied.developer.install",
					"version": "1.0.0",
					"kind": "function",
					"master": true,
					"description": "nuke install-ied in the source checkout, the build Settings > Developer shows: {} -> {state: succeeded|failed|canceled, exitCode, tail}, once the install that runs, or one started now, has ended. It waits as long as the build takes, so call it from a tool on a thread of its own (ownThread), as ied_relaunch does (docs/28)."
				}
			]
		},
		"statusBarItems": [
			{ "id": "ied.developer.status", "alignment": "left", "priority": 5, "view": "DeveloperStatus", "command": "ied.developer.settings" }
		],
		"commands": [
			{ "id": "ied.developer.settings", "title": "Developer Mode Settings", "category": "Developer", "icon": "$(tools)" }
		]
	}
}
