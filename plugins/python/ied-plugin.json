// Python (docs/26 "Language plugins"): the language, its icons, Python projects by their packaging files, the places
// Python prints - a traceback's 'File "path", line N' and the tools' "path:line:col" - and the Python terminal profile
// (docs/05 "Terminal profiles"): IED's own Python (vendor/python, the embeddable CPython IED runs its services with)
// interactively in the workspace's folder, through shell/startup.py, which gives it a packages folder of its own and a
// pip() that installs there (pip("install requests")).
{
	"manifestVersion": 1,
	"id": "ied.python",
	"name": "Python",
	"version": "0.1.0",
	"description": "The Python language: recognition, icons, traceback links and a Python terminal on IED's own Python.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"contributes": {
		"languages": [
			{ "id": "python", "aliases": ["Python"], "extensions": [".py", ".pyw", ".pyi"], "fences": ["python", "py", "python3"], "lineComment": "#", "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] }
		],
		"fileIcons": [
			{ "languageId": "python", "extensions": [".py", ".pyw", ".pyi"], "label": "PY", "color": "--hue-cyan" }
		],
		"projectIcons": [
			{ "languageId": "python", "label": "PY", "color": "--hue-cyan", "markers": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt"] }
		],
		"terminalProfiles": [
			{ "id": "python", "title": "Python", "icon": "$(python)", "argv": ["${iedHome}/vendor/python/python.exe", "-i", "${pluginDir}/shell/startup.py", "${pluginState}/packages"], "env": { "PYTHONIOENCODING": "utf-8" } }
		],
		"outputLinks": [
			{ "id": "traceback", "regexp": "File \\\"([^\\\"]+)\\\", line (\\d+)", "file": 1, "line": 2 },
			{ "id": "gnu", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\\\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		]
	}
}
