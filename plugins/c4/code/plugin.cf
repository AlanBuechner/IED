// The built-in c4 plugin's entry (docs/26 "The c4 plugin and its toolchains"): for each workspace it is loaded for, the
// language server, the debug adapter and the reference docs of the C4 toolchain that workspace uses (toolchain.ch),
// given as the plugin's computed contributions from toolchain-contributions.json, and given again when the workspace's
// nuke.toml or a setting changes. A toolchain's own copy of the plugin has no code: C4/MakeToolchain.py writes them
// into its manifest.
include "api/plugin.ch"
include "toolchain.ch"

namespace C4Plugin
{
	const char* kTemplateFile = "toolchain-contributions.json";
	static const char*[2] kPoints = { "lspProfiles", "dapProviders" };
	const char* kDocsPoint = "aiDocs";
	const char* kCopyFolder = "ied";   // a toolchain's own copy of the plugin, whose folders the docs entries name

	class Support
	{
		[operator("create")] public void Init(IED::PluginContext* context) { this.context = context; }

		public IED::PluginContext* context;
		public Serialization::DomDoc* contributions;                  // toolchain-contributions.json, read once
		public Serialization::DomNode entries;
		public Core::HashMap<Core::String, Core::String> given;   // "<wsId> <point>" -> the entries given last
		public Core::HashMap<Core::String, Core::String> told;    // wsId -> what the log said last
	}

	// --- What the plugin reads -----------------------------------------------------------------------------------------

	static Core::String TextOf(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Core::String("");
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	// A setting's string value ("" when it is unset or not a string).
	static Core::String StringSetting(Support* support, Core::StringView key, Core::StringView wsId) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(support->context->Setting(key, wsId).View(), *doc);
		return read.Ok() && read.root.Kind() == Serialization::DomKind::String ? Core::String(read.root.AsView()) : Core::String("");
	}

	static Core::String Environment(const char* name) {
		Core::String value;
		return Platform::TryGetEnvironmentVariable(name, value) ? value : Core::String("");
	}

	// The Nuke checkout IED runs Nuke from: the one nuke.command names, or the first on PATH.
	static Core::String NukeCheckout(Support* support, Core::StringView wsId) {
		Core::String command = StringSetting(support, Core::StringView("nuke.command"), wsId);
		Core::String named = CheckoutOfCommand(command.View());
		if (!named.IsEmpty()) return named;
		for (const Core::String& candidate : CommandCandidates(command.IsEmpty() ? Core::StringView("nuke") : command.View(), Environment("PATH").View()))
			if (FS::FileExists(candidate.CStr())) return Core::String(FS::Path(candidate.View()).Parent().Parent().Normalized().View());
		return Core::String("");
	}

	// <store>/c4 of Nuke's toolchain store (Nuke/nuke/toolchains.py): NUKE_TOOLCHAINS, else the checkout's toolchains.
	static Core::String StoreFolder(Support* support, Core::StringView wsId) {
		Core::String root = Environment(kStoreVariable);
		if (root.IsEmpty()) {
			Core::String checkout = NukeCheckout(support, wsId);
			if (checkout.IsEmpty()) return Core::String("");
			root = Core::String((FS::Path(checkout.View()) / "toolchains").View());
		}
		FS::Path store = FS::Path(root.View()) / "c4";
		return FS::IsDirectory(store.CStr()) ? Core::String(store.Normalized().View()) : Core::String("");
	}

	static Core::Array<Core::String> InstalledVersions(Core::StringView store) {
		Core::Array<Core::String> versions;
		if (store.IsEmpty()) return versions;
		FS::Directory listing = FS::Directory(Core::String(store).CStr());
		for (FS::DirectoryEntry& entry : listing)
			if (entry.kind == FS::EntryKind::Directory && FS::FileExists((FS::Path(store) / entry.name.View() / "C4.exe").CStr())) versions.Push(Core::String(entry.name.View()));
		return versions;
	}

	static ToolchainQuery Query(Support* support, const IED::Workspace& ws) {
		ToolchainQuery query;
		query.setting = StringSetting(support, Core::StringView("c4.toolchain"), ws.id.View());
		Core::String manifest;
		Core::String problem;
		if (IED::ReadFile(ws, Core::StringView("nuke.toml"), manifest, problem)) query.pin = WorkspaceToolchain(manifest.View());
		query.root = ws.root;
		query.store = StoreFolder(support, ws.id.View());
		query.installed = InstalledVersions(query.store.View());
		return query;
	}

	// --- What it gives -------------------------------------------------------------------------------------------------

	static Serialization::DomNode Template(Support* support, const char* point) {
		if (!support->contributions) {
			support->contributions = new Serialization::DomDoc();
			Core::String text = TextOf(FS::Path(support->context->Folder().View()) / kTemplateFile);
			Serialization::ReadResult read = Serialization::ReadJsonc(text.View(), *support->contributions);
			if (read.Ok()) support->entries = read.root;
			else support->context->Log((Core::String(kTemplateFile) + " does not read as JSON: the language server and the debugger are not set up").View());
		}
		return support->entries.Member(point);
	}

	static Core::String TemplateEntries(Support* support, const char* point) {
		Serialization::DomNode entries = Template(support, point);
		return entries.IsValid() ? IED::NodeJson(entries) : Core::String("[]");
	}

	// A point's entries for a workspace whose toolchain is `choice`: none when no toolchain was found.
	static Core::String Entries(Support* support, const char* point, const ToolchainChoice& choice) {
		if (choice.folder.IsEmpty()) return Core::String("[]");
		return WithToolchain(TemplateEntries(support, point).View(), choice.folder.View());
	}

	// The reference docs of the toolchain `choice` names: its own copy's (<toolchain>/ied/docs), where that copy has them.
	static Core::String DocsEntries(Support* support, const ToolchainChoice& choice) {
		Serialization::DomNode docs = Template(support, kDocsPoint);
		IED::JsonWriter json;
		json.BeginArray();
		for (int64 i = 0; !choice.folder.IsEmpty() && i < docs.Count(); ++i) {
			FS::Path folder = (FS::Path(choice.folder.View()) / kCopyFolder / docs.At(i).Member("folder").AsView()).Normalized();
			if (!FS::IsDirectory(folder.CStr())) continue;
			json.BeginObject();
			json.Field("id", docs.At(i).Member("id").AsView());
			json.Field("title", docs.At(i).Member("title").AsView());
			json.Field("folder", folder.View());
			json.EndObject();
		}
		json.EndArray();
		return json.ToString();
	}

	static void Give(Support* support, const IED::Workspace& ws, Core::StringView point, const Core::String& entries) {
		Core::String key = (ws.id + " ") + point;
		Core::String before;
		if (support->given.TryGet(key, before) && before == entries) return;
		Core::String problem;
		if (!support->context->Contribute(point, ws.id.View(), entries.View(), problem)) support->context->Log(problem.View());
		support->given.At(key) = entries;
	}

	// The server log says which toolchain a workspace's C4 tools come from, or, where C4 is used, why none.
	static void Tell(Support* support, const IED::Workspace& ws, const ToolchainChoice& choice) {
		const bool usesC4 = ws.languages.Contains(Core::String("c4"));
		if (choice.folder.IsEmpty() && !usesC4) return;
		Core::String line = choice.folder.IsEmpty()
			? (ws.name + ": no C4 toolchain for the language server and the debugger: ") + choice.reason.View()
			: ((((ws.name + ": C4 toolchain ") + choice.folder.View()) + " (") + choice.reason.View()) + ")";
		Core::String before;
		if (support->told.TryGet(ws.id, before) && before == line) return;
		support->told.At(ws.id) = line;
		support->context->Log(line.View());
	}

	static void Refresh(Support* support, const IED::Workspace& ws) {
		ToolchainChoice choice = ChooseToolchain(Query(support, ws));
		Tell(support, ws, choice);
		for (int64 i = 0; i < 2; ++i) Give(support, ws, Core::StringView(kPoints[i]), Entries(support, kPoints[i], choice));
		Give(support, ws, Core::StringView(kDocsPoint), DocsEntries(support, choice));
	}

	static void RefreshAll(Support* support) {
		for (const IED::Workspace& ws : IED::Workspaces()) Refresh(support, ws);
	}

	static void FilesChanged(Support* support, const IED::FileChanges& changes) {
		bool manifest = changes.overflowed;
		for (const IED::FileChange& change : changes.changes) manifest = manifest || change.path == "nuke.toml";
		IED::Workspace ws;
		if (manifest && IED::FindWorkspace(changes.wsId.View(), ws)) Refresh(support, ws);
	}

	void Activate(IED::PluginContext& context)
	{
		Support* support = new Support(&context);
		context.OnWorkspace([support](const IED::Workspace& ws) { Refresh(support, ws); });
		context.OnFilesChanged([support](const IED::FileChanges& changes) { FilesChanged(support, changes); });
		context.Listen(Core::StringView("settings.changed"), [support](const IED::Event& event) { RefreshAll(support); });
	}
}
