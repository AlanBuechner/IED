// What the browser tells (on the CDP reader's thread): pages navigating, loading, titled, logging, failing requests,
// painting frames, opening dialogs and crashing. Nothing here waits on the browser: what needs asking goes to the worker.

include "browser.ch"

namespace Browser
{
	static bool Is(const CdpEvent& event, const char* method) { return event.method.View() == method; }

	void Browsers::Event(const CdpEvent& event) {
		if (event.sessionId.IsEmpty() && Is(event, "Target.targetCreated")) {
			Opened(event);
			return;
		}
		if (event.sessionId.IsEmpty()) {
			Page* page = null;
			Core::StringView targetId = Is(event, "Target.targetInfoChanged") ? event.params.Member("targetInfo").Member("targetId").AsView()
				: event.params.Member("targetId").AsView();
			{
				Threading::LockGuard routes(frames);
				byTarget.TryGet(Core::String(targetId), page);
			}
			if (page == null) return;
			if (Is(event, "Target.targetInfoChanged")) {
				Core::String title = Core::String(event.params.Member("targetInfo").Member("title").AsView());
				Browsers* self = this;
				context->Atomically([self, page, title](IED::Events& events) {
					if (page->title.View() == title.View()) return;
					page->title = title;
					self->Changed(events, page);
				});
			}
			else if (Is(event, "Target.detachedFromTarget") || Is(event, "Target.targetDestroyed")) Unloaded(page);
			return;
		}
		Page* page = null;
		{
			Threading::LockGuard routes(frames);
			bySession.TryGet(event.sessionId, page);
		}
		if (page == null) return;
		if (Is(event, "Runtime.bindingCalled")) TitleReported(page, event);
		else if (event.method.View().StartsWith(Core::StringView("Page.screencastFrame"))) FrameEvent(page, event);
		else if (event.method.View().StartsWith(Core::StringView("Page.")) || event.method.View().StartsWith(Core::StringView("Inspector."))) PageEvent(page, event);
		else if (event.method.View().StartsWith(Core::StringView("Network."))) NetworkEvent(page, event);
		else ConsoleEvent(page, event);
	}

	void Browsers::FrameEvent(Page* page, const CdpEvent& event) {
		Core::StringBuilder ack;
		ack.Append("{\"sessionId\":");
		ack.AppendInt(event.params.Member("sessionId").AsInt());
		ack.AppendByte('}');
		engine.cdp->Send(event.sessionId.View(), Core::StringView("Page.screencastFrameAck"), ack.View());
		Serialization::DomNode metadata = event.params.Member("metadata");
		Threading::LockGuard guard(frames);
		page->frameSeq += 1;
		page->frameData = Core::String(event.params.Member("data").AsView());
		page->frameWidth = (int32)metadata.Member("deviceWidth").AsFloat();
		page->frameHeight = (int32)metadata.Member("deviceHeight").AsFloat();
		frameArrived.NotifyAll();
	}

	// A target a page of ours opened: adopted (on the worker, which may ask the browser) as a page of its own.
	void Browsers::Opened(const CdpEvent& event) {
		Serialization::DomNode info = event.params.Member("targetInfo");
		if (info.Member("type").AsView() != "page" || info.Member("openerId").AsView().IsEmpty()) return;
		Page* parent = null;
		Core::String targetId = Core::String(info.Member("targetId").AsView());
		{
			Threading::LockGuard routes(frames);
			if (byTarget.Contains(targetId)) return;
			byTarget.TryGet(Core::String(info.Member("openerId").AsView()), parent);
		}
		if (parent == null) return;
		Core::String url = Core::String(info.Member("url").AsView());
		Browsers* self = this;
		Later([self, parent, targetId, url]() { self->Adopt(parent, targetId.View(), url.View()); });
	}

	void Browsers::TitleReported(Page* page, const CdpEvent& event) {
		if (event.params.Member("name").AsView() != "__iedPageTitle") return;
		Core::String title = Core::String(event.params.Member("payload").AsView());
		if (title.IsEmpty()) return;
		Browsers* self = this;
		context->Atomically([self, page, title](IED::Events& events) {
			if (page->title.View() == title.View()) return;
			page->title = title;
			self->Changed(events, page);
		});
	}

	void Browsers::PageEvent(Page* page, const CdpEvent& event) {
		Browsers* self = this;
		Core::String targetId;
		{
			Threading::LockGuard routes(frames);
			targetId = page->targetId;
		}
		if (Is(event, "Page.frameNavigated")) {
			Serialization::DomNode frame = event.params.Member("frame");
			if (frame.Member("parentId").IsValid()) return;
			Core::String url = Core::String(frame.Member("url").AsView()) + frame.Member("urlFragment").AsView();
			{
				// A new document may have a new renderer, which the screencast does not follow: the next pull starts it.
				Threading::LockGuard guard(frames);
				page->screencasting = false;
				frameArrived.NotifyAll();
			}
			context->Atomically([self, page, url](IED::Events& events) {
				page->url = url;
				self->Changed(events, page);
			});
			Later([self, page]() { self->RefreshState(page); });
			Persist(page->wsId.View());
		}
		else if (Is(event, "Page.navigatedWithinDocument")) {
			if (event.params.Member("frameId").AsView() != targetId.View()) return;
			Core::String url = Core::String(event.params.Member("url").AsView());
			context->Atomically([self, page, url](IED::Events& events) {
				page->url = url;
				self->Changed(events, page);
			});
			Later([self, page]() { self->RefreshState(page); });
		}
		else if (Is(event, "Page.frameStartedLoading") || Is(event, "Page.frameStoppedLoading")) {
			if (event.params.Member("frameId").AsView() != targetId.View()) return;
			const bool loading = Is(event, "Page.frameStartedLoading");
			context->Atomically([self, page, loading](IED::Events& events) {
				if (page->loading == loading) return;
				page->loading = loading;
				self->Changed(events, page);
			});
		}
		else if (Is(event, "Page.loadEventFired") || Is(event, "Page.domContentEventFired")) {
			if (Is(event, "Page.loadEventFired")) {
				Threading::LockGuard guard(frames);
				page->loads += 1;
				frameArrived.NotifyAll();
			}
			Later([self, page]() { self->RefreshState(page); });
		}
		else if (Is(event, "Page.javascriptDialogOpening")) {
			// A dialog would stop the page until someone answered it; the browser answers, and the console says so.
			ConsoleEntry entry;
			entry.level = Core::String("warning");
			entry.text = Core::String(event.params.Member("type").AsView()) + " dialog, answered: " + event.params.Member("message").AsView();
			entry.time = clock_now_ns() / 1000000;
			context->Atomically([page, entry](IED::Events& events) {
				ConsoleEntry& added = page->AddConsole(entry);
				events.Publish(page->Topic().View(), "console", (Core::String("{\"entries\":[") + ConsoleJson(added).View() + "]}").View());
			});
			Core::String prompt = Core::String(event.params.Member("defaultPrompt").AsView());
			Later([self, page, prompt]() {
				self->Call(page, Core::StringView("Page.handleJavaScriptDialog"), (Core::String("{\"accept\":true,\"promptText\":") + JsonText(prompt.View()).View() + "}").View());
			});
		}
		else if (Is(event, "Inspector.targetCrashed")) {
			ConsoleEntry entry;
			entry.level = Core::String("error");
			entry.text = Core::String("the page crashed; it loads again when it is next shown");
			entry.time = clock_now_ns() / 1000000;
			context->Atomically([page, entry](IED::Events& events) {
				ConsoleEntry& added = page->AddConsole(entry);
				events.Publish(page->Topic().View(), "console", (Core::String("{\"entries\":[") + ConsoleJson(added).View() + "]}").View());
			});
			Unloaded(page);
			Later([self, targetId]() {
				if (self->engine.Running())
					self->engine.cdp->Call(Core::StringView(""), Core::StringView("Target.closeTarget"), (Core::String("{\"targetId\":") + JsonText(targetId.View()).View() + "}").View());
			});
		}
	}

	// A remote object as console text: a string as it is, anything else as its value's JSON or its description.
	static Core::String ArgumentText(const Serialization::DomNode& argument) {
		Serialization::DomNode value = argument.Member("value");
		if (value.Kind() == Serialization::DomKind::String) return Core::String(value.AsView());
		if (value.IsValid()) return IED::NodeJson(value);
		if (argument.Member("unserializableValue").IsValid()) return Core::String(argument.Member("unserializableValue").AsView());
		if (argument.Member("description").IsValid()) return Core::String(argument.Member("description").AsView());
		return Core::String(argument.Member("type").AsView());
	}

	static Core::String Level(Core::StringView kind) {
		if (kind == "warning" || kind == "warn") return Core::String("warning");
		if (kind == "error" || kind == "assert") return Core::String("error");
		if (kind == "debug" || kind == "verbose" || kind == "trace") return Core::String("debug");
		if (kind == "info") return Core::String("info");
		return Core::String("log");
	}

	void Browsers::ConsoleEvent(Page* page, const CdpEvent& event) {
		ConsoleEntry entry;
		entry.time = clock_now_ns() / 1000000;
		if (Is(event, "Runtime.consoleAPICalled")) {
			Core::StringView kind = event.params.Member("type").AsView();
			if (kind == "clear" || kind == "startGroup" || kind == "endGroup" || kind == "startGroupCollapsed") return;
			entry.level = Level(kind);
			Core::StringBuilder text;
			Serialization::DomNode arguments = event.params.Member("args");
			for (int64 i = 0; i < arguments.Count(); ++i) {
				if (i > 0) text.AppendByte(' ');
				text.Append(ArgumentText(arguments.At(i)).View());
			}
			entry.text = text.ToString();
			Serialization::DomNode top = event.params.Member("stackTrace").Member("callFrames").At(0);
			entry.url = Core::String(top.Member("url").AsView());
			entry.line = top.IsValid() ? top.Member("lineNumber").AsInt() + 1 : 0;
		}
		else if (Is(event, "Runtime.exceptionThrown")) {
			Serialization::DomNode details = event.params.Member("exceptionDetails");
			entry.level = Core::String("error");
			Serialization::DomNode description = details.Member("exception").Member("description");
			entry.text = Core::String(description.IsValid() ? description.AsView() : details.Member("text").AsView());
			entry.url = Core::String(details.Member("url").AsView());
			entry.line = details.Member("lineNumber").AsInt() + 1;
		}
		else if (Is(event, "Log.entryAdded")) {
			Serialization::DomNode logged = event.params.Member("entry");
			entry.level = Level(logged.Member("level").AsView());
			entry.text = Core::String(logged.Member("text").AsView());
			entry.url = Core::String(logged.Member("url").AsView());
			entry.line = logged.Member("lineNumber").IsValid() ? logged.Member("lineNumber").AsInt() + 1 : 0;
		}
		else return;
		context->Atomically([page, entry](IED::Events& events) {
			ConsoleEntry& added = page->AddConsole(entry);
			events.Publish(page->Topic().View(), "console", (Core::String("{\"entries\":[") + ConsoleJson(added).View() + "]}").View());
		});
	}

	void Browsers::NetworkEvent(Page* page, const CdpEvent& event) {
		Core::String requestId = Core::String(event.params.Member("requestId").AsView());
		if (Is(event, "Network.requestWillBeSent")) {
			Serialization::DomNode request = event.params.Member("request");
			if (request.Member("url").AsView().StartsWith(Core::StringView("data:"))) return;
			Core::String described = Core::String(request.Member("method").AsView()) + " " + request.Member("url").AsView();
			context->Atomically([page, requestId, described](IED::Events& events) { page->TrackRequest(requestId.View(), described.View()); });
			return;
		}
		NetworkEntry entry;
		entry.type = Core::String(event.params.Member("type").AsView());
		if (Is(event, "Network.responseReceived")) {
			Serialization::DomNode response = event.params.Member("response");
			entry.status = response.Member("status").AsInt();
			if (entry.status < 400) return;
			entry.url = Core::String(response.Member("url").AsView());
			entry.error = Core::String(response.Member("statusText").AsView());
		}
		else if (Is(event, "Network.loadingFailed")) {
			if (event.params.Member("canceled").AsBool()) return;
			entry.error = Core::String(event.params.Member("errorText").AsView());
		}
		else return;
		context->Atomically([page, entry, requestId](IED::Events& events) {
			NetworkEntry kept = entry;
			Core::String described;
			if (page->requests.TryGet(requestId, described)) {
				const int64 space = described.View().IndexOf(' ', 0);
				kept.method = Core::String(described.View().Substring(0, space));
				if (kept.url.IsEmpty()) kept.url = Core::String(described.View().Substring(space + 1, described.ByteLength() - space - 1));
			}
			if (kept.url.IsEmpty()) return;
			NetworkEntry& added = page->AddNetwork(kept);
			events.Publish(page->Topic().View(), "network", (Core::String("{\"entries\":[") + NetworkJson(added).View() + "]}").View());
		});
	}
}
