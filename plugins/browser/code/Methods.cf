// The browser.* protocol methods (docs/27 "Protocol"), each on its request's thread.

include "Browser.ch"
include "Actions.ch"

namespace Browser
{
	alias BrowserMethod = func<Core::String(Browsers* browsers, const IED::Params& params)>;

	static Core::String PageJson(Page* page) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("pageId", page->m_PageId.View());
		json.EndObject();
		return json.ToString();
	}

	static int32 ScaleParam(const IED::Params& params) {
		Serialization::DomNode scale = params.Field("scale");
		return scale.IsValid() ? (int32)(scale.AsFloat() * 100.0 + 0.5) : 100;
	}

	static Core::String OpenMethod(Browsers* browsers, const IED::Params& params) {
		Page* page = browsers->Open(params.Str("wsId").View(), params.Str("url", Core::StringView("about:blank")).View(), (int32)params.Int("width", 0),
			(int32)params.Int("height", 0), ScaleParam(params), Core::StringView("user"), Core::StringView(""));
		return PageJson(page);
	}

	static Core::String NavigateMethod(Browsers* browsers, const IED::Params& params) {
		browsers->Navigate(browsers->Find(params.Str("pageId").View()), params.Str("url").View());
		return Core::String("{}");
	}

	static Core::String BackMethod(Browsers* browsers, const IED::Params& params) {
		browsers->Back(browsers->Find(params.Str("pageId").View()), -1);
		return Core::String("{}");
	}

	static Core::String ForwardMethod(Browsers* browsers, const IED::Params& params) {
		browsers->Back(browsers->Find(params.Str("pageId").View()), 1);
		return Core::String("{}");
	}

	static Core::String ReloadMethod(Browsers* browsers, const IED::Params& params) {
		browsers->Reload(browsers->Find(params.Str("pageId").View()));
		return Core::String("{}");
	}

	static Core::String StopMethod(Browsers* browsers, const IED::Params& params) {
		browsers->StopLoading(browsers->Find(params.Str("pageId").View()));
		return Core::String("{}");
	}

	static Core::String ResizeMethod(Browsers* browsers, const IED::Params& params) {
		browsers->Resize(browsers->Find(params.Str("pageId").View()), (int32)params.Int("width"), (int32)params.Int("height"), ScaleParam(params));
		return Core::String("{}");
	}

	static Core::String InputMethod(Browsers* browsers, const IED::Params& params) {
		DispatchInput(browsers, browsers->Find(params.Str("pageId").View()), params.List("events"));
		return Core::String("{}");
	}

	static Core::String FrameMethod(Browsers* browsers, const IED::Params& params) {
		return browsers->Frame(browsers->Find(params.Str("pageId").View()), params.Int("after", 0));
	}

	// {closed}: false for a page an AI's chat opened, which only its tab left (Browsers::CloseByPerson); `force` closes
	// any page for good.
	static Core::String CloseMethod(Browsers* browsers, const IED::Params& params) {
		Page* page = browsers->Find(params.Str("pageId").View());
		bool closed = true;
		if (params.Bool("force", false)) browsers->Close(page);
		else closed = browsers->CloseByPerson(page);
		return Core::String(closed ? "{\"closed\":true}" : "{\"closed\":false}");
	}

	static Core::String PagesMethod(Browsers* browsers, const IED::Params& params) {
		IED::HostLock lock(*browsers->m_Context);
		return browsers->ListJson(params.Str("wsId").View());
	}

	static void Register(Browsers* browsers, const char* name, BrowserMethod method) {
		Core::String problem;
		if (!browsers->m_Context->Method(Core::StringView(name), [browsers, method](const IED::Request& request) -> Core::String { return method(browsers, request.m_Params); }, problem))
			browsers->m_Context->Log(problem.View());
	}

	void RegisterMethods(Browsers* browsers) {
		Register(browsers, "browser.open", OpenMethod);
		Register(browsers, "browser.navigate", NavigateMethod);
		Register(browsers, "browser.back", BackMethod);
		Register(browsers, "browser.forward", ForwardMethod);
		Register(browsers, "browser.reload", ReloadMethod);
		Register(browsers, "browser.stop", StopMethod);
		Register(browsers, "browser.resize", ResizeMethod);
		Register(browsers, "browser.input", InputMethod);
		Register(browsers, "browser.frame", FrameMethod);
		Register(browsers, "browser.close", CloseMethod);
		Register(browsers, "browser.pages", PagesMethod);
	}
}
