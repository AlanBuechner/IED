include "browser.ch"
include "store.ch"

namespace Browser
{
	Core::String BrowserTopic(Core::StringView wsId) { return Core::String("browser:") + wsId; }

	static IED::RpcError Unavailable(Core::StringView why) { return IED::RpcError(IED::ErrorCode::Unavailable, why); }

	void Browsers::Start() {
		Browsers* self = this;
		context->StartThread([self]() { self->WorkLoop(); });
	}

	void Browsers::Opened(const IED::Workspace& ws) {
		Browsers* self = this;
		Core::String wsId = ws.id;
		Core::Array<Page*> restored = LoadPages(ws);
		for (Page* page : restored) context->TopicFrom(page->Topic().View(), [page]() -> Core::String { return page->SnapshotJson(); });
		context->Atomically([self, restored](IED::Events& events) {
			for (Page* page : restored) self->pages.Push(page);
		});
		context->TopicFrom(BrowserTopic(wsId.View()).View(), [self, wsId]() -> Core::String { return self->ListJson(wsId.View()); });
	}

	Core::String Browsers::ListJson(Core::StringView wsId) const {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("pages"));
		json.BeginArray();
		for (Page* page : pages)
			if (page->wsId.View() == wsId) json.Raw(page->SummaryJson().View());
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Browsers::Changed(IED::Events& events, Page* page) {
		Core::String summary = page->SummaryJson();
		events.Publish(BrowserTopic(page->wsId.View()).View(), "page.changed", summary.View());
		events.Publish(page->Topic().View(), "changed", summary.View());
		TellChat(page, page->live);
	}

	// A server without the chat plugin refuses the call, which changes nothing.
	void Browsers::TellChat(Page* page, bool open) {
		if (page->chatId.IsEmpty()) return;
		Core::String title = open ? (page->title.IsEmpty() ? page->url : page->title) : Core::String();
		if (title.View() == page->toldChat.View()) return;
		page->toldChat = title;
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("chatId", page->chatId.View());
		args.Field("ref", (Core::String("browser:") + page->pageId.View()).View());
		if (open) args.Field("title", title.View());
		args.Field("kind", Core::StringView("page"));
		args.BoolField("open", open);
		args.EndObject();
		Core::String text = args.ToString();
		Later([text]() { IED::CallBinding(Core::StringView("chat.resource"), text.View()); });
	}

	Page* Browsers::Find(Core::StringView pageId) {
		IED::HostLock lock(*context);
		for (Page* page : pages)
			if (page->pageId.View() == pageId) return page;
		throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no page ") + pageId).View());
	}

	// --- The engine and its contexts --------------------------------------------------------------------------------

	static Core::String SettingText(IED::PluginContext* context, const char* key) {
		Core::String json = context->Setting(Core::StringView(key), Core::StringView(""));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(json.View(), *doc);
		return parsed.Ok() && parsed.root.Kind() == Serialization::DomKind::String ? Core::String(parsed.root.AsView()) : Core::String();
	}

	// Under `starting`.
	void Browsers::EnsureEngine() {
		if (engine.Running()) return;
		engine.Stop();
		contexts.Clear();
		FS::Path executable = FindBrowser(SettingText(context, "browser.executable").View());
		if (executable.IsEmpty()) throw Unavailable(Core::StringView("no browser to run pages in: install Microsoft Edge, or set browser.executable"));
		FS::Path profile = FS::Path(context->StateFolder().View()) / "profile";
		Core::String error;
		if (!engine.Start(executable, profile, error)) throw Unavailable(error.View());
		Browsers* self = this;
		CdpConnection* cdp = engine.cdp;
		context->StartThread([self, cdp]() {
			cdp->ReadLoop([self](const CdpEvent& event) { self->Event(event); }, [self](Core::StringView why) { self->EngineClosed(why); });
		});
		cdp->Call(Core::StringView(""), Core::StringView("Target.setDiscoverTargets"), Core::StringView("{\"discover\":true}"));
		context->Log((Core::String("the browser runs: ") + executable.View()).View());
	}

	// Under `starting`.
	Core::String Browsers::ContextFor(Core::StringView wsId) {
		Core::String known;
		if (contexts.TryGet(Core::String(wsId), known)) return known;
		CdpReply made = engine.cdp->Call(Core::StringView(""), Core::StringView("Target.createBrowserContext"), Core::StringView("{\"disposeOnDetach\":false}"));
		if (!made.ok) throw Unavailable((Core::String("the browser made no context for the workspace: ") + made.error.View()).View());
		Core::String id = Core::String(made.result.Member("browserContextId").AsView());
		contexts.Insert(Core::String(wsId), id);
		return id;
	}

	void Browsers::EngineClosed(Core::StringView why) {
		context->Log((Core::String("the browser stopped: ") + why).View());
		Core::Array<Page*> loaded;
		{
			IED::HostLock lock(*context);
			for (Page* page : pages)
				if (page->live) loaded.Push(page);
		}
		for (Page* page : loaded) Unloaded(page);
	}

	// --- Pages ------------------------------------------------------------------------------------------------------

	static bool StartsWithIgnoringCase(Core::StringView text, const char* prefix) {
		Core::StringView wanted = Core::StringView(prefix);
		return text.ByteLength() >= wanted.ByteLength() && Http::EqualsIgnoringCase(text.Substring(0, wanted.ByteLength()), wanted);
	}

	static bool LocalHost(Core::StringView host) {
		if (StartsWithIgnoringCase(host, "localhost") || host.StartsWith(Core::StringView("[::1]"))) return true;
		return host.ByteLength() > 0 && host.ByteAt(0) >= '0' && host.ByteAt(0) <= '9';
	}

	// "javascript:", "mailto:", ... - letters then a colon not followed by a digit ("localhost:3000" is a host and port).
	static bool HasScheme(Core::StringView url) {
		int64 i = 0;
		while (i < url.ByteLength() && ((url.ByteAt(i) >= 'a' && url.ByteAt(i) <= 'z') || (url.ByteAt(i) >= 'A' && url.ByteAt(i) <= 'Z'))) i += 1;
		if (i == 0 || i >= url.ByteLength() || url.ByteAt(i) != ':') return false;
		return i + 1 >= url.ByteLength() || url.ByteAt(i + 1) < '0' || url.ByteAt(i + 1) > '9';
	}

	Core::String Browsers::Allowed(Core::StringView wsId, Core::StringView typed) const {
		Core::StringView url = typed.Trimmed();
		if (url.IsEmpty() || url == "about:blank") return Core::String("about:blank");
		if (StartsWithIgnoringCase(url, "http://") || StartsWithIgnoringCase(url, "https://")) return Core::String(url);
		if (StartsWithIgnoringCase(url, "file:")) {
			IED::Workspace ws;
			Core::String relative;
			Core::String path = FilePath(url);
			if (IED::FindWorkspace(wsId, ws) && !path.IsEmpty() && IED::RelativeTo(ws.root.View(), path.View(), relative)) return Core::String(url);
			throw IED::RpcError(IED::ErrorCode::Forbidden, "only the workspace's own files open in the browser");
		}
		if (url.IndexOf(Core::StringView("://")) >= 0 || HasScheme(url))
			throw IED::RpcError(IED::ErrorCode::BadRequest, (Core::String("the browser opens http, https and the workspace's files, not ") + url).View());
		return (Core::String(LocalHost(url) ? "http://" : "https://") + url);
	}

	Page* Browsers::Open(Core::StringView wsId, Core::StringView url, int32 width, int32 height, int32 scalePercent, Core::StringView opener,
			Core::StringView chatId) {
		IED::Workspace ws;
		if (!IED::FindWorkspace(wsId, ws)) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no workspace ") + wsId).View());
		Page* page = new Page();
		page->pageId = NewPageId();
		page->wsId = Core::String(wsId);
		page->url = Allowed(wsId, url);
		page->opener = Core::String(opener);
		page->chatId = Core::String(chatId);
		page->width = width > 0 ? width : kDefaultPageWidth;
		page->height = height > 0 ? height : kDefaultPageHeight;
		page->scalePercent = scalePercent > 0 ? scalePercent : 100;
		Browsers* self = this;
		context->TopicFrom(page->Topic().View(), [page]() -> Core::String { return page->SnapshotJson(); });
		context->Atomically([self, page](IED::Events& events) {
			self->pages.Push(page);
			events.Publish(BrowserTopic(page->wsId.View()).View(), "page.added", page->SummaryJson().View());
		});
		Persist(wsId);
		Load(page);
		return page;
	}

	void Browsers::Load(Page* page) {
		Threading::LockGuard guard(starting);
		Core::String url;
		{
			IED::HostLock lock(*context);
			if (page->live) return;
			url = page->url;
		}
		EnsureEngine();
		Core::String browserContext = ContextFor(page->wsId.View());
		Core::StringBuilder params;
		params.Append("{\"url\":\"about:blank\",\"browserContextId\":");
		params.Append(JsonText(browserContext.View()).View());
		params.AppendByte('}');
		CdpReply created = engine.cdp->Call(Core::StringView(""), Core::StringView("Target.createTarget"), params.View());
		if (!created.ok) throw Unavailable((Core::String("the browser made no page: ") + created.error.View()).View());
		Attach(page, created.result.Member("targetId").AsView(), url.View());
	}

	// Under `starting`: the page on the target `targetId` - attached, its domains on, its title reported, its viewport
	// set - then at `navigateTo` unless that is "" or about:blank.
	void Browsers::Attach(Page* page, Core::StringView target, Core::StringView navigateTo) {
		Core::String targetId = Core::String(target);
		Core::String url = Core::String(navigateTo);
		CdpReply attached = engine.cdp->Call(Core::StringView(""), Core::StringView("Target.attachToTarget"),
			(Core::String("{\"flatten\":true,\"targetId\":") + JsonText(targetId.View()).View() + "}").View());
		if (!attached.ok) throw Unavailable((Core::String("the browser's page did not attach: ") + attached.error.View()).View());
		Core::String sessionId = Core::String(attached.result.Member("sessionId").AsView());
		{
			Threading::LockGuard routes(frames);
			bySession.At(sessionId) = page;
			byTarget.At(targetId) = page;
			page->lastUsedNs = clock_now_ns();
		}
		Browsers* self = this;
		context->Atomically([self, page, targetId, sessionId](IED::Events& events) {
			page->targetId = targetId;
			page->sessionId = sessionId;
			page->live = true;
			self->Changed(events, page);
		});
		Core::Array<Core::String> domains;
		domains.Push(Core::String("Page.enable"));
		domains.Push(Core::String("Runtime.enable"));
		domains.Push(Core::String("Network.enable"));
		domains.Push(Core::String("Log.enable"));
		domains.Push(Core::String("Inspector.enable"));
		for (const Core::String& domain : domains) engine.cdp->Call(sessionId.View(), domain.View(), Core::StringView(""));
		engine.cdp->Call(sessionId.View(), Core::StringView("Runtime.addBinding"), Core::StringView("{\"name\":\"__iedPageTitle\"}"));
		engine.cdp->Call(sessionId.View(), Core::StringView("Page.addScriptToEvaluateOnNewDocument"),
			(Core::String("{\"source\":") + JsonText(Core::StringView(kTitleReporter)).View() + "}").View());
		Viewport(page);
		if (!url.IsEmpty() && url.View() != "about:blank")
			engine.cdp->Call(sessionId.View(), Core::StringView("Page.navigate"), (Core::String("{\"url\":") + JsonText(url.View()).View() + "}").View());
	}

	// A page another page opened (a target="_blank" link, window.open): a page of its own in the same workspace, with
	// the opener's viewport and opener, told as added with its parent.
	void Browsers::Adopt(Page* parent, Core::StringView targetId, Core::StringView url) {
		Page* page = new Page();
		page->pageId = NewPageId();
		page->url = Core::String(url);
		{
			IED::HostLock lock(*context);
			page->wsId = parent->wsId;
			page->opener = parent->opener;
			page->chatId = parent->chatId;
			page->parent = parent->pageId;
			page->width = parent->width;
			page->height = parent->height;
			page->scalePercent = parent->scalePercent;
		}
		Browsers* self = this;
		context->TopicFrom(page->Topic().View(), [page]() -> Core::String { return page->SnapshotJson(); });
		context->Atomically([self, page](IED::Events& events) {
			self->pages.Push(page);
			events.Publish(BrowserTopic(page->wsId.View()).View(), "page.added", page->SummaryJson().View());
		});
		Persist(page->wsId.View());
		{
			Threading::LockGuard guard(starting);
			if (!engine.Running()) return;
			Attach(page, targetId, Core::StringView(""));
		}
		// It may have loaded before it was attached: its address and title are asked of it.
		RefreshState(page);
		Persist(page->wsId.View());
	}

	CdpReply Browsers::Call(Page* page, Core::StringView method, Core::StringView paramsJson) {
		{
			Threading::LockGuard guard(frames);
			page->lastUsedNs = clock_now_ns();
		}
		Core::String sessionId;
		{
			IED::HostLock lock(*context);
			sessionId = page->sessionId;
		}
		if (sessionId.IsEmpty() || !engine.Running()) throw Unavailable(Core::StringView("the page is not loaded"));
		CdpReply reply = engine.cdp->Call(sessionId.View(), method, paramsJson);
		if (!reply.ok) throw IED::RpcError(IED::ErrorCode::PluginError, (Core::String(method) + ": " + reply.error.View()).View());
		return reply;
	}

	void Browsers::Viewport(Page* page) {
		Core::StringBuilder params;
		{
			IED::HostLock lock(*context);
			params.Append("{\"mobile\":false,\"width\":");
			params.AppendInt(page->width);
			params.Append(",\"height\":");
			params.AppendInt(page->height);
			params.Append(",\"deviceScaleFactor\":");
			params.Append(ScaleText(page->scalePercent).View());
			params.AppendByte('}');
		}
		Call(page, Core::StringView("Emulation.setDeviceMetricsOverride"), params.View());
	}

	bool Browsers::Navigate(Page* page, Core::StringView url) {
		Core::String target = Allowed(page->wsId.View(), url);
		Load(page);
		CdpReply reply = Call(page, Core::StringView("Page.navigate"), (Core::String("{\"url\":") + JsonText(target.View()).View() + "}").View());
		Core::StringView failed = reply.result.Member("errorText").AsView();
		// A navigation within the document (only the #fragment differs) has no loader: no load event will come.
		const bool newDocument = failed.IsEmpty() && !reply.result.Member("loaderId").AsView().IsEmpty();
		if (!failed.IsEmpty()) {
			ConsoleEntry entry;
			entry.level = Core::String("error");
			entry.text = Core::String("navigation to ") + target.View() + " failed: " + failed;
			entry.url = target;
			entry.time = clock_now_ns() / 1000000;
			context->Atomically([page, entry](IED::Events& events) {
				ConsoleEntry& added = page->AddConsole(entry);
				events.Publish(page->Topic().View(), "console", (Core::String("{\"entries\":[") + ConsoleJson(added).View() + "]}").View());
			});
		}
		return newDocument;
	}

	void Browsers::Back(Page* page, int32 step) {
		Load(page);
		CdpReply history = Call(page, Core::StringView("Page.getNavigationHistory"), Core::StringView(""));
		const int64 index = history.result.Member("currentIndex").AsInt() + step;
		Serialization::DomNode entries = history.result.Member("entries");
		if (index < 0 || index >= entries.Count()) return;
		Core::StringBuilder params;
		params.Append("{\"entryId\":");
		params.AppendInt(entries.At(index).Member("id").AsInt());
		params.AppendByte('}');
		Call(page, Core::StringView("Page.navigateToHistoryEntry"), params.View());
	}

	void Browsers::Reload(Page* page) {
		bool wasLive = false;
		{
			IED::HostLock lock(*context);
			wasLive = page->live;
		}
		Load(page);
		if (wasLive) Call(page, Core::StringView("Page.reload"), Core::StringView(""));
	}

	void Browsers::StopLoading(Page* page) { Call(page, Core::StringView("Page.stopLoading"), Core::StringView("")); }

	void Browsers::Resize(Page* page, int32 width, int32 height, int32 scalePercent) {
		if (width < 200 || height < 150 || width > 8192 || height > 8192 || scalePercent < 50 || scalePercent > 400)
			throw IED::RpcError(IED::ErrorCode::BadRequest, "a viewport from 200x150 to 8192x8192 at a scale from 0.5 to 4");
		Browsers* self = this;
		context->Atomically([self, page, width, height, scalePercent](IED::Events& events) {
			page->width = width;
			page->height = height;
			page->scalePercent = scalePercent;
			self->Changed(events, page);
		});
		Persist(page->wsId.View());
		bool live = false;
		{
			IED::HostLock lock(*context);
			live = page->live;
		}
		if (!live) return;
		Viewport(page);
		// The screencast keeps the size it started with: stop it, and a waiting pull starts it again at the new size.
		bool screencasting = false;
		{
			Threading::LockGuard guard(frames);
			screencasting = page->screencasting;
		}
		if (screencasting) {
			try {
				Call(page, Core::StringView("Page.stopScreencast"), Core::StringView(""));
			}
			catch (IED::RpcError failed) {
			}
		}
		Threading::LockGuard guard(frames);
		page->screencasting = false;
		frameArrived.NotifyAll();
	}

	void Browsers::Close(Page* page) {
		Core::String targetId;
		{
			IED::HostLock lock(*context);
			targetId = page->targetId;
		}
		if (!targetId.IsEmpty() && engine.Running())
			engine.cdp->Call(Core::StringView(""), Core::StringView("Target.closeTarget"), (Core::String("{\"targetId\":") + JsonText(targetId.View()).View() + "}").View());
		{
			Threading::LockGuard routes(frames);
			bySession.Remove(page->sessionId);
			byTarget.Remove(page->targetId);
		}
		Browsers* self = this;
		context->Atomically([self, page](IED::Events& events) {
			Core::Array<Page*> kept;
			for (Page* other : self->pages)
				if (other != page) kept.Push(other);
			self->pages = kept;
			page->live = false;
			self->TellChat(page, false);
			events.Publish(page->Topic().View(), "closed", Core::StringView("{}"));
			events.Publish(BrowserTopic(page->wsId.View()).View(), "page.removed", (Core::String("{\"pageId\":") + JsonText(page->pageId.View()).View() + "}").View());
		});
		context->RemoveTopic(page->Topic().View());
		Persist(page->wsId.View());
	}

	bool Browsers::CloseByPerson(Page* page) {
		Core::String chatId;
		{
			IED::HostLock lock(*context);
			chatId = page->chatId;
		}
		if (chatId.IsEmpty() || !ChatRunning(chatId.View())) {
			Close(page);
			return true;
		}
		{
			IED::HostLock lock(*context);
			page->released = true;
			page->releasedNs = clock_now_ns();
		}
		Persist(page->wsId.View());
		return false;
	}

	bool Browsers::ChatRunning(Core::StringView chatId) {
		IED::Result state = IED::CallBinding(Core::StringView("chat.state"), (Core::String("{\"chatId\":") + JsonText(chatId).View() + "}").View());
		if (!state.Ok()) return false;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(state.json.View(), *doc);
		return parsed.Ok() && parsed.root.Member("running").IsValid() && parsed.root.Member("running").AsBool();
	}

	void Browsers::CloseReleasedPages() {
		Core::Array<Page*> released;
		Core::Array<Core::String> chats;
		{
			IED::HostLock lock(*context);
			for (Page* page : pages) {
				if (!page->released) continue;
				released.Push(page);
				chats.Push(page->chatId);
			}
		}
		for (int64 i = 0; i < released.Count(); ++i)
			if (!ChatRunning(chats[i].View())) Close(released[i]);
	}

	void Browsers::Unloaded(Page* page) {
		{
			Threading::LockGuard routes(frames);
			bySession.Remove(page->sessionId);
			byTarget.Remove(page->targetId);
			page->screencasting = false;
			frameArrived.NotifyAll();
		}
		Browsers* self = this;
		context->Atomically([self, page](IED::Events& events) {
			page->live = false;
			page->loading = false;
			page->sessionId = Core::String();
			page->targetId = Core::String();
			self->Changed(events, page);
		});
	}

	void Browsers::Acted(Page* page, Core::StringView actionJson) {
		Core::String action = Core::String(actionJson);
		context->Atomically([page, action](IED::Events& events) {
			page->lastAction = action;
			events.Publish(page->Topic().View(), "action", action.View());
		});
	}

	// --- Loads and frames -------------------------------------------------------------------------------------------

	int64 Browsers::Loads(Page* page) {
		Threading::LockGuard guard(frames);
		return page->loads;
	}

	bool Browsers::AwaitLoad(Page* page, int64 loadsBefore, int64 ns) {
		const int64 deadline = clock_now_ns() + ns;
		Threading::LockGuard guard(frames);
		while (page->loads <= loadsBefore) {
			const int64 left = deadline - clock_now_ns();
			if (left <= 0) return false;
			frameArrived.WaitFor(frames, left);
		}
		return true;
	}

	// Starts the page's screencast; false when the page cannot take it now (a navigation is swapping its renderer).
	bool Browsers::StartScreencast(Page* page) {
		Core::StringBuilder params;
		{
			IED::HostLock lock(*context);
			params.Append("{\"format\":\"jpeg\",\"quality\":80,\"everyNthFrame\":1,\"maxWidth\":");
			params.AppendInt(page->width * page->scalePercent / 100);
			params.Append(",\"maxHeight\":");
			params.AppendInt(page->height * page->scalePercent / 100);
			params.AppendByte('}');
		}
		try {
			Call(page, Core::StringView("Page.startScreencast"), params.View());
			return true;
		}
		catch (IED::RpcError failed) {
			return false;
		}
	}

	Core::String Browsers::Frame(Page* page, int64 after) {
		{
			IED::HostLock lock(*context);
			if (page->released && clock_now_ns() - page->releasedNs > kReleaseGraceNs) {
				page->released = false;
				Persist(page->wsId.View());
			}
		}
		Load(page);
		const int64 deadline = clock_now_ns() + kFrameWaitNs;
		for (;;) {
			bool start = false;
			{
				Threading::LockGuard guard(frames);
				page->lastPullNs = clock_now_ns();
				if (page->frameSeq > after || clock_now_ns() >= deadline) break;
				start = !page->screencasting;
				page->screencasting = true;
			}
			if (start && !StartScreencast(page)) {
				{
					Threading::LockGuard guard(frames);
					page->screencasting = false;
				}
				Threading::Thread::Sleep(kScreencastRetryNs);
				continue;
			}
			// Until a frame comes, the time is up, or a navigation stops the screencast (then it starts again).
			Threading::LockGuard guard(frames);
			while (page->frameSeq <= after && page->screencasting) {
				const int64 left = deadline - clock_now_ns();
				if (left <= 0) break;
				frameArrived.WaitFor(frames, left);
			}
		}
		Threading::LockGuard guard(frames);
		IED::JsonWriter json;
		json.BeginObject();
		if (page->frameSeq <= after) json.IntField("seq", after);
		else {
			json.IntField("seq", page->frameSeq);
			json.Field("mime", "image/jpeg");
			json.Field("data", page->frameData.View());
			json.IntField("width", page->frameWidth);
			json.IntField("height", page->frameHeight);
		}
		json.EndObject();
		return json.ToString();
	}

	// --- The worker -------------------------------------------------------------------------------------------------

	void Browsers::Later(func<void()> job) {
		Threading::LockGuard guard(jobs);
		queue.Push(job);
		jobAdded.NotifyOne();
	}

	void Browsers::WorkLoop() {
		for (;;) {
			Core::Array<func<void()>> ready;
			{
				Threading::LockGuard guard(jobs);
				if (queue.IsEmpty()) jobAdded.WaitFor(jobs, kWorkerTickNs);
				ready = queue;
				queue.Clear();
			}
			for (func<void()> job : ready) {
				try {
					job();
				}
				catch (IED::RpcError failed) {
					context->Log(failed.message.View());
				}
			}
			StopIdleScreencasts();
			CloseReleasedPages();
			UnloadIdlePages();
		}
	}

	int64 Browsers::UnloadAfterNs() {
		Core::String json = context->Setting(Core::StringView("browser.unloadAfterSeconds"), Core::StringView(""));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(json.View(), *doc);
		const int64 seconds = parsed.Ok() && parsed.root.Kind() == Serialization::DomKind::Int ? parsed.root.AsInt() : kDefaultUnloadSeconds;
		return seconds * 1000000000;
	}

	void Browsers::UnloadIdlePages() {
		const int64 after = UnloadAfterNs();
		if (after <= 0) return;
		const int64 now = clock_now_ns();
		Core::Array<Page*> idle;
		bool anyLoaded = false;
		{
			Threading::LockGuard guard(frames);
			for (Core::KeyValue<Core::String, Page*>& entry : bySession) {
				Page* page = entry.value;
				const int64 last = page->lastPullNs > page->lastUsedNs ? page->lastPullNs : page->lastUsedNs;
				if (now - last > after) idle.Push(page);
				else anyLoaded = true;
			}
		}
		for (Page* page : idle) {
			Core::String targetId;
			{
				IED::HostLock lock(*context);
				targetId = page->targetId;
			}
			if (engine.Running() && !targetId.IsEmpty())
				engine.cdp->Call(Core::StringView(""), Core::StringView("Target.closeTarget"), (Core::String("{\"targetId\":") + JsonText(targetId.View()).View() + "}").View());
			Unloaded(page);
		}
		if (anyLoaded || !engine.Running()) {
			idleSinceNs = now;
			return;
		}
		if (idleSinceNs == 0) idleSinceNs = now;
		if (now - idleSinceNs <= after) return;
		idleSinceNs = 0;
		Threading::LockGuard guard(starting);
		engine.Stop();
		contexts.Clear();
		context->Log(Core::StringView("the browser stopped: no page was loaded for browser.unloadAfterSeconds"));
	}

	void Browsers::StopIdleScreencasts() {
		Core::Array<Page*> idle;
		{
			Threading::LockGuard guard(frames);
			const int64 now = clock_now_ns();
			for (Core::KeyValue<Core::String, Page*>& entry : bySession)
				if (entry.value->screencasting && now - entry.value->lastPullNs > kScreencastIdleNs) {
					entry.value->screencasting = false;
					idle.Push(entry.value);
				}
		}
		for (Page* page : idle) {
			try {
				Call(page, Core::StringView("Page.stopScreencast"), Core::StringView(""));
			}
			catch (IED::RpcError failed) {
			}
		}
	}

	void Browsers::RefreshState(Page* page) {
		CdpReply history = Call(page, Core::StringView("Page.getNavigationHistory"), Core::StringView(""));
		const int64 index = history.result.Member("currentIndex").AsInt();
		const int64 count = history.result.Member("entries").Count();
		Core::String url = Core::String(history.result.Member("entries").At(index).Member("url").AsView());
		CdpReply titled = Call(page, Core::StringView("Runtime.evaluate"), Core::StringView("{\"expression\":\"document.title\",\"returnByValue\":true}"));
		Core::String title = Core::String(titled.result.Member("result").Member("value").AsView());
		Browsers* self = this;
		context->Atomically([self, page, index, count, title, url](IED::Events& events) {
			const bool back = index > 0;
			const bool forward = index + 1 < count;
			const bool named = !title.IsEmpty() && title.View() != page->title.View();
			const bool moved = !url.IsEmpty() && url.View() != page->url.View();
			if (back == page->canGoBack && forward == page->canGoForward && !named && !moved) return;
			page->canGoBack = back;
			page->canGoForward = forward;
			if (named) page->title = title;
			if (moved) page->url = url;
			self->Changed(events, page);
		});
	}

	void Browsers::Persist(Core::StringView wsId) {
		Browsers* self = this;
		Core::String id = Core::String(wsId);
		Later([self, id]() {
			IED::Workspace ws;
			if (!IED::FindWorkspace(id.View(), ws)) return;
			Core::String json;
			{
				IED::HostLock lock(*self->context);
				json = PagesJson(self->pages, id.View());
			}
			SavePages(ws, json.View());
		});
	}
}
