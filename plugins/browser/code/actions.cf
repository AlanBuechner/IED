include "actions.ch"
include "store.ch"

namespace Browser
{
	static IED::RpcError BadRequest(Core::StringView why) { return IED::RpcError(IED::ErrorCode::BadRequest, why); }

	static void Number(Core::StringBuilder& json, const char* key, double value) {
		json.Append(",\"");
		json.Append(key);
		json.Append("\":");
		json.AppendDouble(value, 2);
	}

	// --- A person's input -------------------------------------------------------------------------------------------

	static Core::String MouseParams(const Serialization::DomNode& event) {
		Core::StringView action = event.Member("action").AsView();
		const char* type = action == "down" ? "mousePressed" : action == "up" ? "mouseReleased" : action == "wheel" ? "mouseWheel" : "mouseMoved";
		if (action != "down" && action != "up" && action != "wheel" && action != "move") throw BadRequest(Core::StringView("a mouse event's action is down, up, move or wheel"));
		Core::StringBuilder json;
		json.Append("{\"type\":\"");
		json.Append(type);
		json.AppendByte('"');
		Number(json, "x", event.Member("x").AsFloat());
		Number(json, "y", event.Member("y").AsFloat());
		Core::StringView button = event.Member("button").AsView();
		json.Append(",\"button\":");
		json.Append(JsonText(button.IsEmpty() ? Core::StringView("none") : button).View());
		json.Append(",\"buttons\":");
		json.AppendInt(event.Member("buttons").AsInt());
		json.Append(",\"clickCount\":");
		json.AppendInt(event.Member("clickCount").AsInt());
		json.Append(",\"modifiers\":");
		json.AppendInt(event.Member("modifiers").AsInt());
		if (action == "wheel") {
			Number(json, "deltaX", event.Member("deltaX").AsFloat());
			Number(json, "deltaY", event.Member("deltaY").AsFloat());
		}
		json.AppendByte('}');
		return json.ToString();
	}

	static Core::String KeyParams(Core::StringView action, Core::StringView key, Core::StringView code, int64 keyCode, Core::StringView text, int64 modifiers) {
		if (action != "down" && action != "up") throw BadRequest(Core::StringView("a key event's action is down or up"));
		Core::StringBuilder json;
		json.Append("{\"type\":\"");
		json.Append(action == "up" ? "keyUp" : text.IsEmpty() ? "rawKeyDown" : "keyDown");
		json.Append("\",\"key\":");
		json.Append(JsonText(key).View());
		json.Append(",\"code\":");
		json.Append(JsonText(code).View());
		json.Append(",\"windowsVirtualKeyCode\":");
		json.AppendInt(keyCode);
		json.Append(",\"nativeVirtualKeyCode\":");
		json.AppendInt(keyCode);
		json.Append(",\"modifiers\":");
		json.AppendInt(modifiers);
		if (action == "down" && !text.IsEmpty()) {
			json.Append(",\"text\":");
			json.Append(JsonText(text).View());
			json.Append(",\"unmodifiedText\":");
			json.Append(JsonText(text).View());
		}
		json.AppendByte('}');
		return json.ToString();
	}

	void DispatchInput(Browsers* browsers, Page* page, const Serialization::DomNode& events) {
		for (int64 i = 0; i < events.Count(); ++i) {
			Serialization::DomNode event = events.At(i);
			Core::StringView type = event.Member("type").AsView();
			if (type == "mouse") browsers->Call(page, Core::StringView("Input.dispatchMouseEvent"), MouseParams(event).View());
			else if (type == "key")
				browsers->Call(page, Core::StringView("Input.dispatchKeyEvent"), KeyParams(event.Member("action").AsView(), event.Member("key").AsView(),
					event.Member("code").AsView(), event.Member("keyCode").AsInt(), event.Member("text").AsView(), event.Member("modifiers").AsInt()).View());
			else if (type == "text")
				browsers->Call(page, Core::StringView("Input.insertText"), (Core::String("{\"text\":") + JsonText(event.Member("text").AsView()).View() + "}").View());
			else throw BadRequest(Core::StringView("an input event's type is mouse, key or text"));
		}
	}

	// --- Reading the page -------------------------------------------------------------------------------------------

	// The accessibility tree as lines: roles worth naming, with their names, states and a ref for each element.
	class AxPrinter
	{
		public Serialization::DomNode nodes;
		public Core::HashMap<Core::String, int64> byId;
		public Core::HashMap<Core::String, RefTarget> refs;
		public Core::StringBuilder out;
		public int64 made;
		public bool truncated;

		public void Print(int64 index, int32 depth, Core::StringView parentName);
	}

	static bool Quiet(Core::StringView role) {
		return role == "none" || role == "generic" || role == "presentation" || role == "InlineTextBox" || role == "LineBreak" || role == "ignored" ||
			role == "RootWebArea" || role == "WebArea" || role == "ListMarker";
	}

	static Core::String Property(const Serialization::DomNode& node, const char* name) {
		Serialization::DomNode properties = node.Member("properties");
		for (int64 i = 0; i < properties.Count(); ++i) {
			Serialization::DomNode property = properties.At(i);
			if (property.Member("name").AsView() != name) continue;
			Serialization::DomNode value = property.Member("value").Member("value");
			return value.Kind() == Serialization::DomKind::String ? Core::String(value.AsView()) : IED::NodeJson(value);
		}
		return Core::String();
	}

	// " [checked]", " [checked=mixed]", or nothing when the node is not in that state.
	static void AppendState(Core::StringBuilder& line, const Serialization::DomNode& node, const char* name) {
		Core::String state = Property(node, name);
		if (state.IsEmpty() || state.View() == "false") return;
		line.Append(" [");
		line.Append(name);
		if (state.View() != "true") {
			line.AppendByte('=');
			line.Append(state.View());
		}
		line.AppendByte(']');
	}

	void AxPrinter::Print(int64 index, int32 depth, Core::StringView parentName) {
		if (truncated) return;
		Serialization::DomNode node = nodes.At(index);
		Core::StringView role = node.Member("role").Member("value").AsView();
		Core::StringView name = node.Member("name").Member("value").AsView();
		const bool shown = !node.Member("ignored").AsBool() && !Quiet(role) && !(role == "StaticText" && (name.IsEmpty() || name == parentName));
		int32 childDepth = depth;
		if (shown) {
			Core::StringBuilder line;
			for (int32 i = 0; i < depth; ++i) line.Append("  ");
			line.Append("- ");
			line.Append(role == "StaticText" ? Core::StringView("text") : role);
			if (!name.IsEmpty()) {
				line.AppendByte(' ');
				line.Append(JsonText(name).View());
			}
			Core::StringView value = node.Member("value").Member("value").AsView();
			if (!value.IsEmpty()) {
				line.Append(": ");
				line.Append(JsonText(value).View());
			}
			AppendState(line, node, "checked");
			AppendState(line, node, "disabled");
			AppendState(line, node, "expanded");
			AppendState(line, node, "selected");
			AppendState(line, node, "focused");
			AppendState(line, node, "required");
			const int64 backend = node.Member("backendDOMNodeId").AsInt();
			if (backend > 0 && role != "StaticText") {
				made += 1;
				Core::StringBuilder ref;
				ref.AppendByte('e');
				ref.AppendInt(made);
				RefTarget target;
				target.backendNodeId = backend;
				target.label = name.IsEmpty() ? Core::String(role) : Core::String(role) + " " + JsonText(name).View();
				refs.At(ref.ToString()) = target;
				line.Append(" [ref=");
				line.Append(ref.View());
				line.AppendByte(']');
			}
			line.AppendByte('\n');
			if (out.View().ByteLength() + line.View().ByteLength() > kSnapshotBytes) {
				truncated = true;
				return;
			}
			out.Append(line.View());
			childDepth = depth + 1;
		}
		Serialization::DomNode children = node.Member("childIds");
		Core::StringView named = shown && !name.IsEmpty() ? name : parentName;
		for (int64 i = 0; i < children.Count(); ++i) {
			int64 child = -1;
			if (byId.TryGet(Core::String(children.At(i).AsView()), child)) Print(child, childDepth, named);
		}
	}

	static Core::String EvaluateText(Browsers* browsers, Page* page, const char* expression, int64 limit) {
		CdpReply reply = browsers->Call(page, Core::StringView("Runtime.evaluate"), (Core::String("{\"returnByValue\":true,\"expression\":") + JsonText(Core::StringView(expression)).View() + "}").View());
		Core::StringView text = reply.result.Member("result").Member("value").AsView();
		if (text.ByteLength() <= limit) return Core::String(text);
		const int64 whole = IED::WholeCharacters(text.Substring(0, limit));
		return Core::String(text.Substring(0, whole)) + "\n[cut here: the page goes on]";
	}

	Core::String Snapshot(Browsers* browsers, Page* page, Core::StringView mode) {
		if (mode == "text") return EvaluateText(browsers, page, "document.body ? document.body.innerText : ''", kSnapshotBytes);
		if (mode == "dom") return EvaluateText(browsers, page, "document.documentElement ? document.documentElement.outerHTML : ''", kHtmlBytes);
		if (mode != "a11y" && !mode.IsEmpty()) throw BadRequest(Core::StringView("a snapshot's mode is a11y, text or dom"));
		CdpReply tree = browsers->Call(page, Core::StringView("Accessibility.getFullAXTree"), Core::StringView(""));
		AxPrinter printer;
		printer.nodes = tree.result.Member("nodes");
		for (int64 i = 0; i < printer.nodes.Count(); ++i) printer.byId.At(Core::String(printer.nodes.At(i).Member("nodeId").AsView())) = i;
		if (printer.nodes.Count() > 0) printer.Print(0, 0, Core::StringView(""));
		{
			IED::HostLock lock(*browsers->context);
			page->refs = printer.refs;
		}
		if (printer.truncated) printer.out.Append("[the tree is cut here; act on what is above or read the page as text]\n");
		return printer.out.ToString();
	}

	Core::String Screenshot(Browsers* browsers, Page* page, const IED::Workspace& ws, bool fullPage, int64& width, int64& height) {
		Core::String params = Core::String("{\"format\":\"png\"}");
		{
			IED::HostLock lock(*browsers->context);
			width = page->width;
			height = page->height;
		}
		if (fullPage) {
			CdpReply metrics = browsers->Call(page, Core::StringView("Page.getLayoutMetrics"), Core::StringView(""));
			Serialization::DomNode size = metrics.result.Member("cssContentSize");
			width = (int64)size.Member("width").AsFloat();
			height = (int64)size.Member("height").AsFloat();
			if (height > 16384) height = 16384;
			Core::StringBuilder clipped;
			clipped.Append("{\"format\":\"png\",\"captureBeyondViewport\":true,\"clip\":{\"x\":0,\"y\":0,\"scale\":1,\"width\":");
			clipped.AppendInt(width);
			clipped.Append(",\"height\":");
			clipped.AppendInt(height);
			clipped.Append("}}");
			params = clipped.ToString();
		}
		CdpReply shot = browsers->Call(page, Core::StringView("Page.captureScreenshot"), params.View());
		Core::Array<uint8> png;
		if (!Core::Base64Decode(shot.result.Member("data").AsView(), png)) throw IED::RpcError(IED::ErrorCode::PluginError, "the browser's screenshot was not base64");
		FS::Path folder = BrowserFolder(ws) / "shots";
		FS::MakeDirectories(folder.CStr());
		Core::StringBuilder name;
		name.Append(page->pageId.View());
		name.AppendByte('-');
		name.AppendInt(clock_now_ns() / 1000000);
		name.Append(".png");
		if (!FS::WriteFileAtomically((folder / name.View()).CStr(), (const void*)png.Data(), png.Count()))
			throw IED::RpcError(IED::ErrorCode::Internal, "the screenshot could not be written");
		return Core::String(".ied/local/browser/shots/") + name.View();
	}

	// --- Acting -----------------------------------------------------------------------------------------------------

	// The element's backend node id, and in `label` how it reads; 0 when neither a ref nor a selector names one.
	static int64 ElementOf(Browsers* browsers, Page* page, Core::StringView ref, Core::StringView selector, Core::String& label) {
		if (!ref.IsEmpty()) {
			RefTarget target;
			bool known = false;
			{
				IED::HostLock lock(*browsers->context);
				known = page->refs.TryGet(Core::String(ref), target);
			}
			if (!known) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no element ") + ref + " in the page's last snapshot: take a new one").View());
			label = target.label;
			return target.backendNodeId;
		}
		if (selector.IsEmpty()) return 0;
		CdpReply found = browsers->Call(page, Core::StringView("Runtime.evaluate"), (Core::String("{\"expression\":") +
			JsonText((Core::String("document.querySelector(") + JsonText(selector).View() + ")").View()).View() + "}").View());
		Core::StringView objectId = found.result.Member("result").Member("objectId").AsView();
		if (objectId.IsEmpty()) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("nothing matches ") + selector).View());
		CdpReply described = browsers->Call(page, Core::StringView("DOM.describeNode"), (Core::String("{\"objectId\":") + JsonText(objectId).View() + "}").View());
		label = Core::String(described.result.Member("node").Member("localName").AsView()) + " " + JsonText(selector).View();
		return described.result.Member("node").Member("backendNodeId").AsInt();
	}

	class ElementBox
	{
		public double x;
		public double y;
		public double width;
		public double height;
	}

	static ElementBox BoxOf(Browsers* browsers, Page* page, int64 backend) {
		Core::StringBuilder node;
		node.Append("{\"backendNodeId\":");
		node.AppendInt(backend);
		node.AppendByte('}');
		browsers->Call(page, Core::StringView("DOM.scrollIntoViewIfNeeded"), node.View());
		CdpReply model = browsers->Call(page, Core::StringView("DOM.getBoxModel"), node.View());
		Serialization::DomNode quad = model.result.Member("model").Member("border");
		ElementBox box;
		double left = quad.At(0).AsFloat();
		double top = quad.At(1).AsFloat();
		double right = left;
		double bottom = top;
		for (int64 i = 0; i < 8; i += 2) {
			const double x = quad.At(i).AsFloat();
			const double y = quad.At(i + 1).AsFloat();
			if (x < left) left = x;
			if (x > right) right = x;
			if (y < top) top = y;
			if (y > bottom) bottom = y;
		}
		box.x = left;
		box.y = top;
		box.width = right - left;
		box.height = bottom - top;
		return box;
	}

	static void Mouse(Browsers* browsers, Page* page, const char* type, double x, double y, const char* button, int32 clicks) {
		Core::StringBuilder json;
		json.Append("{\"type\":\"");
		json.Append(type);
		json.Append("\",\"button\":\"");
		json.Append(button);
		json.Append("\",\"clickCount\":");
		json.AppendInt(clicks);
		json.Append(",\"buttons\":");
		json.AppendInt(clicks > 0 && Core::StringView(type) == "mousePressed" ? 1 : 0);
		Number(json, "x", x);
		Number(json, "y", y);
		json.AppendByte('}');
		browsers->Call(page, Core::StringView("Input.dispatchMouseEvent"), json.View());
	}

	// A key by its name as people write it ("Enter", "Tab", "ArrowDown", "a"): DOM key, code and Windows key code.
	static void PressKey(Browsers* browsers, Page* page, Core::StringView name) {
		Core::String key = Core::String(name);
		Core::String code = Core::String(name);
		int64 keyCode = 0;
		Core::String text;
		if (name == "Enter") { keyCode = 13; text = Core::String("\r"); }
		else if (name == "Tab") keyCode = 9;
		else if (name == "Escape") keyCode = 27;
		else if (name == "Backspace") keyCode = 8;
		else if (name == "Delete") keyCode = 46;
		else if (name == "Space" || name == " ") { key = Core::String(" "); code = Core::String("Space"); keyCode = 32; text = Core::String(" "); }
		else if (name == "ArrowLeft") keyCode = 37;
		else if (name == "ArrowUp") keyCode = 38;
		else if (name == "ArrowRight") keyCode = 39;
		else if (name == "ArrowDown") keyCode = 40;
		else if (name == "Home") keyCode = 36;
		else if (name == "End") keyCode = 35;
		else if (name == "PageUp") keyCode = 33;
		else if (name == "PageDown") keyCode = 34;
		else if (name.ByteLength() == 1) {
			const int32 c = name.ByteAt(0);
			text = Core::String(name);
			if (c >= 'a' && c <= 'z') {
				keyCode = c - 32;
				Core::StringBuilder upper;
				upper.Append("Key");
				upper.AppendByte((char8)(c - 32));
				code = upper.ToString();
			}
			else if (c >= 'A' && c <= 'Z') { keyCode = c; code = Core::String("Key") + name; }
			else if (c >= '0' && c <= '9') { keyCode = c; code = Core::String("Digit") + name; }
		}
		else throw BadRequest((Core::String("an unknown key: ") + name + " (Enter, Tab, Escape, Backspace, Delete, Space, arrows, Home, End, PageUp, PageDown or one character)").View());
		browsers->Call(page, Core::StringView("Input.dispatchKeyEvent"), KeyParams(Core::StringView("down"), key.View(), code.View(), keyCode, text.View(), 0).View());
		browsers->Call(page, Core::StringView("Input.dispatchKeyEvent"), KeyParams(Core::StringView("up"), key.View(), code.View(), keyCode, text.View(), 0).View());
	}

	static Core::String ActionJson(Core::StringView kind, Core::StringView label, bool placed, const ElementBox& box) {
		IED::JsonWriter json;
		json.BeginObject();
		json.IntField("seq", clock_now_ns() / 1000000);
		json.Field("by", "ai");
		json.Field("kind", kind);
		json.Field("label", label);
		if (placed) {
			json.IntField("x", (int64)(box.x + box.width / 2));
			json.IntField("y", (int64)(box.y + box.height / 2));
			Core::StringBuilder rect;
			rect.Append("{\"x\":");
			rect.AppendInt((int64)box.x);
			rect.Append(",\"y\":");
			rect.AppendInt((int64)box.y);
			rect.Append(",\"width\":");
			rect.AppendInt((int64)box.width);
			rect.Append(",\"height\":");
			rect.AppendInt((int64)box.height);
			rect.AppendByte('}');
			json.RawField("box", rect.View());
		}
		json.EndObject();
		return json.ToString();
	}

	Core::String Act(Browsers* browsers, Page* page, Core::StringView action, Core::StringView ref, Core::StringView selector, Core::StringView text) {
		if (action != "click" && action != "type" && action != "press" && action != "select" && action != "scroll" && action != "hover")
			throw BadRequest(Core::StringView("an action is click, type, press, select, scroll or hover"));
		Core::String label;
		const int64 backend = ElementOf(browsers, page, ref, selector, label);
		if (backend == 0 && action != "press" && action != "scroll") throw BadRequest((Core::String(action) + " needs an element: a ref from browser_snapshot, or a selector").View());
		ElementBox box;
		const bool placed = backend != 0;
		if (placed) box = BoxOf(browsers, page, backend);
		const double x = box.x + box.width / 2;
		const double y = box.y + box.height / 2;
		Core::StringBuilder node;
		node.Append("{\"backendNodeId\":");
		node.AppendInt(backend);
		node.AppendByte('}');
		Core::String done;
		if (action == "click") {
			Mouse(browsers, page, "mouseMoved", x, y, "none", 0);
			Mouse(browsers, page, "mousePressed", x, y, "left", 1);
			Mouse(browsers, page, "mouseReleased", x, y, "left", 1);
			done = Core::String("clicked ") + label.View();
		}
		else if (action == "hover") {
			Mouse(browsers, page, "mouseMoved", x, y, "none", 0);
			done = Core::String("hovered over ") + label.View();
		}
		else if (action == "type") {
			browsers->Call(page, Core::StringView("DOM.focus"), node.View());
			browsers->Call(page, Core::StringView("Input.insertText"), (Core::String("{\"text\":") + JsonText(text).View() + "}").View());
			done = Core::String("typed ") + JsonText(text).View() + " into " + label.View();
		}
		else if (action == "press") {
			if (placed) browsers->Call(page, Core::StringView("DOM.focus"), node.View());
			PressKey(browsers, page, text);
			done = Core::String("pressed ") + text;
			if (placed) done = done + " in " + label.View();
		}
		else if (action == "select") {
			CdpReply resolved = browsers->Call(page, Core::StringView("DOM.resolveNode"), node.View());
			Core::StringView objectId = resolved.result.Member("object").Member("objectId").AsView();
			Core::StringBuilder call;
			call.Append("{\"objectId\":");
			call.Append(JsonText(objectId).View());
			call.Append(",\"functionDeclaration\":\"function(v){this.value=v;this.dispatchEvent(new Event('input',{bubbles:true}));this.dispatchEvent(new Event('change',{bubbles:true}));return this.value;}\",\"arguments\":[{\"value\":");
			call.Append(JsonText(text).View());
			call.Append("}],\"returnByValue\":true}");
			browsers->Call(page, Core::StringView("Runtime.callFunctionOn"), call.View());
			done = Core::String("selected ") + JsonText(text).View() + " in " + label.View();
		}
		else {
			if (!placed) {
				double delta = text == "up" ? -600.0 : 600.0;
				int64 amount = 0;
				if (Core::ParseInt64(text, amount)) delta = (double)amount;
				int32 width = 0;
				int32 height = 0;
				{
					IED::HostLock lock(*browsers->context);
					width = page->width;
					height = page->height;
				}
				Core::StringBuilder wheel;
				wheel.Append("{\"type\":\"mouseWheel\",\"deltaX\":0");
				Number(wheel, "x", (double)(width / 2));
				Number(wheel, "y", (double)(height / 2));
				Number(wheel, "deltaY", delta);
				wheel.AppendByte('}');
				browsers->Call(page, Core::StringView("Input.dispatchMouseEvent"), wheel.View());
				done = Core::String("scrolled the page ") + (delta < 0 ? "up" : "down");
			}
			else done = Core::String("scrolled to ") + label.View();
		}
		browsers->Acted(page, ActionJson(action, (Core::String(action) + " " + label.View()).View(), placed, box).View());
		return done;
	}

	Core::String Evaluate(Browsers* browsers, Page* page, Core::StringView script, bool& failed) {
		CdpReply reply = browsers->Call(page, Core::StringView("Runtime.evaluate"), (Core::String("{\"returnByValue\":true,\"awaitPromise\":true,\"userGesture\":true,\"timeout\":10000,\"expression\":") +
			JsonText(script).View() + "}").View());
		Serialization::DomNode exception = reply.result.Member("exceptionDetails");
		failed = exception.IsValid();
		Core::String text;
		if (failed) {
			Serialization::DomNode description = exception.Member("exception").Member("description");
			text = Core::String(description.IsValid() ? description.AsView() : exception.Member("text").AsView());
		}
		else {
			Serialization::DomNode result = reply.result.Member("result");
			if (result.Member("value").IsValid()) text = IED::NodeJson(result.Member("value"));
			else if (result.Member("description").IsValid()) text = Core::String(result.Member("description").AsView());
			else text = Core::String(result.Member("type").AsView());
		}
		if (text.ByteLength() > kEvalBytes) text = Core::String(text.View().Substring(0, IED::WholeCharacters(text.View().Substring(0, kEvalBytes)))) + " [cut]";
		return text;
	}

	Core::String Described(Browsers* browsers, Page* page) {
		IED::HostLock lock(*browsers->context);
		Core::StringBuilder line;
		line.Append(page->pageId.View());
		line.Append(": ");
		line.Append(page->title.IsEmpty() ? Core::StringView("(untitled)") : page->title.View());
		line.Append(" - ");
		line.Append(page->url.View());
		if (page->loading) line.Append(" (loading)");
		return line.ToString();
	}

	Core::String ConsoleLines(Browsers* browsers, Page* page, int64 since, bool network, int64& last) {
		IED::HostLock lock(*browsers->context);
		Core::StringBuilder lines;
		last = since;
		if (!network) {
			for (const ConsoleEntry& entry : page->console) {
				if (entry.seq <= since) continue;
				last = entry.seq;
				lines.AppendByte('[');
				lines.AppendInt(entry.seq);
				lines.Append("] ");
				lines.Append(entry.level.View());
				lines.Append(": ");
				lines.Append(entry.text.View());
				if (!entry.url.IsEmpty()) {
					lines.Append(" (");
					lines.Append(entry.url.View());
					if (entry.line > 0) {
						lines.AppendByte(':');
						lines.AppendInt(entry.line);
					}
					lines.AppendByte(')');
				}
				lines.AppendByte('\n');
			}
			return lines.ToString();
		}
		for (const NetworkEntry& entry : page->network) {
			if (entry.seq <= since) continue;
			last = entry.seq;
			lines.AppendByte('[');
			lines.AppendInt(entry.seq);
			lines.Append("] ");
			lines.Append(entry.method.View());
			lines.AppendByte(' ');
			lines.Append(entry.url.View());
			lines.Append(" - ");
			if (entry.status > 0) {
				lines.AppendInt(entry.status);
				lines.AppendByte(' ');
			}
			lines.Append(entry.error.View());
			if (!entry.type.IsEmpty()) {
				lines.Append(" (");
				lines.Append(entry.type.View());
				lines.AppendByte(')');
			}
			lines.AppendByte('\n');
		}
		return lines.ToString();
	}
}
