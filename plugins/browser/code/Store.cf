include "Store.ch"

namespace Browser
{
	FS::Path BrowserFolder(const IED::Workspace& ws) { return FS::Path(IED::WorkspaceFile(ws, Core::StringView(".ied/local/browser")).View()); }

	Core::String PagesJson(const Core::Array<Page*>& pages, Core::StringView wsId) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("pages"));
		json.BeginArray();
		for (Page* page : pages) {
			if (page->m_WsId.View() != wsId) continue;
			json.BeginObject();
			json.Field("pageId", page->m_PageId.View());
			json.Field("url", page->m_Url.View());
			json.Field("title", page->m_Title.View());
			json.IntField("width", page->m_Width);
			json.IntField("height", page->m_Height);
			json.RawField("scale", ScaleText(page->m_ScalePercent).View());
			json.Field("opener", page->m_Opener.View());
			if (!page->m_ChatId.IsEmpty()) json.Field("chatId", page->m_ChatId.View());
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	static bool IsPageId(Core::StringView id) {
		if (!id.StartsWith(Core::StringView("pg-")) || id.ByteLength() < 4 || id.ByteLength() > 40) return false;
		for (int64 i = 3; i < id.ByteLength(); ++i) {
			const int32 c = id.ByteAt(i);
			if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
		}
		return true;
	}

	Core::Array<Page*> ParsePages(Core::StringView json, Core::StringView wsId) {
		Core::Array<Page*> pages;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult parsed = Serialization::ReadJson(json, *doc);
		if (!parsed.Ok()) return pages;
		Serialization::DomNode list = parsed.root.Member("pages");
		for (int64 i = 0; i < list.Count(); ++i) {
			Serialization::DomNode item = list.At(i);
			if (!IsPageId(item.Member("pageId").AsView())) continue;
			Page* page = new Page();
			page->m_PageId = Core::String(item.Member("pageId").AsView());
			page->m_WsId = Core::String(wsId);
			page->m_Url = Core::String(item.Member("url").AsView());
			page->m_Title = Core::String(item.Member("title").AsView());
			page->m_Width = (int32)item.Member("width").AsInt();
			page->m_Height = (int32)item.Member("height").AsInt();
			page->m_ScalePercent = (int32)(item.Member("scale").AsFloat() * 100.0 + 0.5);
			page->m_Opener = Core::String(item.Member("opener").AsView() == "ai" ? "ai" : "user");
			page->m_ChatId = Core::String(item.Member("chatId").AsView());
			if (page->m_Width < 200 || page->m_Height < 150) {
				page->m_Width = c_DefaultPageWidth;
				page->m_Height = c_DefaultPageHeight;
			}
			if (page->m_ScalePercent < 50 || page->m_ScalePercent > 400) page->m_ScalePercent = 100;
			pages.Push(page);
		}
		return pages;
	}

	Core::Array<Page*> LoadPages(const IED::Workspace& ws) {
		FS::Path file = BrowserFolder(ws) / "pages.json";
		if (!FS::FileExists(file.CStr())) return Core::Array<Page*>();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? ParsePages(opened.ReadText().View(), ws.m_Id.View()) : Core::Array<Page*>();
	}

	void SavePages(const IED::Workspace& ws, Core::StringView json) {
		FS::Path folder = BrowserFolder(ws);
		FS::MakeDirectories(folder.CStr());
		FS::WriteFileAtomically((folder / "pages.json").CStr(), (const void*)json.Data(), json.ByteLength());
	}

	static int32 HexDigit(int32 c) {
		if (c >= '0' && c <= '9') return c - '0';
		if (c >= 'a' && c <= 'f') return c - 'a' + 10;
		if (c >= 'A' && c <= 'F') return c - 'A' + 10;
		return -1;
	}

	Core::String FilePath(Core::StringView url) {
		if (url.ByteLength() < 6 || !Http::EqualsIgnoringCase(url.Substring(0, 5), Core::StringView("file:"))) return Core::String();
		Core::StringView rest = url.Substring(5, url.ByteLength() - 5);
		while (rest.StartsWith(Core::StringView("/"))) rest = rest.Substring(1, rest.ByteLength() - 1);
		Core::StringBuilder path;
		for (int64 i = 0; i < rest.ByteLength(); ++i) {
			const int32 c = rest.ByteAt(i);
			if (c == '?' || c == '#') break;
			if (c == '%' && i + 2 < rest.ByteLength() && HexDigit(rest.ByteAt(i + 1)) >= 0 && HexDigit(rest.ByteAt(i + 2)) >= 0) {
				path.AppendByte((char8)(HexDigit(rest.ByteAt(i + 1)) * 16 + HexDigit(rest.ByteAt(i + 2))));
				i += 2;
			}
			else path.AppendByte((char8)c);
		}
		Core::String text = path.ToString();
		// A drive ("C:/...") is the only kind of path a file: URL names here, and never one that climbs out of a folder.
		if (text.View().Contains(Core::StringView("/..")) || text.View().Contains(Core::StringView("\\.."))) return Core::String();
		return text.ByteLength() >= 3 && text.View().ByteAt(1) == ':' ? text : Core::String();
	}
}
