include "Engine.ch"

namespace Browser
{
	static FS::Path Under(const char* variable, const char* rest) {
		Core::String root;
		if (!Platform::TryGetEnvironmentVariable(variable, root) || root.IsEmpty()) return FS::Path();
		return FS::Path(root.View()) / rest;
	}

	FS::Path FindBrowser(Core::StringView configured) {
		if (!configured.IsEmpty()) {
			Core::String path = Core::String(configured);
			return FS::FileExists(path.CStr()) ? FS::Path(configured) : FS::Path();
		}
		Core::Array<FS::Path> candidates;
		candidates.Push(Under("ProgramFiles(x86)", "Microsoft/Edge/Application/msedge.exe"));
		candidates.Push(Under("ProgramFiles", "Microsoft/Edge/Application/msedge.exe"));
		candidates.Push(Under("LOCALAPPDATA", "Microsoft/Edge/Application/msedge.exe"));
		candidates.Push(Under("ProgramFiles", "Google/Chrome/Application/chrome.exe"));
		candidates.Push(Under("ProgramFiles(x86)", "Google/Chrome/Application/chrome.exe"));
		candidates.Push(Under("LOCALAPPDATA", "Google/Chrome/Application/chrome.exe"));
		for (const FS::Path& candidate : candidates)
			if (!candidate.IsEmpty() && FS::FileExists(candidate.CStr())) return candidate;
		return FS::Path();
	}

	Core::Array<Core::String> BrowserArguments(Core::StringView profile) {
		Core::Array<Core::String> arguments;
		arguments.Push(Core::String("--headless=new"));
		arguments.Push(Core::String("--remote-debugging-port=0"));
		arguments.Push(Core::String("--remote-debugging-address=127.0.0.1"));
		arguments.Push(Core::String("--user-data-dir=") + profile);
		arguments.Push(Core::String("--no-first-run"));
		arguments.Push(Core::String("--no-default-browser-check"));
		arguments.Push(Core::String("--disable-extensions"));
		arguments.Push(Core::String("--disable-sync"));
		arguments.Push(Core::String("--disable-background-networking"));
		arguments.Push(Core::String("--mute-audio"));
		arguments.Push(Core::String("about:blank"));
		return arguments;
	}

	Core::String EndpointFromActivePort(Core::StringView text) {
		const int64 newline = text.IndexOf('\n', 0);
		if (newline <= 0) return Core::String();
		int64 port = 0;
		if (!Core::ParseInt64(text.Substring(0, newline).Trimmed(), port) || port < 1 || port > 65535) return Core::String();
		Core::StringView path = text.Substring(newline + 1, text.ByteLength() - newline - 1).Trimmed();
		if (!path.StartsWith(Core::StringView("/devtools/browser/"))) return Core::String();
		Core::StringBuilder url;
		url.Append("ws://127.0.0.1:");
		url.AppendInt(port);
		url.Append(path);
		return url.ToString();
	}

	static Core::String ReadText(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.IsOpen() ? opened.ReadText() : Core::String();
	}

	Core::String EndProfileHoldersScript(Core::StringView profile) {
		Core::StringBuilder quoted;
		for (int64 i = 0; i < profile.ByteLength(); ++i) {
			if (profile.ByteAt(i) == '\'') quoted.AppendByte('\'');
			quoted.AppendByte(profile.ByteAt(i));
		}
		return (Core::String("$p = '") + quoted.View()) + "'; Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -ne $PID -and $_.CommandLine -and ($_.CommandLine.Replace('\\', '/')).Contains($p.Replace('\\', '/')) } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }";
	}

	static bool Answers(Core::StringView endpoint) {
		CdpConnection probe;
		Core::String error;
		if (!probe.Connect(endpoint, error)) return false;
		probe.Close();
		return true;
	}

	// A browser still on `profile` whose DevToolsActivePort names its port is asked to close; waits until its port no
	// longer answers and its lockfile is gone.
	static void CloseHeld(const FS::Path& profile) {
		Core::String endpoint = EndpointFromActivePort(ReadText(profile / "DevToolsActivePort").View());
		if (endpoint.IsEmpty() || !Answers(endpoint.View())) return;
		CdpConnection held;
		Core::String error;
		if (!held.Connect(endpoint.View(), error)) return;
		held.Send(Core::StringView(""), Core::StringView("Browser.close"), Core::StringView(""));
		held.Close();
		const int64 deadline = clock_now_ns() + c_EngineCloseHeldNs;
		FS::Path lockfile = profile / "lockfile";
		while (clock_now_ns() < deadline && (Answers(endpoint.View()) || (FS::FileExists(lockfile.CStr()) && !FS::RemoveFile(lockfile.CStr()))))
			Threading::Thread::Sleep(200000000);
	}

	// Every process whose command line names `profile` ended; the last resort.
	static void EndHolders(const FS::Path& profile) {
		Process::StartInfo info;
		info.program = Core::String("powershell.exe");
		info.arguments.Push(Core::String("-NoProfile"));
		info.arguments.Push(Core::String("-NonInteractive"));
		info.arguments.Push(Core::String("-Command"));
		info.arguments.Push(EndProfileHoldersScript(profile.View()));
		Process::Run(info, 30000);
		Threading::Thread::Sleep(500000000);
	}

	bool Engine::Start(const FS::Path& executable, const FS::Path& profile, Core::String& error) {
		FS::MakeDirectories(profile.CStr());
		CloseHeld(profile);
		if (Launch(executable, profile, error)) return true;
		if (!error.View().StartsWith(Core::StringView("the browser exited as it started"))) return false;
		EndHolders(profile);
		return Launch(executable, profile, error);
	}

	// One start: a process that exits before the port is open may have handed off to another (an update, a launcher),
	// whose port is still awaited a while.
	bool Engine::Launch(const FS::Path& executable, const FS::Path& profile, Core::String& error) {
		FS::Path activePort = profile / "DevToolsActivePort";
		FS::RemoveFile(activePort.CStr());
		Process::StartInfo info;
		info.program = Core::String(executable.View());
		info.arguments = BrowserArguments(profile.View());
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			error = Core::String("the browser did not start: ") + started.Error();
			return false;
		}
		m_Process = new Process::Child(take(started));
		const int64 deadline = clock_now_ns() + c_EngineStartNs;
		int64 exitedAt = 0;
		Core::String endpoint;
		while (clock_now_ns() < deadline) {
			endpoint = EndpointFromActivePort(ReadText(activePort).View());
			if (!endpoint.IsEmpty()) break;
			if (exitedAt == 0 && m_Process->Wait(100) != Process::kTimedOut) exitedAt = clock_now_ns();
			if (exitedAt == 0) continue;
			if (clock_now_ns() - exitedAt > c_EngineHandOffNs) break;
			Threading::Thread::Sleep(100000000);
		}
		if (endpoint.IsEmpty()) {
			error = exitedAt != 0 ? (Core::String("the browser exited as it started (another program may hold its profile: ") + profile.View() + ")")
				: Core::String("the browser did not open its DevTools port");
			Stop();
			return false;
		}
		m_Cdp = new CdpConnection();
		if (!m_Cdp->Connect(endpoint.View(), error)) {
			Stop();
			return false;
		}
		return true;
	}

	void Engine::Stop() {
		if (m_Cdp != null) {
			m_Cdp->Send(Core::StringView(""), Core::StringView("Browser.close"), Core::StringView(""));
			m_Cdp->Close();
		}
		if (m_Process != null) {
			m_Process->Kill();
			m_Process->Close();
		}
		m_Cdp = null;
		m_Process = null;
	}
}
