// The ied.webfetch plugin's entry (runtime.entry "WebFetch::Activate"): the webfetch.fetch binding over one Fetcher,
// and the web_fetch tool that calls it.

include "pages.ch"

namespace WebFetch
{
	void Activate(IED::PluginContext& context) {
		Fetcher* fetcher = new Fetcher(&context);
		context.Provide(Core::StringView("webfetch.fetch"), [fetcher](const Serialization::DomNode& args) -> IED::Result { return IED::Answer(fetcher->Fetch(args).View()); });
	}

	// web_fetch (docs/13 T-WEB-2): through the webfetch.fetch binding, which runs here at once.
	IED::ToolResult FetchTool(const IED::ToolCall& call) {
		IED::Result answer = IED::CallBinding(Core::StringView("webfetch.fetch"), IED::NodeJson(call.args).View());
		if (!answer.Ok()) return IED::ToolFailure(answer.error.View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode result = Serialization::ReadJson(answer.json.View(), *doc).root;
		Core::StringView text = result.Member("text").AsView();
		return result.Member("isError").AsBool() ? IED::ToolFailure(text) : IED::ToolText(text);
	}
}
