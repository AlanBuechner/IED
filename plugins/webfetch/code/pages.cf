include "pages.ch"
include "html.ch"
include "urls.ch"

namespace WebFetch
{
	const int64 kMinChars = 1000;
	const int64 kMostChars = 100000;
	const int64 kSniffBytes = 4096;

	static Core::String Slashes(Core::StringView path) {
		Core::StringBuilder text;
		for (int64 i = 0; i < path.ByteLength(); ++i) text.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return text.ToString();
	}

	static Core::String Lowercase(Core::StringView text) {
		Core::StringBuilder lower;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			lower.AppendByte(c >= 'A' && c <= 'Z' ? c + 32 : c);
		}
		return lower.ToString();
	}

	// "text/html; charset=UTF-8" -> "text/html".
	static Core::String MediaType(Core::StringView contentType) {
		const int64 semicolon = contentType.IndexOf(';', 0);
		return Lowercase((semicolon < 0 ? contentType : contentType.Substring(0, semicolon)).Trimmed());
	}

	PageKind KindOf(Core::StringView contentType, Core::StringView body) {
		Core::String media = MediaType(contentType);
		Core::StringView type = media.View();
		if (type == "text/html" || type == "application/xhtml+xml") return PageKind::Html;
		if (type.StartsWith(Core::StringView("text/")) || type.EndsWith(Core::StringView("+json")) || type.EndsWith(Core::StringView("+xml")) || type == "application/json"
			|| type == "application/xml" || type == "application/javascript" || type == "application/x-javascript" || type == "application/yaml"
			|| type == "application/x-yaml" || type == "application/toml" || type == "application/sql" || type == "application/x-sh")
			return PageKind::Text;
		if (!type.IsEmpty() && type != "application/octet-stream") return PageKind::Other;
		Core::StringView head = body.ByteLength() > kSniffBytes ? body.Substring(0, kSniffBytes) : body;
		Core::String lower = Lowercase(head.Trimmed());
		if (lower.View().StartsWith(Core::StringView("<!doctype html")) || lower.View().StartsWith(Core::StringView("<html"))) return PageKind::Html;
		if (head.IndexOf((char)0, 0) >= 0) return PageKind::Other;
		return type.IsEmpty() ? PageKind::Text : PageKind::Other;
	}

	// The charset a type or the start of a page names ("charset=windows-1252"), lowercase; "" for none.
	static Core::String CharsetIn(Core::StringView text) {
		Core::String lower = Lowercase(text);
		const int64 at = lower.View().IndexOf(Core::StringView("charset="));
		if (at < 0) return Core::String();
		int64 start = at + 8;
		while (start < lower.ByteLength() && (lower.View().ByteAt(start) == '"' || lower.View().ByteAt(start) == '\'')) start += 1;
		int64 end = start;
		while (end < lower.ByteLength()) {
			const int32 c = lower.View().ByteAt(end);
			if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) break;
			end += 1;
		}
		return Core::String(lower.View().Substring(start, end - start));
	}

	// Windows-1252's characters for 0x80-0x9F (0: none - kept as the C1 control).
	static int32 Cp1252High(int32 byte) {
		int32[32] table = { 0x20AC, 0, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017D, 0,
			0, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0, 0x017E, 0x0178 };
		const int32 code = table[byte - 0x80];
		return code == 0 ? byte : code;
	}

	Core::String AsUtf8(Core::StringView body, Core::StringView contentType) {
		Core::String charset = CharsetIn(contentType);
		if (charset.IsEmpty()) charset = CharsetIn(body.ByteLength() > kSniffBytes ? body.Substring(0, kSniffBytes) : body);
		Core::StringView name = charset.View();
		const bool latin = name == "iso-8859-1" || name == "latin1" || name == "windows-1252" || name == "cp1252" || name == "iso-8859-15";
		if (!latin && (!charset.IsEmpty() || body.IsValidUtf8())) return Core::String(body);
		Core::StringBuilder out;
		for (int64 i = 0; i < body.ByteLength(); ++i) {
			const int32 c = body.ByteAt(i);
			if (c < 0x80) out.AppendByte(c);
			else out.AppendCodePoint(c < 0xA0 ? Cp1252High(c) : c);
		}
		return out.ToString();
	}

	bool IsBotCheck(const FetchedPage& page) {
		Core::String title = Lowercase(page.title.View());
		Core::StringView t = title.View();
		return t.Contains(Core::StringView("just a moment")) || t.Contains(Core::StringView("attention required")) || t.Contains(Core::StringView("prove your humanity"))
			|| t.Contains(Core::StringView("are you a robot")) || t.Contains(Core::StringView("verify you are human")) || t.Contains(Core::StringView("captcha"))
			|| t.Contains(Core::StringView("ddos-guard")) || t.Contains(Core::StringView("security check"));
	}

	// The byte where character `index` of `text` starts (the end when it has fewer).
	static int64 ByteOfChar(Core::StringView text, int64 index) {
		int64 chars = 0;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			if ((text.ByteAt(i) & 0xC0) == 0x80) continue;
			if (chars == index) return i;
			chars += 1;
		}
		return text.ByteLength();
	}

	static void HeaderLine(Core::StringBuilder& text, const char* name, Core::StringView value) {
		if (value.IsEmpty()) return;
		text.Append(name);
		text.Append(": ");
		text.Append(value);
		text.Append("\n");
	}

	Core::String WindowText(const FetchedPage& page, int64 start, int64 count) {
		Core::StringBuilder text;
		HeaderLine(text, "URL", page.finalUrl.IsEmpty() ? page.url.View() : page.finalUrl.View());
		Core::StringBuilder status;
		status.AppendInt(page.status);
		HeaderLine(text, "Status", status.View());
		HeaderLine(text, "Type", page.contentType.View());
		HeaderLine(text, "Title", page.title.View());
		const int64 total = page.text.View().CharCount();
		text.Append("Length: ");
		text.AppendInt(total);
		text.Append(" characters");
		if (page.cut) text.Append(" (the page was cut short: it is larger than webfetch.maxBytes, or did not arrive whole)");
		text.Append("\n\n");
		if (total == 0) {
			text.Append(page.cut ? "Nothing arrived before the limit." : "The page has no text (it may be drawn by scripts: browser_open renders it).");
			text.Append("\n");
			return text.ToString();
		}
		if (start >= total) {
			text.Append("Nothing from start=");
			text.AppendInt(start);
			text.Append(": the text has ");
			text.AppendInt(total);
			text.Append(" characters.\n");
			return text.ToString();
		}
		const int64 end = start + count < total ? start + count : total;
		const int64 from = ByteOfChar(page.text.View(), start);
		const int64 to = ByteOfChar(page.text.View(), end);
		text.Append(page.text.View().Substring(from, to - from));
		if (end < total || start > 0) {
			text.Append("\n\n[Characters ");
			text.AppendInt(start);
			text.Append("-");
			text.AppendInt(end);
			text.Append(" of ");
			text.AppendInt(total);
			if (end < total) {
				text.Append(": web_fetch with start=");
				text.AppendInt(end);
				text.Append(" gives the next ones");
			}
			text.Append(".]");
		}
		text.Append("\n");
		return text.ToString();
	}

	// --- Fetcher ----------------------------------------------------------------------------------------------------

	static Serialization::DomNode SettingNode(IED::PluginContext* context, const char* key) {
		Core::String json = context->Setting(Core::StringView(key), Core::StringView(""));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json.View(), *doc).root;
	}

	static int64 SettingInt(IED::PluginContext* context, const char* key, int64 fallback) {
		Serialization::DomNode node = SettingNode(context, key);
		return node.Kind() == Serialization::DomKind::Int ? node.AsInt() : fallback;
	}

	static Core::String Reply(Core::StringView text, bool isError) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("text", text);
		json.BoolField("isError", isError);
		json.EndObject();
		return json.ToString();
	}

	FetchedPage* Fetcher::Kept(Core::StringView url, Core::StringView format) {
		const int64 now = clock_now_ns();
		for (int64 i = kept.Count() - 1; i >= 0; --i) {
			if (now - kept[i]->fetchedNs > kKeptNs) {
				kept.RemoveAt(i);
				continue;
			}
			if (kept[i]->url.View() == url && kept[i]->format.View() == format) return kept[i];
		}
		return null;
	}

	void Fetcher::Keep(FetchedPage* page) {
		kept.Push(page);
		if (kept.Count() > kKeptPages) kept.RemoveAt(0);
	}

	FetchedPage* Fetcher::Load(Core::StringView url, Core::StringView format, Core::String& error) {
		FetchedPage* known = Kept(url, format);
		if (known != null) return known;
		FetchOptions options;
		options.userAgent = Core::String(SettingNode(context, "webfetch.userAgent").AsView());
		options.seconds = SettingInt(context, "webfetch.timeoutSeconds", 30);
		options.maxBytes = SettingInt(context, "webfetch.maxBytes", 5242880);
		Core::StringView browser = SettingNode(context, "webfetch.impersonate").AsView();
		Core::String home = Slashes(IED::HomeFolder().View());
		Core::String python = home + "/vendor/python/python.exe";
		Core::String packages = home + "/vendor/searxng-packages";
		const bool impersonate = browser != "off" && FS::FileExists(python.CStr()) && FS::IsDirectory((packages + "/curl_cffi").CStr());
		Fetched fetched = impersonate
			? RunFetcher(python.View(), ImpersonatorArguments(url, (Slashes(context->Folder().View()) + "/service/fetch.py").View(), packages.View(),
				browser.IsEmpty() ? Core::StringView("chrome") : browser, options), options)
			: RunFetcher(CurlProgram(SettingNode(context, "webfetch.curl").AsView()).View(), CurlArguments(url, options), options);
		if (!fetched.error.IsEmpty() && fetched.status == 0) {
			error = (Core::String("web_fetch could not fetch ") + url + ": ") + fetched.error.View();
			return null;
		}
		const PageKind kind = KindOf(fetched.contentType.View(), fetched.body.View());
		if (kind == PageKind::Other) {
			Core::StringBuilder text;
			text.Append(url);
			text.Append(" is ");
			text.Append(fetched.contentType.IsEmpty() ? Core::StringView("binary") : fetched.contentType.View());
			text.Append(" (");
			text.AppendInt(fetched.body.ByteLength());
			text.Append(" bytes), not a page or text: web_fetch reads HTML and text (browser_open shows PDFs and images)");
			error = text.ToString();
			return null;
		}
		FetchedPage* page = new FetchedPage();
		page->url = Core::String(url);
		page->format = Core::String(format);
		page->status = fetched.status;
		page->contentType = fetched.contentType;
		page->finalUrl = fetched.finalUrl;
		page->cut = fetched.cut;
		page->bodyBytes = fetched.body.ByteLength();
		page->fetchedNs = clock_now_ns();
		Core::String body = AsUtf8(fetched.body.View(), fetched.contentType.View());
		if (kind == PageKind::Html && format != "raw") page->text = HtmlToText(body.View(), (page->finalUrl.IsEmpty() ? page->url : page->finalUrl).View(), format == "text", page->title);
		else page->text = body;
		Keep(page);
		return page;
	}

	Core::String Fetcher::Fetch(const Serialization::DomNode& args) {
		Core::String url = Core::String(args.Member("url").AsView().Trimmed());
		if (url.IsEmpty()) return Reply(Core::StringView("give the address to read: url"), true);
		Core::String scheme = SchemeOf(url.View());
		if (scheme.IsEmpty()) url = Core::String("https://") + url.View();
		else if (scheme.View() != "http" && scheme.View() != "https") return Reply((Core::String("web_fetch reads http and https addresses, not ") + scheme.View() + ":").View(), true);
		Core::StringView format = args.Member("format").AsView();
		if (format.IsEmpty()) format = Core::StringView("markdown");
		if (format != "markdown" && format != "text" && format != "raw") return Reply(Core::StringView("format is markdown, text or raw"), true);
		Serialization::DomNode startNode = args.Member("start");
		const int64 start = startNode.IsValid() && !startNode.IsNull() ? startNode.AsInt() : 0;
		if (start < 0) return Reply(Core::StringView("start is 0 or more: a character offset into the page's text"), true);
		Serialization::DomNode most = args.Member("max_chars");
		int64 count = most.IsValid() && !most.IsNull() ? most.AsInt() : SettingInt(context, "webfetch.maxChars", 20000);
		count = count < kMinChars ? kMinChars : count > kMostChars ? kMostChars : count;
		Core::String error;
		FetchedPage* page = Load(url.View(), format, error);
		if (page == null) return Reply(error.View(), true);
		if (IsBotCheck(*page)) {
			Core::StringBuilder text;
			text.Append(page->finalUrl.IsEmpty() ? page->url.View() : page->finalUrl.View());
			text.Append(" answered with a bot check instead of the page (status ");
			text.AppendInt(page->status);
			text.Append(", \"");
			text.Append(page->title.View());
			text.Append("\"). browser_open loads it in a real browser, which can pass it.");
			return Reply(text.View(), true);
		}
		const bool failed = page->status >= 400;
		return Reply(WindowText(*page, start, failed && count > kErrorChars ? kErrorChars : count).View(), failed);
	}
}
