include "writer.ch"

namespace WebFetch
{
	static bool IsBlank(int32 c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'; }

	void PageWriter::LinePrefix() {
		if (!plain)
			for (int32 i = 0; i < quoteDepth; ++i) out.Append("> ");
		if (listDepth <= 0) return;
		for (int32 i = 1; i < listDepth; ++i) out.Append("  ");
		if (itemMarker.IsEmpty()) out.Append("  ");
		else out.Append(itemMarker.View());
		itemMarker = Core::String();
	}

	// What is owed before the next text: the breaks, the line's prefix, a space, the held marks.
	void PageWriter::Flush() {
		if (breaks > 0 && out.ByteLength() > 0) {
			for (int32 i = 0; i < breaks; ++i) out.AppendByte('\n');
			lineStart = true;
		}
		breaks = 0;
		if (lineStart) {
			LinePrefix();
			lineStart = false;
			space = false;
		}
		if (space && out.ByteLength() > 0 && out.View().ByteAt(out.ByteLength() - 1) != ' ') out.AppendByte(' ');
		space = false;
		if (!marks.IsEmpty()) {
			out.Append(marks.View());
			marks.Clear();
		}
	}

	void PageWriter::Text(Core::StringView text) {
		int64 i = 0;
		const int64 n = text.ByteLength();
		if (preformatted) {
			if (n > 0 && (breaks > 0 || lineStart)) Flush();
			for (; i < n; ++i)
				if (text.ByteAt(i) != '\r') out.AppendByte(text.ByteAt(i));
			return;
		}
		while (i < n) {
			if (IsBlank(text.ByteAt(i))) {
				space = true;
				i += 1;
				continue;
			}
			Flush();
			const int64 start = i;
			while (i < n && !IsBlank(text.ByteAt(i))) i += 1;
			out.Append(text.Substring(start, i - start));
		}
	}

	void PageWriter::Open(Core::StringView mark) { marks.Append(mark); }

	bool PageWriter::Discard(Core::StringView mark) {
		if (!marks.View().EndsWith(mark)) return false;
		marks.Truncate(marks.ByteLength() - mark.ByteLength());
		return true;
	}

	void PageWriter::Close(Core::StringView mark) {
		if (!Discard(mark)) out.Append(mark);
	}

	void PageWriter::Inline(Core::StringView text) {
		Flush();
		out.Append(text);
	}

	void PageWriter::Break(int32 lines) {
		if (cellDepth > 0) {
			space = true;
			return;
		}
		if (breaks < lines) breaks = lines;
	}

	void PageWriter::Append(Core::StringView text) { out.Append(text); }

	bool PageWriter::EndsWithNewline() const {
		return out.ByteLength() > 0 && out.View().ByteAt(out.ByteLength() - 1) == '\n';
	}

	Core::String PageWriter::Finish() const {
		Core::StringBuilder text;
		Core::StringView all = out.View();
		int64 blankLines = 0;
		int64 at = 0;
		while (at < all.ByteLength()) {
			int64 end = all.IndexOf('\n', at);
			if (end < 0) end = all.ByteLength();
			int64 last = end;
			while (last > at && IsBlank(all.ByteAt(last - 1))) last -= 1;
			if (last == at) blankLines += 1;
			else {
				if (!text.IsEmpty()) text.Append(blankLines > 0 ? "\n\n" : "\n");
				text.Append(all.Substring(at, last - at));
				blankLines = 0;
			}
			at = end + 1;
		}
		return text.ToString();
	}
}
