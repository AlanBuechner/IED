// The Go plugin's server code (docs/26 section 2): the system-message section that names the workspace's Go modules -
// each go.mod's module path and Go version - so the AI writes import paths and language features that fit.
include "api/plugin.ch"

namespace Go
{
	// What a go.mod says.
	class Module
	{
		public Core::String folder;    // workspace-relative; "" for the root
		public Core::String path;      // `module`
		public Core::String version;   // `go`
	}

	// The rest of `line` after `key` and a space, without quotes; empty when it does not start so.
	Core::StringView Directive(Core::StringView line, Core::StringView key)
	{
		if (!line.StartsWith(key) || line.ByteLength() <= key.ByteLength() || line.ByteAt(key.ByteLength()) != ' ') return Core::StringView("");
		Core::StringView rest = line.Substring(key.ByteLength(), line.ByteLength() - key.ByteLength()).Trimmed();
		if (rest.ByteLength() >= 2 && rest.ByteAt(0) == '"' && rest.ByteAt(rest.ByteLength() - 1) == '"') return rest.Substring(1, rest.ByteLength() - 2);
		return rest;
	}

	bool ReadModule(const IED::Workspace& ws, Core::StringView folder, Module& module)
	{
		Core::String file = folder.IsEmpty() ? Core::String("go.mod") : Core::String(folder) + "/go.mod";
		Core::String text;
		Core::String problem;
		if (!IED::ReadFile(ws, file.View(), text, problem)) return false;
		module.folder = Core::String(folder);
		Core::StringView rest = text.View();
		while (!rest.IsEmpty()) {
			int64 end = rest.IndexOf('\n', 0);
			if (end < 0) end = rest.ByteLength();
			Core::StringView line = rest.Substring(0, end).Trimmed();
			rest = end < rest.ByteLength() ? rest.Substring(end + 1, rest.ByteLength() - end - 1) : Core::StringView("");
			if (module.path.IsEmpty()) module.path = Core::String(Directive(line, Core::StringView("module")));
			if (module.version.IsEmpty()) module.version = Core::String(Directive(line, Core::StringView("go")));
		}
		return !module.path.IsEmpty();
	}

	// The root, then each Go project's folder, once each.
	Core::Array<Core::String> ModuleFolders(const IED::Workspace& ws)
	{
		Core::Array<Core::String> folders;
		folders.Push(Core::String(""));
		for (const IED::Project& project : ws.projects)
			if (project.language.View() == "go" && !folders.Contains(project.folder)) folders.Push(project.folder);
		return folders;
	}

	Core::String Section(const IED::Workspace& ws)
	{
		Core::StringBuilder list;
		for (const Core::String& folder : ModuleFolders(ws)) {
			Module module;
			if (!ReadModule(ws, folder.View(), module)) continue;
			list.Append("- `");
			list.Append(module.path.View());
			list.Append("` in ");
			list.Append(module.folder.IsEmpty() ? Core::StringView("the root") : module.folder.View());
			if (!module.version.IsEmpty()) {
				list.Append(", go ");
				list.Append(module.version.View());
			}
			list.Append("\n");
		}
		if (list.ByteLength() == 0) return Core::String("");
		Core::StringBuilder out;
		out.Append("Go modules here (go.mod):\n");
		out.Append(list.View());
		out.Append("A package's import path is its module path and its folder under the module. Keep go.mod and go.sum to the go tool (go get, go mod tidy).");
		return out.ToString();
	}

	void Activate(IED::PluginContext& context) {}
}
