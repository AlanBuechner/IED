// Go (docs/26 "Language plugins"): the language, its icons, Go projects by go.mod / go.work, and the places the go tool
// prints ("path:line:col").
{
	"manifestVersion": 1,
	"id": "ied.go",
	"name": "Go",
	"version": "0.1.0",
	"description": "The Go language: recognition, icons and build output links.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"contributes": {
		"languages": [
			{ "id": "go", "aliases": ["Go"], "extensions": [".go"], "fences": ["go", "golang"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] }
		],
		"fileIcons": [
			{ "languageId": "go", "extensions": [".go"], "label": "GO", "color": "--hue-cyan" },
			{ "languageId": "go", "fileNames": ["go.mod", "go.sum", "go.work"], "icon": "$(package)", "color": "--hue-cyan" }
		],
		"projectIcons": [
			{ "languageId": "go", "label": "GO", "color": "--hue-cyan", "markers": ["go.mod", "go.work"] }
		],
		"outputLinks": [
			{ "id": "gnu", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\\\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		]
	}
}
