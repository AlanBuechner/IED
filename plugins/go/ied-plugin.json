// Go (docs/26 "Language plugins"): the language, its icons, Go projects by go.mod / go.work, the places the go tool
// prints ("path:line:col"), gopls as the language server when it is installed (go install golang.org/x/tools/gopls),
// the go preset for a folder with a go.mod - Build, Run and Test through the go tool with the `go` matcher - in a Nuke
// workspace the go driver in nuke/ with the go.nuke preset (docs/26 section 6), and C4 code (code/go.cf) whose
// system-message section names the workspace's Go modules. For the profiler (docs/16): the Go client module in
// profiler/, the go preset's Profile task, and the importer of Go execution traces in importer/ (profilerImporters).
{
	"manifestVersion": 1,
	"id": "ied.go",
	"name": "Go",
	"version": "0.1.0",
	"description": "The Go language: recognition, icons, gopls, builds through the go tool or Nuke, and build output links.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "c4", "entry": "Go::Activate" },
	"activation": ["onLanguage:go"],
	"permissions": ["process.spawn", "lsp", "fs.read"],
	"dependencies": [ { "id": "ied.nuke", "version": "^0.1", "optional": true } ],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/Go" },
		"languages": [
			{ "id": "go", "aliases": ["Go"], "extensions": [".go"], "fences": ["go", "golang"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] }
		],
		"fileIcons": [
			{ "languageId": "go", "extensions": [".go"], "label": "GO", "color": "--hue-cyan" },
			{ "languageId": "go", "fileNames": ["go.mod", "go.sum", "go.work"], "icon": "$(package)", "color": "--hue-cyan" }
		],
		"projectIcons": [
			{ "languageId": "go", "label": "GO", "color": "--hue-cyan", "presets": ["go", "go.nuke"], "markers": ["go.mod", "go.work"] }
		],
		"projectTemplates": [
			{ "id": "console", "title": "Console App", "language": "go", "tags": ["Console"], "into": ["nuke.toml"], "files": "templates/console",
				"description": "A Go command (package main with its go.mod), built and run by Nuke through the go tool.",
				"steps": [{ "label": "nuke init", "run": "\"${config:nuke.command}\" init ${name} --language go --ied" }] }
		],
		"outputLinks": [
			{ "id": "gnu", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\\\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		],
		"systemMessageSections": [
			{ "id": "modules", "function": "Go::Section", "when": "workspaceLanguage.go", "maxTokens": 200 }
		],
		"profilerImporters": [
			{ "id": "go.trace", "label": "Go execution trace", "extensions": [".out", ".trace"], "magic": "go 1.", "run": ["${config:go.path}", "-C", "${pluginFolder}/importer", "run", ".", "-go", "${config:go.path}", "${input}", "${output}"] }
		],
		"menus": {
			"explorer/context": [
				{ "command": "ied.profiler.import", "group": "1_open", "when": "explorerItemKind == 'file' && (explorerItemExtension == '.out' || explorerItemExtension == '.trace')" }
			]
		},
		"lspProfiles": [
			{ "id": "gopls", "label": "gopls", "command": "${config:go.gopls.path}", "selector": { "languages": ["go"] }, "when": "config.go.languageServer && workspaceTrusted" }
		],
		"problemMatchers": [
			{
				"id": "go",
				"source": "go",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}", "${cwd}"] },
				"patterns": [ { "regexp": "^(.+?\\.go):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 } ],
				"defaultSeverity": "error"
			}
		],
		"taskPresets": [
			{
				"id": "go",
				"label": "Go",
				"detect": "go.mod",
				"tasks": {
					"build": { "label": "Build", "icon": "$(gear)", "slot": "build", "steps": [ { "run": ["${config:go.path}", "build", "./..."], "problemMatcher": "go" } ] },
					"run": { "label": "Run", "icon": "$(run)", "slot": "run", "concurrency": "restart", "steps": [ { "run": ["${config:go.path}", "run", "."], "problemMatcher": "go", "output": "run" } ] },
					"test": { "label": "Test", "icon": "$(beaker)", "slot": "test", "steps": [ { "run": ["${config:go.path}", "test", "./..."], "problemMatcher": "go", "output": "test" } ] },
					"profile": { "label": "Profile", "icon": "$(pulse)", "slot": "profile", "concurrency": "restart", "tooltip": "Run with the profiler connected (IED_PROFILER); the program records through github.com/AlanBuechner/IED/plugins/go/profiler", "steps": [ { "run": ["${config:go.path}", "run", "."], "problemMatcher": "go", "output": "run", "env": { "IED_PROFILER": "${profiler.connect}" } } ] }
				},
				"toolbar": ["run", "build", "test"]
			},
			{ "id": "go.nuke", "label": "Go (Nuke)", "extends": "nuke", "problemMatcher": "go" }
		]
	}
}
