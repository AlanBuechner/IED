// The chat activity (docs/04, docs/12, docs/15 "Chat activity"): the server's chats - turns that run on the server
// whatever the browsers do - as dockable tabs with streaming segments, tool cards, approval cards and harness notes, a
// composer that sends (into a running turn too), queues and stops, and a right panel with the context, the task list
// and the files the AI changed; the Chats list beside them shows every chat's state and keeps deleted chats restorable. Its server
// code (code/: the turn loop, the model wire, the tools, the chats on disk) is compiled into the server and runs on
// the plugin API (docs/26 "Built-ins on the API"); its prompts are in prompts/.
{
	"manifestVersion": 1,
	"id": "ied.chat",
	"name": "Chat",
	"version": "0.1.0",
	"description": "AI chats: streaming turns, tool and approval cards, messages to running turns, tasks and context.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "Ai::Activate", "ui": "ui/index.js", "servers": ["master", "workspace"] },
	"permissions": ["ai.invoke", "ai.tools", "ai.context", "settings.write", "fs.read", "fs.write", "process.spawn", "lsp", "workspace.projects"],
	"contributes": {
		"outputSources": [ { "id": "ai", "title": "AI" } ],
		"skills": ["skills"],
		"settings": { "schema": "settings.schema.json", "page": "AI" },
		"bindings": {
			"consumes": [
				{ "name": "ai.roots", "version": "1.0.0", "optional": true },
				{ "name": "terminal.text", "version": "1.0.0", "optional": true },
				{ "name": "git.workingDiff", "version": "1.0.0", "optional": true },
				{ "name": "editor.colorize", "version": "1", "optional": true },
				{ "name": "mcp.ensure", "version": "1", "optional": true },
				{ "name": "mcp.readResource", "version": "1", "optional": true },
				{ "name": "ai.claude.account", "version": "1.0.0" }
			],
			"provides": [
				{
					"name": "chat.resource",
					"version": "1.0.0",
					"kind": "function",
					"description": "A plugin says a chat uses one of its tabs (a page the AI drives), or no longer does: {chatId, ref, title?, kind?, close?, open?} -> {}; the chat's side panel lists them, and its Force close runs the UI command `close` names with {ref} (docs/04 \"What a chat has open\")."
				},
				{
					"name": "chat.state",
					"version": "1.0.0",
					"kind": "function",
					"description": "Whether a chat is in a turn: {chatId} -> {state, running}; a deleted chat answers {state: \"deleted\", running: false, deleted: true}, and a page its AI opened closes (docs/27)."
				},
				{
					"name": "ai.claude.account",
					"version": "1.0.0",
					"kind": "function",
					"master": true,
					"description": "The Claude account the master keeps (docs/04 \"Usage\", docs/01 \"Processes\"): {learned?: [{kind: usage|rateLimit|auth, ...}], refresh?, force?} -> the account's state; what a workspace server's sessions learn goes in, and its copy of the account comes back."
				}
			]
		},
		"settingsPages": [
			{ "id": "ied.chat.models", "page": "AI", "title": "Models", "view": "ModelsSettings", "keys": ["ai.models"] },
			{ "id": "ied.chat.groups", "page": "AI", "title": "Model Groups", "view": "ModelGroupsSettings", "keys": ["ai.groups", "ai.defaultGroup"] },
			{ "id": "ied.chat.claude", "page": "AI", "title": "Claude", "view": "ClaudeSettings", "keys": ["ai.claude.command", "ai.claude.usageRefreshMinutes", "ai.claude.paceDays", "ai.claude.workDays"] }
		],
		"activities": [
			{ "id": "ied.chat", "title": "Chat", "icon": "$(comment-discussion)", "order": 0, "phoneSlot": true, "documents": ["chat", "browser"], "emptyWell": ["ied.chat.new"], "newTab": "ied.chat.new" }
		],
		"toolWindows": [
			{ "id": "ied.chat.list", "title": "Chats", "icon": "$(comment-discussion)", "view": "ChatsList", "activity": "ied.chat", "defaultDock": "left", "defaultSize": 0.2, "phoneNav": false }
		],
		"statusBarItems": [
			{ "id": "ied.chat.status", "alignment": "left", "priority": 40, "view": "ChatStatus", "command": "ied.chat.show" },
			{ "id": "ied.chat.claude", "alignment": "right", "priority": 30, "view": "ClaudeStatus", "command": "ied.chat.claudeUsage" }
		],
		"commands": [
			{ "id": "ied.chat.new", "title": "New Chat", "category": "Chat", "icon": "$(add)" },
			{ "id": "ied.chat.show", "title": "Chat", "category": "View", "icon": "$(comment-discussion)" },
			{ "id": "ied.chat.stop", "title": "Stop the Turn", "category": "Chat", "icon": "$(debug-stop)" },
			{ "id": "ied.chat.rename", "title": "Rename Chat...", "category": "Chat", "icon": "$(edit)" },
			{ "id": "ied.chat.delete", "title": "Delete Chat", "category": "Chat", "icon": "$(trash)" },
			{ "id": "ied.chat.claudeUsage", "title": "Claude Usage", "category": "Chat", "icon": "$(pulse)" }
		],
		"menus": {
			"tab/context": [
				{ "command": "ied.chat.rename", "group": "0_chat", "when": "tabKind == 'chat' && tabRef != 'chat:new'" },
				{ "command": "ied.chat.delete", "group": "0_chat", "order": 1, "when": "tabKind == 'chat' && tabRef != 'chat:new'" }
			]
		},
		"keybindings": [
			{ "command": "ied.chat.show", "key": "ctrl+alt+i" },
			{ "command": "ied.chat.new", "key": "ctrl+alt+n" }
		]
	}
}
