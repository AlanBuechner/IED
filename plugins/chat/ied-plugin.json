// The chat activity (docs/04, docs/12, docs/15 "Chat"): the server's chats - turns that run on the server whatever the
// browsers do - as tabs with streaming segments, tool cards, approval cards and harness notes, a composer that sends,
// queues, injects and stops, and a right panel with the context, the task list and the files the AI changed. Its server
// code (code/: the turn loop, the model wire, the tools, the chats on disk) is compiled into the server and runs on
// the plugin API (docs/26 "Built-ins on the API"); its prompts are in prompts/.
{
	"manifestVersion": 1,
	"id": "ied.chat",
	"name": "Chat",
	"version": "0.1.0",
	"description": "AI chats: streaming turns, tool and approval cards, steering, tasks and context.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "Ai::Activate", "ui": "ui/index.js" },
	"permissions": ["ai.invoke", "ai.tools", "ai.context", "settings.write", "fs.read", "fs.write", "process.spawn", "lsp"],
	"contributes": {
		"outputSources": [ { "id": "ai", "title": "AI" } ],
		"skills": ["skills"],
		"settings": { "schema": "settings.schema.json", "page": "AI" },
		"bindings": {
			"consumes": [
				{ "name": "ai.roots", "version": "1.0.0", "optional": true },
				{ "name": "terminal.text", "version": "1.0.0", "optional": true },
				{ "name": "git.workingDiff", "version": "1.0.0", "optional": true }
			],
			"provides": [
				{
					"name": "chat.resource",
					"version": "1.0.0",
					"kind": "function",
					"description": "A plugin says a chat uses one of its tabs (a page the AI drives), or no longer does: {chatId, ref, title?, kind?, open?} -> {}; the chat's side panel lists them (docs/04 \"What a chat has open\")."
				}
			]
		},
		"settingsPages": [
			{ "id": "ied.chat.models", "page": "AI", "title": "Models", "view": "ModelsSettings", "keys": ["ai.models"] },
			{ "id": "ied.chat.groups", "page": "AI", "title": "Model Groups", "view": "ModelGroupsSettings", "keys": ["ai.groups", "ai.defaultGroup"] },
			{ "id": "ied.chat.claude", "page": "AI", "title": "Claude", "view": "ClaudeSettings", "keys": ["ai.claude.command", "ai.claude.usageRefreshMinutes"] }
		],
		"activities": [
			{ "id": "ied.chat", "title": "Chat", "icon": "$(comment-discussion)", "order": 0, "phoneSlot": true, "view": "ChatActivity" }
		],
		"statusBarItems": [
			{ "id": "ied.chat.status", "alignment": "left", "priority": 40, "view": "ChatStatus", "command": "ied.chat.show" },
			{ "id": "ied.chat.claude", "alignment": "right", "priority": 30, "view": "ClaudeStatus", "command": "ied.chat.claudeUsage" }
		],
		"commands": [
			{ "id": "ied.chat.new", "title": "New Chat", "category": "Chat", "icon": "$(add)" },
			{ "id": "ied.chat.show", "title": "Chat", "category": "View", "icon": "$(comment-discussion)" },
			{ "id": "ied.chat.stop", "title": "Stop the Turn", "category": "Chat", "icon": "$(debug-stop)" },
			{ "id": "ied.chat.claudeUsage", "title": "Claude Usage", "category": "Chat", "icon": "$(pulse)" }
		],
		"keybindings": [
			{ "command": "ied.chat.show", "key": "ctrl+alt+i" },
			{ "command": "ied.chat.new", "key": "ctrl+alt+n" }
		]
	}
}
