include "mentions.ch"
include "images.ch"

namespace Ai
{
	static Core::String ArgsWith(const char* name, Core::StringView value) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field(name, value);
		json.EndObject();
		return json.ToString();
	}

	// Where "path:line" puts its line; -1 when `ref` is a name.
	static int64 LineColon(Core::StringView ref) {
		int64 colon = ref.ByteLength() - 1;
		while (colon >= 0 && ref.ByteAt(colon) >= '0' && ref.ByteAt(colon) <= '9') colon -= 1;
		return colon > 0 && colon < ref.ByteLength() - 1 && ref.ByteAt(colon) == ':' && ref.ByteAt(colon - 1) != ':' ? colon : -1;
	}

	// A symbol by the place of its name, `path:line`, narrowed by the label's name; or by its name alone.
	static Core::String SymbolArgs(const Mention& mention) {
		Core::StringView ref = mention.ref.View();
		const int64 colon = LineColon(ref);
		if (colon < 0) return ArgsWith("symbol", ref);
		Core::StringView name = mention.label.View();
		if (name.StartsWith(Core::StringView("#"))) name = name.Substring(1, name.ByteLength() - 1);
		int64 line = 0;
		Core::ParseInt64(ref.Substring(colon + 1, ref.ByteLength() - colon - 1), line);
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("path", ref.Substring(0, colon));
		json.IntField("line", line);
		if (!name.IsEmpty()) json.Field("symbol", name);
		json.EndObject();
		return json.ToString();
	}

	MentionCall MentionTool(const Mention& mention) {
		MentionCall call;
		Core::StringView kind = mention.kind.View();
		if (kind == "file") call.tool = Core::String("fs_read");
		else if (kind == "folder") call.tool = Core::String("fs_list");
		else if (kind == "symbol") call.tool = Core::String("code_read_symbol");
		else if (kind == "problems") call.tool = Core::String("problems_list");
		else if (kind == "chat") call.tool = Core::String("chat_read");
		else return call;
		if (kind == "problems") call.args = Core::String("{}");
		else if (kind == "symbol") call.args = SymbolArgs(mention);
		else if (kind == "chat") {
			IED::JsonWriter json;
			json.BeginObject();
			json.Field("chat", mention.ref.View());
			json.IntField("turns", kMentionChatTurns);
			json.EndObject();
			call.args = json.ToString();
		}
		else call.args = ArgsWith("path", mention.ref.View());
		return call;
	}

	static Core::String Quoted(Core::StringView text) {
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			out.AppendByte(c == '"' ? '\'' : c);
		}
		return out.ToString();
	}

	Core::String MentionBlock(const Mention& mention, Core::StringView text) {
		Core::StringBuilder out;
		out.Append("<mention label=\"@");
		out.Append(Quoted(mention.label.View()).View());
		out.Append("\" kind=\"");
		out.Append(mention.kind.View());
		out.Append("\">\n");
		out.Append(text);
		if (!text.EndsWith(Core::StringView("\n"))) out.Append("\n");
		out.Append("</mention>");
		return out.ToString();
	}

	Core::String TailLines(Core::StringView text, int64 most) {
		int64 end = text.ByteLength();
		while (end > 0 && text.ByteAt(end - 1) == '\n') end -= 1;
		int64 start = end;
		for (int64 lines = 0; start > 0; --start)
			if (text.ByteAt(start - 1) == '\n' && ++lines == most) break;
		return Core::String(text.Substring(start, end - start));
	}

	static Core::String SizeText(int64 bytes) {
		Core::StringBuilder out;
		if (bytes < 1024) {
			out.AppendInt(bytes);
			out.Append(" bytes");
		}
		else if (bytes < 1024 * 1024) {
			out.AppendInt((bytes + 1023) / 1024);
			out.Append(" KB");
		}
		else {
			out.AppendInt((bytes + 1024 * 1024 - 1) / (1024 * 1024));
			out.Append(" MB");
		}
		return out.ToString();
	}

	Core::String AttachedNote(const Attachment& attachment) {
		Core::StringBuilder out;
		out.Append("[attached: ");
		out.Append(attachment.path.View());
		out.Append(" (");
		out.Append(attachment.name.View());
		out.Append(", ");
		out.Append(SizeText(attachment.bytes).View());
		out.Append(", ");
		out.Append(attachment.mime.View());
		out.Append("); fs_read reads it]");
		return out.ToString();
	}

	bool AttachedImage(const Attachment& attachment) {
		return SupportedImage(attachment.mime.View()) && attachment.bytes <= kToolImageMaxBytes;
	}

	static Core::String ByTool(const ToolRegistry& tools, const ToolInvocation& call, const Mention& mention) {
		MentionCall named = MentionTool(mention);
		ToolSpec* spec = tools.Find(named.tool.View());
		if (!spec || !spec->run) return (Core::String("(not read: ") + named.tool.View()) + " is not available in this workspace)";
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		ToolInvocation reading = call;
		reading.args = Serialization::ReadJson(named.args.View(), *doc).root;
		ToolOutcome outcome = spec->run(reading);
		return outcome.content;
	}

	static Core::String FromOutput(const ToolInvocation& call, const Mention& mention) {
		Core::String text;
		Core::String problem;
		if (!IED::OutputTail(call.ws.id.View(), mention.ref.View(), text, problem)) return (Core::String("(not read: ") + problem.View()) + ")";
		Core::String tail = TailLines(text.View(), kMentionLines);
		return tail.IsEmpty() ? Core::String("(the output is empty)") : tail;
	}

	// A binding's answer read as JSON; why it failed in `problem`.
	static Serialization::DomNode BindingAnswer(Core::StringView name, Core::StringView args, Core::String& problem) {
		IED::Result result = IED::CallBinding(name, args);
		if (!result.Ok()) {
			problem = result.error;
			return Serialization::DomNode();
		}
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(result.json.View(), *doc).root;
	}

	static Core::String FromTerminal(const Mention& mention) {
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("terminal", mention.ref.View());
		args.IntField("lines", kMentionLines);
		args.EndObject();
		Core::String problem;
		Serialization::DomNode answer = BindingAnswer(Core::StringView("terminal.text"), args.View(), problem);
		if (!answer.IsValid()) return (Core::String("(not read: ") + problem.View()) + ")";
		Core::StringBuilder out;
		out.Append("Terminal ");
		out.Append(answer.Member("title").AsView());
		out.Append(answer.Member("alive").AsBool() ? " (running), its last lines:\n" : " (exited), its last lines:\n");
		out.Append(answer.Member("text").AsView());
		return out.ToString();
	}

	static Core::String FromDiff(const ToolInvocation& call) {
		IED::JsonWriter args;
		args.BeginObject();
		args.Field("wsId", call.ws.id.View());
		args.IntField("maxBytes", kMentionDiffBytes);
		args.EndObject();
		Core::String problem;
		Serialization::DomNode answer = BindingAnswer(Core::StringView("git.workingDiff"), args.View(), problem);
		if (!answer.IsValid()) return (Core::String("(not read: ") + problem.View()) + ")";
		if (answer.Member("repos").AsInt() == 0) return Core::String("(the workspace has no git repository)");
		Core::String text = Core::String(answer.Member("text").AsView());
		if (answer.Member("truncated").AsBool()) text = text + "[cut at 64 KiB: git diff HEAD in shell_run shows the rest]\n";
		return text;
	}

	Core::String ReadMention(const ToolRegistry& tools, const ToolInvocation& call, const Mention& mention) {
		Core::StringView kind = mention.kind.View();
		if (kind == "output") return FromOutput(call, mention);
		if (kind == "terminal") return FromTerminal(mention);
		if (kind == "diff") return FromDiff(call);
		return ByTool(tools, call, mention);
	}
}
