include "api/plugin.ch"
include "run.ch"
include "images.ch"
include "superseded.ch"
include "effort.ch"

namespace Ai
{
	const char* kTrimmedNote = "\n[trimmed to save context; call the tool again if you need it]";
	const char* kImagesTrimmedNote = "\n[its images were left out to save context; call the tool again if you need them]";
	const int64 kTrimmedKeepBytes = 300;
	const int64 kTrimBelowBytes = 600;
	const int64 kRecentMessagesKept = 4;

	static int64 StreamNowMs() { return Platform::UnixTimeNs() / 1000000; }

	// --- The request -------------------------------------------------------------------------------------------------

	static void WriteTemperature(IED::JsonWriter& json, double temperature) {
		Core::StringBuilder text;
		text.AppendDouble(temperature, 3);
		json.Key(Core::StringView("temperature"));
		json.Raw(text.View());
	}

	// What a request does with images (images.ch): whether the model is sent any, and how many of the oldest it names
	// instead; what it sent.
	class RequestImages
	{
		public bool vision;
		public int64 older;     // images still to name rather than send
		public int64 sent;
		public int64 encoded;   // bytes of base64 written
	}

	// Why the message's images are not sent; empty when they are.
	static Core::StringView Unsent(const ModelMessage* message, RequestImages& images) {
		if (message->images.IsEmpty()) return Core::StringView("");
		if (!images.vision) return Core::StringView(kImagesNotSent);
		if (images.older <= 0) return Core::StringView("");
		images.older -= message->images.Count();
		return Core::StringView(kImagesEarlier);
	}

	// The messages as a request sends them: after a step's results, the images they name in a user message, to a model
	// that sees images (images.ch); the owner's attached images in their message.
	static void WriteMessages(IED::JsonWriter& json, const IED::Workspace& ws, const Core::Array<ModelMessage*>& messages, RequestImages& images, bool withReasoning) {
		Core::Array<ModelMessage*> shown;
		for (int64 i = 0; i < messages.Count(); ++i) {
			ModelMessage* message = messages[i];
			Core::StringView unsent = Unsent(message, images);
			if (message->role == "user" && unsent.IsEmpty() && !message->images.IsEmpty()) {
				images.encoded += WriteUserWithImages(json, ws, message);
				images.sent += message->images.Count();
				continue;
			}
			message->WriteRequest(json, unsent, withReasoning);
			if (unsent.IsEmpty() && !message->images.IsEmpty()) {
				shown.Push(message);
				images.sent += message->images.Count();
			}
			const bool resultsEnd = i + 1 == messages.Count() || messages[i + 1]->role != "tool";
			if (resultsEnd && !shown.IsEmpty()) {
				images.encoded += WriteImagesMessage(json, ws, shown);
				shown.Clear();
			}
		}
	}

	Core::String TurnRun::RequestBody(int64& promptTokens) {
		ModelProfile* profile = candidates[candidate];
		RequestImages images;
		images.vision = profile->vision;
		if (!profile->visionSet) chats->seesImages.TryGet(profile->name, images.vision);
		for (Turn* each : chat->turns)
			if (!each->compressed) images.older += CountImages(each->messages);
		images.older -= kRequestImagesSent;
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("model", profile->model.View());
		json.Key(Core::StringView("messages"));
		json.BeginArray();
		json.BeginObject();
		json.Field("role", "system");
		json.Field("content", system.View());
		json.EndObject();
		bool llamaCpp = false;
		chats->llamaCpp.TryGet(profile->name, llamaCpp);
		// The turn's earlier thinking goes back to a llama.cpp server: its templates show a step's reasoning with the step,
		// and without it the model works its plan out again at every step.
		const bool keepThinking = llamaCpp && profile->keepThinking;
		for (Turn* each : chat->turns)
			if (!each->compressed) WriteMessages(json, ws, each->messages, images, keepThinking && each == turn);
		json.EndArray();
		json.RawField("tools", tools->RequestTools(chat->mode, chat->loadedTools).View());
		json.BoolField("stream", true);
		if (llamaCpp) json.BoolField("return_progress", true);
		json.Key(Core::StringView("stream_options"));
		json.BeginObject();
		json.BoolField("include_usage", true);
		json.EndObject();
		if (role.hasTemperature) WriteTemperature(json, role.temperature);
		turn->effort = Core::String(EffortOf(chat->effort.View(), role.effort.View()));
		WriteEffort(json, *profile, turn->effort.View(), llamaCpp);
		if (profile->maxOutput > 0) json.IntField("max_tokens", profile->maxOutput);
		json.EndObject();
		Core::String body = json.ToString();
		promptTokens = (body.ByteLength() - images.encoded) / 4 + images.sent * kToolImageTokens;
		return body;
	}

	StepRequest TurnRun::Request() {
		ModelProfile* profile = candidates[candidate];
		StepRequest request;
		request.url = profile->CompletionsUrl();
		Core::String key;
		if (!profile->apiKeyEnv.IsEmpty() && Platform::TryGetEnvironmentVariable(profile->apiKeyEnv.CStr(), key)) request.headers.Push(Core::String("Authorization: Bearer ") + key.View());
		request.body = RequestBody(request.promptTokens);
		double rate = profile->prefillRate;
		chats->prefillRates.TryGet(profile->name, rate);
		request.connectMs = profile->connectMs;
		request.readMs = (int64)((double)request.promptTokens * 1000.0 / rate);
		request.prefillMs = profile->prefillBaseMs + 2 * request.readMs;
		request.prefillExtendMs = profile->prefillBaseMs;
		request.idleMs = profile->idleMs;
		request.capMs = profile->stepCapMs;
		return request;
	}

	// --- Segments as the reply streams -------------------------------------------------------------------------------

	Segment* TurnRun::NewSegment(const char* type) {
		Segment* segment = new Segment();
		segment->segId = chat->NextId("s");
		segment->type = Core::String(type);
		segment->model = candidates.IsEmpty() ? Core::String() : candidates[candidate]->name;
		return segment;
	}

	// The segment joins the turn: segment.start carries it as it starts (a note's text, a tool's name and call).
	Segment* TurnRun::Begin(Segment* segment) {
		Prefill(Core::StringView(""));
		turn->segments.Push(segment);
		openedMs = StreamNowMs();
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turn->turnId.View());
		segment->WriteFields(data);
		data.EndObject();
		chats->Publish(chat, "segment.start", data.View());
		return segment;
	}

	void TurnRun::Close(Segment* segment) {
		if (!segment || segment->done) return;
		segment->done = true;
		segment->tokens = (segment->text.ByteLength() + segment->argsText.ByteLength() + 3) / 4;
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("segId", segment->segId.View());
		data.IntField("tokens", segment->tokens);
		data.IntField("ms", StreamNowMs() - openedMs);
		data.EndObject();
		chats->Publish(chat, "segment.end", data.View());
	}

	void TurnRun::CloseStreaming() {
		Close(thinking);
		Close(text);
		for (Segment* segment : callSegments) Close(segment);
		thinking = nullptr;
		text = nullptr;
	}

	// Mergeable: a slow client gets a segment's queued deltas as one (docs/10 "Backpressure").
	static void PublishDelta(Chats* chats, Chat* chat, const Segment* segment, const char* field, Core::StringView text) {
		Core::StringBuilder rest;
		rest.Append("\"segId\":");
		Serialization::WriteJsonString(segment->segId.View(), &rest);
		IED::Merge merge;
		merge.field = Core::String(field);
		merge.text = Core::String(text);
		merge.rest = rest.ToString();
		chats->PublishMergeable(chat, "segment.delta", merge);
	}

	void TurnRun::OnEvent(StepEventKind kind, Core::StringView delta, int64 call) {
		IED::HostLock guard(*context);
		if (kind == StepEventKind::Thinking) {
			if (!thinking) {
				Close(text);
				text = nullptr;
				thinking = Begin(NewSegment("thinking"));
			}
			thinking->text.Append(delta);
			PublishDelta(chats, chat, thinking, "text", delta);
		}
		else if (kind == StepEventKind::Text) {
			Close(thinking);
			thinking = nullptr;
			if (!text) text = Begin(NewSegment("text"));
			text->text.Append(delta);
			PublishDelta(chats, chat, text, "text", delta);
		}
		else if (kind == StepEventKind::CallStarted) {
			CloseStreaming();
			Segment* segment = NewSegment("tool");
			segment->tool = Core::String(delta);
			segment->callId = chat->NextId("k");
			segment->state = Core::String("streaming");
			callSegments.Push(Begin(segment));
		}
		else if (kind == StepEventKind::Progress) Prefill(delta);
		else if (call >= 0 && call < callSegments.Count()) {
			callSegments[call]->argsText.Append(delta);
			PublishDelta(chats, chat, callSegments[call], "argsText", delta);
		}
	}

	void TurnRun::EstimatePrefill(const StepRequest& request) {
		bool llamaCpp = false;
		chats->llamaCpp.TryGet(candidates[candidate]->name, llamaCpp);
		if (llamaCpp || request.readMs < kRunEstimateShownMs) return;
		IED::JsonWriter json;
		json.BeginObject();
		json.BoolField("estimated", true);
		json.IntField("total", request.promptTokens);
		json.IntField("estimatedMs", request.readMs);
		json.IntField("startedMs", StreamNowMs());
		json.EndObject();
		Prefill(json.View());
	}

	void TurnRun::Prefill(Core::StringView progress) {
		if (progress.IsEmpty() && turn->prefill.IsEmpty()) return;
		turn->prefill = Core::String(progress);
		const int64 now = StreamNowMs();
		if (!progress.IsEmpty() && now - progressMs < kRunProgressEveryMs) return;
		progressMs = now;
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turn->turnId.View());
		data.Key(Core::StringView("prefill"));
		if (progress.IsEmpty()) data.Null();
		else data.Raw(progress);
		data.EndObject();
		chats->Publish(chat, "turn.progress", data.View());
	}

	// --- Notes -------------------------------------------------------------------------------------------------------

	void TurnRun::UiNote(Core::StringView kind, Core::StringView note) {
		Segment* segment = NewSegment("harness");
		segment->kind = Core::String(kind);
		segment->text = Core::String(note);
		Close(Begin(segment));
	}

	void TurnRun::HarnessNote(Core::StringView kind, Core::StringView note) {
		UiNote(kind, note);
		ModelMessage* message = new ModelMessage();
		message->role = Core::String("user");
		message->content = Core::String(note);
		turn->messages.Push(message);
	}

	void TurnRun::DeliverSteering() {
		for (const Core::String& steering : chat->injected) {
			Segment* segment = NewSegment("steering");
			segment->text = steering;
			Close(Begin(segment));
			Core::Array<Core::String> values;
			values.Push(Core::String("text"));
			values.Push(steering);
			ModelMessage* message = new ModelMessage();
			message->role = Core::String("user");
			message->content = chats->prompts.Note("steering", values);
			turn->messages.Push(message);
			turn->recoveries.Push(Core::String("delivered a steering message"));
		}
		chat->injected.Clear();
		Core::String ended = chats->TellEnded(chat);
		if (!ended.IsEmpty()) HarnessNote(Core::StringView("background_ended"), ended.View());
	}

	// --- Accounting --------------------------------------------------------------------------------------------------

	int64 TurnRun::Window() const { return chats->WindowOf(candidates[candidate]); }

	// A message's bytes as a request carries them: its text, calls and thinking (sent back where the server keeps it),
	// an image as kToolImageTokens.
	static int64 MessageBytes(const ModelMessage* message) {
		return message->content.ByteLength() + message->toolCalls.ByteLength() + message->reasoning.ByteLength() + message->images.Count() * kToolImageTokens * 4;
	}

	int64 TurnRun::EstimateTokens() const {
		int64 bytes = system.ByteLength();
		for (Turn* each : chat->turns)
			if (!each->compressed)
				for (ModelMessage* message : each->messages) bytes += MessageBytes(message);
		return bytes / 4;
	}

	int64 TurnRun::CalibratedTokens() const {
		const int64 estimate = EstimateTokens();
		if (chat->estimateModel.View() != candidates[candidate]->name.View()) return estimate;
		return estimate + chat->estimateOffset > 0 ? estimate + chat->estimateOffset : estimate;
	}

	static ContextPart Part(const char* name, int64 tokens) {
		ContextPart part;
		part.name = Core::String(name);
		part.tokens = tokens;
		return part;
	}

	// The tool definitions the model is sent: Claude's session lists every tool, a local model the request's.
	Core::String TurnRun::SentTools() const {
		if (!candidates[candidate]->IsClaude()) return tools->RequestTools(chat->mode, chat->loadedTools);
		Core::Array<Core::String> every;
		for (ToolSpec* spec : tools->tools) every.Push(spec->name);
		return tools->RequestTools(chat->mode, every);
	}

	void TurnRun::PublishContext(int64 used) {
		int64 messages = 0;
		int64 results = 0;
		for (Turn* each : chat->turns)
			if (!each->compressed)
				for (ModelMessage* message : each->messages) {
					if (message->role == "tool") results += MessageBytes(message);
					else messages += MessageBytes(message);
				}
		Core::Array<ContextPart> parts;
		parts.Push(Part("System prompt", system.ByteLength() / 4));
		parts.Push(Part("Tool definitions", SentTools().ByteLength() / 4));
		parts.Push(Part("Messages", messages / 4));
		parts.Push(Part("Tool results", results / 4));
		ModelProfile* profile = candidates[candidate];
		chat->context = ContextJson(Window(), used, profile->name.View(), profile->IsClaude(), ScaledParts(parts, used));
		chats->Publish(chat, "context.changed", chat->context.View());
	}

	void TurnRun::Account(const StepResult* result, int64 promptEstimate, int64 estimateBefore) {
		ModelProfile* profile = candidates[candidate];
		const Completion* completion = result->completion;
		// A step that failed before an answer (no connection, an error status, a stall, Claude's error line) counted
		// nothing: the meter keeps the last step's count.
		if (completion->promptTokens <= 0 && result->text.IsEmpty() && result->thinking.IsEmpty() && result->calls.IsEmpty()) return;
		const int64 output = completion->completionTokens > 0 ? completion->completionTokens : (result->text.ByteLength() + result->thinking.ByteLength()) / 4;
		if (completion->promptTokens > 0) {
			turn->tokensIn = completion->promptTokens;
			chat->estimateOffset = completion->promptTokens - estimateBefore;
			chat->estimateModel = profile->name;
		}
		else turn->tokensIn = promptEstimate > 0 ? promptEstimate : CalibratedTokens();
		turn->tokensOut += output;
		if (result->ttftMs >= 0) {
			turn->ttftMs = result->ttftMs;
			turn->genMs += result->ms - result->ttftMs;
		}
		if (completion->promptPerSecond > 0) chats->prefillRates.At(profile->name) = completion->promptPerSecond;
		else if (result->ttftMs > 200 && turn->tokensIn > 0) chats->prefillRates.At(profile->name) = (double)turn->tokensIn * 1000.0 / (double)result->ttftMs;
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turn->turnId.View());
		data.Field("model", turn->model.View());
		data.IntField("tokensIn", turn->tokensIn);
		data.IntField("tokensOut", turn->tokensOut);
		data.IntField("ttftMs", turn->ttftMs);
		data.IntField("genMs", turn->genMs);
		data.EndObject();
		chats->Publish(chat, "turn.stats", data.View());
		PublishContext(turn->tokensIn + output);
	}

	// Mechanical compression (docs/04 "Context management"): file reads a later call made stale noted as such, tool
	// results older than the last few messages trimmed; when that is not enough, whole earlier turns left out (they stay
	// on disk). Whether anything changed.
	bool TurnRun::Compress() {
		Core::Array<ModelMessage*> sent;
		int64 keepFrom = -1;
		for (Turn* each : chat->turns) {
			if (each->compressed) continue;
			for (int64 i = 0; i < each->messages.Count(); ++i) {
				if (each == turn && keepFrom < 0 && i >= each->messages.Count() - kRecentMessagesKept) keepFrom = sent.Count();
				sent.Push(each->messages[i]);
			}
		}
		bool changed = DropSuperseded(sent, keepFrom < 0 ? sent.Count() : keepFrom) > 0;
		for (Turn* each : chat->turns)
			for (int64 i = 0; i < each->messages.Count(); ++i) {
				ModelMessage* message = each->messages[i];
				if (each == turn && i >= each->messages.Count() - kRecentMessagesKept) continue;
				if (message->role != "tool") continue;
				if (!message->images.IsEmpty()) {
					message->images.Clear();
					message->content = message->content + kImagesTrimmedNote;
					changed = true;
				}
				if (message->content.ByteLength() < kTrimBelowBytes) continue;
				message->content = Core::String(message->content.View().Substring(0, kTrimmedKeepBytes)) + kTrimmedNote;
				changed = true;
			}
		const int64 target = Window() / 2;
		for (Turn* each : chat->turns) {
			if (target <= 0 || EstimateTokens() <= target || each == turn) break;
			if (each->compressed) continue;
			each->compressed = true;
			changed = true;
		}
		if (changed) HarnessNote(Core::StringView("context_compressed"), chats->prompts.Note("context_compressed").View());
		return changed;
	}

	void TurnRun::SaveRunning() { SaveRunningTurn(LocalStateOf(ws), chat, turn); }
}
