// contextmeter: the parts scaled to the server's count, the meter drawn again for another model's window, and the
// compress mark only for a model IED compresses (docs/04 "Context management").

include "contextmeter.ch"

static Ai::ContextPart MeterPart(const char* name, int64 tokens) {
	Ai::ContextPart part;
	part.name = Core::String(name);
	part.tokens = tokens;
	return part;
}

static Core::Array<Ai::ContextPart> FourParts() {
	Core::Array<Ai::ContextPart> parts;
	parts.Push(MeterPart("System prompt", 1000));
	parts.Push(MeterPart("Tool definitions", 3000));
	parts.Push(MeterPart("Messages", 4000));
	parts.Push(MeterPart("Tool results", 2000));
	return parts;
}

[test("server.ai.contextmeter")]
class ContextMeterTests {
	[test("parts_add_up_to_the_count")]
	public static void TestScaled() {
		Core::Array<Ai::ContextPart> scaled = Ai::ScaledParts(FourParts(), 12345);
		int64 total = 0;
		for (const Ai::ContextPart& part : scaled) total += part.tokens;
		assert_eq((int64)12345, total, "the parts add up to the server's count");
		assert_eq((int64)1235, scaled[0].tokens, "each in its share");
		assert_eq((int64)1000, Ai::ScaledParts(FourParts(), 0)[0].tokens, "no count: the estimates as they are");
	}

	[test("another_models_window")]
	public static void TestForModel() {
		Core::String local = Ai::ContextJson(32768, 20000, Core::StringView("qwen"), false, Ai::ScaledParts(FourParts(), 20000));
		assert_true(local.View().Contains(Core::StringView("\"compressAt\":85")), "IED compresses a local model's context");
		assert_true(!local.View().Contains(Core::StringView("compacts")), "a local model does not compact itself");
		assert_se("qwen", Ai::ContextModel(local.View()).CStr(), "the model it counted");
		Core::String claude = Ai::ContextForModel(local.View(), 200000, Core::StringView("claude-opus"), true);
		assert_true(claude.View().Contains(Core::StringView("\"window\":200000")), "the new model's window");
		assert_true(claude.View().Contains(Core::StringView("\"used\":20000")), "the same count");
		assert_true(claude.View().Contains(Core::StringView("\"compacts\":true")) && !claude.View().Contains(Core::StringView("compressAt")), "Claude compacts its own");
		assert_se("claude-opus", Ai::ContextModel(claude.View()).CStr(), "the model it is drawn for");
		assert_se("", Ai::ContextModel(Core::StringView("")).CStr(), "no meter, no model");
		Core::String estimate = Ai::ContextJson(32768, 9000, Core::StringView("qwen"), false, FourParts(), true);
		assert_true(estimate.View().Contains(Core::StringView("\"estimated\":true")), "an estimate says so");
		assert_true(Ai::ContextForModel(estimate.View(), 200000, Core::StringView("claude-opus"), true).View().Contains(Core::StringView("\"estimated\":true")), "and still does for another model");
		assert_true(!local.View().Contains(Core::StringView("estimated")), "a count is not an estimate");
	}
}
