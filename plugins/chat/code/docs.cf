include "docs.ch"
include "linediff.ch"

namespace Ai
{
	const int64 kDocsHeadingWeight = 4;
	const int64 kDocsAllWordsBonus = 3;
	const int64 kDocsPhraseBonus = 3;
	const int64 kDocsMostHeadingLevel = 6;
	const int64 kDocsLeastWordBytes = 2;

	static Core::String DocsLowered(Core::StringView text) {
		Core::StringBuilder out;
		out.Reserve(text.ByteLength());
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			out.AppendByte(c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c);
		}
		return out.ToString();
	}

	static bool IsSmallWord(Core::StringView word) {
		const char*[23] small = { "the", "and", "how", "what", "for", "with", "does", "use", "are", "can", "from", "into", "that", "this", "to", "in", "of", "on", "is", "it", "an", "or", "be" };
		for (const char* each : small)
			if (word == each) return true;
		return word.ByteLength() < kDocsLeastWordBytes;
	}

	static bool IsWordByte(int32 c) { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c >= 0x80; }

	Core::Array<Core::String> QueryWords(Core::StringView query) {
		Core::String lowered = DocsLowered(query);
		Core::Array<Core::String> words;
		int64 start = -1;
		for (int64 i = 0; i <= lowered.ByteLength(); ++i) {
			const bool inWord = i < lowered.ByteLength() && IsWordByte(lowered.View().ByteAt(i));
			if (inWord && start < 0) start = i;
			if (inWord || start < 0) continue;
			Core::String word = Core::String(lowered.View().Substring(start, i - start));
			if (!IsSmallWord(word.View()) && !words.Contains(word)) words.Push(word);
			start = -1;
		}
		return words;
	}

	// A heading's level (1 to 6) when `line` is an ATX heading, else 0.
	static int64 HeadingLevel(Core::StringView line) {
		int64 level = 0;
		while (level < line.ByteLength() && line.ByteAt(level) == '#') ++level;
		if (level == 0 || level > kDocsMostHeadingLevel || level >= line.ByteLength() || line.ByteAt(level) != ' ') return 0;
		return level;
	}

	static Core::StringView FileNameOf(Core::StringView path) {
		int64 start = 0;
		for (int64 i = 0; i < path.ByteLength(); ++i)
			if (path.ByteAt(i) == '/' || path.ByteAt(i) == '\\') start = i + 1;
		return path.Substring(start, path.ByteLength() - start);
	}

	Core::Array<DocSection> SplitSections(Core::StringView text, Core::StringView path) {
		Core::Array<Core::StringView> lines = SplitLines(text);
		Core::Array<DocSection> sections;
		DocSection current;
		current.path = Core::String(path);
		current.heading = Core::String(FileNameOf(path));
		current.first = 1;
		bool fenced = false;
		for (int64 i = 0; i < lines.Count(); ++i) {
			if (lines[i].Trimmed().StartsWith(Core::StringView("```"))) fenced = !fenced;
			const int64 level = fenced ? 0 : HeadingLevel(lines[i]);
			if (level == 0) continue;
			if (i > 0) {
				current.last = i;
				sections.Push(current);
			}
			current.heading = Core::String(lines[i].Substring(level, lines[i].ByteLength() - level).Trimmed());
			current.first = i + 1;
		}
		current.last = lines.Count();
		if (current.last >= current.first) sections.Push(current);
		return sections;
	}

	int64 SectionScore(Core::StringView heading, Core::StringView loweredBody, const Core::Array<Core::String>& words, Core::StringView loweredQuery) {
		Core::String loweredHeading = DocsLowered(heading);
		int64 score = 0;
		int64 found = 0;
		for (const Core::String& word : words) {
			const bool inHeading = loweredHeading.View().Contains(word.View());
			const bool inBody = loweredBody.Contains(word.View());
			if (inHeading) score += kDocsHeadingWeight;
			if (inBody) score += 1;
			if (inHeading || inBody) found += 1;
		}
		if (found == 0) return 0;
		if (found == words.Count()) score += kDocsAllWordsBonus;
		if (words.Count() > 1 && loweredBody.Contains(loweredQuery)) score += kDocsPhraseBonus;
		return score;
	}

	Core::String DocsIndex(const Core::Array<DocsFolder*>& folders) {
		Core::StringBuilder out;
		for (const DocsFolder* docs : folders) {
			out.Append("- ");
			out.Append(docs->id.View());
			out.Append(": ");
			out.Append(docs->title.View());
			out.Append("\n");
		}
		return out.ToString();
	}

	// --- The files ---------------------------------------------------------------------------------------------------

	// One Markdown file of a docs folder, read: its path as the model names it, its text and its text lowercased.
	class DocFile
	{
		public Core::String path;
		public Core::String text;
		public Core::String lowered;
		public Core::Array<int64> lineStarts;   // the byte where each line starts, then the text's length
	}

	static DocFile* ReadDocFile(const FS::Path& file, Core::StringView path) {
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen()) return nullptr;
		DocFile* doc = new DocFile();
		doc->path = Core::String(path);
		doc->text = opened.ReadText();
		doc->lowered = DocsLowered(doc->text.View());
		doc->lineStarts.Push(0);
		for (int64 i = 0; i < doc->text.ByteLength(); ++i)
			if (doc->text.View().ByteAt(i) == '\n') doc->lineStarts.Push(i + 1);
		doc->lineStarts.Push(doc->text.ByteLength());
		return doc;
	}

	// Lines `first` to `last` (1-based) of a file's lowered text.
	static Core::StringView LoweredLines(const DocFile* doc, int64 first, int64 last) {
		const int64 lines = doc->lineStarts.Count() - 1;
		const int64 from = doc->lineStarts[first - 1 < lines ? first - 1 : lines];
		const int64 to = doc->lineStarts[last < lines ? last : lines];
		return doc->lowered.View().Substring(from, to - from);
	}

	static void CollectMarkdown(const FS::Path& folder, Core::StringView prefix, Core::Array<Core::String>& relative) {
		for (FS::DirectoryEntry& entry : FS::Directory(folder.CStr())) {
			Core::String path = prefix.IsEmpty() ? entry.name : (Core::String(prefix) + "/") + entry.name.View();
			if (entry.kind == FS::EntryKind::Directory) CollectMarkdown(folder / entry.name.View(), path.View(), relative);
			else if (entry.kind == FS::EntryKind::File && entry.name.View().EndsWith(Core::StringView(".md"))) relative.Push(path);
		}
	}

	static Core::Array<DocFile*> ReadDocs(const Core::Array<DocsFolder*>& folders) {
		Core::Array<DocFile*> files;
		for (const DocsFolder* docs : folders) {
			Core::Array<Core::String> relative;
			CollectMarkdown(docs->folder, Core::StringView(""), relative);
			relative.Sort();
			for (const Core::String& path : relative) {
				DocFile* doc = ReadDocFile(docs->folder / path.View(), ((docs->id + "/") + path.View()).View());
				if (doc) files.Push(doc);
			}
		}
		return files;
	}

	// --- docs_search -------------------------------------------------------------------------------------------------

	struct DocHit
	{
		public DocSection section;
		public const DocFile* file;
		public int64 score;
	}

	static int64 WordsIn(Core::StringView loweredLine, const Core::Array<Core::String>& words) {
		int64 count = 0;
		for (const Core::String& word : words)
			if (loweredLine.Contains(word.View())) count += 1;
		return count;
	}

	// The section's lines with the most of the words, at most kDocsMatchLines, in their order.
	static void AppendMatchingLines(Core::StringBuilder& out, const DocHit& hit, const Core::Array<Core::String>& words) {
		Core::Array<int64> best;
		for (int64 count = words.Count(); count > 0 && best.Count() < kDocsMatchLines; --count)
			for (int64 line = hit.section.first + 1; line <= hit.section.last && best.Count() < kDocsMatchLines; ++line)
				if (WordsIn(LoweredLines(hit.file, line, line), words) == count && !best.Contains(line)) best.Push(line);
		best.Sort();
		for (int64 line : best) {
			Core::StringView text = hit.file->text.View().Substring(hit.file->lineStarts[line - 1], hit.file->lineStarts[line] - hit.file->lineStarts[line - 1]).Trimmed();
			Core::Format(&out, "  {0:D}: ", line);
			out.Append(text.Substring(0, kDocsLineBytes));
			out.Append(text.ByteLength() > kDocsLineBytes ? " ...\n" : "\n");
		}
	}

	static Core::Array<DocHit> RankSections(const Core::Array<DocFile*>& files, const Core::Array<Core::String>& words, Core::StringView loweredQuery) {
		Core::Array<DocHit> hits;
		for (const DocFile* file : files)
			for (const DocSection& section : SplitSections(file->text.View(), file->path.View())) {
				const int64 score = SectionScore(section.heading.View(), LoweredLines(file, section.first, section.last), words, loweredQuery);
				if (score > 0) hits.Push(DocHit{ section, file, score });
			}
		hits.SortBy([](const DocHit& a, const DocHit& b) -> bool {
			if (a.score != b.score) return a.score > b.score;
			return (a.section.last - a.section.first) < (b.section.last - b.section.first);
		});
		return hits;
	}

	static ToolPlan DocsPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView what = call.args.Member("query").IsValid() ? call.args.Member("query").AsView() : call.args.Member("path").AsView();
		plan.subject = (Core::String("docs(") + what) + ")";
		plan.summary = Core::String("Read the reference docs");
		return plan;
	}

	static ToolOutcome DocsSearchRun(const ToolInvocation& call, const Core::Array<DocsFolder*>& folders) {
		Core::StringView query = call.args.Member("query").AsView();
		Core::Array<Core::String> words = QueryWords(query);
		if (words.IsEmpty()) return ToolError(Core::StringView("docs_search: the query has no words to look for; name the type, function or topic"));
		Core::String loweredQuery = DocsLowered(query.Trimmed());
		Core::Array<DocFile*> files = ReadDocs(folders);
		Core::Array<DocHit> hits = RankSections(files, words, loweredQuery.View());
		Core::StringBuilder out;
		for (int64 i = 0; i < hits.Count() && i < kDocsSearchMost; ++i) {
			Core::Format(&out, "{0:s}:{1:D}-{2:D} ", hits[i].section.path.CStr(), hits[i].section.first, hits[i].section.last);
			out.Append(hits[i].section.heading.View());
			out.Append("\n");
			AppendMatchingLines(out, hits[i], words);
		}
		if (hits.IsEmpty()) out.Append("[no section has any of these words; try other words or a shorter name]\n");
		else if (hits.Count() > kDocsSearchMost) Core::Format(&out, "[{0:D} more sections match; more words narrow the search]\n", hits.Count() - kDocsSearchMost);
		out.Append("[docs_read with a path and a heading (or a line) reads a section]\n");
		Core::StringBuilder preview;
		preview.AppendInt(hits.Count() < kDocsSearchMost ? hits.Count() : kDocsSearchMost);
		preview.Append(" sections");
		return ToolResult(out.View(), preview.View());
	}

	// --- docs_read ---------------------------------------------------------------------------------------------------

	static DocsFolder* FolderNamed(const Core::Array<DocsFolder*>& folders, Core::StringView id) {
		for (DocsFolder* docs : folders)
			if (docs->id == id) return docs;
		return nullptr;
	}

	// The file `path` ("<id>/<path in the folder>") names; null with `problem` when it names none.
	static DocFile* DocAt(const Core::Array<DocsFolder*>& folders, Core::StringView path, Core::String& problem) {
		const int64 slash = path.IndexOf('/', 0);
		DocsFolder* docs = slash > 0 ? FolderNamed(folders, path.Substring(0, slash)) : nullptr;
		Core::StringView inside = slash > 0 ? path.Substring(slash + 1, path.ByteLength() - slash - 1) : Core::StringView("");
		if (!docs || inside.IsEmpty() || inside.Contains(Core::StringView(".."))) {
			problem = Core::String("docs_read: no reference doc ") + path + "; paths start with a docs name (" + DocsIndex(folders).View().Trimmed() + "), as docs_search gives them";
			return nullptr;
		}
		DocFile* doc = ReadDocFile(docs->folder / inside, path);
		if (!doc) problem = Core::String("docs_read: there is no file ") + path + "; docs_search finds the sections";
		return doc;
	}

	static Core::String HeadingList(const DocFile* doc) {
		Core::StringBuilder out;
		Core::Format(&out, "{0:s}: {1:D} lines. Its headings:\n", doc->path.CStr(), doc->lineStarts.Count() - 2);
		for (const DocSection& section : SplitSections(doc->text.View(), doc->path.View())) {
			Core::Format(&out, "  {0:D} ", section.first);
			out.Append(section.heading.View());
			out.Append("\n");
		}
		out.Append("[docs_read with a heading or a line reads that section]\n");
		return out.ToString();
	}

	static bool FindSection(const DocFile* doc, const Serialization::DomNode& args, DocSection& found) {
		Core::String wanted = DocsLowered(args.Member("heading").AsView().Trimmed());
		const int64 line = args.Member("line").IsValid() ? args.Member("line").AsInt() : 0;
		for (const DocSection& section : SplitSections(doc->text.View(), doc->path.View())) {
			const bool named = !wanted.IsEmpty() && DocsLowered(section.heading.View()).View().Contains(wanted.View());
			const bool holds = line > 0 && line >= section.first && line <= section.last;
			if (named || holds) {
				found = section;
				return true;
			}
		}
		return false;
	}

	static Core::String SectionText(const DocFile* doc, const DocSection& section, int64 from) {
		const int64 last = section.last < from + kDocsReadMostLines - 1 ? section.last : from + kDocsReadMostLines - 1;
		Core::StringBuilder out;
		Core::Format(&out, "{0:s}:{1:D}-{2:D} ", doc->path.CStr(), section.first, section.last);
		out.Append(section.heading.View());
		out.Append("\n");
		for (int64 line = from; line <= last; ++line) {
			out.AppendInt(line);
			out.Append("\t");
			out.Append(doc->text.View().Substring(doc->lineStarts[line - 1], doc->lineStarts[line] - doc->lineStarts[line - 1]));
		}
		if (last < section.last) Core::Format(&out, "\n[the section goes on: docs_read with line {0:D} reads on]\n", last + 1);
		return out.ToString();
	}

	static ToolOutcome DocsReadRun(const ToolInvocation& call, const Core::Array<DocsFolder*>& folders) {
		Core::String problem;
		DocFile* doc = DocAt(folders, call.args.Member("path").AsView(), problem);
		if (!doc) return ToolError(problem.View());
		if (!call.args.Member("heading").IsValid() && !call.args.Member("line").IsValid()) return ToolResult(HeadingList(doc).View(), doc->path.View());
		DocSection section;
		if (!FindSection(doc, call.args, section)) return ToolError(((Core::String("docs_read: no section of ") + doc->path.View()) + " has that heading or line. " + HeadingList(doc).View()).View());
		const int64 line = call.args.Member("line").IsValid() ? call.args.Member("line").AsInt() : section.first;
		return ToolResult(SectionText(doc, section, line > section.first ? line : section.first).View(), section.heading.View());
	}

	static ToolSpec* DocsSpec(const char* name, const char* description, const char* parameters) {
		ToolSpec* spec = new ToolSpec();
		spec->name = Core::String(name);
		spec->description = Core::String(description);
		spec->parameters = Core::String(parameters);
		spec->toolClass = ToolClass::Read;
		spec->parallelSafe = true;
		spec->inPlan = true;
		spec->plan = DocsPlan;
		return spec;
	}

	void AddDocsTools(ToolRegistry& registry, func<Core::Array<DocsFolder*>(const ToolInvocation& call)> folders) {
		ToolSpec* search = DocsSpec("docs_search", "Search the reference docs of the workspace's languages and libraries (# Reference docs in the system message) by words - a type, a function, a topic: the best sections with their path, lines and the lines that match. Example: docs_search({\"query\": \"HashMap insert find\"})",
			"{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"minLength\": 1}}, \"required\": [\"query\"], \"additionalProperties\": false}");
		search->run = [folders](const ToolInvocation& call) -> ToolOutcome { return DocsSearchRun(call, folders(call)); };
		registry.Add(search);
		ToolSpec* read = DocsSpec("docs_read", "Read a section of the reference docs by its path and heading (or a line), as docs_search gives them; a path alone lists the file's headings. Example: docs_read({\"path\": \"c4/library/bedrock.md\", \"heading\": \"Core::HashMap\"})",
			"{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\", \"minLength\": 1}, \"heading\": {\"type\": \"string\"}, \"line\": {\"type\": \"integer\", \"minimum\": 1}}, \"required\": [\"path\"], \"additionalProperties\": false}");
		read->run = [folders](const ToolInvocation& call) -> ToolOutcome { return DocsReadRun(call, folders(call)); };
		registry.Add(read);
	}
}
