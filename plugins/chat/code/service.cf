include "api/plugin.ch"
include "service.ch"
include "run.ch"
include "sent.ch"

namespace Ai
{
	const char* kInterruptedNote = "This call was interrupted by a server restart; its effect is unknown. Check the current state before retrying it.";
	const int64 kTitleMostBytes = 48;
	const int64 kProbeWaitSliceNs = 50000000;

	Core::String ChatsTopic(Core::StringView wsId) { return Core::String("chats:") + wsId; }

	IED::Workspace OpenWorkspace(Core::StringView wsId) {
		IED::Workspace ws;
		if (!IED::FindWorkspace(wsId, ws)) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no workspace ") + wsId).View());
		return ws;
	}

	void Chats::Init(IED::PluginContext* context) {
		this.context = context;
		tools = CoreTools();
		for (const Core::String& problem : tools->problems) context->Log(problem.View());
		Core::Array<Core::String> problems;
		prompts.Load(FS::Path(context->Folder().View()) / "prompts", problems);
		for (const Core::String& problem : problems) context->Log(problem.View());
		Chats* self = this;
		Register("chat.list", [self](const IED::Request& request) -> Core::String { return self->ListMethod(request); });
		Register("chat.create", [self](const IED::Request& request) -> Core::String { return self->CreateMethod(request); });
		Register("chat.set", [self](const IED::Request& request) -> Core::String { return self->SetMethod(request); });
		Register("chat.send", [self](const IED::Request& request) -> Core::String { return self->SendMethod(request); });
		Register("chat.unqueue", [self](const IED::Request& request) -> Core::String { return self->UnqueueMethod(request); });
		Register("chat.stop", [self](const IED::Request& request) -> Core::String { return self->StopMethod(request); });
		Register("chat.approve", [self](const IED::Request& request) -> Core::String { return self->ApproveMethod(request); });
		Register("chat.answer", [self](const IED::Request& request) -> Core::String { return self->AnswerMethod(request); });
		Register("chat.history", [self](const IED::Request& request) -> Core::String { return self->HistoryMethod(request); });
		Register("ai.probe", [self](const IED::Request& request) -> Core::String { return self->ProbeMethod(request); });
		Register("chat.delete", [self](const IED::Request& request) -> Core::String { return self->DeleteMethod(request); });
	}

	void Chats::Register(const char* name, IED::MethodHandler method) {
		IED::PluginContext* plugin = context;
		Core::String problem;
		if (!context->Method(Core::StringView(name), [plugin, method](const IED::Request& request) -> Core::String {
			IED::HostLock guard(*plugin);
			return method(request);
		}, problem))
			context->Log(problem.View());
	}

	void Chats::WorkspaceOpened(const IED::Workspace& ws) {
		IED::HostLock guard(*context);
		Chats* self = this;
		Core::String wsId = ws.id;
		context->TopicFrom(ChatsTopic(wsId.View()).View(), [self, wsId]() -> Core::String { return self->ListSnapshot(wsId.View()); });
		Core::Array<Core::String> problems;
		for (Chat* chat : LoadChats(LocalStateOf(ws), ws.id.View(), Core::StringView(kInterruptedNote), problems)) {
			chats.Push(chat);
			AddTopic(chat);
		}
		for (const Core::String& problem : problems) context->Log(problem.View());
	}

	Chat* Chats::Get(Core::StringView chatId) const {
		for (Chat* chat : chats)
			if (chat->chatId.View() == chatId) return chat;
		throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no chat ") + chatId).View());
	}

	IED::Workspace Chats::WorkspaceOf(const Chat* chat) const { return OpenWorkspace(chat->wsId.View()); }

	void Chats::Publish(Chat* chat, const char* kind, Core::StringView data) { context->Publish(chat->Topic().View(), kind, data); }

	void Chats::PublishMergeable(Chat* chat, const char* kind, const IED::Merge& merge) { context->PublishMergeable(chat->Topic().View(), kind, merge); }

	void Chats::Changed(Chat* chat) {
		Core::String summary = chat->SummaryJson();
		Publish(chat, "chat.changed", summary.View());
		context->Publish(ChatsTopic(chat->wsId.View()).View(), "chat.changed", summary.View());
		SaveChatHeader(LocalStateOf(WorkspaceOf(chat)), chat);
	}

	// The chat's group: its own, else ai.defaultGroup, else the first group.
	static Core::String GroupOf(IED::PluginContext* context, const Chat* chat, const IED::Workspace& ws) {
		if (!chat->group.IsEmpty()) return chat->group;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String fallback = Core::String(Serialization::ReadJson(context->Setting(Core::StringView("ai.defaultGroup"), WsId(ws)).View(), *doc).root.AsView());
		if (!fallback.IsEmpty()) return fallback;
		Core::Array<Core::String> names = GroupNames(context->Setting(Core::StringView("ai.groups"), WsId(ws)).View());
		return names.IsEmpty() ? Core::String() : names[0];
	}

	// The models the primary role of the chat's group tries, in order; `role` gets the role.
	static Core::Array<ModelProfile*> PrimaryOf(IED::PluginContext* context, const Chat* chat, const IED::Workspace& ws, RoleModel& role) {
		Core::Array<Core::String> problems;
		Core::Array<ModelProfile*> models = ReadModels(context->Setting(Core::StringView("ai.models"), WsId(ws)).View(), problems);
		return RoleCandidates(models, context->Setting(Core::StringView("ai.groups"), WsId(ws)).View(), GroupOf(context, chat, ws).View(), Core::StringView("primary"), role);
	}

	Core::String Chats::ModelOf(const Chat* chat) const {
		RoleModel role;
		Core::Array<ModelProfile*> candidates = PrimaryOf(context, chat, WorkspaceOf(chat), role);
		return candidates.IsEmpty() ? Core::String() : candidates[0]->name;
	}

	Core::String Chats::Snapshot(Chat* chat) {
		IED::Workspace ws = WorkspaceOf(chat);
		RoleModel role;
		Core::Array<ModelProfile*> candidates = PrimaryOf(context, chat, ws, role);
		Core::StringView model = candidates.IsEmpty() ? Core::StringView("") : candidates[0]->name.View();
		return chat->SnapshotJson(model, GroupOf(context, chat, ws).View(), role.effort.View(), kChatSnapshotTurns);
	}

	Core::String Chats::ListSnapshot(Core::StringView wsId) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("chats"));
		json.BeginArray();
		for (Chat* chat : chats) {
			if (chat->wsId.View() != wsId) continue;
			json.BeginObject();
			chat->WriteSummary(json);
			json.EndObject();
		}
		json.EndArray();
		json.EndObject();
		return json.ToString();
	}

	void Chats::AddTopic(Chat* chat) {
		Chats* self = this;
		context->TopicFrom(chat->Topic().View(), [self, chat]() -> Core::String { return self->Snapshot(chat); });
	}

	// --- Turns -------------------------------------------------------------------------------------------------------

	static Core::String TitleFrom(Core::StringView text) {
		Core::StringView line = text.Trimmed();
		const int64 lineEnd = line.IndexOf('\n', 0);
		if (lineEnd >= 0) line = line.Substring(0, lineEnd).Trimmed();
		if (line.ByteLength() <= kTitleMostBytes) return Core::String(line);
		int64 cut = kTitleMostBytes;
		while (cut > 0 && ((uint8)line.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
		return Core::String(line.Substring(0, cut)) + "...";
	}

	// What the model is told of a message another chat sent.
	static Core::String FromText(const Chat* from, Core::StringView text) {
		Core::StringBuilder out;
		out.Append("Message from chat \"");
		out.Append(from->title.View());
		out.Append("\" (");
		out.Append(from->chatId.View());
		out.Append("); answer it with chat_send if it asks for an answer:\n\n");
		out.Append(text);
		return out.ToString();
	}

	void Chats::StartTurn(Chat* chat, const OwnerMessage& message) { StartTurn(chat, message, nullptr, 0); }

	void Chats::StartTurn(Chat* chat, const OwnerMessage& sent, const Chat* from, int64 hops) {
		IED::Workspace ws = WorkspaceOf(chat);
		Core::StringView text = sent.text.View();
		Turn* turn = new Turn();
		turn->turnId = chat->NextId("u");
		turn->userText = sent.text;
		turn->mentions = sent.mentions;
		turn->attachments = sent.attachments;
		turn->hops = hops;
		if (from) {
			turn->fromChatId = from->chatId;
			turn->fromTitle = from->title;
		}
		turn->mode = chat->mode;
		turn->group = GroupOf(context, chat, ws);
		turn->model = ModelOf(chat);
		turn->startedMs = ChatNowMs();
		ModelMessage* message = new ModelMessage();
		message->role = Core::String("user");
		message->content = from ? FromText(from, text) : Core::String(text);
		turn->messages.Push(message);
		chat->turns.Push(turn);
		if (chat->title == kNewChatTitle) chat->title = TitleFrom(text);
		chat->run = new ChatRun();
		chat->run->turn = turn;
		chat->state = ChatState::Running;
		chat->stateReason = Core::String();
		chat->updatedMs = turn->startedMs;
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turn->turnId.View());
		data.Field("mode", ChatModeName(turn->mode));
		data.Field("group", turn->group.View());
		data.Field("model", turn->model.View());
		data.Key(Core::StringView("user"));
		turn->WriteUser(data);
		data.IntField("startedMs", turn->startedMs);
		data.EndObject();
		Publish(chat, "turn.start", data.View());
		Changed(chat);
		StartRun(this, chat, ws);
	}

	Core::Array<Chat*> Chats::InWorkspace(Core::StringView wsId) const {
		Core::Array<Chat*> found;
		for (Chat* chat : chats)
			if (chat->wsId.View() == wsId) found.Push(chat);
		return found;
	}

	bool Chats::Deliver(Chat* chat, Core::StringView text, const Chat* from, int64 hops) {
		if (!chat->run) {
			OwnerMessage message;
			message.text = Core::String(text);
			StartTurn(chat, message, from, hops);
			return true;
		}
		chat->injected.Push(FromText(from, text));
		if (hops > chat->run->turn->hops) chat->run->turn->hops = hops;
		return false;
	}

	// A chat not yet announced: kept and given its topic.
	Chat* Chats::NewChat(const IED::Workspace& ws, Core::StringView title, ChatMode mode, Core::StringView group) {
		Chat* chat = new Chat();
		Core::StringBuilder id;
		id.Append("c");
		id.AppendHex((uint64)(Platform::UnixTimeNs() / 1000));
		chat->chatId = id.ToString();
		chat->wsId = ws.id;
		chat->title = Core::String(title);
		chat->mode = mode;
		chat->permission = DefaultPermission(mode);
		chat->group = Core::String(group);
		chat->createdMs = ChatNowMs();
		chat->updatedMs = chat->createdMs;
		chats.Push(chat);
		AddTopic(chat);
		return chat;
	}

	// The chat saved and announced on its workspace's chats: topic.
	void Chats::Announce(const IED::Workspace& ws, Chat* chat) {
		SaveChatHeader(LocalStateOf(ws), chat);
		context->Publish(ChatsTopic(ws.id.View()).View(), "chat.created", chat->SummaryJson().View());
	}

	Chat* Chats::Create(const IED::Workspace& ws, Core::StringView title, ChatMode mode, Core::StringView group) {
		Chat* chat = NewChat(ws, title, mode, group);
		Announce(ws, chat);
		return chat;
	}

	void Chats::TurnEnded(Chat* chat) {
		if (chat->queued.IsEmpty() || chat->Current()->stop != "finished") return;
		OwnerMessage* next = chat->queued[0];
		chat->queued.RemoveAt(0);
		QueueChanged(chat);
		StartTurn(chat, *next);
	}

	void Chats::QueueChanged(Chat* chat) {
		IED::JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("queued"));
		chat->WriteQueued(data);
		data.EndObject();
		Publish(chat, "queue.changed", data.View());
	}

	// --- Methods -----------------------------------------------------------------------------------------------------

	Core::String Chats::ListMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		return ListSnapshot(OpenWorkspace(params.Str("wsId").View()).id.View());
	}

	static void ReadSettings(Chat* chat, const IED::Params& params) {
		if (params.Has("title")) chat->title = params.Str("title");
		if (params.Has("mode") && !ReadChatMode(params.Str("mode").View(), chat->mode)) throw IED::RpcError(IED::ErrorCode::BadRequest, "mode must be ask, plan or agent");
		if (params.Has("permission") && !ReadPermissionMode(params.Str("permission").View(), chat->permission)) throw IED::RpcError(IED::ErrorCode::BadRequest, "permission must be plan, ask, acceptEdits or auto");
		if (params.Has("group")) chat->group = params.Str("group");
		if (params.Has("effort")) {
			Core::String effort = params.Str("effort");
			if (!effort.IsEmpty() && !IsEffort(effort.View())) throw IED::RpcError(IED::ErrorCode::BadRequest, "effort must be low, medium, high or empty (its role's)");
			chat->effort = effort;
		}
	}

	Core::String Chats::CreateMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		IED::Workspace ws = OpenWorkspace(params.Str("wsId").View());
		ChatMode mode = ChatMode::Agent;
		if (params.Has("mode") && !ReadChatMode(params.Str("mode").View(), mode)) throw IED::RpcError(IED::ErrorCode::BadRequest, "mode must be ask, plan or agent");
		Chat* chat = NewChat(ws, Core::StringView(kNewChatTitle), mode, Core::StringView(""));
		ReadSettings(chat, params);
		Announce(ws, chat);
		return chat->SummaryJson();
	}

	Core::String Chats::SetMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		ReadSettings(chat, params);
		Changed(chat);
		return chat->SummaryJson();
	}

	Core::String Chats::SendMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		OwnerMessage* message = new OwnerMessage();
		message->text = params.Str("text");
		if (message->text.View().Trimmed().IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, "text is empty");
		Core::String delivery = params.Str("as", Core::StringView("message"));
		if (delivery != "message" && delivery != "queue" && delivery != "inject") throw IED::RpcError(IED::ErrorCode::BadRequest, "as must be message, queue or inject");
		Serialization::DomNode mentions = params.Field("mentions");
		Serialization::DomNode attachments = params.Field("attachments");
		const bool extras = mentions.Count() > 0 || attachments.Count() > 0;
		if (chat->run && delivery == "inject" && extras) throw IED::RpcError(IED::ErrorCode::BadRequest, "a message with mentions or attachments cannot be injected: queue it");
		message->mentions = SentMentions(mentions);
		message->attachments = KeepAttachments(chat, WorkspaceOf(chat), attachments);
		IED::JsonWriter json;
		json.BeginObject();
		if (!chat->run) {
			StartTurn(chat, *message);
			json.Field("turnId", chat->Current()->turnId.View());
		}
		else if (delivery == "inject") {
			chat->injected.Push(message->text);
			json.BoolField("injected", true);
		}
		else {
			chat->queued.Push(message);
			QueueChanged(chat);
			SaveChatHeader(LocalStateOf(WorkspaceOf(chat)), chat);
			json.IntField("queued", chat->queued.Count());
		}
		json.EndObject();
		return json.ToString();
	}

	Core::String Chats::UnqueueMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		const int64 index = params.Int("index");
		if (index < 0 || index >= chat->queued.Count()) throw IED::RpcError(IED::ErrorCode::NotFound, "no queued message at that index");
		const bool start = params.Bool("start", false);
		if (start && chat->run) throw IED::RpcError(IED::ErrorCode::Conflict, "a turn is running: the message starts when it ends");
		OwnerMessage* message = chat->queued[index];
		chat->queued.RemoveAt(index);
		QueueChanged(chat);
		SaveChatHeader(LocalStateOf(WorkspaceOf(chat)), chat);
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("queued"));
		chat->WriteQueued(json);
		json.Key(Core::StringView("message"));
		message->WriteJson(json);
		if (start) {
			StartTurn(chat, *message);
			json.Field("turnId", chat->Current()->turnId.View());
		}
		json.EndObject();
		return json.ToString();
	}

	Core::String Chats::StopMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		if (chat->run) {
			chat->run->cancelled = true;
			chat->run->wake.NotifyAll();
		}
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("state", ChatStateName(chat->state));
		json.EndObject();
		return json.ToString();
	}

	Core::String Chats::ApproveMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		Core::String approvalId = params.Str("approvalId");
		Core::String decision = params.Str("decision");
		if (decision != "allow" && decision != "deny" && decision != "chat") throw IED::RpcError(IED::ErrorCode::BadRequest, "decision must be allow, deny or chat");
		Approval* approval = nullptr;
		for (Approval* each : chat->approvals)
			if (each->approvalId == approvalId) approval = each;
		if (!approval) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no approval ") + approvalId.View() + " is waiting").View());
		if (!approval->decision.IsEmpty()) {
			IED::JsonWriter answered;
			answered.BeginObject();
			answered.Field("decision", approval->decision.View());
			answered.Field("by", approval->by.View());
			answered.EndObject();
			throw IED::RpcError(IED::ErrorCode::Conflict, "another device answered first", answered.View());
		}
		approval->decision = decision;
		approval->message = params.Str("message", Core::StringView(""));
		approval->by = Core::String(request.clientId.View());
		chat->run->wake.NotifyAll();
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("approvalId", approvalId.View());
		data.Field("decision", decision.View());
		data.Field("by", approval->by.View());
		data.EndObject();
		Publish(chat, "approval.resolved", data.View());
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("decision", decision.View());
		json.EndObject();
		return json.ToString();
	}

	Core::String Chats::AnswerMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		Core::String questionId = params.Str("questionId");
		Question* question = chat->question;
		if (!question || question->questionId != questionId) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no question ") + questionId.View() + " is waiting").View());
		if (question->answered) throw IED::RpcError(IED::ErrorCode::Conflict, "another device answered first");
		question->answer = params.Str("answer");
		question->answered = true;
		chat->run->wake.NotifyAll();
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("questionId", questionId.View());
		data.Field("answer", question->answer.View());
		data.Field("by", request.clientId.View());
		data.EndObject();
		Publish(chat, "question.resolved", data.View());
		return Core::String("{}");
	}

	Core::String Chats::HistoryMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		Core::String before = params.Str("before", Core::StringView(""));
		const int64 limit = params.Int("limit", kChatSnapshotTurns);
		int64 end = chat->turns.Count();
		for (int64 i = 0; i < chat->turns.Count(); ++i)
			if (chat->turns[i]->turnId == before) end = i;
		const int64 start = end - limit > 0 ? end - limit : 0;
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("turns"));
		json.BeginArray();
		for (int64 i = start; i < end; ++i) chat->turns[i]->WriteJson(json, false);
		json.EndArray();
		json.BoolField("hasMore", start > 0);
		json.EndObject();
		return json.ToString();
	}

	Core::String Chats::DeleteMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		if (chat->run) throw IED::RpcError(IED::ErrorCode::Conflict, "the chat is running a turn: stop it first");
		IED::Workspace ws = WorkspaceOf(chat);
		for (int64 i = 0; i < chats.Count(); ++i)
			if (chats[i] == chat) {
				chats.RemoveAt(i);
				break;
			}
		DeleteChatFiles(LocalStateOf(ws), chat->chatId.View());
		context->RemoveTopic(chat->Topic().View());
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("chatId", chat->chatId.View());
		data.EndObject();
		context->Publish(ChatsTopic(ws.id.View()).View(), "chat.deleted", data.View());
		return Core::String("{}");
	}
	// --- Model probes ------------------------------------------------------------------------------------------------

	class ProbeJob
	{
		public bool done;
		public ModelProbe probe;
		public Threading::ConditionVariable ready;
	}

	// ai.probe {wsId, model} asks a profile's server what it serves (settings' "Test connection"); {wsId, profile} tests a
	// profile not saved yet (an ai.models entry). What it learns of a saved profile's window is kept for its turns.
	Core::String Chats::ProbeMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		IED::Workspace ws = OpenWorkspace(params.Str("wsId").View());
		Core::Array<Core::String> problems;
		Core::Array<ModelProfile*> models;
		Core::String name;
		if (params.Has("profile")) {
			name = Core::String("probe");
			models = ReadModels((Core::String("{\"probe\": ") + IED::NodeJson(params.Field("profile")).View() + "}").View(), problems);
		}
		else {
			name = params.Str("model");
			models = ReadModels(context->Setting(Core::StringView("ai.models"), WsId(ws)).View(), problems);
		}
		ModelProfile* profile = FindModel(models, name.View());
		if (!profile) throw IED::RpcError(IED::ErrorCode::BadRequest, (problems.IsEmpty() ? (Core::String("no model ") + name.View() + " in ai.models") : problems[0]).View());
		ProbeJob* job = new ProbeJob();
		IED::PluginContext* plugin = context;
		ModelProfile* asked = profile;
		plugin->StartThread([job, asked, plugin]() {
			ModelProbe probe = ProbeModel(*asked, kProbeTimeoutMs);
			IED::HostLock guard(*plugin);
			job->probe = probe;
			job->done = true;
			job->ready.NotifyAll();
		});
		IED::HostLock guard(*context);
		while (!job->done && !request.Cancelled()) guard.Wait(job->ready, kProbeWaitSliceNs);
		if (!job->done) throw IED::RpcError(IED::ErrorCode::Cancelled, "request cancelled");
		if (!params.Has("profile") && job->probe.contextWindow > 0) {
			windows.At(name) = job->probe.contextWindow;
			probed.At(name) = true;
		}
		return job->probe.JsonText();
	}
}
