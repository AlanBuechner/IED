include "background.ch"

namespace Ai
{
	const int32 kBackgroundReadPollMs = 250;
	const int64 kBackgroundDrainMs = 1000;    // after the command exits, what its children still write

	Core::String TaskDuration(int64 ms) {
		Core::StringBuilder out;
		const int64 seconds = ms / 1000;
		if (seconds < 120) {
			out.AppendInt(seconds);
			out.Append(" s");
		}
		else if (seconds < 7200) {
			out.AppendInt(seconds / 60);
			out.Append(" min");
		}
		else {
			out.AppendInt(seconds / 3600);
			out.Append(" h");
		}
		return out.ToString();
	}

	// --- The chat's tasks (Chats members) ----------------------------------------------------------------------------

	BackgroundTask* Chats::StartBackground(Chat* chat, Core::StringView kind, Core::StringView title) {
		BackgroundTask* task = new BackgroundTask();
		task->taskId = chat->NextId("bg-");
		task->kind = Core::String(kind);
		task->title = Core::String(title);
		task->state = Core::String("running");
		task->startedMs = ChatNowMs();
		int64 at = 0;
		while (chat->background.Count() >= kBackgroundKept && at < chat->background.Count()) {
			if (!chat->background[at]->Running() && chat->background[at]->told) chat->background.RemoveAt(at);
			else at += 1;
		}
		chat->background.Push(task);
		BackgroundChanged(chat);
		return task;
	}

	void Chats::BackgroundChanged(Chat* chat) {
		IED::JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("tasks"));
		chat->WriteBackground(data);
		data.EndObject();
		Publish(chat, "background.changed", data.View());
		Changed(chat);
	}

	bool Chats::HasUntold(const Chat* chat) const {
		for (BackgroundTask* task : chat->background)
			if (!task->Running() && !task->told) return true;
		return false;
	}

	static void AppendTold(Core::StringBuilder& out, const BackgroundTask* task) {
		out.Append("- ");
		out.Append(task->taskId.View());
		out.Append(" (");
		out.Append(task->kind.View());
		out.Append(": ");
		out.Append(task->title.View());
		if (!task->agentChatId.IsEmpty()) {
			out.Append(", chat ");
			out.Append(task->agentChatId.View());
		}
		out.Append("): ");
		out.Append(task->summary.View());
		out.Append(" after ");
		out.Append(TaskDuration(task->endedMs - task->startedMs).View());
		Core::String tail = TailOf(task->output.View(), kBackgroundToldLines, kBackgroundToldBytes);
		if (tail.IsEmpty()) {
			out.Append(".\n");
			return;
		}
		out.Append(task->kind == "agent" ? ". Its answer:\n" : ". The end of its output:\n");
		out.Append(tail.View());
		if (!tail.View().EndsWith(Core::StringView("\n"))) out.Append("\n");
	}

	Core::String Chats::TellEnded(Chat* chat) {
		Core::StringBuilder out;
		for (BackgroundTask* task : chat->background) {
			if (task->Running() || task->told) continue;
			if (out.ByteLength() == 0) out.Append("Background tasks you started have ended:\n");
			AppendTold(out, task);
			task->told = true;
		}
		if (out.ByteLength() == 0) return Core::String();
		out.Append("background_status <id> shows more of one. Check what an agent did before you rely on it.");
		BackgroundChanged(chat);
		return out.ToString();
	}

	void Chats::StopBackground(BackgroundTask* task) {
		task->stopAsked = true;
		if (task->agentChatId.IsEmpty()) return;
		for (Chat* agent : chats)
			if (agent->chatId == task->agentChatId && agent->run) {
				agent->run->cancelled = true;
				agent->run->wake.NotifyAll();
			}
	}

	void Chats::BackgroundEnded(Chat* chat, BackgroundTask* task) {
		BackgroundChanged(chat);
		WakeForBackground(chat);
	}

	// An idle chat starts a turn to hear of its ended tasks; a running one hears them at its next step, a paused or
	// waiting one with its next turn.
	void Chats::WakeForBackground(Chat* chat) {
		if (chat->run || chat->state != ChatState::Idle) return;
		Core::String told = TellEnded(chat);
		if (told.IsEmpty()) return;
		OwnerMessage message;
		message.text = told;
		StartTurn(chat, message, 0, "", "background");
	}

	// --- Running them ------------------------------------------------------------------------------------------------

	// Reads a background command's output into its task and the AI output source until it ends, runs out of time or is
	// stopped, then ends the task.
	static void FollowCommand(Chats* chats, Chat* chat, BackgroundTask* task, Process::Child* child, Core::String wsId, int64 seconds) {
		IED::PluginContext* context = chats->context;
		const int64 deadline = ChatNowMs() + seconds * 1000;
		int64 exitedAt = -1;
		Core::String stopped;
		char8[16384] buffer;
		while (child->HasOutput()) {
			bool stop = false;
			{
				IED::HostLock guard(*context);
				stop = task->stopAsked;
			}
			if (stop || ChatNowMs() > deadline) {
				stopped = Core::String(stop ? "stopped" : "ran out of time and was stopped");
				child->Kill();
				break;
			}
			if (exitedAt < 0 && child->Wait(0) != Process::kTimedOut) exitedAt = ChatNowMs();
			if (exitedAt >= 0 && ChatNowMs() - exitedAt > kBackgroundDrainMs) break;
			Process::Stream from;
			const int64 got = child->ReadAny((void*)&buffer[0], 16384, from, kBackgroundReadPollMs);
			if (got > 0) {
				Core::StringView text = Core::StringView(&buffer[0], got);
				context->Output(wsId.View(), Core::StringView(kAiOutputSource), text);
				IED::HostLock guard(*context);
				task->output = IED::BoundedText(task->output.View(), text, kBackgroundKeptBytes);
			}
			else if (got != Process::kTimedOut && got != 0) break;
		}
		const int64 code = child->Wait(5000);
		IED::HostLock guard(*context);
		task->endedMs = ChatNowMs();
		task->exitCode = stopped.IsEmpty() ? code : -1;
		task->state = Core::String(!stopped.IsEmpty() ? "stopped" : code == 0 ? "done" : "failed");
		Core::StringBuilder summary;
		if (stopped.IsEmpty()) {
			summary.Append("exit ");
			summary.AppendInt(code);
		}
		else summary.Append(stopped.View());
		task->summary = summary.ToString();
		chats->BackgroundEnded(chat, task);
	}

	static ToolInvocation* HeldCall(const ToolInvocation& call, BackgroundTask* task) {
		ToolInvocation* held = new ToolInvocation();
		held->context = call.context;
		held->ws = call.ws;
		held->chat = call.chat;
		held->callId = call.callId;
		held->args = call.args;
		held->cancelled = &task->stopAsked;
		return held;
	}

	static Core::String Started(const BackgroundTask* task, Core::StringView what) {
		Core::StringBuilder out;
		out.Append("Started background task ");
		out.Append(task->taskId.View());
		out.Append(": ");
		out.Append(what);
		out.Append(". Go on with other work: you are told when it ends. background_status ");
		out.Append(task->taskId.View());
		out.Append(" shows it so far, background_wait waits for it, background_stop stops it.");
		return out.ToString();
	}

	static ToolOutcome StartCommand(Chats* chats, Chat* chat, const ToolInvocation& call) {
		ToolCommand command = ShellCommandOf(call, kBackgroundDefaultSeconds, kBackgroundMostSeconds);
		BackgroundTask* task = nullptr;
		{
			IED::HostLock guard(*call.context);
			task = chats->StartBackground(chat, Core::StringView("command"), command.shell.View());
		}
		Core::String problem;
		Process::Child* child = StartToolCommand(*HeldCall(call, task), command, problem);
		if (!child) {
			IED::HostLock guard(*call.context);
			task->state = Core::String("failed");
			task->summary = problem;
			task->endedMs = ChatNowMs();
			task->told = true;
			chats->BackgroundChanged(chat);
			return ToolError(problem.View());
		}
		Core::String wsId = call.ws.id;
		const int64 seconds = command.seconds;
		call.context->StartThread([chats, chat, task, child, wsId, seconds]() { FollowCommand(chats, chat, task, child, wsId, seconds); });
		ToolOutcome outcome = ToolResult(Started(task, (Core::String("`") + command.shell.View() + "`").View()).View(), (task->taskId + " started").View());
		outcome.source = Core::String("Output: AI");
		return outcome;
	}

	static Core::String TaskTitle(const ToolInvocation& call) {
		Core::String title = call.args.Member("task").IsValid() ? Core::String(call.args.Member("task").AsView()) : Core::String("build");
		if (call.args.Member("project").IsValid()) title = (title + " of ") + call.args.Member("project").AsView();
		return title;
	}

	static ToolOutcome StartBuild(Chats* chats, Chat* chat, const ToolInvocation& call) {
		BackgroundTask* task = nullptr;
		{
			IED::HostLock guard(*call.context);
			task = chats->StartBackground(chat, Core::StringView("task"), TaskTitle(call).View());
		}
		ToolInvocation* held = HeldCall(call, task);
		call.context->StartThread([chats, chat, task, held]() {
			ToolOutcome outcome = BuildRun(*held);
			IED::HostLock guard(*held->context);
			task->endedMs = ChatNowMs();
			task->exitCode = outcome.isError ? 1 : 0;
			task->state = Core::String(task->stopAsked ? "stopped" : outcome.isError ? "failed" : "done");
			const int64 lineEnd = outcome.content.View().IndexOf('\n', 0);
			task->summary = Core::String(lineEnd < 0 ? outcome.content.View() : outcome.content.View().Substring(0, lineEnd));
			task->output = IED::BoundedText(Core::StringView(""), outcome.content.View(), kBackgroundKeptBytes);
			chats->BackgroundEnded(chat, task);
		});
		ToolOutcome outcome = ToolResult(Started(task, (Core::String("the ") + TaskTitle(call).View() + " task").View()).View(), (task->taskId + " started").View());
		outcome.source = Core::String("Output: Build");
		return outcome;
	}

	// --- The tools ---------------------------------------------------------------------------------------------------

	static void StatusLine(Core::StringBuilder& out, const BackgroundTask* task) {
		out.Append(task->taskId.View());
		out.Append(" ");
		out.Append(task->state.View());
		out.Append(" ");
		out.Append(TaskDuration((task->Running() ? ChatNowMs() : task->endedMs) - task->startedMs).View());
		out.Append(": ");
		out.Append(task->kind.View());
		out.Append(" ");
		out.Append(task->title.View());
		if (!task->agentChatId.IsEmpty()) {
			out.Append(" (chat ");
			out.Append(task->agentChatId.View());
			out.Append(")");
		}
		if (!task->Running() && !task->summary.IsEmpty()) {
			out.Append(" - ");
			out.Append(task->summary.View());
		}
		out.Append("\n");
	}

	// One task with its output's end; an ended one is told by this.
	static Core::String TaskText(BackgroundTask* task) {
		Core::StringBuilder out;
		StatusLine(out, task);
		Core::String tail = TailOf(task->output.View(), kShellTailLines, kShellTailBytes);
		if (!tail.IsEmpty()) {
			out.Append(task->kind == "agent" ? "Its answer:\n" : task->Running() ? "Its output so far (the end):\n" : "The end of its output:\n");
			out.Append(tail.View());
		}
		else if (task->Running()) out.Append("No output yet.");
		if (!task->Running()) task->told = true;
		return out.ToString();
	}

	static ToolPlan BackgroundPlan(const ToolInvocation& call, const char* kind) {
		ToolPlan plan;
		Core::StringView id = call.args.Member("id").AsView();
		plan.subject = ((Core::String(kind) + "(") + (id.IsEmpty() ? Core::StringView("*") : id)) + ")";
		plan.summary = Core::String(kind) + (id.IsEmpty() ? Core::String() : Core::String(" ") + id);
		return plan;
	}

	static ToolOutcome StatusRun(Chats* chats, Chat* chat, const ToolInvocation& call) {
		IED::HostLock guard(*call.context);
		Core::StringView id = call.args.Member("id").AsView();
		if (!id.IsEmpty()) {
			BackgroundTask* task = chat->FindBackground(id);
			if (!task) return ToolError((Core::String("background_status: this chat has no task ") + id).View());
			Core::String text = TaskText(task);
			chats->BackgroundChanged(chat);
			return ToolResult(text.View(), (task->taskId + " " + task->state.View()).View());
		}
		if (chat->background.IsEmpty()) return ToolResult(Core::StringView("This chat has started no background task."), Core::StringView("none"));
		Core::StringBuilder out;
		int64 running = 0;
		for (BackgroundTask* task : chat->background) {
			StatusLine(out, task);
			if (task->Running()) running += 1;
		}
		Core::StringBuilder preview;
		preview.AppendInt(running);
		preview.Append(" running of ");
		preview.AppendInt(chat->background.Count());
		return ToolResult(out.View(), preview.View());
	}

	// The task `id` names; else one that ended and was not told, else the first running one; null with `problem`, which
	// lists how the chat's tasks went when none runs.
	static BackgroundTask* Awaited(Chat* chat, Core::StringView id, Core::String& problem) {
		if (!id.IsEmpty()) {
			BackgroundTask* task = chat->FindBackground(id);
			if (!task) problem = Core::String("background_wait: this chat has no task ") + id;
			return task;
		}
		for (BackgroundTask* task : chat->background)
			if (!task->Running() && !task->told) return task;
		for (BackgroundTask* task : chat->background)
			if (task->Running()) return task;
		Core::StringBuilder out;
		out.Append("background_wait: no background task is running");
		out.Append(chat->background.IsEmpty() ? "." : "; they ended:\n");
		for (BackgroundTask* task : chat->background) StatusLine(out, task);
		problem = out.ToString();
		return nullptr;
	}

	static ToolOutcome WaitRun(Chats* chats, Chat* chat, const ToolInvocation& call) {
		const int64 seconds = call.args.Member("seconds").IsValid() ? call.args.Member("seconds").AsInt() : kBackgroundWaitDefaultSeconds;
		const int64 deadline = ChatNowMs() + (seconds < 1 || seconds > kBackgroundWaitMostSeconds ? kBackgroundWaitMostSeconds : seconds) * 1000;
		Core::StringView id = call.args.Member("id").AsView();
		for (;;) {
			{
				IED::HostLock guard(*call.context);
				Core::String problem;
				BackgroundTask* task = Awaited(chat, id, problem);
				if (!task) return ToolError(problem.View());
				if (!task->Running()) {
					Core::String text = TaskText(task);
					chats->BackgroundChanged(chat);
					return ToolResult(text.View(), (task->taskId + " " + task->state.View()).View());
				}
				if (*call.cancelled) return ToolError(Core::StringView("background_wait: the run was stopped"));
				if (ChatNowMs() > deadline) {
					Core::StringBuilder out;
					out.Append("background_wait: ");
					out.Append(task->taskId.View());
					out.Append(" is still running; wait again, or go on - you are told when it ends.\n");
					out.Append(TaskText(task).View());
					return ToolResult(out.View(), (task->taskId + " still running").View());
				}
			}
			Threading::Thread::Sleep(kBackgroundPollNs);
		}
	}

	static ToolOutcome StopRun(Chats* chats, Chat* chat, const ToolInvocation& call) {
		IED::HostLock guard(*call.context);
		Core::StringView id = call.args.Member("id").AsView();
		BackgroundTask* task = chat->FindBackground(id);
		if (!task) return ToolError((Core::String("background_stop: this chat has no task ") + id).View());
		if (!task->Running()) return ToolResult((task->taskId + " already ended: " + task->summary.View()).View(), (task->taskId + " ended").View());
		chats->StopBackground(task);
		return ToolResult((Core::String("Stopping ") + task->taskId.View() + "; you are told when it has ended.").View(), (Core::String("stopping ") + task->taskId.View()).View());
	}

	static ToolSpec* BackgroundTool(const char* name, const char* description, const char* parameters, ToolClass toolClass, const char* kind) {
		ToolSpec* spec = new ToolSpec();
		spec->name = Core::String(name);
		spec->description = Core::String(description);
		spec->parameters = Core::String(parameters);
		spec->toolClass = toolClass;
		spec->parallelSafe = toolClass == ToolClass::Read;
		spec->inPlan = true;
		spec->deferred = true;
		spec->group = Core::String("background");
		Core::String subject = Core::String(kind);
		spec->plan = [subject](const ToolInvocation& call) -> ToolPlan { return BackgroundPlan(call, subject.CStr()); };
		return spec;
	}

	// The tool `name` takes `background`: its foreground run otherwise.
	static void Backgrounded(ToolRegistry& registry, const char* name, func<ToolOutcome(const ToolInvocation& call)> start) {
		ToolSpec* spec = registry.Find(Core::StringView(name));
		if (!spec) return;
		ToolRunner foreground = spec->run;
		spec->run = [foreground, start](const ToolInvocation& call) -> ToolOutcome { return call.args.Member("background").AsBool() ? start(call) : foreground(call); };
	}

	void AddBackgroundTools(ToolRegistry& registry, Chats* chats, Chat* chat) {
		Backgrounded(registry, "shell_run", [chats, chat](const ToolInvocation& call) -> ToolOutcome { return StartCommand(chats, chat, call); });
		Backgrounded(registry, "build_run", [chats, chat](const ToolInvocation& call) -> ToolOutcome { return StartBuild(chats, chat, call); });
		ToolSpec* status = BackgroundTool("background_status", "This chat's background tasks (shell_run or build_run with background, agent_run): each one's state and time; with id, one task with the end of its output (an agent's answer). Example: background_status({\"id\": \"bg-3\"})",
			"{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}}, \"additionalProperties\": false}", ToolClass::Read, "background.read");
		status->run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return StatusRun(chats, chat, call); };
		registry.Add(status);
		ToolSpec* wait = BackgroundTool("background_wait", "Wait for a background task to end (id), or for any of this chat's; returns how it ended with the end of its output. seconds: at most 600, 120 by default. You are told when a task ends anyway: wait only when you cannot go on without it. Example: background_wait({\"id\": \"bg-3\", \"seconds\": 300})",
			"{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"seconds\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 600}}, \"additionalProperties\": false}", ToolClass::Read, "background.read");
		wait->parallelSafe = false;
		wait->run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return WaitRun(chats, chat, call); };
		registry.Add(wait);
		ToolSpec* stop = BackgroundTool("background_stop", "Stop one of this chat's background tasks: a command is killed, a task cancelled, an agent's turn stopped. Example: background_stop({\"id\": \"bg-3\"})",
			"{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}}, \"required\": [\"id\"], \"additionalProperties\": false}", ToolClass::Meta, "background.stop");
		stop->run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return StopRun(chats, chat, call); };
		registry.Add(stop);
	}
}
