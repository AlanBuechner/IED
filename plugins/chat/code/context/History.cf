include "api/Plugin.ch"
include "History.ch"

namespace Ai
{
	// The query's words, lowercased; those too short to say anything are left out.
	static Core::Array<Core::String> HistoryWords(Core::StringView query) {
		Core::Array<Core::String> words;
		for (Core::StringView part : query.Split(' ')) {
			Core::StringView word = part.Trimmed();
			if (word.ByteLength() < 3) continue;
			words.Push(word.ToLower());
		}
		return words;
	}

	// Which line of `text` holds byte `at` (0-based) and where it starts.
	static void LineOf(Core::StringView text, int64 at, int64& line, int64& start) {
		line = 0;
		start = 0;
		for (;;) {
			const int64 end = text.IndexOf('\n', start);
			if (end < 0 || end >= at) return;
			start = end + 1;
			line += 1;
		}
	}

	// Where `text`'s line starting at `from` ends, past its line feed.
	static int64 LineAfter(Core::StringView text, int64 from) {
		const int64 end = text.IndexOf('\n', from);
		return end < 0 ? text.ByteLength() : end + 1;
	}

	Core::Array<const Turn*> ChatTurns(const Chat* chat) {
		Core::Array<const Turn*> turns;
		for (const Turn* turn : chat->m_Turns) turns.Push(turn);
		return turns;
	}

	Core::Array<const Turn*> DroppedTurns(const Chat* chat) {
		Core::Array<const Turn*> turns;
		for (const Turn* turn : chat->m_Turns)
			if (turn->m_Compressed) turns.Push(turn);
		return turns;
	}

	// Each word's newest place among `turns`: one scan, the newest kept per word, so a word said fifty times says
	// where it was said last rather than filling the answer with its first pages. Where it was found is kept as
	// indices (-1 for a word nothing says), so nothing depends on an array's fresh slots.
	Core::Array<HistoryHit> SearchTurns(const Core::Array<const Turn*>& turns, Core::StringView query, int64 most) {
		const Core::Array<Core::String> words = HistoryWords(query);
		Core::Array<int64> atTurn;
		Core::Array<int64> atMessage;
		for (int64 w = 0; w < words.Count(); ++w) {
			atTurn.Push(-1);
			atMessage.Push(-1);
		}
		for (int64 i = 0; i < turns.Count(); ++i) {
			for (int64 m = 0; m < turns[i]->m_Messages.Count(); ++m) {
				const Core::StringView text = turns[i]->m_Messages[m]->m_Content.View();
				if (text.IsEmpty()) continue;
				for (int64 w = 0; w < words.Count(); ++w) {
					if (text.IndexOf(words[w].View(), 0) < 0) continue;
					atTurn[w] = i;
					atMessage[w] = m;
				}
			}
		}
		Core::Array<HistoryHit> hits;
		for (int64 w = 0; w < words.Count(); ++w) {
			if (atTurn[w] < 0) continue;
			const Turn* turn = turns[atTurn[w]];
			const Core::StringView text = turn->m_Messages[atMessage[w]]->m_Content.View();
			const int64 at = text.IndexOf(words[w].View(), 0);
			HistoryHit hit;
			hit.m_Turn = turn;
			hit.m_Message = atMessage[w];
			hit.m_At = at;
			LineOf(text, at, hit.m_Line, hit.m_Start);
			hits.Push(hit);
		}
		for (int64 i = 1; i < hits.Count(); ++i) {   // in the order the conversation went
			for (int64 j = i; j > 0 && hits[j].m_Turn->m_StartedMs < hits[j - 1].m_Turn->m_StartedMs; --j) {
				const HistoryHit kept = hits[j];
				hits[j] = hits[j - 1];
				hits[j - 1] = kept;
			}
		}
		if (most <= 0 || hits.Count() <= most) return hits;
		Core::Array<HistoryHit> kept;
		for (int64 i = hits.Count() - most; i < hits.Count(); ++i) kept.Push(hits[i]);
		return kept;
	}

	// A turn's messages as the model was sent them: who said what, and what was called.
	static void WriteMessageLine(Core::StringBuilder& out, const ModelMessage* message) {
		out.Append(message->m_Role.View());
		out.Append(": ");
		const Core::StringView text = message->m_Content.View();
		out.Append(text.Substring(0, text.ByteLength() < c_HistoryLineBytes ? text.ByteLength() : c_HistoryLineBytes));
		if (text.ByteLength() > c_HistoryLineBytes) out.Append(" [...]");
		if (!message->m_ToolCalls.IsEmpty()) {
			out.Append(" [called ");
			out.Append(message->m_ToolCalls.View().Substring(0, 160));
			out.Append("]");
		}
		out.Append("\n");
	}

	Core::String TurnDigest(const Turn* turn, int64 most) {
		Core::StringBuilder out;
		int64 bytes = 0;
		for (const ModelMessage* message : turn->m_Messages) {
			WriteMessageLine(out, message);
			bytes += message->m_Content.ByteLength() < c_HistoryLineBytes ? message->m_Content.ByteLength() : c_HistoryLineBytes;
			if (bytes >= most) {
				out.Append("[and more in this turn]\n");
				break;
			}
		}
		return out.ToString();
	}

	static void AppendCount(Core::StringBuilder& out, int64 count) {
		out.AppendByte('0' + (int32)(count < 9 ? count : 9));
	}

	static ToolOutcome SearchRun(Chat* chat, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		const Core::StringView query = call.m_Args.Member("query").AsView().Trimmed();
		if (query.IsEmpty()) return ToolError(Core::StringView("history_search: name the words to look for"));
		const Core::Array<const Turn*> every = ChatTurns(chat);
		// The turns the context does not hold first: that is what this tool is for. When none of them matches, the
		// whole chat is searched, so the answer is "it was said in a turn you still have" rather than "nothing".
		Core::Array<HistoryHit> hits = SearchTurns(DroppedTurns(chat), query, c_HistorySearchMost);
		const bool fromDropped = !hits.IsEmpty();
		if (hits.IsEmpty()) hits = SearchTurns(every, query, c_HistorySearchMost);
		if (hits.IsEmpty()) {
			Core::StringBuilder said;
			said.Append("history_search: nothing in this chat's ");
			AppendCount(said, every.Count());
			said.Append(" turns holds '");
			said.Append(query);
			said.Append("'; it may be in another chat (chat_list) or never was");
			return ToolResult(said.View(), Core::StringView("nothing found"));
		}
		Core::StringBuilder out;
		out.Append("history_search: where each of '");
		out.Append(query);
		out.Append("'s words was said last");
		if (fromDropped) out.Append(" - in turns your context does not hold any more");
		out.Append(". history_read {turn} gives one whole:\n");
		for (const HistoryHit& hit : hits) {
			const Core::StringView text = hit.m_Turn->m_Messages[hit.m_Message]->m_Content.View();
			const int64 start = hit.m_Start;
			const int64 end = LineAfter(text, start);
			out.Append("- ");
			out.Append(hit.m_Turn->m_TurnId.View());
			if (hit.m_Turn->m_Compressed) out.Append(" (left out)");
			out.Append(": ");
			out.Append(text.Substring(start, end - start < c_HistoryLineBytes ? end - start : c_HistoryLineBytes).Trimmed());
			out.Append("\n");
		}
		Core::StringBuilder said;
		said.Append("history_search: ");
		AppendCount(said, hits.Count());
		said.Append(" places");
		return ToolResult(out.View(), said.View());
	}

	static ToolOutcome ReadRun(Chat* chat, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		const Core::StringView wanted = call.m_Args.Member("turn").AsView();
		int64 most = call.m_Args.Member("turns").IsValid() ? call.m_Args.Member("turns").AsInt() : 1;
		most = most < 1 ? 1 : most > c_HistoryReadTurnsMost ? c_HistoryReadTurnsMost : most;
		int64 at = -1;
		for (int64 i = 0; i < chat->m_Turns.Count(); ++i)
			if (chat->m_Turns[i]->m_TurnId.View() == wanted) at = i;
		if (at < 0) return ToolError((Core::String("history_read: this chat has no turn ") + wanted).View());
		Core::StringBuilder out;
		for (int64 i = at; i < at + most && i < chat->m_Turns.Count(); ++i) {
			const Turn* turn = chat->m_Turns[i];
			out.Append("## Turn ");
			out.Append(turn->m_TurnId.View());
			out.Append(turn->m_Compressed ? Core::StringView(" (your context does not hold this one: compression left it out)") : Core::StringView("\n"));
			out.Append(TurnDigest(turn, c_HistoryTurnBytes).View());
		}
		return ToolResult(out.View(), (Core::String("history_read: ") + wanted).View());
	}

	static ToolPlan HistoryPlan(const ToolInvocation& call, Core::StringView kind) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("chat.history(") + kind) + ")";
		return plan;
	}

	static ToolSpec* HistorySpec(const char* name, const char* description, const char* parameters) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = ToolClass::Read;
		spec->m_ParallelSafe = true;
		spec->m_InPlan = true;
		spec->m_Deferred = true;   // named in the system message, sent only once loaded: a long chat's turn definitions stay small
		spec->m_Group = Core::String("chats");
		return spec;
	}

	void AddHistoryTools(ToolRegistry& registry, Chat* chat) {
		ToolSpec* search = HistorySpec("history_search", "Find what this chat said in turns its context does not hold any more - the ones compression left out, named in the note it gave you. Words, not a pattern; where each was said last. Example: history_search({\"query\": \"the dock layout\"})",
			"{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"minLength\": 1}}, \"required\": [\"query\"], \"additionalProperties\": false}");
		search->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return HistoryPlan(call, Core::StringView("search")); };
		search->m_Run = [chat](const ToolInvocation& call) -> ToolOutcome { return SearchRun(chat, call); };
		registry.Add(search);
		ToolSpec* read = HistorySpec("history_read", "One of this chat's earlier turns whole: its messages and what it called. history_search names turns; `turns` reads that many from it. Example: history_read({\"turn\": \"u462\"})",
			"{\"type\": \"object\", \"properties\": {\"turn\": {\"type\": \"string\", \"minLength\": 1}, \"turns\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 4}}, \"required\": [\"turn\"], \"additionalProperties\": false}");
		read->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return HistoryPlan(call, Core::StringView("read")); };
		read->m_Run = [chat](const ToolInvocation& call) -> ToolOutcome { return ReadRun(chat, call); };
		registry.Add(read);
	}
}
