include "Superseded.ch"

namespace Ai
{
	// A call as a later one can make it stale: its tool, the file it names and its arguments.
	class FileCall
	{
		public Core::String m_CallId;
		public Core::String m_Tool;
		public Core::String m_Path;
		public Core::String m_Args;
		public int64 m_At;   // the index of the message that made it
	}

	static Serialization::DomNode Parsed(Core::StringView text) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text, *doc);
		return read.Ok() ? read.root : Serialization::DomNode();
	}

	static bool NamesFile(Core::StringView tool) { return tool == "fs_read" || tool == "fs_write" || tool == "fs_edit"; }

	static Core::Array<FileCall*> FileCalls(const Core::Array<ModelMessage*>& messages) {
		Core::Array<FileCall*> calls;
		for (int64 i = 0; i < messages.Count(); ++i) {
			if (messages[i]->m_ToolCalls.IsEmpty()) continue;
			Serialization::DomNode list = Parsed(messages[i]->m_ToolCalls.View());
			for (int64 k = 0; k < list.Count(); ++k) {
				Serialization::DomNode function = list.At(k).Member("function");
				if (!NamesFile(function.Member("name").AsView())) continue;
				FileCall* call = new FileCall();
				call->m_CallId = Core::String(list.At(k).Member("id").AsView());
				call->m_Tool = Core::String(function.Member("name").AsView());
				call->m_Args = Core::String(function.Member("arguments").AsView());
				call->m_Path = Core::String(Parsed(call->m_Args.View()).Member("path").AsView());
				call->m_At = i;
				if (!call->m_Path.IsEmpty()) calls.Push(call);
			}
		}
		return calls;
	}

	static FileCall* CallOf(const Core::Array<FileCall*>& calls, Core::StringView callId) {
		for (FileCall* call : calls)
			if (call->m_CallId.View() == callId) return call;
		return nullptr;
	}

	// Why the read `read` is stale ("" when it is not): the later call of its file that made it so.
	static Core::String StaleBecause(const Core::Array<FileCall*>& calls, const FileCall* read) {
		for (FileCall* later : calls) {
			if (later->m_At <= read->m_At || later->m_Path != read->m_Path) continue;
			if (later->m_Tool != "fs_read") return ((Core::String("[out of date: ") + read->m_Path.View()) + " was changed later by " + later->m_Tool.View()) + "; read it again if you need it]";
			if (later->m_Args == read->m_Args) return (Core::String("[superseded: ") + read->m_Path.View()) + " was read again later]";
		}
		return Core::String();
	}

	int64 DropSuperseded(const Core::Array<ModelMessage*>& messages, int64 keepFrom) {
		Core::Array<FileCall*> calls = FileCalls(messages);
		int64 dropped = 0;
		for (int64 i = 0; i < messages.Count() && i < keepFrom; ++i) {
			ModelMessage* message = messages[i];
			if (message->m_Role != "tool") continue;
			FileCall* call = CallOf(calls, message->m_ToolCallId.View());
			if (!call || call->m_Tool != "fs_read") continue;
			Core::String because = StaleBecause(calls, call);
			if (because.IsEmpty() || message->m_Shown == because) continue;
			message->m_Shown = because;
			message->m_ImagesOut = !message->m_Images.IsEmpty();
			dropped += 1;
		}
		return dropped;
	}
}
