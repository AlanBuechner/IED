include "api/plugin.ch"
include "permissions.ch"

namespace Ai
{
	static Core::Array<Core::String> RuleList(const Serialization::DomNode& list) {
		Core::Array<Core::String> rules;
		for (int64 i = 0; list.Kind() == Serialization::DomKind::Array && i < list.Count(); ++i) rules.Push(Core::String(list.At(i).AsView()));
		return rules;
	}

	PermissionRules ReadPermissionRules(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(json, *doc);
		PermissionRules rules;
		if (!read.Ok()) return rules;
		rules.allow = RuleList(read.root.Member("allow"));
		rules.confirm = RuleList(read.root.Member("confirm"));
		rules.deny = RuleList(read.root.Member("deny"));
		return rules;
	}

	// '*' any run of characters, everything else itself; ASCII case is ignored.
	static bool Wildcard(Core::StringView pattern, Core::StringView text) {
		if (pattern.IsEmpty()) return text.IsEmpty();
		if (pattern.ByteAt(0) == '*') {
			for (int64 skip = 0; skip <= text.ByteLength(); ++skip)
				if (Wildcard(pattern.Substring(1, pattern.ByteLength() - 1), text.Substring(skip, text.ByteLength() - skip))) return true;
			return false;
		}
		if (text.IsEmpty()) return false;
		int32 a = pattern.ByteAt(0);
		int32 b = text.ByteAt(0);
		if (a >= 'A' && a <= 'Z') a += 32;
		if (b >= 'A' && b <= 'Z') b += 32;
		return a == b && Wildcard(pattern.Substring(1, pattern.ByteLength() - 1), text.Substring(1, text.ByteLength() - 1));
	}

	// "kind(pattern)" split; false when `text` is not that shape.
	static bool SplitSubject(Core::StringView text, Core::StringView& kind, Core::StringView& pattern) {
		const int64 open = text.IndexOf(Core::StringView("("));
		if (open <= 0 || !text.EndsWith(Core::StringView(")"))) return false;
		kind = text.Substring(0, open);
		pattern = text.Substring(open + 1, text.ByteLength() - open - 2);
		return true;
	}

	bool RuleMatches(Core::StringView rule, Core::StringView subject) {
		Core::StringView ruleKind;
		Core::StringView rulePattern;
		Core::StringView kind;
		Core::StringView argument;
		if (!SplitSubject(rule, ruleKind, rulePattern) || !SplitSubject(subject, kind, argument)) return false;
		if (!Wildcard(ruleKind, kind)) return false;
		return kind.StartsWith(Core::StringView("fs.")) ? IED::GlobMatch(rulePattern, argument) : Wildcard(rulePattern, argument);
	}

	static bool AnyMatches(const Core::Array<Core::String>& rules, Core::StringView subject, Core::String& matched) {
		for (const Core::String& rule : rules) {
			if (!RuleMatches(rule.View(), subject)) continue;
			matched = rule;
			return true;
		}
		return false;
	}

	static const char* ClassWord(ToolClass toolClass) { return toolClass == ToolClass::Write ? "edits" : "commands"; }

	Permit Decide(PermissionMode mode, ToolClass toolClass, const PermissionRules& rules, const Core::Array<Core::String>& allowedForChat, Core::StringView subject, Core::String& why) {
		Core::String rule;
		if (AnyMatches(rules.deny, subject, rule)) {
			why = Core::String("denied by the rule ") + rule.View();
			return Permit::Deny;
		}
		if (AnyMatches(rules.confirm, subject, rule)) {
			why = Core::String("the rule ") + rule.View() + " asks every time";
			return Permit::Ask;
		}
		if (toolClass == ToolClass::Read || toolClass == ToolClass::Meta) return Permit::Allow;
		if (mode == PermissionMode::Plan) {
			why = Core::String("permission \"plan\" allows no ") + ClassWord(toolClass);
			return Permit::Deny;
		}
		if (mode == PermissionMode::Auto) return Permit::Allow;
		if (mode == PermissionMode::AcceptEdits && toolClass == ToolClass::Write) return Permit::Allow;
		if (AnyMatches(rules.allow, subject, rule) || AnyMatches(allowedForChat, subject, rule)) return Permit::Allow;
		why = (Core::String("permission \"") + PermissionModeName(mode)) + "\" asks for " + ClassWord(toolClass) + "; no rule matched";
		return Permit::Ask;
	}

	Core::String ChatAllowRule(Core::StringView subject) {
		Core::StringView kind;
		Core::StringView argument;
		if (!SplitSubject(subject, kind, argument)) return Core::String(subject);
		if (kind == "fs.write") {
			int64 slash = argument.ByteLength() - 1;
			while (slash >= 0 && argument.ByteAt(slash) != '/') slash -= 1;
			return slash < 0 ? Core::String("fs.write(*)") : (Core::String("fs.write(") + argument.Substring(0, slash)) + "/**)";
		}
		if (kind == "shell") {
			const int64 space = argument.IndexOf(Core::StringView(" "));
			return space < 0 ? Core::String(subject) : (Core::String("shell(") + argument.Substring(0, space)) + " *)";
		}
		return Core::String(subject);
	}
}
