include "api/plugin.ch"
include "resources.ch"

namespace Ai
{
	// {chatId, ref, title?, kind?, close?, open?}: `open` false takes the tab off the chat's list; `close` the UI command
	// that closes the thing for good, which the side panel's Force close runs with {ref}.
	static IED::Result ChatResourceCall(IED::PluginContext* context, Chats* chats, const Serialization::DomNode& args) {
		IED::HostLock guard(*context);
		Core::StringView ref = args.Member("ref").AsView();
		if (ref.IsEmpty()) return IED::Refusal(Core::StringView("ref is empty"));
		Chat* chat = nullptr;
		try {
			chat = chats->Get(args.Member("chatId").AsView());
		}
		catch (IED::RpcError& error) {
			return IED::Refusal(error.message.View());
		}
		const bool open = !args.Member("open").IsValid() || args.Member("open").AsBool();
		int64 at = -1;
		for (int64 i = 0; i < chat->resources.Count(); ++i)
			if (chat->resources[i]->ref.View() == ref) at = i;
		if (!open && at >= 0) chat->resources.RemoveAt(at);
		if (open) {
			ChatResource* resource = at >= 0 ? chat->resources[at] : new ChatResource();
			resource->ref = Core::String(ref);
			if (args.Member("title").IsValid()) resource->title = Core::String(args.Member("title").AsView());
			if (args.Member("kind").IsValid()) resource->kind = Core::String(args.Member("kind").AsView());
			if (args.Member("close").IsValid()) resource->close = Core::String(args.Member("close").AsView());
			if (at < 0) chat->resources.Push(resource);
		}
		IED::JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("resources"));
		chat->WriteResources(data);
		data.EndObject();
		chats->Publish(chat, "resources.changed", data.View());
		return IED::Answer(Core::StringView("{}"));
	}

	// {chatId} -> {state, running}: `running` while a turn is in flight, waiting on an approval or answer included; a
	// deleted chat (kept among the deleted until purged) is {state: "deleted", running: false, deleted: true}, so what a
	// plugin kept open for it can close (docs/27).
	static IED::Result ChatStateCall(IED::PluginContext* context, Chats* chats, const Serialization::DomNode& args) {
		IED::HostLock guard(*context);
		Chat* chat = nullptr;
		try {
			chat = chats->Get(args.Member("chatId").AsView());
		}
		catch (IED::RpcError& error) {
			if (chats->IsDeleted(args.Member("chatId").AsView())) return IED::Answer(Core::StringView("{\"state\":\"deleted\",\"running\":false,\"deleted\":true}"));
			return IED::Refusal(error.message.View());
		}
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("state", ChatStateName(chat->state));
		data.BoolField("running", chat->run != nullptr);
		data.EndObject();
		return IED::Answer(data.View());
	}

	void ProvideChatResources(IED::PluginContext& context, Chats* chats) {
		IED::PluginContext* at = &context;
		context.Provide(Core::StringView("chat.resource"), [at, chats](const Serialization::DomNode& args) -> IED::Result { return ChatResourceCall(at, chats, args); });
		context.Provide(Core::StringView("chat.state"), [at, chats](const Serialization::DomNode& args) -> IED::Result { return ChatStateCall(at, chats, args); });
	}
}
