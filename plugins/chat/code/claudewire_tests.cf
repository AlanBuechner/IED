// claudewire: the plan's usage from get_usage and rate_limit_events, pace and the pacing pick, a response from the CLI's
// stream events, its errors, and the lines IED writes to the CLI (docs/04 "The Claude Code provider").

include "api/plugin.ch"
include "claudewire.ch"
include "claudecli.ch"
include "pacing.ch"

static Core::StringView Text(const char* text) { return Core::StringView(text); }

static Serialization::DomNode Parse(const char* json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	return Serialization::ReadJson(Text(json), *doc).root;
}

static const int64 kNow = 1761150000000;   // 2025-10-22T16:20:00Z

static Ai::UsageWindow* Window(Ai::ClaudeUsage& usage, const char* id, double used, int64 resetsInMs) {
	Ai::UsageWindow* window = usage.Window(Text(id));
	window->utilization = used;
	window->resetsAtMs = kNow + resetsInMs;
	return window;
}

static Ai::ClaudeUsage* Plan() {
	Ai::ClaudeUsage* usage = new Ai::ClaudeUsage();
	usage->known = true;
	usage->available = true;
	return usage;
}

static Ai::ChainPlace* Place(const char* model, Ai::PlaceState state, double over) {
	Ai::ChainPlace* place = new Ai::ChainPlace();
	place->model = Core::String(model);
	place->claude = true;
	place->state = state;
	place->over = over;
	return place;
}

static Ai::ModelProfile* Claude(const char* name, const char* model) {
	Ai::ModelProfile* profile = new Ai::ModelProfile();
	profile->name = Core::String(name);
	profile->model = Core::String(model);
	profile->provider = Ai::Provider::ClaudeCode;
	return profile;
}

static void Touch(const FS::Path& file) {
	FS::MakeDirectories(file.Parent().CStr());
	FS::WriteFileAtomically(file.CStr(), (const void*)"", 0);
}

static Ai::ClaudeResponse* Streamed(const char* events) {
	Ai::ClaudeResponse* response = new Ai::ClaudeResponse();
	Serialization::DomNode list = Parse(events);
	Core::Array<Ai::ClaudeDelta> deltas;
	for (int64 i = 0; i < list.Count(); ++i) response->Take(list.At(i), deltas);
	return response;
}

[test("server.ai.claude")]
class ClaudeWireTests {
	[test("iso_times")]
	public static void TestIso() {
		assert_true(Ai::IsoToMs(Text("1970-01-01T00:00:00Z")) == 0, "the epoch");
		assert_true(Ai::IsoToMs(Text("2025-10-22T16:20:00.250+00:00")) == kNow + 250, "fraction and offset");
		assert_true(Ai::IsoToMs(Text("2025-10-22T18:20:00+02:00")) == kNow, "an offset east of UTC");
		assert_true(Ai::IsoToMs(Text("not a time")) == 0 && Ai::IsoToMs(Text("")) == 0, "not one");
	}

	[test("get_usage_answer")]
	public static void TestReadUsage() {
		Ai::ClaudeUsage usage;
		const bool read = Ai::ReadUsage(Parse("{\"subscription_type\": \"max\", \"rate_limits_available\": true, \"rate_limits\": {\"five_hour\": {\"utilization\": 42.5, \"resets_at\": \"2025-10-22T18:20:00Z\"}, \"seven_day\": {\"utilization\": 61, \"resets_at\": \"2025-10-25T16:20:00Z\"}, \"seven_day_opus\": null, \"seven_day_sonnet\": {\"utilization\": null, \"resets_at\": null}, \"model_scoped\": [{\"display_name\": \"Fable\", \"utilization\": 12, \"resets_at\": \"2025-10-25T16:20:00Z\"}], \"extra_usage\": {\"is_enabled\": false, \"utilization\": null}}}"), usage, kNow);
		assert_true(read && usage.known && usage.available, "an answer with the plan's limits");
		assert_se("max", usage.plan.CStr(), "the plan");
		assert_true(usage.windows.Count() == 3, "five_hour, seven_day and Fable's week; the null ones left out");
		Ai::UsageWindow* session = usage.Find(Text("five_hour"));
		assert_true(session && session->utilization == 42.5 && session->resetsAtMs == kNow + 2 * 3600 * 1000 && session->lengthMs == Ai::kSessionWindowMs, "the session");
		Ai::UsageWindow* fable = usage.Find(Text("model:fable"));
		assert_true(fable && fable->model == "fable" && fable->label == "Fable week", "a model_scoped window");
		assert_true(Ai::ModelWindow(usage, Text("claude-fable-5-1[1m]")) == fable, "found by its model's id");
		assert_true(!usage.extraEnabled && usage.extraUtilization < 0, "no extra usage");
		usage.Forget();
		assert_true(!usage.known && usage.windows.IsEmpty() && usage.plan.IsEmpty() && usage.updatedMs == 0, "forgotten when the CLI signs out");
		Ai::ClaudeUsage signedOut;
		assert_true(Ai::ReadUsage(Parse("{\"subscription_type\": null, \"rate_limits_available\": false, \"rate_limits\": null}"), signedOut, kNow) && !signedOut.available && signedOut.windows.IsEmpty(), "no plan");
		assert_true(!Ai::ReadUsage(Parse("{\"other\": 1}"), signedOut, kNow), "not an answer");
	}

	[test("rate_limit_events")]
	public static void TestRateLimit() {
		Ai::ClaudeUsage usage;
		Ai::TakeRateLimit(Parse("{\"status\": \"allowed_warning\", \"rateLimitType\": \"seven_day\", \"utilization\": 0.81, \"resetsAt\": 1761400000, \"unifiedWindows\": {\"five_hour\": {\"utilization\": 0.3, \"resetsAt\": 1761160000}}}"), usage, kNow);
		assert_true(usage.known && usage.available, "a plan's event");
		assert_se("allowed_warning", usage.status.CStr(), "its status");
		Ai::UsageWindow* week = usage.Find(Text("seven_day"));
		assert_true(week && week->utilization > 80.9 && week->utilization < 81.1 && week->resetsAtMs == (int64)1761400000 * 1000, "the window it names, 0-1 made percent");
		Ai::UsageWindow* session = usage.Find(Text("five_hour"));
		assert_true(session && session->utilization > 29.9 && session->utilization < 30.1, "the unified windows");
		Ai::TakeRateLimit(Parse("{\"status\": \"rejected\", \"rateLimitType\": \"five_hour\", \"resetsAt\": 1761160000}"), usage, kNow);
		assert_true(Ai::UsedUp(*usage.Find(Text("five_hour")), kNow), "a rejected window is used up until it resets");
		Ai::ClaudeUsage apiKey;
		Ai::TakeRateLimit(Parse("{\"status\": \"allowed\"}"), apiKey, kNow);
		assert_true(!apiKey.known, "an event that names no plan window");
	}

	[test("pace")]
	public static void TestPace() {
		Ai::ClaudeUsage* usage = Plan();
		Ai::UsageWindow* half = Window(*usage, "five_hour", 50, Ai::kSessionWindowMs / 2);
		assert_true(Ai::Through(*half, kNow) > 0.49 && Ai::Through(*half, kNow) < 0.51, "half way through");
		assert_true(Ai::Pace(*half, kNow) > 0.99 && Ai::Pace(*half, kNow) < 1.01, "half used half way: on the even line");
		Ai::UsageWindow* early = Window(*usage, "seven_day", 2, Ai::kWeekWindowMs - 3600 * 1000);
		assert_true(Ai::Pace(*early, kNow) == 0.0, "an hour into the week with 2% used counts as no pace");
		Ai::UsageWindow* reset = Window(*usage, "seven_day_opus", 90, -1000);
		assert_true(Ai::Pace(*reset, kNow) == 0.0 && !Ai::UsedUp(*reset, kNow), "a window past its reset");
	}

	[test("pace_against_a_target")]
	public static void TestPaceAgainst() {
		Core::String why;
		Ai::ClaudeUsage* busy = Plan();
		Window(*busy, "five_hour", 20, Ai::kSessionWindowMs / 2);
		Window(*busy, "seven_day", 60, Ai::kWeekWindowMs / 2);
		const double both = Ai::PaceAgainst(*busy, Text("opus"), Text("both"), kNow, why);
		assert_true(both > 1.19 && both < 1.21, "the week's 1.2x is the worse");
		assert_se("the week is at 1.20x pace", why.CStr(), "why");
		const double session = Ai::PaceAgainst(*busy, Text("opus"), Text("session"), kNow, why);
		assert_true(session > 0.39 && session < 0.41 && why.View().Contains(Text("5-hour session")), "against the session only");
		Ai::ClaudeUsage* opusWeek = Plan();
		Window(*opusWeek, "seven_day", 10, Ai::kWeekWindowMs / 2);
		Window(*opusWeek, "seven_day_opus", 90, Ai::kWeekWindowMs / 2);
		assert_true(Ai::PaceAgainst(*opusWeek, Text("opus"), Text("week"), kNow, why) > 1.79 && why.View().Contains(Text("Opus week is at 1.80x")), "its own week counts for the week");
		assert_true(Ai::PaceAgainst(*opusWeek, Text("sonnet"), Text("week"), kNow, why) < 0.21, "not for another model");
		Ai::ClaudeUsage unknown;
		assert_true(Ai::PaceAgainst(unknown, Text("opus"), Text("both"), kNow, why) == 0.0 && why.IsEmpty(), "usage unknown: no pace");
		assert_true(Ai::IsPacingTarget(Text("week")) && !Ai::IsPacingTarget(Text("month")), "targets");
	}

	[test("a_model_metered_apart_runs_while_the_week_is_used_up")]
	public static void TestMeteredApart() {
		Ai::ClaudeAccount* account = new Ai::ClaudeAccount();
		Ai::ClaudeUsage& usage = account->usage;
		Ai::ReadUsage(Parse("{\"subscription_type\": \"max\", \"rate_limits_available\": true, \"rate_limits\": {\"five_hour\": {\"utilization\": 30, \"resets_at\": \"2025-10-22T18:20:00Z\"}, \"seven_day\": {\"utilization\": 100, \"resets_at\": \"2025-10-25T16:20:00Z\"}, \"model_scoped\": [{\"display_name\": \"Fable\", \"utilization\": 20, \"resets_at\": \"2025-10-25T16:20:00Z\"}]}}"), usage, kNow);
		Ai::UsageWindow* session = usage.Find(Text("five_hour"));
		Ai::UsageWindow* week = usage.Find(Text("seven_day"));
		Ai::UsageWindow* fable = usage.Find(Text("model:fable"));
		assert_true(fable && fable->separate && !week->separate, "a model_scoped window is metered apart");
		assert_true(Ai::Limits(usage, *week, Text("opus")) && !Ai::Limits(usage, *week, Text("claude-fable-5-1")), "the shared week limits opus, not fable");
		assert_true(Ai::Limits(usage, *session, Text("fable")) && Ai::Limits(usage, *fable, Text("fable")) && !Ai::Limits(usage, *fable, Text("opus")), "the session limits every model, fable's week fable alone");
		Core::String why;
		assert_true(Ai::PaceAgainst(usage, Text("fable"), Text("week"), kNow, why) < 0.5 && why.View().Contains(Text("Fable week")), "fable is paced by its own week");
		assert_true(account->BlockedUntil(Text("opus"), kNow) == week->resetsAtMs && account->BlockedUntil(Text("fable"), kNow) == 0, "the used-up week holds opus back until it resets, not fable");
		assert_true(Ai::PlaceNow(*Claude("claude-fable", "fable"), Ai::PaceLimit(), false, *account, kNow)->state == Ai::PlaceState::Use, "fable's place is in use");
		Ai::ChainPlace* opus = Ai::PlaceNow(*Claude("claude-opus", "opus"), Ai::PaceLimit(), false, *account, kNow);
		assert_true(opus->state == Ai::PlaceState::UsedUp && opus->why.View().Contains(Text("frees in 3 d")), "opus's is used up");
		account->apartBlockedUntilMs.At(Core::String("fable")) = kNow + 3600 * 1000;
		assert_true(account->BlockedUntil(Text("fable"), kNow) == kNow + 3600 * 1000 && account->BlockedUntil(Text(""), kNow) == week->resetsAtMs, "a usage limit a fable turn met holds back fable alone");
		account->apartBlockedUntilMs.Remove(Core::String("fable"));
		account->blockedUntilMs = kNow + (int64)5 * 24 * 3600 * 1000;
		assert_true(account->BlockedUntil(Text("sonnet"), kNow) == account->blockedUntilMs && account->BlockedUntil(Text("fable"), kNow) == 0, "one a turn of the shared pool met, that pool");

		Ai::TakeRateLimit(Parse("{\"status\": \"rejected\", \"rateLimitType\": \"seven_day_overage_included\", \"resetsAt\": 1761400000, \"unifiedWindows\": {\"seven_day_overage_included\": {\"utilization\": 1.0, \"resetsAt\": 1761400000}}}"), usage, kNow);
		assert_true(usage.windows.Count() == 3 && Ai::UsedUp(*fable, kNow) && Ai::RejectedWindow(usage, kNow) == fable, "the CLI's Fable limit is fable's model_scoped window");
		assert_true(Ai::PlaceNow(*Claude("claude-fable", "fable"), Ai::PaceLimit(), false, *account, kNow)->why.View().StartsWith(Text("Fable week is used up")), "its own week used up says so");
		Ai::ReadUsage(Parse("{\"subscription_type\": \"max\", \"rate_limits_available\": true, \"rate_limits\": {\"five_hour\": {\"utilization\": 31, \"resets_at\": \"2025-10-22T18:20:00Z\"}, \"seven_day\": {\"utilization\": 100, \"resets_at\": \"2025-10-25T16:20:00Z\"}}}"), usage, kNow);
		assert_true(usage.Find(Text("model:fable")) == fable && fable->separate, "an answer that names no model_scoped windows keeps those known");
		Ai::ReadUsage(Parse("{\"subscription_type\": \"max\", \"rate_limits_available\": true, \"rate_limits\": {\"seven_day\": {\"utilization\": 100, \"resets_at\": \"2025-10-25T16:20:00Z\"}, \"model_scoped\": []}}"), usage, kNow);
		assert_true(!usage.Find(Text("model:fable")) && account->BlockedUntil(Text("claude-fable-5-1"), kNow) == 0 && account->BlockedUntil(Text("sonnet"), kNow) > 0, "an empty list: none, and fable is metered apart all the same, as the CLI has it");
		assert_se("fable", Ai::ApartModel(usage, Text("claude-fable-5-1")).CStr(), "fable's pool");
		assert_true(Ai::ApartModel(usage, Text("opus")).IsEmpty(), "opus is of the shared pool");

		Ai::ClaudeUsage eventOnly;
		Ai::TakeRateLimit(Parse("{\"status\": \"allowed_warning\", \"rateLimitType\": \"seven_day_overage_included\", \"utilization\": 0.9, \"resetsAt\": 1761400000}"), eventOnly, kNow);
		Ai::UsageWindow* named = eventOnly.Find(Text("model:fable"));
		assert_true(named && named->separate && named->label == "Fable week" && named->utilization > 89.9, "an event before any get_usage answer names Fable's window as the CLI does");
	}

	[test("a_turn_tries_the_chain_in_pacing_order")]
	public static void TestTurnOrder() {
		Core::Array<Ai::ChainPlace*> places;
		places.Push(Place("claude-opus", Ai::PlaceState::Over, 1.85));
		places.Push(Place("claude-sonnet", Ai::PlaceState::UsedUp, 0));
		places.Push(Place("claude-haiku", Ai::PlaceState::Over, 1.23));
		places.Push(Place("qwen", Ai::PlaceState::Use, 0));
		Core::Array<Ai::ChainPlace*> order = Ai::TurnOrder(places);
		assert_true(order.Count() == 3 && order[0]->model == "qwen" && order[1]->model == "claude-haiku" && order[2]->model == "claude-opus",
			"in use first, then over their pace, the least over first (haiku 1.23x past its 1.5x before opus 1.85x past its 1.0x); used up left out");
		Core::Array<Ai::ChainPlace*> passed = Ai::PassedOver(places, order);
		assert_true(passed.Count() == 3 && passed[0]->model == "claude-opus" && passed[2]->model == "claude-haiku", "every place ahead of qwen that is not in use is passed over");
	}

	[test("only_the_places_ahead_of_the_turns_model_are_passed_over")]
	public static void TestPassedOver() {
		Core::Array<Ai::ChainPlace*> pinned;
		pinned.Push(Place("fake", Ai::PlaceState::Use, 0));
		pinned.Push(Place("claude-opus", Ai::PlaceState::Over, 1.85));
		pinned.Push(Place("claude-sonnet", Ai::PlaceState::UsedUp, 0));
		assert_true(Ai::PassedOver(pinned, Ai::TurnOrder(pinned)).IsEmpty(), "a pinned model in use: the group's fallbacks behind it are not skipped");
		Core::Array<Ai::ChainPlace*> over;
		over.Push(Place("claude-opus", Ai::PlaceState::Over, 1.85));
		over.Push(Place("claude-sonnet", Ai::PlaceState::Over, 1.48));
		over.Push(Place("claude-haiku", Ai::PlaceState::Over, 1.23));
		Core::Array<Ai::ChainPlace*> passed = Ai::PassedOver(over, Ai::TurnOrder(over));
		assert_true(passed.Count() == 2 && passed[0]->model == "claude-opus" && passed[1]->model == "claude-sonnet", "every place over its pace: the least over is used, not skipped");
		Core::Array<Ai::ChainPlace*> none;
		none.Push(Place("claude-opus", Ai::PlaceState::UsedUp, 0));
		none.Push(Place("qwen", Ai::PlaceState::Use, 0));
		none.Push(Place("claude-haiku", Ai::PlaceState::UsedUp, 0));
		passed = Ai::PassedOver(none, Core::Array<Ai::ChainPlace*>());
		assert_true(passed.Count() == 2 && passed[1]->model == "claude-haiku", "no order: every place not in use");
	}

	[test("when_a_window_frees")]
	public static void TestResetText() {
		assert_se("in 35 min", Ai::ResetText(kNow + 35 * 60000, kNow).CStr(), "minutes");
		assert_se("in 2 h 14 min", Ai::ResetText(kNow + 134 * 60000, kNow).CStr(), "hours");
		assert_se("in 3 d 4 h", Ai::ResetText(kNow + (3 * 24 + 4) * 3600000, kNow).CStr(), "days");
		assert_se("now", Ai::ResetText(kNow - 1, kNow).CStr(), "past");
	}

	[test("a_streamed_response")]
	public static void TestResponse() {
		Ai::ClaudeResponse* response = Streamed("["
			"{\"type\": \"message_start\", \"message\": {\"model\": \"claude-opus-5-5\", \"usage\": {\"input_tokens\": 10, \"cache_read_input_tokens\": 900, \"cache_creation_input_tokens\": 90, \"output_tokens\": 1}}},"
			"{\"type\": \"content_block_start\", \"index\": 0, \"content_block\": {\"type\": \"thinking\", \"thinking\": \"\"}},"
			"{\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"thinking_delta\", \"thinking\": \"Look first.\"}},"
			"{\"type\": \"content_block_stop\", \"index\": 0},"
			"{\"type\": \"content_block_start\", \"index\": 1, \"content_block\": {\"type\": \"text\", \"text\": \"\"}},"
			"{\"type\": \"content_block_delta\", \"index\": 1, \"delta\": {\"type\": \"text_delta\", \"text\": \"Reading \"}},"
			"{\"type\": \"content_block_delta\", \"index\": 1, \"delta\": {\"type\": \"text_delta\", \"text\": \"it.\"}},"
			"{\"type\": \"content_block_start\", \"index\": 2, \"content_block\": {\"type\": \"tool_use\", \"id\": \"toolu_1\", \"name\": \"mcp__ied__fs_read\", \"input\": {}}},"
			"{\"type\": \"content_block_delta\", \"index\": 2, \"delta\": {\"type\": \"input_json_delta\", \"partial_json\": \"{\\\"path\\\": \"}},"
			"{\"type\": \"content_block_delta\", \"index\": 2, \"delta\": {\"type\": \"input_json_delta\", \"partial_json\": \"\\\"a.cf\\\"}\"}},"
			"{\"type\": \"content_block_stop\", \"index\": 2},"
			"{\"type\": \"message_delta\", \"delta\": {\"stop_reason\": \"tool_use\"}, \"usage\": {\"output_tokens\": 42}},"
			"{\"type\": \"message_stop\"}]");
		assert_true(response->started && response->stopped, "start to stop");
		assert_se("claude-opus-5-5", response->model.CStr(), "the model");
		assert_se("Look first.", response->thinking.CStr(), "thinking");
		assert_se("Reading it.", response->text.CStr(), "text");
		assert_true(response->calls.Count() == 1, "one call");
		assert_se("fs_read", response->calls[0]->name.CStr(), "IED's name for it");
		assert_se("toolu_1", response->calls[0]->id.CStr(), "its tool_use id");
		assert_se("{\"path\": \"a.cf\"}", response->calls[0]->arguments.CStr(), "its input");
		assert_se("tool_use", response->stopReason.CStr(), "the stop reason");
		assert_true(response->promptTokens == 1000 && response->cachedTokens == 900 && response->outputTokens == 42, "the usage");
	}

	[test("errors")]
	public static void TestErrors() {
		assert_true(Ai::ClaudeErrorKind(Text("rate_limit")) == Ai::ClaudeError::UsageLimit && Ai::ClaudeErrorKind(Text("billing_error")) == Ai::ClaudeError::UsageLimit, "usage limits");
		assert_true(Ai::ClaudeErrorKind(Text("authentication_failed")) == Ai::ClaudeError::SignIn, "sign in");
		assert_true(Ai::ClaudeErrorKind(Text("overloaded")) == Ai::ClaudeError::Transport, "transport");
		assert_true(Ai::ClaudeErrorKind(Text("")) == Ai::ClaudeError::None, "none");
		assert_true(Ai::LimitResetIn(Text("Claude AI usage limit reached|1761160000")) == (int64)1761160000 * 1000 && Ai::LimitResetIn(Text("You've hit your limit")) == 0, "a reset in the message");
	}

	[test("lines_to_the_cli")]
	public static void TestLines() {
		assert_se("{\"type\":\"control_request\",\"request_id\":\"r1\",\"request\":{\"subtype\":\"initialize\",\"sdkMcpServers\":[\"ied\"]}}", Ai::ControlRequestLine(Text("r1"), Ai::InitializeRequest().View()).CStr(), "initialize");
		assert_se("{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"q\",\"response\":{}}}", Ai::ControlAnswerLine(Text("q"), Text("{}")).CStr(), "an answer");
		Core::Array<Ai::ClaudeImage> images;
		Ai::ClaudeImage image;
		image.mime = Core::String("image/png");
		image.base64 = Core::String("AAAA");
		images.Push(image);
		assert_se("{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Look\"},{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":\"image/png\",\"data\":\"AAAA\"}}]},\"parent_tool_use_id\":null,\"session_id\":\"\"}", Ai::UserMessageLine(Text("Look"), images).CStr(), "a user message with an image");
		assert_se("{\"tools\":[{\"name\":\"fs_read\",\"description\":\"Read.\",\"inputSchema\":{\"type\":\"object\"}}]}", Ai::McpToolsResult(Text("[{\"type\": \"function\", \"function\": {\"name\": \"fs_read\", \"description\": \"Read.\", \"parameters\": {\"type\": \"object\"}}}, {\"type\": \"function\", \"function\": {\"name\": \"tool_search\", \"description\": \"x\", \"parameters\": {}}}]")).CStr(), "tools/list without tool_search");
		assert_se("{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"ok\"},{\"type\":\"image\",\"data\":\"AAAA\",\"mimeType\":\"image/png\"}],\"isError\":false}}", Ai::McpReply(Parse("7"), Ai::McpCallResult(Text("ok"), images, false).View()).CStr(), "a call's result");
		assert_true(Ai::IedToolName(Text("mcp__ied__shell_run")) == "shell_run" && Ai::IedToolName(Text("Bash")) == "Bash", "tool names");
	}

	[test("subscription_only")]
	public static void TestSubscriptionOnly() {
		assert_true(Ai::IsSubscriptionAuth(Text("claude.ai")) && Ai::IsSubscriptionAuth(Text("oauth_token")), "a claude.ai sign-in and its long-lived token");
		assert_true(!Ai::IsSubscriptionAuth(Text("api_key")) && !Ai::IsSubscriptionAuth(Text("api_key_helper")) && !Ai::IsSubscriptionAuth(Text("third_party")) && !Ai::IsSubscriptionAuth(Text("none")) && !Ai::IsSubscriptionAuth(Text("")), "keys, helpers, other providers and no sign-in");
		Core::Array<Core::String> environment = Ai::ClaudeEnvironment();
		const char*[6] removed = { "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY" };
		for (int64 i = 0; i < 6; ++i) assert_true(environment.Contains(Core::String(removed[i])), removed[i]);
		assert_true(environment.Contains(Core::String("CLAUDE_CODE_DISABLE_CLAUDE_MDS=1")), "the CLI's own CLAUDE.md reading off");
		assert_true(environment.Contains(Core::String("CLAUDE_CODE_SIMPLE")) && environment.Contains(Core::String("CLAUDECODE")) && environment.Contains(Core::String("CLAUDE_CODE_SESSION_ID")), "a parent Claude Code session's bare mode and ids taken out");
		assert_true(!environment.Contains(Core::String("CLAUDE_CODE_OAUTH_TOKEN")) && !environment.Contains(Core::String("CLAUDE_CONFIG_DIR")), "the owner's own long-lived token and config folder kept");
		assert_true(Ai::NotSubscription(Text("api_key")).View().Contains(Text("subscription only")), "why an API key is refused");
		assert_true(Ai::LaterVersion(Text("2.1.304"), Text("2.1.299")) && !Ai::LaterVersion(Text("2.1.299"), Text("2.1.304")) && !Ai::LaterVersion(Text("2.1.0"), Text("2.1.0")), "versions");
	}

	[test("setting_claude_up")]
	public static void TestWithClaudeModels() {
		Core::String models;
		Core::String groups;
		Ai::WithClaudeModels(Text("{}"), Text("{}"), Text(""), models, groups);
		assert_true(Ai::HasClaudeModel(models.View()) && !Ai::HasClaudeModel(Text("{\"q\": {\"endpoint\": \"http://q/v1\"}}")), "the Claude profiles added");
		Serialization::DomNode added = Parse(models.CStr());
		assert_true(added.Count() == 4 && added.Member("claude-opus").Member("model").AsView() == "opus" && !added.Member("claude-auto").IsValid(), "four profiles, no auto");
		assert_se("{\"claude\":{\"primary\":{\"model\":\"claude-opus\",\"pace\":{\"max\": 1.00, \"target\": \"both\"},\"fallback\":[{\"model\":\"claude-sonnet\",\"pace\":{\"max\": 1.25, \"target\": \"both\"}},{\"model\":\"claude-haiku\",\"pace\":{\"max\": 1.50, \"target\": \"both\"}}]}}}", groups.CStr(), "a chain stepping down as the plan runs ahead of pace");
		Ai::WithClaudeModels(Text("{\"qwen\": {\"endpoint\": \"http://q/v1\"}, \"claude-opus\": {\"provider\": \"claude-code\", \"model\": \"opus\", \"contextWindow\": 5}}"),
			Text("{\"local\": {\"primary\": {\"model\": \"qwen\"}}}"), Text("local"), models, groups);
		Serialization::DomNode kept = Parse(models.CStr());
		assert_true(kept.Count() == 5 && kept.Member("claude-opus").Member("contextWindow").AsInt() == 5 && kept.Member("qwen").Member("endpoint").AsView() == "http://q/v1", "what was there kept as it was");
		Serialization::DomNode chain = Parse(groups.CStr()).Member("claude").Member("primary").Member("fallback");
		assert_true(chain.Count() == 3 && chain.At(2).AsView() == "qwen", "then the default group's local primary, always");
		assert_true(Parse(groups.CStr()).Member("local").Member("primary").Member("model").AsView() == "qwen", "the other groups kept");
		Ai::WithClaudeModels(Text("{\"qwen\": {\"endpoint\": \"http://q/v1\"}}"), Text("{\"claude\": {\"primary\": {\"model\": \"claude-opus\"}}}"), Text("claude"), models, groups);
		assert_se("{\"claude\":{\"primary\":{\"model\":\"claude-opus\"}}}", groups.CStr(), "a claude group already there is kept");
		Core::Array<Core::String> command;
		command.Push(Core::String("C:/Users/Ann Lee/claude.exe"));
		command.Push(Core::String("auth"));
		assert_se("start \"Claude Code sign-in\" \"C:/Users/Ann Lee/claude.exe\" \"auth\"", Ai::ClaudeWindowCommand(Text("Claude Code sign-in"), command).CStr(), "a window's command, each word quoted");
	}

	[test("the_desktop_apps_cli")]
	public static void TestDesktopAppCli() {
		FS::Path root = FS::TempDirectory() / "ied-claude-desktop";
		FS::RemoveAll(root.CStr());
		FS::Path store = root / "Local" / "Packages" / "Claude_pzs8sxrjxfjjc" / "LocalCache" / "Roaming" / "Claude" / "claude-code";
		Touch(root / "Roaming" / "Claude" / "claude-code" / "2.1.299" / "f0584be0fbaf" / "claude.exe");
		Touch(store / "2.1.304" / "aed62990b91e" / "claude.exe");
		FS::MakeDirectories((store / "2.1.400" / "unpacking").CStr());
		Touch(root / "Local" / "Packages" / "Other_x" / "LocalCache" / "Roaming" / "Claude" / "claude-code" / "9.0.0" / "a" / "claude.exe");
		Core::Array<FS::Path> folders = Ai::DesktopAppCliFolders((root / "Roaming").View(), (root / "Local").View());
		assert_true(folders.Count() == 2, "the installer's app's folder and the Store app's, no other package's");
		Core::String found = Ai::NewestDesktopCli(folders);
		assert_se((store / "2.1.304" / "aed62990b91e" / "claude.exe").CStr(), found.CStr(), "the newest with a claude.exe, in the Store app's package");
		assert_true(Ai::NewestDesktopCli(Ai::DesktopAppCliFolders(Text(""), (root / "Nowhere").View())).IsEmpty(), "none");
		FS::RemoveAll(root.CStr());
	}

	[test("auto_profiles_become_chains")]
	public static void TestWithoutAutoProfiles() {
		Core::String models;
		Core::String groups;
		assert_true(!Ai::WithoutAutoProfiles(Text("{\"q\": {\"endpoint\": \"http://q/v1\"}}"), Text("{}"), models, groups), "nothing to move");
		const char* oldModels = "{\"claude-auto\": {\"provider\": \"claude-code\", \"model\": \"auto\", \"pacing\": {\"ladder\": [\"opus\", \"haiku\"], \"target\": \"week\"}}, \"big\": {\"provider\": \"claude-code\", \"model\": \"opus\"}, \"q\": {\"endpoint\": \"http://q/v1\"}}";
		const char* oldGroups = "{\"claude\": {\"primary\": {\"model\": \"claude-auto\", \"temperature\": 0.3, \"fallback\": [\"q\"]}}, \"local\": {\"primary\": {\"model\": \"q\", \"fallback\": [\"claude-auto\"]}}}";
		assert_true(Ai::WithoutAutoProfiles(Text(oldModels), Text(oldGroups), models, groups), "moved");
		Serialization::DomNode newModels = Parse(models.CStr());
		assert_true(!newModels.Member("claude-auto").IsValid() && newModels.Member("big").IsValid() && newModels.Member("claude-haiku").Member("model").AsView() == "haiku" && !newModels.Member("claude-opus").IsValid(),
			"the auto profile gone; a rung uses a profile of its model, else claude-<model>");
		assert_se("{\"claude\":{\"primary\":{\"model\":\"big\",\"pace\":{\"max\": 1.00, \"target\": \"week\"},\"temperature\":0.30,\"fallback\":[{\"model\":\"claude-haiku\",\"pace\":{\"max\": 1.25, \"target\": \"week\"}},\"q\"]}},\"local\":{\"primary\":{\"model\":\"q\",\"fallback\":[{\"model\":\"big\",\"pace\":{\"max\": 1.00, \"target\": \"week\"}},{\"model\":\"claude-haiku\",\"pace\":{\"max\": 1.25, \"target\": \"week\"}}]}}}",
			groups.CStr(), "each role that named it gets the ladder as paced places, the rest kept");
		Core::String again;
		Core::String againGroups;
		assert_true(!Ai::WithoutAutoProfiles(models.View(), groups.View(), again, againGroups), "once");
	}

	[test("history_for_a_new_session")]
	public static void TestHistory() {
		Core::Array<Ai::Turn*> turns;
		assert_true(Ai::HistoryText(turns).IsEmpty(), "no turns: nothing");
		Ai::Turn* turn = new Ai::Turn();
		Ai::ModelMessage* asked = new Ai::ModelMessage();
		asked->role = Core::String("user");
		asked->content = Core::String("Fix the build.");
		Ai::ModelMessage* called = new Ai::ModelMessage();
		called->role = Core::String("assistant");
		called->content = Core::String("Building.");
		called->toolCalls = Core::String("[{\"id\": \"c1\", \"type\": \"function\", \"function\": {\"name\": \"build_run\", \"arguments\": \"{}\"}}]");
		Ai::ModelMessage* result = new Ai::ModelMessage();
		result->role = Core::String("tool");
		result->content = Core::String("exit 0\nall green");
		turn->messages.Push(asked);
		turn->messages.Push(called);
		turn->messages.Push(result);
		turns.Push(turn);
		Core::String text = Ai::HistoryText(turns);
		assert_true(text.View().Contains(Text("## User\nFix the build.")) && text.View().Contains(Text("## Assistant\nBuilding.")), text.CStr());
		assert_true(text.View().Contains(Text("[called build_run {}]")) && text.View().Contains(Text("[result: exit 0]")), text.CStr());
	}
}
