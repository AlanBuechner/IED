// images: which images a tool's result names can be sent, and how a request shows them or names them.

include "images.ch"

static Core::StringView ImageView(const char* text) { return Core::StringView(text); }

static IED::ToolImage Image(const char* mime, Core::StringView path) {
	IED::ToolImage image;
	image.mime = Core::String(mime);
	image.path = Core::String(path);
	return image;
}

// A workspace in a fresh temporary folder holding shot.png (four bytes).
static IED::Workspace ImageWorkspace(const char* name) {
	Core::StringBuilder folder;
	folder.Append(name);
	folder.AppendInt(Platform::UnixTimeNs());
	FS::Path root = FS::TempDirectory() / folder.View();
	FS::MakeDirectories(root.CStr());
	FS::WriteFileAtomically((root / "shot.png").CStr(), (const void*)"\x89PNG", 4);
	IED::Workspace ws;
	ws.root = Core::String(root.View());
	return ws;
}

static Serialization::DomNode ParsedImageJson(Core::StringView json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	Serialization::ReadResult read = Serialization::ReadJson(json, *doc);
	return read.Ok() ? read.root : Serialization::DomNode();
}

[test("server.ai.images")]
class ImageTests {
	[test("what_can_be_sent")]
	public static void TestAccepted() {
		IED::Workspace ws = ImageWorkspace("ied-images-");
		Core::Array<IED::ToolImage> named;
		named.Push(Image("image/png", ImageView("shot.png")));
		named.Push(Image("image/png", (FS::Path(ws.root.View()) / "shot.png").View()));
		named.Push(Image("image/bmp", ImageView("shot.png")));
		named.Push(Image("image/png", ImageView("../shot.png")));
		named.Push(Image("image/png", ImageView("missing.png")));
		named.Push(Image("image/png", (FS::TempDirectory() / "elsewhere.png").View()));
		Core::Array<Core::String> notes;
		Core::Array<IED::ToolImage> sent = Ai::AcceptedImages(ws, named, notes);
		assert_eq((int64)2, sent.Count(), "a file in the workspace, named either way");
		assert_true(sent[1].path.View() == "shot.png" && sent[1].mime.View() == "image/png", "an absolute path inside the root made relative");
		assert_eq((int64)4, notes.Count(), "each other one said");
		assert_true(notes[0].View().Contains(ImageView("its type")), "a type the format does not take");
		assert_true(notes[2].View().Contains(ImageView("no such file")), "a file that is not there");
		assert_true(notes[3].View().Contains(ImageView("not inside the workspace")), "a file outside it");
		FS::RemoveAll(ws.root.CStr());
	}

	[test("named_or_shown")]
	public static void TestRequest() {
		IED::Workspace ws = ImageWorkspace("ied-images-request-");
		Ai::ModelMessage* result = new Ai::ModelMessage();
		result->role = Core::String("tool");
		result->toolCallId = Core::String("c1");
		result->content = Core::String("took it");
		result->images.Push(Image("image/png", ImageView("shot.png")));
		result->images.Push(Image("image/png", ImageView("gone.png")));
		IED::JsonWriter blind;
		result->WriteRequest(blind, false);
		Serialization::DomNode told = ParsedImageJson(blind.View());
		assert_true(told.Member("content").AsView().Contains(ImageView("[image shot.png (image/png): this model is not sent images]")), "a model that does not see images is told the path");
		assert_true(!told.Member("images").IsValid(), "a request carries no field the format lacks");
		IED::JsonWriter seeing;
		result->WriteRequest(seeing, true);
		assert_true(ParsedImageJson(seeing.View()).Member("content").AsView() == "took it", "one that sees them gets the text as it is");
		Core::Array<Ai::ModelMessage*> results;
		results.Push(result);
		IED::JsonWriter shown;
		const int64 encoded = Ai::WriteImagesMessage(shown, ws.root.View(), results);
		Serialization::DomNode message = ParsedImageJson(shown.View());
		assert_true(message.Member("role").AsView() == "user", "a user message: a tool message carries text only");
		Serialization::DomNode parts = message.Member("content");
		assert_eq((int64)3, parts.Count(), "a caption and the image, then the one that is gone");
		assert_true(parts.At(1).Member("image_url").Member("url").AsView() == "data:image/png;base64,iVBORw==", "the file as a data: URL");
		assert_eq((int64)30, encoded, "the bytes of the URL, for the estimate");
		assert_true(parts.At(2).Member("text").AsView().Contains(ImageView("gone.png, is no longer there")), "a file since removed is said");
		FS::RemoveAll(ws.root.CStr());
	}

	[test("kept_with_the_chat")]
	public static void TestKept() {
		Ai::ModelMessage message;
		message.role = Core::String("tool");
		message.images.Push(Image("image/jpeg", ImageView("a/b.jpg")));
		IED::JsonWriter json;
		message.WriteJson(json);
		Ai::ModelMessage back;
		back.Read(ParsedImageJson(json.View()));
		assert_true(back.images.Count() == 1 && back.images[0].mime.View() == "image/jpeg" && back.images[0].path.View() == "a/b.jpg", "the images read back");
	}
}
