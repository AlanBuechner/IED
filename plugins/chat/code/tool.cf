include "api/plugin.ch"
include "tool.ch"

namespace Ai
{
	void ToolRegistry::Add(ToolSpec* spec) {
		Core::String error;
		if (!schemas->Add((Core::String("tool/") + spec->name.View()).View(), spec->parameters.View(), error)) problems.Push(((Core::String("the schema of the tool ") + spec->name.View()) + " does not load: ") + error.View());
		tools.Push(spec);
	}

	ToolSpec* ToolRegistry::Find(Core::StringView name) const {
		for (ToolSpec* spec : tools)
			if (spec->name.View() == name) return spec;
		return nullptr;
	}

	bool ToolRegistry::Offered(const ToolSpec* spec, ChatMode mode) const {
		if (spec->agentOnly && mode != ChatMode::Agent) return false;
		return mode != ChatMode::Plan || spec->inPlan;
	}

	Core::String ToolRegistry::RequestTools(ChatMode mode, const Core::Array<Core::String>& loaded) const {
		IED::JsonWriter json;
		json.BeginArray();
		for (ToolSpec* spec : tools) {
			if (!Offered(spec, mode) || (spec->deferred && !loaded.Contains(spec->name))) continue;
			json.BeginObject();
			json.Field("type", "function");
			json.Key(Core::StringView("function"));
			json.BeginObject();
			json.Field("name", spec->name.View());
			json.Field("description", spec->description.View());
			json.RawField("parameters", spec->parameters.View());
			json.EndObject();
			json.EndObject();
		}
		json.EndArray();
		return json.ToString();
	}

	// A description's first sentence, for a one-line listing.
	static Core::StringView FirstSentence(Core::StringView text) {
		const int64 stop = text.IndexOf(Core::StringView(". "));
		const int64 end = stop >= 0 ? stop + 1 : text.ByteLength();
		return text.Substring(0, end < kToolIndexLineBytes ? end : kToolIndexLineBytes);
	}

	Core::String ToolRegistry::DeferredIndex(ChatMode mode, const Core::Array<Core::String>& loaded) const {
		Core::StringBuilder out;
		for (ToolSpec* spec : tools) {
			if (!spec->deferred || !Offered(spec, mode) || loaded.Contains(spec->name)) continue;
			out.Append("- ");
			out.Append(spec->name.View());
			out.Append(": ");
			out.Append(FirstSentence(spec->description.View()));
			if (!spec->group.IsEmpty()) {
				out.Append(" (");
				out.Append(spec->group.View());
				out.Append(")");
			}
			out.Append("\n");
		}
		return out.ToString();
	}

	// How well `query`'s words match the tool: each word found in its name counts 3, in its group 2, in its description 1.
	static int64 Match(const ToolSpec* spec, Core::StringView query) {
		int64 score = 0;
		int64 at = 0;
		while (at < query.ByteLength()) {
			int64 end = at;
			while (end < query.ByteLength() && query.ByteAt(end) != ' ' && query.ByteAt(end) != ',') end += 1;
			Core::StringView word = query.Substring(at, end - at);
			if (word.ByteLength() >= 2) {
				if (spec->name.View().Contains(word)) score += 3;
				if (spec->group.View().Contains(word)) score += 2;
				if (spec->description.View().Contains(word)) score += 1;
			}
			at = end + 1;
		}
		return score;
	}

	Core::Array<ToolSpec*> ToolRegistry::SearchDeferred(Core::StringView query, ChatMode mode, int64 most) const {
		Core::Array<ToolSpec*> found;
		const Core::StringView select = Core::StringView("select:");
		if (query.StartsWith(select)) {
			Core::StringView names = query.Substring(select.ByteLength(), query.ByteLength() - select.ByteLength());
			int64 at = 0;
			while (at < names.ByteLength()) {
				int64 end = names.IndexOf(',', at);
				if (end < 0) end = names.ByteLength();
				ToolSpec* spec = Find(names.Substring(at, end - at).Trimmed());
				if (spec && spec->deferred && Offered(spec, mode) && !found.Contains(spec)) found.Push(spec);
				at = end + 1;
			}
			return found;
		}
		Core::Array<int64> scores;
		for (ToolSpec* spec : tools) {
			if (!spec->deferred || !Offered(spec, mode)) continue;
			const int64 score = Match(spec, query);
			if (score == 0) continue;
			int64 at = found.Count();
			while (at > 0 && scores[at - 1] < score) at -= 1;
			found.Insert(at, spec);
			scores.Insert(at, score);
		}
		while (found.Count() > most) found.RemoveAt(found.Count() - 1);
		return found;
	}

	void ToolRegistry::LoadAll() {
		for (ToolSpec* spec : tools) spec->deferred = false;
	}

	Core::Array<Core::String> ToolRegistry::Check(const ToolSpec* spec, const Serialization::DomNode& args) const {
		Core::Array<Core::String> problems;
		Core::String name = Core::String("tool/") + spec->name.View();
		for (const Serialization::SchemaProblem& problem : Serialization::ValidateJson(*schemas, name.View(), Core::StringView(""), args))
			problems.Push((problem.path.IsEmpty() ? Core::String("arguments") : problem.path) + ": " + problem.message.View());
		return problems;
	}

	// Whether `word` is one of the underscore-separated words of `name`.
	static bool HasWord(Core::StringView name, Core::StringView word) {
		int64 at = 0;
		while (at <= name.ByteLength()) {
			int64 end = name.IndexOf('_', at);
			if (end < 0) end = name.ByteLength();
			if (name.Substring(at, end - at) == word) return true;
			at = end + 1;
		}
		return false;
	}

	// Letters of `a` found in order in `b`, plus a bonus for its tail after an underscore and for each word they share,
	// less a third of what `b` is longer: "read_file" is as like fs_read as code_read_symbol.
	static int64 Likeness(Core::StringView a, Core::StringView b) {
		int64 score = 0;
		int64 at = 0;
		for (int64 i = 0; i < a.ByteLength() && at < b.ByteLength(); ++i) {
			const int64 found = b.IndexOf((char8)a.ByteAt(i), at);
			if (found < 0) continue;
			score += 1;
			at = found + 1;
		}
		const int64 underscore = a.IndexOf('_', 0);
		if (underscore > 0 && b.Contains(a.Substring(underscore, a.ByteLength() - underscore))) score += 4;
		int64 start = 0;
		while (start < a.ByteLength()) {
			int64 end = a.IndexOf('_', start);
			if (end < 0) end = a.ByteLength();
			if (end - start >= 2 && HasWord(b, a.Substring(start, end - start))) score += 4;
			start = end + 1;
		}
		if (b.ByteLength() > a.ByteLength()) score -= (b.ByteLength() - a.ByteLength()) / 3;
		return score;
	}

	Core::Array<Core::String> ToolRegistry::Suggest(Core::StringView name, ChatMode mode) const {
		Core::Array<Core::String> best;
		int64 top = 0;
		for (ToolSpec* spec : tools) {
			if (!Offered(spec, mode)) continue;
			const int64 score = Likeness(name, spec->name.View());
			if (score > top) {
				top = score;
				best.Clear();
			}
			if (score == top && score > 0) best.Push(spec->name);
		}
		return best;
	}

	static Core::StringView WithoutFence(Core::StringView text) {
		Core::StringView trimmed = text.Trimmed();
		if (!trimmed.StartsWith(Core::StringView("```")) || !trimmed.EndsWith(Core::StringView("```")) || trimmed.ByteLength() < 6) return trimmed;
		const int64 lineEnd = trimmed.IndexOf('\n', 0);
		if (lineEnd < 0) return trimmed;
		return trimmed.Substring(lineEnd + 1, trimmed.ByteLength() - lineEnd - 4).Trimmed();
	}

	bool ReadToolArguments(Core::StringView text, Serialization::DomNode& args) {
		Core::StringView json = WithoutFence(text);
		if (json.IsEmpty()) json = Core::StringView("{}");
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(json, *doc);
		if (!read.Ok() || read.root.Kind() != Serialization::DomKind::Object) return false;
		args = read.root;
		return true;
	}

	ToolOutcome ToolError(Core::StringView message) {
		ToolOutcome outcome;
		outcome.content = Core::String(message);
		outcome.isError = true;
		return outcome;
	}

	ToolOutcome ToolResult(Core::StringView content, Core::StringView preview) {
		ToolOutcome outcome;
		outcome.content = Core::String(content);
		outcome.preview = Core::String(preview);
		return outcome;
	}
}
