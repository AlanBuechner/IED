include "api/plugin.ch"
include "contributed.ch"
include "catalog.ch"
include "plugintools.ch"
include "codetools.ch"

namespace Ai
{
	static Core::Array<Core::StringView> SplitPath(Core::StringView path) {
		Core::Array<Core::StringView> parts;
		int64 start = 0;
		for (int64 i = 0; i <= path.ByteLength(); ++i)
			if (i == path.ByteLength() || path.ByteAt(i) == '/' || path.ByteAt(i) == '\\') {
				parts.Push(path.Substring(start, i - start));
				start = i + 1;
			}
		return parts;
	}

	// A path a manifest names inside its plugin's folder; empty when it is absolute or leaves the folder.
	static FS::Path InsidePlugin(const IED::Contribution& given, Core::StringView relative) {
		if (relative.IsEmpty() || relative.StartsWith(Core::StringView("/")) || relative.StartsWith(Core::StringView("\\")) || relative.IndexOf(':', 0) >= 0) return FS::Path();
		for (Core::StringView part : SplitPath(relative))
			if (part == "..") return FS::Path();
		return FS::Path(given.folder.View()) / relative;
	}

	static SkillFolder* Folder(const FS::Path& folder, Core::StringView source) {
		SkillFolder* entry = new SkillFolder();
		entry->folder = folder;
		entry->source = Core::String(source);
		return entry;
	}

	static Core::String Who(const IED::Contribution& given) { return Core::String("plugin ") + given.pluginId.View(); }

	Core::Array<Skill*> SkillsOf(IED::PluginContext* context, const IED::Workspace& ws, Core::Array<Core::String>& problems) {
		Core::Array<SkillFolder*> folders;
		folders.Push(Folder(FS::Path(ws.root.View()) / ".ied" / "skills", Core::StringView("project")));
		for (const IED::Contribution& given : IED::Contributions(WsId(ws), Core::StringView("skills"))) {
			FS::Path folder = InsidePlugin(given, given.entry.AsView());
			if (folder.IsEmpty()) problems.Push((Who(given) + ": a skills folder must be inside the plugin: ") + given.entry.AsView());
			else folders.Push(Folder(folder, Who(given).View()));
		}
		folders.Push(Folder(FS::Path(IED::AppFolder().View()) / "skills", Core::StringView("app")));
		return ReadSkills(folders, problems);
	}

	// --- System-message sections -------------------------------------------------------------------------------------

	static Core::String ReadAll(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	// A section's text: its `text`, its `file` inside the plugin, or what its `function` computes for `ws`; empty with a
	// problem when the file is not there or the function failed.
	static Core::String SectionText(const IED::Workspace& ws, const IED::Contribution& given, Core::Array<Core::String>& problems) {
		Serialization::DomNode section = given.entry;
		if (section.Member("text").IsValid()) return Core::String(section.Member("text").AsView().Trimmed());
		if (section.Member("function").IsValid()) {
			Core::String text;
			Core::String problem;
			if (!IED::PluginSection(ws, given.pluginId.View(), section.Member("function").AsView(), text, problem)) problems.Push(problem);
			return Core::String(text.View().Trimmed());
		}
		FS::Path file = InsidePlugin(given, section.Member("file").AsView());
		Core::String text = file.IsEmpty() ? Core::String() : ReadAll(file);
		if (text.IsEmpty()) problems.Push(((Who(given) + ": the section ") + section.Member("id").AsView()) + " has no text to give");
		return Core::String(text.View().Trimmed());
	}

	static Core::StringView Capped(Core::StringView text, int64 bytes) { return text.ByteLength() <= bytes ? text : text.Substring(0, bytes); }

	Core::String PluginSections(IED::PluginContext* context, const IED::Workspace& ws, Core::Array<Core::String>& problems) {
		Core::StringBuilder out;
		int64 left = kSectionsMostTokens * kBytesPerToken;
		for (const IED::Contribution& given : IED::Contributions(WsId(ws), Core::StringView("systemMessageSections"))) {
			if (left <= 0) break;
			Serialization::DomNode section = given.entry;
			Core::String error;
			if (!IED::WhenHolds(ws, section.Member("when").AsView(), error)) {
				if (!error.IsEmpty()) problems.Push(((Who(given) + ": the when of section ") + section.Member("id").AsView()) + " does not parse: " + error.View());
				continue;
			}
			const int64 tokens = section.Member("maxTokens").IsValid() ? section.Member("maxTokens").AsInt() : kSectionDefaultTokens;
			Core::String text = SectionText(ws, given, problems);
			if (text.IsEmpty()) continue;
			Core::StringView kept = Capped(Capped(text.View(), tokens * kBytesPerToken), left);
			out.Append("## ");
			out.Append(given.pluginName.View());
			out.Append("\n\n");
			out.Append(kept);
			out.Append("\n\n");
			left -= kept.ByteLength();
		}
		return Core::String(out.View().Trimmed());
	}

	// --- Tool calls --------------------------------------------------------------------------------------------------

	ToolRegistry* ToolsFor(IED::PluginContext* context, const IED::Workspace& ws, Core::Array<Core::String>& problems) {
		ToolRegistry* registry = CoreTools();
		for (const IED::Contribution& given : IED::Contributions(WsId(ws), Core::StringView("toolCalls"))) {
			Serialization::DomNode entry = given.entry;
			Core::String error;
			if (!IED::WhenHolds(ws, entry.Member("when").AsView(), error)) continue;
			Core::StringView name = entry.Member("name").AsView();
			Core::String who = (Who(given) + ": the tool ") + name;
			if (registry->Find(name)) {
				problems.Push(who + " is already a tool");
				continue;
			}
			Core::String problem;
			ToolSpec* spec = entry.Member("run").IsValid() ? CommandTool(entry, given.pluginId.View(), problem) : CodeTool(entry, given.pluginId.View(), problem);
			if (spec) registry->Add(spec);
			else problems.Push(problem);
		}
		for (const Core::String& problem : registry->problems) problems.Push(problem);
		return registry;
	}
}
