include "api/Plugin.ch"
include "ClaudeCli.ch"
include "ClaudeWire.ch"

namespace Ai
{
	const int64 c_ClaudeReadBytes = 16384;
	// What a Claude Code session sets for what it runs (2.1.304; the Claude desktop app's sessions set them all). A server
	// started from one - a terminal of a Claude Code session, a check it runs - would hand them on: CLAUDE_CODE_SIMPLE alone
	// is bare mode, which never reads the owner's login, and the rest make the CLI a child of that session.
	const int64 c_ClaudeSessionVariableCount = 31;
	const char*[31] c_ClaudeSessionVariables = {
		"CLAUDECODE", "CLAUDE_CODE_SIMPLE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_ENTRYPOINT_ON_REQUESTS", "CLAUDE_CODE_SESSION_ID",
		"CLAUDE_CODE_HOST_SESSION_ID", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_OAUTH_SCOPES",
		"CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN", "CLAUDE_CODE_EXECPATH",
		"CLAUDE_CODE_ACCOUNT_UUID", "CLAUDE_CODE_ORGANIZATION_UUID", "CLAUDE_CODE_USER_EMAIL", "CLAUDE_CODE_DESKTOP_APP_VERSION",
		"CLAUDE_CODE_STARTUP_FAILURE_RESULTS", "CLAUDE_CODE_EMIT_STARTUP_TIMING", "CLAUDE_CODE_EMIT_TOOL_USE_SUMMARIES",
		"CLAUDE_CODE_EAGER_FLUSH", "CLAUDE_CODE_TERMINAL_MCP_TOOLS", "CLAUDE_CODE_REPORT_FINDINGS", "CLAUDE_CODE_ENABLE_ASK_USER_QUESTION_TOOL",
		"CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING", "CLAUDE_CODE_DISABLE_TERMINAL_TITLE", "CLAUDE_AGENT_SDK_VERSION", "CLAUDE_AGENT_SDK_MCP_NO_PREFIX",
		"CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_PREVIEW_CLASSIFIER_FLOOR" };
	const int32 c_ClaudeWriteMs = 10000;

	// --- Where the CLI is ------------------------------------------------------------------------------------------------

	Core::Array<Core::String> ClaudeCommandSetting(Core::StringView json) {
		Core::Array<Core::String> command;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode list = Serialization::ReadJson(json, *doc).root;
		for (int64 i = 0; list.Kind() == Serialization::DomKind::Array && i < list.Count(); ++i)
			if (list.At(i).Kind() == Serialization::DomKind::String) command.Push(Core::String(list.At(i).AsView()));
		if (!command.IsEmpty() && command[0].IsEmpty()) command.Clear();
		return command;
	}

	// The number at `at` and the separators after it.
	static int64 VersionPart(Core::StringView text, int64& at) {
		int64 value = 0;
		while (at < text.ByteLength() && text.ByteAt(at) >= '0' && text.ByteAt(at) <= '9') {
			value = value * 10 + (text.ByteAt(at) - '0');
			at += 1;
		}
		while (at < text.ByteLength() && (text.ByteAt(at) < '0' || text.ByteAt(at) > '9')) at += 1;
		return value;
	}

	bool LaterVersion(Core::StringView a, Core::StringView b) {
		int64 i = 0;
		int64 j = 0;
		while (i < a.ByteLength() || j < b.ByteLength()) {
			const int64 x = VersionPart(a, i);
			const int64 y = VersionPart(b, j);
			if (x != y) return x > y;
		}
		return false;
	}

	static Core::String OnPath(const char* program) {
		Core::String path;
		if (!Platform::TryGetEnvironmentVariable("PATH", path)) return Core::String();
		int64 start = 0;
		while (start <= path.ByteLength()) {
			int64 end = path.View().IndexOf(';', start);
			if (end < 0) end = path.ByteLength();
			Core::StringView folder = path.View().Substring(start, end - start).Trimmed();
			if (!folder.IsEmpty()) {
				FS::Path candidate = FS::Path(folder) / program;
				if (FS::FileExists(candidate.CStr())) return Core::String(candidate.View());
			}
			start = end + 1;
		}
		return Core::String();
	}

	Core::Array<FS::Path> DesktopAppCliFolders(Core::StringView appData, Core::StringView localAppData) {
		Core::Array<FS::Path> folders;
		if (!appData.IsEmpty()) folders.Push(FS::Path(appData) / "Claude" / "claude-code");
		if (localAppData.IsEmpty()) return folders;
		FS::Path packages = FS::Path(localAppData) / "Packages";
		for (FS::DirectoryEntry& package : FS::Directory(packages.CStr())) {
			if (package.kind != FS::EntryKind::Directory || !package.name.View().StartsWith(Core::StringView("Claude_"))) continue;
			folders.Push(packages / package.name.CStr() / "LocalCache" / "Roaming" / "Claude" / "claude-code");
		}
		return folders;
	}

	Core::String NewestDesktopCli(const Core::Array<FS::Path>& folders) {
		Core::String best;
		Core::String bestVersion;
		for (const FS::Path& root : folders) {
			for (FS::DirectoryEntry& version : FS::Directory(root.CStr())) {
				if (version.kind != FS::EntryKind::Directory) continue;
				if (!bestVersion.IsEmpty() && !LaterVersion(version.name.View(), bestVersion.View())) continue;
				FS::Path folder = root / version.name.CStr();
				for (FS::DirectoryEntry& build : FS::Directory(folder.CStr())) {
					FS::Path program = folder / build.name.CStr() / "claude.exe";
					if (build.kind != FS::EntryKind::Directory || !FS::FileExists(program.CStr())) continue;
					best = Core::String(program.View());
					bestVersion = version.name;
					break;
				}
			}
		}
		return best;
	}

	static Core::String DesktopAppCli() {
		Core::String appData;
		Core::String localAppData;
		Platform::TryGetEnvironmentVariable("APPDATA", appData);
		Platform::TryGetEnvironmentVariable("LOCALAPPDATA", localAppData);
		return NewestDesktopCli(DesktopAppCliFolders(appData.View(), localAppData.View()));
	}

	Core::Array<Core::String> FindClaude(const Core::Array<Core::String>& configured) {
		if (!configured.IsEmpty()) return configured;
		Core::Array<Core::String> command;
		Core::String found = OnPath("claude.exe");
		Core::String home;
		if (found.IsEmpty() && Platform::TryGetEnvironmentVariable("USERPROFILE", home)) {
			FS::Path native = FS::Path(home.View()) / ".local" / "bin" / "claude.exe";
			if (FS::FileExists(native.CStr())) found = Core::String(native.View());
		}
		Core::String local;
		if (found.IsEmpty() && Platform::TryGetEnvironmentVariable("LOCALAPPDATA", local)) {
			FS::Path winget = FS::Path(local.View()) / "Microsoft" / "WinGet" / "Links" / "claude.exe";
			if (FS::FileExists(winget.CStr())) found = Core::String(winget.View());
		}
		if (found.IsEmpty()) found = DesktopAppCli();
		if (!found.IsEmpty()) command.Push(found);
		return command;
	}

	static Core::String Quoted(Core::StringView text) {
		Core::StringBuilder out;
		out.AppendByte('"');
		out.Append(text);
		out.AppendByte('"');
		return out.ToString();
	}

	Core::String ClaudeWindowCommand(Core::StringView title, const Core::Array<Core::String>& command) {
		Core::StringBuilder line;
		line.Append("start ");
		line.Append(Quoted(title).View());
		for (const Core::String& word : command) {
			line.AppendByte(' ');
			line.Append(Quoted(word.View()).View());
		}
		return line.ToString();
	}

	bool OpenClaudeWindow(Core::StringView title, const Core::Array<Core::String>& command, Core::String& problem) {
		Process::StartInfo info;
		info.shellCommand = ClaudeWindowCommand(title, command);
		info.environment = ClaudeEnvironment();
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Null;
		info.errors = Process::Redirect::Null;
		info.killOnClose = false;
		Process::Child shell = Process::Child::Start(info);
		if (!shell.IsOpen()) {
			problem = Core::String("cannot open a window: ") + shell.Error();
			return false;
		}
		const int64 exitCode = shell.Wait(c_ClaudeCommandMs);
		if (exitCode != 0) {
			problem = Core::String("the window did not open");
			return false;
		}
		return true;
	}

	Core::Array<Core::String> ClaudeEnvironment() {
		Core::Array<Core::String> environment;
		const char*[6] billed = { "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY" };
		for (int64 i = 0; i < 6; ++i) environment.Push(Core::String(billed[i]));
		for (int64 i = 0; i < c_ClaudeSessionVariableCount; ++i) environment.Push(Core::String(c_ClaudeSessionVariables[i]));
		const char*[8] off ={ "CLAUDE_MDS", "AUTO_MEMORY", "BUNDLED_SKILLS", "BACKGROUND_TASKS", "CRON", "WORKFLOWS", "ADVISOR_TOOL", "FILE_CHECKPOINTING" };
		for (int64 i = 0; i < 8; ++i) environment.Push((Core::String("CLAUDE_CODE_DISABLE_") + off[i]) + "=1");
		return environment;
	}

	static Process::Output RunClaude(const Core::Array<Core::String>& command, const char* first, const char* second, Core::StringView folder) {
		Process::StartInfo info;
		info.program = command[0];
		for (int64 i = 1; i < command.Count(); ++i) info.arguments.Push(command[i]);
		info.arguments.Push(Core::String(first));
		if (second) info.arguments.Push(Core::String(second));
		info.workingDirectory = Core::String(folder);
		info.environment = ClaudeEnvironment();
		info.errors = Process::Redirect::ToOutput;
		return Process::Run(info, c_ClaudeCommandMs);
	}

	Core::String ClaudeAuthMethod(const Core::Array<Core::String>& command, Core::StringView folder, bool& signedIn) {
		signedIn = false;
		if (command.IsEmpty()) return Core::String();
		Process::Output said = RunClaude(command, "auth", "status", folder);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode status = Serialization::ReadJson(said.output.View().Trimmed(), *doc).root;
		if (status.Member("loggedIn").Kind() != Serialization::DomKind::Bool) return Core::String();
		signedIn = status.Member("loggedIn").AsBool();
		return Core::String(status.Member("authMethod").AsView());
	}

	bool IsSubscriptionAuth(Core::StringView method) { return method == "claude.ai" || method == "oauth_token"; }

	Core::String ClaudeVersion(const Core::Array<Core::String>& command, Core::StringView folder) {
		if (command.IsEmpty()) return Core::String();
		Process::Output said = RunClaude(command, "--version", nullptr, folder);
		if (said.exitCode != 0) return Core::String();
		Core::StringView text = said.output.View().Trimmed();
		const int64 space = text.IndexOf(' ', 0);
		return Core::String(space < 0 ? text : text.Substring(0, space));
	}

	Core::String NotSubscription(Core::StringView method) {
		if (method.IsEmpty() || method == "none") return Core::String("Claude Code is not signed in: sign in with your Claude subscription from Settings > AI > Claude (Sign in), or run `claude auth login` in a terminal of your own");
		return ((Core::String("Claude Code signs in with ") + method) + ", not your Claude subscription, and IED runs Claude on the subscription only: sign in with your Claude subscription from Settings > AI > Claude (Sign in), or run `claude auth login` in a terminal of your own");
	}

	Core::Array<Core::String> ClaudeBaseArguments() {
		Core::Array<Core::String> arguments;
		const char*[13] fixed = { "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose", "--tools", "", "--strict-mcp-config", "--setting-sources", "", "--disable-slash-commands", "--include-partial-messages" };
		for (int64 i = 0; i < 13; ++i) arguments.Push(Core::String(fixed[i]));
		return arguments;
	}

	// --- A running CLI ---------------------------------------------------------------------------------------------------

	bool ClaudeProcess::Start(const Core::Array<Core::String>& command, Core::StringView folder, const Core::Array<Core::String>& environment, Core::String& error) {
		if (command.IsEmpty()) {
			error = Core::String("no Claude Code CLI was found: install it, or set ai.claude.command");
			return false;
		}
		Process::StartInfo info;
		info.program = command[0];
		for (int64 i = 1; i < command.Count(); ++i) info.arguments.Push(command[i]);
		info.workingDirectory = Core::String(folder);
		info.environment = environment;
		info.input = Process::Redirect::Pipe;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::ToOutput;
		Process::Child started = Process::Child::Start(info);
		if (!started.IsOpen()) {
			error = ((Core::String("cannot start ") + command[0].View()) + ": ") + started.Error();
			return false;
		}
		m_Child = new Process::Child(take(started));
		ClaudeProcess* self = this;
		Process::Child* process = m_Child;
		Threading::Thread::Run([self, process]() { self->ReadLoop(process); }).Detach();
		return true;
	}

	bool ClaudeProcess::Running() const { return m_Child != nullptr && !m_Ended; }

	bool ClaudeProcess::Send(Core::StringView line) {
		Threading::LockGuard guard(m_Writing);
		if (!m_Child || m_Ended) return false;
		Core::StringBuilder text;
		text.Append(line);
		text.AppendByte('\n');
		return m_Child->WriteText(text.View(), c_ClaudeWriteMs);
	}

	void ClaudeProcess::ReadLoop(Process::Child* process) {
		char[c_ClaudeReadBytes] buffer;
		Core::String pending;
		for (;;) {
			const int64 got = process->Read(Process::Stream::Output, (void*)&buffer[0], c_ClaudeReadBytes);
			if (got <= 0) break;
			pending.Append(Core::StringView(&buffer[0], got));
			int64 start = 0;
			for (;;) {
				const int64 end = pending.View().IndexOf('\n', start);
				if (end < 0) break;
				Take(pending.View().Substring(start, end - start));
				start = end + 1;
			}
			if (start > 0) pending = Core::String(pending.View().Substring(start, pending.ByteLength() - start));
		}
		if (!pending.View().Trimmed().IsEmpty()) Take(pending.View());
		Threading::LockGuard guard(m_Mutex);
		m_Ended = true;
		m_Arrived.NotifyAll();
	}

	void ClaudeProcess::Take(Core::StringView text) {
		Core::StringView trimmed = text.Trimmed();
		if (trimmed.IsEmpty()) return;
		ClaudeLine* line = new ClaudeLine();
		line->m_Doc = new Serialization::DomDoc();
		line->m_Text = Core::String(trimmed);
		Serialization::ReadResult read = Serialization::ReadJson(line->m_Text.View(), *line->m_Doc);
		if (read.Ok() && read.root.Kind() == Serialization::DomKind::Object) line->m_Root = read.root;
		Threading::LockGuard guard(m_Mutex);
		if (!line->m_Root.IsValid()) {
			m_Notes.Push(line->m_Text);
			if (m_Notes.Count() > c_ClaudeNotesKept) m_Notes.RemoveAt(0);
		}
		m_Lines.Push(line);
		m_Arrived.NotifyAll();
	}

	ClaudeLine* ClaudeProcess::Next(int32 waitMs) {
		Threading::LockGuard guard(m_Mutex);
		const int64 deadline = clock_now_ns() + (int64)waitMs * 1000000;
		while (m_Lines.IsEmpty() && !m_Ended) {
			const int64 left = deadline - clock_now_ns();
			if (left <= 0) return nullptr;
			m_Arrived.WaitFor(m_Mutex, left);
		}
		if (m_Lines.IsEmpty()) return nullptr;
		ClaudeLine* line = m_Lines[0];
		m_Lines.RemoveAt(0);
		return line;
	}

	bool ClaudeProcess::Ended() {
		Threading::LockGuard guard(m_Mutex);
		return m_Ended && m_Lines.IsEmpty();
	}

	Serialization::DomNode ClaudeProcess::Request(Core::StringView request, int32 waitMs, Core::String& error, ClaudeServe serve) {
		Core::StringBuilder id;
		{
			Threading::LockGuard guard(m_Mutex);
			m_Requests += 1;
			id.Append("ied-");
			id.AppendInt(m_Requests);
		}
		Serialization::DomNode answer;
		if (!Send(ControlRequestLine(id.View(), request).View())) {
			error = Core::String("the Claude Code CLI is not running");
			return answer;
		}
		Core::Array<ClaudeLine*> kept;
		const int64 deadline = clock_now_ns() / 1000000 + waitMs;
		for (;;) {
			const int64 left = deadline - clock_now_ns() / 1000000;
			ClaudeLine* line = left > 0 ? Next((int32)left) : nullptr;
			if (!line) {
				error = Core::String(Ended() ? "the Claude Code CLI ended" : "the Claude Code CLI did not answer in time");
				break;
			}
			Serialization::DomNode response = line->m_Root.Member("response");
			if (line->Type() == "control_response" && response.Member("request_id").AsView() == id.View()) {
				if (response.Member("subtype").AsView() == "error") error = Core::String(response.Member("error").AsView());
				else if (response.Member("response").IsValid()) answer = response.Member("response");
				else {
					Serialization::DomDoc* empty = new Serialization::DomDoc();
					answer = empty->NewObject();
				}
				break;
			}
			if (line->Type() == "control_request") serve(line);
			else kept.Push(line);
		}
		PutBack(kept);
		return answer;
	}

	void ClaudeProcess::PutBack(const Core::Array<ClaudeLine*>& kept) {
		Threading::LockGuard guard(m_Mutex);
		for (int64 i = kept.Count() - 1; i >= 0; --i) m_Lines.Insert(0, kept[i]);
	}

	Core::String ClaudeProcess::Notes() {
		Threading::LockGuard guard(m_Mutex);
		Core::StringBuilder out;
		for (const Core::String& note : m_Notes) {
			if (!out.IsEmpty()) out.AppendByte('\n');
			out.Append(note.View());
		}
		return out.ToString();
	}

	void ClaudeProcess::Stop() {
		Threading::LockGuard guard(m_Writing);
		if (m_Child) m_Child->Kill();
	}
}
