// The chats' Claude Code sessions and the plan's usage kept current (docs/04 "The Claude Code provider"): a session per chat
// that uses a Claude profile, made from what its header kept; a thread that asks for the usage every
// ai.claude.usageRefreshMinutes while a claude-code profile is set up - and, while none is, asks every
// kClaudeDetectEveryMs whether the CLI is signed in to a subscription, which sets Claude up (docs/04 "Setting it up") -
// and stops sessions idle for kClaudeIdleMs.

include "api/Plugin.ch"
include "ChatService.ch"

namespace Ai
{
	const int64 c_ClaudeKeeperTickNs = 15000000000;   // how often the keeper looks
	const int64 c_ClaudeRefreshDefaultMinutes = 10;
	const int64 c_ClaudeDetectEveryMs = 5 * 60 * 1000;

	static int64 KeeperNowMs() { return Platform::UnixTimeNs() / 1000000; }

	ClaudeSession* Chats::SessionOf(Chat* chat) {
		ClaudeSession* session = nullptr;
		if (m_ClaudeSessions.TryGet(chat->m_ChatId, session)) return session;
		session = new ClaudeSession();
		session->m_ChatId = chat->m_ChatId;
		session->m_SessionId = chat->m_ClaudeSession;
		session->m_Turns = chat->m_ClaudeTurns;
		session->m_IdleSinceMs = KeeperNowMs();
		m_ClaudeSessions.At(chat->m_ChatId) = session;
		return session;
	}

	void Chats::StopIdleSessions() {
		const int64 now = KeeperNowMs();
		for (Core::KeyValue<Core::String, ClaudeSession*>& entry : m_ClaudeSessions) {
			ClaudeSession* session = entry.value;
			if (!session->m_InUse && session->m_Process && now - session->m_IdleSinceMs > c_ClaudeIdleMs) session->Stop();
		}
	}

	// A workspace server's chats: idle sessions stopped, and the copy of the master's Claude account brought up to date
	// each tick (docs/01 "Processes"), so the usage another workspace's turns learned paces this one's within a tick.
	void Chats::ClaudeKeeper() {
		for (;;) {
			Threading::Thread::Sleep(c_ClaudeKeeperTickNs);
			{
				IED::HostLock guard(*m_Context);
				if (m_Stopping) return;
				StopIdleSessions();
			}
			m_Claude->Sync(false, false);
		}
	}

	// How often the master asks the CLI (ms): every ai.claude.usageRefreshMinutes while a claude-code profile is set up,
	// else every kClaudeDetectEveryMs to find a sign-in (0: never).
	static int64 UsageEveryMs(IED::PluginContext* context, bool configured) {
		if (!configured) return c_ClaudeSubscriptionOffered ? c_ClaudeDetectEveryMs : 0;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode minutes = Serialization::ReadJson(context->Setting(Core::StringView("ai.claude.usageRefreshMinutes"), Core::StringView("")).View(), *doc).root;
		return (minutes.Kind() == Serialization::DomKind::Int ? minutes.AsInt() : c_ClaudeRefreshDefaultMinutes) * 60 * 1000;
	}

	void KeepAccount(IED::PluginContext* context, ClaudeAccount* account, AccountKeeper* keeper) {
		int64 askedMs = 0;
		for (;;) {
			Threading::Thread::Sleep(c_ClaudeKeeperTickNs);
			bool configured = false;
			{
				IED::HostLock guard(*context);
				if (keeper->m_Stopping) return;
				configured = account->Configured();
			}
			const int64 every = UsageEveryMs(context, configured);
			if (every <= 0 || KeeperNowMs() - askedMs < every) continue;
			askedMs = KeeperNowMs();
			account->Refresh(false);
		}
	}

	// ai.probe of a claude-code profile: the CLI asked now, its answer in a probe's shape (settings' Test connection).
	Core::String ProbeClaude(ClaudeAccount* account, IED::PluginContext* context, const ModelProfile& profile) {
		account->Refresh(true);
		IED::HostLock guard(*context);
		IED::JsonWriter json;
		json.BeginObject();
		const bool found = !account->m_CliPath.IsEmpty();
		const bool signedIn = account->m_SignIn == "signed_in";
		json.BoolField("ok", found && signedIn);
		if (!found) json.Field("error", "no Claude Code CLI was found: install it, or set ai.claude.command");
		else if (!signedIn) json.Field("error", "Claude Code is not signed in: run `claude auth login` in a terminal of your own");
		json.Field("server", (Core::String("Claude Code ") + account->m_CliVersion.View()).View());
		json.Key(Core::StringView("models"));
		json.BeginArray();
		json.String(profile.m_Model.View());
		json.EndArray();
		json.BoolField("modelServed", true);
		json.IntField("contextWindow", profile.m_ContextWindow);
		json.IntField("trainContext", 0);
		json.IntField("slots", 0);
		json.BoolField("vision", true);
		json.IntField("ms", 0);
		json.EndObject();
		return json.ToString();
	}
}
