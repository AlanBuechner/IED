// The Claude models the CLI offers: see ClaudeModels.ch.

include "ClaudeModels.ch"

namespace Ai
{
	Threading::Mutex s_ClaudeCatalogLock;
	Core::Array<ClaudeCatalogModel*> s_ClaudeCatalog;   // s_ClaudeCatalogLock

	static bool IsFullId(Core::StringView value) { return value.StartsWith(Core::StringView("claude-")); }

	// "claude-fable-5-2" -> family "fable", version [5, 2]; a date part (8 digits) is not a version.
	static void FamilyOf(Core::StringView id, Core::String& family, Core::Array<int64>& version) {
		Core::StringView rest = IsFullId(id) ? id.Substring(7, id.ByteLength() - 7) : id;
		int64 at = 0;
		Core::StringBuilder name;
		while (at < rest.ByteLength() && rest.Data()[at] != '-' && rest.Data()[at] != '[') name.AppendByte(rest.Data()[at++]);
		family = name.ToString();
		while (at < rest.ByteLength() && rest.Data()[at] == '-') {
			++at;
			int64 start = at;
			int64 number = 0;
			while (at < rest.ByteLength() && rest.Data()[at] >= '0' && rest.Data()[at] <= '9') number = number * 10 + (rest.Data()[at++] - '0');
			if (at == start || at - start >= 8) break;
			version.Push(number);
		}
	}

	// -1, 0 or 1 as version `a` is older than, the same as or newer than `b`.
	static int32 CompareVersions(const Core::Array<int64>& a, const Core::Array<int64>& b) {
		for (int64 i = 0; i < a.Count() || i < b.Count(); ++i) {
			const int64 x = i < a.Count() ? a[i] : 0;
			const int64 y = i < b.Count() ? b[i] : 0;
			if (x != y) return x < y ? -1 : 1;
		}
		return 0;
	}

	Core::Array<ClaudeCatalogModel*> ReadClaudeCatalog(const Serialization::DomNode& models) {
		Core::Array<ClaudeCatalogModel*> catalog;
		for (int64 i = 0; models.Kind() == Serialization::DomKind::Array && i < models.Count(); ++i) {
			Serialization::DomNode entry = models.At(i);
			ClaudeCatalogModel* model = new ClaudeCatalogModel();
			model->m_Value = Core::String(entry.Member("value").AsView());
			if (model->m_Value.IsEmpty() || model->m_Value == "default" || entry.Member("disabled").AsBool()) continue;
			model->m_Resolved = Core::String(entry.Member("resolvedModel").AsView());
			if (model->m_Resolved.IsEmpty()) model->m_Resolved = model->m_Value;
			model->m_Label = Core::String(entry.Member("displayName").AsView());
			model->m_Description = Core::String(entry.Member("description").AsView());
			Serialization::DomNode efforts = entry.Member("supportedEffortLevels");
			model->m_EffortsSaid = efforts.Kind() == Serialization::DomKind::Array;
			for (int64 e = 0; model->m_EffortsSaid && e < efforts.Count(); ++e) model->m_Efforts.Push(Core::String(efforts.At(e).AsView()));
			FamilyOf(model->m_Resolved.View(), model->m_Family, model->m_Version);
			catalog.Push(model);
		}
		return catalog;
	}

	static void WriteEfforts(IED::JsonWriter& json, const ClaudeCatalogModel* model, const char* key) {
		if (!model->m_EffortsSaid) return;
		json.Key(Core::StringView(key));
		json.BeginArray();
		for (const Core::String& effort : model->m_Efforts) json.String(effort.View());
		json.EndArray();
	}

	void WriteClaudeCatalog(IED::JsonWriter& json, const Core::Array<ClaudeCatalogModel*>& catalog) {
		json.BeginArray();
		for (const ClaudeCatalogModel* model : catalog) {
			json.BeginObject();
			json.Field("value", model->m_Value.View());
			json.Field("resolvedModel", model->m_Resolved.View());
			json.Field("displayName", model->m_Label.View());
			json.Field("description", model->m_Description.View());
			WriteEfforts(json, model, "supportedEffortLevels");
			json.EndObject();
		}
		json.EndArray();
	}

	// The newest model of `family` in the catalog (by version; the first of equals); null when it has none.
	static ClaudeCatalogModel* NewestOf(const Core::Array<ClaudeCatalogModel*>& catalog, Core::StringView family) {
		ClaudeCatalogModel* newest = nullptr;
		for (ClaudeCatalogModel* model : catalog)
			if (model->m_Family.View() == family && (!newest || CompareVersions(model->m_Version, newest->m_Version) > 0)) newest = model;
		return newest;
	}

	Core::String ResolveClaudeModel(const Core::Array<ClaudeCatalogModel*>& catalog, Core::StringView model) {
		if (model.IsEmpty() || model == "default" || IsFullId(model)) return Core::String(model);
		ClaudeCatalogModel* named = nullptr;
		for (ClaudeCatalogModel* entry : catalog)
			if (entry->m_Value.View() == model) named = entry;
		ClaudeCatalogModel* newest = NewestOf(catalog, named ? named->m_Family.View() : model);
		if (!newest || (named && CompareVersions(newest->m_Version, named->m_Version) <= 0)) return Core::String(model);
		return newest->m_Resolved;
	}

	void WriteClaudeModels(IED::JsonWriter& json, const Core::Array<ClaudeCatalogModel*>& catalog) {
		json.BeginArray();
		for (const ClaudeCatalogModel* model : catalog) {
			const bool isAlias = !IsFullId(model->m_Value.View());
			ClaudeCatalogModel* newest = NewestOf(catalog, model->m_Family.View());
			json.BeginObject();
			json.Field("value", model->m_Value.View());
			json.Field("resolved", model->m_Resolved.View());
			json.Field("label", model->m_Label.View());
			json.Field("description", model->m_Description.View());
			json.Field("family", model->m_Family.View());
			json.BoolField("alias", isAlias);
			if (isAlias) json.Field("runs", ResolveClaudeModel(catalog, model->m_Value.View()).View());
			json.BoolField("newest", newest && CompareVersions(model->m_Version, newest->m_Version) >= 0);
			WriteEfforts(json, model, "efforts");
			json.EndObject();
		}
		json.EndArray();
	}

	void SetClaudeCatalog(const Core::Array<ClaudeCatalogModel*>& catalog) {
		Threading::LockGuard guard(s_ClaudeCatalogLock);
		s_ClaudeCatalog = catalog;
	}

	Core::Array<ClaudeCatalogModel*> ClaudeCatalog() {
		Threading::LockGuard guard(s_ClaudeCatalogLock);
		return s_ClaudeCatalog;
	}

	Core::String ClaudeFamilyProfile(Core::StringView family) { return Core::String("claude-") + family; }

	// A claude-code profile of one version as IED's earlier sync wrote it: named by its id, nothing but the provider, the
	// model, the CLI's name and efforts.
	static bool IsSyncedVersion(Core::StringView name, const Serialization::DomNode& profile, const Core::Array<ClaudeCatalogModel*>& catalog) {
		if (profile.Member("provider").AsView() != "claude-code" || profile.Member("model").AsView() != name || !IsFullId(name)) return false;
		for (int64 m = 0; m < profile.Count(); ++m) {
			Core::StringView key = profile.KeyAt(m);
			if (key != "provider" && key != "model" && key != "label" && key != "efforts") return false;
		}
		for (const ClaudeCatalogModel* model : catalog)
			if (model->m_Value.View() == name) return true;
		return false;
	}

	// A label IED's earlier sync gave a family's profile: the CLI's name of a model.
	static bool IsSyncedLabel(const Serialization::DomNode& profile, const Core::Array<ClaudeCatalogModel*>& catalog) {
		if (profile.Member("provider").AsView() != "claude-code" || IsFullId(profile.Member("model").AsView())) return false;
		Core::StringView label = profile.Member("label").AsView();
		for (const ClaudeCatalogModel* model : catalog)
			if (!label.IsEmpty() && model->m_Label.View() == label) return true;
		return false;
	}

	bool TidyClaudeModels(Core::StringView modelsJson, const Core::Array<ClaudeCatalogModel*>& catalog, Core::Array<Core::String>& seen, Core::String& modelsOut, Core::Array<Core::String>& added) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode old = Serialization::ReadJson(modelsJson, *doc).root;
		bool changed = false;
		IED::JsonWriter json;
		json.BeginObject();
		for (int64 i = 0; old.Kind() == Serialization::DomKind::Object && i < old.Count(); ++i) {
			Serialization::DomNode profile = old.ValueAt(i);
			Core::String name = Core::String(old.KeyAt(i));
			if (IsSyncedVersion(name.View(), profile, catalog)) {
				changed = true;
				continue;
			}
			if (!IsSyncedLabel(profile, catalog)) {
				json.RawField(name.CStr(), IED::NodeJson(profile).View());
				continue;
			}
			IED::JsonWriter kept;
			kept.BeginObject();
			for (int64 m = 0; m < profile.Count(); ++m)
				if (profile.KeyAt(m) != "label") kept.RawField(Core::String(profile.KeyAt(m)).CStr(), IED::NodeJson(profile.ValueAt(m)).View());
			kept.EndObject();
			json.RawField(name.CStr(), kept.View());
			changed = true;
		}
		// The families: each the first time the catalog has it, unless a profile serves it already (its alias or name).
		Core::Array<Core::String> families;
		for (const ClaudeCatalogModel* model : catalog)
			if (!families.Contains(model->m_Family)) families.Push(model->m_Family);
		for (const Core::String& family : families) {
			Core::String value = family;
			for (const ClaudeCatalogModel* model : catalog)
				if (model->m_Family == family && !IsFullId(model->m_Value.View())) value = model->m_Value;
			const bool known = seen.Contains(family) || seen.Contains(value);
			if (!seen.Contains(family)) seen.Push(family);
			Core::String name = ClaudeFamilyProfile(family.View());
			bool served = old.Member(name.CStr()).IsValid();
			for (int64 i = 0; !served && old.Kind() == Serialization::DomKind::Object && i < old.Count(); ++i) {
				Core::StringView model = old.ValueAt(i).Member("model").AsView();
				served = old.ValueAt(i).Member("provider").AsView() == "claude-code" && (model == value.View() || model == family.View());
			}
			if (known || served) continue;
			json.Key(name.View());
			json.BeginObject();
			json.Field("provider", "claude-code");
			json.Field("model", value.View());
			json.EndObject();
			added.Push(name);
			changed = true;
		}
		json.EndObject();
		modelsOut = json.ToString();
		return changed;
	}
}
