include "api/plugin.ch"
include "step.ch"
include "request.ch"
include "sse.ch"
include "dialect.ch"
include "repetition.ch"
include "probe.ch"

namespace Ai
{
	const int32 kStepPollMs = 250;
	const int64 kStepHeldBytes = 48;          // the text tail held back in case it opens a tool call
	const int64 kStepErrorBodyMs = 5000;
	const int64 kStepErrorBodyBytes = 16384;
	const int32 kStepLivenessMs = 2000;       // how long the server gets to say whether it has the work: a healthy vLLM
												// answers /metrics in milliseconds even while reading a 283k prompt (measured),
												// and a longer wait would only hold up a Stop
	const int64 kStepLivenessEveryMs = 1000;  // asked at most this often, however often the deadline is checked
	const int32 kStepLivenessMost = 10;       // asks that got nothing to read before the watchdog is believed over them:
													// about twenty seconds of grace for a status page that is slow or busy
	const int64 kStepMetricsBytes = 1024 * 1024;   // a Prometheus answer read no further than this
	const char* kVllmRunning = "vllm:num_requests_running";   // what vLLM's gauges say about the engine
	const char* kVllmWaiting = "vllm:num_requests_waiting";   // its 0.32 split of that count too, below: its lines start
													// with this name, so GaugeNamed would take them for it
	const char* kVllmWaitingByReason = "vllm:num_requests_waiting_by_reason";

	static int64 StepNowMs() { return clock_now_ns() / 1000000; }

	// What a step's stream has handed out so far, and the clocks its watchdogs read.
	class StepStream
	{
		public StepResult* result;
		public const StepEvents* events;
		public ThinkSplitter splitter;
		public Core::String visible;      // the prose so far, <think> blocks out
		public int64 released;            // bytes of `visible` handed out as Text
		public bool callOpened;           // a text tool call opened: what follows is withheld
		public int64 startMs;
		public int64 lastByteMs;
		public int64 prefillDeadlineMs;
		public int64 prefillExtendMs;     // what a keepalive comment or a progress report adds before the first token
		public int64 thinkingChecked;     // the lengths at their last repetition check
		public int64 visibleChecked;
		public int64 argumentsChecked;    // of call `checkedCall`, the one streaming
		public int64 checkedCall;
		public bool repeating;            // the reply is caught in a loop: the stream ends
		public const StepRequest* request;
		// Whether the server is still asked whether it has the work: cleared when an answer carries no request gauges (or
		// when there is no root to ask). What the last answer said is kept in `working` and used until the next ask.
		public bool askable;
		public int64 livenessAskedMs;
		public int32 livenessUnknown;   // asks that got nothing to read
		public bool working;
	}

	// Never cuts a UTF-8 sequence: the end moves back to the start of the code point it falls in.
	static int64 CharacterBoundary(Core::StringView text, int64 end) {
		while (end > 0 && end < text.ByteLength() && ((uint8)text.ByteAt(end) & 0xC0) == 0x80) end -= 1;
		return end;
	}

	static void Release(StepStream& stream, bool all) {
		if (!stream.callOpened) {
			const int64 from = stream.released > kStepHeldBytes ? stream.released - kStepHeldBytes : 0;
			const int64 opener = TextToolCallStart(stream.visible.View().Substring(from, stream.visible.ByteLength() - from));
			if (opener >= 0) stream.callOpened = true;
			const int64 limit = opener >= 0 ? from + opener : all ? stream.visible.ByteLength() : stream.visible.ByteLength() - kStepHeldBytes;
			const int64 end = CharacterBoundary(stream.visible.View(), limit);
			if (end > stream.released) {
				(*stream.events)(StepEventKind::Text, stream.visible.View().Substring(stream.released, end - stream.released), -1);
				stream.released = end;
			}
		}
	}

	static void TakeContent(StepStream& stream, Core::StringView text) {
		Core::String thinking;
		Core::String visible;
		stream.splitter.Feed(text, thinking, visible);
		if (!thinking.IsEmpty()) {
			stream.result->thinking.Append(thinking.View());
			(*stream.events)(StepEventKind::Thinking, thinking.View(), -1);
		}
		stream.visible.Append(visible.View());
		Release(stream, false);
	}

	// The server is still at work before the first token: the prefill watchdog waits longer.
	static void ExtendPrefill(StepStream& stream, int64 ms) {
		const int64 extended = StepNowMs() + ms;
		if (stream.result->ttftMs < 0 && extended > stream.prefillDeadlineMs) stream.prefillDeadlineMs = extended;
	}

	static void ExtendPrefill(StepStream& stream) { ExtendPrefill(stream, stream.prefillExtendMs); }

	// Whether `text` grew enough since its last check to be checked again, and now ends in a loop; moves the mark.
	static bool Loops(Core::StringView text, int64& checked, int64 tailBytes) {
		if (text.ByteLength() - checked < kRepetitionCheckBytes) return false;
		checked = text.ByteLength();
		return RepeatedTailPeriod(text, tailBytes) > 0;
	}

	static void CheckRepetition(StepStream& stream, const CompletionDelta& delta) {
		if (delta.kind == DeltaKind::ToolCall) {
			if (delta.call != stream.checkedCall) {
				stream.checkedCall = delta.call;
				stream.argumentsChecked = 0;
			}
			if (Loops(stream.result->completion->calls[delta.call]->arguments.View(), stream.argumentsChecked, kRepetitionArgumentBytes)) stream.repeating = true;
			return;
		}
		if (Loops(stream.result->thinking.View(), stream.thinkingChecked, kRepetitionTailBytes) || Loops(stream.visible.View(), stream.visibleChecked, kRepetitionTailBytes)) stream.repeating = true;
	}

	static void TakeDelta(StepStream& stream, const CompletionDelta& delta, int64& knownCalls) {
		if (delta.kind == DeltaKind::Progress) {
			ExtendPrefill(stream);
			if (stream.result->ttftMs < 0) (*stream.events)(StepEventKind::Progress, delta.text.View(), -1);
			return;
		}
		if (stream.result->ttftMs < 0) stream.result->ttftMs = StepNowMs() - stream.startMs;
		if (delta.kind == DeltaKind::Content) TakeContent(stream, delta.text.View());
		else if (delta.kind == DeltaKind::Reasoning) {
			stream.result->thinking.Append(delta.text.View());
			(*stream.events)(StepEventKind::Thinking, delta.text.View(), -1);
		}
		else {
			if (delta.call >= knownCalls) {
				knownCalls = delta.call + 1;
				Release(stream, true);
				(*stream.events)(StepEventKind::CallStarted, stream.result->completion->calls[delta.call]->name.View(), delta.call);
			}
			if (!delta.text.IsEmpty()) (*stream.events)(StepEventKind::CallArguments, delta.text.View(), delta.call);
		}
		CheckRepetition(stream, delta);
	}

	static void TakeEvent(StepStream& stream, const SseEvent& event, int64& knownCalls) {
		if (event.kind == SseKind::Comment) {
			stream.result->keepalives += 1;
			ExtendPrefill(stream);
			return;
		}
		Core::Array<CompletionDelta> deltas;
		stream.result->completion->Take(event.data.View(), deltas);
		for (const CompletionDelta& delta : deltas) TakeDelta(stream, delta, knownCalls);
	}

	// The end of the stream: held text out, and calls written as text taken from the prose.
	static void Finish(StepStream& stream) {
		Core::String thinking;
		Core::String visible;
		stream.splitter.Flush(thinking, visible);
		stream.result->thinking.Append(thinking.View());
		stream.visible.Append(visible.View());
		Release(stream, true);
		StepResult* result = stream.result;
		for (ToolCallDraft* call : result->completion->calls) result->calls.Push(call);
		result->text = stream.visible;
		if (!result->calls.IsEmpty()) return;
		Core::String rest;
		Core::Array<TextToolCall> found = ParseTextToolCalls(stream.visible.View(), rest);
		for (int64 i = 0; i < found.Count(); ++i) {
			ToolCallDraft* call = new ToolCallDraft();
			call->name = found[i].name;
			call->arguments = found[i].arguments;
			call->index = i;
			result->calls.Push(call);
		}
		result->textCalls = !found.IsEmpty();
		if (result->textCalls) result->text = rest;
		else result->unparsedCall = stream.callOpened;
	}

	static int64 RetryAfterMs(const Http::Response& head) {
		const Core::String* value = head.headers.Find(Core::StringView("retry-after"));
		if (!value) return 0;
		int64 seconds = 0;
		for (int64 i = 0; i < value->ByteLength() && value->View().ByteAt(i) >= '0' && value->View().ByteAt(i) <= '9'; ++i) seconds = seconds * 10 + (value->View().ByteAt(i) - '0');
		return seconds * 1000;
	}

	// A refused request's body, bounded: the server says why there.
	static Core::String ErrorBody(StreamingRequest& http) {
		Core::String body;
		const int64 until = StepNowMs() + kStepErrorBodyMs;
		while (StepNowMs() < until && body.ByteLength() < kStepErrorBodyBytes) {
			const BodyRead read = http.Read(body, kStepPollMs);
			if (read == BodyRead::Ended || read == BodyRead::Failed) break;
		}
		return body;
	}

	// The prefill watchdog fired: what it waited and what it allowed, for the pause to say (docs/12 "Watchdogs"). The
	// budget is the deadline as it stood then, keepalives included, not the one the request started with.
	static void StalledPrefill(StepStream& stream) {
		stream.result->end = WireEnd::StalledPrefill;
		stream.result->prefillWaitMs = StepNowMs() - stream.startMs;
		stream.result->prefillBudgetMs = stream.prefillDeadlineMs - stream.startMs;
	}

	// The number after the last space of a Prometheus line (`name{labels} 1.0`); false when there is none.
	static bool TrailingNumber(Core::StringView line, double& value) {
		int64 at = line.ByteLength() - 1;
		while (at > 0 && line.ByteAt(at) != ' ') at -= 1;
		return at > 0 && Core::ParseDouble(line.Substring(at + 1, line.ByteLength() - at - 1).Trimmed(), value);
	}

	// Whether `line` is the gauge named `name`: it starts with the name and a `{` of labels or the value's space follows
	// it - `vllm:num_requests_running_created` is a different metric.
	static bool GaugeNamed(Core::StringView line, Core::StringView name) {
		if (!line.StartsWith(name)) return false;
		if (line.ByteLength() == name.ByteLength()) return true;
		const int32 after = line.ByteAt(name.ByteLength());
		return after == '{' || after == ' ';
	}

	// What one pass over a server's Prometheus answer says of it: whether its vLLM request gauges are there at all
	// (`found`: what makes a server worth asking) and whether one of them puts work in the engine (`working`: what the
	// prefill watchdog acts on). The whole answer is read, not a window of it: an engine's lines come after the process's
	// own in a large one (the owner's vLLM's sit 2 kB into a 71 kB body).
	struct MetricsLiveness
	{
		public bool found;
		public bool working;
	}

	MetricsLiveness ReadMetricsLiveness(Core::StringView text) {
		MetricsLiveness liveness;
		int64 at = 0;
		while (at < text.ByteLength()) {
			const int64 end = text.IndexOf('\n', at);
			const Core::StringView line = text.Substring(at, (end < 0 ? text.ByteLength() : end) - at);
			at = end < 0 ? text.ByteLength() : end + 1;
			const bool running = GaugeNamed(line, Core::StringView(kVllmRunning));
			const bool waiting = GaugeNamed(line, Core::StringView(kVllmWaiting));
			const bool byReason = line.StartsWith(Core::StringView(kVllmWaitingByReason));   // also starts with kVllmWaiting
			if (!running && !waiting && !byReason) continue;
			liveness.found = true;
			double value = 0;
			if (TrailingNumber(line, value) && value > 0) liveness.working = true;
		}
		return liveness;
	}

	bool MetricsSayWorking(Core::StringView text) { return ReadMetricsLiveness(text).working; }

	bool MetricsHasRequestGauges(Core::StringView text) { return ReadMetricsLiveness(text).found; }

	// What asking the server came to: its engine has no work (`Idle`), has work in it (`Working`), or the ask found nothing
	// to read (`Unknown`) - no answer, or an answer that is not a status page. Only `Idle` is a stall.
	enum class Liveness { Idle, Working, Unknown }

	// Whether the server says it has work in its engine. A vLLM reads a 250k prompt for a minute and a half with nothing
	// on the wire (no keepalives, no usage before the end), so the prefill watchdog asks rather than guessing from
	// silence: the gauges saying work is in flight extend the deadline, and a server that answers, is silent on the wire
	// and idle in its engine really did stop. Asked at most every kStepLivenessEveryMs.
	//
	// Only vLLM's gauges are asked. llama.cpp is left to its `prompt_progress` reports, which already extend the
	// deadline as they arrive (docs/12 "Watchdogs"): its `/slots` `is_processing` says a slot is busy, not that it is
	// reading this prompt, and a hung server keeps saying busy forever.
	//
	// An answer with no request gauges in it - a 404, or a status page that never names them - means this server has
	// nothing to say and is not asked again, so the clock decides, as it did before the question existed. An ask that got
	// nothing to read says nothing either way: the deadline moves by the asking alone and it is tried again, until
	// kStepLivenessMost in a row found nothing - then the server is the dead one it has begun to look like. Giving up on
	// the first slow reply is how a healthy long prefill was called a stall.
	static Liveness ServerSaysWorking(StepStream& stream) {
		const int64 now = StepNowMs();
		if (!stream.askable) return Liveness::Idle;
		if (now - stream.livenessAskedMs < kStepLivenessEveryMs) return stream.working ? Liveness::Working : Liveness::Idle;
		stream.livenessAskedMs = now;
		if (stream.request->serverRoot.IsEmpty()) {
			stream.askable = false;
			stream.working = false;
			return Liveness::Idle;
		}
		Core::String body;
		Core::String error;
		int32 status = 0;
		if (!FetchText((stream.request->serverRoot + "/metrics").View(), stream.request->headers, kStepLivenessMs, status, body, error)) {
			stream.livenessUnknown += 1;
			return stream.livenessUnknown >= kStepLivenessMost ? Liveness::Idle : Liveness::Unknown;
		}
		if (status == 404) {   // it says there is no /metrics here: nothing is asked again
			stream.askable = false;
			stream.working = false;
			return Liveness::Idle;
		}
		if (status != 200) {   // busy or an error page: nothing learned, asked again
			stream.livenessUnknown += 1;
			return stream.livenessUnknown >= kStepLivenessMost ? Liveness::Idle : Liveness::Unknown;
		}
		const MetricsLiveness liveness = ReadMetricsLiveness(
			body.View().Substring(0, body.ByteLength() < kStepMetricsBytes ? body.ByteLength() : kStepMetricsBytes));
		stream.livenessUnknown = 0;   // it answered: what it has said since then is what counts
		if (!liveness.found) {
			stream.askable = false;   // no request gauges: nothing is asked again
			stream.working = false;
			return Liveness::Idle;
		}
		stream.working = liveness.working;
		return liveness.working ? Liveness::Working : Liveness::Idle;
	}

	// The prefill deadline passed. A server that says it is still reading does not get its request cancelled - the read
	// starts over on a retry, so cancelling a healthy long prefill is what turns it into a stall - so the deadline moves
	// by what a keepalive would and the client is told what the wait is. An ask that got nothing back moves it by the ask
	// alone and is tried again, so one slow status page never ends a request that is being served.
	static bool PrefillDeadlinePassed(StepStream& stream) {
		if (StepNowMs() <= stream.prefillDeadlineMs) return false;
		const Liveness liveness = ServerSaysWorking(stream);
		if (liveness == Liveness::Idle) {
			StalledPrefill(stream);
			return true;
		}
		if (liveness != Liveness::Working) {
			ExtendPrefill(stream, kStepLivenessMs);   // the ask itself is what this wait cost: it is asked again next second
			return false;
		}
		stream.result->prefillConfirms += 1;
		ExtendPrefill(stream);
		IED::JsonWriter json;
		json.BeginObject();
		json.BoolField("working", true);
		json.IntField("total", stream.request->promptTokens);
		json.IntField("waitedMs", StepNowMs() - stream.startMs);
		json.EndObject();
		(*stream.events)(StepEventKind::Working, json.ToString().View(), -1);
		return false;
	}

	static bool AwaitHead(StreamingRequest& http, StepStream& stream, const bool* cancelled) {
		for (;;) {
			if (*cancelled) {
				stream.result->end = WireEnd::Cancelled;
				return false;
			}
			const BodyRead read = http.ReadHead(kStepPollMs);
			if (read == BodyRead::Bytes) return true;
			if (read == BodyRead::Failed) {
				stream.result->end = WireEnd::ConnectFailed;
				stream.result->error = Core::String(http.Error());
				return false;
			}
			if (PrefillDeadlinePassed(stream)) return false;
		}
	}

	// Whether the stream's silence has outlasted its watchdog; sets the end when it has.
	static bool Stalled(StepStream& stream, const StepRequest& request) {
		const int64 now = StepNowMs();
		if (now - stream.startMs > request.capMs) stream.result->end = WireEnd::StepCap;
		else if (stream.result->ttftMs < 0 && PrefillDeadlinePassed(stream)) return true;
		else if (stream.result->ttftMs >= 0 && now - stream.lastByteMs > request.idleMs) stream.result->end = WireEnd::StalledStream;
		else return false;
		return true;
	}

	static void ReadEvents(StreamingRequest& http, StepStream& stream, const StepRequest& request, const bool* cancelled) {
		SseReader sse;
		SseEvent event;
		int64 knownCalls = 0;
		for (;;) {
			if (*cancelled) {
				stream.result->end = WireEnd::Cancelled;
				return;
			}
			Core::String bytes;
			const BodyRead read = http.Read(bytes, kStepPollMs);
			if (!bytes.IsEmpty()) {
				stream.lastByteMs = StepNowMs();
				sse.Feed(bytes.View());
				while (sse.Next(event)) TakeEvent(stream, event, knownCalls);
				if (stream.repeating) {
					stream.result->end = WireEnd::Repetition;
					return;
				}
				if (stream.result->completion->done) {
					stream.result->end = WireEnd::Completed;
					return;
				}
			}
			if (read == BodyRead::Ended || read == BodyRead::Failed) {
				if (sse.Flush(event)) TakeEvent(stream, event, knownCalls);
				const bool ended = stream.result->completion->done || !stream.result->completion->finishReason.IsEmpty();
				stream.result->end = ended ? WireEnd::Completed : WireEnd::Disconnected;
				if (!ended && read == BodyRead::Failed) stream.result->error = Core::String(http.Error());
				return;
			}
			if (read == BodyRead::Waiting && Stalled(stream, request)) return;
		}
	}

	StepResult* RunStep(const StepRequest& request, const StepEvents& events, const bool* cancelled) {
		StepStream stream;
		stream.result = new StepResult();
		stream.result->promptTokens = request.promptTokens;
		stream.result->prefillRate = request.readMs > 0 ? (double)request.promptTokens * 1000.0 / (double)request.readMs : 0.0;
		stream.events = &events;
		stream.request = &request;
		stream.startMs = StepNowMs();
		stream.lastByteMs = stream.startMs;
		stream.livenessAskedMs = 0;   // never asked
		stream.askable = true;      // asked until an answer carries no request gauges
		stream.livenessUnknown = 0;
		stream.working = false;
		stream.prefillDeadlineMs = stream.startMs + request.prefillMs;
		stream.prefillExtendMs = request.prefillExtendMs;
		StreamingRequest http;
		Core::String error;
		if (!http.Send(request.url.View(), request.headers, request.body.View(), request.connectMs, error)) {
			stream.result->end = WireEnd::ConnectFailed;
			stream.result->error = error;
		}
		else if (AwaitHead(http, stream, cancelled)) {
			stream.result->httpStatus = http.Status();
			if (http.Status() != 200) {
				stream.result->end = WireEnd::HttpError;
				stream.result->retryAfterMs = RetryAfterMs(http.Head());
				stream.result->error = ErrorBody(http);
			}
			else ReadEvents(http, stream, request, cancelled);
		}
		http.Close();
		Finish(stream);
		stream.result->ms = StepNowMs() - stream.startMs;
		return stream.result;
	}

	const char* WireEndName(WireEnd end) {
		const char*[9] names = { "completed", "connect_failed", "http_error", "disconnected_mid_stream", "stalled_prefill", "stalled_stream", "step_cap", "user_cancelled", "repetition" };
		return names[(int32)end];
	}
}
