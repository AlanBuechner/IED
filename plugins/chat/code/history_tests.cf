// history: finding what a chat said in the turns compression left out of its requests.

include "history.ch"

static Core::StringView Text(const char* text) { return Core::StringView(text); }

static Ai::ModelMessage* Message(const char* role, const char* text) {
	Ai::ModelMessage* message = new Ai::ModelMessage();
	message->role = Core::String(Text(role));
	message->content = Core::String(Text(text));
	return message;
}

static Ai::Turn* TurnOf(const char* turnId, bool dropped, int64 startedMs, const char* first, const char* second = "") {
	Ai::Turn* turn = new Ai::Turn();
	turn->turnId = Core::String(Text(turnId));
	turn->compressed = dropped;
	turn->startedMs = startedMs;
	turn->messages.Push(Message("user", first));
	if (second != nullptr) turn->messages.Push(Message("tool", second));
	return turn;
}

[test("server.ai.history")]
class HistoryTests {
	[test("where_a_word_was_said_is_found_in_the_turns_left_out")]
	public static void TestSearch() {
		Core::Array<const Ai::Turn*> turns;
		turns.Push(TurnOf("u1", true, 1000, "the dock layout keeps a well per activity"));
		turns.Push(TurnOf("u2", false, 2000, "now the sash drags the panel wider"));
		turns.Push(TurnOf("u3", true, 3000, "the layout again: wells fold into the dock"));

		Core::Array<Ai::HistoryHit> hits = Ai::SearchTurns(turns, Text("dock"), 8);
		assert_eq((int64)1, hits.Count(), "one word: its newest place");
		assert_true(hits[0].turn->turnId.View() == "u3", "the last turn saying it");
		assert_eq((int64)0, hits[0].line, "on its first line");

		Core::Array<Ai::HistoryHit> both = Ai::SearchTurns(turns, Text("dock sash"), 8);
		assert_eq((int64)2, both.Count(), "each word says where it was said");
		assert_true(both[0].turn->turnId.View() == "u2" && both[1].turn->turnId.View() == "u3", "in the order the conversation went");

		assert_eq((int64)0, Ai::SearchTurns(turns, Text("zzz"), 8).Count(), "a word nothing says");
		assert_eq((int64)0, Ai::SearchTurns(turns, Text("a"), 8).Count(), "a word too short to say anything");
		Core::Array<Ai::HistoryHit> capped = Ai::SearchTurns(turns, Text("dock sash layout"), 2);
		assert_eq((int64)2, capped.Count(), "capped at what is asked for");
		assert_true(capped[1].turn->turnId.View() == "u3", "kept from the newest end");
	}

	[test("a_turn_reads_as_the_model_was_sent_it")]
	public static void TestDigest() {
		Ai::Turn* turn = TurnOf("u9", true, 1000, "the first thing said", "and what a tool brought back");
		const Core::String text = Ai::TurnDigest(turn, 6000);
		assert_true(text.View().Contains(Text("user: the first thing said")), "its messages, in order, with their roles");
		assert_true(text.View().Contains(Text("tool: and what a tool brought back")), "and the tool's result");
		assert_true(Ai::TurnDigest(turn, 10).View().Contains(Text("[and more in this turn]")), "past the bytes it stops, and says so");

		Ai::Chat chat;
		chat.turns.Push(TurnOf("u1", true, 1000, "one"));
		chat.turns.Push(TurnOf("u2", false, 2000, "two"));
		assert_eq((int64)1, Ai::DroppedTurns(&chat).Count(), "only the turn left out of requests");
		assert_eq((int64)2, Ai::ChatTurns(&chat).Count(), "both are the chat's");
	}
}
