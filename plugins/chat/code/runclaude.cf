include "api/plugin.ch"
include "run.ch"
include "effort.ch"
include "images.ch"
include "pacing.ch"

namespace Ai
{
	const int32 kClaudePollMs = 250;
	const int32 kClaudeDrainMs = 60000;      // a query's result after its response ended
	const int32 kClaudeCallWaitMs = 30000;   // the CLI's tools/call for a call the step returned
	const int32 kClaudeUsageAskMs = 15000;
	const char* kClaudeTurnOverNote = "The call did not run: the turn ended first.";
	// A retried step with nothing new for the model (the CLI's query ended with an error, or the CLI was restarted).
	const char* kClaudeGoOnNote = "The last request failed before you answered. Go on where you left off.";

	static int64 ClaudeNowMs() { return Platform::UnixTimeNs() / 1000000; }

	// --- Which Claude ----------------------------------------------------------------------------------------------------

	Core::String TurnRun::ChooseClaude() {
		Core::Array<ChainPlace*> places = PlacesOf(candidates, role, chat->pinnedModel.View(), *chats->claude, ClaudeNowMs());
		Core::Array<ChainPlace*> order = TurnOrder(places);
		Core::String out;
		for (const ChainPlace* place : PassedOver(places, order)) {
			out = place->why;
			UiNote(Core::StringView("routing"), ((place->model + (place->state == PlaceState::Over ? " skipped for pace: " : " left out: ")) + place->why.View()).View());
		}
		Core::Array<ModelProfile*> kept;
		for (const ChainPlace* place : order) kept.Push(FindModel(candidates, place->model.View()));
		candidates = kept;
		return candidates.IsEmpty() ? out : Core::String();
	}

	Core::String TurnRun::ClaudeModel() const { return candidates[candidate]->model; }

	// --- The session -----------------------------------------------------------------------------------------------------

	bool TurnRun::StartClaude(Core::String& problem) {
		Core::String model = ClaudeModel();
		Core::String effort;
		Core::String toolList;
		{
			IED::HostLock guard(*context);
			if (!claude) {
				claude = chats->SessionOf(chat);
				claude->inUse = true;
			}
			toolList = McpToolsResult(tools->RequestTools(chat->mode, true).View());
			effort = Core::String(EffortOf(chat->effort.View(), role.effort.View()));
			turn->effort = effort;
		}
		const uint64 hash = system.View().Hash();
		if (claude->Running() && (claude->systemHash != hash || claude->effort != effort)) claude->Stop();
		claude->SetTools(toolList.View());
		if (!claude->Running()) {
			FS::Path file = ChatFolder(LocalStateOf(ws), chat->chatId.View()) / "claude-system.md";
			FS::MakeDirectories(file.Parent().CStr());
			FS::WriteFileAtomically(file.CStr(), (const void*)system.View().Data(), system.ByteLength());
			claude->model = model;
			claude->effort = effort;
			claude->systemHash = hash;
			Core::Array<Core::String> command = FindClaude(ClaudeCommandSetting(context->Setting(Core::StringView("ai.claude.command"), Core::StringView("")).View()));
			if (command.IsEmpty()) {
				problem = Core::String("no Claude Code CLI was found: install it, or set ai.claude.command");
				IED::HostLock guard(*context);
				claudeBlocked = problem;
				claudeBlockedStop = Core::String("no_claude_cli");
				return false;
			}
			bool signedIn = false;
			Core::String method = ClaudeAuthMethod(command, ws.root.View(), signedIn);
			{
				IED::HostLock guard(*context);
				chats->claude->TookAuth(signedIn, method.View());
			}
			if (!signedIn || !IsSubscriptionAuth(method.View())) {
				problem = NotSubscription(signedIn ? method.View() : Core::StringView(""));
				IED::HostLock guard(*context);
				claudeBlocked = problem;
				claudeBlockedStop = Core::String("not_subscription");
				return false;
			}
			if (!claude->Start(command, ws.root.View(), file.View(), problem)) {
				if (claude->sessionId.IsEmpty()) return false;
				context->Log(((Core::String("Claude Code could not resume session ") + claude->sessionId.View()) + " (" + problem.View() + "); a new one is told the chat so far").View());
				IED::HostLock guard(*context);
				claude->sessionId = Core::String();
				claude->turns.Clear();
				claudeSent = 0;
				problem = Core::String();
			}
			if (!claude->Running() && !claude->Start(command, ws.root.View(), file.View(), problem)) return false;
		}
		return claude->model == model || claude->SetModel(model.View(), problem);
	}

	// An image of a message or a result, read for the CLI; false when it cannot be sent.
	static bool ReadClaudeImage(const IED::Workspace& ws, const IED::ToolImage& image, ClaudeImage& block) {
		if (!SupportedImage(image.mime.View())) return false;
		FS::Path file = FS::Path(IED::WorkspaceFile(ws, image.path.View()).View());
		const int64 size = FS::FileSize(file.CStr());
		if (size <= 0 || size > kToolImageMaxBytes) return false;
		Core::Array<uint8> bytes;
		bytes.Resize(size);
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen() || opened.ReadAll((void*)bytes.Data(), size) != size) return false;
		block.mime = image.mime;
		block.base64 = Core::Base64Encode((const void*)bytes.Data(), size);
		return true;
	}

	// The CLI makes a message sent while a query runs a query of its own after it, so mid-query (after a step's tool calls)
	// the turn's new messages - the owner's, harness notes - wait in claudeAside for the next tool result, or for the
	// query's end.
	void TurnRun::SendToClaude() {
		Core::Array<ModelMessage*> pending;
		Core::String history;
		{
			IED::HostLock guard(*context);
			if (claude->querying) {
				SetAside();
				return;
			}
			if (!claudeAside.IsEmpty()) {
				ModelMessage* aside = new ModelMessage();
				aside->role = Core::String("user");
				aside->content = claudeAside;
				aside->images = claudeAsideImages;
				claudeAside = Core::String();
				claudeAsideImages.Clear();
				pending.Push(aside);
			}
			if (claudeSent == 0) {
				Core::Array<Turn*> missing;
				for (Turn* each : chat->turns)
					if (each != turn && !claude->turns.Contains(each->turnId)) missing.Push(each);
				history = HistoryText(missing);
			}
			for (int64 i = claudeSent; i < turn->messages.Count(); ++i)
				if (turn->messages[i]->role == "user") pending.Push(turn->messages[i]);
			claudeSent = turn->messages.Count();
			if (!claude->turns.Contains(turn->turnId)) {
				claude->turns.Push(turn->turnId);
				chat->claudeTurns = claude->turns;
			}
		}
		for (int64 i = 0; i < pending.Count(); ++i) {
			Core::Array<ClaudeImage> images;
			for (const IED::ToolImage& image : pending[i]->images) {
				ClaudeImage block;
				if (ReadClaudeImage(ws, image, block)) images.Push(block);
			}
			Core::String text = i == 0 && !history.IsEmpty() ? (history + "\n\n") + pending[i]->content.View() : pending[i]->content;
			claude->process->Send(UserMessageLine(text.View(), images).View());
			claude->querying = true;
		}
	}

	void TurnRun::SetAside() {
		for (int64 i = claudeSent; i < turn->messages.Count(); ++i) {
			const ModelMessage* message = turn->messages[i];
			if (message->role != "user") continue;
			claudeAside = (claudeAside.IsEmpty() ? Core::String() : claudeAside + "\n\n") + message->content.View();
			for (const IED::ToolImage& image : message->images) claudeAsideImages.Push(image);
		}
		claudeSent = turn->messages.Count();
	}

	// --- A step ----------------------------------------------------------------------------------------------------------

	static Core::StringView FinishOf(Core::StringView stopReason) {
		if (stopReason == "tool_use") return Core::StringView("tool_calls");
		if (stopReason == "max_tokens") return Core::StringView("length");
		return Core::StringView("stop");
	}

	StepResult* TurnRun::ClaudeStep(const StepEvents& events) {
		StepResult* result = new StepResult();
		const int64 started = ClaudeNowMs();
		Core::String problem;
		if (!StartClaude(problem)) {
			result->end = WireEnd::ConnectFailed;
			result->error = problem.IsEmpty() ? Core::String("Claude Code did not start") : problem;
			result->ms = ClaudeNowMs() - started;
			return result;
		}
		SendToClaude();
		if (!claude->querying) {
			Core::Array<ClaudeImage> none;
			claude->process->Send(UserMessageLine(Core::StringView(kClaudeGoOnNote), none).View());
			claude->querying = true;
		}
		ModelProfile* profile = candidates[candidate];
		ClaudeResponse* response = new ClaudeResponse();
		int64 lastMs = started;
		bool interrupted = false;
		for (;;) {
			if (run->cancelled && !interrupted) {
				interrupted = true;
				claude->process->Send(ControlRequestLine(Core::StringView("ied-stop"), Core::StringView("{\"subtype\":\"interrupt\"}")).View());
			}
			ClaudeLine* line = claude->process->Next(kClaudePollMs);
			const int64 now = ClaudeNowMs();
			if (line) {
				lastMs = now;
				if (TakeClaudeLine(line, response, result, events, started)) break;
				continue;
			}
			if (claude->process->Ended()) {
				result->end = response->started ? WireEnd::Disconnected : WireEnd::ConnectFailed;
				result->error = (Core::String("the Claude Code CLI ended: ") + claude->process->Notes().View());
				claude->Stop();
				break;
			}
			if (now - started > profile->stepCapMs) result->end = WireEnd::StepCap;
			else if (now - lastMs > (response->started ? profile->idleMs : profile->prefillBaseMs)) result->end = response->started ? WireEnd::StalledStream : WireEnd::StalledPrefill;
			else continue;
			break;
		}
		result->text = response->text;
		result->thinking = response->thinking;
		for (ToolCallDraft* call : response->calls) result->calls.Push(call);
		result->completion->finishReason = Core::String(FinishOf(response->stopReason.View()));
		result->completion->promptTokens = response->promptTokens;
		result->completion->completionTokens = response->outputTokens;
		result->ms = ClaudeNowMs() - started;
		return result;
	}

	bool TurnRun::TakeClaudeLine(ClaudeLine* line, ClaudeResponse* response, StepResult* result, const StepEvents& events, int64 startedMs) {
		Core::StringView type = line->Type();
		if (type == "stream_event") {
			if (line->root.Member("parent_tool_use_id").Kind() == Serialization::DomKind::String) return false;
			Core::Array<ClaudeDelta> deltas;
			response->Take(line->root.Member("event"), deltas);
			for (const ClaudeDelta& delta : deltas) {
				if (result->ttftMs < 0) result->ttftMs = ClaudeNowMs() - startedMs;
				if (delta.kind == ClaudeDeltaKind::Text) events(StepEventKind::Text, delta.text.View(), -1);
				else if (delta.kind == ClaudeDeltaKind::Thinking) events(StepEventKind::Thinking, delta.text.View(), -1);
				else if (delta.kind == ClaudeDeltaKind::CallStarted) events(StepEventKind::CallStarted, delta.text.View(), delta.call);
				else events(StepEventKind::CallArguments, delta.text.View(), delta.call);
			}
			if (!response->stopped) return false;
			if (response->stopReason != "tool_use") DrainClaude();
			return true;
		}
		if (type == "assistant") {
			if (line->root.Member("error").AsView().IsEmpty() || response->started) return false;
			ClaudeErrorOf(line, result);
			DrainClaude();
			return true;
		}
		if (type == "control_request") {
			claude->Serve(line);
			return false;
		}
		Core::StringView keySource = line->root.Member("apiKeySource").AsView();
		if (type == "system" && line->root.Member("subtype").AsView() == "init" && !keySource.IsEmpty() && keySource != "none") {
			claude->Stop();
			result->end = WireEnd::ConnectFailed;
			result->error = ((Core::String("Claude Code started with an API key (") + keySource) + "), not your Claude subscription: IED stopped it. IED runs Claude on the subscription only; take the key out of Claude Code's settings and sign in with `claude auth login`");
			IED::HostLock guard(*context);
			claudeBlocked = result->error;
			claudeBlockedStop = Core::String("not_subscription");
			return true;
		}
		if (type != "result") {
			ClaudeAside(line);
			return false;
		}
		claude->querying = false;
		ClaudeResult(line);
		if (response->stopped || result->end != WireEnd::Completed) return true;
		if (run->cancelled) {
			result->end = WireEnd::Cancelled;
			return true;
		}
		result->end = WireEnd::HttpError;
		result->httpStatus = 500;
		Core::StringView said = line->root.Member("result").AsView();
		result->error = said.IsEmpty() ? Core::String("Claude Code ended the query without a reply") : Core::String(said);
		return true;
	}

	void TurnRun::ClaudeAside(ClaudeLine* line) {
		Core::StringView type = line->Type();
		if (type == "result") {
			ClaudeResult(line);
			return;
		}
		if (type == "rate_limit_event") {
			IED::HostLock guard(*context);
			chats->claude->TookRateLimit(line->root.Member("rate_limit_info"));
			return;
		}
		if (type != "system") return;
		Core::StringView subtype = line->root.Member("subtype").AsView();
		IED::HostLock guard(*context);
		if (subtype == "init" && !line->root.Member("session_id").AsView().IsEmpty()) {
			const bool changed = claude->sessionId.View() != line->root.Member("session_id").AsView();
			claude->sessionId = Core::String(line->root.Member("session_id").AsView());
			chat->claudeSession = claude->sessionId;
			// Kept at once: a server stopped before the step's end would otherwise start the next turn on a new session,
			// told the chat only as text (docs/04 "What a restart keeps").
			if (changed) SaveChatHeader(LocalStateOf(ws), chat);
		}
		else if (subtype == "api_retry") {
			Core::StringBuilder note;
			note.Append("Claude Code retries the API (attempt ");
			note.AppendInt(line->root.Member("attempt").AsInt());
			note.Append(" of ");
			note.AppendInt(line->root.Member("max_retries").AsInt());
			if (line->root.Member("error_status").AsInt() > 0) {
				note.Append(", HTTP ");
				note.AppendInt(line->root.Member("error_status").AsInt());
			}
			note.Append(")");
			UiNote(Core::StringView("routing"), note.View());
		}
		else if (subtype == "compact_boundary") UiNote(Core::StringView("context_compressed"), Core::StringView("Claude Code compacted the conversation to fit its context."));
	}

	// The text of a message's first text block.
	static Core::String MessageText(const ClaudeLine* line) {
		Serialization::DomNode content = line->root.Member("message").Member("content");
		for (int64 i = 0; content.Kind() == Serialization::DomKind::Array && i < content.Count(); ++i)
			if (content.At(i).Member("type").AsView() == "text") return Core::String(content.At(i).Member("text").AsView());
		return Core::String();
	}

	void TurnRun::ClaudeErrorOf(ClaudeLine* line, StepResult* result) {
		Core::StringView error = line->root.Member("error").AsView();
		Core::String said = MessageText(line);
		result->end = WireEnd::HttpError;
		const ClaudeError kind = ClaudeErrorKind(error);
		if (kind == ClaudeError::UsageLimit) {
			result->httpStatus = 429;
			result->error = (Core::String("Claude's usage limit: ") + said.View());
			IED::HostLock guard(*context);
			const Core::String model = ClaudeModel();
			chats->claude->MetLimit(model.View(), LimitResetIn(said.View()));
			const int64 now = ClaudeNowMs();
			claudeBlocked = ((Core::String("Claude's usage limit is reached (") + said.View()) + "); it frees ") + ResetText(chats->claude->BlockedUntil(model.View(), now), now).View();
			claudeBlockedStop = Core::String("usage_limit");
			return;
		}
		if (kind == ClaudeError::SignIn) {
			result->httpStatus = 401;
			result->error = ((Core::String("Claude Code is not signed in to your subscription (") + said.View()) + "): run `claude auth login` in a terminal of your own, then send a message");
			IED::HostLock guard(*context);
			claudeBlocked = result->error;
			claudeBlockedStop = Core::String("not_subscription");
			return;
		}
		result->httpStatus = kind == ClaudeError::Transport ? 529 : kind == ClaudeError::Refused ? 400 : 500;
		result->error = ((Core::String("Claude Code: ") + error) + ": ") + said.View();
	}

	// modelUsage names each model the query used by its id: the turn's model's entry, else the first with a window.
	void TurnRun::ClaudeResult(ClaudeLine* line) {
		Serialization::DomNode usage = line->root.Member("modelUsage");
		if (usage.Kind() != Serialization::DomKind::Object) return;
		const Core::String model = ClaudeModel();
		int64 window = 0;
		for (int64 i = 0; i < usage.Count(); ++i) {
			const int64 each = usage.ValueAt(i).Member("contextWindow").AsInt();
			if (each <= 0) continue;
			if (window == 0 || usage.KeyAt(i).Contains(model.View())) window = each;
		}
		IED::HostLock guard(*context);
		ModelProfile* profile = candidates[candidate];
		if (!chats->LearnWindow(profile->name.View(), window) || chat->context.IsEmpty()) return;
		chat->context = ContextForModel(chat->context.View(), Window(), profile->name.View(), true);
		chats->Publish(chat, "context.changed", chat->context.View());
		SaveChatHeader(LocalStateOf(ws), chat);
	}

	void TurnRun::ClaudeContext(const Serialization::DomNode& usage) {
		int64 used = 0;
		int64 window = 0;
		if (!ReadClaudeContext(usage, used, window)) return;
		ModelProfile* profile = candidates[candidate];
		chats->LearnWindow(profile->name.View(), window);
		Core::Array<ContextPart> parts = ScaledParts(ContextParts(chat, system.ByteLength(), SentTools().ByteLength()), used);
		chat->context = ContextJson(Window(), used, profile->name.View(), true, parts, Core::StringView("claude"));
		chats->Publish(chat, "context.changed", chat->context.View());
		SaveChatHeader(LocalStateOf(ws), chat);
	}

	void TurnRun::DrainClaude() {
		TurnRun* self = this;
		claude->Settle(Core::StringView(kClaudeTurnOverNote), false, kClaudeDrainMs, [self](ClaudeLine* line) { self->ClaudeAside(line); });
	}

	// Whether `profile` can take a turn Claude refused: a model that is not Claude, or after a usage limit a Claude one with
	// room left (one metered apart from the pool that ran out: Fable).
	static bool TakesOver(const ModelProfile& profile, bool usageLimit, const ClaudeAccount& account, int64 nowMs) {
		if (!profile.IsClaude()) return true;
		return usageLimit && PlaceNow(profile, PaceLimit(), true, account, nowMs)->state != PlaceState::UsedUp;
	}

	void TurnRun::ClaudeBlocked() {
		const Core::String why = claudeBlocked;
		claudeBlocked = Core::String();
		const bool usageLimit = claudeBlockedStop == "usage_limit";
		const int64 now = ClaudeNowMs();
		int64 next = candidate + 1;
		while (next < candidates.Count() && !TakesOver(*candidates[next], usageLimit, *chats->claude, now)) next += 1;
		if (next >= candidates.Count()) {
			Pause(claudeBlockedStop.View(), why.View());
			return;
		}
		candidate = next;
		turn->model = candidates[candidate]->name;
		Core::String switched = ((Core::String("switched to ") + candidates[candidate]->name.View()) + ": ") + why.View();
		UiNote(Core::StringView("routing"), switched.View());
		turn->recoveries.Push(switched);
	}

	// --- Calls and the end -----------------------------------------------------------------------------------------------

	// Claude reads a step's results together, so the last one takes what came for the turn while the step ran - the
	// soonest Claude can see it.
	void TurnRun::AnswerClaude(Core::StringView toolUseId, const ToolOutcome& outcome, bool last) {
		ClaudeLine* call = claude->AwaitCall(toolUseId, kClaudeCallWaitMs);
		if (!call) return;
		if (last && !ending) DeliverMessages(true);
		Core::StringView content = outcome.content.View();
		Core::String kept = content.ByteLength() <= kRunKeptToolResultBytes ? outcome.content : Core::String(content.Substring(0, kRunKeptToolResultBytes)) + "\n[result truncated]";
		Core::Array<IED::ToolImage> shown = outcome.images;
		{
			IED::HostLock guard(*context);
			if (last) SetAside();
			if (!claudeAside.IsEmpty()) {
				kept = (kept + "\n\n") + claudeAside.View();
				for (const IED::ToolImage& image : claudeAsideImages) shown.Push(image);
				claudeAside = Core::String();
				claudeAsideImages.Clear();
			}
		}
		Core::Array<ClaudeImage> images;
		for (const IED::ToolImage& image : shown) {
			ClaudeImage block;
			if (ReadClaudeImage(ws, image, block)) images.Push(block);
		}
		claude->Answer(call, McpCallResult(kept.View(), images, outcome.isError).View());
	}

	void TurnRun::EndClaude() {
		if (!claude) return;
		TurnRun* self = this;
		if (claude->Running() && claude->querying && stop == "finished" && !run->cancelled) {
			StepEvents events = [self](StepEventKind kind, Core::StringView delta, int64 call) { self->OnEvent(kind, delta, call); };
			int64 estimateBefore = 0;
			{
				IED::HostLock guard(*context);
				estimateBefore = EstimateTokens();
			}
			StepResult* last = ClaudeStep(events);
			IED::HostLock guard(*context);
			CloseStreaming();
			Account(last, 0, estimateBefore);
		}
		claude->Settle(Core::StringView(kClaudeTurnOverNote), true, kClaudeDrainMs, [self](ClaudeLine* line) { self->ClaudeAside(line); });
		if (claude->Running()) {
			Core::String error;
			ClaudeSession* session = claude;
			Serialization::DomNode usage = claude->process->Request(Core::StringView("{\"subtype\":\"get_usage\",\"skip_behaviors\":true}"), kClaudeUsageAskMs, error,
				[session](ClaudeLine* line) { session->Serve(line); });
			if (usage.IsValid()) {
				IED::HostLock guard(*context);
				chats->claude->TookUsage(usage);
			}
			Serialization::DomNode contextUsage = claude->process->Request(Core::StringView("{\"subtype\":\"get_context_usage\",\"detail\":\"summary\"}"), kClaudeUsageAskMs, error,
				[session](ClaudeLine* line) { session->Serve(line); });
			if (contextUsage.IsValid()) {
				IED::HostLock guard(*context);
				ClaudeContext(contextUsage);
			}
		}
		IED::HostLock guard(*context);
		chat->claudeSession = claude->sessionId;
		chat->claudeTurns = claude->turns;
		claude->inUse = false;
		claude->idleSinceMs = ClaudeNowMs();
	}
}
