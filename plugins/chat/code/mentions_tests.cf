// mentions and sent: what chat.send's mentions and attachments are checked for, kept as, and how the model is told of
// them when the turn starts.

include "mentions.ch"
include "sent.ch"
include "images.ch"

static Core::StringView MentionView(const char* text) { return Core::StringView(text); }

static Serialization::DomNode MentionJson(Core::StringView json) {
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	Serialization::ReadResult read = Serialization::ReadJson(json, *doc);
	return read.Ok() ? read.root : Serialization::DomNode();
}

static Ai::Mention MentionOf(const char* kind, const char* ref, const char* label) {
	Ai::Mention mention;
	mention.kind = Core::String(kind);
	mention.ref = Core::String(ref);
	mention.label = Core::String(label);
	return mention;
}

static Ai::Attachment AttachmentOf(const char* mime, int64 bytes) {
	Ai::Attachment attachment;
	attachment.name = Core::String("shot.png");
	attachment.path = Core::String(".ied/local/chats/c1/media/m3-shot.png");
	attachment.mime = Core::String(mime);
	attachment.bytes = bytes;
	return attachment;
}

// Whether chat.send's mentions `json` are refused with bad_request.
static bool MentionsRefused(const char* json) {
	try {
		Ai::SentMentions(MentionJson(MentionView(json)));
		return false;
	}
	catch (IED::RpcError& error) {
		return error.code == IED::ErrorCode::BadRequest;
	}
}

[test("server.ai.mentions")]
class MentionTests {
	[test("sent_mentions_checked")]
	public static void TestChecked() {
		Core::Array<Ai::Mention> read = Ai::SentMentions(MentionJson(MentionView("[{\"kind\": \"file\", \"ref\": \"src/a.cf\", \"label\": \"src/a.cf\"}, {\"kind\": \"problems\", \"label\": \"problems\"}]")));
		assert_eq((int64)2, read.Count(), "both read");
		assert_true(read[0].ref.View() == "src/a.cf" && read[1].kind.View() == "problems", "as sent");
		assert_true(Ai::SentMentions(Serialization::DomNode()).IsEmpty(), "none sent is none");
		assert_true(MentionsRefused("[{\"kind\": \"url\", \"ref\": \"x\", \"label\": \"x\"}]"), "a kind there is not");
		assert_true(MentionsRefused("[{\"kind\": \"terminal\", \"label\": \"terminal:Build\"}]"), "a terminal without its id");
		assert_true(MentionsRefused("{\"kind\": \"file\"}"), "not an array");
	}

	[test("media_names")]
	public static void TestMediaName() {
		assert_true(Ai::MediaName(MentionView("C:\\Users\\me\\My Shot (2).png")).View() == "My_Shot__2_.png", "the last part, its spaces and brackets made _");
		assert_true(Ai::MediaName(MentionView("a/b/notes.txt")).View() == "notes.txt", "a / path's last part");
		assert_true(Ai::MediaName(MentionView("..")).View() == "file" && Ai::MediaName(MentionView("")).View() == "file", "no name that climbs, none empty");
	}

	[test("the_tool_that_reads_it")]
	public static void TestTools() {
		Ai::MentionCall file = Ai::MentionTool(MentionOf("file", "src/a.cf", "src/a.cf"));
		assert_true(file.tool.View() == "fs_read" && MentionJson(file.args.View()).Member("path").AsView() == "src/a.cf", "a file is fs_read of its path");
		assert_true(Ai::MentionTool(MentionOf("folder", "src", "src/")).tool.View() == "fs_list", "a folder is listed");
		Ai::MentionCall symbol = Ai::MentionTool(MentionOf("symbol", "Game::Ring::Push", "#Game::Ring::Push"));
		assert_true(symbol.tool.View() == "code_read_symbol" && MentionJson(symbol.args.View()).Member("symbol").AsView() == "Game::Ring::Push", "a symbol is read whole");
		Serialization::DomNode placed = MentionJson(Ai::MentionTool(MentionOf("symbol", "src/ring.cf:42", "#Ring::Push")).args.View());
		assert_true(placed.Member("path").AsView() == "src/ring.cf" && placed.Member("line").AsInt() == 42 && placed.Member("symbol").AsView() == "Ring::Push", "by the place of its name, narrowed by the name");
		assert_true(MentionJson(Ai::MentionTool(MentionOf("symbol", "Ring::Push", "#Ring::Push")).args.View()).Member("symbol").AsView() == "Ring::Push", "a qualified name is not a place");
		Ai::MentionCall chat = Ai::MentionTool(MentionOf("chat", "c18f", "chat:Fix it"));
		assert_true(chat.tool.View() == "chat_read" && MentionJson(chat.args.View()).Member("turns").AsInt() == 3, "a chat's last 3 turns");
		assert_true(Ai::MentionTool(MentionOf("problems", "", "problems")).args.View() == "{}", "the Error List, all of it");
		assert_true(Ai::MentionTool(MentionOf("terminal", "t1", "terminal:Build")).tool.IsEmpty(), "a terminal is the terminal plugin's binding");
	}

	[test("blocks_and_tails")]
	public static void TestBlocks() {
		Core::String block = Ai::MentionBlock(MentionOf("file", "a \"b\".txt", "a \"b\".txt"), MentionView("1: x"));
		assert_true(block.View() == "<mention label=\"@a 'b'.txt\" kind=\"file\">\n1: x\n</mention>", "one block, the label's quotes made single");
		assert_true(Ai::TailLines(MentionView("a\nb\nc\n\n"), 2).View() == "b\nc", "the last lines, no final empty one");
		assert_true(Ai::TailLines(MentionView("a\nb"), 5).View() == "a\nb", "fewer than asked: all of them");
	}

	[test("attachments_shown_or_named")]
	public static void TestAttachments() {
		assert_true(Ai::AttachedImage(AttachmentOf("image/png", 1024)), "a PNG is shown");
		assert_true(!Ai::AttachedImage(AttachmentOf("image/png", Ai::kToolImageMaxBytes + 1)), "one past 4 MiB is named");
		assert_true(!Ai::AttachedImage(AttachmentOf("image/svg+xml", 10)), "a type the format does not take is named");
		Core::String note = Ai::AttachedNote(AttachmentOf("text/plain", 12300));
		assert_true(note.View() == "[attached: .ied/local/chats/c1/media/m3-shot.png (shot.png, 13 KB, text/plain); fs_read reads it]", "its path, name, size and type");
	}

	[test("queued_message_kept_whole")]
	public static void TestQueued() {
		Ai::OwnerMessage message;
		message.text = Core::String("look at this");
		message.mentions.Push(MentionOf("diff", "", "diff"));
		message.attachments.Push(AttachmentOf("image/png", 4));
		IED::JsonWriter json;
		message.WriteJson(json);
		Ai::OwnerMessage back;
		back.Read(MentionJson(json.View()));
		assert_true(back.text.View() == "look at this" && back.mentions.Count() == 1 && back.attachments.Count() == 1, "read back whole");
		assert_true(back.attachments[0].path.View() == ".ied/local/chats/c1/media/m3-shot.png" && back.attachments[0].bytes == 4, "the attachment as kept");
		Ai::OwnerMessage older;
		older.Read(MentionJson(MentionView("\"plain text\"")));
		assert_true(older.text.View() == "plain text" && older.mentions.IsEmpty(), "an older header's text");
	}

	[test("turn_user_message")]
	public static void TestTurnUser() {
		Ai::Turn turn;
		turn.turnId = Core::String("u1");
		turn.userText = Core::String("why?");
		turn.mentions.Push(MentionOf("output", "git", "output:Git"));
		IED::JsonWriter json;
		turn.WriteJson(json, false);
		Serialization::DomNode user = MentionJson(json.View()).Member("user");
		assert_true(user.Member("mentions").At(0).Member("label").AsView() == "output:Git", "the mentions go with the text");
		assert_true(!user.Member("attachments").IsValid(), "no attachments, no field");
		Ai::Turn back;
		back.Read(MentionJson(json.View()));
		assert_true(back.mentions.Count() == 1 && back.mentions[0].ref.View() == "git", "and read back");
	}

	[test("attached_images_in_the_message")]
	public static void TestUserImages() {
		Ai::ModelMessage message;
		message.role = Core::String("user");
		message.content = Core::String("what is wrong here?");
		IED::ToolImage gone;
		gone.mime = Core::String("image/png");
		gone.path = Core::String("missing.png");
		message.images.Push(gone);
		IED::Workspace ws;
		ws.root = Core::String((FS::TempDirectory() / "ied-no-such-folder").View());
		IED::JsonWriter json;
		const int64 encoded = Ai::WriteUserWithImages(json, ws, &message);
		Serialization::DomNode parts = MentionJson(json.View()).Member("content");
		assert_true(parts.At(0).Member("text").AsView() == "what is wrong here?", "the text first, in the same message");
		assert_true(parts.At(1).Member("text").AsView().Contains(MentionView("missing.png is no longer there")), "an image since removed is said");
		assert_eq((int64)0, encoded, "nothing encoded");
	}
}
