include "claudeaccount.ch"
include "pacing.ch"

namespace Ai
{
	const int64 kUsageUnknownBlockMs = 15 * 60 * 1000;   // a usage limit that names no reset: look again after this

	static int64 AccountNowMs() { return Platform::UnixTimeNs() / 1000000; }

	void ClaudeAccount::Init(IED::PluginContext* context) {
		this.context = context;
		usage.extraUtilization = -1;
		ClaudeAccount* self = this;
		context->TopicFrom(Core::StringView(kUsageTopic), [self]() -> Core::String { return self->SnapshotJson(); });
		Core::String problem;
		if (!context->Method(Core::StringView("ai.usage"), [self](const IED::Request& request) -> Core::String { return self->UsageMethod(request); }, problem)) context->Log(problem.View());
		if (!context->Method(Core::StringView("ai.claude.signIn"), [self](const IED::Request& request) -> Core::String { return self->SignInMethod(request); }, problem)) context->Log(problem.View());
		if (!context->Method(Core::StringView("ai.claude.install"), [self](const IED::Request& request) -> Core::String { return self->InstallMethod(request); }, problem)) context->Log(problem.View());
		if (!context->Method(Core::StringView("ai.claude.setup"), [self](const IED::Request& request) -> Core::String { return self->SetupMethod(request); }, problem)) context->Log(problem.View());
	}

	Core::Array<Core::String> ClaudeAccount::Command() const {
		return FindClaude(ClaudeCommandSetting(context->Setting(Core::StringView("ai.claude.command"), Core::StringView("")).View()));
	}

	void ClaudeAccount::Watch(func<bool()> done, func<void(bool)> after) {
		context->StartThread([done, after]() {
			const int64 until = AccountNowMs() + kClaudeWindowWatchMs;
			bool succeeded = false;
			while (!succeeded && AccountNowMs() < until) {
				Threading::Thread::Sleep(kClaudeWindowPollNs);
				succeeded = done();
			}
			after(succeeded);
		});
	}

	bool ClaudeAccount::Claim(bool& waiting) {
		IED::HostLock guard(*context);
		if (waiting) return false;
		waiting = true;
		Changed();
		return true;
	}

	void ClaudeAccount::Release(bool& waiting) {
		IED::HostLock guard(*context);
		waiting = false;
		Changed();
	}

	Core::String ClaudeAccount::SignInMethod(const IED::Request& request) {
		if (!kClaudeSubscriptionOffered) throw IED::RpcError(IED::ErrorCode::Unavailable, kClaudeNotOffered);
		Core::Array<Core::String> command = Command();
		if (command.IsEmpty()) throw IED::RpcError(IED::ErrorCode::NotFound, "no Claude Code CLI was found: install it first");
		if (!Claim(signingIn)) {
			IED::HostLock guard(*context);
			return SnapshotJson();
		}
		Core::Array<Core::String> login = command;
		login.Push(Core::String("auth"));
		login.Push(Core::String("login"));
		login.Push(Core::String("--claudeai"));
		Core::String problem;
		if (!OpenClaudeWindow(Core::StringView("Claude Code sign-in"), login, problem)) {
			Release(signingIn);
			throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
		}
		ClaudeAccount* self = this;
		Core::String folder = context->StateFolder();
		IED::HostLock guard(*context);
		Watch([command, folder]() -> bool {
			bool signedIn = false;
			Core::String method = ClaudeAuthMethod(command, folder.View(), signedIn);
			return signedIn && IsSubscriptionAuth(method.View());
		}, [self](bool succeeded) {
			self->Refresh(true);
			Core::String problem;
			if (succeeded && !self->Configured() && !self->Setup(true, problem)) self->context->Log((Core::String("Claude could not be set up: ") + problem.View()).View());
			self->Release(self->signingIn);
		});
		return SnapshotJson();
	}

	Core::String ClaudeAccount::InstallMethod(const IED::Request& request) {
		if (!kClaudeSubscriptionOffered) throw IED::RpcError(IED::ErrorCode::Unavailable, kClaudeNotOffered);
		if (!Command().IsEmpty()) throw IED::RpcError(IED::ErrorCode::Conflict, "Claude Code is installed already");
		if (!Claim(installing)) {
			IED::HostLock guard(*context);
			return SnapshotJson();
		}
		Core::Array<Core::String> install;
		const char*[6] words = { "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-NoExit", "-Command" };
		for (int64 i = 0; i < 6; ++i) install.Push(Core::String(words[i]));
		install.Push(Core::String(kClaudeInstallScript));
		Core::String problem;
		if (!OpenClaudeWindow(Core::StringView("Install Claude Code"), install, problem)) {
			Release(installing);
			throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
		}
		ClaudeAccount* self = this;
		IED::HostLock guard(*context);
		Watch([self]() -> bool { return !self->Command().IsEmpty(); }, [self](bool found) {
			if (found) self->Refresh(true);
			self->Release(self->installing);
		});
		return SnapshotJson();
	}

	Core::String ClaudeAccount::SetupMethod(const IED::Request& request) {
		Core::String problem;
		if (!Setup(true, problem) && !problem.IsEmpty()) throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
		IED::HostLock guard(*context);
		return SnapshotJson();
	}

	bool ClaudeAccount::Setup(bool force, Core::String& problem) {
		if (!kClaudeSubscriptionOffered) {
			problem = Core::String(kClaudeNotOffered);
			return false;
		}
		FS::Path mark = FS::Path(context->StateFolder().View()) / "claude-setup.json";
		if (!force && FS::FileExists(mark.CStr())) return false;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String defaultGroup = Core::String(Serialization::ReadJson(context->Setting(Core::StringView("ai.defaultGroup"), Core::StringView("")).View(), *doc).root.AsView());
		Core::String models;
		Core::String groups;
		WithClaudeModels(context->Setting(Core::StringView("ai.models"), Core::StringView("")).View(), context->Setting(Core::StringView("ai.groups"), Core::StringView("")).View(), defaultGroup.View(), models, groups);
		if (!context->SetSetting(Core::StringView("ai.models"), models.View(), problem) || !context->SetSetting(Core::StringView("ai.groups"), groups.View(), problem)) return false;
		Core::StringBuilder stamp;
		stamp.Append("{\"setUpMs\": ");
		stamp.AppendInt(AccountNowMs());
		stamp.Append("}");
		FS::WriteFileAtomically(mark.CStr(), (const void*)stamp.View().Data(), stamp.View().ByteLength());
		context->Log(Core::StringView("Claude is set up: the Claude models and the claude group are in the app settings (Settings > AI > Claude)"));
		IED::HostLock guard(*context);
		Changed();
		return true;
	}

	// ai.usage {refresh?}: the snapshot, the CLI asked first when `refresh`.
	Core::String ClaudeAccount::UsageMethod(const IED::Request& request) {
		if (request.params.Bool("refresh", false)) Refresh(true);
		IED::HostLock guard(*context);
		return SnapshotJson();
	}

	// get_usage asked of a CLI process of IED's own (no session kept, no model request); an invalid node with `error`.
	static Serialization::DomNode AskUsage(const Core::Array<Core::String>& command, Core::StringView folder, Core::String& error) {
		Core::Array<Core::String> argv = command;
		for (const Core::String& argument : ClaudeBaseArguments()) argv.Push(argument);
		argv.Push(Core::String("--no-session-persistence"));
		ClaudeProcess* process = new ClaudeProcess();
		Serialization::DomNode answer;
		if (!process->Start(argv, folder, ClaudeEnvironment(), error)) return answer;
		ClaudeServe refuse = [process](ClaudeLine* line) { process->Send(ControlRefusalLine(line->root.Member("request_id").AsView(), Core::StringView("IED's usage check answers nothing")).View()); };
		if (process->Request(Core::StringView("{\"subtype\":\"initialize\"}"), kUsageProcessMs, error, refuse).IsValid())
			answer = process->Request(Core::StringView("{\"subtype\":\"get_usage\",\"skip_behaviors\":true}"), kUsageProcessMs, error, refuse);
		process->Stop();
		return answer;
	}

	void ClaudeAccount::MigrateAuto() {
		Core::String models;
		Core::String groups;
		if (!WithoutAutoProfiles(context->Setting(Core::StringView("ai.models"), Core::StringView("")).View(), context->Setting(Core::StringView("ai.groups"), Core::StringView("")).View(), models, groups)) return;
		Core::String problem;
		if (!context->SetSetting(Core::StringView("ai.groups"), groups.View(), problem) || !context->SetSetting(Core::StringView("ai.models"), models.View(), problem)) {
			context->Log((Core::String("Claude's pacing could not be moved into ai.groups: ") + problem.View()).View());
			return;
		}
		context->Log(Core::StringView("Claude's pacing moved into ai.groups: each role that named a model auto profile has its ladder as paced places (docs/04 Pacing)"));
	}

	void ClaudeAccount::Refresh(bool force) {
		MigrateAuto();
		{
			IED::HostLock guard(*context);
			if (refreshing) return;
			if (!force && usage.updatedMs > 0 && AccountNowMs() - usage.updatedMs < kUsageFreshMs) return;
			refreshing = true;
			Changed();
		}
		Core::Array<Core::String> command = Command();
		Core::String folder = context->StateFolder();
		Core::String version = ClaudeVersion(command, folder.View());
		bool signedIn = false;
		Core::String method = ClaudeAuthMethod(command, folder.View(), signedIn);
		Core::String error;
		Serialization::DomNode answer;
		if (command.IsEmpty()) error = Core::String("no Claude Code CLI was found: install it, or set ai.claude.command");
		else if (signedIn) answer = AskUsage(command, folder.View(), error);
		Core::String problem;
		if (signedIn && IsSubscriptionAuth(method.View()) && kClaudeSubscriptionOffered && !Configured() && !Setup(false, problem) && !problem.IsEmpty())
			context->Log((Core::String("Claude could not be set up: ") + problem.View()).View());
		IED::HostLock guard(*context);
		refreshing = false;
		asked = true;
		cliPath = command.IsEmpty() ? Core::String() : command[0];
		if (!version.IsEmpty()) cliVersion = version;
		if (!method.IsEmpty()) {
			signIn = Core::String(signedIn ? "signed_in" : "signed_out");
			authMethod = method;
		}
		if (answer.IsValid() && ReadUsage(answer, usage, AccountNowMs())) usage.error = Core::String();
		else if (!signedIn && !command.IsEmpty()) usage.Forget();
		else usage.error = error.IsEmpty() ? Core::String("the CLI's usage answer was not one IED reads") : error;
		Changed();
	}

	void ClaudeAccount::TookUsage(const Serialization::DomNode& response) {
		if (!ReadUsage(response, usage, AccountNowMs())) return;
		Changed();
	}

	void ClaudeAccount::TookAuth(bool signedIn, Core::StringView method) {
		if (method.IsEmpty()) return;
		signIn = Core::String(signedIn ? "signed_in" : "signed_out");
		authMethod = Core::String(method);
		Changed();
	}

	void ClaudeAccount::TookRateLimit(const Serialization::DomNode& info) {
		TakeRateLimit(info, usage, AccountNowMs());
		Changed();
	}

	void ClaudeAccount::MetLimit(Core::StringView model, int64 untilMs) {
		const int64 now = AccountNowMs();
		UsageWindow* rejected = RejectedWindow(usage, now);
		if (rejected && Limits(usage, *rejected, model)) return;
		int64 until = untilMs;
		if (until <= now) until = usage.limitResetsAtMs > now ? usage.limitResetsAtMs : now + kUsageUnknownBlockMs;
		Core::String apart = ApartModel(usage, model);
		if (!apart.IsEmpty()) apartBlockedUntilMs.At(apart) = until;
		else blockedUntilMs = until;
		Changed();
	}

	int64 ClaudeAccount::BlockedUntil(Core::StringView model, int64 nowMs) const {
		Core::String apart = ApartModel(usage, model);
		int64 until = blockedUntilMs;
		if (!apart.IsEmpty() && !apartBlockedUntilMs.TryGet(apart, until)) until = 0;
		if (until <= nowMs) until = 0;
		for (UsageWindow* window : usage.windows)
			if (Limits(usage, *window, model) && UsedUp(*window, nowMs) && window->resetsAtMs > until) until = window->resetsAtMs;
		return until;
	}

	bool ClaudeAccount::Configured() const {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode models = Serialization::ReadJson(context->Setting(Core::StringView("ai.models"), Core::StringView("")).View(), *doc).root;
		for (int64 i = 0; models.Kind() == Serialization::DomKind::Object && i < models.Count(); ++i)
			if (models.ValueAt(i).Member("provider").AsView() == "claude-code") return true;
		return false;
	}

	Core::String ClaudeAccount::SnapshotJson() {
		const int64 now = AccountNowMs();
		IED::JsonWriter json;
		json.BeginObject();
		json.Key(Core::StringView("claude"));
		json.BeginObject();
		json.BoolField("offered", kClaudeSubscriptionOffered);
		json.BoolField("configured", Configured());
		json.Key(Core::StringView("cli"));
		json.BeginObject();
		json.BoolField("asked", asked);
		json.Field("path", cliPath.View());
		json.Field("version", cliVersion.View());
		json.Field("signIn", signIn.View());
		json.Field("authMethod", authMethod.View());
		json.BoolField("subscription", signIn == "signed_in" && IsSubscriptionAuth(authMethod.View()));
		json.BoolField("signingIn", signingIn);
		json.BoolField("installing", installing);
		json.EndObject();
		json.BoolField("refreshing", refreshing);
		json.IntField("blockedUntilMs", BlockedUntil(Core::StringView(""), now));
		json.IntField("nowMs", now);
		json.Key(Core::StringView("chains"));
		Core::Array<Core::String> problems;
		Core::Array<ModelProfile*> models = ReadModels(context->Setting(Core::StringView("ai.models"), Core::StringView("")).View(), problems);
		WriteChains(json, ClaudeChains(models, context->Setting(Core::StringView("ai.groups"), Core::StringView("")).View(), *this, now));
		json.Key(Core::StringView("usage"));
		WriteUsage(json, usage, now);
		json.EndObject();
		json.EndObject();
		return json.ToString();
	}

	void ClaudeAccount::Changed() { context->Publish(Core::StringView(kUsageTopic), "usage.changed", SnapshotJson().View()); }
}
