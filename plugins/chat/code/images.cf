include "images.ch"

namespace Ai
{
	bool SupportedImage(Core::StringView mime) {
		return mime == "image/png" || mime == "image/jpeg" || mime == "image/webp" || mime == "image/gif";
	}

	static bool IsAbsolute(Core::StringView path) {
		return path.StartsWith(Core::StringView("/")) || (path.ByteLength() >= 2 && path.ByteAt(1) == ':');
	}

	// The path relative to the workspace root; false with `why` when it is not inside it.
	static bool InsideWorkspace(const IED::Workspace& ws, Core::StringView path, Core::String& relative, Core::String& why) {
		Core::String named = Core::String(path);
		if (IsAbsolute(path) && !IED::RelativeTo(ws.root.View(), path, named)) {
			why = Core::String("it is not inside the workspace");
			return false;
		}
		try {
			relative = IED::NormalizePath(named.View());
			return true;
		}
		catch (IED::RpcError& error) {
			why = error.message;
			return false;
		}
	}

	// Why the image cannot be sent; empty when it can, with its path made relative in `kept`.
	static Core::String Unsendable(const IED::Workspace& ws, const IED::ToolImage& image, IED::ToolImage& kept) {
		if (!SupportedImage(image.mime.View())) return Core::String("its type is not image/png, image/jpeg, image/webp or image/gif");
		Core::String why;
		if (!InsideWorkspace(ws, image.path.View(), kept.path, why)) return why;
		const int64 bytes = FS::FileSize((FS::Path(ws.root.View()) / kept.path.View()).CStr());
		if (bytes < 0) return Core::String("there is no such file");
		if (bytes > kToolImageMaxBytes) return Core::String("it is larger than 4 MB");
		kept.mime = image.mime;
		return Core::String();
	}

	Core::Array<IED::ToolImage> AcceptedImages(const IED::Workspace& ws, const Core::Array<IED::ToolImage>& images, Core::Array<Core::String>& notes) {
		Core::Array<IED::ToolImage> accepted;
		for (const IED::ToolImage& image : images) {
			IED::ToolImage kept;
			Core::String why = Unsendable(ws, image, kept);
			if (why.IsEmpty()) accepted.Push(kept);
			else notes.Push((((Core::String("[image ") + image.path.View()) + " left out: ") + why.View()) + "]");
		}
		return accepted;
	}

	Core::String ImagesAsText(const Core::Array<IED::ToolImage>& images, Core::StringView why) {
		Core::StringBuilder out;
		for (const IED::ToolImage& image : images) {
			out.Append("\n[image ");
			out.Append(image.path.View());
			out.Append(" (");
			out.Append(image.mime.View());
			out.Append("): ");
			out.Append(why);
			out.Append("]");
		}
		return out.ToString();
	}

	// The image's file as a data: URL; false when it can no longer be read.
	static bool DataUrl(Core::StringView root, const IED::ToolImage& image, Core::String& url) {
		FS::Path file = FS::Path(root) / image.path.View();
		const int64 size = FS::FileSize(file.CStr());
		if (size < 0 || size > kToolImageMaxBytes) return false;
		Core::Array<uint8> bytes;
		bytes.Resize(size);
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen() || opened.ReadAll((void*)bytes.Data(), size) != size) return false;
		url = ((Core::String("data:") + image.mime.View()) + ";base64,") + Core::Base64Encode((const void*)bytes.Data(), size).View();
		return true;
	}

	static void TextPart(IED::JsonWriter& json, Core::StringView text) {
		json.BeginObject();
		json.Field("type", "text");
		json.Field("text", text);
		json.EndObject();
	}

	static void ImagePart(IED::JsonWriter& json, Core::StringView url) {
		json.BeginObject();
		json.Field("type", "image_url");
		json.Key(Core::StringView("image_url"));
		json.BeginObject();
		json.Field("url", url);
		json.EndObject();
		json.EndObject();
	}

	int64 WriteImagesMessage(IED::JsonWriter& json, Core::StringView root, const Core::Array<ModelMessage*>& results) {
		int64 encoded = 0;
		json.BeginObject();
		json.Field("role", "user");
		json.Key(Core::StringView("content"));
		json.BeginArray();
		for (ModelMessage* result : results)
			for (const IED::ToolImage& image : result->images) {
				Core::String url;
				const Core::String from = ((Core::String(" from the result of call ") + result->toolCallId.View()) + ", ") + image.path.View();
				if (!DataUrl(root, image, url)) {
					TextPart(json, ((Core::String("[the image") + from.View()) + ", is no longer there]").View());
					continue;
				}
				TextPart(json, ((Core::String("The image") + from.View()) + ":").View());
				ImagePart(json, url.View());
				encoded += url.ByteLength();
			}
		json.EndArray();
		json.EndObject();
		return encoded;
	}

	int64 WriteUserWithImages(IED::JsonWriter& json, Core::StringView root, const ModelMessage* message) {
		int64 encoded = 0;
		json.BeginObject();
		json.Field("role", "user");
		json.Key(Core::StringView("content"));
		json.BeginArray();
		TextPart(json, message->content.View());
		for (const IED::ToolImage& image : message->images) {
			Core::String url;
			if (!DataUrl(root, image, url)) {
				TextPart(json, ((Core::String("[the attached image ") + image.path.View()) + " is no longer there]").View());
				continue;
			}
			TextPart(json, ((Core::String("The attached image ") + image.path.View()) + ":").View());
			ImagePart(json, url.View());
			encoded += url.ByteLength();
		}
		json.EndArray();
		json.EndObject();
		return encoded;
	}

	int64 CountImages(const Core::Array<ModelMessage*>& messages) {
		int64 count = 0;
		for (ModelMessage* message : messages) count += message->images.Count();
		return count;
	}
}
