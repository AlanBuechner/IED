include "api/plugin.ch"
include "modeltools.ch"

namespace Ai
{
	static int64 ToolsNowMs() { return Platform::UnixTimeNs() / 1000000; }

	static void Percent(Core::StringBuilder& out, double value) {
		out.AppendDouble(value, 0);
		out.Append("%");
	}

	static void WindowLine(Core::StringBuilder& out, const UsageWindow* window, int64 now) {
		out.Append("- ");
		out.Append(window->label.View());
		out.Append(": ");
		Percent(out, window->utilization);
		out.Append(" used");
		if (window->resetsAtMs > 0) {
			out.Append(", resets ");
			out.Append(ResetText(window->resetsAtMs, now).View());
			out.Append("; ");
			Percent(out, Through(*window, now) * 100.0);
			out.Append(" through; pace ");
			out.AppendDouble(Pace(*window, now), 2);
			out.Append("x");
		}
		if (UsedUp(*window, now)) out.Append(" - USED UP");
		out.Append("\n");
	}

	static void ProfileLine(Core::StringBuilder& out, const ModelProfile* profile, const ClaudeAccount& account, int64 now) {
		out.Append("- ");
		out.Append(profile->name.View());
		out.Append(": ");
		if (!profile->IsClaude()) {
			out.Append(PrivacyName(profile->privacy));
			out.Append(" model ");
			out.Append(profile->model.View());
			out.Append("\n");
			return;
		}
		if (!profile->IsPaced()) {
			out.Append("Claude ");
			out.Append(profile->model.View());
			out.Append("\n");
			return;
		}
		out.Append("Claude, paced (");
		for (int64 i = 0; i < profile->ladder.Count(); ++i) {
			if (i > 0) out.Append(" > ");
			out.Append(profile->ladder[i].View());
		}
		out.Append(", against ");
		out.Append(profile->pacingTarget.View());
		out.Append("): now ");
		PacedChoice choice = ChoosePaced(account.usage, profile->ladder, profile->pacingTarget.View(), now);
		out.Append(choice.model.IsEmpty() ? Core::StringView("none - Claude is used up") : choice.model.View());
		out.Append(" (");
		out.Append(choice.why.View());
		out.Append(")\n");
	}

	Core::String UsageText(const ClaudeAccount& account, const Core::Array<ModelProfile*>& models, int64 now) {
		Core::StringBuilder out;
		out.Append("Claude Code: ");
		if (account.cliPath.IsEmpty()) out.Append("no CLI found yet");
		else {
			out.Append(account.cliVersion.IsEmpty() ? Core::StringView("found") : account.cliVersion.View());
			out.Append(account.signIn == "signed_in" && IsSubscriptionAuth(account.authMethod.View()) ? Core::StringView(", on the Claude subscription") : Core::StringView(", NOT signed in to a Claude subscription (Claude turns are refused)"));
		}
		const ClaudeUsage& usage = account.usage;
		if (!usage.plan.IsEmpty()) {
			out.Append("; plan ");
			out.Append(usage.plan.View());
		}
		out.Append("\n");
		if (!usage.known || !usage.available) out.Append("The plan's usage is not known");
		else {
			out.Append("The plan's windows (pace 1.0x lasts exactly to the reset; above it runs out early):\n");
			for (const UsageWindow* window : usage.windows) WindowLine(out, window, now);
		}
		if (!usage.error.IsEmpty()) {
			out.Append(" (the last ask failed: ");
			out.Append(usage.error.View());
			out.Append(")");
		}
		if (!usage.known || !usage.available) out.Append("\n");
		const int64 blocked = account.BlockedUntil(now);
		if (blocked > 0) {
			out.Append("Claude is used up; it frees ");
			out.Append(ResetText(blocked, now).View());
			out.Append("\n");
		}
		out.Append("Models (ai.models):\n");
		for (const ModelProfile* profile : models) ProfileLine(out, profile, account, now);
		return out.ToString();
	}

	static Core::Array<ModelProfile*> ModelsOf(const ToolInvocation& call) {
		Core::Array<Core::String> problems;
		return ReadModels(call.context->Setting(Core::StringView("ai.models"), WsId(call.ws)).View(), problems);
	}

	static ToolOutcome UsageRun(Chats* chats, const ToolInvocation& call) {
		if (call.args.Member("refresh").AsBool()) chats->claude->Refresh(false);
		Core::Array<ModelProfile*> models = ModelsOf(call);
		IED::HostLock guard(*call.context);
		Core::StringBuilder out;
		out.Append(UsageText(*chats->claude, models, ToolsNowMs()).View());
		out.Append("This chat: ");
		out.Append(call.chat->pinnedModel.IsEmpty() ? Core::StringView("its group's model") : (Core::String("pinned to ") + call.chat->pinnedModel.View()).View());
		out.Append(" (chat_set_model changes it for the next turns)\n");
		return ToolResult(out.View(), Core::StringView("Claude usage"));
	}

	// The chat the call names, this one when it names none; null with `problem`.
	static Chat* Target(Chats* chats, Chat* self, const ToolInvocation& call, Core::String& problem) {
		Core::StringView id = call.args.Member("chat").AsView();
		if (id.IsEmpty() || id == self->chatId.View()) return self;
		for (Chat* each : chats->InWorkspace(call.ws.id.View()))
			if (each->chatId.View() == id) return each;
		problem = (Core::String("there is no chat ") + id) + " in this workspace; chat_list lists them";
		return nullptr;
	}

	static ToolOutcome SetModelRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		Core::StringView name = call.args.Member("model").AsView();
		Core::Array<ModelProfile*> models = ModelsOf(call);
		if (!name.IsEmpty() && !FindModel(models, name)) {
			Core::StringBuilder known;
			for (ModelProfile* profile : models) {
				if (!known.IsEmpty()) known.Append(", ");
				known.Append(profile->name.View());
			}
			return ToolError(((Core::String("chat_set_model: there is no model ") + name) + " in ai.models; they are " + known.View()).View());
		}
		IED::HostLock guard(*call.context);
		Core::String problem;
		Chat* chat = Target(chats, self, call, problem);
		if (!chat) return ToolError((Core::String("chat_set_model: ") + problem.View()).View());
		chat->pinnedModel = Core::String(name);
		chats->Changed(chat);
		Core::StringBuilder said;
		said.Append(chat == self ? "This chat's" : "That chat's");
		said.Append(" next turns use ");
		said.Append(name.IsEmpty() ? Core::StringView("its group's model again") : name);
		said.Append(chat == self ? "; this turn goes on with the model it started on." : ".");
		return ToolResult(said.View(), (Core::String("Model: ") + (name.IsEmpty() ? Core::StringView("the group's") : name)).View());
	}

	static ToolSpec* ModelTool(const char* name, const char* description, const char* parameters, ToolClass toolClass) {
		ToolSpec* spec = new ToolSpec();
		spec->name = Core::String(name);
		spec->description = Core::String(description);
		spec->parameters = Core::String(parameters);
		spec->toolClass = toolClass;
		spec->parallelSafe = toolClass == ToolClass::Read;
		spec->inPlan = toolClass == ToolClass::Read;
		spec->deferred = true;
		spec->group = Core::String("models");
		return spec;
	}

	void AddModelTools(ToolRegistry& registry, Chats* chats, Chat* chat) {
		ToolSpec* usage = ModelTool("ai_usage", "The Claude plan's usage: each window (the 5-hour session, the week, the per-model weeks) - how much is used, how far through it is, its pace (1.0x lasts exactly to the reset) and when it resets - the models of ai.models, and which model pacing picks now. Use it before handing out work to decide which model a chat should use. Example: ai_usage({\"refresh\": true})",
			"{\"type\": \"object\", \"properties\": {\"refresh\": {\"type\": \"boolean\", \"description\": \"ask the CLI now rather than use the last answer\"}}, \"additionalProperties\": false}", ToolClass::Read);
		usage->plan = [](const ToolInvocation& call) -> ToolPlan {
			ToolPlan plan;
			plan.subject = Core::String("ai.usage(*)");
			plan.summary = Core::String("Read Claude's usage");
			return plan;
		};
		usage->run = [chats](const ToolInvocation& call) -> ToolOutcome { return UsageRun(chats, call); };
		registry.Add(usage);
		ToolSpec* pin = ModelTool("chat_set_model", "Pin a model of ai.models for a chat's next turns (this chat's, or another chat's by id), over its group's primary; \"\" goes back to the group's. Use a cheaper model for routine work to stretch Claude's usage, the strongest while it is under pace. Example: chat_set_model({\"model\": \"claude-sonnet\", \"chat\": \"c18f2a\"})",
			"{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"chat\": {\"type\": \"string\"}}, \"required\": [\"model\"], \"additionalProperties\": false}", ToolClass::Exec);
		pin->plan = [](const ToolInvocation& call) -> ToolPlan {
			ToolPlan plan;
			Core::StringView name = call.args.Member("model").AsView();
			plan.subject = (Core::String("chat.model(") + (name.IsEmpty() ? Core::StringView("*") : name)) + ")";
			plan.summary = (Core::String("Use ") + (name.IsEmpty() ? Core::StringView("the group's model") : name)) + " for the next turns";
			return plan;
		};
		pin->run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return SetModelRun(chats, chat, call); };
		registry.Add(pin);
	}
}
