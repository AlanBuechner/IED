include "api/plugin.ch"
include "chat.ch"
include "images.ch"

namespace Ai
{
	int64 ChatNowMs() { return Platform::UnixTimeNs() / 1000000; }

	Core::StringView WsId(const IED::Workspace& ws) { return ws.id.View(); }

	const char* ChatModeName(ChatMode mode) {
		if (mode == ChatMode::Ask) return "ask";
		return mode == ChatMode::Plan ? "plan" : "agent";
	}

	bool ReadChatMode(Core::StringView text, ChatMode& mode) {
		if (text == "ask") mode = ChatMode::Ask;
		else if (text == "plan") mode = ChatMode::Plan;
		else if (text == "agent") mode = ChatMode::Agent;
		else return false;
		return true;
	}

	const char* PermissionModeName(PermissionMode mode) {
		const char*[4] names = { "plan", "ask", "acceptEdits", "auto" };
		return names[(int32)mode];
	}

	bool ReadPermissionMode(Core::StringView text, PermissionMode& mode) {
		if (text == "plan") mode = PermissionMode::Plan;
		else if (text == "ask") mode = PermissionMode::Ask;
		else if (text == "acceptEdits") mode = PermissionMode::AcceptEdits;
		else if (text == "auto") mode = PermissionMode::Auto;
		else return false;
		return true;
	}

	const char* ChatStateName(ChatState state) {
		const char*[5] names = { "idle", "running", "awaiting_approval", "awaiting_answer", "paused" };
		return names[(int32)state];
	}

	PermissionMode DefaultPermission(ChatMode mode) { return mode == ChatMode::Plan ? PermissionMode::Plan : PermissionMode::Ask; }

	// --- Segments and messages ---------------------------------------------------------------------------------------

	void WriteToolImages(IED::JsonWriter& json, const Core::Array<IED::ToolImage>& images) {
		json.Key(Core::StringView("images"));
		json.BeginArray();
		for (const IED::ToolImage& image : images) {
			json.BeginObject();
			json.Field("mime", image.mime.View());
			json.Field("path", image.path.View());
			json.EndObject();
		}
		json.EndArray();
	}

	static void ReadToolImages(const Serialization::DomNode& list, Core::Array<IED::ToolImage>& images) {
		for (int64 i = 0; i < list.Count(); ++i) {
			IED::ToolImage image;
			image.mime = Core::String(list.At(i).Member("mime").AsView());
			image.path = Core::String(list.At(i).Member("path").AsView());
			images.Push(image);
		}
	}

	void Segment::WriteJson(IED::JsonWriter& json) const {
		json.BeginObject();
		WriteFields(json);
		json.EndObject();
	}

	void Segment::WriteFields(IED::JsonWriter& json) const {
		json.Field("segId", segId.View());
		json.Field("type", type.View());
		json.BoolField("done", done);
		if (!model.IsEmpty()) json.Field("model", model.View());
		if (type == "tool") {
			json.Field("tool", tool.View());
			json.Field("callId", callId.View());
			json.Field("argsText", argsText.View());
			if (!state.IsEmpty()) json.Field("state", state.View());
			if (!source.IsEmpty()) json.Field("source", source.View());
			if (ms > 0) json.IntField("ms", ms);
			if (plus > 0) json.IntField("plus", plus);
			if (minus > 0) json.IntField("minus", minus);
			if (state == "ok" || state == "error" || state == "denied" || state == "interrupted") {
				json.Key(Core::StringView("result"));
				json.BeginObject();
				json.Field("preview", preview.View());
				json.BoolField("isError", isError);
				if (!images.IsEmpty()) WriteToolImages(json, images);
				json.EndObject();
			}
		}
		else json.Field("text", text.View());
		if (!kind.IsEmpty()) json.Field("kind", kind.View());
		if (tokens > 0) json.IntField("tokens", tokens);
	}

	void Segment::Read(const Serialization::DomNode& node) {
		segId = Core::String(node.Member("segId").AsView());
		type = Core::String(node.Member("type").AsView());
		text = Core::String(node.Member("text").AsView());
		done = true;
		model = Core::String(node.Member("model").AsView());
		kind = Core::String(node.Member("kind").AsView());
		tool = Core::String(node.Member("tool").AsView());
		callId = Core::String(node.Member("callId").AsView());
		argsText = Core::String(node.Member("argsText").AsView());
		state = Core::String(node.Member("state").AsView());
		source = Core::String(node.Member("source").AsView());
		ms = node.Member("ms").AsInt();
		plus = node.Member("plus").AsInt();
		minus = node.Member("minus").AsInt();
		preview = Core::String(node.Member("result").Member("preview").AsView());
		isError = node.Member("result").Member("isError").AsBool();
		ReadToolImages(node.Member("result").Member("images"), images);
		tokens = node.Member("tokens").AsInt();
	}

	void ModelMessage::WriteJson(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("role", role.View());
		json.Field("content", content.View());
		if (!toolCalls.IsEmpty()) json.RawField("tool_calls", toolCalls.View());
		if (!toolCallId.IsEmpty()) json.Field("tool_call_id", toolCallId.View());
		if (!images.IsEmpty()) WriteToolImages(json, images);
		if (!reasoning.IsEmpty()) json.Field("reasoning_content", reasoning.View());
		json.EndObject();
	}

	void ModelMessage::WriteRequest(IED::JsonWriter& json, Core::StringView unsent, bool withReasoning) const {
		json.BeginObject();
		json.Field("role", role.View());
		Core::String text = unsent.IsEmpty() ? content : content + ImagesAsText(images, unsent).View();
		json.Field("content", text.View());
		if (withReasoning && !reasoning.IsEmpty()) json.Field("reasoning_content", reasoning.View());
		if (!toolCalls.IsEmpty()) json.RawField("tool_calls", toolCalls.View());
		if (!toolCallId.IsEmpty()) json.Field("tool_call_id", toolCallId.View());
		json.EndObject();
	}

	void ModelMessage::Read(const Serialization::DomNode& node) {
		role = Core::String(node.Member("role").AsView());
		content = Core::String(node.Member("content").AsView());
		if (node.Member("tool_calls").IsValid()) toolCalls = IED::NodeJson(node.Member("tool_calls"));
		toolCallId = Core::String(node.Member("tool_call_id").AsView());
		ReadToolImages(node.Member("images"), images);
		reasoning = Core::String(node.Member("reasoning_content").AsView());
	}

	// --- What an owner's message names ------------------------------------------------------------------------------

	void WriteMentions(IED::JsonWriter& json, const Core::Array<Mention>& mentions) {
		json.BeginArray();
		for (const Mention& mention : mentions) {
			json.BeginObject();
			json.Field("kind", mention.kind.View());
			json.Field("ref", mention.ref.View());
			json.Field("label", mention.label.View());
			json.EndObject();
		}
		json.EndArray();
	}

	void WriteAttachments(IED::JsonWriter& json, const Core::Array<Attachment>& attachments) {
		json.BeginArray();
		for (const Attachment& attachment : attachments) {
			json.BeginObject();
			json.Field("name", attachment.name.View());
			json.Field("path", attachment.path.View());
			json.Field("mime", attachment.mime.View());
			json.IntField("bytes", attachment.bytes);
			json.EndObject();
		}
		json.EndArray();
	}

	void ReadMentions(const Serialization::DomNode& list, Core::Array<Mention>& mentions) {
		for (int64 i = 0; i < list.Count(); ++i) {
			Mention mention;
			mention.kind = Core::String(list.At(i).Member("kind").AsView());
			mention.ref = Core::String(list.At(i).Member("ref").AsView());
			mention.label = Core::String(list.At(i).Member("label").AsView());
			mentions.Push(mention);
		}
	}

	void ReadAttachments(const Serialization::DomNode& list, Core::Array<Attachment>& attachments) {
		for (int64 i = 0; i < list.Count(); ++i) {
			Attachment attachment;
			attachment.name = Core::String(list.At(i).Member("name").AsView());
			attachment.path = Core::String(list.At(i).Member("path").AsView());
			attachment.mime = Core::String(list.At(i).Member("mime").AsView());
			attachment.bytes = list.At(i).Member("bytes").AsInt();
			attachments.Push(attachment);
		}
	}

	void OwnerMessage::WriteJson(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("text", text.View());
		if (!mentions.IsEmpty()) {
			json.Key(Core::StringView("mentions"));
			WriteMentions(json, mentions);
		}
		if (!attachments.IsEmpty()) {
			json.Key(Core::StringView("attachments"));
			WriteAttachments(json, attachments);
		}
		json.EndObject();
	}

	void OwnerMessage::Read(const Serialization::DomNode& node) {
		if (node.Kind() == Serialization::DomKind::String) {
			text = Core::String(node.AsView());
			return;
		}
		text = Core::String(node.Member("text").AsView());
		ReadMentions(node.Member("mentions"), mentions);
		ReadAttachments(node.Member("attachments"), attachments);
	}

	// --- Turns -------------------------------------------------------------------------------------------------------

	Segment* Turn::FindSegment(Core::StringView segId) const {
		for (Segment* segment : segments)
			if (segment->segId.View() == segId) return segment;
		return nullptr;
	}

	Segment* Turn::ToolSegment(Core::StringView callId) const {
		for (Segment* segment : segments)
			if (segment->type == "tool" && segment->callId.View() == callId) return segment;
		return nullptr;
	}

	void Turn::WriteUser(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("text", userText.View());
		if (!fromChatId.IsEmpty()) {
			json.Key(Core::StringView("from"));
			json.BeginObject();
			json.Field("chatId", fromChatId.View());
			json.Field("title", fromTitle.View());
			json.EndObject();
		}
		if (!resumed.IsEmpty()) json.Field("resumed", resumed.View());
		if (!mentions.IsEmpty()) {
			json.Key(Core::StringView("mentions"));
			WriteMentions(json, mentions);
		}
		if (!attachments.IsEmpty()) {
			json.Key(Core::StringView("attachments"));
			WriteAttachments(json, attachments);
		}
		json.EndObject();
	}

	void Turn::WriteJson(IED::JsonWriter& json, bool withMessages) const {
		json.BeginObject();
		json.Field("turnId", turnId.View());
		json.Key(Core::StringView("user"));
		WriteUser(json);
		if (hops > 0) json.IntField("hops", hops);
		json.Field("mode", ChatModeName(mode));
		json.Field("model", model.View());
		json.Field("group", group.View());
		if (!effort.IsEmpty()) json.Field("effort", effort.View());
		json.Key(Core::StringView("segments"));
		json.BeginArray();
		for (Segment* segment : segments) segment->WriteJson(json);
		json.EndArray();
		if (stop.IsEmpty()) {
			json.Key(Core::StringView("stop"));
			json.Null();
		}
		else json.Field("stop", stop.View());
		json.Key(Core::StringView("recoveries"));
		json.BeginArray();
		for (const Core::String& recovery : recoveries) json.String(recovery.View());
		json.EndArray();
		json.IntField("tokensIn", tokensIn);
		json.IntField("tokensOut", tokensOut);
		if (ttftMs > 0) json.IntField("ttftMs", ttftMs);
		if (genMs > 0) json.IntField("genMs", genMs);
		json.IntField("startedMs", startedMs);
		if (endedMs > 0) json.IntField("endedMs", endedMs);
		if (!prefill.IsEmpty() && !withMessages) json.RawField("prefill", prefill.View());
		if (withMessages) {
			json.Key(Core::StringView("messages"));
			json.BeginArray();
			for (ModelMessage* message : messages) message->WriteJson(json);
			json.EndArray();
		}
		json.EndObject();
	}

	void Turn::Read(const Serialization::DomNode& node) {
		turnId = Core::String(node.Member("turnId").AsView());
		userText = Core::String(node.Member("user").Member("text").AsView());
		fromChatId = Core::String(node.Member("user").Member("from").Member("chatId").AsView());
		fromTitle = Core::String(node.Member("user").Member("from").Member("title").AsView());
		resumed = Core::String(node.Member("user").Member("resumed").AsView());
		ReadMentions(node.Member("user").Member("mentions"), mentions);
		ReadAttachments(node.Member("user").Member("attachments"), attachments);
		hops = node.Member("hops").AsInt();
		ReadChatMode(node.Member("mode").AsView(), mode);
		model = Core::String(node.Member("model").AsView());
		group = Core::String(node.Member("group").AsView());
		effort = Core::String(node.Member("effort").AsView());
		Serialization::DomNode list = node.Member("segments");
		for (int64 i = 0; i < list.Count(); ++i) {
			Segment* segment = new Segment();
			segment->Read(list.At(i));
			segments.Push(segment);
		}
		stop = Core::String(node.Member("stop").AsView());
		Serialization::DomNode done = node.Member("recoveries");
		for (int64 i = 0; i < done.Count(); ++i) recoveries.Push(Core::String(done.At(i).AsView()));
		tokensIn = node.Member("tokensIn").AsInt();
		tokensOut = node.Member("tokensOut").AsInt();
		ttftMs = node.Member("ttftMs").AsInt();
		genMs = node.Member("genMs").AsInt();
		startedMs = node.Member("startedMs").AsInt();
		endedMs = node.Member("endedMs").AsInt();
		Serialization::DomNode sent = node.Member("messages");
		for (int64 i = 0; i < sent.Count(); ++i) {
			ModelMessage* message = new ModelMessage();
			message->Read(sent.At(i));
			messages.Push(message);
		}
	}

	// --- Waiting -----------------------------------------------------------------------------------------------------

	void Approval::WriteJson(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("approvalId", approvalId.View());
		json.Field("callId", callId.View());
		json.Field("tool", tool.View());
		json.RawField("args", args.IsEmpty() ? Core::StringView("{}") : args.View());
		json.Field("summary", summary.View());
		json.Field("why", why.View());
		json.Field("subject", subject.View());
		if (!diff.IsEmpty()) json.Field("diff", diff.View());
		if (plus > 0) json.IntField("plus", plus);
		if (minus > 0) json.IntField("minus", minus);
		json.EndObject();
	}

	void Question::WriteJson(IED::JsonWriter& json) const {
		json.BeginObject();
		json.Field("questionId", questionId.View());
		json.Field("callId", callId.View());
		json.Field("question", question.View());
		json.Key(Core::StringView("options"));
		json.BeginArray();
		for (const Core::String& option : options) json.String(option.View());
		json.EndArray();
		json.BoolField("allowText", allowText);
		json.EndObject();
	}

	// --- The chat ----------------------------------------------------------------------------------------------------

	Core::String Chat::NextId(const char* prefix) {
		counter += 1;
		Core::StringBuilder id;
		id.Append(prefix);
		id.AppendInt(counter);
		return id.ToString();
	}

	int64 Chat::WaitingApprovals() const {
		int64 waiting = 0;
		for (Approval* approval : approvals)
			if (approval->decision.IsEmpty()) waiting += 1;
		return waiting;
	}

	void Chat::WriteSummary(IED::JsonWriter& json) const {
		json.Field("chatId", chatId.View());
		json.Field("wsId", wsId.View());
		json.Field("title", title.View());
		json.Field("mode", ChatModeName(mode));
		json.Field("permission", PermissionModeName(permission));
		json.Field("group", group.View());
		json.Field("effort", effort.View());
		json.Field("pinnedModel", pinnedModel.View());
		json.Field("state", ChatStateName(state));
		if (!stateReason.IsEmpty()) json.Field("stateReason", stateReason.View());
		json.IntField("turnCount", turns.Count());
		json.IntField("updatedMs", updatedMs);
		int64 done = 0;
		for (ChatTask* task : tasks)
			if (task->status == "done" || task->status == "skipped") done += 1;
		json.IntField("tasksDone", done);
		json.IntField("tasksTotal", tasks.Count());
		json.IntField("approvalsWaiting", WaitingApprovals());
	}

	Core::String Chat::SummaryJson() const {
		IED::JsonWriter json;
		json.BeginObject();
		WriteSummary(json);
		json.EndObject();
		return json.ToString();
	}

	void Chat::WriteTasks(IED::JsonWriter& json) const {
		json.BeginArray();
		for (ChatTask* task : tasks) {
			json.BeginObject();
			json.Field("id", task->id.View());
			json.Field("title", task->title.View());
			json.Field("status", task->status.View());
			if (!task->note.IsEmpty()) json.Field("note", task->note.View());
			json.EndObject();
		}
		json.EndArray();
	}

	void Chat::WriteQueued(IED::JsonWriter& json) const {
		json.BeginArray();
		for (OwnerMessage* message : queued) json.String(message->text.View());
		json.EndArray();
	}

	void Chat::WriteModified(IED::JsonWriter& json) const {
		json.BeginArray();
		for (ModifiedFile* file : modified) {
			json.BeginObject();
			json.Field("path", file->path.View());
			json.IntField("plus", file->plus);
			json.IntField("minus", file->minus);
			json.EndObject();
		}
		json.EndArray();
	}

	void Chat::WriteResources(IED::JsonWriter& json) const {
		json.BeginArray();
		for (ChatResource* resource : resources) {
			json.BeginObject();
			json.Field("ref", resource->ref.View());
			json.Field("title", resource->title.View());
			json.Field("kind", resource->kind.View());
			json.EndObject();
		}
		json.EndArray();
	}

	int64 Clip::Lines() const {
		int64 lines = 0;
		Core::StringView view = text.View();
		for (int64 i = 0; i < view.ByteLength(); ++i)
			if (view.ByteAt(i) == '\n') lines += 1;
		return view.IsEmpty() || view.EndsWith(Core::StringView("\n")) ? lines : lines + 1;
	}

	void Chat::WriteClips(IED::JsonWriter& json) const {
		json.BeginArray();
		for (Clip* clip : clips) {
			Core::StringView text = clip->text.View();
			int64 cut = text.ByteLength() < kClipShownBytes ? text.ByteLength() : kClipShownBytes;
			while (cut > 0 && cut < text.ByteLength() && ((uint8)text.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
			json.BeginObject();
			json.Field("name", clip->name.View());
			json.Field("source", clip->source.View());
			json.IntField("lines", clip->Lines());
			json.IntField("bytes", text.ByteLength());
			json.Field("text", text.Substring(0, cut));
			json.EndObject();
		}
		json.EndArray();
	}

	static void WriteInUse(IED::JsonWriter& json, Core::StringView model, Core::StringView groupInUse, Core::StringView roleEffort) {
		json.Field("model", model);
		json.Field("groupInUse", groupInUse);
		json.Field("roleEffort", roleEffort);
	}

	Core::String Chat::ChangedJson(Core::StringView model, Core::StringView groupInUse, Core::StringView roleEffort) const {
		IED::JsonWriter json;
		json.BeginObject();
		WriteSummary(json);
		WriteInUse(json, model, groupInUse, roleEffort);
		json.EndObject();
		return json.ToString();
	}

	Core::String Chat::SnapshotJson(Core::StringView model, Core::StringView groupInUse, Core::StringView roleEffort, int64 recent) const {
		IED::JsonWriter json;
		json.BeginObject();
		WriteSummary(json);
		WriteInUse(json, model, groupInUse, roleEffort);
		json.Key(Core::StringView("tasks"));
		WriteTasks(json);
		json.Key(Core::StringView("queued"));
		WriteQueued(json);
		json.Key(Core::StringView("modified"));
		WriteModified(json);
		json.Key(Core::StringView("resources"));
		WriteResources(json);
		json.Key(Core::StringView("clips"));
		WriteClips(json);
		json.Key(Core::StringView("context"));
		if (context.IsEmpty()) json.Null();
		else json.Raw(context.View());
		const int64 first = turns.Count() > recent ? turns.Count() - recent : 0;
		json.BoolField("hasMore", first > 0);
		json.Key(Core::StringView("turns"));
		json.BeginArray();
		for (int64 i = first; i < turns.Count(); ++i) turns[i]->WriteJson(json, false);
		json.EndArray();
		json.Key(Core::StringView("pendingApprovals"));
		json.BeginArray();
		for (Approval* approval : approvals)
			if (approval->decision.IsEmpty()) approval->WriteJson(json);
		json.EndArray();
		json.Key(Core::StringView("pendingQuestion"));
		if (question && !question->answered) question->WriteJson(json);
		else json.Null();
		json.EndObject();
		return json.ToString();
	}
}
