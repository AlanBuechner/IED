include "api/Plugin.ch"
include "Clipboard.ch"
include "Files.ch"

namespace Ai
{
	const int64 c_ClipLineShownBytes = 160;   // of a clip's first and last line, what a result shows
	const int64 c_ClipQuotedBytes = 60;       // of a from or to an error quotes

	// --- Cutting -----------------------------------------------------------------------------------------------------

	class ClipLine
	{
		public int64 m_Number;
		public Core::StringView m_Text;
		public bool m_Broken;   // a line break followed it
	}

	// The number of a line that starts with "<n>\t" (spaces before it allowed), and in `skip` where its text starts; -1 for
	// a line without that gutter.
	static int64 GutterNumber(Core::StringView line, int64& skip) {
		int64 at = 0;
		while (at < line.ByteLength() && line.ByteAt(at) == ' ') at += 1;
		const int64 digits = at;
		int64 number = 0;
		while (at < line.ByteLength() && at - digits < 10 && line.ByteAt(at) >= '0' && line.ByteAt(at) <= '9') {
			number = number * 10 + (line.ByteAt(at) - '0');
			at += 1;
		}
		if (at == digits || at >= line.ByteLength() || line.ByteAt(at) != '\t') return -1;
		skip = at + 1;
		return number;
	}

	static bool IsNote(Core::StringView line) { return line.StartsWith(Core::StringView("[")); }

	bool LooksNumbered(Core::StringView text) {
		bool numbered = false;
		int64 at = 0;
		while (at < text.ByteLength()) {
			int64 end = text.IndexOf('\n', at);
			if (end < 0) end = text.ByteLength();
			Core::StringView line = text.Substring(at, end - at);
			at = end + 1;
			int64 skip = 0;
			if (GutterNumber(line, skip) >= 0) numbered = true;
			else if (!IsNote(line)) return false;
		}
		return numbered;
	}

	// The lines of `text`, numbered by their place from 1, or a numbered text's by their gutters.
	static Core::Array<ClipLine> LinesOf(Core::StringView text, bool numbered) {
		Core::Array<ClipLine> lines;
		int64 at = 0;
		while (at < text.ByteLength()) {
			int64 end = text.IndexOf('\n', at);
			ClipLine line;
			line.m_Broken = end >= 0;
			if (end < 0) end = text.ByteLength();
			int64 cut = end;
			if (cut > at && text.ByteAt(cut - 1) == '\r') cut -= 1;
			line.m_Text = text.Substring(at, cut - at);
			at = end + 1;
			line.m_Number = lines.Count() + 1;
			if (numbered) {
				int64 skip = 0;
				line.m_Number = GutterNumber(line.m_Text, skip);
				if (line.m_Number < 0) continue;
				line.m_Text = line.m_Text.Substring(skip, line.m_Text.ByteLength() - skip);
				line.m_Broken = true;
			}
			lines.Push(line);
		}
		return lines;
	}

	static Core::String Quoted(Core::StringView text) {
		int64 cut = text.ByteLength() < c_ClipQuotedBytes ? text.ByteLength() : c_ClipQuotedBytes;
		while (cut > 0 && cut < text.ByteLength() && ((uint8)text.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
		Core::StringBuilder out;
		out.Append("\"");
		out.Append(text.Substring(0, cut));
		out.Append(cut < text.ByteLength() ? "...\"" : "\"");
		return out.ToString();
	}

	static Core::String MissingLines(const Core::Array<ClipLine>& lines, const ClipRange& range) {
		if (lines.IsEmpty()) return Core::String("it is empty");
		Core::StringBuilder out;
		out.Append("it has no lines ");
		if (range.m_StartLine > 0) out.AppendInt(range.m_StartLine);
		out.Append("-");
		if (range.m_EndLine > 0) out.AppendInt(range.m_EndLine);
		out.Append("; its lines are ");
		out.AppendInt(lines[0].m_Number);
		out.Append("-");
		out.AppendInt(lines[lines.Count() - 1].m_Number);
		return out.ToString();
	}

	static Core::StringView WithoutIndent(Core::StringView line) {
		int64 at = 0;
		while (at < line.ByteLength() && (line.ByteAt(at) == ' ' || line.ByteAt(at) == '\t')) at += 1;
		return line.Substring(at, line.ByteLength() - at);
	}

	// Whether `lines` from `first` on hold `wanted` when every line's leading whitespace is left out: its first line ending
	// one of them, its last starting the one it reaches, the ones between equal.
	static bool MatchesUnindented(const Core::Array<ClipLine>& lines, int64 first, const Core::Array<Core::StringView>& wanted) {
		if (first + wanted.Count() > lines.Count()) return false;
		for (int64 k = 0; k < wanted.Count(); k += 1) {
			Core::StringView have = WithoutIndent(lines[first + k].m_Text);
			Core::StringView want = WithoutIndent(wanted[k]);
			const bool last = k + 1 == wanted.Count();
			const bool fits = k == 0 ? (wanted.Count() == 1 ? have.Contains(want) : have.EndsWith(want)) : last ? have.StartsWith(want) : have == want;
			if (!fits) return false;
		}
		return true;
	}

	static Core::Array<Core::StringView> LinesOfWanted(Core::StringView wanted) {
		Core::Array<Core::StringView> parts;
		int64 at = 0;
		while (at <= wanted.ByteLength()) {
			int64 end = wanted.IndexOf('\n', at);
			if (end < 0) end = wanted.ByteLength();
			int64 cut = end > at && wanted.ByteAt(end - 1) == '\r' ? end - 1 : end;
			parts.Push(wanted.Substring(at, cut - at));
			at = end + 1;
		}
		return parts;
	}

	// Where a from or to that differs from the text only in its lines' indentation is (as fs_edit matches): the byte span in
	// the cut lines' text (`starts`: each line's offset there) of each place it fits starting at `notBefore` or later. A part
	// that starts at its line's indentation takes the line's own; the spans' first lines' numbers in `numbers`.
	static void UnindentedSpans(const Core::Array<ClipLine>& lines, const Core::Array<int64>& starts, Core::StringView wanted, int64 notBefore,
		Core::Array<int64>& begins, Core::Array<int64>& ends, Core::Array<int64>& numbers) {
		Core::Array<Core::StringView> parts = LinesOfWanted(wanted);
		if (WithoutIndent(parts[0]).IsEmpty()) return;
		const int64 last = parts.Count() - 1;
		for (int64 i = 0; i < lines.Count(); i += 1) {
			if (!MatchesUnindented(lines, i, parts)) continue;
			Core::StringView first = lines[i].m_Text;
			Core::StringView firstWant = WithoutIndent(parts[0]);
			const int64 firstIndent = first.ByteLength() - WithoutIndent(first).ByteLength();
			const int64 inLine = last == 0 ? WithoutIndent(first).IndexOf(firstWant, 0) + firstIndent : first.ByteLength() - firstWant.ByteLength();
			const bool wholeLine = parts[0].ByteLength() > firstWant.ByteLength() && inLine == firstIndent;
			const int64 begin = starts[i] + (wholeLine ? 0 : inLine);
			int64 end = starts[i] + inLine + firstWant.ByteLength();
			if (last > 0) {
				Core::StringView lastLine = lines[i + last].m_Text;
				Core::StringView lastWant = WithoutIndent(parts[last]);
				const int64 lastIndent = lastLine.ByteLength() - WithoutIndent(lastLine).ByteLength();
				end = starts[i + last] + (lastWant.IsEmpty() ? 0 : lastIndent + lastWant.ByteLength());
			}
			if (begin < notBefore) continue;
			begins.Push(begin);
			ends.Push(end);
			numbers.Push(lines[i].m_Number);
		}
	}

	// A from or to not in the text as written: the one place it fits but for its lines' indentation, as [begin, end), or
	// false with `error` saying so - and, when it fits in several, which lines.
	static bool FindUnindented(const Core::Array<ClipLine>& lines, const Core::Array<int64>& starts, Core::StringView wanted, int64 notBefore,
		int64& begin, int64& end, Core::String& error) {
		Core::Array<int64> begins;
		Core::Array<int64> ends;
		Core::Array<int64> numbers;
		UnindentedSpans(lines, starts, wanted, notBefore, begins, ends, numbers);
		if (begins.Count() == 1) {
			begin = begins[0];
			end = ends[0];
			return true;
		}
		if (begins.Count() > 1) {
			Core::StringBuilder out;
			out.Append(error.View());
			out.Append("; lines ");
			for (int64 k = 0; k < numbers.Count(); k += 1) {
				if (k > 0) out.Append(k + 1 == numbers.Count() ? " and " : ", ");
				out.AppendInt(numbers[k]);
			}
			out.Append(" have it with other indentation: copy its text as the file has it, or give start_line and end_line");
			error = out.ToString();
		}
		return false;
	}

	// A from or to whose tabs and line breaks were written as the escapes \t and \n: the text it means; empty when it has none.
	static Core::String WithEscapesRead(Core::StringView text) {
		if (!text.Contains(Core::StringView("\\t")) && !text.Contains(Core::StringView("\\n"))) return Core::String();
		Core::StringBuilder out;
		int64 at = 0;
		while (at < text.ByteLength()) {
			const bool escape = text.ByteAt(at) == '\\' && at + 1 < text.ByteLength() && (text.ByteAt(at + 1) == 't' || text.ByteAt(at + 1) == 'n');
			if (escape) {
				out.Append(text.ByteAt(at + 1) == 't' ? "\t" : "\n");
				at += 2;
				continue;
			}
			out.Append(text.Substring(at, 1));
			at += 1;
		}
		return out.ToString();
	}

	// Where `wanted` is in the cut lines' text `whole` at `notBefore` or later, as [begin, end): as written, else but for its
	// lines' indentation, else with its \t and \n read as a tab and a line break; false with `error` saying so.
	static bool Locate(Core::StringView whole, const Core::Array<ClipLine>& lines, const Core::Array<int64>& starts, Core::StringView wanted,
		int64 notBefore, int64& begin, int64& end, Core::String& error) {
		const int64 found = whole.Substring(notBefore, whole.ByteLength() - notBefore).IndexOf(wanted);
		if (found >= 0) {
			begin = notBefore + found;
			end = begin + wanted.ByteLength();
			return true;
		}
		if (FindUnindented(lines, starts, wanted, notBefore, begin, end, error)) return true;
		Core::String read = WithEscapesRead(wanted);
		if (read.IsEmpty()) return false;
		Core::String readError = error;
		return Locate(whole, lines, starts, read.View(), notBefore, begin, end, readError);
	}

	bool CutClip(Core::StringView text, bool numbered, const ClipRange& range, Core::String& cut, Core::String& error) {
		if (range.m_StartLine > 0 && range.m_EndLine > 0 && range.m_EndLine < range.m_StartLine) {
			error = Core::String("end_line is before start_line");
			return false;
		}
		Core::Array<ClipLine> lines = LinesOf(text, numbered);
		Core::Array<ClipLine> inRange;
		Core::Array<int64> starts;   // each line's offset in `taken`
		Core::StringBuilder taken;
		for (const ClipLine& line : lines) {
			if ((range.m_StartLine > 0 && line.m_Number < range.m_StartLine) || (range.m_EndLine > 0 && line.m_Number > range.m_EndLine)) continue;
			starts.Push(taken.ByteLength());
			taken.Append(line.m_Text);
			if (line.m_Broken) taken.Append("\n");
			inRange.Push(line);
		}
		if (inRange.IsEmpty()) {
			error = MissingLines(lines, range);
			return false;
		}
		Core::StringView whole = taken.View();
		int64 begin = 0;
		int64 end = whole.ByteLength();
		int64 after = 0;   // where to is looked for: past from
		if (!range.m_From.IsEmpty()) {
			error = (Core::String("from ") + Quoted(range.m_From.View()).View()) + " is not in it";
			if (!Locate(whole, inRange, starts, range.m_From.View(), 0, begin, after, error)) return false;
		}
		if (!range.m_To.IsEmpty()) {
			error = (Core::String("to ") + Quoted(range.m_To.View()).View()) + (range.m_From.IsEmpty() ? " is not in it" : " is not in it after from");
			int64 toBegin = 0;
			if (!Locate(whole, inRange, starts, range.m_To.View(), after, toBegin, end, error)) return false;
		}
		error.Clear();
		cut = Core::String(whole.Substring(begin, end - begin));
		if (cut.IsEmpty()) {
			error = Core::String("there is nothing to copy");
			return false;
		}
		return true;
	}

	// --- Pasting -----------------------------------------------------------------------------------------------------

	static bool IsNameByte(int32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-'; }

	static Clip* Named(const Core::Array<Clip*>& clips, Core::StringView name) {
		for (Clip* clip : clips)
			if (clip->m_Name.View() == name) return clip;
		return nullptr;
	}

	// The length of the {{clip:<name>}} or {{!clip:<name>}} at the start of `text`, with its name and whether it is the
	// escaped one; 0 when it does not start with one.
	static int64 Token(Core::StringView text, Core::StringView& name, bool& escaped) {
		escaped = text.StartsWith(Core::StringView("{{!clip:"));
		if (!escaped && !text.StartsWith(Core::StringView("{{clip:"))) return 0;
		const int64 start = escaped ? 8 : 7;
		int64 end = start;
		while (end < text.ByteLength() && end - start <= c_ClipNameMostBytes && IsNameByte(text.ByteAt(end))) end += 1;
		if (end == start || end - start > c_ClipNameMostBytes || !text.Substring(end, text.ByteLength() - end).StartsWith(Core::StringView("}}"))) return 0;
		name = text.Substring(start, end - start);
		return end + 2;
	}

	bool PasteClips(Core::StringView text, const Core::Array<Clip*>& clips, Core::String& pasted, Core::String& missing) {
		if (!text.Contains(Core::StringView("clip:"))) {
			pasted = Core::String(text);
			return true;
		}
		Core::StringBuilder out;
		int64 at = 0;
		for (;;) {
			const int64 found = text.Substring(at, text.ByteLength() - at).IndexOf(Core::StringView("{{"));
			if (found < 0) break;
			out.Append(text.Substring(at, found));
			at += found;
			Core::StringView name;
			bool escaped = false;
			const int64 length = Token(text.Substring(at, text.ByteLength() - at), name, escaped);
			if (length == 0) {
				out.Append("{");
				at += 1;
				continue;
			}
			if (escaped) {
				out.Append("{{clip:");
				out.Append(name);
				out.Append("}}");
			}
			else {
				Clip* clip = Named(clips, name);
				if (!clip) {
					missing = Core::String(name);
					return false;
				}
				out.Append(clip->m_Text.View());
			}
			at += length;
		}
		out.Append(text.Substring(at, text.ByteLength() - at));
		pasted = out.ToString();
		return true;
	}

	static bool WritePasted(IED::JsonWriter& json, const Serialization::DomNode& node, const Core::Array<Clip*>& clips, bool& changed, Core::String& missing) {
		if (node.Kind() == Serialization::DomKind::String) {
			Core::String pasted;
			if (!PasteClips(node.AsView(), clips, pasted, missing)) return false;
			changed = changed || pasted.View() != node.AsView();
			json.String(pasted.View());
			return true;
		}
		if (node.Kind() == Serialization::DomKind::Object) {
			json.BeginObject();
			for (int64 i = 0; i < node.Count(); ++i) {
				json.Key(node.KeyAt(i));
				if (!WritePasted(json, node.ValueAt(i), clips, changed, missing)) return false;
			}
			json.EndObject();
			return true;
		}
		if (node.Kind() == Serialization::DomKind::Array) {
			json.BeginArray();
			for (int64 i = 0; i < node.Count(); ++i)
				if (!WritePasted(json, node.At(i), clips, changed, missing)) return false;
			json.EndArray();
			return true;
		}
		json.Raw(IED::NodeJson(node).View());
		return true;
	}

	bool PasteArguments(const Serialization::DomNode& args, const Core::Array<Clip*>& clips, Serialization::DomNode& pasted, Core::String& missing) {
		IED::JsonWriter json;
		bool changed = false;
		if (!WritePasted(json, args, clips, changed, missing)) return false;
		if (!changed) {
			pasted = args;
			return true;
		}
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		pasted = Serialization::ReadJson(json.View(), *doc).root;
		return true;
	}

	// --- Where a copy reads ------------------------------------------------------------------------------------------

	static bool IsClipboardTool(Core::StringView name) { return name.StartsWith(Core::StringView("clipboard_")); }

	// The tool names of an assistant message's calls, by their ids.
	static void CallNames(Core::StringView toolCalls, Core::HashMap<Core::String, Core::String>& names) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode calls = Serialization::ReadJson(toolCalls, *doc).root;
		for (int64 i = 0; i < calls.Count(); ++i) names.At(Core::String(calls.At(i).Member("id").AsView())) = Core::String(calls.At(i).Member("function").Member("name").AsView());
	}

	// The `back`-th tool result of the chat so far, newest first, the clipboard's own not counted, with its tool's name;
	// false with `count` the results there are.
	static bool EarlierResult(const Chat* chat, int64 back, Core::String& tool, Core::String& content, int64& count) {
		count = 0;
		for (int64 t = chat->m_Turns.Count() - 1; t >= 0; --t) {
			Core::HashMap<Core::String, Core::String> names;
			Core::Array<const ModelMessage*> results;
			Core::Array<Core::String> tools;
			for (const ModelMessage* message : chat->m_Turns[t]->m_Messages) {
				if (!message->m_ToolCalls.IsEmpty()) CallNames(message->m_ToolCalls.View(), names);
				if (message->m_Role != "tool") continue;
				Core::String name;
				names.TryGet(message->m_ToolCallId, name);
				results.Push(message);
				tools.Push(name);
			}
			for (int64 i = results.Count() - 1; i >= 0; --i) {
				if (IsClipboardTool(tools[i].View())) continue;
				count += 1;
				if (count < back) continue;
				tool = tools[i];
				content = results[i]->m_Content;
				return true;
			}
		}
		return false;
	}

	static ClipRange RangeOf(const Serialization::DomNode& args) {
		ClipRange range;
		range.m_StartLine = args.Member("start_line").AsInt();
		range.m_EndLine = args.Member("end_line").AsInt();
		range.m_From = Core::String(args.Member("from").AsView());
		range.m_To = Core::String(args.Member("to").AsView());
		return range;
	}

	// " lines 40-62", " from line 40", " to line 62", or nothing.
	static Core::String LinesNote(const ClipRange& range) {
		Core::StringBuilder out;
		if (range.m_StartLine > 0 && range.m_EndLine > 0) {
			out.Append(range.m_StartLine == range.m_EndLine ? " line " : " lines ");
			out.AppendInt(range.m_StartLine);
			if (range.m_EndLine != range.m_StartLine) {
				out.Append("-");
				out.AppendInt(range.m_EndLine);
			}
		}
		else if (range.m_StartLine > 0) {
			out.Append(" from line ");
			out.AppendInt(range.m_StartLine);
		}
		else if (range.m_EndLine > 0) {
			out.Append(" to line ");
			out.AppendInt(range.m_EndLine);
		}
		return out.ToString();
	}

	static int64 SourcesGiven(const Serialization::DomNode& args) {
		int64 count = 0;
		if (args.Member("path").IsValid()) count += 1;
		if (args.Member("result").IsValid()) count += 1;
		if (args.Member("text").IsValid()) count += 1;
		return count;
	}

	// The text a copy reads and what to call it; false with `error`. Inside the host lock.
	static bool CopySource(const Chat* chat, const ToolInvocation& call, Core::String& text, Core::String& source, bool& numbered, Core::String& error) {
		numbered = false;
		if (call.m_Args.Member("path").IsValid()) {
			source = IED::NormalizePath(call.m_Args.Member("path").AsView());
			text = TextAsEdited(call.m_Ws, source.View());
			return true;
		}
		if (call.m_Args.Member("text").IsValid()) {
			source = Core::String("text");
			text = Core::String(call.m_Args.Member("text").AsView());
			return true;
		}
		Core::String tool;
		int64 count = 0;
		if (!EarlierResult(chat, call.m_Args.Member("result").AsInt(), tool, text, count)) {
			Core::StringBuilder said;
			said.Append("there ");
			said.Append(count == 1 ? "is 1 earlier tool result" : "are ");
			if (count != 1) {
				said.AppendInt(count);
				said.Append(" earlier tool results");
			}
			said.Append(" (the clipboard's own not counted); result 1 is the latest");
			error = said.ToString();
			return false;
		}
		source = (Core::String("the ") + (tool.IsEmpty() ? Core::StringView("tool") : tool.View())) + " result";
		numbered = LooksNumbered(text.View());
		return true;
	}

	// --- Keeping ------------------------------------------------------------------------------------------------------

	// `text` kept as the clip `name`, after the clip's own text with `append`, as the newest; past kClipsMost the oldest is
	// dropped and named in `dropped`. Null with `error` when the clip would be too large.
	static Clip* Keep(Chat* chat, Core::StringView name, Core::StringView text, Core::StringView source, bool append, Core::String& dropped, Core::String& error) {
		Clip* clip = nullptr;
		int64 at = -1;
		for (int64 i = 0; i < chat->m_Clips.Count(); ++i)
			if (chat->m_Clips[i]->m_Name.View() == name) {
				clip = chat->m_Clips[i];
				at = i;
			}
		const bool adding = append && clip;
		const int64 bytes = adding ? clip->m_Text.ByteLength() + text.ByteLength() : text.ByteLength();
		if (bytes > c_ClipMostBytes) {
			Core::StringBuilder said;
			said.Append("that makes ");
			said.AppendInt((bytes + 1023) / 1024);
			said.Append(" KB; a clip holds at most ");
			said.AppendInt(c_ClipMostBytes / 1024);
			said.Append(" KB: copy fewer lines, or into two clips");
			error = said.ToString();
			return nullptr;
		}
		if (adding) {
			clip->m_Text = clip->m_Text + text;
			clip->m_Source = (clip->m_Source + "; ") + source;
			chat->m_Clips.RemoveAt(at);
		}
		else {
			if (clip) chat->m_Clips.RemoveAt(at);
			clip = new Clip();
			clip->m_Name = Core::String(name);
			clip->m_Text = Core::String(text);
			clip->m_Source = Core::String(source);
		}
		chat->m_Clips.Push(clip);
		if (chat->m_Clips.Count() > c_ClipsMost) {
			dropped = chat->m_Clips[0]->m_Name;
			chat->m_Clips.RemoveAt(0);
		}
		return clip;
	}

	static void PublishClips(Chats* chats, Chat* chat) {
		IED::JsonWriter data;
		data.BeginObject();
		data.Key(Core::StringView("clips"));
		chat->WriteClips(data);
		data.EndObject();
		chats->Publish(chat, "clips.changed", data.View());
		SaveChatHeader(LocalStateOf(chats->WorkspaceOf(chat)), chat);
	}

	// --- Saying what it holds -----------------------------------------------------------------------------------------

	static int64 LineCount(Core::StringView text) {
		Clip counted;
		counted.m_Text = Core::String(text);
		return counted.Lines();
	}

	static void AppendSize(Core::StringBuilder& out, Core::StringView text) {
		const int64 lines = LineCount(text);
		out.AppendInt(lines);
		out.Append(lines == 1 ? " line (" : " lines (");
		out.AppendInt(text.ByteLength());
		out.Append(text.ByteLength() == 1 ? " byte)" : " bytes)");
	}

	static Core::StringView Shown(Core::StringView line) {
		int64 cut = line.ByteLength() < c_ClipLineShownBytes ? line.ByteLength() : c_ClipLineShownBytes;
		while (cut > 0 && cut < line.ByteLength() && ((uint8)line.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
		return line.Substring(0, cut);
	}

	static Core::StringView FirstLine(Core::StringView text) {
		const int64 end = text.IndexOf('\n', 0);
		return Shown(end < 0 ? text : text.Substring(0, end));
	}

	static Core::StringView LastLine(Core::StringView text) {
		Core::StringView body = text.EndsWith(Core::StringView("\n")) ? text.Substring(0, text.ByteLength() - 1) : text;
		int64 start = body.ByteLength();
		while (start > 0 && body.ByteAt(start - 1) != '\n') start -= 1;
		return Shown(body.Substring(start, body.ByteLength() - start));
	}

	Core::String CopyReport(const Clip* clip, Core::StringView added, Core::StringView source, bool appended, Core::StringView dropped) {
		Core::StringBuilder out;
		out.Append(appended ? "Added " : "Copied ");
		AppendSize(out, added);
		out.Append(" of ");
		out.Append(source);
		out.Append(appended ? " to the end of the clip " : " to the clip ");
		out.Append(clip->m_Name.View());
		if (appended) {
			out.Append(", now ");
			AppendSize(out, clip->m_Text.View());
		}
		out.Append(". Write {{clip:");
		out.Append(clip->m_Name.View());
		out.Append("}} in any later call's arguments to paste it (as fs_edit's old to match it exactly, as new to put it elsewhere).");
		if (clip->m_Text.View().EndsWith(Core::StringView("\n"))) out.Append(" It ends with its last line's line break: write no \\n after it.");
		if (LineCount(added) == 1) {
			out.Append("\nLine: ");
			out.Append(FirstLine(added));
		}
		else {
			out.Append("\nFirst line: ");
			out.Append(FirstLine(added));
			out.Append("\nLast line: ");
			out.Append(LastLine(added));
		}
		if (!dropped.IsEmpty()) {
			out.Append("\nThe clipboard keeps ");
			out.AppendInt(c_ClipsMost);
			out.Append(" clips: the oldest, ");
			out.Append(dropped);
			out.Append(", was dropped.");
		}
		return out.ToString();
	}

	// --- The tools ----------------------------------------------------------------------------------------------------

	static ToolPlan CopyPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView name = call.m_Args.Member("name").AsView();
		if (SourcesGiven(call.m_Args) != 1) {
			plan.m_Error = Core::String("clipboard_copy: give one of path (a file), result (an earlier tool result, 1 the latest) or text");
			return plan;
		}
		Core::String lines = LinesNote(RangeOf(call.m_Args));
		if (call.m_Args.Member("path").IsValid()) {
			Core::String path = IED::NormalizePath(call.m_Args.Member("path").AsView());
			plan.m_Subject = (Core::String("fs.read(") + path.View()) + ")";
			plan.m_Summary = ((Core::String("Copy ") + path.View()) + lines.View() + " to " + name);
			return plan;
		}
		plan.m_Subject = (Core::String("clipboard.copy(") + name) + ")";
		plan.m_Summary = Core::String("Copy to ") + name;
		return plan;
	}

	static ToolOutcome CopyRun(Chats* chats, Chat* chat, const ToolInvocation& call) {
		Core::StringView name = call.m_Args.Member("name").AsView();
		Core::String text;
		Core::String source;
		Core::String error;
		bool numbered = false;
		{
			IED::HostLock guard(*call.m_Context);
			if (!CopySource(chat, call, text, source, numbered, error)) return ToolError((Core::String("clipboard_copy: ") + error.View()).View());
		}
		ClipRange range = RangeOf(call.m_Args);
		Core::String cut;
		if (!CutClip(text.View(), numbered, range, cut, error)) return ToolError(((Core::String("clipboard_copy: ") + source.View()) + ": " + error.View()).View());
		source = source + LinesNote(range).View();
		IED::HostLock guard(*call.m_Context);
		const bool append = call.m_Args.Member("append").AsBool() && Named(chat->m_Clips, name);
		Core::String dropped;
		Clip* clip = Keep(chat, name, cut.View(), source.View(), append, dropped, error);
		if (!clip) return ToolError((Core::String("clipboard_copy: ") + error.View()).View());
		PublishClips(chats, chat);
		Core::StringBuilder preview;
		preview.Append(append ? "Added " : "Copied ");
		AppendSize(preview, cut.View());
		preview.Append(" to ");
		preview.Append(name);
		preview.Append("\n\n");
		preview.Append(cut.View());
		return ToolResult(CopyReport(clip, cut.View(), source.View(), append, dropped.View()).View(), preview.View());
	}

	static ToolOutcome ListRun(Chat* chat, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		if (chat->m_Clips.IsEmpty()) return ToolResult(Core::StringView("The clipboard is empty; clipboard_copy copies to it."), Core::StringView("Empty"));
		Core::StringBuilder out;
		for (Clip* clip : chat->m_Clips) {
			out.Append(clip->m_Name.View());
			out.Append(": ");
			AppendSize(out, clip->m_Text.View());
			out.Append(", from ");
			out.Append(clip->m_Source.View());
			out.Append(" - ");
			out.Append(FirstLine(clip->m_Text.View()));
			out.Append("\n");
		}
		out.Append("Paste a clip with {{clip:<name>}} in any call's arguments.");
		Core::StringBuilder preview;
		preview.AppendInt(chat->m_Clips.Count());
		preview.Append(chat->m_Clips.Count() == 1 ? " clip" : " clips");
		return ToolResult(out.View(), preview.View());
	}

	static ToolPlan ListPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = Core::String("clipboard.read()");
		plan.m_Summary = Core::String("List the clipboard");
		return plan;
	}

	static ToolSpec* ClipboardTool(const char* name, const char* description, const char* parameters) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = ToolClass::Read;
		spec->m_InPlan = true;
		spec->m_Deferred = true;
		spec->m_Group = Core::String("clipboard");
		return spec;
	}

	void AddClipboardTools(ToolRegistry& registry, Chats* chats, Chat* chat) {
		ToolSpec* copy = ClipboardTool("clipboard_copy", "Copy lines of a file or tool result to a clip; {{clip:<name>}} in a later call's arguments pastes it. Use it to match a long block exactly (fs_edit old: \"{{clip:old}}\"), to move or repeat code, or to reuse output. Copy from path (the file as the editors have it), result (an earlier tool result: 1 the latest, the clipboard's own not counted; an fs_read result's line numbers are left out and start_line/end_line are the numbers it shows) or text; start_line/end_line take whole lines, each with its line break (the last one's too: write nothing after the clip), from/to the text from the first from to the end of the first to after it (one that differs only in its lines' indentation is found where it fits but for that, when it fits in one place, as fs_edit does; one not there as written whose \\t and \\n are escapes is read with a tab and a line break for them). Example: clipboard_copy({\"name\": \"push\", \"path\": \"src/ring.cf\", \"start_line\": 40, \"end_line\": 62})",
			"{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"pattern\": \"^[A-Za-z0-9_.-]{1,40}$\", \"description\": \"letters, digits, _ . -\"}, \"path\": {\"type\": \"string\", \"description\": \"copy from this workspace file\"}, \"result\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"copy from an earlier tool result: 1 the latest\"}, \"text\": {\"type\": \"string\", \"minLength\": 1}, \"start_line\": {\"type\": \"integer\", \"minimum\": 1}, \"end_line\": {\"type\": \"integer\", \"minimum\": 1}, \"from\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"start at the first occurrence of this text\"}, \"to\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"end after the first occurrence of this text after from\"}, \"append\": {\"type\": \"boolean\", \"description\": \"add to the end of the clip instead of replacing it\"}}, \"required\": [\"name\"], \"additionalProperties\": false}");
		copy->m_Plan = CopyPlan;
		copy->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return CopyRun(chats, chat, call); };
		registry.Add(copy);
		ToolSpec* list = ClipboardTool("clipboard_list", "The clips on the clipboard: each one's name, size, where it came from and first line. Example: clipboard_list({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}");
		list->m_ParallelSafe = true;
		list->m_Plan = ListPlan;
		list->m_Run = [chat](const ToolInvocation& call) -> ToolOutcome { return ListRun(chat, call); };
		registry.Add(list);
	}
}
