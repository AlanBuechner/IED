include "ProjectTools.ch"
include "Work.ch"

namespace Ai
{
	const int64 c_ProjectLogLines = 20;
	const int64 c_ProjectToolLogBytes = 2000;

	static Core::StringView Arg(const ToolInvocation& call, const char* name) { return call.m_Args.Member(name).AsView(); }

	static Core::String Slashed(Core::StringView path) {
		Core::StringBuilder out;
		for (int64 i = 0; i < path.ByteLength(); ++i) out.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return out.ToString();
	}

	// "Game (executable, c4) in Game, file build/ied/Game.iedproj, depends on Engine"
	static void DescribeProject(Core::StringBuilder& out, const IED::Project& project) {
		out.Append("- ");
		out.Append(project.m_Name.View());
		out.Append(" (");
		out.Append(project.m_Kind.IsEmpty() ? Core::StringView("no kind") : project.m_Kind.View());
		if (!project.m_Language.IsEmpty()) {
			out.Append(", ");
			out.Append(project.m_Language.View());
		}
		out.Append(") in ");
		out.Append(project.m_Folder.IsEmpty() ? Core::StringView("the workspace's folder") : project.m_Folder.View());
		out.Append(", file ");
		out.Append(project.m_File.View());
		for (int64 i = 0; i < project.m_References.Count(); ++i) {
			out.Append(i == 0 ? ", depends on " : ", ");
			out.Append(project.m_References[i].View());
		}
		out.Append("\n");
	}

	static void DescribeWorkspace(Core::StringBuilder& out, const IED::Workspace& ws) {
		out.Append("Workspace ");
		out.Append(ws.m_Id.View());
		out.Append(" '");
		out.Append(ws.m_Name.View());
		out.Append("': ");
		out.Append(ws.m_Kind.View());
		out.Append(" at ");
		out.Append(Slashed(ws.m_Root.View()).View());
		out.Append(ws.m_Trusted ? ", trusted\n" : ", not trusted (nothing builds or runs there)\n");
		if (ws.m_Kind != "solution") {
			out.Append("No projects: it is a folder. project_import({\"folder\": \".\"}) makes it a solution.\n");
			return;
		}
		out.AppendInt(ws.m_Projects.Count());
		out.Append(ws.m_Projects.Count() == 1 ? " project:\n" : " projects:\n");
		for (const IED::Project& project : ws.m_Projects) DescribeProject(out, project);
	}

	// --- project_list ------------------------------------------------------------------------------------------------

	static ToolPlan ListPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = Core::String("project.list()");
		plan.m_Summary = Core::String("List the projects");
		return plan;
	}

	static ToolOutcome ListRun(const ToolInvocation& call) {
		IED::Workspace ws;
		if (!IED::FindWorkspace(call.m_Ws.m_Id.View(), ws)) return ToolError(Core::StringView("project_list: the workspace is not open any more"));
		Core::StringBuilder out;
		DescribeWorkspace(out, ws);
		bool others = false;
		for (const IED::Workspace& open : IED::Workspaces()) {
			if (open.m_Id.View() == ws.m_Id.View()) continue;
			out.Append(others ? "" : "Other open workspaces (this chat works in its own; the owner switches with the workspace switcher):\n");
			others = true;
			out.Append("- ");
			out.Append(open.m_Id.View());
			out.Append(" '");
			out.Append(open.m_Name.View());
			out.Append("': ");
			out.Append(open.m_Kind.View());
			out.Append(" at ");
			out.Append(Slashed(open.m_Root.View()).View());
			out.Append("\n");
		}
		Core::StringBuilder preview;
		preview.AppendInt(ws.m_Projects.Count());
		preview.Append(ws.m_Projects.Count() == 1 ? " project" : " projects");
		return ToolResult(out.View(), preview.View());
	}

	// --- project_templates -------------------------------------------------------------------------------------------

	static ToolPlan TemplatesPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = Core::String("project.templates()");
		plan.m_Summary = Core::String("List the project templates");
		return plan;
	}

	static ToolOutcome TemplatesRun(const ToolInvocation& call) {
		Core::Array<IED::ProjectTemplate> templates;
		Core::String location;
		Core::String problem;
		if (!IED::ProjectTemplates(call.m_Ws.m_Id.View(), templates, location, problem)) return ToolError((Core::String("project_templates: ") + problem.View()).View());
		Core::StringBuilder out;
		for (const IED::ProjectTemplate& made : templates) {
			out.Append("- ");
			out.Append(made.m_Key.View());
			out.Append(": ");
			out.Append(made.m_Title.View());
			if (!made.m_Language.IsEmpty()) {
				out.Append(" (");
				out.Append(made.m_Language.View());
				out.Append(")");
			}
			out.Append(made.m_CanAdd ? " [can add to this solution]" : "");
			if (!made.m_Description.IsEmpty()) {
				out.Append(" - ");
				out.Append(made.m_Description.View());
			}
			out.Append("\n");
		}
		if (templates.IsEmpty()) out.Append("[no plugin gives a project template]\n");
		out.Append("A new workspace goes in ");
		out.Append(location.View());
		out.Append(" unless project_create names a location.\n");
		Core::StringBuilder preview;
		preview.AppendInt(templates.Count());
		preview.Append(" templates");
		return ToolResult(out.View(), preview.View());
	}

	// --- what a change left ------------------------------------------------------------------------------------------

	// What the model is told after a change: what happened, the notes, the workspace's projects as they are now, and the
	// end of the steps' output.
	static ToolOutcome Changed(const ToolInvocation& call, Core::StringView done, const IED::ProjectChange& change) {
		Core::StringBuilder out;
		out.Append(done);
		out.Append("\n");
		for (const Core::String& note : change.m_Notes) {
			out.Append("Note: ");
			out.Append(note.View());
			out.Append("\n");
		}
		if (!change.m_TrashId.IsEmpty()) out.Append("Its folder is in IED's trash (recoverable).\n");
		IED::Workspace ws;
		if (IED::FindWorkspace(change.m_WsId.View(), ws)) {
			if (ws.m_Id.View() != call.m_Ws.m_Id.View()) {
				out.Append("It opened as workspace ");
				out.Append(ws.m_Id.View());
				out.Append(", beside this chat's; its files are outside this chat's workspace, and the owner switches to it with the workspace switcher.\n");
			}
			DescribeWorkspace(out, ws);
		}
		if (!change.m_Log.IsEmpty()) {
			out.Append("Output:\n");
			out.Append(TailOf(change.m_Log.View(), c_ProjectLogLines, c_ProjectToolLogBytes).View());
			out.Append("\n");
		}
		ToolOutcome outcome = ToolResult(out.View(), done);
		outcome.m_Source = Core::String("Solution Explorer");
		return outcome;
	}

	static ToolOutcome Refused(const char* tool, Core::StringView problem) { return ToolError(((Core::String(tool) + ": ") + problem).View()); }

	// --- project_create ----------------------------------------------------------------------------------------------

	static ToolPlan CreatePlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView location = Arg(call, "location");
		plan.m_Subject = (Core::String("project.create(") + Arg(call, "name")) + ")";
		plan.m_Summary = (((Core::String("Create project ") + Arg(call, "name")) + " from ") + Arg(call, "template")) + (location.IsEmpty() ? Core::String(" in this solution") : Core::String(" as a new workspace in ") + location);
		if (location.IsEmpty() && !call.m_Ws.m_Trusted) plan.m_Error = Core::String("project_create: the workspace is not trusted, and a template runs commands in it; ask the owner to trust it, or give a location for a new workspace");
		return plan;
	}

	static ToolOutcome CreateRun(const ToolInvocation& call) {
		Core::StringView location = Arg(call, "location");
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::CreateProject(Arg(call, "template"), Arg(call, "name"), location, location.IsEmpty() ? call.m_Ws.m_Id.View() : Core::StringView(""), change, problem)) {
			if (location.IsEmpty() && problem.View().IndexOf(Core::StringView("cannot add a project")) >= 0) problem = problem + "; give a location (a full path) to make it a workspace of its own, or see project_templates for the ones marked [can add to this solution]";
			return Refused("project_create", problem.View());
		}
		return Changed(call, ((Core::String("Created project ") + Arg(call, "name")) + " at " + change.m_Path.View() + ".").View(), change);
	}

	// --- project_import ----------------------------------------------------------------------------------------------

	// Where `folder` is: this workspace's own folder (`relative` ""), a folder in it, or outside it (false).
	static bool InWorkspace(const ToolInvocation& call, Core::StringView folder, Core::String& relative) {
		if (folder.IsEmpty() || folder == "." || folder == "./") {
			relative = Core::String();
			return true;
		}
		if (!FS::Path(folder).IsAbsolute()) {
			relative = Core::String(folder);
			return true;
		}
		return IED::RelativeTo(call.m_Ws.m_Root.View(), folder, relative);
	}

	static ToolPlan ImportPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView folder = Arg(call, "folder");
		plan.m_Subject = (Core::String("project.import(") + (folder.IsEmpty() ? Core::StringView(".") : folder)) + ")";
		Core::String relative;
		if (!InWorkspace(call, folder, relative)) plan.m_Summary = (Core::String("Make ") + folder) + " an IED solution and open it";
		else if (relative.IsEmpty()) plan.m_Summary = Core::String("Make this workspace an IED solution");
		else plan.m_Summary = (Core::String("Add the folder ") + relative.View()) + " to the solution as a project";
		return plan;
	}

	static IED::ProjectChoices Choices(const ToolInvocation& call) {
		IED::ProjectChoices choices;
		choices.m_Name = Core::String(Arg(call, "name"));
		choices.m_Kind = Core::String(Arg(call, "kind"));
		choices.m_Language = Core::String(Arg(call, "language"));
		return choices;
	}

	static ToolOutcome ImportRun(const ToolInvocation& call) {
		Core::StringView folder = Arg(call, "folder");
		Core::String relative;
		IED::ProjectChange change;
		Core::String problem;
		const bool inside = InWorkspace(call, folder, relative);
		if (inside && !relative.IsEmpty()) {
			if (!IED::AddProject(call.m_Ws.m_Id.View(), relative.View(), Choices(call), change, problem)) return Refused("project_import", problem.View());
			return Changed(call, ((((Core::String("Added the folder ") + relative.View()) + " to the solution as project ") + change.m_Project.View()) + ".").View(), change);
		}
		Core::String full = inside ? call.m_Ws.m_Root : Core::String(folder);
		if (!IED::ImportFolder(full.View(), Choices(call), change, problem)) return Refused("project_import", problem.View());
		return Changed(call, ((Core::String("The folder ") + Slashed(full.View()).View()) + " is now the IED solution " + change.m_Path.View() + ".").View(), change);
	}

	// --- project_move, project_remove --------------------------------------------------------------------------------

	static ToolPlan MovePlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (((Core::String("project.move(") + Arg(call, "project")) + " -> ") + Arg(call, "to")) + ")";
		plan.m_Summary = (((Core::String("Move project ") + Arg(call, "project")) + " to ") + Arg(call, "to"));
		return plan;
	}

	static ToolOutcome MoveRun(const ToolInvocation& call) {
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::MoveProject(call.m_Ws.m_Id.View(), Arg(call, "project"), Arg(call, "to"), change, problem)) return Refused("project_move", problem.View());
		return Changed(call, ((((Core::String("Moved project ") + Arg(call, "project")) + " to ") + Arg(call, "to")) + "; documents open in it followed it.").View(), change);
	}

	static ToolPlan RemovePlan(const ToolInvocation& call) {
		ToolPlan plan;
		const bool deleting = call.m_Args.Member("delete_files").AsBool();
		plan.m_Subject = (Core::String("project.remove(") + Arg(call, "project")) + ")";
		plan.m_Summary = ((Core::String("Remove project ") + Arg(call, "project")) + " from the solution") + (deleting ? ", its folder to the trash" : ", its files kept");
		return plan;
	}

	static ToolOutcome RemoveRun(const ToolInvocation& call) {
		const bool deleting = call.m_Args.Member("delete_files").AsBool();
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::RemoveProject(call.m_Ws.m_Id.View(), Arg(call, "project"), deleting, change, problem)) return Refused("project_remove", problem.View());
		return Changed(call, (((Core::String("Removed project ") + Arg(call, "project")) + " from the solution") + (deleting ? "; its folder went to the trash." : "; its files are where they were.")).View(), change);
	}

	static ToolSpec* ProjectSpec(const char* name, const char* description, const char* parameters, ToolClass toolClass, ToolPlanner plan, ToolRunner run) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = toolClass;
		spec->m_ParallelSafe = toolClass == ToolClass::Read;
		spec->m_InPlan = toolClass == ToolClass::Read;
		spec->m_Deferred = true;
		spec->m_Group = Core::String("projects");
		spec->m_Plan = plan;
		spec->m_Run = run;
		return spec;
	}

	static ToolPlan LanguageToolsPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = Core::String("tools.status()");
		plan.m_Summary = Core::String("List the language tools");
		return plan;
	}

	// One tool as a line: "- Go (compiler, Go): found 1.26.6 at C:\...\go.exe; the workspace pins 1.22 or newer (go.mod)".
	static void DescribeTool(Core::StringBuilder& out, const Serialization::DomNode& tool) {
		Core::StringView state = tool.Member("state").AsView();
		out.Append("- ");
		out.Append(tool.Member("title").AsView());
		out.Append(" (");
		out.Append(tool.Member("kind").AsView());
		out.Append(", ");
		out.Append(tool.Member("pluginName").AsView());
		out.Append("): ");
		out.Append(state == "wrongVersion" ? Core::StringView("wrong version") : state);
		if (!tool.Member("version").AsView().IsEmpty()) {
			out.Append(" ");
			out.Append(tool.Member("version").AsView());
		}
		if (!tool.Member("path").AsView().IsEmpty()) {
			out.Append(" at ");
			out.Append(tool.Member("path").AsView());
		}
		Serialization::DomNode pin = tool.Member("pin");
		if (pin.Kind() == Serialization::DomKind::Object) {
			out.Append("; the workspace pins ");
			out.Append(pin.Member("version").AsView());
			if (pin.Member("match").AsView() == "minimum") out.Append(" or newer");
			out.Append(" (");
			out.Append(pin.Member("file").AsView());
			out.Append(")");
		}
		if (state != "found" && !tool.Member("problem").AsView().IsEmpty()) {
			out.Append(" - ");
			out.Append(tool.Member("problem").AsView());
		}
		if (state != "found" && tool.Member("canInstall").AsBool()) {
			out.Append("; IED installs ");
			out.Append(tool.Member("installs").AsView());
			if (tool.Member("installsForUser").AsBool()) out.Append(" for the user (asked first)");
		}
		out.Append("\n");
	}

	static ToolOutcome LanguageToolsRun(const ToolInvocation& call) {
		Core::String json = IED::LanguageToolsJson(call.m_Ws);
		if (json.IsEmpty()) return ToolError(Core::StringView("language_tools: the workspace is not open any more"));
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode snapshot = Serialization::ReadJson(json.View(), *doc).root;
		if (!snapshot.Member("trusted").AsBool()) return ToolResult(Core::StringView("The workspace is not trusted, so IED looks for none of its tools (finding them runs programs); the owner trusts it from the banner."), Core::StringView("untrusted"));
		if (!snapshot.Member("detected").AsBool()) return ToolResult(Core::StringView("IED is still looking for the workspace's tools; ask again in a moment."), Core::StringView("looking"));
		Serialization::DomNode tools = snapshot.Member("tools");
		Core::StringBuilder out;
		out.Append("The compilers, language servers and debuggers the workspace's languages need. The owner installs a missing one with one click (the banner, or Settings > Languages > Tools); a setting naming a program wins.\n");
		int64 lacking = 0;
		for (int64 i = 0; tools.Kind() == Serialization::DomKind::Array && i < tools.Count(); ++i) {
			DescribeTool(out, tools.At(i));
			if (tools.At(i).Member("state").AsView() != "found") lacking += 1;
		}
		if (tools.Count() == 0) out.Append("None of the workspace's languages names a tool.\n");
		Core::StringBuilder preview;
		preview.AppendInt(tools.Count());
		preview.Append(tools.Count() == 1 ? " tool, " : " tools, ");
		preview.AppendInt(lacking);
		preview.Append(" missing");
		return ToolResult(out.View(), preview.View());
	}

	void AddProjectTools(ToolRegistry& registry) {
		registry.Add(ProjectSpec("project_list", "The workspace's solution and its projects (kind, language, folder, project file, dependencies) and the other open workspaces. Example: project_list({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read, ListPlan, ListRun));
		registry.Add(ProjectSpec("project_templates", "New Project's templates (C++, C4, Go console apps, libraries...): their keys for project_create, and which can be added to this solution. Example: project_templates({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read, TemplatesPlan, TemplatesRun));
		registry.Add(ProjectSpec("project_create", "Make a project from a template (key from project_templates): added to this solution, or with location (a full path) a new workspace <location>/<name> that opens beside this one. The Solution Explorer shows it at once. Example: project_create({\"template\": \"ied.cpp/console\", \"name\": \"Tools\"})",
			"{\"type\": \"object\", \"properties\": {\"template\": {\"type\": \"string\", \"minLength\": 1}, \"name\": {\"type\": \"string\", \"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"maxLength\": 64}, \"location\": {\"type\": \"string\", \"description\": \"a full path: make a new workspace there instead of adding to this solution\"}}, \"required\": [\"template\", \"name\"], \"additionalProperties\": false}",
			ToolClass::Exec, CreatePlan, CreateRun));
		registry.Add(ProjectSpec("project_import", "Make an existing folder an IED project: \".\" makes this workspace a solution; a folder of the workspace joins its solution as a project; a full path elsewhere becomes a solution of its own and opens. A .iedsln already in the folder (nuke init --ied wrote it) is opened as it is; else the build system's own project files are used when there is one (nuke.toml); else IED writes a .iedsln and .iedproj with the language and build preset found in the folder. Example: project_import({\"folder\": \"tools/packer\"})",
			"{\"type\": \"object\", \"properties\": {\"folder\": {\"type\": \"string\", \"description\": \"\\\".\\\", a workspace-relative folder, or a full path\"}, \"name\": {\"type\": \"string\", \"description\": \"default: the folder's name\"}, \"kind\": {\"enum\": [\"executable\", \"library\", \"module\", \"custom\", \"tests\", \"other\"]}, \"language\": {\"type\": \"string\", \"description\": \"a language id (cpp, c4, go, rust...); default: found from the files\"}}, \"required\": [\"folder\"], \"additionalProperties\": false}",
			ToolClass::Exec, ImportPlan, ImportRun));
		registry.Add(ProjectSpec("project_move", "Move a project of the solution to another folder of the workspace; its build files and the solution follow, and so do documents open in it. Example: project_move({\"project\": \"Engine\", \"to\": \"libs/Engine\"})",
			"{\"type\": \"object\", \"properties\": {\"project\": {\"type\": \"string\", \"minLength\": 1}, \"to\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"the new folder, workspace-relative\"}}, \"required\": [\"project\", \"to\"], \"additionalProperties\": false}",
			ToolClass::Exec, MovePlan, MoveRun));
		registry.Add(ProjectSpec("project_remove", "Take a project out of the solution (and its build): its files stay unless delete_files, which moves its folder to IED's trash (recoverable). Refused while another project depends on it. Example: project_remove({\"project\": \"OldTool\"})",
			"{\"type\": \"object\", \"properties\": {\"project\": {\"type\": \"string\", \"minLength\": 1}, \"delete_files\": {\"type\": \"boolean\"}}, \"required\": [\"project\"], \"additionalProperties\": false}",
			ToolClass::Exec, RemovePlan, RemoveRun));
		registry.Add(ProjectSpec("language_tools", "The compilers, language servers and debuggers the workspace's languages need (go, gopls, Delve, cargo, rust-analyzer, clangd, CodeLLDB...): each found (its version and where) or missing (why), and the version the workspace pins (go.mod, rust-toolchain.toml). For a build, a language server or a debugger that fails because its program is missing or the wrong version. Example: language_tools({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read, LanguageToolsPlan, LanguageToolsRun));
	}
}
