include "ImageInfo.ch"

namespace Ai
{
	// --- Bytes -----------------------------------------------------------------------------------------------------------

	static bool Has(const Core::Array<uint8>& b, int64 at, int64 count) { return at >= 0 && at + count <= b.Count(); }
	static int64 U16LE(const Core::Array<uint8>& b, int64 at) { return (int64)b[at] | ((int64)b[at + 1] << 8); }
	static int64 U24LE(const Core::Array<uint8>& b, int64 at) { return U16LE(b, at) | ((int64)b[at + 2] << 16); }
	static int64 U32LE(const Core::Array<uint8>& b, int64 at) { return U16LE(b, at) | (U16LE(b, at + 2) << 16); }
	static int64 U16BE(const Core::Array<uint8>& b, int64 at) { return ((int64)b[at] << 8) | (int64)b[at + 1]; }
	static int64 U32BE(const Core::Array<uint8>& b, int64 at) { return (U16BE(b, at) << 16) | U16BE(b, at + 2); }

	// The `count` bytes at `at` are `text`'s.
	static bool Starts(const Core::Array<uint8>& b, int64 at, const char* text, int64 count) {
		if (!Has(b, at, count)) return false;
		for (int64 i = 0; i < count; ++i)
			if (b[at + i] != (uint8)text[i]) return false;
		return true;
	}

	static Core::String Bits(int64 bits, const char* what) {
		Core::StringBuilder out;
		out.AppendInt(bits);
		out.Append("-bit ");
		out.Append(what);
		return out.ToString();
	}

	// --- Formats ---------------------------------------------------------------------------------------------------------

	// A PNG chunk of that type before the image data.
	static bool PngChunk(const Core::Array<uint8>& b, const char* type) {
		int64 at = 8;
		while (Has(b, at, 8) && !Starts(b, at + 4, "IDAT", 4)) {
			if (Starts(b, at + 4, type, 4)) return true;
			at += 12 + U32BE(b, at);
		}
		return false;
	}

	static bool ReadPng(const Core::Array<uint8>& b, ImageInfo& info) {
		if (!Starts(b, 0, "\x89PNG\r\n\x1a\n", 8) || !Starts(b, 12, "IHDR", 4) || !Has(b, 16, 10)) return false;
		info.m_Format = Core::String("PNG");
		info.m_Width = U32BE(b, 16);
		info.m_Height = U32BE(b, 20);
		const int64 type = b[25];
		const char*[7] names = { "gray", "", "RGB", "indexed", "gray and alpha", "", "RGBA" };
		info.m_Pixels = Bits(b[24], type <= 6 ? names[type] : "pixels");
		info.m_Alpha = type == 4 || type == 6 || PngChunk(b, "tRNS");
		info.m_Srgb = PngChunk(b, "sRGB");
		return true;
	}

	static bool IsJpegFrame(int64 marker) {
		return marker >= 0xC0 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC;
	}

	static bool ReadJpeg(const Core::Array<uint8>& b, ImageInfo& info, Core::String& problem) {
		if (!Has(b, 0, 3) || b[0] != 0xFF || b[1] != 0xD8) return false;
		info.m_Format = Core::String("JPEG");
		int64 at = 2;
		while (Has(b, at, 4)) {
			const int64 marker = b[at + 1];
			if (b[at] != 0xFF || marker == 0xFF) {
				at += 1;
				continue;
			}
			if (marker == 0xDA) break;
			if (marker == 0x01 || (marker >= 0xD0 && marker <= 0xD8)) {   // standalone: no length
				at += 2;
				continue;
			}
			if (IsJpegFrame(marker) && Has(b, at + 4, 6)) {
				info.m_Height = U16BE(b, at + 5);
				info.m_Width = U16BE(b, at + 7);
				const int64 components = b[at + 9];
				info.m_Pixels = Bits(b[at + 4], components == 1 ? "gray" : components == 4 ? "CMYK" : "YCbCr");
				if (marker == 0xC2 || marker == 0xC6 || marker == 0xCA || marker == 0xCE) info.m_Pixels = info.m_Pixels + ", progressive";
				return true;
			}
			at += 2 + U16BE(b, at + 2);
		}
		problem = Core::String("its size is not in the first 256 KB");
		return true;
	}

	static bool ReadGif(const Core::Array<uint8>& b, ImageInfo& info) {
		if ((!Starts(b, 0, "GIF87a", 6) && !Starts(b, 0, "GIF89a", 6)) || !Has(b, 6, 4)) return false;
		info.m_Format = Core::String("GIF");
		info.m_Width = U16LE(b, 6);
		info.m_Height = U16LE(b, 8);
		info.m_Pixels = Core::String("indexed");
		return true;
	}

	static bool ReadWebp(const Core::Array<uint8>& b, ImageInfo& info, Core::String& problem) {
		if (!Starts(b, 0, "RIFF", 4) || !Starts(b, 8, "WEBP", 4)) return false;
		info.m_Format = Core::String("WebP");
		if (Starts(b, 12, "VP8 ", 4) && Has(b, 26, 4)) {
			info.m_Width = U16LE(b, 26) & 0x3FFF;
			info.m_Height = U16LE(b, 28) & 0x3FFF;
			info.m_Pixels = Core::String("lossy");
		}
		else if (Starts(b, 12, "VP8L", 4) && Has(b, 21, 4)) {
			const int64 bits = U32LE(b, 21);
			info.m_Width = (bits & 0x3FFF) + 1;
			info.m_Height = ((bits >> 14) & 0x3FFF) + 1;
			info.m_Alpha = ((bits >> 28) & 1) != 0;
			info.m_Pixels = Core::String("lossless");
		}
		else if (Starts(b, 12, "VP8X", 4) && Has(b, 20, 10)) {
			info.m_Alpha = (b[20] & 0x10) != 0;
			info.m_Width = U24LE(b, 24) + 1;
			info.m_Height = U24LE(b, 27) + 1;
			info.m_Pixels = Core::String((b[20] & 0x02) != 0 ? "extended, animated" : "extended");
		}
		else problem = Core::String("its first chunk is none of VP8, VP8L, VP8X");
		return true;
	}

	static bool ReadBmp(const Core::Array<uint8>& b, ImageInfo& info) {
		if (!Starts(b, 0, "BM", 2) || !Has(b, 18, 12)) return false;
		info.m_Format = Core::String("BMP");
		info.m_Width = U32LE(b, 18);
		const int64 height = U32LE(b, 22);
		info.m_Height = height >= 0x80000000 ? 0x100000000 - height : height;   // negative: stored top-down
		const int64 bits = U16LE(b, 28);
		info.m_Pixels = Bits(bits, "pixels");
		info.m_Alpha = bits == 32;
		return true;
	}

	// The DXGI formats textures use, by number (dxgiformat.h); others are named by number.
	static Core::String DxgiName(int64 format) {
		const int64[22] numbers = { 2, 10, 24, 28, 29, 61, 71, 72, 74, 75, 77, 78, 80, 81, 83, 84, 87, 91, 95, 96, 98, 99 };
		const char*[22] names = { "R32G32B32A32_FLOAT", "R16G16B16A16_FLOAT", "R10G10B10A2_UNORM", "R8G8B8A8_UNORM", "R8G8B8A8_UNORM_SRGB", "R8_UNORM",
			"BC1_UNORM", "BC1_UNORM_SRGB", "BC2_UNORM", "BC2_UNORM_SRGB", "BC3_UNORM", "BC3_UNORM_SRGB", "BC4_UNORM", "BC4_SNORM", "BC5_UNORM", "BC5_SNORM",
			"B8G8R8A8_UNORM", "B8G8R8A8_UNORM_SRGB", "BC6H_UF16", "BC6H_SF16", "BC7_UNORM", "BC7_UNORM_SRGB" };
		for (int32 i = 0; i < 22; ++i)
			if (numbers[i] == format) return Core::String(names[i]);
		Core::StringBuilder out;
		out.Append("DXGI format ");
		out.AppendInt(format);
		return out.ToString();
	}

	static bool HasAlphaChannel(Core::StringView name) {
		return name.Contains(Core::StringView("A8")) || name.Contains(Core::StringView("A16")) || name.Contains(Core::StringView("A32")) || name.StartsWith(Core::StringView("BC2"))
			|| name.StartsWith(Core::StringView("BC3")) || name.Contains(Core::StringView("DXT3")) || name.Contains(Core::StringView("DXT5"));
	}

	static bool ReadDds(const Core::Array<uint8>& b, ImageInfo& info, Core::String& problem) {
		if (!Starts(b, 0, "DDS ", 4)) return false;
		info.m_Format = Core::String("DDS");
		if (!Has(b, 0, 128)) {
			problem = Core::String("its header is cut short");
			return true;
		}
		info.m_Height = U32LE(b, 12);
		info.m_Width = U32LE(b, 16);
		info.m_Mips = U32LE(b, 28) > 1 ? U32LE(b, 28) : 1;
		info.m_Cube = (U32LE(b, 112) & 0x200) != 0;
		const int64 flags = U32LE(b, 80);
		if (Starts(b, 84, "DX10", 4) && Has(b, 128, 20)) {
			info.m_Pixels = DxgiName(U32LE(b, 128));
			info.m_Cube = info.m_Cube || (U32LE(b, 136) & 0x4) != 0;
			info.m_Layers = U32LE(b, 140) > 1 ? U32LE(b, 140) : 1;
		}
		else if ((flags & 0x4) != 0) {
			Core::String fourcc = Core::String(Core::StringView((const char*)b.Data() + 84, 4));
			if (fourcc.View() == "DXT1") info.m_Pixels = Core::String("DXT1 (BC1)");
			else if (fourcc.View() == "DXT3") info.m_Pixels = Core::String("DXT3 (BC2)");
			else if (fourcc.View() == "DXT5") info.m_Pixels = Core::String("DXT5 (BC3)");
			else if (fourcc.View() == "ATI1" || fourcc.View() == "BC4U") info.m_Pixels = Core::String("BC4");
			else if (fourcc.View() == "ATI2" || fourcc.View() == "BC5U") info.m_Pixels = Core::String("BC5");
			else info.m_Pixels = Core::String("FourCC ") + fourcc.View();
		}
		else info.m_Pixels = Bits(U32LE(b, 88), (flags & 0x1) != 0 ? "RGBA" : "RGB");
		info.m_Alpha = HasAlphaChannel(info.m_Pixels.View()) || ((flags & 0x1) != 0);
		info.m_Srgb = info.m_Pixels.View().EndsWith(Core::StringView("_SRGB"));
		return true;
	}

	// --- Reading -----------------------------------------------------------------------------------------------------------

	bool ReadImageInfo(const Core::Array<uint8>& bytes, ImageInfo& info, Core::String& problem) {
		info.m_Mips = 1;
		info.m_Layers = 1;
		const bool known = ReadPng(bytes, info) || ReadJpeg(bytes, info, problem) || ReadGif(bytes, info) || ReadWebp(bytes, info, problem) || ReadBmp(bytes, info)
			|| ReadDds(bytes, info, problem);
		if (!known) problem = Core::String("it is not a PNG, JPEG, GIF, WebP, BMP or DDS file");
		return known && problem.IsEmpty();
	}

	Core::String ImageInfo::Summary() const {
		Core::StringBuilder out;
		out.Append(m_Format.View());
		out.Append(", ");
		out.AppendInt(m_Width);
		out.Append("x");
		out.AppendInt(m_Height);
		if (m_Mips > 1) {
			out.Append(", ");
			out.AppendInt(m_Mips);
			out.Append(" mips");
		}
		if (m_Cube) out.Append(", cube");
		if (m_Layers > 1) {
			out.Append(", ");
			out.AppendInt(m_Layers);
			out.Append(" layers");
		}
		if (!m_Pixels.IsEmpty()) {
			out.Append(", ");
			out.Append(m_Pixels.View());
		}
		if (m_Srgb || m_Alpha) {
			out.Append(" (");
			if (m_Srgb) out.Append(m_Alpha ? "sRGB, " : "sRGB");
			if (m_Alpha) out.Append("alpha");
			out.Append(")");
		}
		return out.ToString();
	}
}
