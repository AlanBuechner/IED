namespace Ai
{
	Core::String ImageMime(Core::StringView path) {
		int64 dot = path.ByteLength() - 1;
		while (dot >= 0 && path.ByteAt(dot) != '.' && path.ByteAt(dot) != '/') dot -= 1;
		if (dot < 0 || path.ByteAt(dot) != '.') return Core::String();
		Core::StringBuilder extension;
		for (int64 i = dot + 1; i < path.ByteLength(); ++i) {
			const int32 c = path.ByteAt(i);
			extension.AppendByte(c >= 'A' && c <= 'Z' ? c + 32 : c);
		}
		Core::StringView e = extension.View();
		if (e == "png") return Core::String("image/png");
		if (e == "jpg" || e == "jpeg") return Core::String("image/jpeg");
		if (e == "webp") return Core::String("image/webp");
		if (e == "gif") return Core::String("image/gif");
		return Core::String();
	}

	static bool IsFullPath(Core::StringView path) { return path.StartsWith(Core::StringView("/")) || (path.ByteLength() >= 2 && path.ByteAt(1) == ':'); }

	// A full path the workspace does not hold - an image the owner attached, named as the model is shown it, or another on disk.
	static bool OutsideWorkspace(const ToolInvocation& call, Core::StringView path) { return IsFullPath(path) && IsFullPath(WorkspacePathOf(call.m_Ws, path).View()); }

	Core::String ViewedCopyName(Core::StringView fullPath) {
		uint64 hash = 0xCBF29CE484222325ul;
		for (int64 i = 0; i < fullPath.ByteLength(); ++i) hash = (hash ^ (uint64)(uint8)fullPath.ByteAt(i)) * 0x100000001B3ul;
		Core::StringBuilder name;
		name.Append("viewed-");
		name.AppendHex(hash & 0xFFFFFFFFul);
		name.Append("-");
		name.Append(MediaName(fullPath).View());
		return name.ToString();
	}

	// An image outside the workspace, copied into this chat's media folder (which the workspace holds), so it is read and sent as any of the
	// workspace's images: its workspace path, or empty with `why`.
	static Core::String CopiedIntoChat(const ToolInvocation& call, Core::StringView fullPath, Core::String& why) {
		const Core::String source = Core::String(fullPath);
		const int64 bytes = FS::FileSize(source.CStr());
		if (bytes < 0) {
			why = Core::String("there is no such file");
			return Core::String();
		}
		if (bytes > c_ToolImageMaxBytes) {
			why = Core::String("it is larger than 4 MB");
			return Core::String();
		}
		Core::Array<uint8> data;
		data.Resize(bytes);
		FS::File opened = FS::File(source.CStr(), "rb");
		if (!opened.IsOpen() || opened.ReadAll((void*)data.Data(), data.Count()) != data.Count()) {
			why = Core::String("it cannot be read");
			return Core::String();
		}
		const Core::String name = ViewedCopyName(fullPath);
		FS::Path written = ChatFolder(LocalStateOf(call.m_Ws), call.m_Chat->m_ChatId.View()) / "media" / name.View();
		FS::MakeDirectories(written.Parent().CStr());
		if (!FS::WriteFileAtomically(written.CStr(), (const void*)data.Data(), data.Count())) {
			why = Core::String("its copy could not be written into the chat's media folder");
			return Core::String();
		}
		return ((Core::String(".ied/local/chats/") + call.m_Chat->m_ChatId.View()) + "/media/") + name.View();
	}

	static ToolPlan ViewPlan(const ToolInvocation& call) {
		ToolPlan plan;
		const Core::StringView given = call.m_Args.Member("path").AsView();
		plan.m_Subject = (Core::String("fs.read(") + (OutsideWorkspace(call, given) ? Core::String(given) : WorkspaceArgument(call, "path")).View()) + ")";
		plan.m_Summary = Core::String("View ") + call.m_Args.Member("path").AsView();
		return plan;
	}

	static ToolOutcome ViewRun(const ToolInvocation& call) {
		IED::ToolImage image;
		const Core::StringView given = call.m_Args.Member("path").AsView();
		const bool outside = OutsideWorkspace(call, given);
		image.m_Path = outside ? Core::String(given) : WorkspaceArgument(call, "path");
		image.m_Mime = ImageMime(image.m_Path.View());
		if (image.m_Mime.IsEmpty()) return ToolError(((Core::String("image_view: ") + image.m_Path.View()) + " is not a PNG, JPEG, WebP or GIF file").View());
		if (outside) {
			Core::String why;
			Core::String copied = CopiedIntoChat(call, given, why);
			if (copied.IsEmpty()) return ToolError(((Core::String("image_view: ") + given) + ": " + why.View()).View());
			image.m_Path = copied;
		}
		Core::Array<IED::ToolImage> named;
		named.Push(image);
		Core::Array<Core::String> notes;
		Core::Array<IED::ToolImage> shown = AcceptedImages(call.m_Ws, named, notes);
		if (shown.IsEmpty()) return ToolError((Core::String("image_view: ") + notes[0].View()).View());
		Core::StringBuilder said;
		said.Append("The image ");
		said.Append(image.m_Path.View());
		said.Append(" (");
		said.Append(image.m_Mime.View());
		said.Append(", ");
		said.AppendInt((FS::FileSize(IED::WorkspaceFile(call.m_Ws, image.m_Path.View()).CStr()) + 1023) / 1024);
		said.Append(" KB).");
		ToolOutcome outcome = ToolResult(said.View(), ((Core::String("[image ") + image.m_Path.View()) + "]").View());
		outcome.m_Images = shown;
		return outcome;
	}

	static ToolPlan InfoPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("fs.read(") + WorkspaceArgument(call, "path").View()) + ")";
		plan.m_Summary = Core::String("Read the header of ") + call.m_Args.Member("path").AsView();
		return plan;
	}

	static ToolOutcome InfoRun(const ToolInvocation& call) {
		Core::String path = WorkspaceArgument(call, "path");
		FS::Path file = FS::Path(IED::WorkspaceFile(call.m_Ws, path.View()).View());
		const int64 size = FS::FileSize(file.CStr());
		if (size < 0) return ToolError(((Core::String("image_info: there is no file ") + path.View()) + "; use fs_glob to find files by name").View());
		Core::Array<uint8> head;
		head.Resize(size < c_ImageInfoHeadBytes ? size : c_ImageInfoHeadBytes);
		FS::File opened = FS::File(file.CStr(), "rb");
		if (!opened.IsOpen() || opened.ReadAll((void*)head.Data(), head.Count()) != head.Count()) return ToolError((Core::String("image_info: cannot read ") + path.View()).View());
		ImageInfo info;
		Core::String problem;
		if (!ReadImageInfo(head, info, problem)) return ToolError(((Core::String("image_info: ") + path.View()) + ": " + problem.View()).View());
		Core::StringBuilder said;
		said.Append(path.View());
		said.Append(": ");
		said.Append(info.Summary().View());
		said.Append(", ");
		said.AppendInt((size + 1023) / 1024);
		said.Append(" KB");
		return ToolResult(said.View(), said.View());
	}

	void AddMediaTools(ToolRegistry& registry) {
		ToolSpec* info = new ToolSpec();
		info->m_Name = Core::String("image_info");
		info->m_Description = Core::String("What an image file is, from its header: format, size, mip levels, pixel format (DDS textures: BC1-BC7, sRGB, cube, array), alpha. PNG, JPEG, GIF, WebP, BMP and DDS. Example: image_info({\"path\": \"assets/rock_albedo.dds\"})");
		info->m_Parameters = Core::String("{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\", \"description\": \"workspace-relative path\"}}, \"required\": [\"path\"], \"additionalProperties\": false}");
		info->m_ToolClass = ToolClass::Read;
		info->m_ParallelSafe = true;
		info->m_InPlan = true;
		info->m_Deferred = true;
		info->m_Group = Core::String("media");
		info->m_FolderRoots = true;
		info->m_Plan = InfoPlan;
		info->m_Run = InfoRun;
		registry.Add(info);
		ToolSpec* view = new ToolSpec();
		view->m_Name = Core::String("image_view");
		view->m_Description = Core::String("Look at an image file (PNG, JPEG, WebP or GIF, at most 4 MB): a screenshot, a texture, a diagram. One outside the workspace - an image the owner attached, by the full path it was shown with - is copied into the chat's media folder and shown from there. Example: image_view({\"path\": \"docs/shots/menu.png\"})");
		view->m_Parameters = Core::String("{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\", \"description\": \"workspace-relative path, or the full path of an image elsewhere on disk\"}}, \"required\": [\"path\"], \"additionalProperties\": false}");
		view->m_ToolClass = ToolClass::Read;
		view->m_ParallelSafe = true;
		view->m_InPlan = true;
		view->m_Deferred = true;
		view->m_Group = Core::String("media");
		view->m_Plan = ViewPlan;
		view->m_Run = ViewRun;
		registry.Add(view);
		AddVideoTool(registry);
	}
}
