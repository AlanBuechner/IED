// The line diff a write's result and an approval card show (docs/04): as many lines as were edited, however long the
// file and however far apart its edits - a middle too big for the common subsequence's table is diffed by its shortest
// edit script - and only a text rewritten past c_LineDiffMostEdits shown removed then added.

include "LineDiff.ch"

static Core::StringView Text(const char* text) { return Core::StringView(text); }

// `count` numbered lines; line `changed` reads otherwise, and a line is added after line `added` (-1: none).
static Core::String Lines(int64 count, int64 changed, int64 added, const char* word) {
	Core::StringBuilder text;
	for (int64 i = 0; i < count; i += 1) {
		text.Append(i == changed ? "changed " : word);
		text.AppendInt(i);
		text.Append("\n");
		if (i == added) text.Append("added\n");
	}
	return text.ToString();
}

static int64 Hunks(const Core::String& unified) {
	int64 count = 0;
	for (Core::StringView line : Ai::SplitLines(unified.View()))
		if (line.StartsWith(Text("@@ -"))) count += 1;
	return count;
}

[test("server.ai.linediff")]
class LineDiffTests {
	[test("a_small_edit_by_its_lines_a_changed_one_removed_then_added")]
	public static void TestSmall() {
		Ai::LineDiff same = Ai::DiffLines(Text("a\nb\n"), Text("a\nb\n"), 3);
		assert_true(same.m_Unified.IsEmpty() && same.m_Plus == 0 && same.m_Minus == 0, "the same: nothing");
		Ai::LineDiff changed = Ai::DiffLines(Text("a\nb\nc\n"), Text("a\nB\nc\nd\n"), 3);
		assert_true(changed.m_Plus == 2 && changed.m_Minus == 1, "one changed, one added");
		assert_true(changed.m_Unified.View() == Text("@@ -1,3 +1,4 @@\n a\n-b\n+B\n c\n+d\n"), changed.m_Unified.CStr());
	}

	[test("two_edits_far_apart_in_a_long_file_are_two_small_hunks")]
	public static void TestFarApart() {
		Core::String before = Lines(1500, -1, -1, "line ");
		Core::String after = Lines(1500, 20, 1400, "line ");
		Ai::LineDiff diff = Ai::DiffLines(before.View(), after.View(), 3);
		assert_true(diff.m_Plus == 2 && diff.m_Minus == 1, "the line changed and the one added, not the 1380 between them");
		assert_eq((int64)2, Hunks(diff.m_Unified), "a hunk each");
		assert_true(diff.m_Unified.View().Contains(Text("@@ -18,7 +18,7 @@\n line 17\n line 18\n line 19\n-line 20\n+changed 20\n line 21\n")), diff.m_Unified.CStr());
		assert_true(diff.m_Unified.View().Contains(Text(" line 1400\n+added\n line 1401\n")), "the added line where it was added");
		Ai::LineDiff gone = Ai::DiffLines(after.View(), before.View(), 3);
		assert_true(gone.m_Plus == 1 && gone.m_Minus == 2 && Hunks(gone.m_Unified) == 2, "and back");
	}

	[test("a_text_rewritten_is_shown_removed_then_added")]
	public static void TestRewritten() {
		Core::String before = Lines(1500, -1, -1, "line ");
		Core::String after = Lines(1500, -1, -1, "other ");
		Ai::LineDiff diff = Ai::DiffLines(before.View(), after.View(), 3);
		assert_true(diff.m_Plus == 1500 && diff.m_Minus == 1500, "every line, past the edits a script is found for");
		assert_eq((int64)1, Hunks(diff.m_Unified), "one hunk");
	}
}
