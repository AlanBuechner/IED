include "api/Plugin.ch"
include "CodeInfo.ch"

namespace Ai
{
	const int64 c_HoverSummaryBytes = 120;

	static const char*[9] c_ShownModifiers = { "static", "readonly", "abstract", "virtual", "deprecated", "async", "const", "constexpr", "inline" };

	// --- Hovers ----------------------------------------------------------------------------------------------------------

	static void AppendMarked(Core::StringBuilder& out, const Serialization::DomNode& node) {
		if (node.Kind() == Serialization::DomKind::String) {
			out.Append(node.AsView());
			return;
		}
		if (node.Member("kind").IsValid()) {
			out.Append(node.Member("value").AsView());
			return;
		}
		out.Append("```");
		out.Append(node.Member("language").AsView());
		out.Append("\n");
		out.Append(node.Member("value").AsView());
		out.Append("\n```");
	}

	Core::String HoverText(const Serialization::DomNode& hover) {
		Serialization::DomNode contents = hover.Member("contents");
		Core::StringBuilder out;
		if (contents.Kind() == Serialization::DomKind::Array)
			for (int64 i = 0; i < contents.Count(); ++i) {
				if (i > 0) out.Append("\n\n");
				AppendMarked(out, contents.At(i));
			}
		else if (contents.IsValid() && !contents.IsNull()) AppendMarked(out, contents);
		return Core::String(out.View().Trimmed());
	}

	// The next line of `text` from `at`, trimmed; `at` moves past it.
	static Core::StringView NextLine(Core::StringView text, int64& at) {
		int64 end = text.IndexOf('\n', at);
		if (end < 0) end = text.ByteLength();
		Core::StringView line = text.Substring(at, end - at).Trimmed();
		at = end + 1;
		return line;
	}

	static bool IsFence(Core::StringView line) { return line.StartsWith(Core::StringView("```")); }

	Core::String HoverDeclaration(Core::StringView markdown) {
		Core::StringBuilder out;
		int64 fences = 0;
		int64 at = 0;
		while (at < markdown.ByteLength() && fences < 2) {
			Core::StringView line = NextLine(markdown, at);
			if (IsFence(line)) fences += 1;
			else if (fences == 1 && !line.IsEmpty() && !line.StartsWith(Core::StringView("//"))) {
				if (!out.IsEmpty()) out.Append(" ");
				out.Append(line);
			}
		}
		return out.ToString();
	}

	// Whether `text` starts with the arrow U+2192 a hover puts before a return type.
	static bool IsArrow(Core::StringView text) { return text.ByteLength() >= 3 && (uint8)text.ByteAt(0) == 0xE2 && (uint8)text.ByteAt(1) == 0x86 && (uint8)text.ByteAt(2) == 0x92; }

	// Whether `text` is a fact a server labels ("Type: `int`", "Offset: 8 bytes", "Value = `6`", "provided by `a.h`"):
	// one word, ": " or " = ", then code or a number.
	static bool IsLabelledFact(Core::StringView text) {
		if (text.StartsWith(Core::StringView("provided by "))) return true;
		int64 word = 0;
		while (word < text.ByteLength() && ((text.ByteAt(word) >= 'a' && text.ByteAt(word) <= 'z') || (text.ByteAt(word) >= 'A' && text.ByteAt(word) <= 'Z'))) word += 1;
		if (word == 0 || word > 16) return false;
		Core::StringView rest = text.Substring(word, text.ByteLength() - word);
		if (rest.StartsWith(Core::StringView(": "))) rest = rest.Substring(2, rest.ByteLength() - 2);
		else if (rest.StartsWith(Core::StringView(" = "))) rest = rest.Substring(3, rest.ByteLength() - 3);
		else return false;
		return rest.StartsWith(Core::StringView("`")) || (!rest.IsEmpty() && rest.ByteAt(0) >= '0' && rest.ByteAt(0) <= '9');
	}

	// Whether a hover's prose line is a heading, a rule, a list item or a label rather than a doc comment's.
	static bool IsHoverChrome(Core::StringView text) {
		if (text.IsEmpty() || text.StartsWith(Core::StringView("#")) || text.StartsWith(Core::StringView("-")) || text.StartsWith(Core::StringView("*")) || text.StartsWith(Core::StringView(">")) || text.StartsWith(Core::StringView("|"))) return true;
		return IsArrow(text) || text.EndsWith(Core::StringView(":")) || IsLabelledFact(text);
	}

	Core::String HoverSummary(Core::StringView markdown) {
		bool inside = false;
		int64 at = 0;
		while (at < markdown.ByteLength()) {
			Core::StringView line = NextLine(markdown, at);
			if (IsFence(line)) inside = !inside;
			if (inside || IsFence(line) || IsHoverChrome(line)) continue;
			int64 cut = line.ByteLength() < c_HoverSummaryBytes ? line.ByteLength() : c_HoverSummaryBytes;
			while (cut > 0 && cut < line.ByteLength() && ((uint8)line.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
			return Core::String(line.Substring(0, cut));
		}
		return Core::String();
	}

	Core::Array<CodeToken> DecodeTokens(const Serialization::DomNode& data, const Serialization::DomNode& legend) {
		Core::Array<CodeToken> tokens;
		Serialization::DomNode names = legend.Member("tokenModifiers");
		int64 line = 0;
		int64 character = 0;
		for (int64 i = 0; i + 4 < data.Count(); i += 5) {
			const int64 deltaLine = data.At(i).AsInt();
			line += deltaLine;
			character = deltaLine == 0 ? character + data.At(i + 1).AsInt() : data.At(i + 1).AsInt();
			CodeToken token;
			token.m_Line = line;
			token.m_Character = character;
			const int64 bits = data.At(i + 4).AsInt();
			for (int64 bit = 0; bit < names.Count() && bit < 62; ++bit)
				if ((bits & ((int64)1 << bit)) != 0) token.m_Modifiers.Push(Core::String(names.At(bit).AsView()));
			tokens.Push(token);
		}
		return tokens;
	}

	static ToolOutcome HoverRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		Core::String text = HoverText(query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/hover"), PositionParams(target.m_At, Core::StringView("")).View(), true));
		if (text.IsEmpty()) return ToolError((Core::String("code_hover: the language server says nothing of what is at ") + target.m_Label.View() + "; is a name there?").View());
		Core::StringBuilder out;
		out.Append(target.m_Label.View());
		out.Append(" (");
		out.Append(WhereOf(target.m_At, query.Shown(target.m_At.m_Path.View()).View()).View());
		out.Append("):\n");
		out.Append(text.View());
		return ToolResult(out.View(), text.View());
	}

	// --- code_members ----------------------------------------------------------------------------------------------------

	// The innermost symbol holding members whose range holds `line`.
	static CodeSymbol* HolderAt(const Core::Array<CodeSymbol*>& symbols, int64 line) {
		for (CodeSymbol* symbol : symbols) {
			if (symbol->m_Range.m_StartLine > line || line > symbol->m_Range.m_EndLine) continue;
			CodeSymbol* inner = HolderAt(symbol->m_Children, line);
			if (inner) return inner;
			return HoldsMembers(symbol->m_Kind) ? symbol : nullptr;
		}
		return nullptr;
	}

	static CodeSymbol* TypeOf(CodeQuery& query, const CodeTarget& target) {
		if (target.m_Symbols.IsEmpty()) {
			CodeSymbol* holder = HolderAt(query.Outline(target.m_At.m_Path.View()), target.m_At.m_StartLine);
			if (!holder) throw IED::RpcError(IED::ErrorCode::NotFound, (Core::String("no type holds ") + target.m_Label.View()).View());
			return holder;
		}
		for (CodeSymbol* symbol : target.m_Symbols)
			if (HoldsMembers(symbol->m_Kind) && !symbol->m_Children.IsEmpty()) return symbol;
		for (CodeSymbol* symbol : target.m_Symbols)
			if (!symbol->m_Children.IsEmpty()) return symbol;
		CodeSymbol* first = target.m_Symbols[0];
		if (HoldsMembers(first->m_Kind)) return first;
		throw IED::RpcError(IED::ErrorCode::BadRequest, ((Core::String(target.m_Label.View()) + " is a ") + SymbolKindName(first->m_Kind) + ", not a type; give a class, struct, interface, enum or namespace").View());
	}

	// What code_members learns of one file: its semantic tokens' modifiers and whether its server hovers.
	class MemberFacts
	{
		public Core::String m_Path;
		public Core::Array<CodeToken> m_Tokens;
		public bool m_Hovers;
	}

	static MemberFacts* FactsOf(CodeQuery& query, Core::StringView path) {
		MemberFacts* facts = new MemberFacts();
		facts->m_Path = Core::String(path);
		facts->m_Hovers = query.Offers(path, "hoverProvider");
		if (!query.Offers(path, "semanticTokensProvider")) return facts;
		Serialization::DomNode legend = query.Serving(path).Member("capabilities").Member("semanticTokensProvider").Member("legend");
		try {
			facts->m_Tokens = DecodeTokens(query.Request(path, Core::StringView("textDocument/semanticTokens/full"), Core::StringView("{}"), true).Member("data"), legend);
		}
		catch (IED::RpcError& error) {
		}
		return facts;
	}

	// The modifiers worth saying of the token at `at` that `declaration` does not already say.
	static Core::String ModifiersAt(const MemberFacts* facts, const CodeSpan& at, Core::StringView declaration) {
		Core::StringBuilder out;
		for (const CodeToken& token : facts->m_Tokens) {
			if (token.m_Line != at.m_StartLine || token.m_Character != at.m_StartCharacter) continue;
			for (const Core::String& modifier : token.m_Modifiers) {
				bool shown = false;
				for (const char* name : c_ShownModifiers) shown = shown || modifier.View() == name;
				if (!shown || declaration.Contains(modifier.View())) continue;
				out.Append(out.IsEmpty() ? "[" : ", ");
				out.Append(modifier.View());
			}
		}
		if (!out.IsEmpty()) out.Append("]");
		return out.ToString();
	}

	// `declaration` without its owner's qualification (`Ied::LspPool::Find` -> `Find`): the type's heading names it.
	static Core::String WithoutOwner(Core::StringView declaration, Core::StringView owner) {
		Core::String text = Core::String(declaration);
		Core::Array<Core::String> parts = NameParts(owner);
		while (!parts.IsEmpty()) {
			Core::StringBuilder prefix;
			for (const Core::String& part : parts) {
				prefix.Append(part.View());
				prefix.Append("::");
			}
			Core::StringBuilder kept;
			Core::StringView rest = text.View();
			for (;;) {
				const int64 found = rest.IndexOf(prefix.View());
				if (found < 0) break;
				kept.Append(rest.Substring(0, found));
				rest = rest.Substring(found + prefix.ByteLength(), rest.ByteLength() - found - prefix.ByteLength());
			}
			kept.Append(rest);
			text = kept.ToString();
			parts.RemoveAt(0);
		}
		return text;
	}

	static void AppendMember(Core::StringBuilder& out, CodeQuery& query, const MemberFacts* facts, Core::StringView owner, const CodeSymbol* member) {
		Core::String hover;
		if (facts->m_Hovers) {
			try {
				hover = HoverText(query.Request(facts->m_Path.View(), Core::StringView("textDocument/hover"), PositionParams(member->m_Selection, Core::StringView("")).View(), true));
			}
			catch (IED::RpcError& error) {
			}
		}
		Core::String declaration = WithoutOwner(HoverDeclaration(hover.View()).View(), owner);
		if (declaration.IsEmpty()) {
			declaration = member->m_Name;
			if (!member->m_Detail.IsEmpty()) declaration = (declaration + ": ") + member->m_Detail.View();
		}
		out.Append("  L");
		out.AppendInt(member->m_Selection.m_StartLine + 1);
		out.Append("  ");
		out.Append(SymbolKindName(member->m_Kind));
		out.Append("  ");
		out.Append(declaration.View());
		Core::String modifiers = ModifiersAt(facts, member->m_Selection, declaration.View());
		if (!modifiers.IsEmpty()) {
			out.Append("  ");
			out.Append(modifiers.View());
		}
		Core::String summary = HoverSummary(hover.View());
		if (!summary.IsEmpty()) {
			out.Append("  - ");
			out.Append(summary.View());
		}
		out.Append("\n");
	}

	static void AppendMembers(Core::StringBuilder& out, CodeQuery& query, const CodeSymbol* type, int64& budget) {
		MemberFacts* facts = FactsOf(query, type->m_Range.m_Path.View());
		Core::String owner = type->Qualified();
		for (CodeSymbol* member : type->m_Children) {
			if (budget <= 0) return;
			AppendMember(out, query, facts, owner.View(), member);
			budget -= 1;
		}
	}

	static Core::String Visit(Core::StringView path, int64 line) {
		Core::StringBuilder key;
		key.Append(path);
		key.Append(":");
		key.AppendInt(line);
		return key.ToString();
	}

	// The members of `type`'s base types, nearest first (typeHierarchy/supertypes).
	static void AppendInherited(Core::StringBuilder& out, CodeQuery& query, const CodeSymbol* type, int64& budget) {
		Core::StringView path = type->m_Range.m_Path.View();
		if (!query.Offers(path, "typeHierarchyProvider")) {
			out.Append("[inherited members: the language server has no type hierarchy]\n");
			return;
		}
		Serialization::DomNode items = query.Request(path, Core::StringView("textDocument/prepareTypeHierarchy"), PositionParams(type->m_Selection, Core::StringView("")).View(), true);
		Core::Array<Serialization::DomNode> waiting;
		for (int64 i = 0; i < items.Count(); ++i) waiting.Push(items.At(i));
		Core::Array<Core::String> visited;
		int64 depth = 0;
		while (!waiting.IsEmpty() && depth < c_CodeHierarchyDepthMost && budget > 0) {
			Core::Array<Serialization::DomNode> next;
			for (const Serialization::DomNode& item : waiting) {
				Core::String itemPath = query.PathOf(item.Member("uri").AsView());
				Serialization::DomNode supers = query.Request(itemPath.View(), Core::StringView("typeHierarchy/supertypes"), (Core::String("{\"item\": ") + IED::NodeJson(item).View() + "}").View(), false);
				for (int64 i = 0; i < supers.Count(); ++i) {
					Serialization::DomNode base = supers.At(i);
					Core::String basePath = query.PathOf(base.Member("uri").AsView());
					const int64 line = base.Member("selectionRange").Member("start").Member("line").AsInt();
					Core::String key = Visit(basePath.View(), line);
					if (visited.Contains(key)) continue;
					visited.Push(key);
					next.Push(base);
					CodeSymbol* symbol = nullptr;
					try {
						symbol = HolderAt(query.Outline(basePath.View()), line);
					}
					catch (IED::RpcError& error) {
					}
					out.Append("from ");
					out.Append(base.Member("name").AsView());
					out.Append(" (");
					out.Append(query.Shown(basePath.View()).View());
					out.Append(":");
					out.AppendInt(line + 1);
					out.Append(")\n");
					if (symbol) AppendMembers(out, query, symbol, budget);
					else out.Append("  [its file has no outline]\n");
				}
			}
			waiting = next;
			depth += 1;
		}
	}

	static ToolOutcome MembersRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		CodeSymbol* type = TypeOf(query, target);
		int64 limit = call.m_Args.Member("limit").IsValid() ? call.m_Args.Member("limit").AsInt() : c_CodeMembersDefault;
		limit = limit < 1 ? 1 : limit > c_CodeMembersMost ? c_CodeMembersMost : limit;
		int64 budget = limit;
		Core::StringBuilder out;
		out.Append(SymbolHeading(query, type).View());
		out.Append(": ");
		out.AppendInt(type->m_Children.Count());
		out.Append(type->m_Children.Count() == 1 ? " member\n" : " members\n");
		AppendMembers(out, query, type, budget);
		if (type->m_Children.Count() > limit) {
			out.Append("[");
			out.AppendInt(type->m_Children.Count() - limit);
			out.Append(" more; give a larger limit]\n");
		}
		if (call.m_Args.Member("inherited").AsBool()) AppendInherited(out, query, type, budget);
		Core::StringBuilder preview;
		preview.Append(type->Qualified().View());
		preview.Append(": ");
		preview.AppendInt(type->m_Children.Count());
		preview.Append(" members");
		return ToolResult(out.View(), preview.View());
	}

	// --- Places: type definition, implementations --------------------------------------------------------------------------

	static ToolOutcome PlacesRun(const ToolInvocation& call, const char* tool, const char* method, const char* capability, const char* one, const char* what) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		if (!query.Offers(target.m_At.m_Path.View(), capability)) return ToolError((((Core::String(tool) + ": the language server of ") + query.Shown(target.m_At.m_Path.View()).View()) + " cannot say " + what).View());
		Core::Array<CodeSpan> spans = SpansOf(query, query.Request(target.m_At.m_Path.View(), Core::StringView(method), PositionParams(target.m_At, Core::StringView("")).View(), true), true);
		if (spans.IsEmpty()) return ToolError((((Core::String(tool) + ": the language server knows no ") + what) + " for " + target.m_Label.View()).View());
		Core::StringBuilder out;
		out.AppendInt(spans.Count());
		out.Append(" ");
		out.Append(spans.Count() == 1 ? one : what);
		out.Append(" for ");
		out.Append(target.m_Label.View());
		out.Append(":\n");
		for (int64 i = 0; i < spans.Count() && i < c_CodeImplementationsMost; ++i) {
			AppendPlace(out, query, spans[i]);
			out.Append("\n");
		}
		if (spans.Count() > c_CodeImplementationsMost) out.Append("[more not shown]\n");
		Core::StringBuilder preview;
		preview.AppendInt(spans.Count());
		preview.Append(" ");
		preview.Append(spans.Count() == 1 ? one : what);
		return ToolResult(out.View(), preview.View());
	}

	// --- Hierarchies ---------------------------------------------------------------------------------------------------------

	static void AppendItem(Core::StringBuilder& out, CodeQuery& query, const Serialization::DomNode& item, int64 indent) {
		for (int64 i = 0; i < indent; ++i) out.Append("  ");
		out.Append(SymbolKindName(item.Member("kind").AsInt()));
		out.Append(" ");
		out.Append(item.Member("name").AsView());
		if (!item.Member("detail").AsView().IsEmpty() && item.Member("detail").AsView() != item.Member("name").AsView()) {
			out.Append(" (");
			out.Append(item.Member("detail").AsView());
			out.Append(")");
		}
		out.Append(" - ");
		out.Append(query.Shown(query.PathOf(item.Member("uri").AsView()).View()).View());
		out.Append(":");
		out.AppendInt(item.Member("selectionRange").Member("start").Member("line").AsInt() + 1);
	}

	// The calls into or out of `item`, `depth` levels down; `count` nodes written so far. Its direct callers' call sites go
	// to `sites` when there is one.
	static void WalkCalls(Core::StringBuilder& out, CodeQuery& query, const Serialization::DomNode& item, bool incoming, int64 depth, int64 indent, Core::Array<Core::String>& visited, int64& count, Core::Array<CodeSpan>* sites) {
		Core::String path = query.PathOf(item.Member("uri").AsView());
		Serialization::DomNode calls = query.Request(path.View(), Core::StringView(incoming ? "callHierarchy/incomingCalls" : "callHierarchy/outgoingCalls"), (Core::String("{\"item\": ") + IED::NodeJson(item).View() + "}").View(), false);
		for (int64 i = 0; i < calls.Count() && count < c_CodeHierarchyNodesMost; ++i) {
			Serialization::DomNode other = calls.At(i).Member(incoming ? "from" : "to");
			Serialization::DomNode ranges = calls.At(i).Member("fromRanges");
			AppendItem(out, query, other, indent);
			out.Append(ranges.Count() == 1 ? " (call at line " : " (calls at lines ");
			for (int64 r = 0; r < ranges.Count(); ++r) {
				if (r > 0) out.Append(", ");
				out.AppendInt(ranges.At(r).Member("start").Member("line").AsInt() + 1);
				if (!sites) continue;
				CodeSpan site;
				site.m_Path = query.PathOf(other.Member("uri").AsView());
				site.m_StartLine = ranges.At(r).Member("start").Member("line").AsInt();
				site.m_EndLine = site.m_StartLine;
				sites->Push(site);
			}
			out.Append(")\n");
			count += 1;
			Core::String key = Visit(query.PathOf(other.Member("uri").AsView()).View(), other.Member("selectionRange").Member("start").Member("line").AsInt());
			if (depth <= 1 || visited.Contains(key)) continue;
			visited.Push(key);
			WalkCalls(out, query, other, incoming, depth - 1, indent + 1, visited, count, nullptr);
		}
	}

	static void WalkTypes(Core::StringBuilder& out, CodeQuery& query, const Serialization::DomNode& item, bool supertypes, int64 depth, int64 indent, Core::Array<Core::String>& visited, int64& count) {
		Core::String path = query.PathOf(item.Member("uri").AsView());
		Serialization::DomNode types = query.Request(path.View(), Core::StringView(supertypes ? "typeHierarchy/supertypes" : "typeHierarchy/subtypes"), (Core::String("{\"item\": ") + IED::NodeJson(item).View() + "}").View(), false);
		for (int64 i = 0; i < types.Count() && count < c_CodeHierarchyNodesMost; ++i) {
			Serialization::DomNode other = types.At(i);
			AppendItem(out, query, other, indent);
			out.Append("\n");
			count += 1;
			Core::String key = Visit(query.PathOf(other.Member("uri").AsView()).View(), other.Member("selectionRange").Member("start").Member("line").AsInt());
			if (depth <= 1 || visited.Contains(key)) continue;
			visited.Push(key);
			WalkTypes(out, query, other, supertypes, depth - 1, indent + 1, visited, count);
		}
	}

	static int64 DepthOf(const ToolInvocation& call, int64 fallback) {
		const int64 depth = call.m_Args.Member("depth").IsValid() ? call.m_Args.Member("depth").AsInt() : fallback;
		return depth < 1 ? 1 : depth > c_CodeHierarchyDepthMost ? c_CodeHierarchyDepthMost : depth;
	}

	static ToolOutcome CallHierarchyRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		if (!query.Offers(target.m_At.m_Path.View(), "callHierarchyProvider")) return ToolError((Core::String("code_call_hierarchy: the language server of ") + query.Shown(target.m_At.m_Path.View()).View() + " has no call hierarchy; code_references lists every use of a symbol").View());
		const bool incoming = call.m_Args.Member("direction").AsView() != "outgoing";
		Serialization::DomNode items = query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/prepareCallHierarchy"), PositionParams(target.m_At, Core::StringView("")).View(), true);
		if (items.Count() == 0) return ToolError((Core::String("code_call_hierarchy: no function is at ") + target.m_Label.View()).View());
		Core::StringBuilder out;
		Core::Array<Core::String> visited;
		Core::Array<CodeSpan> sites;
		int64 count = 0;
		for (int64 i = 0; i < items.Count(); ++i) {
			AppendItem(out, query, items.At(i), 0);
			out.Append(incoming ? " is called by:\n" : " calls:\n");
			WalkCalls(out, query, items.At(i), incoming, DepthOf(call, 2), 1, visited, count, incoming ? &sites : nullptr);
		}
		if (count == 0) out.Append(incoming ? "  [no callers]\n" : "  [no calls]\n");
		if (count >= c_CodeHierarchyNodesMost) out.Append("[stopped at 150 entries; give a smaller depth]\n");
		if (incoming) {
			for (int64 i = 0; i < items.Count(); ++i) {
				CodeSpan own;
				own.m_Path = query.PathOf(items.At(i).Member("uri").AsView());
				own.m_StartLine = items.At(i).Member("selectionRange").Member("start").Member("line").AsInt();
				own.m_EndLine = own.m_StartLine;
				sites.Push(own);
			}
			for (CodeSymbol* symbol : target.m_Symbols) sites.Push(symbol->m_Selection);
			AppendUnlisted(out, query, TargetName(query, target).View(), sites);
		}
		Core::StringBuilder preview;
		preview.AppendInt(count);
		preview.Append(incoming ? " callers" : " callees");
		return ToolResult(out.View(), preview.View());
	}

	static ToolOutcome TypeHierarchyRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		if (!query.Offers(target.m_At.m_Path.View(), "typeHierarchyProvider")) return ToolError((Core::String("code_type_hierarchy: the language server of ") + query.Shown(target.m_At.m_Path.View()).View() + " has no type hierarchy; code_implementations lists what implements an interface").View());
		const bool supertypes = call.m_Args.Member("direction").AsView() != "subtypes";
		Serialization::DomNode items = query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/prepareTypeHierarchy"), PositionParams(target.m_At, Core::StringView("")).View(), true);
		if (items.Count() == 0) return ToolError((Core::String("code_type_hierarchy: no type is at ") + target.m_Label.View()).View());
		Core::StringBuilder out;
		Core::Array<Core::String> visited;
		int64 count = 0;
		for (int64 i = 0; i < items.Count(); ++i) {
			AppendItem(out, query, items.At(i), 0);
			out.Append(supertypes ? " derives from:\n" : " is derived by:\n");
			WalkTypes(out, query, items.At(i), supertypes, DepthOf(call, 3), 1, visited, count);
		}
		if (count == 0) out.Append(supertypes ? "  [no base types]\n" : "  [no derived types]\n");
		Core::StringBuilder preview;
		preview.AppendInt(count);
		preview.Append(supertypes ? " base types" : " derived types");
		return ToolResult(out.View(), preview.View());
	}

	// --- Macros and a plugin's own requests ------------------------------------------------------------------------------------

	// The method of the serving profile's aiExposedRequests entry with `purpose`, or empty.
	static Core::String ExposedFor(CodeQuery& query, Core::StringView path, Core::StringView purpose) {
		Serialization::DomNode requests = query.Serving(path).Member("aiRequests");
		for (int64 i = 0; i < requests.Count(); ++i)
			if (requests.At(i).Member("purpose").AsView() == purpose) return Core::String(requests.At(i).Member("method").AsView());
		return Core::String();
	}

	static ToolOutcome ExpandMacroRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		Core::String method = ExposedFor(query, target.m_At.m_Path.View(), Core::StringView("expandMacro"));
		Core::StringBuilder out;
		if (!method.IsEmpty()) {
			Serialization::DomNode answer = query.Request(target.m_At.m_Path.View(), method.View(), PositionParams(target.m_At, Core::StringView("")).View(), true);
			if (!answer.IsValid() || answer.IsNull()) return ToolError((Core::String("code_expand_macro: no macro use is at ") + target.m_Label.View()).View());
			Core::StringView expansion = answer.Kind() == Serialization::DomKind::String ? answer.AsView() : answer.Member("expansion").AsView();
			out.Append(answer.Member("name").AsView().IsEmpty() ? target.m_Label.View() : answer.Member("name").AsView());
			out.Append(" at ");
			out.Append(WhereOf(target.m_At, query.Shown(target.m_At.m_Path.View()).View()).View());
			out.Append(" expands to:\n```\n");
			out.Append(expansion);
			out.Append("\n```\n");
			return ToolResult(out.View(), expansion);
		}
		out.Append("The language server of ");
		out.Append(query.Shown(target.m_At.m_Path.View()).View());
		out.Append(" has no expand-macro request (a language plugin exposes one with aiExposedRequests purpose expandMacro); what it says of ");
		out.Append(target.m_Label.View());
		out.Append(":\n");
		if (query.Offers(target.m_At.m_Path.View(), "hoverProvider")) {
			out.Append(HoverText(query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/hover"), PositionParams(target.m_At, Core::StringView("")).View(), true)).View());
			out.Append("\n");
		}
		for (const CodeSpan& span : SpansOf(query, query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/definition"), PositionParams(target.m_At, Core::StringView("")).View(), true), true)) {
			out.Append("Defined at ");
			AppendPlace(out, query, span);
		}
		return ToolResult(out.View(), Core::StringView("no expand request; hover and definition"));
	}

	static ToolOutcome CustomRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		Core::String path = query.FileOf(call.m_Args.Member("path").AsView());
		Core::StringView method = call.m_Args.Member("method").AsView();
		Serialization::DomNode requests = query.Serving(path.View()).Member("aiRequests");
		bool exposed = false;
		Core::StringBuilder offered;
		for (int64 i = 0; i < requests.Count(); ++i) {
			exposed = exposed || requests.At(i).Member("method").AsView() == method;
			offered.Append(i == 0 ? "" : ", ");
			offered.Append(requests.At(i).Member("method").AsView());
		}
		if (!exposed) return ToolError(((((Core::String("code_custom: the language server of ") + path.View()) + " does not expose ") + method) + (requests.Count() == 0 ? Core::String("; it exposes none") : Core::String("; it exposes ") + offered.View())).View());
		Core::String given = call.m_Args.Member("params").IsValid() ? IED::NodeJson(call.m_Args.Member("params")) : Core::String("{}");
		Core::String asked = given;
		if (call.m_Args.Member("line").IsValid()) {
			CodeTarget target = TargetOf(query, call.m_Args);
			Core::StringView inner = given.View().Trimmed();
			inner = inner.ByteLength() >= 2 ? inner.Substring(1, inner.ByteLength() - 2).Trimmed() : Core::StringView();
			asked = PositionParams(target.m_At, inner);
		}
		Core::String result = IED::NodeJson(query.Request(path.View(), method, asked.View(), true));
		Core::StringView shown = result.View().Substring(0, result.ByteLength() < c_CodeCustomResultBytes ? result.ByteLength() : c_CodeCustomResultBytes);
		return ToolResult(shown, (Core::String(method) + " answered").View());
	}

	// --- The group ---------------------------------------------------------------------------------------------------------

	void AddCodeInfoTools(ToolRegistry& registry) {
		ToolSpec* hover = CodeToolSpec("code_hover", "What the language server says of a symbol or the name at a place: its declaration, type and documentation. Example: code_hover({\"symbol\": \"Ring::Push\"})",
			CodeTargetSchema("").View(), true);
		hover->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Hover"); };
		hover->m_Run = HoverRun;
		registry.Add(hover);
		ToolSpec* members = CodeToolSpec("code_members", "A type's members - fields, methods, constructors, nested types, enum values - each with its declaration as the server shows it (types, return type, parameters, static, const, inline, virtual), modifiers and doc summary; inherited adds its base types' members. Example: code_members({\"symbol\": \"Ring\", \"inherited\": true})",
			CodeTargetSchema(", \"inherited\": {\"type\": \"boolean\"}, \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 300}").View(), false);
		members->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "List members of"); };
		members->m_Run = MembersRun;
		registry.Add(members);
		ToolSpec* type = CodeToolSpec("code_type_definition", "The type of a variable, parameter or expression at a place, and where that type is defined. Example: code_type_definition({\"path\": \"src/game.cf\", \"line\": 30, \"symbol\": \"ring\"})",
			CodeTargetSchema("").View(), true);
		type->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Find the type of"); };
		type->m_Run = [](const ToolInvocation& call) -> ToolOutcome { return PlacesRun(call, "code_type_definition", "textDocument/typeDefinition", "typeDefinitionProvider", "type definition", "type definitions"); };
		registry.Add(type);
		ToolSpec* implementations = CodeToolSpec("code_implementations", "What implements an interface, an abstract or virtual method. Example: code_implementations({\"symbol\": \"ISink::Write\"})",
			CodeTargetSchema("").View(), true);
		implementations->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Find implementations of"); };
		implementations->m_Run = [](const ToolInvocation& call) -> ToolOutcome { return PlacesRun(call, "code_implementations", "textDocument/implementation", "implementationProvider", "implementation", "implementations"); };
		registry.Add(implementations);
		ToolSpec* calls = CodeToolSpec("code_call_hierarchy", "Who calls a function (incoming) or what it calls (outgoing), as a tree with the lines of each call. Example: code_call_hierarchy({\"symbol\": \"Ring::Push\", \"direction\": \"incoming\", \"depth\": 2})",
			CodeTargetSchema(", \"direction\": {\"enum\": [\"incoming\", \"outgoing\"]}, \"depth\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 5}").View(), false);
		calls->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Call hierarchy of"); };
		calls->m_Run = CallHierarchyRun;
		registry.Add(calls);
		ToolSpec* types = CodeToolSpec("code_type_hierarchy", "A type's base types (supertypes) or derived types (subtypes), as a tree. Example: code_type_hierarchy({\"symbol\": \"FileSink\", \"direction\": \"supertypes\"})",
			CodeTargetSchema(", \"direction\": {\"enum\": [\"supertypes\", \"subtypes\"]}, \"depth\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 5}").View(), true);
		types->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Type hierarchy of"); };
		types->m_Run = TypeHierarchyRun;
		registry.Add(types);
		ToolSpec* macro = CodeToolSpec("code_expand_macro", "What a macro use expands to; without the server's expand request, its hover and definition. Example: code_expand_macro({\"path\": \"src/log.cf\", \"line\": 12, \"symbol\": \"LOG_INFO\"})",
			CodeTargetSchema("").View(), true);
		macro->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Expand"); };
		macro->m_Run = ExpandMacroRun;
		registry.Add(macro);
		ToolSpec* custom = CodeToolSpec("code_custom", "Call a request a language plugin exposes to the AI (its profile's aiExposedRequests; an unknown method is answered with the list). With line, the params get the position. Example: code_custom({\"method\": \"c4/expandMacro\", \"path\": \"src/a.cf\", \"line\": 4, \"column\": 9})",
			Core::StringView("{\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\", \"minLength\": 1}, \"path\": {\"type\": \"string\", \"minLength\": 1}, \"line\": {\"type\": \"integer\", \"minimum\": 1}, \"column\": {\"type\": \"integer\", \"minimum\": 1}, \"symbol\": {\"type\": \"string\"}, \"params\": {\"type\": \"object\"}}, \"required\": [\"method\", \"path\"], \"additionalProperties\": false}"),
			true);
		custom->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Ask the language server"); };
		custom->m_Run = CustomRun;
		registry.Add(custom);
	}
}
