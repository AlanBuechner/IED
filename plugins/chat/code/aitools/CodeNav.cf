include "api/Plugin.ch"
include "CodeNav.ch"

namespace Ai
{
	const int64 c_CodeCommentLinesMost = 30;
	const int64 c_CodeDeclarationLinesMost = 6;
	const int64 c_CodeBraceScanLines = 4000;

	// --- Shared by the code tools --------------------------------------------------------------------------------------

	ToolSpec* CodeToolSpec(const char* name, const char* description, Core::StringView parameters, bool deferred) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = ToolClass::Read;
		spec->m_ParallelSafe = true;
		spec->m_InPlan = true;
		spec->m_Deferred = deferred;
		if (deferred) spec->m_Group = Core::String("code");
		return spec;
	}

	ToolPlan CodePlan(const ToolInvocation& call, const char* verb) {
		Core::StringView named = call.m_Args.Member("symbol").AsView();
		if (named.IsEmpty()) named = call.m_Args.Member("path").AsView();
		if (named.IsEmpty()) named = call.m_Args.Member("query").AsView();
		ToolPlan plan;
		plan.m_Subject = (Core::String("code(") + named) + ")";
		plan.m_Summary = (Core::String(verb) + " ") + named;
		return plan;
	}

	// A comment line, or an annotation alone on its line (`[test("x")]`, `@Override`) - not a declaration that starts with
	// one (`[operator("create")] public void Init() {}`).
	static bool IsCommentLine(Core::StringView line) {
		Core::StringView text = line.Trimmed();
		if (text.StartsWith(Core::StringView("//")) || text.StartsWith(Core::StringView("/*")) || text.StartsWith(Core::StringView("*"))) return true;
		if (text.StartsWith(Core::StringView("[")) && text.EndsWith(Core::StringView("]"))) return true;
		return text.StartsWith(Core::StringView("@")) && !text.Contains(Core::StringView(" "));
	}

	int64 CommentStart(CodeQuery& query, Core::StringView path, int64 line) {
		int64 first = line;
		while (first > 0 && line - first < c_CodeCommentLinesMost && IsCommentLine(query.Line(path, first - 1))) first -= 1;
		return first;
	}

	static bool EndsDeclaration(Core::StringView line) {
		Core::StringView text = line.Trimmed();
		return text.Contains(Core::StringView("{")) || text.EndsWith(Core::StringView(";")) || text.EndsWith(Core::StringView(":"));
	}

	Core::String DeclarationLines(CodeQuery& query, const CodeSpan& range) {
		int64 last = range.m_StartLine;
		while (last < range.m_StartLine + c_CodeDeclarationLinesMost - 1 && !EndsDeclaration(query.Line(range.m_Path.View(), last)) && !query.Line(range.m_Path.View(), last + 1).IsEmpty()) last += 1;
		const int64 first = CommentStart(query, range.m_Path.View(), range.m_StartLine);
		return NumberedSpan(query.Text(range.m_Path.View()), first, last, c_CodeCommentLinesMost + c_CodeDeclarationLinesMost);
	}

	Core::String SymbolHeading(CodeQuery& query, const CodeSymbol* symbol) {
		Core::StringBuilder out;
		out.Append(SymbolKindName(symbol->m_Kind));
		out.Append(" ");
		out.Append(symbol->Qualified().View());
		if (!symbol->m_Detail.IsEmpty() && symbol->m_Detail.View() != SymbolKindName(symbol->m_Kind)) {
			out.Append(": ");
			out.Append(symbol->m_Detail.View());
		}
		out.Append(" - ");
		out.Append(query.Shown(symbol->m_Range.m_Path.View()).View());
		out.Append(symbol->m_Range.m_EndLine > symbol->m_Range.m_StartLine ? " lines " : " line ");
		out.Append(LinesOf(symbol->m_Range).View());
		return out.ToString();
	}

	Core::Array<CodeSpan> SpansOf(const CodeQuery& query, const Serialization::DomNode& answer, bool selection) {
		Core::Array<CodeSpan> spans;
		if (answer.Kind() == Serialization::DomKind::Object) spans.Push(query.SpanOf(answer, selection));
		for (int64 i = 0; answer.Kind() == Serialization::DomKind::Array && i < answer.Count(); ++i) spans.Push(query.SpanOf(answer.At(i), selection));
		return spans;
	}

	CodeSymbol* SymbolAt(CodeQuery& query, const CodeSpan& span) {
		try {
			return query.Enclosing(span.m_Path.View(), span.m_StartLine);
		}
		catch (IED::RpcError& error) {
			return nullptr;
		}
	}

	// --- code_symbols ------------------------------------------------------------------------------------------------------

	static void AppendOutline(Core::StringBuilder& out, const Core::Array<CodeSymbol*>& symbols, int64 depth, int64 most, int64& count) {
		for (CodeSymbol* symbol : symbols) {
			if (count >= c_CodeOutlineMost) return;
			for (int64 i = 0; i < depth; ++i) out.Append("  ");
			out.Append(SymbolKindName(symbol->m_Kind));
			out.Append(" ");
			out.Append(symbol->m_Name.View());
			if (!symbol->m_Detail.IsEmpty() && symbol->m_Detail.View() != SymbolKindName(symbol->m_Kind)) {
				out.Append(": ");
				out.Append(symbol->m_Detail.View());
			}
			out.Append("  [");
			out.Append(LinesOf(symbol->m_Range).View());
			out.Append("]\n");
			count += 1;
			if (depth + 1 < most) AppendOutline(out, symbol->m_Children, depth + 1, most, count);
		}
	}

	static int64 CountSymbols(const Core::Array<CodeSymbol*>& symbols) {
		int64 count = symbols.Count();
		for (CodeSymbol* symbol : symbols) count += CountSymbols(symbol->m_Children);
		return count;
	}

	static ToolOutcome OutlineRun(CodeQuery& query, Core::StringView path, int64 depth) {
		Core::Array<CodeSymbol*> symbols = query.Outline(path);
		const int64 total = CountSymbols(symbols);
		Core::StringBuilder out;
		out.Append(query.Shown(path).View());
		out.Append(": ");
		out.AppendInt(total);
		out.Append(total == 1 ? " symbol (lines in [])\n" : " symbols (lines in [])\n");
		int64 count = 0;
		AppendOutline(out, symbols, 0, depth, count);
		if (count < total) {
			out.Append("[");
			out.AppendInt(total - count);
			out.Append(" more not shown; give depth, or code_symbols with query]\n");
		}
		if (total == 0) out.Append("[the language server gives no symbols for this file]\n");
		Core::StringBuilder preview;
		preview.Append(query.Shown(path).View());
		preview.Append(": ");
		preview.AppendInt(total);
		preview.Append(" symbols");
		return ToolResult(out.View(), preview.View());
	}

	// Whether `symbol` is of the kind the model asked for ("class", "function", ...).
	static bool KindMatches(const CodeSymbol* symbol, Core::StringView kind) { return kind.IsEmpty() || Core::StringView(SymbolKindName(symbol->m_Kind)) == kind; }

	static Core::String Lower(Core::StringView text) {
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			const int32 c = text.ByteAt(i);
			out.AppendByte(c >= 'A' && c <= 'Z' ? c + 32 : c);
		}
		return out.ToString();
	}

	// How many of `words` the symbol's qualified name holds, ignoring case.
	static int64 WordsHeld(const CodeSymbol* symbol, const Core::Array<Core::String>& words) {
		Core::String name = Lower(symbol->Qualified().View());
		int64 held = 0;
		for (const Core::String& word : words)
			if (name.View().Contains(Lower(word.View()).View())) held += 1;
		return held;
	}

	// For a name nothing has ("LanguageServerPool", "language server pool"): the symbols named with its words, those
	// holding the most of them first; empty when it has no words but itself.
	// Only those holding the most words are kept, at most kCodeWordMatchesMost; `others` counts the rest.
	static Core::Array<CodeSymbol*> ByWords(CodeQuery& query, Core::StringView text, const Core::Array<Core::String>& words, int64& others) {
		Core::Array<CodeSymbol*> found;
		Core::Array<int64> held;
		others = 0;
		if (words.Count() < 2 && (words.IsEmpty() || words[0].View() == text)) return found;
		for (const Core::String& word : words)
			for (CodeSymbol* symbol : query.Search(word.View())) {
				bool seen = false;
				for (CodeSymbol* kept : found) seen = seen || (kept->Qualified() == symbol->Qualified() && kept->m_Selection.m_Path == symbol->m_Selection.m_Path && kept->m_Selection.m_StartLine == symbol->m_Selection.m_StartLine);
				if (seen) continue;
				const int64 score = WordsHeld(symbol, words);
				int64 at = found.Count();
				while (at > 0 && held[at - 1] < score) at -= 1;
				found.Insert(at, symbol);
				held.Insert(at, score);
			}
		int64 keep = 0;
		while (keep < found.Count() && keep < c_CodeWordMatchesMost && held[keep] == held[0]) keep += 1;
		others = found.Count() - keep;
		while (found.Count() > keep) found.RemoveAt(found.Count() - 1);
		return found;
	}

	// The one symbol named `text` among `shown` - declared and defined counts once, the definition then - or null when
	// none or several are.
	static const CodeSymbol* OnlyNamed(CodeQuery& query, const Core::Array<CodeSymbol*>& shown, Core::StringView text) {
		const CodeSymbol* only = nullptr;
		for (CodeSymbol* symbol : shown) {
			if (!QualifiedMatches(symbol->Qualified().View(), text)) continue;
			if (only && only->Qualified().View() != symbol->Qualified().View()) return nullptr;
			if (!only || (!HasBody(query, only) && HasBody(query, symbol))) only = symbol;
		}
		return only;
	}

	// A lone match's source when it is short, so searching for a function by name reads it too.
	static void AppendShortSource(Core::StringBuilder& out, CodeQuery& query, const CodeSymbol* symbol) {
		CodeSpan span = WholeSpan(query, symbol);
		if (span.m_EndLine - span.m_StartLine + 1 > c_CodeSearchSourceLines) return;
		out.Append("Its source, ");
		out.Append(query.Shown(span.m_Path.View()).View());
		out.Append(":\n");
		out.Append(NumberedSpan(query.Text(span.m_Path.View()), span.m_StartLine, span.m_EndLine, c_CodeSearchSourceLines).View());
	}

	static ToolOutcome SearchRun(CodeQuery& query, Core::StringView text, Core::StringView kind) {
		Core::Array<CodeSymbol*> found = query.Search(text);
		Core::Array<Core::String> words = NameWords(text);
		const bool byWords = found.IsEmpty();
		int64 others = 0;
		if (byWords) found = ByWords(query, text, words, others);
		Core::Array<CodeSymbol*> shown;
		for (int64 pass = 0; pass < 2; ++pass)
			for (CodeSymbol* symbol : found) {
				const bool exact = NameParts(symbol->m_Name.View()).Count() > 0 && NameParts(symbol->m_Name.View())[NameParts(symbol->m_Name.View()).Count() - 1].View() == text;
				if (KindMatches(symbol, kind) && exact == (pass == 0)) shown.Push(symbol);
			}
		Core::StringBuilder out;
		if (byWords && !shown.IsEmpty()) {
			out.Append("Nothing is named \"");
			out.Append(text);
			out.Append("\"; ");
			out.AppendInt(shown.Count());
			out.Append(" symbols are named with most of its words (");
			for (int64 i = 0; i < words.Count(); ++i) {
				if (i > 0) out.Append(", ");
				out.Append(words[i].View());
			}
			out.Append(")");
			if (others > 0) {
				out.Append("; ");
				out.AppendInt(others);
				out.Append(" more have fewer - a closer name narrows it");
			}
			out.Append(":\n");
		}
		else {
			out.AppendInt(shown.Count());
			out.Append(shown.Count() == 1 ? " symbol for \"" : " symbols for \"");
			out.Append(text);
			out.Append("\"\n");
		}
		for (int64 i = 0; i < shown.Count() && i < c_CodeOutlineMost; ++i) {
			out.Append(SymbolKindName(shown[i]->m_Kind));
			out.Append(" ");
			out.Append(shown[i]->Qualified().View());
			out.Append("  ");
			out.Append(WhereOf(shown[i]->m_Selection, query.Shown(shown[i]->m_Selection.m_Path.View()).View()).View());
			out.Append("\n");
		}
		if (shown.IsEmpty()) out.Append("[nothing; symbols are found by a part of their name as code writes it (\"Pool\", \"Serving\"); fs_glob finds files by name, search_text finds exact text such as a message]\n");
		const CodeSymbol* only = OnlyNamed(query, shown, text);
		if (only) AppendShortSource(out, query, only);
		Core::StringBuilder preview;
		preview.AppendInt(shown.Count());
		preview.Append(" symbols");
		return ToolResult(out.View(), preview.View());
	}

	static ToolOutcome SymbolsRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		Core::String path = query.FileOf(call.m_Args.Member("path").AsView());
		if (!path.IsEmpty() && FS::IsDirectory((FS::Path(call.m_Ws.m_Root.View()) / path.View()).CStr())) return ToolError((Core::String("code_symbols: ") + path.View() + " is a folder; give one of its files (fs_list lists them), or query to search by name").View());
		if (!path.IsEmpty()) return OutlineRun(query, path.View(), call.m_Args.Member("depth").IsValid() ? call.m_Args.Member("depth").AsInt() : 100);
		Core::StringView text = call.m_Args.Member("query").AsView();
		if (text.IsEmpty()) return ToolError(Core::StringView("code_symbols: give path (a file's outline) or query (symbols named like it across the workspace)"));
		return SearchRun(query, text, call.m_Args.Member("kind").AsView());
	}

	// --- code_read_symbol ----------------------------------------------------------------------------------------------------

	// The line of the brace that closes the first one opened at or after `line`, for a symbol whose server gave only its
	// name's line; `line` itself when it ends before opening one.
	static int64 BraceEnd(CodeQuery& query, Core::StringView path, int64 line) {
		int64 depth = 0;
		bool opened = false;
		const int64 lines = query.LineCount(path);
		for (int64 at = line; at < line + c_CodeBraceScanLines && at < lines; ++at) {
			Core::StringView text = query.Line(path, at);
			bool quoted = false;
			char8 quote = 0;
			for (int64 i = 0; i < text.ByteLength(); ++i) {
				const char8 c = (char8)text.ByteAt(i);
				if (quoted) {
					if (c == '\\') i += 1;
					else if (c == quote) quoted = false;
					continue;
				}
				if (c == '/' && i + 1 < text.ByteLength() && text.ByteAt(i + 1) == '/') break;
				if (c == '"' || c == '\'') {
					quoted = true;
					quote = c;
				}
				else if (c == ';' && !opened) return line;
				else if (c == '{') {
					depth += 1;
					opened = true;
				}
				else if (c == '}') {
					depth -= 1;
					if (opened && depth == 0) return at;
				}
			}
		}
		return line;
	}

	// The symbol's whole span: its range, the comment lines above it, and its body when the server named only its line.
	static CodeSpan WholeSpan(CodeQuery& query, const CodeSymbol* symbol) {
		CodeSpan span = symbol->m_Range;
		if (span.m_EndLine == span.m_StartLine) span.m_EndLine = BraceEnd(query, span.m_Path.View(), span.m_StartLine);
		span.m_StartLine = CommentStart(query, span.m_Path.View(), span.m_StartLine);
		return span;
	}

	// Whether the symbol has a body: a brace from its name to its end (a definition, not a declaration).
	static bool HasBody(CodeQuery& query, const CodeSymbol* symbol) {
		CodeSpan span = WholeSpan(query, symbol);
		for (int64 line = symbol->m_Selection.m_StartLine; line <= span.m_EndLine; ++line)
			if (query.Line(span.m_Path.View(), line).Contains(Core::StringView("{"))) return true;
		return false;
	}

	// The definition (with `declaration`, the declaration) the server knows of the first candidate, added when none of
	// them is one: a header's declaration finds its source's definition, a definition its declaration.
	static void AddCounterparts(CodeQuery& query, Core::Array<CodeSymbol*>& candidates, bool declaration) {
		for (CodeSymbol* symbol : candidates)
			if (HasBody(query, symbol) != declaration) return;
		CodeSymbol* first = candidates[0];
		if (declaration && !query.Offers(first->m_Selection.m_Path.View(), "declarationProvider")) return;
		Serialization::DomNode answer;
		try {
			answer = query.Request(first->m_Selection.m_Path.View(), Core::StringView(declaration ? "textDocument/declaration" : "textDocument/definition"), PositionParams(first->m_Selection, Core::StringView("")).View(), true);
		}
		catch (IED::RpcError& error) {
			return;
		}
		for (const CodeSpan& span : SpansOf(query, answer, true)) {
			CodeSymbol* found = SymbolAt(query, span);
			if (!found || found->m_Selection.m_StartLine != span.m_StartLine) continue;
			bool known = false;
			for (CodeSymbol* candidate : candidates) known = known || (candidate->m_Selection.m_Path == found->m_Selection.m_Path && candidate->m_Selection.m_StartLine == found->m_Selection.m_StartLine);
			if (!known) candidates.Push(found);
		}
	}

	static ToolOutcome ReadSymbolRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		Core::Array<CodeSymbol*> candidates = target.m_Symbols;
		if (candidates.IsEmpty()) {
			CodeSymbol* enclosing = query.Enclosing(target.m_At.m_Path.View(), target.m_At.m_StartLine);
			if (!enclosing) return ToolError((Core::String("code_read_symbol: no symbol of ") + target.m_Label.View() + " holds that line; fs_read reads it").View());
			candidates.Push(enclosing);
		}
		const bool declaration = call.m_Args.Member("declaration").AsBool();
		AddCounterparts(query, candidates, declaration);
		AddCounterparts(query, candidates, !declaration);
		Core::Array<CodeSymbol*> shown;
		Core::Array<CodeSymbol*> others;
		bool anyBody = false;
		for (CodeSymbol* symbol : candidates) anyBody = anyBody || HasBody(query, symbol);
		for (CodeSymbol* symbol : candidates) {
			if (!anyBody || HasBody(query, symbol) != declaration) shown.Push(symbol);
			else others.Push(symbol);
		}
		if (shown.IsEmpty()) shown = candidates;
		Core::StringBuilder out;
		int64 budget = c_CodeReadMostLines;
		for (CodeSymbol* symbol : shown) {
			CodeSpan span = WholeSpan(query, symbol);
			out.Append(SymbolHeading(query, symbol).View());
			out.Append("\n");
			out.Append(NumberedSpan(query.Text(span.m_Path.View()), span.m_StartLine, span.m_EndLine, budget > 0 ? budget : 1).View());
			budget -= span.m_EndLine - span.m_StartLine + 1;
			if (budget <= 0) break;
		}
		for (CodeSymbol* symbol : others) {
			out.Append(declaration ? "Defined at " : "Also declared at ");
			out.Append(WhereOf(symbol->m_Selection, query.Shown(symbol->m_Selection.m_Path.View()).View()).View());
			out.Append("\n");
		}
		Core::StringBuilder preview;
		preview.Append(target.m_Label.View());
		preview.Append(" (");
		preview.Append(query.Shown(shown[0]->m_Range.m_Path.View()).View());
		preview.Append(" ");
		preview.Append(LinesOf(WholeSpan(query, shown[0])).View());
		preview.Append(")");
		return ToolResult(out.View(), preview.View());
	}

	// --- code_definition -----------------------------------------------------------------------------------------------------

	void AppendPlace(Core::StringBuilder& out, CodeQuery& query, const CodeSpan& span) {
		CodeSymbol* symbol = SymbolAt(query, span);
		if (symbol && symbol->m_Range.m_StartLine <= span.m_StartLine && span.m_StartLine <= symbol->m_Selection.m_EndLine + 1) {
			out.Append(SymbolHeading(query, symbol).View());
			out.Append("\n");
			out.Append(DeclarationLines(query, symbol->m_Range).View());
			return;
		}
		out.Append(WhereOf(span, query.Shown(span.m_Path.View()).View()).View());
		out.Append("\n");
		out.Append(DeclarationLines(query, span).View());
	}

	static bool Listed(const Core::Array<CodeSpan>& spans, const CodeSpan& span) {
		for (const CodeSpan& known : spans)
			if (known.m_Path == span.m_Path && known.m_StartLine == span.m_StartLine) return true;
		return false;
	}

	static ToolOutcome DefinitionRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		Core::Array<CodeSpan> places;
		for (CodeSymbol* symbol : target.m_Symbols) places.Push(symbol->m_Selection);
		if (places.IsEmpty()) {
			Core::String asked = PositionParams(target.m_At, Core::StringView(""));
			for (const CodeSpan& span : SpansOf(query, query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/definition"), asked.View(), true), true)) places.Push(span);
			if (query.Offers(target.m_At.m_Path.View(), "declarationProvider"))
				for (const CodeSpan& span : SpansOf(query, query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/declaration"), asked.View(), true), true))
					if (!Listed(places, span)) places.Push(span);
		}
		if (places.IsEmpty()) return ToolError((Core::String("code_definition: the language server knows no definition of what is at ") + target.m_Label.View() + "; is a name there? code_hover says what it sees").View());
		Core::StringBuilder out;
		for (const CodeSpan& span : places) {
			AppendPlace(out, query, span);
			out.Append("\n");
		}
		Core::StringBuilder preview;
		preview.Append(target.m_Label.View());
		preview.Append(": ");
		preview.AppendInt(places.Count());
		preview.Append(places.Count() == 1 ? " place" : " places");
		return ToolResult(out.View(), preview.View());
	}

	// --- What a server may have missed ----------------------------------------------------------------------------------------

	Core::String TargetName(CodeQuery& query, const CodeTarget& target) {
		if (target.m_Symbols.IsEmpty()) return query.NameAt(target.m_At);
		Core::Array<Core::String> parts = NameParts(target.m_Symbols[0]->m_Name.View());
		return parts.IsEmpty() ? Core::String() : parts[parts.Count() - 1];
	}

	static bool IsNameByte(int32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }

	bool UsesAsCode(Core::StringView line, Core::StringView name) {
		Core::StringView text = line.Trimmed();
		if (text.StartsWith(Core::StringView("//")) || text.StartsWith(Core::StringView("/*")) || text.StartsWith(Core::StringView("*"))) return false;
		int64 at = 0;
		for (;;) {
			const int64 found = text.Substring(at, text.ByteLength() - at).IndexOf(name);
			if (found < 0) return false;
			const int64 start = at + found;
			const int64 end = start + name.ByteLength();
			at = end;
			if ((start > 0 && IsNameByte(text.ByteAt(start - 1))) || (end < text.ByteLength() && IsNameByte(text.ByteAt(end)))) continue;
			int64 quotes = 0;
			for (int64 i = 0; i < start; ++i)
				if (text.ByteAt(i) == '"' && (i == 0 || text.ByteAt(i - 1) != '\\')) quotes += 1;
			if (quotes % 2 == 1) continue;
			Core::StringView before = text.Substring(0, start).Trimmed();
			Core::StringView after = text.Substring(end, text.ByteLength() - end).Trimmed();
			if (after.StartsWith(Core::StringView("(")) || after.StartsWith(Core::StringView("<")) || after.StartsWith(Core::StringView("::"))) return true;
			if (before.EndsWith(Core::StringView(".")) || before.EndsWith(Core::StringView("->")) || before.EndsWith(Core::StringView("::"))) return true;
			if ((after.StartsWith(Core::StringView("*")) || after.StartsWith(Core::StringView("&"))) && after.ByteLength() > 1) {
				Core::StringView declared = after.Substring(1, after.ByteLength() - 1).Trimmed();
				if (declared.ByteLength() > 0 && IsNameByte(declared.ByteAt(0))) return true;
			}
		}
	}

	// The lines of the workspace's files that use `name` as code and `listed` leaves out; `truncated` when the search
	// stopped before the end.
	static Core::Array<IED::SearchMatch> UnlistedUses(CodeQuery& query, Core::StringView name, const Core::Array<CodeSpan>& listed, bool& truncated) {
		Core::Array<IED::SearchMatch> unlisted;
		IED::SearchQuery search;
		search.m_Text = (Core::String("\\b") + name) + "\\b";
		search.m_Regex = true;
		search.m_CaseSensitive = true;
		search.m_Exclude = IED::DefaultExcludes();
		search.m_UseIgnoreFiles = true;
		search.m_MaxResults = c_CodeUnlistedSearched;
		Threading::Atomic<bool> never;
		IED::SearchResult result;
		Core::String problem;
		truncated = false;
		if (!IED::Search(query.m_Ws, search, &never, result, problem)) return unlisted;
		truncated = result.m_Truncated;
		for (const IED::SearchMatch& match : result.m_Matches) {
			bool known = false;
			for (const CodeSpan& span : listed) known = known || (span.m_Path == match.m_Path && span.m_StartLine == match.m_Line);
			if (!known && UsesAsCode(match.m_Preview.View(), name)) unlisted.Push(match);
		}
		return unlisted;
	}

	// Whether symbols of more than one qualified name are named `name` (a declaration and its definition are one).
	static bool NamedBySeveral(CodeQuery& query, Core::StringView name) {
		Core::String first;
		for (CodeSymbol* symbol : query.Search(name)) {
			Core::Array<Core::String> parts = NameParts(symbol->m_Name.View());
			if (parts.IsEmpty() || parts[parts.Count() - 1].View() != name) continue;
			if (first.IsEmpty()) first = symbol->Qualified();
			else if (first.View() != symbol->Qualified().View()) return true;
		}
		return false;
	}

	void AppendUnlisted(Core::StringBuilder& out, CodeQuery& query, Core::StringView name, const Core::Array<CodeSpan>& listed) {
		if (name.ByteLength() < c_CodeUnlistedNameBytes) return;
		bool truncated = false;
		Core::Array<IED::SearchMatch> unlisted = UnlistedUses(query, name, listed, truncated);
		if (unlisted.IsEmpty()) return;
		const bool shared = NamedBySeveral(query, name);
		if (shared && (unlisted.Count() > c_CodeUnlistedMost || truncated)) {
			out.Append("[");
			out.AppendInt(unlisted.Count());
			out.Append(truncated ? "+ other lines use " : " other lines use ");
			out.Append(name);
			out.Append(" in code - a common name, other symbols' uses among them; search_text with a glob narrows them]\n");
			return;
		}
		out.Append("[the language server did not list these lines that use ");
		out.Append(name);
		out.Append(shared ? " - uses it can miss (through a pointer, a macro) or other symbols of that name; check them:]\n" : " - no other symbol has that name, so they are uses it missed:]\n");
		for (int64 i = 0; i < unlisted.Count() && i < c_CodeUnlistedShown; ++i) {
			out.Append("  ");
			out.Append(unlisted[i].m_Path.View());
			out.Append(":");
			out.AppendInt(unlisted[i].m_Line + 1);
			out.Append(": ");
			Core::StringView text = unlisted[i].m_Preview.View().Trimmed();
			out.Append(text.Substring(0, text.ByteLength() < c_CodeLineShownBytes ? text.ByteLength() : c_CodeLineShownBytes));
			out.Append("\n");
		}
		if (unlisted.Count() > c_CodeUnlistedShown) {
			out.Append("[");
			out.AppendInt(unlisted.Count() - c_CodeUnlistedShown);
			out.Append(" more; search_text for it lists them all]\n");
		}
	}

	// --- code_references -----------------------------------------------------------------------------------------------------

	static bool Before(const CodeSpan& a, const CodeSpan& b) { return a.m_Path < b.m_Path || (a.m_Path == b.m_Path && a.m_StartLine < b.m_StartLine); }

	static Core::Array<CodeSpan> Sorted(const Core::Array<CodeSpan>& spans) {
		Core::Array<CodeSpan> sorted;
		for (const CodeSpan& span : spans) {
			int64 at = sorted.Count();
			while (at > 0 && Before(span, sorted[at - 1])) at -= 1;
			sorted.Insert(at, span);
		}
		return sorted;
	}

	static int64 FileCount(const Core::Array<CodeSpan>& spans) {
		int64 files = 0;
		for (int64 i = 0; i < spans.Count(); ++i)
			if (i == 0 || spans[i].m_Path != spans[i - 1].m_Path) files += 1;
		return files;
	}

	static ToolOutcome ReferencesRun(const ToolInvocation& call) {
		CodeQuery query = CodeQuery(call.m_Ws);
		CodeTarget target = TargetOf(query, call.m_Args);
		int64 limit = call.m_Args.Member("limit").IsValid() ? call.m_Args.Member("limit").AsInt() : c_CodeReferencesDefault;
		limit = limit < 1 ? 1 : limit > c_CodeReferencesMost ? c_CodeReferencesMost : limit;
		const bool declaration = !call.m_Args.Member("include_declaration").IsValid() || call.m_Args.Member("include_declaration").AsBool();
		Core::String context = (Core::String("\"context\": {\"includeDeclaration\": ") + (declaration ? "true" : "false")) + "}";
		Core::String asked = PositionParams(target.m_At, context.View());
		Core::Array<CodeSpan> spans = Sorted(SpansOf(query, query.Request(target.m_At.m_Path.View(), Core::StringView("textDocument/references"), asked.View(), true), true));
		const int64 files = FileCount(spans);
		Core::StringBuilder out;
		out.AppendInt(spans.Count());
		out.Append(spans.Count() == 1 ? " reference to " : " references to ");
		out.Append(target.m_Label.View());
		out.Append(" in ");
		out.AppendInt(files);
		out.Append(files == 1 ? " file\n" : " files\n");
		for (int64 i = 0; i < spans.Count() && i < limit; ++i) {
			const CodeSpan& span = spans[i];
			if (i == 0 || span.m_Path != spans[i - 1].m_Path) {
				out.Append(query.Shown(span.m_Path.View()).View());
				out.Append("\n");
			}
			out.Append("  ");
			out.AppendInt(span.m_StartLine + 1);
			CodeSymbol* inside = files <= c_CodeReferenceFilesNamed ? SymbolAt(query, span) : nullptr;
			if (inside) {
				out.Append(" (in ");
				out.Append(inside->Qualified().View());
				out.Append(")");
			}
			out.Append(": ");
			Core::StringView line = query.Line(span.m_Path.View(), span.m_StartLine).Trimmed();
			out.Append(line.Substring(0, line.ByteLength() < c_CodeLineShownBytes ? line.ByteLength() : c_CodeLineShownBytes));
			out.Append("\n");
		}
		if (spans.Count() > limit) {
			out.Append("[");
			out.AppendInt(spans.Count() - limit);
			out.Append(" more; give a larger limit]\n");
		}
		if (spans.IsEmpty()) out.Append("[none from here: a language server may answer only from a place the name is used (path and line of a use)]\n");
		Core::Array<CodeSpan> listed = spans;
		for (CodeSymbol* symbol : target.m_Symbols) listed.Push(symbol->m_Selection);
		AppendUnlisted(out, query, TargetName(query, target).View(), listed);
		Core::StringBuilder preview;
		preview.AppendInt(spans.Count());
		preview.Append(" references in ");
		preview.AppendInt(files);
		preview.Append(files == 1 ? " file" : " files");
		return ToolResult(out.View(), preview.View());
	}

	// --- The tools ----------------------------------------------------------------------------------------------------------

	Core::String CodeTargetSchema(const char* more) {
		Core::StringBuilder out;
		out.Append("{\"type\": \"object\", \"properties\": {");
		out.Append(c_CodeTargetProperties);
		out.Append(more);
		out.Append("}, \"additionalProperties\": false}");
		return out.ToString();
	}

	void AddCodeNavTools(ToolRegistry& registry) {
		ToolSpec* symbols = CodeToolSpec("code_symbols", "A file's symbols as a tree with kinds, signatures and line ranges (path), or the workspace's symbols named like query (the only one, when short, with its source), from the language servers. Read code by symbol, not whole files. Example: code_symbols({\"path\": \"src/ring.cf\"}) or code_symbols({\"query\": \"Push\", \"kind\": \"method\"})",
			Core::StringView("{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"query\": {\"type\": \"string\", \"minLength\": 1}, \"kind\": {\"type\": \"string\", \"description\": \"only symbols of this kind: class, method, function, field, variable, enum, ...\"}, \"depth\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"levels of an outline\"}}, \"additionalProperties\": false}"),
			false);
		symbols->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "List symbols of"); };
		symbols->m_Run = SymbolsRun;
		registry.Add(symbols);
		ToolSpec* read = CodeToolSpec("code_read_symbol", "The whole source of one symbol - a function with its body, a type with its members, a macro - numbered, with the comment above it; a definition before its declaration. Example: code_read_symbol({\"symbol\": \"Ring::Push\"}) or code_read_symbol({\"path\": \"src/ring.cf\", \"line\": 120})",
			CodeTargetSchema(", \"declaration\": {\"type\": \"boolean\", \"description\": \"the declaration (a header's) instead of the definition\"}").View(), false);
		read->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Read"); };
		read->m_Run = ReadSymbolRun;
		registry.Add(read);
		ToolSpec* definition = CodeToolSpec("code_definition", "Where a symbol, or the name at a place, is defined and declared, with its first lines. Example: code_definition({\"path\": \"src/game.cf\", \"line\": 44, \"symbol\": \"Push\"})",
			CodeTargetSchema("").View(), false);
		definition->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Find the definition of"); };
		definition->m_Run = DefinitionRun;
		registry.Add(definition);
		ToolSpec* references = CodeToolSpec("code_references", "Every use of a symbol, by file, each line with the function it is in. Example: code_references({\"symbol\": \"Ring::Push\", \"limit\": 50})",
			CodeTargetSchema(", \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 500}, \"include_declaration\": {\"type\": \"boolean\"}").View(), false);
		references->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return CodePlan(call, "Find references to"); };
		references->m_Run = ReferencesRun;
		registry.Add(references);
	}
}
