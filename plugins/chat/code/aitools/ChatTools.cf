include "api/Plugin.ch"
include "ChatTools.ch"
include "chats/Pages.ch"
include "chats/Replies.ch"

namespace Ai
{
	const int64 c_ChatWaitPollNs = 250000000;
	const int64 c_ChatLineBytes = 160;

	Core::String AnswerOf(const Turn* turn) { return turn->Answer(); }

	bool WaitInterrupted(const Chat* chat) { return chat && !chat->m_Pending.IsEmpty(); }

	static Core::StringView FirstLine(Core::StringView text) {
		int64 end = text.IndexOf('\n', 0);
		if (end < 0) end = text.ByteLength();
		return text.Substring(0, end < c_ChatLineBytes ? end : c_ChatLineBytes);
	}

	// The workspace's chat of that id, or null with why there is none.
	static Chat* Named(Chats* chats, const IED::Workspace& ws, Core::StringView id, Core::String& problem) {
		for (Chat* each : chats->InWorkspace(ws.m_Id.View()))
			if (each->m_ChatId.View() == id) return each;
		problem = (Core::String("there is no chat ") + id) + " in this workspace; chat_list lists them";
		return nullptr;
	}

	static void Describe(Core::StringBuilder& out, const Chat* chat) {
		out.Append(chat->m_ChatId.View());
		out.Append(" \"");
		out.Append(chat->m_Title.View());
		out.Append("\" (");
		out.Append(ChatModeName(chat->m_Mode));
		out.Append(", ");
		out.Append(ChatStateName(chat->m_State));
		out.Append(", ");
		out.AppendInt(chat->TurnCount());
		out.Append(chat->TurnCount() == 1 ? " turn)" : " turns)");
	}

	// The hops of a message this chat sends now: one more than the turn it is in got.
	static int64 NextHops(const Chat* self) { return self->Current() ? self->Current()->m_Hops + 1 : 1; }

	Core::String ChainNote(int64 hops) {
		Core::StringBuilder out;
		out.Append("message ");
		out.AppendInt(hops);
		out.Append(" of at most ");
		out.AppendInt(c_ChatHopsMost);
		out.Append(" in a row between chats (the owner's next message starts the count again)");
		return out.ToString();
	}

	Core::String SentNote(int64 hops) {
		Core::StringBuilder out;
		out.Append(ChainNote(hops).View());
		if (!CanAnswer(hops)) out.Append(" - the last: it cannot chat_send an answer back to this chat, so do not ask it to; read what it did with chat_wait or chat_read");
		return out.ToString();
	}

	static Core::String TooDeep() {
		Core::StringBuilder out;
		out.Append("chats have messaged each other ");
		out.AppendInt(c_ChatHopsMost);
		out.Append(" times in a row; answer here instead of sending another");
		return out.ToString();
	}

	// --- The tools ---------------------------------------------------------------------------------------------------------

	static ToolOutcome ListRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		Core::StringBuilder out;
		int64 count = 0;
		for (Chat* each : chats->InWorkspace(call.m_Ws.m_Id.View())) {
			Describe(out, each);
			if (each == self) out.Append(" - this chat");
			if (each->m_State == ChatState::Suspended) {
				out.Append(" - suspended: ");
				out.Append(each->m_StateReason.View());
			}
			if (DebtTo(each, self->m_ChatId.View())) out.Append(" - owes this chat a reply");
			if (DebtTo(self, each->m_ChatId.View())) out.Append(" - this chat owes it a reply");
			Core::String answer = each->LastAnswerLine();
			if (!answer.IsEmpty()) {
				out.Append(": ");
				out.Append(FirstLine(answer.View()));
			}
			out.Append("\n");
			count += 1;
		}
		Core::StringBuilder preview;
		preview.AppendInt(count);
		preview.Append(count == 1 ? " chat" : " chats");
		return ToolResult(out.View(), preview.View());
	}

	static ToolOutcome ReadRun(Chats* chats, const ToolInvocation& call) {
		int64 most = call.m_Args.Member("turns").IsValid() ? call.m_Args.Member("turns").AsInt() : 1;
		most = most < 1 ? 1 : most > c_ChatReadTurnsMost ? c_ChatReadTurnsMost : most;
		IED::HostLock guard(*call.m_Context);
		Core::String problem;
		Chat* chat = Named(chats, call.m_Ws, call.m_Args.Member("chat").AsView(), problem);
		if (!chat) return ToolError((Core::String("chat_read: ") + problem.View()).View());
		Core::StringBuilder out;
		Describe(out, chat);
		out.Append("\n");
		for (const Turn* turn : LastTurnsWhole(LocalStateOf(call.m_Ws), chat, most)) {
			out.Append("\n## Turn ");
			out.Append(turn->m_TurnId.View());
			out.Append((turn->m_Stop.IsEmpty() ? Core::String(" (running)") : (Core::String(" (") + turn->m_Stop.View()) + ")").View());
			out.Append("\nMessage: ");
			out.Append(turn->m_UserText.View());
			Core::String answer = AnswerOf(turn);
			out.Append("\nAnswer: ");
			out.Append(answer.IsEmpty() ? Core::StringView("(none yet)") : answer.View());
			out.Append("\n");
		}
		return ToolResult(out.View(), (Core::String("Read ") + chat->m_Title.View()).View());
	}

	// What a send that requires a reply tells its sender.
	static void AppendRequired(Core::StringBuilder& said, int64 hops) {
		said.Append(" It owes this chat a reply now: its finish waits for it, and if its turn ends without one IED tells this chat. Suspend to wait for it (it wakes this chat), or chat_wait. It is ");
		said.Append(ChainNote(hops).View());
		said.Append(", and its reply is outside that count.");
	}

	static ToolOutcome SendRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		Core::String problem;
		Chat* chat = Named(chats, call.m_Ws, call.m_Args.Member("chat").AsView(), problem);
		if (!chat) return ToolError((Core::String("chat_send: ") + problem.View()).View());
		if (chat == self) return ToolError(Core::StringView("chat_send: that is this chat"));
		const bool requires = call.m_Args.Member("require_reply").AsBool();
		// Any message to a chat this one owes pays the debt: the other chat is woken by it. One that asks nothing back is the
		// reply, outside the chain's cut with the hops of the request it answers; one that requires a reply is a question
		// back, counted as any message is.
		ReplyOwed* debt = DebtTo(self, chat->m_ChatId.View());
		const bool answers = debt && !requires;
		const bool questionBack = debt && requires && !debt->m_Question;
		const int64 hops = answers ? debt->m_Hops : NextHops(self);
		if (hops > c_ChatHopsMost) {
			Core::String deep = (Core::String("chat_send: ") + TooDeep().View());
			if (debt) deep = deep + "; send your reply without require_reply: a reply is outside the count";
			return ToolError(deep.View());
		}
		if (debt) chats->Pay(self, chat->m_ChatId.View());
		if (requires) chats->Owe(chat, self, hops, questionBack);
		const bool started = chats->Deliver(chat, call.m_Args.Member("text").AsView(), self, hops, requires ? "required" : answers ? "answer" : "");
		Core::StringBuilder said;
		said.Append(answers ? "Sent your reply to " : "Sent to ");
		Describe(said, chat);
		said.Append(started ? ": it started a turn for it." : ": its running turn gets it at its next step.");
		if (answers) said.Append(" You no longer owe it a reply.");
		else if (debt) said.Append(" It also pays the reply you owed it; once it answers your question, you owe it the reply again.");
		if (requires) AppendRequired(said, hops);
		else if (!answers) {
			said.Append(" chat_wait returns its answer. It is ");
			said.Append(SentNote(hops).View());
			said.Append(".");
		}
		if (!self->m_Owes.IsEmpty()) {
			said.Append("\nThis chat still owes a reply to:\n");
			said.Append(ReplyLines(self->m_Owes, ChatNowMs()).View());
		}
		return ToolResult(said.View(), ((answers ? Core::String("Replied to ") : Core::String("Sent to ")) + chat->m_Title.View()).View());
	}

	static ToolOutcome CreateRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		IED::HostLock guard(*call.m_Context);
		const int64 hops = NextHops(self);
		if (hops > c_ChatHopsMost) return ToolError((Core::String("chat_create: ") + TooDeep().View()).View());
		ChatMode mode = self->m_Mode;
		if (call.m_Args.Member("mode").IsValid() && !ReadChatMode(call.m_Args.Member("mode").AsView(), mode)) return ToolError(Core::StringView("chat_create: mode must be ask, plan or agent"));
		Core::StringView title = call.m_Args.Member("title").AsView();
		Core::StringView model = call.m_Args.Member("model").AsView();
		Core::Array<Core::String> problems;
		if (!model.IsEmpty() && !FindModel(ReadModels(call.m_Context->Setting(Core::StringView("ai.models"), WsId(call.m_Ws)).View(), problems), model))
			return ToolError(((Core::String("chat_create: there is no model ") + model) + " in ai.models; ai_usage lists them").View());
		Chat* made = chats->Create(call.m_Ws, title.IsEmpty() ? Core::StringView(c_NewChatTitle) : title, mode, self->m_Group.View());
		made->m_PinnedModel = model.IsEmpty() ? self->m_PinnedModel : Core::String(model);
		const bool requires = call.m_Args.Member("require_reply").AsBool();
		if (requires) chats->Owe(made, self, hops, false);
		chats->Deliver(made, call.m_Args.Member("text").AsView(), self, hops, requires ? "required" : "");
		Core::StringBuilder said;
		said.Append("Started ");
		Describe(said, made);
		if (requires) {
			said.Append(". chat_send tells it more.");
			AppendRequired(said, hops);
		}
		else {
			said.Append(". chat_wait returns its answer; chat_send tells it more. Its task is ");
			said.Append(SentNote(hops).View());
			said.Append(".");
		}
		return ToolResult(said.View(), (Core::String("Started ") + made->m_Title.View()).View());
	}

	static ToolOutcome WaitRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		int64 seconds = call.m_Args.Member("seconds").IsValid() ? call.m_Args.Member("seconds").AsInt() : c_ChatWaitDefaultSeconds;
		seconds = seconds < 1 ? 1 : seconds > c_ChatWaitMostSeconds ? c_ChatWaitMostSeconds : seconds;
		const int64 deadline = Platform::UnixTimeNs() + seconds * 1000000000;
		for (;;) {
			{
				IED::HostLock guard(*call.m_Context);
				Core::String problem;
				Chat* chat = Named(chats, call.m_Ws, call.m_Args.Member("chat").AsView(), problem);
				if (!chat) return ToolError((Core::String("chat_wait: ") + problem.View()).View());
				Core::Array<Turn*> lastTurns = chat->m_Run ? Core::Array<Turn*>() : LastTurnsWhole(LocalStateOf(call.m_Ws), chat, 1);
				const Turn* last = lastTurns.IsEmpty() ? nullptr : lastTurns[0];
				if (!chat->m_Run && last) {
					Core::StringBuilder said;
					Describe(said, chat);
					said.Append(", its last turn ");
					said.Append(last->m_Stop.View());
					if (chat->m_State == ChatState::Suspended) {
						said.Append(" (");
						said.Append(chat->m_StateReason.View());
						said.Append(")");
					}
					said.Append(":\n\n");
					Core::String answer = AnswerOf(last);
					said.Append(answer.IsEmpty() ? Core::StringView("(no answer)") : answer.View());
					return ToolResult(said.View(), (Core::String("Answer from ") + chat->m_Title.View()).View());
				}
				// A message for this turn - the owner's, or another chat's - stops the wait (docs/04 "Chats waiting on each
				// other"); the chat waited on goes on.
				if (WaitInterrupted(self)) {
					Core::StringBuilder said;
					said.Append("Stopped waiting for ");
					Describe(said, chat);
					said.Append(": a message came for this turn, and it follows now. That chat goes on; chat_wait again to wait more, or chat_read what it has so far.");
					return ToolResult(said.View(), Core::StringView("Stopped waiting: a message came"));
				}
			}
			if (call.m_Cancelled && *call.m_Cancelled) return ToolError(Core::StringView("chat_wait: stopped"));
			// Running past the wait is an answer, not a failure: the other chat may reply by message meanwhile.
			if (Platform::UnixTimeNs() >= deadline) {
				Core::StringBuilder said;
				said.Append("The chat is still running after ");
				said.AppendInt(seconds);
				said.Append(" s (its messages to this chat arrive as they are sent); wait again, or chat_read what it has so far.");
				return ToolResult(said.View(), Core::StringView("Still running"));
			}
			Threading::Thread::Sleep(c_ChatWaitPollNs);
		}
	}

	static ToolOutcome TitleRun(Chats* chats, Chat* self, const ToolInvocation& call) {
		Core::StringView title = call.m_Args.Member("title").AsView();
		if (title.Trimmed().IsEmpty()) return ToolError(Core::StringView("chat_title: the title is empty"));
		IED::HostLock guard(*call.m_Context);
		const bool named = chats->NameByAi(self, title);
		Core::StringBuilder said;
		said.Append(named ? "This chat is now named \"" : "This chat keeps the name it was given: \"");
		said.Append(self->m_Title.View());
		said.Append("\".");
		return ToolResult(said.View(), self->m_Title.View());
	}

	// --- The group ---------------------------------------------------------------------------------------------------------

	static ToolPlan ChatPlan(const ToolInvocation& call, const char* kind) {
		ToolPlan plan;
		Core::StringView id = call.m_Args.Member("chat").AsView();
		plan.m_Subject = ((Core::String(kind) + "(") + (id.IsEmpty() ? Core::StringView("*") : id)) + ")";
		plan.m_Summary = Core::String(kind) + (id.IsEmpty() ? Core::String() : Core::String(" ") + id);
		return plan;
	}

	static ToolSpec* ChatTool(const char* name, const char* description, const char* parameters, ToolClass toolClass) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = toolClass;
		spec->m_ParallelSafe = toolClass == ToolClass::Read;
		spec->m_InPlan = toolClass == ToolClass::Read;
		spec->m_Deferred = true;
		spec->m_Group = Core::String("chats");
		return spec;
	}

	void AddChatTools(ToolRegistry& registry, Chats* chats, Chat* chat) {
		ToolSpec* list = ChatTool("chat_list", "The chats of this workspace: id, title, mode, state and the first line of each one's last answer.",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read);
		list->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.read"); };
		list->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return ListRun(chats, chat, call); };
		registry.Add(list);
		ToolSpec* read = ChatTool("chat_read", "Another chat's last turns: each message and its answer, without the tool calls. Example: chat_read({\"chat\": \"c18f2a\", \"turns\": 2})",
			"{\"type\": \"object\", \"properties\": {\"chat\": {\"type\": \"string\", \"minLength\": 1}, \"turns\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 5}}, \"required\": [\"chat\"], \"additionalProperties\": false}", ToolClass::Read);
		read->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.read"); };
		read->m_Run = [chats](const ToolInvocation& call) -> ToolOutcome { return ReadRun(chats, call); };
		registry.Add(read);
		ToolSpec* send = ChatTool("chat_send", "Send another chat a message: it starts a turn there, or reaches its running turn at the next step. It is told this chat sent it, and can answer with chat_send. Chats reply to each other at most 3 times in a row, counting the other chat's messages to this one too (an owner's message starts the count again): send only what the other chat needs, in as few messages as you can, and once it is told, answer the owner - what is left goes in your answer. require_reply: the other chat owes this one a reply - it cannot finish before it sends one, and IED tells this chat if its turn ends without one - so this chat can suspend until it comes. A message to a chat that required your reply is that reply (outside the count of 3). Example: chat_send({\"chat\": \"c18f2a\", \"text\": \"Port Ring.h and its tests, then tell me what changed.\", \"require_reply\": true})",
			"{\"type\": \"object\", \"properties\": {\"chat\": {\"type\": \"string\", \"minLength\": 1}, \"text\": {\"type\": \"string\", \"minLength\": 1}, \"require_reply\": {\"type\": \"boolean\"}}, \"required\": [\"chat\", \"text\"], \"additionalProperties\": false}", ToolClass::Exec);
		send->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.send"); };
		send->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return SendRun(chats, chat, call); };
		registry.Add(send);
		ToolSpec* create = ChatTool("chat_create", "Start a new chat in this workspace with a message, to hand it part of the work. It uses this chat's model, or `model` (one of ai.models: a cheaper one for routine work stretches Claude's usage). Its message counts in this chat's chain of chats messaging each other (chat_send says how): started from a turn another chat's message began, it may be the chain's last, and then it cannot message this chat back - the result says so - unless require_reply: then it owes this chat a reply, which it can always send, cannot finish before it does, and this chat can suspend until it comes. Example: chat_create({\"title\": \"Port Ring.h\", \"text\": \"Port src/Ring.h to C4 and its tests.\", \"mode\": \"agent\", \"model\": \"claude-sonnet\", \"require_reply\": true})",
			"{\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\", \"minLength\": 1}, \"title\": {\"type\": \"string\"}, \"mode\": {\"enum\": [\"ask\", \"plan\", \"agent\"]}, \"model\": {\"type\": \"string\"}, \"require_reply\": {\"type\": \"boolean\"}}, \"required\": [\"text\"], \"additionalProperties\": false}", ToolClass::Exec);
		create->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.create"); };
		create->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return CreateRun(chats, chat, call); };
		registry.Add(create);
		ToolSpec* wait = ChatTool("chat_wait", "Wait until another chat's turn ends and get its answer (at most 600 s; default 120). A message for this turn stops the wait at once. To wait longer for a reply you required, suspend instead. Example: chat_wait({\"chat\": \"c18f2a\", \"seconds\": 300})",
			"{\"type\": \"object\", \"properties\": {\"chat\": {\"type\": \"string\", \"minLength\": 1}, \"seconds\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 600}}, \"required\": [\"chat\"], \"additionalProperties\": false}", ToolClass::Read);
		wait->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.read"); };
		wait->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return WaitRun(chats, chat, call); };
		registry.Add(wait);
		// Not deferred and allowed in every mode: a chat with no name is asked for one with the first message of a turn.
		ToolSpec* title = ChatTool("chat_title", "Name this chat: 3 to 6 words on what the work is, shown on its tab and in the chats list so the owner can find it. Call it when a note says the chat has no name, along with your first other calls; again only if the work becomes something else. A name someone else chose stays. Example: chat_title({\"title\": \"Fix edit mode wireframe clipping\"})",
			"{\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\", \"minLength\": 1}}, \"required\": [\"title\"], \"additionalProperties\": false}", ToolClass::Meta);
		title->m_Deferred = false;
		title->m_InPlan = true;
		title->m_ParallelSafe = true;
		title->m_Plan = [](const ToolInvocation& call) -> ToolPlan { return ChatPlan(call, "chat.title"); };
		title->m_Run = [chats, chat](const ToolInvocation& call) -> ToolOutcome { return TitleRun(chats, chat, call); };
		registry.Add(title);
	}
}
