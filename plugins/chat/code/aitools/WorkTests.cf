// search_text's listing (docs/13 T-SRCH-1): a file's path once with its lines under it, a long line cut where a
// character starts, and what it says when it stopped early or found nothing; the skipped folders a path searches whole,
// and its errors.

include "Work.ch"

static IED::SearchMatch Match(const char* path, int64 line, Core::StringView preview) {
	IED::SearchMatch match;
	match.m_Path = Core::String(path);
	match.m_Line = line;
	match.m_Preview = Core::String(preview);
	return match;
}

static Core::String Repeated(char c, int64 count) {
	Core::StringBuilder out;
	for (int64 i = 0; i < count; ++i) out.AppendByte(c);
	return Core::String(out.View());
}

[test("server.ai.work")]
class WorkToolsTests {
	[test("search_listing")]
	public static void TestSearchListing() {
		IED::SearchResult result;
		result.m_Matches.Push(Match("src/a.cf", 4, Core::StringView("\tPush(1);  ")));
		result.m_Matches.Push(Match("src/a.cf", 9, Core::StringView("Push(2);")));
		result.m_Matches.Push(Match("src/b.cf", 0, Core::StringView("Push(3);")));
		assert_se("src/a.cf\n  5: Push(1);\n  10: Push(2);\nsrc/b.cf\n  1: Push(3);\n", Ai::SearchListing(result).CStr(), "a file's path once, its trimmed lines under it");

		result.m_Truncated = true;
		assert_true(Ai::SearchListing(result).View().EndsWith(Core::StringView("[stopped at 100 matches; narrow the pattern or add a glob]\n")), "it says where it stopped");

		Core::String prefix = Repeated('x', Ai::c_SearchLineShownBytes - 1);
		IED::SearchResult wide;
		wide.m_Matches.Push(Match("w.txt", 0, (prefix + "\xC3\xA9 and more").View()));
		assert_se((Core::String("w.txt\n  1: ") + prefix.View() + "...\n").CStr(), Ai::SearchListing(wide).CStr(), "a long line is cut before the character it would split");
		wide.m_Matches[0].m_Preview = prefix + Core::StringView("y");
		assert_se((Core::String("w.txt\n  1: ") + prefix.View() + "y\n").CStr(), Ai::SearchListing(wide).CStr(), "a line of exactly the limit is whole");

		IED::SearchResult none;
		assert_true(Ai::SearchListing(none).View().StartsWith(Core::StringView("[no matches;")), "nothing matched");

		IED::SearchResult big;
		big.m_TooLarge.Push(Core::String("Content/Scenes/Valley.cscene"));
		Core::String said = Ai::SearchListing(big);
		assert_true(said.View().StartsWith(Core::StringView("[no matches in the files searched; 1 file was not searched, over 4 MB: Content/Scenes/Valley.cscene")), "a file passed over for its size is named");
		assert_true(said.View().Contains(Core::StringView("findstr")), "with how to search it");
	}

	[test("search_in_skipped_folders")]
	public static void TestSearchInSkippedFolders() {
		assert_true(Ai::InExcludedFolder(Core::StringView("build")) && Ai::InExcludedFolder(Core::StringView("build/int/Rhi/tests")), "build output, and a folder in it");
		assert_true(Ai::InExcludedFolder(Core::StringView("web/node_modules/x")) && Ai::InExcludedFolder(Core::StringView(".git")), "any folder search skips");
		assert_true(!Ai::InExcludedFolder(Core::StringView("")) && !Ai::InExcludedFolder(Core::StringView("src/builder")) && !Ai::InExcludedFolder(Core::StringView("Packages/Renderer")), "not the root, nor folders named like them");
	}

	[test("search_problem")]
	public static void TestSearchProblem() {
		Core::String broken = Ai::SearchProblem(Core::StringView("the pattern is not a valid regex: a '(' that is never closed"), true);
		assert_true(broken.View().StartsWith(Core::StringView("search_text: the pattern is not a valid regex")) && broken.View().Contains(Core::StringView("put a backslash before it")), "a broken regex says how to match ( as text");
		assert_se("search_text: no folder x", Ai::SearchProblem(Core::StringView("no folder x"), true).CStr(), "another problem as it is");
	}
}
