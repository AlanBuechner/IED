// search_text's listing (docs/13 T-SRCH-1): a file's path once with its lines under it, a long line cut where a
// character starts, and what it says when it stopped early or found nothing; the skipped folders a path searches whole,
// and its errors.

include "Work.ch"

static IED::SearchMatch Match(const char* path, int64 line, Core::StringView preview) {
	IED::SearchMatch match;
	match.m_Path = Core::String(path);
	match.m_Line = line;
	match.m_Preview = Core::String(preview);
	return match;
}

static Core::String Repeated(char c, int64 count) {
	Core::StringBuilder out;
	for (int64 i = 0; i < count; ++i) out.AppendByte(c);
	return Core::String(out.View());
}

[test("server.ai.work")]
class WorkToolsTests {
	[test("search_listing")]
	public static void TestSearchListing() {
		IED::SearchResult result;
		result.m_Matches.Push(Match("src/a.cf", 4, Core::StringView("\tPush(1);  ")));
		result.m_Matches.Push(Match("src/a.cf", 9, Core::StringView("Push(2);")));
		result.m_Matches.Push(Match("src/b.cf", 0, Core::StringView("Push(3);")));
		assert_se("src/a.cf\n  5: Push(1);\n  10: Push(2);\nsrc/b.cf\n  1: Push(3);\n", Ai::SearchListing(result).CStr(), "a file's path once, its trimmed lines under it");

		result.m_Truncated = true;
		assert_true(Ai::SearchListing(result).View().EndsWith(Core::StringView("[stopped at 100 matches; narrow the pattern or add a glob]\n")), "it says where it stopped");

		Core::String prefix = Repeated('x', Ai::c_SearchLineShownBytes - 1);
		IED::SearchResult wide;
		wide.m_Matches.Push(Match("w.txt", 0, (prefix + "\xC3\xA9 and more").View()));
		assert_se((Core::String("w.txt\n  1: ") + prefix.View() + "...\n").CStr(), Ai::SearchListing(wide).CStr(), "a long line is cut before the character it would split");
		wide.m_Matches[0].m_Preview = prefix + Core::StringView("y");
		assert_se((Core::String("w.txt\n  1: ") + prefix.View() + "y\n").CStr(), Ai::SearchListing(wide).CStr(), "a line of exactly the limit is whole");

		IED::SearchResult none;
		assert_true(Ai::SearchListing(none).View().StartsWith(Core::StringView("[no matches;")), "nothing matched");

		IED::SearchResult big;
		big.m_TooLarge.Push(Core::String("Content/Scenes/Valley.cscene"));
		Core::String said = Ai::SearchListing(big);
		assert_true(said.View().StartsWith(Core::StringView("[no matches in the files searched; 1 file was not searched, over 4 MB: Content/Scenes/Valley.cscene")), "a file passed over for its size is named");
		assert_true(said.View().Contains(Core::StringView("findstr")), "with how to search it");
	}

	[test("search_in_skipped_folders")]
	public static void TestSearchInSkippedFolders() {
		assert_true(Ai::InExcludedFolder(Core::StringView("build")) && Ai::InExcludedFolder(Core::StringView("build/int/Rhi/tests")), "build output, and a folder in it");
		assert_true(Ai::InExcludedFolder(Core::StringView("web/node_modules/x")) && Ai::InExcludedFolder(Core::StringView(".git")), "any folder search skips");
		assert_true(!Ai::InExcludedFolder(Core::StringView("")) && !Ai::InExcludedFolder(Core::StringView("src/builder")) && !Ai::InExcludedFolder(Core::StringView("Packages/Renderer")), "not the root, nor folders named like them");
	}

	[test("search_scope_of_a_folder_or_a_file")]
	public static void TestSearchScope() {
		Ai::SearchScope folder = Ai::ScopeOfSearch(Core::StringView("src"), Core::StringView("*.cf"), false);
		assert_true(folder.m_Alone.IsEmpty() && folder.m_Glob == "src/*.cf", "a folder: its glob under it, the workspace as edited");
		Ai::SearchScope whole = Ai::ScopeOfSearch(Core::StringView("src"), Core::StringView(""), false);
		assert_se("src/**", whole.m_Glob.CStr(), "without a glob, all of it");
		assert_true(folder.m_File.IsEmpty() && whole.m_File.IsEmpty(), "a folder is no file");
		Ai::SearchScope file = Ai::ScopeOfSearch(Core::StringView("src/a.cf"), Core::StringView("*.ch"), true);
		assert_true(file.m_File == "src/a.cf" && file.m_Alone.IsEmpty() && file.m_Glob.IsEmpty(), "a file: that file alone, the glob left out");
		Ai::SearchScope ignored = Ai::ScopeOfSearch(Core::StringView(".ied/local/check/full-test.log"), Core::StringView(""), true);
		assert_se(".ied/local/check/full-test.log", ignored.m_File.CStr(), "an ignored file named alone is searched all the same");
		Ai::SearchScope sourceBuild = Ai::ScopeOfSearch(Core::StringView("Plugins/WorldPartition/src/WorldPartition"), Core::StringView(""), false);
		assert_true(sourceBuild.m_Alone.IsEmpty() && sourceBuild.m_Glob == "Plugins/WorldPartition/src/WorldPartition/**", "a source folder holding a Build folder is searched through the workspace's ignore rules, which re-include it");
		Ai::SearchScope built = Ai::ScopeOfSearch(Core::StringView("build/int/Rhi/tests/results.json"), Core::StringView(""), true);
		assert_true(built.m_File == "build/int/Rhi/tests/results.json" && built.m_Alone.IsEmpty(), "and one in a skipped folder");
		Ai::SearchScope skipped = Ai::ScopeOfSearch(Core::StringView("build/int"), Core::StringView("**/*.json"), false);
		assert_true(skipped.m_Alone == "build/int" && skipped.m_Glob == "**/*.json", "a skipped folder: whole, its glob relative to it");
	}

	[test("search_one_files_text")]
	public static void TestSearchFileText() {
		IED::SearchQuery query;
		query.m_Text = Core::String("passed");
		query.m_MaxResults = 10;
		query.m_Exclude.Push(Core::String("**"));   // what would skip the file in a walk does not here
		IED::SearchResult result;
		Core::String problem;
		assert_true(IED::SearchFileText(Core::StringView("logs/run.log"), Core::StringView("one\n  passed  A\nthree passed\n"), query, result, problem), problem.CStr());
		assert_eq((int64)2, result.m_Matches.Count(), "its matching lines");
		assert_true(result.m_Matches[0].m_Path == "logs/run.log" && result.m_Matches[0].m_Line == 1, "by the path given, from line 0");
		IED::SearchResult binary;
		Core::String withNul = Core::String("passed") + Core::StringView("\0x", 2);
		assert_true(IED::SearchFileText(Core::StringView("a.bin"), withNul.View(), query, binary, problem) && binary.m_Matches.IsEmpty(), "a binary text shows nothing");
		query.m_Regex = true;
		query.m_Text = Core::String("(");
		assert_true(!IED::SearchFileText(Core::StringView("a.txt"), Core::StringView("("), query, result, problem) && problem.View().Contains(Core::StringView("not a valid regex")), "a broken regex is refused");
	}

	[test("program_file")]
	public static void TestProgramFile() {
		Core::StringBuilder folder;
		folder.Append("ied-program-");
		folder.AppendInt(Platform::UnixTimeNs());
		FS::Path root = FS::TempDirectory() / folder.View();
		FS::MakeDirectories((root / "Game/build/bin").CStr());
		FS::WriteFileAtomically((root / "Game/build/bin/Client.exe").CStr(), (const void*)"x", 1);
		FS::MakeDirectories((root / "build/bin").CStr());
		FS::WriteFileAtomically((root / "build/bin/Tool.exe").CStr(), (const void*)"x", 1);
		Core::String client = Core::String((root / "Game/build/bin/Client.exe").View());
		assert_se((root / "build/bin/Tool.exe").CStr(), Ai::ProgramFile(root.View(), Core::StringView(""), Core::StringView("build/bin/Tool.exe")).CStr(), "a path from the root");
		assert_se(client.CStr(), Ai::ProgramFile(root.View(), Core::StringView("Game"), Core::StringView("build/bin/Client.exe")).CStr(), "else from cwd: a sub-project's own build output");
		assert_se(client.CStr(), Ai::ProgramFile(root.View(), Core::StringView("Game/build/bin"), Core::StringView("Client.exe")).CStr(), "a bare name of a file in cwd, as cmd runs one");
		assert_se("git", Ai::ProgramFile(root.View(), Core::StringView("Game/build/bin"), Core::StringView("git")).CStr(), "any other bare name is looked for on PATH");
		assert_se("Client.exe", Ai::ProgramFile(root.View(), Core::StringView(""), Core::StringView("Client.exe")).CStr(), "a file elsewhere than cwd is not found by its name");
	}

	[test("search_problem")]
	public static void TestSearchProblem() {
		Core::String broken = Ai::SearchProblem(Core::StringView("the pattern is not a valid regex: a '(' that is never closed"), true);
		assert_true(broken.View().StartsWith(Core::StringView("search_text: the pattern is not a valid regex")) && broken.View().Contains(Core::StringView("put a backslash before it")), "a broken regex says how to match ( as text");
		assert_se("search_text: no folder x", Ai::SearchProblem(Core::StringView("no folder x"), true).CStr(), "another problem as it is");
		assert_true(Ai::IsBrokenRegex(Core::StringView("the pattern is not a valid regex: a '(' that is never closed")) && !Ai::IsBrokenRegex(Core::StringView("no folder x")), "a broken regex, searched as text instead; another problem is an error");
		assert_se("[the pattern is not a valid regex: a '(' that is never closed - so it was searched as text]\n", Ai::SearchedAsTextNote(Core::StringView("the pattern is not a valid regex: a '(' that is never closed")).CStr(), "the answer says why it was searched as text");
	}

	[test("missing_search_path")]
	public static void TestMissingSearchPath() {
		Core::StringBuilder folder;
		folder.Append("ied-search-");
		folder.AppendInt(Platform::UnixTimeNs());
		FS::Path root = FS::TempDirectory() / folder.View();
		FS::MakeDirectories((root / "Nuke/nuke/commands").CStr());
		FS::WriteFileAtomically((root / "Nuke/readme.md").CStr(), (const void*)"x", 1);
		Core::String said = Ai::MissingSearchPath(root, Core::StringView("Nuke/nuke/build"), Core::StringView("ied:/"));
		assert_true(said.View().StartsWith(Core::StringView("search_text: no folder or file ied:/Nuke/nuke/build")), said.CStr());
		assert_true(said.View().Contains(Core::StringView("ied:/Nuke/nuke holds the folders: commands/")), "the folders it most likely meant");
		assert_true(Ai::MissingSearchPath(root, Core::StringView("Nuke/nuke"), Core::StringView("ied:/")).IsEmpty(), "a folder that is there is searched");
		assert_true(Ai::MissingSearchPath(root, Core::StringView("Nuke/readme.md"), Core::StringView("ied:/")).IsEmpty(), "so is a file");
		assert_true(Ai::MissingSearchPath(root, Core::StringView(""), Core::StringView("ied:/")).IsEmpty(), "no path is the whole workspace");
		FS::RemoveAll(root.CStr());
	}

	[test("same_named_search_file")]
	public static void TestSameNamedSearchFile() {
		Core::StringBuilder folder;
		folder.Append("ied-search-named-");
		folder.AppendInt(Platform::UnixTimeNs());
		FS::Path root = FS::TempDirectory() / folder.View();
		FS::MakeDirectories((root / "Engine/src/EngineCore").CStr());
		FS::MakeDirectories((root / "build/int").CStr());
		FS::MakeDirectories((root / "Tools/a").CStr());
		FS::MakeDirectories((root / "Tools/b").CStr());
		FS::WriteFileAtomically((root / "Engine/src/EngineCore/EngineCore.ch").CStr(), (const void*)"x", 1);
		FS::WriteFileAtomically((root / "build/int/EngineCore.ch").CStr(), (const void*)"x", 1);
		FS::WriteFileAtomically((root / "Tools/a/Main.cf").CStr(), (const void*)"x", 1);
		FS::WriteFileAtomically((root / "Tools/b/Main.cf").CStr(), (const void*)"x", 1);
		assert_se("Engine/src/EngineCore/EngineCore.ch", Ai::SameNamedSearchFile(root, Core::StringView("Engine/src/EngineCore.ch")).CStr(), "a file's path that misses: the only source of its name, build output's copy left out");
		assert_true(Ai::SameNamedSearchFile(root, Core::StringView("src/Main.cf")).IsEmpty(), "two of that name: no guess");
		assert_true(Ai::SameNamedSearchFile(root, Core::StringView("Engine/EngineCore")).IsEmpty(), "a folder's name is not looked for as a file");
		assert_true(Ai::SameNamedSearchFile(root, Core::StringView("Nowhere.ch")).IsEmpty(), "none of that name");
		FS::RemoveAll(root.CStr());
	}
}
