include "api/Plugin.ch"
include "AfterWrite.ch"
include "LineDiff.ch"

namespace Ai
{
	static Serialization::DomNode SettingValue(const ToolInvocation& call, const char* key) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(call.m_Context->Setting(Core::StringView(key), call.m_Ws.m_Id.View()).View(), *doc).root;
	}

	// A boolean setting that is on unless set false.
	static bool SettingOn(const ToolInvocation& call, const char* key) {
		Serialization::DomNode value = SettingValue(call, key);
		return value.Kind() != Serialization::DomKind::Bool || value.AsBool();
	}

	AfterWrite AfterWriteOf(const ToolInvocation& call, Core::StringView path) {
		AfterWrite after;
		after.m_WaitMs = c_AfterWriteWaitMs;
		if (!call.m_Context || call.m_Ws.m_Id.IsEmpty()) return after;
		Core::String answer;
		Core::String problem;
		if (!IED::LspAiWrite(call.m_Ws, path, answer, problem)) return after;
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode asked = Serialization::ReadJson(answer.View(), *doc).root;
		if (asked.Member("profile").AsView().IsEmpty()) return after;
		after.m_Label = Core::String(asked.Member("label").AsView());
		after.m_Format = asked.Member("format").AsBool() && SettingOn(call, "ai.edits.formatOnWrite");
		after.m_Diagnostics = asked.Member("diagnostics").AsBool() && SettingOn(call, "ai.edits.diagnosticsOnWrite");
		Serialization::DomNode wait = SettingValue(call, "ai.edits.diagnosticsWaitMs");
		if (wait.Kind() == Serialization::DomKind::Int) after.m_WaitMs = wait.AsInt() < 0 ? 0 : wait.AsInt() > c_AfterWriteMostWaitMs ? c_AfterWriteMostWaitMs : wait.AsInt();
		if (after.m_Diagnostics) after.m_Mark = IED::LspPublishMark(call.m_Ws, path);
		return after;
	}

	static int64 Gcd(int64 a, int64 b) { return b == 0 ? a : Gcd(b, a % b); }

	void IndentationOf(Core::StringView text, int64& tabSize, bool& insertSpaces) {
		int64 tabbed = 0;
		int64 spaced = 0;
		int64 unit = 0;
		for (Core::StringView line : SplitLines(text)) {
			if (line.StartsWith(Core::StringView("\t"))) {
				tabbed += 1;
				continue;
			}
			int64 width = 0;
			while (width < line.ByteLength() && line.ByteAt(width) == ' ') width += 1;
			if (width == 0 || width == line.ByteLength() || line.ByteAt(width) == '*') continue;   // none, blank, or a block comment's " * "
			spaced += 1;
			unit = unit == 0 ? width : Gcd(unit, width);
		}
		insertSpaces = spaced > tabbed;
		tabSize = insertSpaces && unit >= 2 && unit <= 8 ? unit : 4;
	}

	// --- What the result says ----------------------------------------------------------------------------------------

	static void AppendCount(Core::StringBuilder& out, int64 count, const char* noun) {
		out.AppendInt(count);
		out.Append(" ");
		out.Append(noun);
		if (count != 1) out.Append("s");
	}

	static const char* SeverityName(const Serialization::DomNode& item) {
		const int64 level = item.Member("severity").IsValid() ? item.Member("severity").AsInt() : 1;
		if (level == 2) return "warning";
		if (level == 3) return "info";
		if (level == 4) return "hint";
		return "error";
	}

	static Core::StringView FirstLine(Core::StringView text) {
		const int64 end = text.IndexOf('\n', 0);
		return (end < 0 ? text : text.Substring(0, end)).Trimmed();
	}

	static void AppendElsewhere(Core::StringBuilder& out, const Serialization::DomNode& answer) {
		Serialization::DomNode elsewhere = answer.Member("elsewhere");
		if (elsewhere.Count() == 0) return;
		if (!out.View().EndsWith(Core::StringView("\n"))) out.Append("\n");
		out.Append("Other files it finds problems in: ");
		for (int64 i = 0; i < elsewhere.Count(); ++i) {
			Serialization::DomNode file = elsewhere.At(i);
			if (i > 0) out.Append(", ");
			out.Append(file.Member("path").AsView());
			out.Append(" (");
			if (file.Member("errors").AsInt() > 0) AppendCount(out, file.Member("errors").AsInt(), "error");
			if (file.Member("errors").AsInt() > 0 && file.Member("warnings").AsInt() > 0) out.Append(", ");
			if (file.Member("warnings").AsInt() > 0) AppendCount(out, file.Member("warnings").AsInt(), "warning");
			out.Append(")");
		}
		const int64 more = answer.Member("elsewhereFiles").AsInt() - elsewhere.Count();
		if (more > 0) {
			out.Append(", and ");
			AppendCount(out, more, "more file");
		}
		out.Append(".");
	}

	Core::String DiagnosticsSaid(Core::StringView answer, int64 waitMs) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode root = Serialization::ReadJson(answer, *doc).root;
		if (root.Member("profile").AsView().IsEmpty()) return Core::String();
		Core::StringBuilder out;
		out.Append("Language server (");
		out.Append(root.Member("label").AsView());
		out.Append("): ");
		Core::StringView state = root.Member("state").AsView();
		if (state == "starting") out.Append("still starting, so nothing yet about this file; problems_list has its diagnostics once it is up.");
		else if (state == "down") out.Append("not running, so no diagnostics of this file.");
		else if (state == "stale") Core::Format(&out, "nothing new about this file within {0:D} ms; problems_list has its diagnostics once it gives them.", waitMs);
		if (state != "fresh") return out.ToString();
		Serialization::DomNode items = root.Member("items");
		int64 errors = 0;
		int64 warnings = 0;
		for (int64 i = 0; i < items.Count(); ++i) {
			Core::StringView severity = Core::StringView(SeverityName(items.At(i)));
			if (severity == "error") errors += 1;
			else if (severity == "warning") warnings += 1;
		}
		if (items.Count() == 0) out.Append("no problems in this file.");
		else {
			AppendCount(out, errors, "error");
			out.Append(", ");
			AppendCount(out, warnings, "warning");
			out.Append(" in this file - what the code says now, not a failure of this call: while an edit spans several files, errors from the files not yet changed are expected.\n");
			for (int64 i = 0; i < items.Count() && i < c_AfterWriteMostItems; ++i) {
				Serialization::DomNode start = items.At(i).Member("range").Member("start");
				Core::Format(&out, "  line {0:D}:{1:D}: {2:s}: ", start.Member("line").AsInt() + 1, start.Member("character").AsInt() + 1, SeverityName(items.At(i)));
				out.Append(FirstLine(items.At(i).Member("message").AsView()));
				out.Append("\n");
			}
			if (items.Count() > c_AfterWriteMostItems) Core::Format(&out, "  [and {0:D} more: problems_list]\n", items.Count() - c_AfterWriteMostItems);
		}
		AppendElsewhere(out, root);
		return Core::String(out.View().Trimmed());
	}
}
