// files: the paths the file tools take from a call - "." parts dropped, anything that leaves the workspace refused -
// and edits matching a file's line breaks.

include "Files.ch"

static bool Refused(const char* path) {
	try {
		Ai::ToolPath(Core::StringView(path));
	}
	catch (IED::RpcError& error) {
		return error.m_Code == IED::ErrorCode::BadRequest;
	}
	return false;
}

// `text` after fs_edit's one edit of `old` (JSON string text) to `replacement`.
static Core::String Edited(const char* text, const char* old, const char* replacement, bool& applied) {
	Core::StringBuilder json;
	json.Append("[{\"old\": \"");
	json.Append(old);
	json.Append("\", \"new\": \"");
	json.Append(replacement);
	json.Append("\"}]");
	Serialization::DomDoc* doc = new Serialization::DomDoc();
	Serialization::DomNode edits = Serialization::ReadJson(json.View(), *doc).root;
	assert_eq((int64)1, edits.Count(), "the edit's JSON parses: old and new escape their breaks (\\\\n)");
	Core::String result;
	Core::String error;
	Core::String unchanged;
	applied = Ai::ApplyTextEdits(Core::StringView(text), edits, result, error, unchanged);
	return result;
}

[test("server.ai.files")]
class FileToolTests {
	[test("tool_paths")]
	public static void TestToolPaths() {
		assert_true(Ai::ToolPath(Core::StringView(".")).IsEmpty() && Ai::ToolPath(Core::StringView("")).IsEmpty(), "the root, as models write it and as the tools say it");
		assert_se("src/main.c", Ai::ToolPath(Core::StringView("./src/main.c")).CStr(), "a leading ./");
		assert_se("src/main.c", Ai::ToolPath(Core::StringView("src/./main.c")).CStr(), "a . inside");
		assert_se("src/main.c", Ai::ToolPath(Core::StringView(".\\src\\main.c")).CStr(), "backslashes");
		assert_true(Refused("..") && Refused("./../secret") && Refused("src/../../x") && Refused("C:/Windows"), "out of the workspace stays refused");
	}

	[test("same_named_glob")]
	public static void TestSameNamedGlob() {
		assert_se("**/Renderer.ch", Ai::SameNamedGlob(Core::StringView("Packages/Renderer/RHI/src/Rhi/Renderer.ch")).CStr(), "the file's name anywhere");
		assert_se("**/Renderer.ch", Ai::SameNamedGlob(Core::StringView("Renderer.ch")).CStr(), "a bare name");
		assert_se("**/main.cf", Ai::SameNamedGlob(Core::StringView("src\\main.cf")).CStr(), "backslashes");
	}

	[test("a_missing_folder_names_its_parents_folders")]
	public static void TestMissingFolder() {
		Core::StringBuilder folder;
		folder.Append("ied-files-");
		folder.AppendInt(Platform::UnixTimeNs());
		FS::Path root = FS::TempDirectory() / folder.View();
		FS::MakeDirectories((root / "C4/src/compiler").CStr());
		FS::MakeDirectories((root / "C4/docs").CStr());
		FS::WriteFileAtomically((root / "C4/readme.md").CStr(), (const void*)"x", 1);
		Core::String said = Ai::NearestFoldersHint(root, Core::StringView("C4/tests/unit"), Core::StringView("ied:/"));
		assert_true(said.View().Contains(Core::StringView("ied:/C4 holds the folders:")), said.CStr());
		assert_true(said.View().Contains(Core::StringView(" src/")) && said.View().Contains(Core::StringView(" docs/")), "its folders");
		assert_true(!said.View().Contains(Core::StringView("readme")), "not its files");
		assert_true(Ai::NearestFoldersHint(root, Core::StringView("Nowhere"), Core::StringView("")).View().Contains(Core::StringView("(the root) holds the folders: C4/")), "up to the root");
	}

	[test("a_missing_folder_names_where_one_like_it_went")]
	public static void TestMovedFolder() {
		Core::StringBuilder folder;
		folder.Append("ied-moved-");
		folder.AppendInt(Platform::UnixTimeNs());
		FS::Path root = FS::TempDirectory() / folder.View();
		FS::MakeDirectories((root / "Claymore/Plugins/SoftBodyPhysics/src/SoftBodyPhysics").CStr());
		FS::MakeDirectories((root / "Packages/Physics/Kernel").CStr());
		FS::MakeDirectories((root / "build/SoftBodyOut").CStr());
		Core::String said = Ai::MovedFoldersHint(root, Core::StringView("Packages/Physics/SoftBody"), Core::StringView(""));
		assert_true(said.View().Contains(Core::StringView("folders named like SoftBody elsewhere:")), said.CStr());
		assert_true(said.View().Contains(Core::StringView(" Claymore/Plugins/SoftBodyPhysics/")), "where it went, nearest the root first");
		assert_true(said.View().Contains(Core::StringView(" Claymore/Plugins/SoftBodyPhysics/src/SoftBodyPhysics/")), "and deeper");
		assert_true(!said.View().Contains(Core::StringView("build/")), "not in build output");
		assert_true(Ai::MovedFoldersHint(root, Core::StringView("Nothing/Like/Zebra"), Core::StringView("")).IsEmpty(), "none: nothing said");
		assert_true(Ai::MovedFoldersHint(root, Core::StringView("softbody"), Core::StringView("ied:/")).View().Contains(Core::StringView(" ied:/Claymore/Plugins/SoftBodyPhysics/")), "any case, with the root's alias");
	}

	[test("glob_root_hint")]
	public static void TestGlobRootHint() {
		assert_true(Ai::GlobRootHint(Core::StringView("src/**/*.cf")).IsEmpty(), "a pattern of the workspace's paths is no mistake");
		assert_true(Ai::GlobRootHint(Core::StringView("C:/x/*.cf")).IsEmpty(), "a drive is no alias");
		Core::String ied = Ai::GlobRootHint(Core::StringView("ied:/plugins/chat/**/*Tests.cf"));
		assert_true(ied.View().Contains(Core::StringView("{\"root\": \"ied:/plugins/chat\", \"pattern\": \"**/*Tests.cf\"}")), ied.CStr());
		Core::String plugin = Ai::GlobRootHint(Core::StringView("plugins:/c4/docs/*.md"));
		assert_true(plugin.View().Contains(Core::StringView("{\"root\": \"plugins:/c4/docs\", \"pattern\": \"*.md\"}")), plugin.CStr());
		Core::String top = Ai::GlobRootHint(Core::StringView("ied:/**/*.md"));
		assert_true(top.View().Contains(Core::StringView("{\"root\": \"ied:/\", \"pattern\": \"**/*.md\"}")), top.CStr());
	}

	[test("only_source_file")]
	public static void TestOnlySourceFile() {
		Core::Array<Core::String> built = { Core::String("Engine/Shaders/Sky.shader"), Core::String("build/bin/Client/Shaders/Sky.shader"), Core::String("Game/node_modules/x/Sky.shader") };
		assert_se("Engine/Shaders/Sky.shader", Ai::OnlySourceFile(built).CStr(), "the copies in build output and skipped folders do not count");
		Core::Array<Core::String> two = { Core::String("a/Sky.shader"), Core::String("b/Sky.shader") };
		assert_true(Ai::OnlySourceFile(two).IsEmpty(), "two sources: no guess");
		Core::Array<Core::String> none = { Core::String("build/Sky.shader") };
		assert_true(Ai::OnlySourceFile(none).IsEmpty(), "only build output: none");
		Core::Array<Core::String> rebuilt = { Core::String("src/build.cf") };
		assert_se("src/build.cf", Ai::OnlySourceFile(rebuilt).CStr(), "a file named like a skipped folder is a source");
	}

	[test("edit_line_breaks")]
	public static void TestEditLineBreaks() {
		bool applied = false;
		Core::String lf = Edited("a\nb\nc\n", "a\\nb", "a\\nx", applied);
		assert_true(applied, "an edit of a \\n file applies");
		assert_se("a\nx\nc\n", lf.CStr(), "with \\n breaks");

		Core::String crlf = Edited("a\r\nb\r\nc\r\n", "a\\nb", "a\\nx", applied);
		assert_true(applied, "an edit written with \\n applies to a \\r\\n file");
		assert_se("a\r\nx\r\nc\r\n", crlf.CStr(), "and keeps its \\r\\n breaks");

		Core::String mixed = Edited("a\r\nb\nc\nd\r\n", "b\\nc", "b\\ny", applied);
		assert_true(applied, "an edit applies to the \\n lines of a file that has both breaks");
		assert_se("a\r\nb\ny\nd\r\n", mixed.CStr(), "keeping the breaks those lines have");

		Core::String spanning = Edited("// why\r\nf() {\n\tg();\n}\n", "// why\\nf() {\\n\\tg();", "// why\\nf() {\\n\\th();", applied);
		assert_true(applied, "an edit across lines of both breaks applies");
		assert_se("// why\nf() {\n\th();\n}\n", spanning.CStr(), "breaking as most of the lines it replaces");

		Core::String written = Edited("a\nb\n", "a\\r\\nb", "a\\r\\nz", applied);
		assert_true(applied, "old written with \\r\\n applies to a \\n file");
		assert_se("a\nz\n", written.CStr(), "and new takes the file's breaks");

		Edited("x;\r\nx;\nx;\r\n", "x;\\n", "y;\\n", applied);
		assert_true(!applied, "old found in lines of either break is found more than once");

		Edited("a\r\nb\r\n", "z", "y", applied);
		assert_true(!applied, "text that is in neither form is not found");
	}

	[test("edit_replace_all_line_breaks")]
	public static void TestEditReplaceAllLineBreaks() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode edits = Serialization::ReadJson(Core::StringView("[{\"old\": \"x;\\n\", \"new\": \"y;\\n\", \"replace_all\": true}]"), *doc).root;
		Core::String result;
		Core::String error;
		Core::String unchanged;
		assert_true(Ai::ApplyTextEdits(Core::StringView("x;\r\nx;\nx;\r\n"), edits, result, error, unchanged), "replace_all applies");
		assert_se("y;\r\ny;\ny;\r\n", result.CStr(), "each match keeps the break its line had");
	}

	[test("edit_found_more_than_once_says_where")]
	public static void TestEditFoundMoreThanOnce() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode edits = Serialization::ReadJson(Core::StringView("[{\"old\": \"x;\", \"new\": \"y;\"}]"), *doc).root;
		Core::String result;
		Core::String error;
		Core::String unchanged;
		assert_true(!Ai::ApplyTextEdits(Core::StringView("a\nx;\nb\nx;\n"), edits, result, error, unchanged), "twice: refused");
		assert_true(error.View().Contains(Core::StringView("found 2 times, at lines 2 and 4;")), error.CStr());
		assert_true(!Ai::ApplyTextEdits(Core::StringView("x;x;\nx;\nx;\nx;\nx;\n"), edits, result, error, unchanged), "six times: refused");
		assert_true(error.View().Contains(Core::StringView("found 6 times, at lines 1, 1, 2, 3 and 2 more;")), error.CStr());
	}

	[test("edit_that_changes_nothing")]
	public static void TestEditThatChangesNothing() {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode edits = Serialization::ReadJson(Core::StringView("[{\"old\": \"x;\\n\", \"new\": \"x;\\n\"}]"), *doc).root;
		Core::String result;
		Core::String error;
		Core::String unchanged;
		assert_true(!Ai::ApplyTextEdits(Core::StringView("y;\nx;\n"), edits, result, error, unchanged), "alone: refused, its change left out of new");
		assert_true(error.View().Contains(Core::StringView("the same")), error.CStr());

		// Among edits that change something: left out and named, the others applied.
		Serialization::DomNode batch = Serialization::ReadJson(Core::StringView("[{\"old\": \"a\", \"new\": \"b\"}, {\"old\": \"x;\", \"new\": \"x;\"}, {\"old\": \"c\", \"new\": \"d\"}]"), *doc).root;
		assert_true(Ai::ApplyTextEdits(Core::StringView("a\nx;\nc\n"), batch, result, error, unchanged), error.CStr());
		assert_se("b\nx;\nd\n", result.CStr(), "the others applied");
		assert_true(unchanged.View().StartsWith(Core::StringView("edit 2:")), unchanged.CStr());
		Serialization::DomNode missing = Serialization::ReadJson(Core::StringView("[{\"old\": \"a\", \"new\": \"b\"}, {\"old\": \"q\", \"new\": \"q\"}]"), *doc).root;
		assert_true(Ai::ApplyTextEdits(Core::StringView("a\n"), missing, result, error, unchanged) && unchanged.View().StartsWith(Core::StringView("edit 2:")), "a leftover need not be in the file: it changes nothing either way");
	}
}
