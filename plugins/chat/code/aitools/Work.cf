include "api/Plugin.ch"
include "Work.ch"
include "prompts/Contributed.ch"
include "Files.ch"
include "chats/Roots.ch"
include "SourceLines.ch"

namespace Ai
{
	const int32 c_ShellPollMs = 250;
	const int64 c_ShellDrainMs = 1000;
	const int64 c_BuildPollNs = 100000000;
	const int64 c_BuildCancelWaitMs = 15000;

	static int64 WorkNowMs() { return clock_now_ns() / 1000000; }

	Core::String TailOf(Core::StringView text, int64 lines, int64 bytes) {
		int64 start = text.ByteLength();
		int64 seen = 0;
		while (start > 0 && seen <= lines && text.ByteLength() - start < bytes) {
			start -= 1;
			if (text.ByteAt(start) == '\n' && start < text.ByteLength() - 1) seen += 1;
		}
		if (seen > lines || text.ByteLength() - start >= bytes) {
			const int64 lineEnd = text.IndexOf('\n', start);
			start = lineEnd < 0 ? start : lineEnd + 1;
		}
		return Core::String(text.Substring(start, text.ByteLength() - start));
	}

	// --- search_text -------------------------------------------------------------------------------------------------

	// The glob a search keeps to: its glob under its folder (`path`), or the folder's files.
	static Core::String SearchGlob(const ToolInvocation& call) {
		Core::String folder = ToolPath(call.m_Args.Member("path").AsView());
		Core::StringView glob = call.m_Args.Member("glob").AsView();
		if (folder.IsEmpty()) return Core::String(glob);
		return JoinPath(folder.View(), glob.IsEmpty() ? Core::StringView("**") : glob);
	}

	static ToolPlan SearchPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::String glob = SearchGlob(call);
		plan.m_Subject = (Core::String("fs.read(") + (glob.IsEmpty() ? Core::StringView("**") : glob.View())) + ")";
		plan.m_Summary = Core::String("Search for ") + call.m_Args.Member("pattern").AsView();
		return plan;
	}

	// Whether a literal pattern reads like a regex a model meant: an alternation, `.*`, a class or an escape.
	static bool LooksLikeRegex(Core::StringView pattern) {
		return pattern.Contains(Core::StringView("|")) || pattern.Contains(Core::StringView(".*")) || pattern.Contains(Core::StringView("\\b")) || pattern.Contains(Core::StringView("\\s")) || pattern.Contains(Core::StringView("\\(")) || pattern.Contains(Core::StringView("\\w")) || (pattern.Contains(Core::StringView("[")) && pattern.Contains(Core::StringView("]")));
	}

	// `line` and a newline; a line longer than kSearchLineShownBytes is cut at a character's start, "..." after it.
	static void AppendShortLine(Core::StringBuilder& out, Core::StringView line) {
		int64 cut = line.ByteLength() < c_SearchLineShownBytes ? line.ByteLength() : c_SearchLineShownBytes;
		while (cut > 0 && cut < line.ByteLength() && ((uint8)line.ByteAt(cut) & 0xC0) == 0x80) cut -= 1;
		out.Append(line.Substring(0, cut));
		if (cut < line.ByteLength()) out.Append("...");
		out.Append("\n");
	}

	Core::String SearchListing(const IED::SearchResult& result) {
		Core::StringBuilder out;
		for (int64 i = 0; i < result.m_Matches.Count(); ++i) {
			const IED::SearchMatch& match = result.m_Matches[i];
			if (i == 0 || match.m_Path.View() != result.m_Matches[i - 1].m_Path.View()) {
				out.Append(match.m_Path.View());
				out.Append("\n");
			}
			out.Append("  ");
			out.AppendInt(match.m_Line + 1);
			out.Append(": ");
			AppendShortLine(out, match.m_Preview.View().Trimmed());
		}
		if (result.m_Truncated) {
			out.Append("[stopped at ");
			out.AppendInt(c_SearchToolMatches);
			out.Append(" matches; narrow the pattern or add a glob]\n");
		}
		if (result.m_Matches.IsEmpty() && result.m_TooLarge.IsEmpty()) out.Append("[no matches; this finds text exactly as written in files - for code by what it does, code_symbols with a likely part of its name (\"Pool\", \"Serve\")]\n");
		if (!result.m_TooLarge.IsEmpty()) {
			out.Append(result.m_Matches.IsEmpty() ? "[no matches in the files searched; " : "[");
			out.AppendInt(result.m_TooLarge.Count());
			out.Append(result.m_TooLarge.Count() == 1 ? " file was not searched, over 4 MB: " : " files were not searched, over 4 MB: ");
			for (int64 i = 0; i < result.m_TooLarge.Count() && i < c_SearchTooLargeShown; ++i) {
				if (i > 0) out.Append(", ");
				out.Append(result.m_TooLarge[i].View());
			}
			if (result.m_TooLarge.Count() > c_SearchTooLargeShown) out.Append(", ...");
			out.Append(" - search one with shell_run (findstr /n /c:\"text\" <file>)]\n");
		}
		return Core::String(out.View());
	}

	bool InExcludedFolder(Core::StringView folder) {
		const Core::Array<Core::String> excludes = IED::DefaultExcludes();
		for (int64 end = 1; end <= folder.ByteLength(); ++end) {
			if (end < folder.ByteLength() && folder.ByteAt(end) != '/') continue;
			for (const Core::String& glob : excludes)
				if (IED::GlobMatch(glob.View(), folder.Substring(0, end))) return true;
		}
		return false;
	}

	// A plugin's folder (plugins:/) is searched on the disk; a workspace with its open documents as edited; a skipped
	// folder the call names (`alone`), on the disk and whole.
	static bool SearchIn(const IED::Workspace& ws, Core::StringView alone, const IED::SearchQuery& query, const Threading::Atomic<bool>* cancel, IED::SearchResult& result, Core::String& problem) {
		if (!alone.IsEmpty()) return IED::SearchFolder(JoinPath(ws.m_Root.View(), alone).View(), query, cancel, result, problem);
		if (IsFolderRoot(ws)) return IED::SearchFolder(ws.m_Root.View(), query, cancel, result, problem);
		return IED::Search(ws, query, cancel, result, problem);
	}

	// The files a search keeps to: the workspace's but build output and ignored files, or all of a skipped folder the
	// call names (`alone`, its glob relative to it).
	static void ScopeSearch(const ToolInvocation& call, IED::SearchQuery& query, Core::String& alone) {
		Core::String folder = ToolPath(call.m_Args.Member("path").AsView());
		if (InExcludedFolder(folder.View())) {
			alone = folder;
			Core::StringView glob = call.m_Args.Member("glob").AsView();
			if (!glob.IsEmpty()) query.m_Include.Push(Core::String(glob));
			return;
		}
		Core::String glob = SearchGlob(call);
		if (!glob.IsEmpty()) query.m_Include.Push(glob);
		query.m_Exclude = IED::DefaultExcludes();
		query.m_UseIgnoreFiles = true;
	}

	Core::String SearchProblem(Core::StringView problem, bool regex) {
		Core::String said = Core::String("search_text: ") + problem;
		if (!regex || !problem.Contains(Core::StringView("not a valid regex"))) return said;
		return said + "; to match ( ) [ ] { } . * + ? | ^ $ or \\ as text put a backslash before it (\\(), or leave regex false";
	}

	static ToolOutcome SearchRun(const ToolInvocation& call) {
		IED::SearchQuery query;
		query.m_Text = Core::String(call.m_Args.Member("pattern").AsView());
		query.m_Regex = call.m_Args.Member("regex").AsBool();
		query.m_CaseSensitive = call.m_Args.Member("case_sensitive").AsBool();
		Core::String alone;
		ScopeSearch(call, query, alone);
		query.m_MaxResults = c_SearchToolMatches;
		Threading::Atomic<bool> never;
		IED::SearchResult result;
		Core::String problem;
		if (!SearchIn(call.m_Ws, alone.View(), query, &never, result, problem)) return ToolError(SearchProblem(problem.View(), query.m_Regex).View());
		bool asRegex = false;
		if (result.m_Matches.IsEmpty() && !query.m_Regex && LooksLikeRegex(query.m_Text.View())) {
			query.m_Regex = true;
			IED::SearchResult again;
			Core::String ignored;
			if (SearchIn(call.m_Ws, alone.View(), query, &never, again, ignored) && !again.m_Matches.IsEmpty()) {
				result = again;
				asRegex = true;
			}
		}
		Core::String shown = alone.IsEmpty() ? Core::String(call.m_Shown) : (call.m_Shown + alone.View()) + "/";
		for (int64 i = 0; i < result.m_Matches.Count(); ++i) result.m_Matches[i].m_Path = shown + result.m_Matches[i].m_Path.View();
		for (int64 i = 0; i < result.m_TooLarge.Count(); ++i) result.m_TooLarge[i] = shown + result.m_TooLarge[i].View();
		Core::StringBuilder out;
		if (asRegex) out.Append("[nothing matched the pattern as text, so it was read as a regex; set regex true for one]\n");
		out.Append(SearchListing(result).View());
		Core::StringBuilder preview;
		preview.AppendInt(result.m_Matches.Count());
		preview.Append(result.m_Matches.Count() == 1 ? " match" : " matches");
		return ToolResult(out.View(), preview.View());
	}

	// --- shell_run ---------------------------------------------------------------------------------------------------

	static ToolPlan ShellPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("shell(") + call.m_Args.Member("command").AsView()) + ")";
		plan.m_Summary = (Core::String("Run `") + call.m_Args.Member("command").AsView()) + "`";
		if (!call.m_Ws.m_Trusted) plan.m_Error = Core::String("shell_run: the workspace is not trusted, so nothing may run in it; ask the owner to trust it");
		return plan;
	}

	static void ShellOutput(const ToolInvocation& call, Core::StringView text) {
		call.m_Context->Output(call.m_Ws.m_Id.View(), Core::StringView(c_AiOutputSource), text);
	}

	// Reads the child's output until it and what it started close it, the time is up or the run is stopped; the code
	// it ended with, or -1 when it had to be stopped. All of it goes to the AI output source; `kept` gets both streams,
	// or only stdout (`stdoutOnly`: a tool whose output is data, its log on stderr).
	static int64 Drain(const ToolInvocation& call, Process::Child& child, int64 seconds, bool stdoutOnly, Core::String& kept, Core::String& stopped) {
		const int64 deadline = WorkNowMs() + seconds * 1000;
		int64 exitedAt = -1;
		char8[16384] buffer;
		while (child.HasOutput()) {
			if (*call.m_Cancelled || WorkNowMs() > deadline) {
				stopped = Core::String(*call.m_Cancelled ? "stopped with the run" : "ran out of time and was stopped");
				child.Kill();
				break;
			}
			if (exitedAt < 0 && child.Wait(0) != Process::kTimedOut) exitedAt = WorkNowMs();
			if (exitedAt >= 0 && WorkNowMs() - exitedAt > c_ShellDrainMs) break;
			Process::Stream from;
			const int64 got = child.ReadAny((void*)&buffer[0], 16384, from, c_ShellPollMs);
			if (got > 0) {
				Core::StringView text = Core::StringView(&buffer[0], got);
				if (!stdoutOnly || from == Process::Stream::Output) kept = IED::BoundedText(kept.View(), text, c_ShellKeptBytes);
				ShellOutput(call, text);
			}
			else if (got != Process::kTimedOut && got != 0) break;
		}
		const int64 code = child.Wait(5000);
		return stopped.IsEmpty() ? code : -1;
	}

	static Core::String CommandLine(const ToolCommand& command) {
		if (!command.m_Shell.IsEmpty()) return command.m_Shell;
		Core::StringBuilder line;
		for (const Core::String& word : command.m_Argv) {
			if (line.ByteLength() > 0) line.Append(" ");
			line.Append(word.View());
		}
		return line.ToString();
	}

	static Process::StartInfo StartInfoOf(const ToolInvocation& call, const ToolCommand& command) {
		Process::StartInfo info;
		if (!command.m_Shell.IsEmpty()) info.shellCommand = command.m_Shell;
		else {
			info.program = command.m_Argv[0];
			for (int64 i = 1; i < command.m_Argv.Count(); ++i) info.arguments.Push(command.m_Argv[i]);
		}
		info.workingDirectory = Core::String((FS::Path(call.m_Ws.m_Root.View()) / command.m_Cwd.View()).View());
		info.input = Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::Pipe;
		return info;
	}

	Process::Child* StartToolCommand(const ToolInvocation& call, const ToolCommand& command, Core::String& problem) {
		ShellOutput(call, ((Core::String("> ") + CommandLine(command).View()) + "\n").View());
		Process::Child started = Process::Child::Start(StartInfoOf(call, command));
		if (!started.IsOpen()) {
			problem = (command.m_Tool + ": the command did not start: ") + started.Error();
			return nullptr;
		}
		return new Process::Child(take(started));
	}

	ToolOutcome RunToolCommand(const ToolInvocation& call, const ToolCommand& command, bool whole) {
		ShellOutput(call, ((Core::String("> ") + CommandLine(command).View()) + "\n").View());
		Process::Child child = Process::Child::Start(StartInfoOf(call, command));
		if (!child.IsOpen()) return ToolError((((command.m_Tool + ": the command did not start: ") + child.Error()).View()));
		Core::String kept;
		Core::String stopped;
		const int64 code = Drain(call, child, command.m_Seconds, whole, kept, stopped);
		Core::StringBuilder said;
		said.Append(stopped.IsEmpty() ? "exit " : "the command ");
		if (stopped.IsEmpty()) said.AppendInt(code);
		else said.Append(stopped.View());
		said.Append("\n");
		said.Append(whole ? kept.View() : TailOf(kept.View(), c_ShellTailLines, c_ShellTailBytes).View());
		ShellOutput(call, ((Core::String("[") + said.View().Substring(0, said.View().IndexOf('\n', 0))) + "]\n").View());
		ToolOutcome outcome = ToolResult(said.View(), TailOf(kept.View(), 12, 2048).View());
		outcome.m_IsError = code != 0;
		outcome.m_ReportsFailure = outcome.m_IsError;
		outcome.m_Source = Core::String("Output: AI");
		return outcome;
	}

	ToolCommand ShellCommandOf(const ToolInvocation& call, int64 defaultSeconds, int64 mostSeconds) {
		ToolCommand command;
		command.m_Shell = Core::String(call.m_Args.Member("command").AsView());
		command.m_Cwd = IED::NormalizePath(call.m_Args.Member("cwd").AsView());
		command.m_Seconds = call.m_Args.Member("timeout_s").IsValid() ? call.m_Args.Member("timeout_s").AsInt() : defaultSeconds;
		if (command.m_Seconds < 1 || command.m_Seconds > mostSeconds) command.m_Seconds = mostSeconds;
		command.m_Tool = Core::String("shell_run");
		return command;
	}

	static ToolOutcome ShellRun(const ToolInvocation& call) {
		ToolOutcome outcome = RunToolCommand(call, ShellCommandOf(call, c_ShellDefaultSeconds, c_ShellMostSeconds), false);
		outcome.m_Content = WithHints(outcome.m_Content.View(), CallHints(call));
		return outcome;
	}

	// --- program_run -------------------------------------------------------------------------------------------------

	// What a program wrote to one of its streams, kept to its end.
	class StreamTail
	{
		public Core::String m_Text;
		public int64 m_Bytes;
	}

	// Reads the child's two streams apart until it ends, then what it used in all (its totals, read through its handle).
	static int64 DrainApart(const ToolInvocation& call, Process::Child& child, int64 seconds, StreamTail& output, StreamTail& errors, Core::String& stopped, Process::Usage& usage, bool& measured) {
		const int64 deadline = WorkNowMs() + seconds * 1000;
		int64 exitedAt = -1;
		char8[16384] buffer;
		while (child.HasOutput()) {
			if (*call.m_Cancelled || WorkNowMs() > deadline) {
				stopped = Core::String(*call.m_Cancelled ? "stopped with the run" : "ran out of time and was stopped");
				child.Kill();
				break;
			}
			if (exitedAt < 0 && child.Wait(0) != Process::kTimedOut) exitedAt = WorkNowMs();
			if (exitedAt >= 0 && WorkNowMs() - exitedAt > c_ShellDrainMs) break;
			Process::Stream from;
			const int64 got = child.ReadAny((void*)&buffer[0], 16384, from, c_ShellPollMs);
			if (got > 0) {
				Core::StringView chunk = Core::StringView(&buffer[0], got);
				StreamTail* into = from == Process::Stream::Errors ? &errors : &output;
				into->m_Text = IED::BoundedText(into->m_Text.View(), chunk, c_ShellKeptBytes);
				into->m_Bytes += got;
				ShellOutput(call, chunk);
			}
			else if (got != Process::kTimedOut && got != 0) break;
		}
		const int64 code = child.Wait(5000);
		measured = child.GetUsage(usage);
		return stopped.IsEmpty() ? code : -1;
	}

	static void AppendStream(Core::StringBuilder& out, const char* name, const StreamTail& stream) {
		out.Append("--- ");
		out.Append(name);
		if (stream.m_Bytes == 0) {
			out.Append(": nothing\n");
			return;
		}
		Core::Format(&out, " ({0:D} bytes{1:s}) ---\n", stream.m_Bytes, stream.m_Bytes > stream.m_Text.ByteLength() ? ", the end of it" : "");
		out.Append(TailOf(stream.m_Text.View(), c_ShellTailLines, c_ShellTailBytes).View());
		if (!stream.m_Text.View().EndsWith(Core::StringView("\n"))) out.Append("\n");
	}

	// A program the call names: a file of the workspace (a path), else a name looked for on PATH.
	static Core::String ProgramPath(const ToolInvocation& call) {
		Core::StringView program = call.m_Args.Member("program").AsView();
		FS::Path inside = FS::Path(call.m_Ws.m_Root.View()) / IED::NormalizePath(program).View();
		const bool path = program.Contains(Core::StringView("/")) || program.Contains(Core::StringView("\\"));
		return path && FS::FileExists(inside.CStr()) ? Core::String(inside.View()) : Core::String(program);
	}

	static Core::String ProgramLine(const ToolInvocation& call) {
		Core::StringBuilder line;
		line.Append(call.m_Args.Member("program").AsView());
		Serialization::DomNode args = call.m_Args.Member("args");
		for (int64 i = 0; i < args.Count(); ++i) {
			line.Append(" ");
			line.Append(args.At(i).AsView());
		}
		return line.ToString();
	}

	static ToolPlan ProgramPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::String line = ProgramLine(call);
		plan.m_Subject = (Core::String("shell(") + line.View()) + ")";
		plan.m_Summary = (Core::String("Run `") + line.View()) + "`";
		if (!call.m_Ws.m_Trusted) plan.m_Error = Core::String("program_run: the workspace is not trusted, so nothing may run in it; ask the owner to trust it");
		return plan;
	}

	// One run of the program: how it ended, how long it took and what it used.
	class ProgramRunResult
	{
		public int64 m_Code;
		public Core::String m_Stopped;
		public int64 m_Ms;
		public Process::Usage m_Usage;
		public bool m_Measured;
		public StreamTail m_Output;
		public StreamTail m_Errors;
	}

	static int64 MedianOf(Core::Array<int64> values) {
		values.Sort();
		return values[values.Count() / 2];
	}

	static void AppendRunLine(Core::StringBuilder& out, const ProgramRunResult& run, const Core::Array<int64>& times) {
		if (run.m_Stopped.IsEmpty()) Core::Format(&out, "exit {0:D}", run.m_Code);
		else Core::Format(&out, "the program {0:s}", run.m_Stopped.CStr());
		if (times.Count() == 1) Core::Format(&out, " after {0:D} ms", run.m_Ms);
		else {
			out.Append(" - runs took");
			for (int64 ms : times) Core::Format(&out, " {0:D}", ms);
			Core::Format(&out, " ms, median {0:D} ms", MedianOf(times));
		}
		if (run.m_Measured) Core::Format(&out, " (CPU {0:F.2} s, peak memory {1:F.1} MB)", (double)run.m_Usage.cpuTimeNs / 1e9, (double)run.m_Usage.peakWorkingSetBytes / 1048576.0);
		out.Append("\n");
	}

	static ToolOutcome ProgramRun(const ToolInvocation& call) {
		int64 repeat = call.m_Args.Member("repeat").IsValid() ? call.m_Args.Member("repeat").AsInt() : 1;
		if (repeat < 1) repeat = 1;
		Core::Array<int64> times;
		ProgramRunResult last;
		for (int64 i = 0; i < repeat; ++i) {
			Core::String problem;
			last = RunProgramOnce(call, problem);
			if (!problem.IsEmpty()) return ToolError(problem.View());
			times.Push(last.m_Ms);
			if (last.m_Code != 0 || !last.m_Stopped.IsEmpty()) break;
		}
		Core::StringBuilder said;
		AppendRunLine(said, last, times);
		AppendStream(said, "stdout", last.m_Output);
		AppendStream(said, "stderr", last.m_Errors);
		ShellOutput(call, ((Core::String("[") + said.View().Substring(0, said.View().IndexOf('\n', 0))) + "]\n").View());
		ToolOutcome outcome = ToolResult(WithHints(said.View(), CallHints(call)).View(), said.View().Substring(0, said.View().IndexOf('\n', 0)));
		outcome.m_IsError = last.m_Code != 0;
		outcome.m_ReportsFailure = outcome.m_IsError;
		outcome.m_Source = Core::String("Output: AI");
		return outcome;
	}

	static ProgramRunResult RunProgramOnce(const ToolInvocation& call, Core::String& problem) {
		ProgramRunResult result;
		ShellOutput(call, ((Core::String("> ") + ProgramLine(call).View()) + "\n").View());
		Process::StartInfo info;
		info.program = ProgramPath(call);
		Serialization::DomNode args = call.m_Args.Member("args");
		for (int64 i = 0; i < args.Count(); ++i) info.arguments.Push(Core::String(args.At(i).AsView()));
		info.workingDirectory = Core::String((FS::Path(call.m_Ws.m_Root.View()) / IED::NormalizePath(call.m_Args.Member("cwd").AsView()).View()).View());
		Core::String input;
		if (call.m_Args.Member("stdin").IsValid()) {
			FS::File file = FS::File((FS::Path(call.m_Ws.m_Root.View()) / IED::NormalizePath(call.m_Args.Member("stdin").AsView()).View()).CStr(), "rb");
			if (!file.IsOpen()) {
				problem = Core::String("program_run: no file ") + call.m_Args.Member("stdin").AsView() + " to give the program as its input";
				return result;
			}
			input = file.ReadText();
		}
		info.input = call.m_Args.Member("stdin").IsValid() ? Process::Redirect::Pipe : Process::Redirect::Null;
		info.output = Process::Redirect::Pipe;
		info.errors = Process::Redirect::Pipe;
		Process::Child child = Process::Child::Start(info);
		if (!child.IsOpen()) {
			problem = Core::String("program_run: ") + info.program.View() + " did not start: " + child.Error() + "; a program of the workspace is named by its path (build/bin/...), another by its name on PATH";
			return result;
		}
		if (!input.IsEmpty()) child.WriteAll((const void*)input.CStr(), input.ByteLength(), 10000);
		if (call.m_Args.Member("stdin").IsValid()) child.CloseInput();
		int64 seconds = call.m_Args.Member("timeout_s").IsValid() ? call.m_Args.Member("timeout_s").AsInt() : c_ShellDefaultSeconds;
		if (seconds < 1 || seconds > c_ShellMostSeconds) seconds = c_ShellMostSeconds;
		const int64 started = WorkNowMs();
		result.m_Code = DrainApart(call, child, seconds, result.m_Output, result.m_Errors, result.m_Stopped, result.m_Usage, result.m_Measured);
		result.m_Ms = WorkNowMs() - started;
		return result;
	}

	// --- problems ----------------------------------------------------------------------------------------------------

	static const char* SeverityName(int64 severity) {
		if (severity == 1) return "error";
		return severity == 2 ? "warning" : "info";
	}

	Core::String ProblemLines(const Serialization::DomNode& files, Core::StringView under, bool errorsOnly, int64 most, int64& errors, int64& warnings) {
		Core::StringBuilder out;
		int64 shown = 0;
		for (int64 f = 0; files.Kind() == Serialization::DomKind::Object && f < files.Count(); ++f) {
			Core::StringView path = files.KeyAt(f);
			if (!under.IsEmpty() && !path.StartsWith(under)) continue;
			Serialization::DomNode sources = files.ValueAt(f);
			for (int64 s = 0; s < sources.Count(); ++s)
				for (int64 i = 0; i < sources.ValueAt(s).Count(); ++i) {
					Serialization::DomNode item = sources.ValueAt(s).At(i);
					const int64 severity = item.Member("severity").IsValid() ? item.Member("severity").AsInt() : 1;
					if (severity > 2 || (errorsOnly && severity != 1)) continue;
					if (severity == 1) errors += 1;
					else warnings += 1;
					if (shown >= most) continue;
					shown += 1;
					out.Append(path);
					out.Append(":");
					out.AppendInt(item.Member("range").Member("start").Member("line").AsInt() + 1);
					out.Append(":");
					out.AppendInt(item.Member("range").Member("start").Member("character").AsInt() + 1);
					out.Append(": ");
					out.Append(SeverityName(severity));
					out.Append(": ");
					out.Append(item.Member("message").AsView());
					out.Append("\n");
				}
		}
		if (errors + warnings > shown) out.Append("[more problems than shown; filter by path or severity]\n");
		return out.ToString();
	}

	static ToolPlan ProblemsPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = Core::String("problems()");
		plan.m_Summary = Core::String("List problems");
		return plan;
	}

	static Serialization::DomNode ParsedObject(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json, *doc).root;
	}

	// The problems' error lines with the source lines they name, read as the editor has them.
	static Core::String WithWorkspaceLines(const ToolInvocation& call, Core::StringView problems) {
		return WithSourceLines(problems, [&call](Core::StringView path, Core::String& text) -> bool {
			Core::String problem;
			return IED::TextAsEdited(call.m_Ws, path, text, problem);
		});
	}

	static ToolOutcome ProblemsRun(const ToolInvocation& call) {
		Core::String snapshot;
		{
			snapshot = IED::Problems(call.m_Ws);
		}
		int64 errors = 0;
		int64 warnings = 0;
		Core::String lines = ProblemLines(ParsedObject(snapshot.View()).Member("files"), call.m_Args.Member("path").AsView(), call.m_Args.Member("severity").AsView() == "error", c_ProblemsMost, errors, warnings);
		Core::StringBuilder preview;
		preview.AppendInt(errors);
		preview.Append(errors == 1 ? " error, " : " errors, ");
		preview.AppendInt(warnings);
		preview.Append(warnings == 1 ? " warning" : " warnings");
		if (lines.IsEmpty()) lines = Core::String("[no problems]\n");
		else lines = WithWorkspaceLines(call, WithHints(lines.View(), CallHints(call)).View());
		return ToolResult(lines.View(), preview.View());
	}

	// --- build_run ---------------------------------------------------------------------------------------------------

	static ToolPlan BuildPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::String task = call.m_Args.Member("task").IsValid() ? Core::String(call.m_Args.Member("task").AsView()) : Core::String("build");
		plan.m_Subject = (Core::String("task(") + task.View()) + ")";
		plan.m_Summary = (Core::String("Run the ") + task.View()) + " task";
		if (call.m_Args.Member("project").IsValid()) plan.m_Summary = (plan.m_Summary + " of ") + call.m_Args.Member("project").AsView();
		if (!call.m_Ws.m_Trusted) plan.m_Error = Core::String("build_run: the workspace is not trusted, so nothing may run in it; ask the owner to trust it");
		return plan;
	}

	// Runs the call's task to its end; the run being stopped, or `seconds` passing (0: no limit), cancels it, and
	// `stopped` says which.
	static IED::TaskOutcome AwaitTask(const ToolInvocation& call, Core::StringView task, int64 seconds, Core::String& stopped) {
		IED::TaskOutcome outcome;
		Core::String runId = IED::StartTask(call.m_Ws, call.m_Args.Member("project").AsView(), task, task.IsEmpty() ? Core::StringView("build") : Core::StringView(""), outcome.m_Problem);
		if (runId.IsEmpty()) return outcome;
		const int64 deadline = seconds > 0 ? WorkNowMs() + seconds * 1000 : -1;
		int64 cancelledAt = -1;
		while (!IED::TaskEnded(runId.View(), outcome) && outcome.m_Problem.IsEmpty()) {
			if (cancelledAt < 0 && (*call.m_Cancelled || (deadline >= 0 && WorkNowMs() > deadline))) {
				stopped = Core::String(*call.m_Cancelled ? "stopped with the run" : "ran out of time and was stopped");
				IED::CancelTask(runId.View());
				cancelledAt = WorkNowMs();
			}
			if (cancelledAt >= 0 && WorkNowMs() - cancelledAt > c_BuildCancelWaitMs) {
				outcome.m_Problem = Core::String("the task did not end when it was cancelled");
				break;
			}
			Threading::Thread::Sleep(c_BuildPollNs);
		}
		return outcome;
	}

	ToolOutcome BuildRun(const ToolInvocation& call) {
		Core::String task = call.m_Args.Member("task").IsValid() ? Core::String(call.m_Args.Member("task").AsView()) : Core::String("");
		const int64 seconds = call.m_Args.Member("timeout_s").IsValid() ? call.m_Args.Member("timeout_s").AsInt() : 0;
		Core::String stopped;
		IED::TaskOutcome run = AwaitTask(call, task.View(), seconds, stopped);
		if (!run.m_Problem.IsEmpty()) return ToolError((Core::String("build_run: ") + run.m_Problem.View()).View());
		const bool succeeded = run.m_Succeeded && stopped.IsEmpty();
		int64 errors = 0;
		int64 warnings = 0;
		Core::String problems = WithWorkspaceLines(call, WithHints(ProblemLines(ParsedObject(run.m_Problems.View()), Core::StringView(""), false, c_ProblemsMost, errors, warnings).View(), CallHints(call)).View());
		Core::StringBuilder said;
		said.Append(run.m_Label.View());
		if (!stopped.IsEmpty()) said.Append((Core::String(" ") + stopped.View()).View());
		else said.Append(succeeded ? " succeeded" : run.m_Cancelled ? " was cancelled" : " failed");
		said.Append(" in ");
		said.AppendInt(run.m_Ms / 1000);
		said.Append(" s (");
		said.AppendInt(errors);
		said.Append(" errors, ");
		said.AppendInt(warnings);
		said.Append(" warnings)\n");
		said.Append(problems.View());
		const bool builds = task.IsEmpty() || task == "build" || task == "rebuild";
		if ((!succeeded && errors == 0) || !builds) said.Append(TailOf(run.m_Tail.View(), 40, 4096).View());
		ToolOutcome outcome = ToolResult(said.View(), said.View().Substring(0, said.View().IndexOf('\n', 0)));
		outcome.m_IsError = !succeeded;
		outcome.m_ReportsFailure = outcome.m_IsError;
		outcome.m_Source = Core::String("Output: Build");
		return outcome;
	}

	static ToolSpec* WorkSpec(const char* name, const char* description, const char* parameters, ToolClass toolClass, bool inPlan) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = toolClass;
		spec->m_ParallelSafe = toolClass == ToolClass::Read;
		spec->m_InPlan = inPlan;
		return spec;
	}

	void AddWorkTools(ToolRegistry& registry) {
		ToolSpec* search = WorkSpec("search_text", "Search the workspace's files for exact text - messages, setting keys, comments - skipping build output and ignored files unless path names a folder of them (build/...); the pattern is literal unless regex is true. Where code is defined or used: code_symbols, code_references. Returns path:line: text. Example: search_text({\"pattern\": \"no language server serves\", \"glob\": \"**/*.cf\"}), or in a plugin's folder: search_text({\"pattern\": \"nuke build\", \"path\": \"plugins:/ied.nuke/skills\"})",
			"{\"type\": \"object\", \"properties\": {\"pattern\": {\"type\": \"string\"}, \"regex\": {\"type\": \"boolean\"}, \"glob\": {\"type\": \"string\", \"description\": \"only paths matching this glob (under path when given): '*' within a folder, '**' across folders, {a,b} either\"}, \"path\": {\"type\": \"string\", \"description\": \"a folder to search under, workspace-relative (no drive letter, no ..), build output too; plugins:/<plugin id>/ for a plugin's files; ied:/ for IED's checkout in developer mode\"}, \"case_sensitive\": {\"type\": \"boolean\"}}, \"required\": [\"pattern\"], \"additionalProperties\": false}",
			ToolClass::Read, true);
		search->m_Plan = SearchPlan;
		search->m_Run = SearchRun;
		search->m_FolderRoots = true;
		registry.Add(search);
		ToolSpec* shell = WorkSpec("shell_run", "Run a shell command (cmd on Windows) in the workspace; returns the exit code and the output's tail. The owner sees the output in Output > AI. Example: shell_run({\"command\": \"git status --short\"})",
			"{\"type\": \"object\", \"properties\": {\"command\": {\"type\": \"string\"}, \"cwd\": {\"type\": \"string\", \"description\": \"workspace-relative folder; left out for the workspace root, not '.'\"}, \"timeout_s\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 14400, \"description\": \"at most 1800 unless in the background\"}, \"background\": {\"type\": \"boolean\", \"description\": \"start it and go on at once (a server, a long test run): you are told when it ends; background_status shows its output so far\"}}, \"required\": [\"command\"], \"additionalProperties\": false}",
			ToolClass::Exec, false);
		shell->m_Plan = ShellPlan;
		shell->m_Run = ShellRun;
		registry.Add(shell);
		ToolSpec* program = WorkSpec("program_run", "Run a program with arguments - no shell, so nothing needs quoting - and get its exit code, its time, CPU and peak memory, its standard output and its standard error apart (their ends); repeat runs it again for timing. For trying or timing a command-line program: the program's path in the workspace (as its build prints it), in developer mode IED's own as ied:/build/bin/... (never a full C:/ path), or a name on PATH; stdin names a file the program reads as its input. Example: program_run({\"program\": \"build/bin/Development-windows-x64/tool/tool.exe\", \"args\": [\"data/in.txt\", \"5\"]})",
			"{\"type\": \"object\", \"properties\": {\"program\": {\"type\": \"string\", \"minLength\": 1}, \"args\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"stdin\": {\"type\": \"string\", \"description\": \"a workspace file given to the program as its standard input\"}, \"cwd\": {\"type\": \"string\", \"description\": \"workspace-relative folder; left out for the workspace root, not '.'\"}, \"timeout_s\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 1800}, \"repeat\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10, \"description\": \"runs, for timing: each run's time and the median\"}}, \"required\": [\"program\"], \"additionalProperties\": false}",
			ToolClass::Exec, false);
		program->m_Plan = ProgramPlan;
		program->m_Run = ProgramRun;
		registry.Add(program);
		ToolSpec* build = WorkSpec("build_run", "Run one of the project's tasks as the toolbar does and return the result with its errors and warnings as path:line: build (the default), test (runs the tests; failed ones as path:line, then the output's end) or run (the program, without arguments; the end of its output). A test or program that might not end: give timeout_s. Example: build_run({}) or build_run({\"task\": \"test\", \"project\": \"Game\", \"timeout_s\": 300})",
			"{\"type\": \"object\", \"properties\": {\"project\": {\"type\": \"string\", \"description\": \"a project of the solution; the startup project when left out (one without tests fails test: name the project that has them). A project folder made since the solution was read is not one yet: project_import it first\"}, \"task\": {\"type\": \"string\", \"description\": \"build (default), test, run, or another task of the project by its key\"}, \"timeout_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"stop the task after this many seconds\"}, \"background\": {\"type\": \"boolean\", \"description\": \"start it and go on at once: you are told when it ends\"}}, \"additionalProperties\": false}",
			ToolClass::Exec, false);
		build->m_Plan = BuildPlan;
		build->m_Run = BuildRun;
		registry.Add(build);
		ToolSpec* problems = WorkSpec("problems_list", "The Error List: errors and warnings from builds and language servers, as path:line:col: severity: message. Example: problems_list({\"severity\": \"error\", \"path\": \"engine/\"})",
			"{\"type\": \"object\", \"properties\": {\"severity\": {\"enum\": [\"error\", \"warning\"]}, \"path\": {\"type\": \"string\", \"description\": \"only files under this path\"}}, \"additionalProperties\": false}",
			ToolClass::Read, true);
		problems->m_Plan = ProblemsPlan;
		problems->m_Run = ProblemsRun;
		registry.Add(problems);
	}
}
