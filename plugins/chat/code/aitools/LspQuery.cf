include "api/Plugin.ch"
include "LspQuery.ch"

namespace Ai
{
	const int64 c_CodeSuggestionsMost = 8;

	static const char*[27] c_SymbolKinds = { "symbol", "file", "module", "namespace", "package", "class", "method", "property", "field", "constructor", "enum",
		"interface", "function", "variable", "constant", "string", "number", "boolean", "array", "object", "key", "null", "enum member", "struct", "event",
		"operator", "type parameter" };

	const char* SymbolKindName(int64 kind) { return kind >= 1 && kind <= 26 ? c_SymbolKinds[kind] : c_SymbolKinds[0]; }

	bool HoldsMembers(int64 kind) { return kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 10 || kind == 11 || kind == 23; }

	static Core::String Normalized(Core::StringView name) {
		Core::StringBuilder out;
		for (int64 i = 0; i < name.ByteLength(); ++i) {
			if (name.ByteAt(i) == '.') out.Append("::");
			else out.AppendByte(name.ByteAt(i));
		}
		return out.ToString();
	}

	Core::String CodeSymbol::Qualified() const {
		if (m_Container.IsEmpty()) return Normalized(m_Name.View());
		return (Normalized(m_Container.View()) + "::") + Normalized(m_Name.View()).View();
	}

	Core::Array<Core::String> NameParts(Core::StringView name) {
		Core::String normal = Normalized(name);
		Core::Array<Core::String> parts;
		int64 at = 0;
		while (at <= normal.ByteLength()) {
			int64 end = normal.View().Substring(at, normal.ByteLength() - at).IndexOf(Core::StringView("::"));
			end = end < 0 ? normal.ByteLength() : at + end;
			Core::StringView part = normal.View().Substring(at, end - at).Trimmed();
			if (!part.IsEmpty()) parts.Push(Core::String(part));
			at = end + 2;
		}
		return parts;
	}

	static bool IsLetterOrDigit(int32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'); }
	static bool IsUpper(int32 c) { return c >= 'A' && c <= 'Z'; }

	Core::Array<Core::String> NameWords(Core::StringView text) {
		Core::Array<Core::String> words;
		int64 at = 0;
		while (at < text.ByteLength()) {
			while (at < text.ByteLength() && !IsLetterOrDigit(text.ByteAt(at))) at += 1;
			int64 end = at;
			while (end < text.ByteLength() && IsLetterOrDigit(text.ByteAt(end))) {
				end += 1;
				if (end >= text.ByteLength() || !IsUpper(text.ByteAt(end))) continue;
				if (!IsUpper(text.ByteAt(end - 1))) break;
				if (end + 1 < text.ByteLength() && !IsUpper(text.ByteAt(end + 1)) && IsLetterOrDigit(text.ByteAt(end + 1))) break;
			}
			Core::String word = Core::String(text.Substring(at, end - at));
			if (word.ByteLength() >= 3 && !words.Contains(word)) words.Push(word);
			at = end;
		}
		return words;
	}

	bool QualifiedMatches(Core::StringView qualified, Core::StringView want) {
		Core::String have = Normalized(qualified);
		Core::String asked = Normalized(want);
		return have == asked || have.View().EndsWith((Core::String("::") + asked.View()).View());
	}

	Core::String WhereOf(const CodeSpan& span, Core::StringView shown) {
		Core::StringBuilder out;
		out.Append(shown);
		out.Append(":");
		out.AppendInt(span.m_StartLine + 1);
		return out.ToString();
	}

	Core::String LinesOf(const CodeSpan& span) {
		Core::StringBuilder out;
		out.AppendInt(span.m_StartLine + 1);
		if (span.m_EndLine > span.m_StartLine) {
			out.Append("-");
			out.AppendInt(span.m_EndLine + 1);
		}
		return out.ToString();
	}

	Core::String PositionParams(const CodeSpan& at, Core::StringView more) {
		Core::StringBuilder out;
		out.Append("{\"position\": {\"line\": ");
		out.AppendInt(at.m_StartLine);
		out.Append(", \"character\": ");
		out.AppendInt(at.m_StartCharacter);
		out.Append("}");
		if (!more.IsEmpty()) {
			out.Append(", ");
			out.Append(more);
		}
		out.Append("}");
		return out.ToString();
	}

	// The byte where each line of `text` starts, and one past its end.
	static Core::Array<int64> LineStarts(Core::StringView text) {
		Core::Array<int64> starts;
		starts.Push(0);
		for (int64 i = 0; i < text.ByteLength(); ++i)
			if (text.ByteAt(i) == '\n') starts.Push(i + 1);
		return starts;
	}

	static Core::StringView LineAt(Core::StringView text, const Core::Array<int64>& starts, int64 line) {
		if (line < 0 || line >= starts.Count() || starts[line] >= text.ByteLength()) return Core::StringView();
		int64 end = line + 1 < starts.Count() ? starts[line + 1] - 1 : text.ByteLength();
		if (end > starts[line] && text.ByteAt(end - 1) == '\r') end -= 1;
		return text.Substring(starts[line], end - starts[line]);
	}

	// The lines of `text`; a final break starts no line.
	static int64 CountLines(Core::StringView text, const Core::Array<int64>& starts) { return text.EndsWith(Core::StringView("\n")) ? starts.Count() - 1 : starts.Count(); }

	Core::String NumberedSpan(Core::StringView text, int64 first, int64 last, int64 most) {
		Core::Array<int64> starts = LineStarts(text);
		const int64 lines = CountLines(text, starts);
		Core::StringBuilder out;
		int64 line = first < 0 ? 0 : first;
		while (line <= last && line < lines && line - first < most) {
			out.AppendInt(line + 1);
			out.Append("\t");
			out.Append(LineAt(text, starts, line));
			out.Append("\n");
			line += 1;
		}
		if (line <= last && line < lines) {
			out.Append("[stopped at line ");
			out.AppendInt(line);
			out.Append(" of ");
			out.AppendInt(first + 1);
			out.Append("-");
			out.AppendInt(last + 1);
			out.Append("; fs_read with offset ");
			out.AppendInt(line + 1);
			out.Append(" reads on]\n");
		}
		return out.ToString();
	}

	// --- Answers read --------------------------------------------------------------------------------------------------

	static void ReadRange(CodeSpan& span, const Serialization::DomNode& range) {
		span.m_StartLine = range.Member("start").Member("line").AsInt();
		span.m_StartCharacter = range.Member("start").Member("character").AsInt();
		span.m_EndLine = range.Member("end").Member("line").AsInt();
		span.m_EndCharacter = range.Member("end").Member("character").AsInt();
	}

	CodeSpan CodeQuery::SpanOf(const Serialization::DomNode& location, bool selection) const {
		CodeSpan span;
		const bool link = location.Member("targetUri").IsValid();
		span.m_Path = PathOf((link ? location.Member("targetUri") : location.Member("uri")).AsView());
		if (!link) ReadRange(span, location.Member("range"));
		else ReadRange(span, location.Member(selection ? "targetSelectionRange" : "targetRange"));
		return span;
	}

	// A DocumentSymbol and its children, in `path`.
	static CodeSymbol* ReadDocumentSymbol(const Serialization::DomNode& node, Core::StringView path, Core::StringView container) {
		CodeSymbol* symbol = new CodeSymbol();
		symbol->m_Name = Core::String(node.Member("name").AsView());
		symbol->m_Container = Core::String(container);
		symbol->m_Kind = node.Member("kind").AsInt();
		symbol->m_Detail = Core::String(node.Member("detail").AsView().Trimmed());
		symbol->m_Range.m_Path = Core::String(path);
		ReadRange(symbol->m_Range, node.Member("range"));
		symbol->m_Selection.m_Path = Core::String(path);
		ReadRange(symbol->m_Selection, node.Member("selectionRange"));
		Core::String inner = symbol->Qualified();
		Serialization::DomNode children = node.Member("children");
		for (int64 i = 0; i < children.Count(); ++i) symbol->m_Children.Push(ReadDocumentSymbol(children.At(i), path, inner.View()));
		return symbol;
	}

	// A SymbolInformation (or WorkspaceSymbol): its location is its range and its name's.
	static CodeSymbol* ReadSymbolInformation(const CodeQuery& query, const Serialization::DomNode& node) {
		CodeSymbol* symbol = new CodeSymbol();
		symbol->m_Name = Core::String(node.Member("name").AsView());
		symbol->m_Container = Core::String(node.Member("containerName").AsView());
		symbol->m_Kind = node.Member("kind").AsInt();
		symbol->m_Detail = Core::String(node.Member("detail").AsView().Trimmed());
		symbol->m_Range = query.SpanOf(node.Member("location"), false);
		if (!node.Member("location").Member("range").IsValid()) symbol->m_Range.m_EndLine = symbol->m_Range.m_StartLine;
		symbol->m_Selection = symbol->m_Range;
		symbol->m_Selection.m_EndLine = symbol->m_Selection.m_StartLine;
		return symbol;
	}

	// --- The query -------------------------------------------------------------------------------------------------------

	void CodeQuery::Init(const IED::Workspace& ws) { this.m_Ws = ws; }

	static Serialization::DomNode ParsedJson(Core::StringView json) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		return Serialization::ReadJson(json, *doc).root;
	}

	Serialization::DomNode CodeQuery::Request(Core::StringView path, Core::StringView method, Core::StringView params, bool withDocument) {
		Core::String result;
		Core::String problem;
		if (!IED::LspRequest(m_Ws, path, method, params, withDocument, result, problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, (((Core::String(method) + " on ") + Shown(path).View()) + ": " + problem.View()).View());
		return ParsedJson(result.View());
	}

	Serialization::DomNode CodeQuery::Serving(Core::StringView path) {
		Serialization::DomNode known;
		if (m_Servers.TryGet(Core::String(path), known)) return known;
		Core::String result;
		Core::String problem;
		if (!IED::LspServing(m_Ws, path, result, problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, (Shown(path) + ": " + problem.View()).View());
		Serialization::DomNode serving = ParsedJson(result.View());
		m_Servers.Insert(Core::String(path), serving);
		return serving;
	}

	bool CodeQuery::Offers(Core::StringView path, const char* capability) {
		Serialization::DomNode offered = Serving(path).Member("capabilities").Member(capability);
		return offered.IsValid() && !offered.IsNull() && !(offered.Kind() == Serialization::DomKind::Bool && !offered.AsBool());
	}

	Core::StringView CodeQuery::Text(Core::StringView path) {
		Core::String* known = m_Texts.Find(Core::String(path));
		if (known) return known->View();
		Core::String text;
		Core::String problem;
		const bool read = path.StartsWith(Core::StringView("file:")) ? IED::LspFileText(m_Ws, path, text, problem) : IED::TextAsEdited(m_Ws, path, text, problem);
		if (!read) throw IED::RpcError(IED::ErrorCode::NotFound, (Shown(path) + ": " + problem.View()).View());
		m_Texts.Insert(Core::String(path), text);
		return m_Texts.Find(Core::String(path))->View();
	}

	Core::StringView CodeQuery::Line(Core::StringView path, int64 line) {
		Core::StringView text = Text(path);
		return LineAt(text, LineStarts(text), line);
	}

	int64 CodeQuery::LineCount(Core::StringView path) {
		Core::StringView text = Text(path);
		return CountLines(text, LineStarts(text));
	}

	Core::String CodeQuery::Shown(Core::StringView path) const {
		Core::String local;
		if (path.StartsWith(Core::StringView("file:")) && IED::LocalPathOf(path, local)) return local;
		return Core::String(path);
	}

	Core::String CodeQuery::PathOf(Core::StringView uri) const {
		Core::String path;
		if (IED::WorkspacePathOf(m_Ws, uri, path)) return path;
		return Core::String(uri);
	}

	Core::Array<CodeSymbol*> CodeQuery::Outline(Core::StringView path) {
		Core::Array<CodeSymbol*>** known = m_Outlines.Find(Core::String(path));
		if (known) return **known;
		Core::Array<CodeSymbol*>* symbols = new Core::Array<CodeSymbol*>();
		Serialization::DomNode answer = Request(path, Core::StringView("textDocument/documentSymbol"), Core::StringView("{}"), true);
		for (int64 i = 0; i < answer.Count(); ++i) {
			Serialization::DomNode node = answer.At(i);
			symbols->Push(node.Member("selectionRange").IsValid() ? ReadDocumentSymbol(node, path, Core::StringView("")) : ReadSymbolInformation(*this, node));
		}
		m_Outlines.Insert(Core::String(path), symbols);
		return *symbols;
	}

	Core::Array<CodeSymbol*> CodeQuery::Search(Core::StringView text) {
		Core::String result;
		Core::String problem;
		if (!IED::LspWorkspaceSymbols(m_Ws, text, result, problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, (Core::String("workspace/symbol: ") + problem.View()).View());
		Serialization::DomNode answer = ParsedJson(result.View());
		Core::Array<CodeSymbol*> symbols;
		for (int64 i = 0; i < answer.Count(); ++i) symbols.Push(ReadSymbolInformation(*this, answer.At(i)));
		return symbols;
	}

	static bool Holds(const CodeSpan& span, int64 line) { return span.m_StartLine <= line && line <= span.m_EndLine; }

	static CodeSymbol* Innermost(const Core::Array<CodeSymbol*>& symbols, int64 line) {
		for (CodeSymbol* symbol : symbols) {
			if (!Holds(symbol->m_Range, line)) continue;
			CodeSymbol* inner = Innermost(symbol->m_Children, line);
			return inner ? inner : symbol;
		}
		return nullptr;
	}

	CodeSymbol* CodeQuery::Enclosing(Core::StringView path, int64 line) { return Innermost(Outline(path), line); }

	// --- Finding a symbol by name ------------------------------------------------------------------------------------------

	// Whether a symbol the server calls `have` ("Push", or "Ring::Push" for an out-of-line definition) is named `last`.
	static bool NameMatches(Core::StringView have, Core::StringView last) {
		if (have == last) return true;
		Core::Array<Core::String> parts = NameParts(have);
		return !parts.IsEmpty() && parts[parts.Count() - 1].View() == last;
	}

	static void Collect(const Core::Array<CodeSymbol*>& symbols, Core::StringView last, Core::StringView qualifier, Core::Array<CodeSymbol*>& found) {
		for (CodeSymbol* symbol : symbols) {
			if (NameMatches(symbol->m_Name.View(), last) && (qualifier.IsEmpty() || QualifiedMatches(symbol->Qualified().View(), (Core::String(qualifier) + "::" + last).View()))) found.Push(symbol);
			Collect(symbol->m_Children, last, qualifier, found);
		}
	}

	// The outline's symbol `found` (a workspace symbol) is: its whole range, detail and kind. `found` itself when the
	// outline cannot be had (the server busy past its time): its place is known, and a reader finds its body by braces.
	CodeSymbol* CodeQuery::Refined(CodeSymbol* found) {
		Core::Array<Core::String> parts = NameParts(found->m_Name.View());
		if (parts.IsEmpty()) return found;
		Core::Array<CodeSymbol*> outline;
		try {
			outline = Outline(found->m_Selection.m_Path.View());
		}
		catch (IED::RpcError& error) {
			return found;
		}
		Core::Array<CodeSymbol*> named;
		Collect(outline, parts[parts.Count() - 1].View(), Core::StringView(""), named);
		for (CodeSymbol* symbol : named) {
			if (Holds(symbol->m_Selection, found->m_Selection.m_StartLine) || symbol->m_Selection.m_StartLine == found->m_Selection.m_StartLine) {
				if (symbol->m_Container.IsEmpty()) symbol->m_Container = found->m_Container;
				return symbol;
			}
		}
		return found;
	}

	static bool SamePlace(const CodeSymbol* a, const CodeSymbol* b) { return a->m_Selection.m_Path == b->m_Selection.m_Path && a->m_Selection.m_StartLine == b->m_Selection.m_StartLine; }

	Core::Array<CodeSymbol*> CodeQuery::Find(Core::StringView name, Core::StringView path) {
		Core::Array<Core::String> parts = NameParts(name);
		Core::Array<CodeSymbol*> found;
		if (parts.IsEmpty()) return found;
		Core::String last = parts[parts.Count() - 1];
		Core::StringBuilder qualifier;
		for (int64 i = 0; i + 1 < parts.Count(); ++i) {
			if (i > 0) qualifier.Append("::");
			qualifier.Append(parts[i].View());
		}
		Core::Array<CodeSymbol*> named;
		if (!path.IsEmpty()) Collect(Outline(path), last.View(), qualifier.View(), named);
		else
			for (CodeSymbol* symbol : Search(last.View()))
				if (NameMatches(symbol->m_Name.View(), last.View()) && (qualifier.IsEmpty() || QualifiedMatches(symbol->Qualified().View(), name))) named.Push(symbol);
		for (CodeSymbol* symbol : named) {
			CodeSymbol* whole = path.IsEmpty() ? Refined(symbol) : symbol;
			bool seen = false;
			for (CodeSymbol* kept : found) seen = seen || SamePlace(kept, whole);
			if (!seen) found.Push(whole);
		}
		return found;
	}

	// --- A call's target ---------------------------------------------------------------------------------------------------

	// A drive's path or a share's; a leading "/" alone is taken for a workspace path.
	static bool IsAbsolute(Core::StringView path) {
		const bool drive = path.ByteLength() >= 3 && path.ByteAt(1) == ':' && (path.ByteAt(2) == '\\' || path.ByteAt(2) == '/');
		return drive || path.StartsWith(Core::StringView("\\\\"));
	}

	Core::String CodeQuery::FileOf(Core::StringView given) const {
		if (given.StartsWith(Core::StringView("file:"))) return Core::String(given);
		Core::String relative;
		if (IsAbsolute(given) && IED::RelativeTo(m_Ws.m_Root.View(), given, relative)) return IED::NormalizePath(relative.View());
		if (IsAbsolute(given)) return IED::FileUriOfPath(given);
		return IED::NormalizePath(given);
	}

	static bool IsWordByte(int32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c >= 0x80; }

	Core::String CodeQuery::NameAt(const CodeSpan& at) {
		Core::StringView line = Line(at.m_Path.View(), at.m_StartLine);
		int64 start = Core::ByteOffsetOfUtf16(line, at.m_StartCharacter);
		int64 end = start;
		while (start > 0 && IsWordByte(line.ByteAt(start - 1))) start -= 1;
		while (end < line.ByteLength() && IsWordByte(line.ByteAt(end))) end += 1;
		return Core::String(line.Substring(start, end - start));
	}

	// The byte where `word` stands alone on `line`; -1 when it does not.
	static int64 WordAt(Core::StringView line, Core::StringView word) {
		int64 at = 0;
		while (at + word.ByteLength() <= line.ByteLength()) {
			const int64 found = line.Substring(at, line.ByteLength() - at).IndexOf(word);
			if (found < 0) return -1;
			const int64 start = at + found;
			const int64 end = start + word.ByteLength();
			if ((start == 0 || !IsWordByte(line.ByteAt(start - 1))) && (end >= line.ByteLength() || !IsWordByte(line.ByteAt(end)))) return start;
			at = start + 1;
		}
		return -1;
	}

	// The byte of the `column`-th character (from 1) of `line`.
	static int64 ByteOfColumn(Core::StringView line, int64 column) {
		int64 byte = 0;
		int64 characters = 1;
		while (byte < line.ByteLength() && characters < column) {
			byte += 1;
			while (byte < line.ByteLength() && ((uint8)line.ByteAt(byte) & 0xC0) == 0x80) byte += 1;
			characters += 1;
		}
		return byte;
	}

	static CodeTarget PlaceTarget(CodeQuery& query, const Serialization::DomNode& args) {
		CodeTarget target;
		Core::String path = query.FileOf(args.Member("path").AsView());
		if (path.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("line needs path"));
		const int64 line = args.Member("line").AsInt() - 1;
		Core::StringView text = query.Line(path.View(), line);
		int64 byte = 0;
		if (args.Member("column").IsValid()) byte = ByteOfColumn(text, args.Member("column").AsInt());
		else if (args.Member("symbol").IsValid()) {
			Core::Array<Core::String> parts = NameParts(args.Member("symbol").AsView());
			byte = parts.IsEmpty() ? -1 : WordAt(text, parts[parts.Count() - 1].View());
			if (byte < 0) {
				Core::StringBuilder said;
				said.Append(args.Member("symbol").AsView());
				said.Append(" is not on line ");
				said.AppendInt(line + 1);
				said.Append(text.IsEmpty() ? Core::StringView(" (past the end or empty)") : Core::StringView(": "));
				said.Append(text.Trimmed());
				throw IED::RpcError(IED::ErrorCode::NotFound, said.View());
			}
		}
		else
			while (byte < text.ByteLength() && (text.ByteAt(byte) == ' ' || text.ByteAt(byte) == '\t')) byte += 1;
		target.m_At.m_Path = path;
		target.m_At.m_StartLine = line;
		target.m_At.m_StartCharacter = Core::Utf16OffsetOfByte(text, byte);
		target.m_At.m_EndLine = line;
		target.m_At.m_EndCharacter = target.m_At.m_StartCharacter;
		target.m_Label = WhereOf(target.m_At, path.View());
		return target;
	}

	// What the workspace has named like the last part of `name`, for an answer that found nothing.
	static Core::String Similar(CodeQuery& query, Core::StringView name) {
		Core::Array<Core::String> parts = NameParts(name);
		if (parts.IsEmpty()) return Core::String();
		Core::StringBuilder out;
		int64 count = 0;
		for (CodeSymbol* symbol : query.Search(parts[parts.Count() - 1].View())) {
			if (count >= c_CodeSuggestionsMost) break;
			out.Append(count == 0 ? "; similar: " : ", ");
			out.Append(symbol->Qualified().View());
			count += 1;
		}
		return out.ToString();
	}

	// `symbols` without those inside another of them that holds members: "Ring" names the class, not its constructor.
	static Core::Array<CodeSymbol*> WithoutMembersOfFound(const Core::Array<CodeSymbol*>& symbols) {
		Core::Array<CodeSymbol*> kept;
		for (CodeSymbol* symbol : symbols) {
			bool member = false;
			for (CodeSymbol* other : symbols)
				member = member || (other != symbol && HoldsMembers(other->m_Kind) && symbol->Qualified().View().StartsWith((other->Qualified() + "::").View()));
			if (!member) kept.Push(symbol);
		}
		return kept;
	}

	// The workspace's own symbol when only one of `symbols` is the workspace's: a plain name the project defines is not
	// made ambiguous by a library's (Bedrock's private InputLines::Fill against the project's Fill).
	static Core::Array<CodeSymbol*> OwnFirst(const Core::Array<CodeSymbol*>& symbols) {
		Core::Array<CodeSymbol*> own;
		for (CodeSymbol* symbol : symbols)
			if (!symbol->m_Selection.m_Path.View().StartsWith(Core::StringView("file:"))) own.Push(symbol);
		if (own.IsEmpty() || own.Count() == symbols.Count()) return symbols;
		for (CodeSymbol* symbol : own)
			if (symbol->Qualified() != own[0]->Qualified()) return symbols;
		return own;
	}

	static bool IsC4File(Core::StringView extension) { return extension == ".cf" || extension == ".ch"; }

	// What a file uses but does not declare - `path` named where the name is used, not where it is defined: the symbols
	// named exactly so in files of the same language as `path` (not the C++ libraries' ToolInvocation for a C4 file's).
	static Core::Array<CodeSymbol*> NamedSoElsewhere(CodeQuery& query, Core::StringView name, Core::StringView path) {
		Core::Array<CodeSymbol*> found;
		Core::Array<Core::String> parts = NameParts(name);
		if (parts.IsEmpty()) return found;
		FS::Path asked = FS::Path(path);
		const bool c4 = IsC4File(asked.Extension());
		Core::String suffix = Core::String("::") + name;
		for (CodeSymbol* symbol : query.Search(parts[parts.Count() - 1].View())) {
			Core::String qualified = symbol->Qualified();
			if (!(qualified == name || qualified.View().EndsWith(suffix.View()))) continue;
			FS::Path file = FS::Path(symbol->m_Selection.m_Path.View());
			if (IsC4File(file.Extension()) != c4) continue;
			found.Push(symbol);
		}
		return OwnFirst(WithoutMembersOfFound(found));
	}

	CodeTarget TargetOf(CodeQuery& query, const Serialization::DomNode& args) {
		if (args.Member("line").IsValid()) return PlaceTarget(query, args);
		Core::StringView name = args.Member("symbol").AsView();
		if (name.IsEmpty()) throw IED::RpcError(IED::ErrorCode::BadRequest, Core::StringView("give symbol (a name; Ring::Push narrows it), or path and line; code_symbols with a path lists a file's symbols"));
		Core::String path = query.FileOf(args.Member("path").AsView());
		CodeTarget target;
		target.m_Symbols = OwnFirst(WithoutMembersOfFound(query.Find(name, path.View())));
		// A server still indexing (just after a restart) answers a first search with nothing: look once more before saying so.
		if (target.m_Symbols.IsEmpty()) target.m_Symbols = OwnFirst(WithoutMembersOfFound(query.Find(name, path.View())));
		if (target.m_Symbols.IsEmpty() && !path.IsEmpty()) target.m_Symbols = NamedSoElsewhere(query, name, path.View());
		if (target.m_Symbols.IsEmpty()) {
			// Without a path only the workspace's own code is searched: a file elsewhere (IED's, ied:/...) needs its path.
			Core::String where = path.IsEmpty() ? Core::String(" in the workspace (code outside it, such as ied:/..., needs its path)") : Core::String(" in ") + path.View();
			throw IED::RpcError(IED::ErrorCode::NotFound, ((((Core::String("no symbol ") + name) + where.View()) + Similar(query, name).View()) + "; code_symbols lists a file's symbols or searches by name").View());
		}
		Core::String first = target.m_Symbols[0]->Qualified();
		for (CodeSymbol* symbol : target.m_Symbols) {
			if (symbol->Qualified() == first) continue;
			Core::StringBuilder listed;
			listed.Append(name);
			listed.Append(" names several symbols - give a qualified name or path: ");
			for (int64 i = 0; i < target.m_Symbols.Count() && i < c_CodeSuggestionsMost; ++i) {
				if (i > 0) listed.Append(", ");
				listed.Append(target.m_Symbols[i]->Qualified().View());
				listed.Append(" (");
				listed.Append(WhereOf(target.m_Symbols[i]->m_Selection, query.Shown(target.m_Symbols[i]->m_Selection.m_Path.View()).View()).View());
				listed.Append(")");
			}
			throw IED::RpcError(IED::ErrorCode::BadRequest, listed.View());
		}
		target.m_At = target.m_Symbols[0]->m_Selection;
		target.m_Label = first;
		return target;
	}
}
