include "api/Plugin.ch"
include "Files.ch"
include "run/EditMiss.ch"
include "LineDiff.ch"
include "LspQuery.ch"
include "chats/Roots.ch"
include "AfterWrite.ch"

namespace Ai
{
	const int64 c_DiffContext = 2;

	// A file of a plugin's folder (plugins:/), which is no workspace: read from the disk.
	static Core::String FolderFileText(const IED::Workspace& ws, Core::StringView path) {
		FS::Path file = FS::Path(ws.m_Root.View()) / IED::NormalizePath(path).View();
		if (!FS::FileExists(file.CStr())) throw IED::RpcError(IED::ErrorCode::NotFound, ((Core::String("no file ") + path) + " in the plugin's folder; fs_list or fs_glob there finds its files").View());
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	Core::String TextAsEdited(const IED::Workspace& ws, Core::StringView path) {
		if (IsFolderRoot(ws)) return FolderFileText(ws, path);
		Core::String text;
		Core::String problem;
		if (!IED::TextAsEdited(ws, path, text, problem)) throw IED::RpcError(IED::ErrorCode::NotFound, problem.View());
		return text;
	}

	void WriteThrough(const IED::Workspace& ws, Core::StringView path, Core::StringView text) {
		Core::String problem;
		if (!IED::WriteThrough(ws, path, text, Core::StringView("ai"), problem)) throw IED::RpcError(IED::ErrorCode::Unavailable, problem.View());
	}

	Core::String NumberedLines(Core::StringView text, int64 first, int64 most) {
		Core::Array<Core::StringView> lines = SplitLines(text);
		Core::StringBuilder out;
		int64 line = first < 1 ? 1 : first;
		while (line <= lines.Count() && line - first < most && out.ByteLength() < c_ReadMostBytes) {
			out.AppendInt(line);
			out.Append("\t");
			out.Append(lines[line - 1]);
			out.Append("\n");
			line += 1;
		}
		if (line <= lines.Count()) {
			out.Append("[lines ");
			out.AppendInt(first);
			out.Append("-");
			out.AppendInt(line - 1);
			out.Append(" of ");
			out.AppendInt(lines.Count());
			out.Append("; call fs_read with offset ");
			out.AppendInt(line);
			out.Append(" to read on]\n");
		}
		else if (lines.IsEmpty()) out.Append("[the file is empty]\n");
		return out.ToString();
	}

	// --- Edits -------------------------------------------------------------------------------------------------------

	static int64 Occurrences(Core::StringView text, Core::StringView part, int64& first) {
		first = -1;
		int64 count = 0;
		int64 at = 0;
		while (at <= text.ByteLength() - part.ByteLength()) {
			const int64 found = text.Substring(at, text.ByteLength() - at).IndexOf(part);
			if (found < 0) break;
			if (first < 0) first = at + found;
			count += 1;
			at += found + part.ByteLength();
		}
		return count;
	}

	// A model writes "\n"; a file may break lines with "\r\n".
	static Core::String WithBreaks(Core::StringView text, bool crlf) {
		if (!crlf) return Core::String(text);
		Core::StringBuilder out;
		for (int64 i = 0; i < text.ByteLength(); ++i) {
			if (text.ByteAt(i) == '\n' && (i == 0 || text.ByteAt(i - 1) != '\r')) out.AppendByte('\r');
			out.AppendByte(text.ByteAt(i));
		}
		return out.ToString();
	}

	static Core::String ReplaceAll(Core::StringView text, Core::StringView old, Core::StringView replacement) {
		Core::StringBuilder out;
		int64 at = 0;
		for (;;) {
			const int64 found = text.Substring(at, text.ByteLength() - at).IndexOf(old);
			if (found < 0) break;
			out.Append(text.Substring(at, found));
			out.Append(replacement);
			at += found + old.ByteLength();
		}
		out.Append(text.Substring(at, text.ByteLength() - at));
		return out.ToString();
	}

	static bool ApplyOne(Core::String& text, const Serialization::DomNode& edit, int64 number, bool crlf, Core::String& error) {
		Core::String old = WithBreaks(edit.Member("old").AsView(), crlf);
		Core::String replacement = WithBreaks(edit.Member("new").AsView(), crlf);
		Core::StringBuilder which;
		which.Append("edit ");
		which.AppendInt(number);
		if (old.IsEmpty()) {
			error = which.ToString() + ": old is empty; to create or overwrite a file use fs_write";
			return false;
		}
		int64 first = -1;
		const int64 count = Occurrences(text.View(), old.View(), first);
		if (count == 0) {
			Core::String miss = EditMiss(text.View(), old.View());
			error = which.ToString() + ": old was not found" + (miss.IsEmpty() ? Core::String("; no part of it is in the file: is it the right file?") : Core::String("; ") + miss.View()) + "; copy the text from the file exactly, tabs included";
			return false;
		}
		if (count > 1 && !edit.Member("replace_all").AsBool()) {
			which.Append(": old is found ");
			which.AppendInt(count);
			which.Append(" times; add surrounding lines to make it unique, or set replace_all");
			error = which.ToString();
			return false;
		}
		if (count > 1) text = ReplaceAll(text.View(), old.View(), replacement.View());
		else text = (Core::String(text.View().Substring(0, first)) + replacement.View()) + text.View().Substring(first + old.ByteLength(), text.ByteLength() - first - old.ByteLength());
		return true;
	}

	bool ApplyTextEdits(Core::StringView text, const Serialization::DomNode& edits, Core::String& result, Core::String& error) {
		const bool crlf = text.Contains(Core::StringView("\r\n"));
		result = Core::String(text);
		for (int64 i = 0; i < edits.Count(); ++i)
			if (!ApplyOne(result, edits.At(i), i + 1, crlf, error)) return false;
		return true;
	}

	// --- The tools ---------------------------------------------------------------------------------------------------

	Core::String ToolPath(Core::StringView path) {
		Core::StringBuilder kept;
		int64 at = 0;
		while (at <= path.ByteLength()) {
			int64 end = at;
			while (end < path.ByteLength() && path.ByteAt(end) != '/' && path.ByteAt(end) != '\\') end += 1;
			Core::StringView part = path.Substring(at, end - at);
			if (part != ".") {
				if (kept.ByteLength() > 0) kept.AppendByte('/');
				kept.Append(part);
			}
			at = end + 1;
		}
		return IED::NormalizePath(kept.View());
	}

	static Core::String PathArgument(const ToolInvocation& call, const char* name) { return ToolPath(call.m_Args.Member(name).AsView()); }

	// The file fs_read reads: a workspace path, or - by its absolute path, as the code tools show one - a file outside
	// the workspace that a language server named (its file: URI).
	static Core::String ReadPath(const ToolInvocation& call) { return CodeQuery(call.m_Ws).FileOf(call.m_Args.Member("path").AsView()); }

	static ToolPlan ReadPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("fs.read(") + ReadPath(call).View()) + ")";
		plan.m_Summary = Core::String("Read ") + call.m_Args.Member("path").AsView();
		return plan;
	}

	static ToolOutcome ReadRun(const ToolInvocation& call) {
		Core::String path = ReadPath(call);
		Core::String text;
		Core::String problem;
		if (path.View().StartsWith(Core::StringView("file:"))) {
			if (!IED::LspFileText(call.m_Ws, path.View(), text, problem)) return ToolError((Core::String("fs_read: ") + problem.View()).View());
		}
		else {
			IED::HostLock guard(*call.m_Context);
			text = TextAsEdited(call.m_Ws, path.View());
		}
		const int64 offset = call.m_Args.Member("offset").IsValid() ? call.m_Args.Member("offset").AsInt() : 1;
		const int64 limit = call.m_Args.Member("limit").IsValid() ? call.m_Args.Member("limit").AsInt() : c_ReadMostLines;
		Core::String numbered = NumberedLines(text.View(), offset, limit < c_ReadMostLines ? limit : c_ReadMostLines);
		Core::StringBuilder preview;
		preview.Append(call.m_Shown.View());
		preview.Append(path.View());
		preview.Append(" (");
		preview.AppendInt(SplitLines(text.View()).Count());
		preview.Append(" lines)");
		return ToolResult(numbered.View(), preview.View());
	}

	// The text a write would leave and the diff to it; `before` empty and `existed` false for a new file.
	static ToolPlan WritePlanFor(const ToolInvocation& call, Core::StringView verb, Core::StringView after, Core::StringView before, bool existed) {
		ToolPlan plan;
		Core::String path = PathArgument(call, "path");
		plan.m_Subject = (Core::String("fs.write(") + path.View()) + ")";
		plan.m_Summary = ((Core::String(existed ? verb : Core::StringView("Create")) + " ") + path.View());
		LineDiff diff = DiffLines(before, after, c_DiffContext);
		plan.m_Diff = diff.m_Unified;
		plan.m_Plus = diff.m_Plus;
		plan.m_Minus = diff.m_Minus;
		return plan;
	}

	static bool CurrentText(const ToolInvocation& call, Core::StringView path, Core::String& text) {
		IED::HostLock guard(*call.m_Context);
		if (!IED::Exists(call.m_Ws, path)) return false;
		text = TextAsEdited(call.m_Ws, path);
		return true;
	}

	static ToolPlan WritePlan(const ToolInvocation& call) {
		Core::String path = PathArgument(call, "path");
		Core::String before;
		const bool existed = CurrentText(call, path.View(), before);
		return WritePlanFor(call, Core::StringView("Overwrite"), call.m_Args.Member("content").AsView(), before.View(), existed);
	}

	// The file as its language server formats it, written over `text` (AfterWrite.ch); `text` when it is not formatted,
	// with why in `note`, and `note` saying how much formatting changed. The diagnostics wanted are then the formatted
	// text's: `after.mark` moves past those of `text`.
	static Core::String FormattedWrite(const ToolInvocation& call, Core::StringView path, Core::StringView text, AfterWrite& after, Core::String& note) {
		int64 tabSize = 4;
		bool insertSpaces = false;
		IndentationOf(text, tabSize, insertSpaces);
		Core::String formatted;
		Core::String problem;
		if (!IED::LspFormatted(call.m_Ws, path, tabSize, insertSpaces, after.m_WaitMs, formatted, problem)) {
			note = (Core::String("Not formatted: ") + problem.View()) + "; the file is saved as you wrote it.";
			return Core::String(text);
		}
		if (formatted.View() == text) return formatted;
		if (after.m_Diagnostics) after.m_Mark = IED::LspPublishMark(call.m_Ws, path);
		{
			IED::HostLock guard(*call.m_Context);
			WriteThrough(call.m_Ws, path, formatted.View());
		}
		LineDiff change = DiffLines(text, formatted.View(), 0);
		Core::StringBuilder said;
		said.Append("Formatted by ");
		said.Append(after.m_Label.View());
		said.Append(": it changed ");
		said.AppendInt(change.m_Plus > change.m_Minus ? change.m_Plus : change.m_Minus);
		said.Append(" of the lines you wrote, so read them again before an fs_edit near them.");
		note = said.ToString();
		return formatted;
	}

	// Writes `text` over `before` and says so, with what follows a write (AfterWrite.ch): the file formatted when its
	// language asks for it, and what its language server then says of it - information, never a failure.
	static ToolOutcome Written(const ToolInvocation& call, Core::StringView path, Core::StringView before, Core::StringView text, const ToolPlan& plan) {
		AfterWrite after = AfterWriteOf(call, path);
		{
			IED::HostLock guard(*call.m_Context);
			WriteThrough(call.m_Ws, path, text);
		}
		Core::String formatNote;
		Core::String saved = after.m_Format ? FormattedWrite(call, path, text, after, formatNote) : Core::String(text);
		LineDiff diff;
		diff.m_Unified = plan.m_Diff;
		diff.m_Plus = plan.m_Plus;
		diff.m_Minus = plan.m_Minus;
		if (saved.View() != text) diff = DiffLines(before, saved.View(), c_DiffContext);
		Core::StringBuilder said;
		said.Append(call.m_Shown.View());
		said.Append(path);
		said.Append(": +");
		said.AppendInt(diff.m_Plus);
		said.Append(" -");
		said.AppendInt(diff.m_Minus);
		said.Append(" lines, saved");
		if (!formatNote.IsEmpty()) {
			said.Append("\n");
			said.Append(formatNote.View());
		}
		Core::String answer;
		Core::String problem;
		if (after.m_Diagnostics && IED::LspDiagnosticsAfter(call.m_Ws, path, after.m_Mark, after.m_WaitMs, answer, problem)) answer = DiagnosticsSaid(answer.View(), after.m_WaitMs);
		else if (after.m_Diagnostics) answer = (Core::String("Language server: no diagnostics (") + problem.View()) + ")";
		if (!answer.IsEmpty()) {
			said.Append("\n");
			said.Append(answer.View());
		}
		ToolOutcome outcome = ToolResult(said.View(), diff.m_Unified.View());
		outcome.m_Plus = diff.m_Plus;
		outcome.m_Minus = diff.m_Minus;
		return outcome;
	}

	static ToolOutcome WriteRun(const ToolInvocation& call) {
		Core::String path = PathArgument(call, "path");
		Core::String before;
		CurrentText(call, path.View(), before);
		return Written(call, path.View(), before.View(), call.m_Args.Member("content").AsView(), WritePlan(call));
	}

	static ToolPlan EditPlan(const ToolInvocation& call) {
		Core::String path = PathArgument(call, "path");
		Core::String before;
		if (!CurrentText(call, path.View(), before)) {
			ToolPlan missing;
			missing.m_Error = (Core::String("fs_edit: ") + path.View()) + " does not exist; create it with fs_write";
			return missing;
		}
		Core::String after;
		Core::String error;
		if (!ApplyTextEdits(before.View(), call.m_Args.Member("edits"), after, error)) {
			ToolPlan failed;
			failed.m_Error = (Core::String("fs_edit ") + path.View()) + ": " + error.View() + "; nothing was changed";
			return failed;
		}
		return WritePlanFor(call, Core::StringView("Edit"), after.View(), before.View(), true);
	}

	static ToolOutcome EditRun(const ToolInvocation& call) {
		ToolPlan plan = EditPlan(call);
		if (!plan.m_Error.IsEmpty()) return ToolError(plan.m_Error.View());
		Core::String path = PathArgument(call, "path");
		Core::String before;
		CurrentText(call, path.View(), before);
		Core::String after;
		Core::String error;
		ApplyTextEdits(before.View(), call.m_Args.Member("edits"), after, error);
		return Written(call, path.View(), before.View(), after.View(), plan);
	}

	static bool Excluded(Core::StringView path) {
		for (const Core::String& glob : IED::DefaultExcludes())
			if (IED::GlobMatch(glob.View(), path)) return true;
		return false;
	}

	// `shown` goes before each path: the root's alias, so the paths can be passed back ("ied:/").
	static void ListFolder(const FS::Path& root, Core::StringView folder, Core::StringView shown, int64 depth, int64 most, Core::StringBuilder& out, int64& count) {
		FS::Directory listing = FS::Directory((folder.IsEmpty() ? root : root / folder).CStr());
		for (FS::DirectoryEntry& entry : listing) {
			if (count >= most) return;
			Core::String path = folder.IsEmpty() ? entry.name : (Core::String(folder) + "/") + entry.name.View();
			if (Excluded(path.View())) continue;
			const bool directory = entry.kind == FS::EntryKind::Directory;
			out.Append(shown);
			out.Append(path.View());
			out.Append(directory ? "/\n" : "\n");
			count += 1;
			if (directory && depth > 1) ListFolder(root, path.View(), shown, depth - 1, most, out, count);
		}
	}

	static ToolPlan ListPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("fs.read(") + PathArgument(call, "path").View()) + ")";
		plan.m_Summary = Core::String("List ") + call.m_Args.Member("path").AsView();
		return plan;
	}

	static ToolOutcome ListRun(const ToolInvocation& call) {
		Core::String path = PathArgument(call, "path");
		const int64 depth = call.m_Args.Member("depth").IsValid() ? call.m_Args.Member("depth").AsInt() : 2;
		if (!FS::IsDirectory((FS::Path(call.m_Ws.m_Root.View()) / path.View()).CStr())) return ToolError((Core::String("fs_list: no folder ") + path.View() + "; use fs_glob to find files by name").View());
		Core::StringBuilder out;
		int64 count = 0;
		ListFolder(FS::Path(call.m_Ws.m_Root.View()), path.View(), call.m_Shown.View(), depth < 1 ? 1 : depth > 6 ? 6 : depth, c_ListMostEntries, out, count);
		if (count >= c_ListMostEntries) out.Append("[stopped at 400 entries; list a subfolder or use fs_glob]\n");
		Core::StringBuilder preview;
		preview.AppendInt(count);
		preview.Append(" entries");
		return ToolResult(out.View(), preview.View());
	}

	static ToolPlan GlobPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.m_Subject = (Core::String("fs.read(") + call.m_Args.Member("pattern").AsView()) + ")";
		plan.m_Summary = Core::String("Find ") + call.m_Args.Member("pattern").AsView();
		return plan;
	}

	static ToolOutcome GlobRun(const ToolInvocation& call) {
		Core::String root = ToolPath(call.m_Args.Member("root").AsView());
		Core::Array<Core::String> found = IED::ExpandGlob((FS::Path(call.m_Ws.m_Root.View()) / root.View()).View(), call.m_Args.Member("pattern").AsView());
		Core::StringBuilder out;
		for (int64 i = 0; i < found.Count() && i < c_GlobMostPaths; ++i) {
			out.Append(call.m_Shown.View());
			if (!root.IsEmpty()) {
				out.Append(root.View());
				out.Append("/");
			}
			out.Append(found[i].View());
			out.Append("\n");
		}
		if (found.Count() > c_GlobMostPaths) out.Append("[more than 200 files; narrow the pattern]\n");
		if (found.IsEmpty()) out.Append("[no file matches; patterns are like src/**/*.txt]\n");
		Core::StringBuilder preview;
		preview.AppendInt(found.Count());
		preview.Append(found.Count() == 1 ? " file" : " files");
		return ToolResult(out.View(), preview.View());
	}

	static ToolSpec* Spec(const char* name, const char* description, const char* parameters, ToolClass toolClass, bool inPlan) {
		ToolSpec* spec = new ToolSpec();
		spec->m_Name = Core::String(name);
		spec->m_Description = Core::String(description);
		spec->m_Parameters = Core::String(parameters);
		spec->m_ToolClass = toolClass;
		spec->m_ParallelSafe = toolClass == ToolClass::Read;
		spec->m_InPlan = inPlan;
		return spec;
	}

	void AddFileTools(ToolRegistry& registry) {
		ToolSpec* read = Spec("fs_read", "Read a text file with line numbers - a workspace file, or by its absolute path a file outside it that the code tools named. Up to 400 lines per call; use offset to read on. For one function or type, code_read_symbol reads just it. Example: fs_read({\"path\": \"src/game/player.txt\", \"offset\": 120, \"limit\": 80})",
			"{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\", \"description\": \"workspace-relative path; plugins:/<plugin id>/<path> for a plugin's files (read-only)\"}, \"offset\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"first line, 1-based\"}, \"limit\": {\"type\": \"integer\", \"minimum\": 1}}, \"required\": [\"path\"], \"additionalProperties\": false}",
			ToolClass::Read, true);
		read->m_Plan = ReadPlan;
		read->m_Run = ReadRun;
		read->m_FolderRoots = true;
		registry.Add(read);
		ToolSpec* write = Spec("fs_write", "Create a file, or replace a whole file's content. For a change to part of a file use fs_edit. Example: fs_write({\"path\": \"docs/notes.md\", \"content\": \"...\"})",
			"{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"], \"additionalProperties\": false}",
			ToolClass::Write, false);
		write->m_Plan = WritePlan;
		write->m_Run = WriteRun;
		registry.Add(write);
		ToolSpec* edit = Spec("fs_edit", "Replace exact text in a file: each edit's old text must occur once (or set replace_all); all edits apply or none. Copy old exactly from fs_read, without the line numbers; for a long block, clipboard_copy its lines and write old as {{clip:<name>}}. Example: fs_edit({\"path\": \"src/config.txt\", \"edits\": [{\"old\": \"count = 0\", \"new\": \"count = 1\"}]})",
			"{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"edits\": {\"type\": \"array\", \"minItems\": 1, \"items\": {\"type\": \"object\", \"properties\": {\"old\": {\"type\": \"string\"}, \"new\": {\"type\": \"string\"}, \"replace_all\": {\"type\": \"boolean\"}}, \"required\": [\"old\", \"new\"], \"additionalProperties\": false}}}, \"required\": [\"path\", \"edits\"], \"additionalProperties\": false}",
			ToolClass::Write, false);
		edit->m_Plan = EditPlan;
		edit->m_Run = EditRun;
		registry.Add(edit);
		ToolSpec* list = Spec("fs_list", "List a folder's files and folders (folders end in /), skipping build output and .git. Example: fs_list({\"path\": \"src\", \"depth\": 2})",
			"{\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\", \"description\": \"workspace-relative folder; empty for the root; plugins:/ for the plugins' folders\"}, \"depth\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 6}}, \"required\": [\"path\"], \"additionalProperties\": false}",
			ToolClass::Read, true);
		list->m_Plan = ListPlan;
		list->m_Run = ListRun;
		list->m_FolderRoots = true;
		registry.Add(list);
		ToolSpec* glob = Spec("fs_glob", "Find files by a glob over their workspace-relative paths ('*' within a folder, '**' across folders, {a,b} either). Example: fs_glob({\"pattern\": \"**/*Log*\"})",
			"{\"type\": \"object\", \"properties\": {\"pattern\": {\"type\": \"string\"}, \"root\": {\"type\": \"string\", \"description\": \"a folder to search under\"}}, \"required\": [\"pattern\"], \"additionalProperties\": false}",
			ToolClass::Read, true);
		glob->m_Plan = GlobPlan;
		glob->m_Run = GlobRun;
		glob->m_FolderRoots = true;
		registry.Add(glob);
	}
}
