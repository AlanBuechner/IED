namespace Ai
{
	static int64 RunNowMs() { return Platform::UnixTimeNs() / 1000000; }

	void StartRun(Chats* chats, Chat* chat, const IED::Workspace& ws) {
		TurnRun* runner = new TurnRun();
		runner->context = chats->context;
		runner->chats = chats;
		runner->chat = chat;
		runner->run = chat->run;
		runner->turn = chat->run->turn;
		runner->ws = ws;
		chats->context->StartThread([runner]() { runner->Execute(); });
	}

	void TurnRun::Execute() {
		try {
			if (Prepare()) {
				ResolveMessage();
				while (!ending) Step();
			}
		}
		catch (IED::RpcError& error) {
			Failed(error.message.View(), Platform::StackText().View());
		}
		catch (...) {
			Failed(Core::StringView(""), Platform::StackText().View());
		}
		EndClaude();
		End();
	}

	void TurnRun::Failed(Core::StringView message, Core::StringView stack) {
		Core::StringBuilder line;
		line.Append("chat ");
		line.Append(chat->chatId.View());
		line.Append(": turn ");
		line.Append(turn->turnId.View());
		line.Append(" ended on an exception nothing caught");
		if (!message.IsEmpty()) {
			line.Append(": ");
			line.Append(message);
		}
		line.AppendByte('\n');
		line.Append(stack);
		context->Log(line.View());
		Core::StringBuilder note;
		note.Append("IED stopped this turn: its own code failed");
		if (!message.IsEmpty()) {
			note.Append(" (");
			note.Append(message);
			note.Append(")");
		}
		note.Append(". Where it failed is in the server's log, logs/server.log.");
		IED::HostLock guard(*context);
		UiNote(Core::StringView("harness_error"), note.View());
		ending = true;
		pausing = false;
		stop = Core::String("harness_error");
	}

	// --- Preparing ---------------------------------------------------------------------------------------------------

	static Core::String SettingString(IED::PluginContext* context, const IED::Workspace& ws, const char* key) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Core::String json = context->Setting(Core::StringView(key), WsId(ws));
		return Core::String(Serialization::ReadJson(json.View(), *doc).root.AsView());
	}

	static Core::String AgentsMd(const IED::Workspace& ws) {
		FS::Path file = FS::Path(ws.root.View()) / "AGENTS.md";
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	static Core::String WorkspaceSummary(const IED::Workspace& ws) {
		Core::StringBuilder out;
		out.Append("Name: ");
		out.Append(ws.name.View());
		out.Append(" (a ");
		out.Append(ws.kind.View());
		out.Append(" workspace)\nRoot: ");
		out.Append(FS::Path(ws.root.View()).View());
		out.Append("\nPaths in tools are relative to the root, with / separators.");
		if (!ws.projects.IsEmpty()) {
			out.Append("\nProjects:");
			for (const IED::Project& project : ws.projects) {
				out.Append(" ");
				out.Append(project.name.View());
				out.Append(" (");
				out.Append(project.kind.View());
				out.Append(")");
			}
		}
		if (!ws.trusted) out.Append("\nThe workspace is not trusted: commands and builds cannot run until the owner trusts it.");
		return out.ToString();
	}

	bool TurnRun::Prepare() {
		IED::HostLock guard(*context);
		Core::Array<Core::String> problems;
		Core::Array<ModelProfile*> models = ReadModels(context->Setting(Core::StringView("ai.models"), WsId(ws)).View(), problems);
		for (const Core::String& problem : problems) context->Log(problem.View());
		Core::String groups = context->Setting(Core::StringView("ai.groups"), WsId(ws));
		candidates = TurnCandidates(models, groups.View(), turn->group.View(), chat->agent.View(), Core::StringView(ChatModeName(turn->mode)), chat->pinnedModel.View(), role);
		rules = ReadPermissionRules(context->Setting(Core::StringView("ai.permissions"), WsId(ws)).View());
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		maxSteps = Serialization::ReadJson(context->Setting(Core::StringView("ai.maxSteps"), WsId(ws)).View(), *doc).root.AsInt();
		if (maxSteps < 0) maxSteps = 0;
		const bool configured = !candidates.IsEmpty();
		Core::String claudeOut = ChooseClaude();
		if (configured && candidates.IsEmpty()) {
			Pause(Core::StringView("usage_limit"), claudeOut.View());
			return false;
		}
		if (!candidates.IsEmpty()) turn->model = candidates[0]->name;
		if (candidates.IsEmpty()) {
			UiNote(Core::StringView("no_model"), Core::StringView(kClaudeSubscriptionOffered ? "No model is set up for this chat: sign in to Claude with your Pro or Max subscription in Settings > AI > Claude, or add a model to ai.models (an OpenAI-compatible endpoint) in Settings." : "No model is set up for this chat: add one to ai.models (an OpenAI-compatible endpoint) and, optionally, a group to ai.groups, in Settings."));
			Finish(Core::StringView("no_model"));
			return false;
		}
		Core::Array<Core::String> contributed;
		tools = TurnTools(chats, chat, ws, contributed);
		system = TurnSystem(chats, chat, ws, tools, turn->userText.View(), models, contributed);
		for (const Core::String& problem : contributed) context->Log(problem.View());
		return true;
	}

	ToolRegistry* TurnTools(Chats* chats, Chat* chat, const IED::Workspace& ws, Core::Array<Core::String>& contributed) {
		IED::PluginContext* context = chats->context;
		ToolRegistry* tools = ToolsFor(context, ws, contributed);
		AddChatTools(*tools, chats, chat);
		AddClipboardTools(*tools, chats, chat);
		AddModelTools(*tools, chats, chat);
		AddBackgroundTools(*tools, chats, chat);
		AddAgentTools(*tools, chats, chat, ws);
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		if (Serialization::ReadJson(context->Setting(Core::StringView("ai.tools.loadAll"), WsId(ws)).View(), *doc).root.AsBool()) tools->LoadAll();
		return tools;
	}

	Core::String TurnSystem(Chats* chats, Chat* chat, const IED::Workspace& ws, ToolRegistry* tools, Core::StringView userText, const Core::Array<ModelProfile*>& models,
		Core::Array<Core::String>& contributed) {
		IED::PluginContext* context = chats->context;
		SystemContext prompt;
		prompt.agentsMd = AgentsMd(ws);
		prompt.sections = PluginSections(context, ws, contributed);
		prompt.workspace = WorkspaceSummary(ws);
		prompt.skills = SkillsIndex(SkillsOf(context, ws, contributed), userText, DefaultSkillsIndexLimits());
		prompt.docs = DocsIndex(DocsOf(context, ws, contributed));
		prompt.deferred = tools->DeferredIndex(chat->mode, chat->loadedTools);
		prompt.agents = AgentsSection(AgentsOf(chats, chat, ws), models);
		return chats->prompts.System(chat->mode, prompt);
	}

	Core::String MeterFromTurns(Chats* chats, Chat* chat, const IED::Workspace& ws) {
		IED::PluginContext* context = chats->context;
		Core::Array<Core::String> problems;
		Core::Array<ModelProfile*> models = ReadModels(context->Setting(Core::StringView("ai.models"), WsId(ws)).View(), problems);
		Core::String group;
		Core::String roleEffort;
		Core::String model = chats->NextModel(chat, ws, group, roleEffort);
		ModelProfile* profile = FindModel(models, model.View());
		const bool claude = profile && profile->IsClaude();
		Core::Array<Core::String> contributed;
		ToolRegistry* tools = TurnTools(chats, chat, ws, contributed);
		Core::String system = TurnSystem(chats, chat, ws, tools, chat->Current() ? chat->Current()->userText.View() : Core::StringView(""), models, contributed);
		Core::Array<ContextPart> parts = ContextParts(chat, system.ByteLength(), ToolsSent(tools, chat->mode, chat->loadedTools, claude).ByteLength());
		int64 used = 0;
		for (int64 i = chat->turns.Count() - 1; i >= 0 && used == 0; --i) used = chat->turns[i]->tokensIn;
		if (used == 0)
			for (const ContextPart& part : parts) used += part.tokens;
		return ContextJson(profile ? chats->WindowOf(profile) : 0, used, model.View(), claude, ScaledParts(parts, used));
	}

	// What the owner's message names, read now, and its attachments, into the message the model is sent (mentions.ch):
	// the turn's stored message, so later steps, a retry and the transcript keep what the model saw.
	void TurnRun::ResolveMessage() {
		Core::Array<Mention> mentions;
		Core::Array<Attachment> attachments;
		{
			IED::HostLock guard(*context);
			mentions = turn->mentions;
			attachments = turn->attachments;
		}
		if (mentions.IsEmpty() && attachments.IsEmpty()) return;
		ToolInvocation call;
		call.context = context;
		call.ws = ws;
		call.chat = chat;
		call.callId = Core::String("mention");
		call.cancelled = &run->cancelled;
		Core::StringBuilder added;
		for (const Mention& mention : mentions) {
			added.Append("\n\n");
			added.Append(MentionBlock(mention, ReadMention(*tools, call, mention).View()).View());
		}
		Core::Array<IED::ToolImage> images;
		for (const Attachment& attachment : attachments) {
			if (!AttachedImage(attachment)) {
				added.Append("\n");
				added.Append(AttachedNote(attachment).View());
				continue;
			}
			IED::ToolImage image;
			image.mime = attachment.mime;
			image.path = attachment.path;
			images.Push(image);
		}
		IED::HostLock guard(*context);
		ModelMessage* message = turn->messages[0];
		message->content = message->content + added.View();
		message->images = images;
		SaveRunning();
	}

	// --- A step ------------------------------------------------------------------------------------------------------

	// A profile's server is asked once per server run (docs/12 "Truth about the model's context window"): the window it
	// reports, for a profile that names none, whether it streams prompt progress and whether it takes images, for a
	// profile that does not say; a server that did not answer is asked again a minute later. The lock is not held.
	void TurnRun::Discover() {
		ModelProfile* profile = candidates[candidate];
		if (profile->IsClaude()) return;
		bool asked = false;
		int64 failedMs = 0;
		{
			IED::HostLock guard(*context);
			chats->probed.TryGet(profile->name, asked);
			chats->probeFailedMs.TryGet(profile->name, failedMs);
		}
		if (asked || (failedMs > 0 && ChatNowMs() - failedMs < kRunProbeRetryMs)) return;
		ModelProbe probe = ProbeModel(*profile, kProbeTimeoutMs);
		IED::HostLock guard(*context);
		if (!probe.ok) {
			chats->probeFailedMs.At(profile->name) = ChatNowMs();
			return;
		}
		chats->probed.At(profile->name) = true;
		chats->llamaCpp.At(profile->name) = probe.server == "llama.cpp";
		chats->seesImages.At(profile->name) = probe.vision;
		chats->LearnWindow(profile->name.View(), probe.contextWindow);
	}

	void TurnRun::Step() {
		Discover();
		const bool onClaude = candidates[candidate]->IsClaude();
		StepRequest request;
		int64 estimate = 0;
		int64 estimateBefore = 0;
		{
			IED::HostLock guard(*context);
			if (run->cancelled) {
				Finish(Core::StringView("user_cancelled"));
				return;
			}
			if (maxSteps > 0 && steps >= maxSteps) {
				Pause(Core::StringView("budget"), Core::StringView("the turn used its step budget (ai.maxSteps); send a message to continue"));
				return;
			}
			if (maxSteps > 0 && steps == maxSteps * 8 / 10 && steps > 0) {
				Core::Array<Core::String> values;
				values.Push(Core::String("percent"));
				values.Push(Core::String("80"));
				values.Push(Core::String("budget"));
				values.Push(Core::String("steps"));
				HarnessNote(Core::StringView("budget_warning"), chats->prompts.Note("budget_warning", values).View());
			}
			DeliverSteering();
			if (!onClaude) {
				if (Window() > 0 && CalibratedTokens() * 100 > Window() * kContextCompressAtPercent && Compress()) turn->recoveries.Push(Core::String("compressed the context at 85%"));
				request = Request();
				estimate = request.promptTokens;
				EstimatePrefill(request);
			}
			estimateBefore = EstimateTokens();
			SaveRunning();
		}
		steps += 1;
		TurnRun* self = this;
		StepEvents events = [self](StepEventKind kind, Core::StringView delta, int64 call) { self->OnEvent(kind, delta, call); };
		StepResult* result = onClaude ? ClaudeStep(events) : RunStep(request, events, &run->cancelled);
		{
			IED::HostLock guard(*context);
			CloseStreaming();
			Prefill(Core::StringView(""));
			Account(result, estimate, estimateBefore);
		}
		Handle(Classify(*result), result);
		callSegments.Clear();
	}

	// Whether every call's arguments are JSON: a reply cut by max_tokens after its calls were complete.
	static bool CallsComplete(const StepResult* result) {
		if (result->calls.IsEmpty()) return false;
		for (ToolCallDraft* call : result->calls) {
			Serialization::DomNode args;
			if (!ReadToolArguments(call->arguments.View(), args)) return false;
		}
		return true;
	}

	static bool IsTransport(StepVerdict verdict) { return verdict == StepVerdict::ConnectFailed || verdict == StepVerdict::HttpError; }

	static bool IsCut(StepVerdict verdict) {
		return verdict == StepVerdict::Disconnected || verdict == StepVerdict::StalledPrefill || verdict == StepVerdict::StalledStream || verdict == StepVerdict::StepCap;
	}

	void TurnRun::Handle(StepVerdict verdict, StepResult* result) {
		if (verdict == StepVerdict::ToolCalls || (verdict == StepVerdict::MaxTokens && CallsComplete(result))) {
			{
				IED::HostLock guard(*context);
				Progress();
				RecordAssistant(result, true);
			}
			ExecuteCalls(result);
			return;
		}
		if (IsTransport(verdict)) {
			Transport(verdict, result);
			return;
		}
		IED::HostLock guard(*context);
		if (verdict == StepVerdict::Cancelled) {
			RecordAssistant(result, false);
			Finish(Core::StringView("user_cancelled"));
		}
		else if (verdict == StepVerdict::Answer) {
			Progress();
			RecordAssistant(result, false);
			if (chat->mode != ChatMode::Agent) Finish(Core::StringView("finished"));
			else NoProgress();
		}
		else if (verdict == StepVerdict::AnnouncedNoAction) {
			RecordAssistant(result, false);
			Core::String action;
			AnnouncesAction(result->text.View(), action);
			Core::Array<Core::String> values;
			values.Push(Core::String("action"));
			values.Push(action);
			Nudge("announced_no_action", 2, chats->prompts.Note("announced_no_action", values).View());
		}
		else if (verdict == StepVerdict::Repetition) Nudge("repetition", 2, chats->prompts.Note("repeated_output").View());
		else if (verdict == StepVerdict::Empty) Nudge("empty", 2, chats->prompts.Note("empty_reply").View());
		else if (verdict == StepVerdict::ReasoningOnly) Nudge("reasoning_only", 2, chats->prompts.Note("reasoning_only").View());
		else if (verdict == StepVerdict::MaxTokens) {
			RecordAssistant(result, false);
			if (result->calls.IsEmpty()) Nudge("max_tokens", 3, chats->prompts.Note("continue_after_max_tokens").View());
			else {
				Core::Array<Core::String> values;
				values.Push(Core::String("tool"));
				values.Push(result->calls[result->calls.Count() - 1]->name);
				Nudge("max_tokens", 3, chats->prompts.Note("retry_tool_call_after_cut", values).View());
			}
		}
		else if (verdict == StepVerdict::UnparsedToolCall) {
			RecordAssistant(result, false);
			Nudge("unparsed_tool_call", 2, chats->prompts.Note("unparsed_tool_call").View());
		}
		else if (IsCut(verdict)) Retry(verdict, result, 2);
		else Overflow(result);
	}

	// --- Recovery ----------------------------------------------------------------------------------------------------

	void TurnRun::Progress() {
		counts.Clear();
		attempts = 0;
	}

	static Core::String Counted(Core::StringView what, int64 count) {
		Core::StringBuilder text;
		text.Append(what);
		text.Append(" (");
		text.AppendInt(count);
		text.Append("x)");
		return text.ToString();
	}

	// One more recovery of `reason` this step: the note goes to the model, or the chat pauses past `bound`.
	bool TurnRun::Nudge(const char* reason, int64 bound, Core::StringView note) {
		Core::String key = Core::String(reason);
		int64 count = 0;
		counts.TryGet(key, count);
		count += 1;
		counts.At(key) = count;
		if (count > bound) {
			Pause(Core::StringView(reason), ((Core::String("the model kept stopping the same way (") + reason) + ") after the harness's notes").View());
			return false;
		}
		const bool continuing = key == "max_tokens" || key == "disconnected_mid_stream" || key == "stalled_stream" || key == "stalled_prefill" || key == "step_cap";
		HarnessNote(Core::StringView(reason), note);
		turn->recoveries.Push(Counted(((Core::String(continuing ? "continued after " : "nudged after ") + reason)).View(), count));
		return true;
	}

	void TurnRun::NoProgress() {
		noProgress += 1;
		if (noProgress > kRunNoProgressBound) {
			Pause(Core::StringView("no_progress"), Core::StringView("the model replied several times without a tool call or finish"));
			return;
		}
		HarnessNote(Core::StringView("agent_no_finish"), chats->prompts.Note("agent_no_finish").View());
		turn->recoveries.Push(Counted(Core::StringView("nudged to act or finish"), noProgress));
	}

	void TurnRun::Retry(StepVerdict verdict, StepResult* result, int64 bound) {
		const char* reason = VerdictName(verdict);
		if (!result->text.View().Trimmed().IsEmpty()) {
			RecordAssistant(result, false);
			Nudge(reason, bound, chats->prompts.Note("continue_after_disconnect").View());
			return;
		}
		Core::String key = Core::String(reason);
		int64 count = 0;
		counts.TryGet(key, count);
		counts.At(key) = count + 1;
		if (count + 1 > bound) Pause(Core::StringView(reason), Core::StringView("the model server stopped answering"));
		else turn->recoveries.Push(Counted((Core::String("retried after ") + reason).View(), count + 1));
	}

	static int64 Backoff(int64 attempt, int64 retryAfterMs) {
		if (retryAfterMs > 0) return retryAfterMs < kRunMostBackoffMs ? retryAfterMs : kRunMostBackoffMs;
		const int64 base = (int64)1000 << (attempt - 1 < 5 ? attempt - 1 : 5);
		return base + (Platform::UnixTimeNs() / 1000) % (base / 4 + 1);
	}

	static Core::String TransportReason(StepVerdict verdict, const StepResult* result) {
		if (verdict == StepVerdict::ConnectFailed) return Core::String("connect_failed");
		Core::StringBuilder reason;
		reason.Append("http_error ");
		reason.AppendInt(result->httpStatus);
		return reason.ToString();
	}

	void TurnRun::Transport(StepVerdict verdict, StepResult* result) {
		int64 waitMs = 0;
		{
			IED::HostLock guard(*context);
			if (!claudeBlocked.IsEmpty()) {
				ClaudeBlocked();
				return;
			}
			Core::String reason = TransportReason(verdict, result);
			Core::String error = result->completion->errored ? result->completion->errorMessage : result->error;
			const bool retryable = verdict == StepVerdict::ConnectFailed || result->httpStatus == 429 || result->httpStatus >= 500 || result->httpStatus == 200;
			if (!retryable) {
				Pause(reason.View(), ((reason + ": ") + error.View().Substring(0, error.ByteLength() < 400 ? error.ByteLength() : 400)).View());
				return;
			}
			attempts += 1;
			if (attempts >= kRunTransportAttempts) {
				Pause(reason.View(), ((reason + " after retries: ") + error.View().Substring(0, error.ByteLength() < 400 ? error.ByteLength() : 400)).View());
				return;
			}
			if (attempts >= kRunFallbackAfter && candidate + 1 < candidates.Count()) {
				candidate += 1;
				turn->model = candidates[candidate]->name;
				Core::String switched = ((Core::String("switched to ") + candidates[candidate]->name.View()) + " after ") + reason.View();
				UiNote(Core::StringView("routing"), switched.View());
				turn->recoveries.Push(switched);
				return;
			}
			turn->recoveries.Push(Counted((Core::String("retried after ") + reason.View()).View(), attempts));
			waitMs = Backoff(attempts, result->retryAfterMs);
		}
		Sleep(waitMs);
	}

	void TurnRun::Overflow(StepResult* result) {
		Core::String error = result->completion->errored ? result->completion->errorMessage : result->error;
		const int64 limit = ContextLimitIn(error.View());
		if (limit > 0) chats->LearnWindow(candidates[candidate]->name.View(), limit);
		Core::String key = Core::String("context_overflow");
		int64 count = 0;
		counts.TryGet(key, count);
		counts.At(key) = count + 1;
		if (count + 1 > 3) {
			Pause(key.View(), Core::StringView("the conversation does not fit the model's context, even compressed"));
			return;
		}
		if (Compress()) {
			turn->recoveries.Push(Counted(Core::StringView("compressed after context_overflow"), count + 1));
			return;
		}
		if (limit > 0 && EstimateTokens() < limit) {
			turn->recoveries.Push(Counted(Core::StringView("retried after context_overflow"), count + 1));
			return;
		}
		Pause(key.View(), Core::StringView("the conversation does not fit the model's context and nothing is left to compress"));
	}

	// Waits `ms` unless the run is stopped first; the lock is not held.
	bool TurnRun::Sleep(int64 ms) {
		IED::HostLock guard(*context);
		const int64 until = RunNowMs() + ms;
		while (!run->cancelled && RunNowMs() < until) guard.Wait(run->wake, (until - RunNowMs()) * 1000000);
		return !run->cancelled;
	}

	// --- Ending ------------------------------------------------------------------------------------------------------

	void TurnRun::Pause(Core::StringView reason, Core::StringView why) {
		if (ending) return;
		ending = true;
		pausing = true;
		stop = Core::String(reason);
		pauseWhy = Core::String(why);
	}

	// A turn about to finish with steering waiting goes on: the next step gives it to the model. The lock is held.
	void TurnRun::Finish(Core::StringView reason) {
		if (ending || (reason == "finished" && (!chat->injected.IsEmpty() || !claudeAside.IsEmpty() || chats->HasUntold(chat)))) return;
		ending = true;
		stop = Core::String(reason);
	}

	void TurnRun::End() {
		IED::HostLock guard(*context);
		CloseStreaming();
		for (Approval* approval : chat->approvals) {
			if (!approval->decision.IsEmpty()) continue;
			approval->decision = Core::String("withdrawn");
			IED::JsonWriter data;
			data.BeginObject();
			data.Field("approvalId", approval->approvalId.View());
			data.Field("decision", "withdrawn");
			data.EndObject();
			chats->Publish(chat, "approval.resolved", data.View());
		}
		chat->approvals.Clear();
		chat->question = nullptr;
		if (!chat->injected.IsEmpty()) {
			for (const Core::String& steering : chat->injected) {
				OwnerMessage* message = new OwnerMessage();
				message->text = steering;
				chat->queued.Push(message);
			}
			chat->injected.Clear();
			IED::JsonWriter queue;
			queue.BeginObject();
			queue.Key(Core::StringView("queued"));
			chat->WriteQueued(queue);
			queue.EndObject();
			chats->Publish(chat, "queue.changed", queue.View());
		}
		if (pausing) UiNote(Core::StringView("paused"), ((Core::String("Paused (") + stop.View()) + "): " + pauseWhy.View() + ". Send a message to continue.").View());
		CloseOpenCalls(turn, Core::StringView("The call did not run: the turn ended first."));
		turn->stop = stop;
		turn->endedMs = RunNowMs();
		chat->run = nullptr;
		chat->state = pausing ? ChatState::Paused : ChatState::Idle;
		chat->stateReason = pausing ? stop : Core::String();
		chat->updatedMs = turn->endedMs;
		AppendTurn(LocalStateOf(ws), chat, turn);
		ForgetRunningTurn(LocalStateOf(ws), chat);
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turn->turnId.View());
		data.Field("stop", stop.View());
		data.Key(Core::StringView("recoveries"));
		data.BeginArray();
		for (const Core::String& recovery : turn->recoveries) data.String(recovery.View());
		data.EndArray();
		data.IntField("tokensIn", turn->tokensIn);
		data.IntField("tokensOut", turn->tokensOut);
		data.IntField("ttftMs", turn->ttftMs);
		data.IntField("genMs", turn->genMs);
		data.IntField("endedMs", turn->endedMs);
		data.EndObject();
		chats->Publish(chat, "turn.end", data.View());
		chats->Changed(chat);
		chats->TurnEnded(chat);
	}
}
