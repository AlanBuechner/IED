include "classify.ch"

namespace Ai
{
	static StepVerdict TransportVerdict(const StepResult& step) {
		if (step.end == WireEnd::Cancelled) return StepVerdict::Cancelled;
		if (step.end == WireEnd::ConnectFailed) return StepVerdict::ConnectFailed;
		if (step.end == WireEnd::HttpError) return IsContextError(step.error.View()) ? StepVerdict::ContextOverflow : StepVerdict::HttpError;
		if (step.completion->errored) return IsContextError(step.completion->errorMessage.View()) ? StepVerdict::ContextOverflow : StepVerdict::HttpError;
		if (step.end == WireEnd::Disconnected) return StepVerdict::Disconnected;
		if (step.end == WireEnd::StalledPrefill) return StepVerdict::StalledPrefill;
		if (step.end == WireEnd::StalledStream) return StepVerdict::StalledStream;
		if (step.end == WireEnd::Repetition) return StepVerdict::Repetition;
		return StepVerdict::StepCap;
	}

	StepVerdict Classify(const StepResult& step) {
		if (step.end != WireEnd::Completed || step.completion->errored) return TransportVerdict(step);
		Core::StringView finish = step.completion->finishReason.View();
		if (finish == "length" || finish == "max_tokens") return StepVerdict::MaxTokens;
		if (!step.calls.IsEmpty()) return StepVerdict::ToolCalls;
		if (step.unparsedCall) return StepVerdict::UnparsedToolCall;
		if (step.text.View().Trimmed().IsEmpty()) return step.thinking.View().Trimmed().IsEmpty() ? StepVerdict::Empty : StepVerdict::ReasoningOnly;
		Core::String action;
		return AnnouncesAction(step.text.View(), action) ? StepVerdict::AnnouncedNoAction : StepVerdict::Answer;
	}

	const char* VerdictName(StepVerdict verdict) {
		const char*[16] names = {
			"tool_calls", "answer", "user_cancelled",
			"connect_failed", "http_error", "context_overflow", "disconnected_mid_stream", "stalled_prefill", "stalled_stream", "step_cap",
			"max_tokens", "empty", "reasoning_only", "announced_no_action", "unparsed_tool_call", "repetition"
		};
		return names[(int32)verdict];
	}

	// The reply's last sentence: after the last ". ", "! ", "? " or line break before its end.
	static Core::StringView LastSentence(Core::StringView text) {
		Core::StringView trimmed = text.Trimmed();
		int64 start = 0;
		for (int64 i = 0; i + 1 < trimmed.ByteLength() - 1; ++i) {
			const int32 c = trimmed.ByteAt(i);
			if (c == '\n' || ((c == '.' || c == '!' || c == '?') && trimmed.ByteAt(i + 1) == ' ')) start = i + 1;
		}
		return trimmed.Substring(start, trimmed.ByteLength() - start).Trimmed();
	}

	bool AnnouncesAction(Core::StringView text, Core::String& action) {
		Core::StringView sentence = LastSentence(text);
		Core::Regex polite = Core::Regex("(?i)^(?:let me know|i'?ll be|i will be|i'?m happy|let me explain)");
		if (polite.Contains(sentence)) return false;
		Core::Regex announced = Core::Regex("(?i)^(?:(?:now|next|first|then|so|ok|okay),?\\s+)?(?:let me|let's|i'?ll|i will|i am going to|i'?m going to|i need to|going to)\\s+(.*?)[.:]?$");
		Core::RegexMatch found;
		if (announced.Search(sentence, found)) {
			action = Core::String(found.Group(1).Trimmed());
			return !action.IsEmpty();
		}
		if (!sentence.EndsWith(Core::StringView(":"))) return false;
		action = Core::String("do what you announced");
		return true;
	}

	bool IsContextError(Core::StringView error) {
		Core::Regex context = Core::Regex("(?i)context[ _](?:length|size|window)|exceed_context_size|maximum context|too many tokens|prompt is too long");
		return context.Contains(error);
	}

	static int64 Digits(Core::StringView text) {
		int64 value = 0;
		for (int64 i = 0; i < text.ByteLength(); ++i) value = value * 10 + (text.ByteAt(i) - '0');
		return value;
	}

	int64 ContextLimitIn(Core::StringView error) {
		Core::Regex llamaCpp = Core::Regex("\"n_ctx\"\\s*:\\s*\"?(\\d+)");
		Core::Regex openAi = Core::Regex("(?i)maximum context length is (\\d+)");
		Core::RegexMatch found;
		if (llamaCpp.Search(error, found) || openAi.Search(error, found)) return Digits(found.Group(1));
		return 0;
	}
}
