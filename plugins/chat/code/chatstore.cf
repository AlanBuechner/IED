include "chatstore.ch"

namespace Ai
{
	FS::Path ChatFolder(const FS::Path& wsRoot, Core::StringView chatId) { return wsRoot / ".ied" / "local" / "chats" / chatId; }

	static void WriteWhole(const FS::Path& file, Core::StringView text) {
		FS::MakeDirectories(file.Parent().CStr());
		FS::WriteFileAtomically(file.CStr(), (const void*)text.Data(), text.ByteLength());
	}

	static Core::String ReadWhole(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	static Serialization::DomNode ParseJson(Core::StringView text) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text, *doc);
		return read.Ok() ? read.root : Serialization::DomNode();
	}

	void SaveChatHeader(const FS::Path& wsRoot, const Chat* chat) {
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("chatId", chat->chatId.View());
		json.Field("title", chat->title.View());
		json.Field("mode", ChatModeName(chat->mode));
		json.Field("permission", PermissionModeName(chat->permission));
		json.Field("group", chat->group.View());
		json.IntField("createdMs", chat->createdMs);
		json.IntField("updatedMs", chat->updatedMs);
		json.IntField("counter", chat->counter);
		json.Key(Core::StringView("tasks"));
		chat->WriteTasks(json);
		json.Key(Core::StringView("queued"));
		chat->WriteQueued(json);
		json.Key(Core::StringView("loadedTools"));
		json.BeginArray();
		for (const Core::String& name : chat->loadedTools) json.String(name.View());
		json.EndArray();
		json.Key(Core::StringView("allowed"));
		json.BeginArray();
		for (const Core::String& subject : chat->allowed) json.String(subject.View());
		json.EndArray();
		json.Key(Core::StringView("modified"));
		chat->WriteModified(json);
		json.EndObject();
		WriteWhole(ChatFolder(wsRoot, chat->chatId.View()) / "chat.json", json.View());
	}

	void AppendTurn(const FS::Path& wsRoot, const Chat* chat, const Turn* turn) {
		FS::Path folder = ChatFolder(wsRoot, chat->chatId.View());
		FS::MakeDirectories(folder.CStr());
		IED::JsonWriter json;
		turn->WriteJson(json, true);
		Core::String line = json.ToString() + "\n";
		FS::File out = FS::File((folder / "turns.jsonl").CStr(), "ab");
		out.Write((const void*)line.View().Data(), line.ByteLength());
		out.Sync();
	}

	void SaveRunningTurn(const FS::Path& wsRoot, const Chat* chat, const Turn* turn) {
		IED::JsonWriter json;
		turn->WriteJson(json, true);
		WriteWhole(ChatFolder(wsRoot, chat->chatId.View()) / "running.json", json.View());
	}

	void ForgetRunningTurn(const FS::Path& wsRoot, const Chat* chat) { FS::RemoveFile((ChatFolder(wsRoot, chat->chatId.View()) / "running.json").CStr()); }

	static void ReadHeader(Chat* chat, const Serialization::DomNode& header) {
		chat->title = Core::String(header.Member("title").AsView());
		ReadChatMode(header.Member("mode").AsView(), chat->mode);
		ReadPermissionMode(header.Member("permission").AsView(), chat->permission);
		chat->group = Core::String(header.Member("group").AsView());
		chat->createdMs = header.Member("createdMs").AsInt();
		chat->updatedMs = header.Member("updatedMs").AsInt();
		chat->counter = header.Member("counter").AsInt();
		Serialization::DomNode tasks = header.Member("tasks");
		for (int64 i = 0; i < tasks.Count(); ++i) {
			ChatTask* task = new ChatTask();
			task->id = Core::String(tasks.At(i).Member("id").AsView());
			task->title = Core::String(tasks.At(i).Member("title").AsView());
			task->status = Core::String(tasks.At(i).Member("status").AsView());
			task->note = Core::String(tasks.At(i).Member("note").AsView());
			chat->tasks.Push(task);
		}
		Serialization::DomNode queued = header.Member("queued");
		for (int64 i = 0; i < queued.Count(); ++i) chat->queued.Push(Core::String(queued.At(i).AsView()));
		Serialization::DomNode loaded = header.Member("loadedTools");
		for (int64 i = 0; i < loaded.Count(); ++i) chat->loadedTools.Push(Core::String(loaded.At(i).AsView()));
		Serialization::DomNode allowed = header.Member("allowed");
		for (int64 i = 0; i < allowed.Count(); ++i) chat->allowed.Push(Core::String(allowed.At(i).AsView()));
		Serialization::DomNode modified = header.Member("modified");
		for (int64 i = 0; i < modified.Count(); ++i) {
			ModifiedFile* file = new ModifiedFile();
			file->path = Core::String(modified.At(i).Member("path").AsView());
			file->plus = modified.At(i).Member("plus").AsInt();
			file->minus = modified.At(i).Member("minus").AsInt();
			chat->modified.Push(file);
		}
	}

	static void ReadTurns(Chat* chat, Core::StringView text) {
		int64 at = 0;
		while (at < text.ByteLength()) {
			int64 end = text.IndexOf('\n', at);
			if (end < 0) end = text.ByteLength();
			Serialization::DomNode node = ParseJson(text.Substring(at, end - at));
			if (node.Kind() == Serialization::DomKind::Object) {
				Turn* turn = new Turn();
				turn->Read(node);
				chat->turns.Push(turn);
			}
			at = end + 1;
		}
	}

	// Whether `message` answers the call `callId`.
	static bool Answers(const ModelMessage* message, Core::StringView callId) { return message->role == "tool" && message->toolCallId.View() == callId; }

	// The calls of the turn's messages that have no result get one saying the restart cut them off.
	void CloseOpenCalls(Turn* turn, Core::StringView note) {
		Core::Array<Core::String> open;
		for (ModelMessage* message : turn->messages) {
			if (message->toolCalls.IsEmpty()) continue;
			Serialization::DomNode calls = ParseJson(message->toolCalls.View());
			for (int64 i = 0; i < calls.Count(); ++i) open.Push(Core::String(calls.At(i).Member("id").AsView()));
		}
		for (const Core::String& callId : open) {
			bool answered = false;
			for (ModelMessage* message : turn->messages) answered = answered || Answers(message, callId.View());
			if (answered) continue;
			ModelMessage* result = new ModelMessage();
			result->role = Core::String("tool");
			result->toolCallId = callId;
			result->content = Core::String(note);
			turn->messages.Push(result);
		}
	}

	static void Interrupted(Chat* chat, const FS::Path& wsRoot, Turn* turn, Core::StringView note) {
		for (Segment* segment : turn->segments) {
			if (segment->type != "tool" || segment->state == "ok" || segment->state == "error" || segment->state == "denied") continue;
			segment->state = Core::String("interrupted");
			segment->preview = Core::String(note);
			segment->isError = true;
		}
		CloseOpenCalls(turn, note);
		turn->stop = Core::String("interrupted");
		turn->endedMs = ChatNowMs();
		chat->turns.Push(turn);
		chat->state = ChatState::Paused;
		chat->stateReason = Core::String("interrupted");
		AppendTurn(wsRoot, chat, turn);
		ForgetRunningTurn(wsRoot, chat);
	}

	static Chat* LoadChat(const FS::Path& wsRoot, Core::StringView wsId, Core::StringView chatId, Core::StringView note, Core::Array<Core::String>& problems) {
		FS::Path folder = ChatFolder(wsRoot, chatId);
		Serialization::DomNode header = ParseJson(ReadWhole(folder / "chat.json").View());
		if (header.Kind() != Serialization::DomKind::Object) {
			problems.Push((Core::String("chat ") + chatId) + ": chat.json is missing or not JSON");
			return nullptr;
		}
		Chat* chat = new Chat();
		chat->chatId = Core::String(chatId);
		chat->wsId = Core::String(wsId);
		ReadHeader(chat, header);
		ReadTurns(chat, ReadWhole(folder / "turns.jsonl").View());
		Serialization::DomNode running = ParseJson(ReadWhole(folder / "running.json").View());
		if (running.Kind() == Serialization::DomKind::Object) {
			Turn* turn = new Turn();
			turn->Read(running);
			Interrupted(chat, wsRoot, turn, note);
		}
		return chat;
	}

	Core::Array<Chat*> LoadChats(const FS::Path& wsRoot, Core::StringView wsId, Core::StringView interruptedNote, Core::Array<Core::String>& problems) {
		Core::Array<Chat*> chats;
		FS::Directory folder = FS::Directory((wsRoot / ".ied" / "local" / "chats").CStr());
		if (!folder.IsOpen()) return chats;
		for (FS::DirectoryEntry& entry : folder) {
			if (entry.kind != FS::EntryKind::Directory) continue;
			Chat* chat = LoadChat(wsRoot, wsId, entry.name.View(), interruptedNote, problems);
			if (chat) chats.Push(chat);
		}
		return chats;
	}

	void DeleteChatFiles(const FS::Path& wsRoot, Core::StringView chatId) { FS::RemoveAll(ChatFolder(wsRoot, chatId).CStr()); }
}
