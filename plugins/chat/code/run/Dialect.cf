include "api/Plugin.ch"
include "Dialect.ch"

namespace Ai
{
	const char* c_ThinkOpen = "<think>";
	const char* c_ThinkClose = "</think>";

	// How many bytes at the end of `text` could be the start of `tag`.
	static int64 PartialTag(Core::StringView text, Core::StringView tag) {
		const int64 most = text.ByteLength() < tag.ByteLength() - 1 ? text.ByteLength() : tag.ByteLength() - 1;
		for (int64 n = most; n > 0; --n)
			if (text.Substring(text.ByteLength() - n, n) == tag.Substring(0, n)) return n;
		return 0;
	}

	void ThinkSplitter::Feed(Core::StringView chunk, Core::String& thinking, Core::String& visible) {
		m_Held.Append(chunk);
		for (;;) {
			Core::StringView tag = m_InThink ? Core::StringView(c_ThinkClose) : Core::StringView(c_ThinkOpen);
			const int64 at = m_Held.View().IndexOf(tag);
			Core::String* into = m_InThink ? &thinking : &visible;
			if (at < 0) {
				const int64 keep = PartialTag(m_Held.View(), tag);
				into->Append(m_Held.View().Substring(0, m_Held.ByteLength() - keep));
				m_Held = Core::String(m_Held.View().Substring(m_Held.ByteLength() - keep, keep));
				return;
			}
			into->Append(m_Held.View().Substring(0, at));
			m_Held = Core::String(m_Held.View().Substring(at + tag.ByteLength(), m_Held.ByteLength() - at - tag.ByteLength()));
			if (!m_InThink) m_SawThink = true;
			m_InThink = !m_InThink;
		}
	}

	void ThinkSplitter::Flush(Core::String& thinking, Core::String& visible) {
		Core::String* into = m_InThink ? &thinking : &visible;
		into->Append(m_Held.View());
		m_Held = Core::String();
	}

	// --- Tool calls as text ------------------------------------------------------------------------------------------

	static Serialization::DomNode ReadJsonNode(Core::StringView text) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::ReadResult read = Serialization::ReadJson(text, *doc);
		return read.Ok() ? read.root : Serialization::DomNode();
	}

	// {"name": ..., "arguments" | "parameters": {...}} as a call; false for anything else.
	static bool CallFromObject(const Serialization::DomNode& node, TextToolCall& call) {
		if (node.Kind() != Serialization::DomKind::Object || node.Member("name").Kind() != Serialization::DomKind::String) return false;
		Serialization::DomNode arguments = node.Member("arguments").IsValid() ? node.Member("arguments") : node.Member("parameters");
		if (!arguments.IsValid()) return false;
		call.m_Name = Core::String(node.Member("name").AsView());
		call.m_Arguments = arguments.Kind() == Serialization::DomKind::String ? Core::String(arguments.AsView()) : IED::NodeJson(arguments);
		return true;
	}

	// Qwen's <parameter=key>value</parameter> blocks as a JSON object: a value that reads as JSON is kept as JSON.
	static Core::String QwenArguments(Core::StringView body) {
		Core::Regex parameter = Core::Regex("(?s)<parameter=([^>\\s]+)>\\n?(.*?)\\n?</parameter>");
		IED::JsonWriter json;
		json.BeginObject();
		for (const Core::RegexMatch& found : parameter.FindAll(body)) {
			json.Key(found.Group(1));
			Core::StringView value = found.Group(2);
			if (ReadJsonNode(value).IsValid()) json.Raw(value);
			else json.String(value);
		}
		json.EndObject();
		return json.ToString();
	}

	// One dialect's calls in `text`: each match's span is recorded so the caller can cut it out.
	struct CallSpan
	{
		public int64 m_Start;
		public int64 m_End;
		public TextToolCall m_Call;
	}

	static void Hermes(Core::StringView text, Core::Array<CallSpan>& spans) {
		Core::Regex pattern = Core::Regex("(?s)<tool_call>\\s*(\\{.*?\\})\\s*</tool_call>");
		for (const Core::RegexMatch& found : pattern.FindAll(text)) {
			CallSpan span;
			if (!CallFromObject(ReadJsonNode(found.Group(1)), span.m_Call)) continue;
			span.m_Start = found.Start();
			span.m_End = found.End();
			spans.Push(span);
		}
	}

	static void Qwen(Core::StringView text, Core::Array<CallSpan>& spans) {
		Core::Regex pattern = Core::Regex("(?s)<tool_call>\\s*<function=([^>\\s]+)>(.*?)</function>\\s*</tool_call>");
		for (const Core::RegexMatch& found : pattern.FindAll(text)) {
			CallSpan span;
			span.m_Call.m_Name = Core::String(found.Group(1));
			span.m_Call.m_Arguments = QwenArguments(found.Group(2));
			span.m_Start = found.Start();
			span.m_End = found.End();
			spans.Push(span);
		}
	}

	static void Mistral(Core::StringView text, Core::Array<CallSpan>& spans) {
		Core::Regex list = Core::Regex("(?s)\\[TOOL_CALLS\\]\\s*(\\[.*\\])");
		Core::RegexMatch found;
		if (list.Search(text, found)) {
			Serialization::DomNode calls = ReadJsonNode(found.Group(1));
			for (int64 i = 0; calls.Kind() == Serialization::DomKind::Array && i < calls.Count(); ++i) {
				CallSpan span;
				if (!CallFromObject(calls.At(i), span.m_Call)) continue;
				span.m_Start = found.Start();
				span.m_End = found.End();
				spans.Push(span);
			}
			return;
		}
		Core::Regex named = Core::Regex("(?s)\\[TOOL_CALLS\\]\\s*([A-Za-z0-9_.\\-]+)\\[ARGS\\](\\{.*\\})");
		if (!named.Search(text, found) || !ReadJsonNode(found.Group(2)).IsValid()) return;
		CallSpan span;
		span.m_Call.m_Name = Core::String(found.Group(1));
		span.m_Call.m_Arguments = Core::String(found.Group(2));
		span.m_Start = found.Start();
		span.m_End = found.End();
		spans.Push(span);
	}

	static void FencedJson(Core::StringView text, Core::Array<CallSpan>& spans) {
		Core::Regex pattern = Core::Regex("(?s)```(?:json)?\\s*(\\{.*?\\})\\s*```");
		for (const Core::RegexMatch& found : pattern.FindAll(text)) {
			CallSpan span;
			if (!CallFromObject(ReadJsonNode(found.Group(1)), span.m_Call)) continue;
			span.m_Start = found.Start();
			span.m_End = found.End();
			spans.Push(span);
		}
	}

	static void Harmony(Core::StringView text, Core::Array<CallSpan>& spans) {
		Core::Regex pattern = Core::Regex("(?s)(?:<\\|start\\|>assistant)?<\\|channel\\|>\\S*\\s*to=functions\\.([A-Za-z0-9_\\-]+).*?<\\|message\\|>(.*?)<\\|call\\|>");
		for (const Core::RegexMatch& found : pattern.FindAll(text)) {
			CallSpan span;
			span.m_Call.m_Name = Core::String(found.Group(1));
			span.m_Call.m_Arguments = Core::String(found.Group(2).Trimmed());
			span.m_Start = found.Start();
			span.m_End = found.End();
			spans.Push(span);
		}
	}

	Core::Array<TextToolCall> ParseTextToolCalls(Core::StringView text, Core::String& rest) {
		Core::Array<CallSpan> spans;
		Hermes(text, spans);
		if (spans.IsEmpty()) Qwen(text, spans);
		if (spans.IsEmpty()) Mistral(text, spans);
		if (spans.IsEmpty()) Harmony(text, spans);
		if (spans.IsEmpty()) FencedJson(text, spans);
		Core::Array<TextToolCall> calls;
		Core::StringBuilder kept;
		int64 at = 0;
		for (const CallSpan& span : spans) {
			calls.Push(span.m_Call);
			if (span.m_Start < at) continue;
			kept.Append(text.Substring(at, span.m_Start - at));
			at = span.m_End;
		}
		kept.Append(text.Substring(at, text.ByteLength() - at));
		rest = Core::String(kept.View().Trimmed());
		return calls;
	}

	int64 TextToolCallStart(Core::StringView text) {
		Core::Regex opener = Core::Regex("<tool_call>|<function=|\\[TOOL_CALLS\\]|(?:<\\|start\\|>assistant)?<\\|channel\\|>\\S*\\s*to=functions\\.|```json\\s*\\{\\s*\"name\"");
		Core::RegexMatch found;
		return opener.Search(text, found) ? found.Start() : -1;
	}

	bool LooksLikeTextToolCall(Core::StringView text) { return TextToolCallStart(text) >= 0; }
}
