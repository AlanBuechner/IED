// effort: what a turn's effort sends - the profile's mapping, else llama.cpp's template variable or OpenAI's field - the
// chat's pick over its role's, and profiles whose mapping is not one (docs/04 "Model groups and roles").

include "Effort.ch"

static Core::StringView Text(const char* text) { return Core::StringView(text); }

static Ai::ModelProfile* OnlyProfile(const char* json) {
	Core::Array<Core::String> problems;
	Core::Array<Ai::ModelProfile*> models = Ai::ReadModels(Text(json), problems);
	return models.Count() == 1 ? models[0] : nullptr;
}

static Core::String Written(const Ai::ModelProfile* profile, const char* effort, bool llamaCpp) {
	IED::JsonWriter json;
	json.BeginObject();
	Ai::WriteEffort(json, *profile, Text(effort), llamaCpp);
	json.EndObject();
	return json.ToString();
}

[test("server.ai.effort")]
class EffortTests {
	[test("by_the_server")]
	public static void TestByServer() {
		Ai::ModelProfile* plain = OnlyProfile("{\"a\": {\"endpoint\": \"http://a/v1\"}}");
		assert_se("{\"chat_template_kwargs\":{\"reasoning_effort\":\"low\"}}", Written(plain, "low", true).CStr(), "llama.cpp: the chat template's variable");
		assert_se("{\"reasoning_effort\":\"high\"}", Written(plain, "high", false).CStr(), "another server: OpenAI's field");
		assert_se("{\"chat_template_kwargs\":{\"reasoning_effort\":\"xhigh\"}}", Written(plain, "xhigh", true).CStr(), "xhigh as it is");
		assert_se("{\"reasoning_effort\":\"max\"}", Written(plain, "max", false).CStr(), "max as it is");
		assert_se("{}", Written(plain, "", true).CStr(), "no effort: nothing sent");
	}

	[test("the_profiles_mapping")]
	public static void TestMapping() {
		Ai::ModelProfile* mapped = OnlyProfile("{\"q\": {\"endpoint\": \"http://q/v1\", \"effort\": {\"low\": {\"chat_template_kwargs\": {\"enable_thinking\": false}, \"top_k\": 20}, \"high\": {}, \"max\": {\"chat_template_kwargs\": {\"reasoning_effort\": \"xhigh\"}}}}}");
		assert_se("{\"chat_template_kwargs\":{\"enable_thinking\":false},\"top_k\":20}", Written(mapped, "low", true).CStr(), "its fields, as written");
		assert_se("{}", Written(mapped, "medium", true).CStr(), "a level it leaves out adds nothing");
		assert_se("{}", Written(mapped, "high", false).CStr(), "nor does an empty one");
		assert_se("{\"chat_template_kwargs\":{\"reasoning_effort\":\"xhigh\"}}", Written(mapped, "max", true).CStr(), "max maps like any level");
	}

	[test("a_mapping_that_is_not_one")]
	public static void TestNotAMapping() {
		Core::Array<Core::String> problems;
		Core::Array<Ai::ModelProfile*> models = Ai::ReadModels(Text("{\"x\": {\"endpoint\": \"http://x/v1\", \"effort\": {\"extreme\": {}}}, \"y\": {\"endpoint\": \"http://y/v1\", \"effort\": {\"low\": 1}}, \"z\": {\"endpoint\": \"http://z/v1\", \"effort\": \"low\"}}"), problems);
		assert_true(models.IsEmpty() && problems.Count() == 3, "an unknown level, a level that is not an object, a value that is not a mapping");
		assert_true(problems[0].View().StartsWith(Text("ai.models.x: effort must map low, medium, high, xhigh or max")), problems[0].CStr());
	}

	[test("the_chats_then_the_roles")]
	public static void TestWhichEffort() {
		assert_true(Ai::EffortOf(Text("low"), Text("high")) == "low", "the chat's pick");
		assert_true(Ai::EffortOf(Text(""), Text("high")) == "high", "else its role's");
		assert_true(Ai::EffortOf(Text(""), Text("")).IsEmpty(), "else none");
		assert_true(Ai::IsEffort(Text("medium")) && Ai::IsEffort(Text("xhigh")) && Ai::IsEffort(Text("max")), "the five levels");
		assert_true(!Ai::IsEffort(Text("extreme")) && !Ai::IsEffort(Text("Max")) && !Ai::IsEffort(Text("")), "nothing else");
	}
}
