include "Resume.ch"

namespace Ai
{
	// The turns IED resumed among the last ones a restart cut off.
	static int64 ResumedCutOff(const Chat* chat) {
		int64 count = 0;
		for (int64 i = chat->m_Turns.Count() - 1; i >= 0 && chat->m_Turns[i]->m_Stop == "interrupted"; --i)
			if (!chat->m_Turns[i]->m_Resumed.IsEmpty()) count += 1;
		return count;
	}

	Core::String ResumeReason(const Chat* chat, Core::StringView policy) {
		if (chat->m_Run) return Core::String();
		if (!chat->m_Resume.IsEmpty()) return Core::String("relaunch");
		const Turn* last = chat->Current();
		if (!last || last->m_Stop != "interrupted" || policy == "never") return Core::String();
		if (policy != "always" && chat->m_Mode != ChatMode::Agent) return Core::String();
		return ResumedCutOff(chat) < c_MostResumes ? Core::String("interrupted") : Core::String();
	}

	Core::String ResumeText(Core::StringView reason, Core::StringView tool) {
		if (reason == "relaunch") {
			return (Core::String("IED restarted onto its new build, as your call to ") + tool) + " asked, and this chat continues on it. Pick up the task where it stopped: check that what you changed works now, then go on.";
		}
		return Core::String("IED restarted while your last turn ran and cut it off; what its last call did is unknown. Pick up the task where it stopped: check the state of what it was doing before you redo anything.");
	}
}
