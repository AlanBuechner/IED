// hints: a plugin's advice under the output lines its pattern finds, each hint once and few in all.

include "Hints.ch"

static Ai::ErrorHint* Hint(const char* pattern, const char* text) {
	Ai::ErrorHint* hint = new Ai::ErrorHint();
	hint->m_Pattern = Core::Regex(pattern);
	hint->m_Text = Core::String(text);
	return hint;
}

[test("server.ai.hints")]
class HintsTests {
	[test("under_the_line")]
	public static void TestUnderTheLine() {
		Core::Array<Ai::ErrorHint*> hints;
		hints.Push(Hint("no matching overload of (push_back|size)", "Bedrock: Push, Count."));
		hints.Push(Hint("type not found: auto", "No auto in C4."));
		Core::String out = Ai::WithHints(Core::StringView("a.cf:3:2: error: no matching overload of push_back\r\nb.cf:9:1: error: no matching overload of size\nok line\n"), hints);
		assert_se("a.cf:3:2: error: no matching overload of push_back\n  hint: Bedrock: Push, Count.\nb.cf:9:1: error: no matching overload of size\nok line\n", out.CStr(), "once, under the first line it matches");
	}

	[test("nothing_to_add")]
	public static void TestNone() {
		Core::Array<Ai::ErrorHint*> none;
		assert_se("as is", Ai::WithHints(Core::StringView("as is"), none).CStr(), "no hints: the text unchanged");
		Core::Array<Ai::ErrorHint*> hints;
		hints.Push(Hint("never", "x"));
		assert_se("plain\n", Ai::WithHints(Core::StringView("plain"), hints).CStr(), "a hint that matches nothing adds nothing");
	}

	[test("at_most_a_few")]
	public static void TestMost() {
		Core::Array<Ai::ErrorHint*> hints;
		Core::StringBuilder text;
		for (int32 i = 0; i < 10; ++i) {
			Core::StringBuilder pattern;
			Core::Format(&pattern, "error {0}$", i);
			hints.Push(Hint(pattern.CStr(), "h"));
			Core::Format(&text, "error {0}\n", i);
		}
		Core::String out = Ai::WithHints(text.View(), hints);
		int64 shown = 0;
		for (int64 at = out.View().IndexOf(Core::StringView("hint:")); at >= 0; at = out.View().Substring(at + 1, out.ByteLength()).IndexOf(Core::StringView("hint:")) >= 0 ? at + 1 + out.View().Substring(at + 1, out.ByteLength()).IndexOf(Core::StringView("hint:")) : -1) shown += 1;
		assert_eq(Ai::c_HintsMostPerResult, shown, "capped");
	}
}
