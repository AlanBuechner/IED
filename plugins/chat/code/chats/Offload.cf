// Offloading idle chats (docs/04 "What stays in memory"): a chat no turn runs in lets its turns go once
// ai.chats.offloadAfterMinutes (10 by default) pass since a turn ran or something read them, with the events its topic
// kept for replay; only its header stays in memory. A tab showing it does not keep it: clients get its turns a page at
// a time from disk (Pages.ch). Whatever needs its turns in memory - a turn starting, a revert, Claude's count -
// calls Chats::Loaded first, which reads them back.

include "api/Plugin.ch"
include "ChatService.ch"
include "Pages.ch"

namespace Ai
{
	const double c_OffloadAfterMinutesDefault = 10.0;
	const int64 c_OffloadTickNs = 15000000000;   // how often the keeper looks
	const int64 c_ForgetNowMs = 9223372036854775807;   // a time past any page's: ForgetPageTurn lets it go now

	// ai.chats.offloadAfterMinutes of the workspace in ms; 0: chats stay loaded.
	static int64 OffloadAfterMs(IED::PluginContext* context, Core::StringView wsId) {
		Serialization::DomDoc* doc = new Serialization::DomDoc();
		Serialization::DomNode value = Serialization::ReadJson(context->Setting(Core::StringView("ai.chats.offloadAfterMinutes"), wsId).View(), *doc).root;
		const bool number = value.Kind() == Serialization::DomKind::Int || value.Kind() == Serialization::DomKind::Float;
		const double minutes = number ? value.AsFloat() : c_OffloadAfterMinutesDefault;
		return minutes > 0.0 ? (int64)(minutes * 60000.0) : 0;
	}

	void Chats::Loaded(Chat* chat) {
		chat->m_UsedMs = ChatNowMs();
		if (!chat->m_Offloaded) return;
		const int64 startedNs = Platform::UnixTimeNs();
		LoadTurns(LocalStateOf(WorkspaceOf(chat)), chat);
		Core::StringBuilder line;
		line.Append("chat ");
		line.Append(chat->m_ChatId.View());
		line.Append(" loaded from disk: ");
		line.AppendInt(chat->m_Turns.Count());
		line.Append(chat->m_Turns.Count() == 1 ? " turn in " : " turns in ");
		line.AppendInt((Platform::UnixTimeNs() - startedNs) / 1000000);
		line.Append(" ms");
		m_Context->Log(line.View());
	}

	void Chats::Offload(Chat* chat, const IED::Workspace& ws) {
		const int64 turns = chat->m_Turns.Count();
		OffloadTurns(chat);
		ForgetPageTurn(chat, c_ForgetNowMs);
		SaveChatHeader(LocalStateOf(ws), chat);
		m_Context->DropReplay(chat->Topic().View());
		Core::StringBuilder line;
		line.Append("chat ");
		line.Append(chat->m_ChatId.View());
		line.Append(" offloaded: ");
		line.AppendInt(turns);
		line.Append(turns == 1 ? " turn" : " turns");
		line.Append(" left on disk");
		m_Context->Log(line.View());
	}

	void Chats::OffloadIdle() {
		const int64 now = ChatNowMs();
		for (Chat* chat : m_Chats) {
			ForgetPageTurn(chat, now);
			if (chat->m_Offloaded) continue;
			if (chat->m_UsedMs == 0 || chat->m_Run) {
				chat->m_UsedMs = now;
				continue;
			}
			IED::Workspace ws;
			if (!IED::FindWorkspace(chat->m_WsId.View(), ws)) continue;
			const int64 after = OffloadAfterMs(m_Context, chat->m_WsId.View());
			if (after > 0 && now - chat->m_UsedMs >= after) Offload(chat, ws);
		}
	}

	void Chats::OffloadKeeper() {
		for (;;) {
			Threading::Thread::Sleep(c_OffloadTickNs);
			IED::HostLock guard(*m_Context);
			if (m_Stopping) return;
			OffloadIdle();
		}
	}
}
