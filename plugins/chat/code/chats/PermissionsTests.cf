// permissions: a tool whose every call asks (a toolCalls entry's approval "ask", docs/11) - an MCP server's by default.

include "Permissions.ch"

[test("server.ai.permissions")]
class AskUntilAllowedTests {
	[test("asks_in_auto_until_a_rule_allows_it")]
	public static void TestAsks() {
		Ai::PermissionRules rules;
		Core::Array<Core::String> chat;
		Core::StringView subject = Core::StringView("plugin(ied.mcp/mcp_blender_run)");
		Core::String why;
		Ai::Permit decided = Ai::Decide(Ai::PermissionMode::Auto, Ai::ToolClass::Exec, rules, chat, subject, why);
		assert_true(decided == Ai::Permit::Allow, "auto allows a command");
		assert_true(Ai::AskUntilAllowed(decided, Ai::ToolClass::Exec, rules, chat, subject, why) == Ai::Permit::Ask, "an asking tool still asks");
		assert_true(why.View().Contains(Core::StringView("asks until you allow it")), why.CStr());
		chat.Push(Ai::ChatAllowRule(subject));
		assert_true(Ai::AskUntilAllowed(decided, Ai::ToolClass::Exec, rules, chat, subject, why) == Ai::Permit::Allow, "Allow for this chat");
		Core::Array<Core::String> none;
		rules.m_Allow.Push(Core::String("plugin(ied.mcp/mcp_blender_*)"));
		assert_true(Ai::AskUntilAllowed(decided, Ai::ToolClass::Exec, rules, none, subject, why) == Ai::Permit::Allow, "an allow rule for the server's tools");
		assert_true(Ai::AskUntilAllowed(decided, Ai::ToolClass::Exec, Ai::PermissionRules(), none, Core::StringView("plugin(ied.mcp/mcp_other_run)"), why) == Ai::Permit::Ask, "not another server's");
		assert_true(Ai::AskUntilAllowed(decided, Ai::ToolClass::Read, Ai::PermissionRules(), none, subject, why) == Ai::Permit::Allow, "a read is not held back");
		assert_true(Ai::AskUntilAllowed(Ai::Permit::Deny, Ai::ToolClass::Exec, rules, chat, subject, why) == Ai::Permit::Deny, "a refusal stays one");
	}
}
