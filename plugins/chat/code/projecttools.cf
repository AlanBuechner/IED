include "projecttools.ch"
include "work.ch"

namespace Ai
{
	const int64 kProjectLogLines = 20;
	const int64 kProjectToolLogBytes = 2000;

	static Core::StringView Arg(const ToolInvocation& call, const char* name) { return call.args.Member(name).AsView(); }

	static Core::String Slashed(Core::StringView path) {
		Core::StringBuilder out;
		for (int64 i = 0; i < path.ByteLength(); ++i) out.AppendByte(path.ByteAt(i) == '\\' ? '/' : path.ByteAt(i));
		return out.ToString();
	}

	// "Game (executable, c4) in Game, file build/ied/Game.iedproj, depends on Engine"
	static void DescribeProject(Core::StringBuilder& out, const IED::Project& project) {
		out.Append("- ");
		out.Append(project.name.View());
		out.Append(" (");
		out.Append(project.kind.IsEmpty() ? Core::StringView("no kind") : project.kind.View());
		if (!project.language.IsEmpty()) {
			out.Append(", ");
			out.Append(project.language.View());
		}
		out.Append(") in ");
		out.Append(project.folder.IsEmpty() ? Core::StringView("the workspace's folder") : project.folder.View());
		out.Append(", file ");
		out.Append(project.file.View());
		for (int64 i = 0; i < project.references.Count(); ++i) {
			out.Append(i == 0 ? ", depends on " : ", ");
			out.Append(project.references[i].View());
		}
		out.Append("\n");
	}

	static void DescribeWorkspace(Core::StringBuilder& out, const IED::Workspace& ws) {
		out.Append("Workspace ");
		out.Append(ws.id.View());
		out.Append(" '");
		out.Append(ws.name.View());
		out.Append("': ");
		out.Append(ws.kind.View());
		out.Append(" at ");
		out.Append(Slashed(ws.root.View()).View());
		out.Append(ws.trusted ? ", trusted\n" : ", not trusted (nothing builds or runs there)\n");
		if (ws.kind != "solution") {
			out.Append("No projects: it is a folder. project_import({\"folder\": \".\"}) makes it a solution.\n");
			return;
		}
		out.AppendInt(ws.projects.Count());
		out.Append(ws.projects.Count() == 1 ? " project:\n" : " projects:\n");
		for (const IED::Project& project : ws.projects) DescribeProject(out, project);
	}

	// --- project_list ------------------------------------------------------------------------------------------------

	static ToolPlan ListPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.subject = Core::String("project.list()");
		plan.summary = Core::String("List the projects");
		return plan;
	}

	static ToolOutcome ListRun(const ToolInvocation& call) {
		IED::Workspace ws;
		if (!IED::FindWorkspace(call.ws.id.View(), ws)) return ToolError(Core::StringView("project_list: the workspace is not open any more"));
		Core::StringBuilder out;
		DescribeWorkspace(out, ws);
		bool others = false;
		for (const IED::Workspace& open : IED::Workspaces()) {
			if (open.id.View() == ws.id.View()) continue;
			out.Append(others ? "" : "Other open workspaces (this chat works in its own; the owner switches with the workspace switcher):\n");
			others = true;
			out.Append("- ");
			out.Append(open.id.View());
			out.Append(" '");
			out.Append(open.name.View());
			out.Append("': ");
			out.Append(open.kind.View());
			out.Append(" at ");
			out.Append(Slashed(open.root.View()).View());
			out.Append("\n");
		}
		Core::StringBuilder preview;
		preview.AppendInt(ws.projects.Count());
		preview.Append(ws.projects.Count() == 1 ? " project" : " projects");
		return ToolResult(out.View(), preview.View());
	}

	// --- project_templates -------------------------------------------------------------------------------------------

	static ToolPlan TemplatesPlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.subject = Core::String("project.templates()");
		plan.summary = Core::String("List the project templates");
		return plan;
	}

	static ToolOutcome TemplatesRun(const ToolInvocation& call) {
		Core::Array<IED::ProjectTemplate> templates;
		Core::String location;
		Core::String problem;
		if (!IED::ProjectTemplates(call.ws.id.View(), templates, location, problem)) return ToolError((Core::String("project_templates: ") + problem.View()).View());
		Core::StringBuilder out;
		for (const IED::ProjectTemplate& made : templates) {
			out.Append("- ");
			out.Append(made.key.View());
			out.Append(": ");
			out.Append(made.title.View());
			if (!made.language.IsEmpty()) {
				out.Append(" (");
				out.Append(made.language.View());
				out.Append(")");
			}
			out.Append(made.canAdd ? " [can add to this solution]" : "");
			if (!made.description.IsEmpty()) {
				out.Append(" - ");
				out.Append(made.description.View());
			}
			out.Append("\n");
		}
		if (templates.IsEmpty()) out.Append("[no plugin gives a project template]\n");
		out.Append("A new workspace goes in ");
		out.Append(location.View());
		out.Append(" unless project_create names a location.\n");
		Core::StringBuilder preview;
		preview.AppendInt(templates.Count());
		preview.Append(" templates");
		return ToolResult(out.View(), preview.View());
	}

	// --- what a change left ------------------------------------------------------------------------------------------

	// What the model is told after a change: what happened, the notes, the workspace's projects as they are now, and the
	// end of the steps' output.
	static ToolOutcome Changed(const ToolInvocation& call, Core::StringView done, const IED::ProjectChange& change) {
		Core::StringBuilder out;
		out.Append(done);
		out.Append("\n");
		for (const Core::String& note : change.notes) {
			out.Append("Note: ");
			out.Append(note.View());
			out.Append("\n");
		}
		if (!change.trashId.IsEmpty()) out.Append("Its folder is in IED's trash (recoverable).\n");
		IED::Workspace ws;
		if (IED::FindWorkspace(change.wsId.View(), ws)) {
			if (ws.id.View() != call.ws.id.View()) {
				out.Append("It opened as workspace ");
				out.Append(ws.id.View());
				out.Append(", beside this chat's; its files are outside this chat's workspace, and the owner switches to it with the workspace switcher.\n");
			}
			DescribeWorkspace(out, ws);
		}
		if (!change.log.IsEmpty()) {
			out.Append("Output:\n");
			out.Append(TailOf(change.log.View(), kProjectLogLines, kProjectToolLogBytes).View());
			out.Append("\n");
		}
		ToolOutcome outcome = ToolResult(out.View(), done);
		outcome.source = Core::String("Solution Explorer");
		return outcome;
	}

	static ToolOutcome Refused(const char* tool, Core::StringView problem) { return ToolError(((Core::String(tool) + ": ") + problem).View()); }

	// --- project_create ----------------------------------------------------------------------------------------------

	static ToolPlan CreatePlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView location = Arg(call, "location");
		plan.subject = (Core::String("project.create(") + Arg(call, "name")) + ")";
		plan.summary = (((Core::String("Create project ") + Arg(call, "name")) + " from ") + Arg(call, "template")) + (location.IsEmpty() ? Core::String(" in this solution") : Core::String(" as a new workspace in ") + location);
		if (location.IsEmpty() && !call.ws.trusted) plan.error = Core::String("project_create: the workspace is not trusted, and a template runs commands in it; ask the owner to trust it, or give a location for a new workspace");
		return plan;
	}

	static ToolOutcome CreateRun(const ToolInvocation& call) {
		Core::StringView location = Arg(call, "location");
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::CreateProject(Arg(call, "template"), Arg(call, "name"), location, location.IsEmpty() ? call.ws.id.View() : Core::StringView(""), change, problem)) {
			if (location.IsEmpty() && problem.View().IndexOf(Core::StringView("cannot add a project")) >= 0) problem = problem + "; give a location (a full path) to make it a workspace of its own, or see project_templates for the ones marked [can add to this solution]";
			return Refused("project_create", problem.View());
		}
		return Changed(call, ((Core::String("Created project ") + Arg(call, "name")) + " at " + change.path.View() + ".").View(), change);
	}

	// --- project_import ----------------------------------------------------------------------------------------------

	// Where `folder` is: this workspace's own folder (`relative` ""), a folder in it, or outside it (false).
	static bool InWorkspace(const ToolInvocation& call, Core::StringView folder, Core::String& relative) {
		if (folder.IsEmpty() || folder == "." || folder == "./") {
			relative = Core::String();
			return true;
		}
		if (!FS::Path(folder).IsAbsolute()) {
			relative = Core::String(folder);
			return true;
		}
		return IED::RelativeTo(call.ws.root.View(), folder, relative);
	}

	static ToolPlan ImportPlan(const ToolInvocation& call) {
		ToolPlan plan;
		Core::StringView folder = Arg(call, "folder");
		plan.subject = (Core::String("project.import(") + (folder.IsEmpty() ? Core::StringView(".") : folder)) + ")";
		Core::String relative;
		if (!InWorkspace(call, folder, relative)) plan.summary = (Core::String("Make ") + folder) + " an IED solution and open it";
		else if (relative.IsEmpty()) plan.summary = Core::String("Make this workspace an IED solution");
		else plan.summary = (Core::String("Add the folder ") + relative.View()) + " to the solution as a project";
		return plan;
	}

	static IED::ProjectChoices Choices(const ToolInvocation& call) {
		IED::ProjectChoices choices;
		choices.name = Core::String(Arg(call, "name"));
		choices.kind = Core::String(Arg(call, "kind"));
		choices.language = Core::String(Arg(call, "language"));
		return choices;
	}

	static ToolOutcome ImportRun(const ToolInvocation& call) {
		Core::StringView folder = Arg(call, "folder");
		Core::String relative;
		IED::ProjectChange change;
		Core::String problem;
		const bool inside = InWorkspace(call, folder, relative);
		if (inside && !relative.IsEmpty()) {
			if (!IED::AddProject(call.ws.id.View(), relative.View(), Choices(call), change, problem)) return Refused("project_import", problem.View());
			return Changed(call, ((((Core::String("Added the folder ") + relative.View()) + " to the solution as project ") + change.project.View()) + ".").View(), change);
		}
		Core::String full = inside ? call.ws.root : Core::String(folder);
		if (!IED::ImportFolder(full.View(), Choices(call), change, problem)) return Refused("project_import", problem.View());
		return Changed(call, ((Core::String("The folder ") + Slashed(full.View()).View()) + " is now the IED solution " + change.path.View() + ".").View(), change);
	}

	// --- project_move, project_remove --------------------------------------------------------------------------------

	static ToolPlan MovePlan(const ToolInvocation& call) {
		ToolPlan plan;
		plan.subject = (((Core::String("project.move(") + Arg(call, "project")) + " -> ") + Arg(call, "to")) + ")";
		plan.summary = (((Core::String("Move project ") + Arg(call, "project")) + " to ") + Arg(call, "to"));
		return plan;
	}

	static ToolOutcome MoveRun(const ToolInvocation& call) {
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::MoveProject(call.ws.id.View(), Arg(call, "project"), Arg(call, "to"), change, problem)) return Refused("project_move", problem.View());
		return Changed(call, ((((Core::String("Moved project ") + Arg(call, "project")) + " to ") + Arg(call, "to")) + "; documents open in it followed it.").View(), change);
	}

	static ToolPlan RemovePlan(const ToolInvocation& call) {
		ToolPlan plan;
		const bool deleting = call.args.Member("delete_files").AsBool();
		plan.subject = (Core::String("project.remove(") + Arg(call, "project")) + ")";
		plan.summary = ((Core::String("Remove project ") + Arg(call, "project")) + " from the solution") + (deleting ? ", its folder to the trash" : ", its files kept");
		return plan;
	}

	static ToolOutcome RemoveRun(const ToolInvocation& call) {
		const bool deleting = call.args.Member("delete_files").AsBool();
		IED::ProjectChange change;
		Core::String problem;
		if (!IED::RemoveProject(call.ws.id.View(), Arg(call, "project"), deleting, change, problem)) return Refused("project_remove", problem.View());
		return Changed(call, (((Core::String("Removed project ") + Arg(call, "project")) + " from the solution") + (deleting ? "; its folder went to the trash." : "; its files are where they were.")).View(), change);
	}

	static ToolSpec* ProjectSpec(const char* name, const char* description, const char* parameters, ToolClass toolClass, ToolPlanner plan, ToolRunner run) {
		ToolSpec* spec = new ToolSpec();
		spec->name = Core::String(name);
		spec->description = Core::String(description);
		spec->parameters = Core::String(parameters);
		spec->toolClass = toolClass;
		spec->parallelSafe = toolClass == ToolClass::Read;
		spec->inPlan = toolClass == ToolClass::Read;
		spec->deferred = true;
		spec->group = Core::String("projects");
		spec->plan = plan;
		spec->run = run;
		return spec;
	}

	void AddProjectTools(ToolRegistry& registry) {
		registry.Add(ProjectSpec("project_list", "The workspace's solution and its projects (kind, language, folder, project file, dependencies) and the other open workspaces. Example: project_list({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read, ListPlan, ListRun));
		registry.Add(ProjectSpec("project_templates", "New Project's templates (C++, C4, Go console apps, libraries...): their keys for project_create, and which can be added to this solution. Example: project_templates({})",
			"{\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}", ToolClass::Read, TemplatesPlan, TemplatesRun));
		registry.Add(ProjectSpec("project_create", "Make a project from a template (key from project_templates): added to this solution, or with location (a full path) a new workspace <location>/<name> that opens beside this one. The Solution Explorer shows it at once. Example: project_create({\"template\": \"ied.cpp/console\", \"name\": \"Tools\"})",
			"{\"type\": \"object\", \"properties\": {\"template\": {\"type\": \"string\", \"minLength\": 1}, \"name\": {\"type\": \"string\", \"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"maxLength\": 64}, \"location\": {\"type\": \"string\", \"description\": \"a full path: make a new workspace there instead of adding to this solution\"}}, \"required\": [\"template\", \"name\"], \"additionalProperties\": false}",
			ToolClass::Exec, CreatePlan, CreateRun));
		registry.Add(ProjectSpec("project_import", "Make an existing folder an IED project: \".\" makes this workspace a solution; a folder of the workspace joins its solution as a project; a full path elsewhere becomes a solution of its own and opens. A .iedsln already in the folder (nuke init --ied wrote it) is opened as it is; else the build system's own project files are used when there is one (nuke.toml); else IED writes a .iedsln and .iedproj with the language and build preset found in the folder. Example: project_import({\"folder\": \"tools/packer\"})",
			"{\"type\": \"object\", \"properties\": {\"folder\": {\"type\": \"string\", \"description\": \"\\\".\\\", a workspace-relative folder, or a full path\"}, \"name\": {\"type\": \"string\", \"description\": \"default: the folder's name\"}, \"kind\": {\"enum\": [\"executable\", \"library\", \"module\", \"custom\", \"tests\", \"other\"]}, \"language\": {\"type\": \"string\", \"description\": \"a language id (cpp, c4, go, rust...); default: found from the files\"}}, \"required\": [\"folder\"], \"additionalProperties\": false}",
			ToolClass::Exec, ImportPlan, ImportRun));
		registry.Add(ProjectSpec("project_move", "Move a project of the solution to another folder of the workspace; its build files and the solution follow, and so do documents open in it. Example: project_move({\"project\": \"Engine\", \"to\": \"libs/Engine\"})",
			"{\"type\": \"object\", \"properties\": {\"project\": {\"type\": \"string\", \"minLength\": 1}, \"to\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"the new folder, workspace-relative\"}}, \"required\": [\"project\", \"to\"], \"additionalProperties\": false}",
			ToolClass::Exec, MovePlan, MoveRun));
		registry.Add(ProjectSpec("project_remove", "Take a project out of the solution (and its build): its files stay unless delete_files, which moves its folder to IED's trash (recoverable). Refused while another project depends on it. Example: project_remove({\"project\": \"OldTool\"})",
			"{\"type\": \"object\", \"properties\": {\"project\": {\"type\": \"string\", \"minLength\": 1}, \"delete_files\": {\"type\": \"boolean\"}}, \"required\": [\"project\"], \"additionalProperties\": false}",
			ToolClass::Exec, RemovePlan, RemoveRun));
	}
}
