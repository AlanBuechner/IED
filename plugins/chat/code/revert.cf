include "api/plugin.ch"
include "revert.ch"
include "service.ch"

namespace Ai
{
	const int64 kRevertPollNs = 50000000;

	static Core::String ReadTurnLines(const FS::Path& file) {
		if (!FS::FileExists(file.CStr())) return Core::String();
		FS::File opened = FS::File(file.CStr(), "rb");
		return opened.ReadText();
	}

	// Where in `text` (turns.jsonl) the line of turn `turnId` starts; -1 for none.
	static int64 TurnLineStart(Core::StringView text, Core::StringView turnId) {
		int64 at = 0;
		while (at < text.ByteLength()) {
			int64 end = text.IndexOf('\n', at);
			if (end < 0) end = text.ByteLength();
			Serialization::DomDoc* doc = new Serialization::DomDoc();
			Serialization::ReadResult line = Serialization::ReadJson(text.Substring(at, end - at), *doc);
			if (line.Ok() && line.root.Member("turnId").AsView() == turnId) return at;
			at = end + 1;
		}
		return -1;
	}

	static bool WriteAll(const FS::Path& file, Core::StringView text, Core::String& problem) {
		FS::MakeDirectories(file.Parent().CStr());
		if (FS::WriteFileAtomically(file.CStr(), (const void*)text.Data(), text.ByteLength())) return true;
		problem = Core::String("could not write ") + file.View();
		return false;
	}

	bool MoveRevertedTurns(const FS::Path& state, Core::StringView chatId, Core::StringView turnId, int64 nowMs, Core::String& moved, Core::String& problem) {
		FS::Path folder = ChatFolder(state, chatId);
		FS::Path turns = folder / "turns.jsonl";
		Core::String text = ReadTurnLines(turns);
		const int64 cut = TurnLineStart(text.View(), turnId);
		if (cut < 0) {
			problem = ((Core::String("turns.jsonl of chat ") + chatId) + " has no line for turn ") + turnId;
			return false;
		}
		Core::StringBuilder name;
		name.Append("reverted/");
		name.AppendInt(nowMs);
		name.AppendByte('-');
		name.Append(turnId);
		name.Append(".jsonl");
		moved = name.ToString();
		if (!WriteAll(folder / moved.View(), text.View().Substring(cut, text.ByteLength() - cut), problem)) return false;
		return WriteAll(turns, text.View().Substring(0, cut), problem);
	}

	// chat.revert {chatId, turnId}: a turn running is stopped first, as chat.stop stops it, and waited for with the lock let
	// go; conflict when it has not ended within kRevertStopWaitNs.
	Core::String Chats::RevertMethod(const IED::Request& request) {
		const IED::Params& params = request.params;
		Chat* chat = Get(params.Str("chatId").View());
		Core::String turnId = params.Str("turnId");
		if (chat->run) StopForRevert(chat, request);
		int64 at = -1;
		for (int64 i = 0; i < chat->turns.Count(); ++i)
			if (chat->turns[i]->turnId == turnId) at = i;
		if (at < 0) throw IED::RpcError(IED::ErrorCode::NotFound, ((Core::String("chat ") + chat->chatId.View()) + " has no turn " + turnId.View()).View());
		IED::Workspace ws = WorkspaceOf(chat);
		const int64 now = ChatNowMs();
		Core::String file;
		Core::String problem;
		if (!MoveRevertedTurns(LocalStateOf(ws), chat->chatId.View(), turnId.View(), now, file, problem)) throw IED::RpcError(IED::ErrorCode::Internal, problem.View());
		Core::Array<Core::String> dropped;
		for (int64 i = at; i < chat->turns.Count(); ++i) dropped.Push(chat->turns[i]->turnId);
		while (chat->turns.Count() > at) chat->turns.RemoveAt(chat->turns.Count() - 1);
		LeaveDroppedClaude(chat, dropped);
		chat->context = Core::String();
		chat->resume = Core::String();
		chat->state = ChatState::Idle;
		chat->stateReason = Core::String();
		chat->updatedMs = now;
		context->Log(((((Core::String("chat ") + chat->chatId.View()) + " reverted to before turn ") + turnId.View()) + "; the turns dropped are in " + file.View()).View());
		IED::JsonWriter data;
		data.BeginObject();
		data.Field("turnId", turnId.View());
		data.IntField("dropped", dropped.Count());
		data.Field("file", file.View());
		data.RawField("snapshot", Snapshot(chat).View());
		data.EndObject();
		Publish(chat, "chat.reverted", data.View());
		Changed(chat);
		IED::JsonWriter json;
		json.BeginObject();
		json.Field("turnId", turnId.View());
		json.IntField("dropped", dropped.Count());
		json.Field("file", file.View());
		json.EndObject();
		return json.ToString();
	}

	void Chats::StopForRevert(Chat* chat, const IED::Request& request) {
		chat->run->cancelled = true;
		chat->run->wake.NotifyAll();
		IED::HostLock guard(*context);
		Threading::ConditionVariable never;
		int64 waited = 0;
		while (chat->run && waited < kRevertStopWaitNs && !request.Cancelled()) {
			guard.Wait(never, kRevertPollNs);
			waited += kRevertPollNs;
		}
		if (chat->run) throw IED::RpcError(IED::ErrorCode::Conflict, "the running turn did not stop in 30 s: stop it, then revert");
	}

	void Chats::LeaveDroppedClaude(Chat* chat, const Core::Array<Core::String>& dropped) {
		ClaudeSession* session = nullptr;
		const bool known = claudeSessions.TryGet(chat->chatId, session);
		bool holds = false;
		for (const Core::String& turnId : dropped) holds = holds || chat->claudeTurns.Contains(turnId) || (known && session->turns.Contains(turnId));
		if (!holds) return;
		if (known) {
			session->Stop();
			session->sessionId = Core::String();
			session->turns.Clear();
		}
		chat->claudeSession = Core::String();
		chat->claudeTurns.Clear();
	}
}
