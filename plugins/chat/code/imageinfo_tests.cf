// imageinfo: what an image file's header says, for each format, from headers made byte by byte.

include "imageinfo.ch"

static void PutText(Core::Array<uint8>& b, const char* text) {
	for (int64 i = 0; text[i] != 0; ++i) b.Push((uint8)text[i]);
}

static void PutBytes(Core::Array<uint8>& b, int64 value, int64 count, bool bigEndian) {
	for (int64 i = 0; i < count; ++i) b.Push((uint8)((value >> (8 * (bigEndian ? count - 1 - i : i))) & 0xFF));
}

static void PutZeros(Core::Array<uint8>& b, int64 count) {
	for (int64 i = 0; i < count; ++i) b.Push((uint8)0);
}

static Ai::ImageInfo Info(const Core::Array<uint8>& b) {
	Ai::ImageInfo info;
	Core::String problem;
	assert_true(Ai::ReadImageInfo(b, info, problem), problem.CStr());
	return info;
}

[test("server.ai.imageinfo")]
class ImageInfoTests {
	[test("png")]
	public static void TestPng() {
		Core::Array<uint8> b;
		PutBytes(b, 0x89504E47, 4, true);
		PutBytes(b, 0x0D0A1A0A, 4, true);
		PutBytes(b, 13, 4, true);
		PutText(b, "IHDR");
		PutBytes(b, 1920, 4, true);
		PutBytes(b, 1080, 4, true);
		PutBytes(b, 8, 1, true);
		PutBytes(b, 6, 1, true);
		PutZeros(b, 7);
		PutBytes(b, 1, 4, true);
		PutText(b, "sRGB");
		PutZeros(b, 5);
		Ai::ImageInfo info = Info(b);
		assert_true(info.Summary().View() == "PNG, 1920x1080, 8-bit RGBA (sRGB, alpha)", info.Summary().CStr());
	}

	[test("jpeg_after_exif")]
	public static void TestJpeg() {
		Core::Array<uint8> b;
		PutBytes(b, 0xFFD8, 2, true);
		PutBytes(b, 0xFFE1, 2, true);
		PutBytes(b, 2 + 20, 2, true);
		PutZeros(b, 20);
		PutBytes(b, 0xFFC2, 2, true);
		PutBytes(b, 17, 2, true);
		PutBytes(b, 8, 1, true);
		PutBytes(b, 480, 2, true);
		PutBytes(b, 640, 2, true);
		PutBytes(b, 3, 1, true);
		PutZeros(b, 9);
		assert_true(Info(b).Summary().View() == "JPEG, 640x480, 8-bit YCbCr, progressive", Info(b).Summary().CStr());
	}

	[test("gif_bmp_webp")]
	public static void TestOthers() {
		Core::Array<uint8> gif;
		PutText(gif, "GIF89a");
		PutBytes(gif, 320, 2, false);
		PutBytes(gif, 200, 2, false);
		PutZeros(gif, 3);
		assert_true(Info(gif).Summary().View() == "GIF, 320x200, indexed", Info(gif).Summary().CStr());
		Core::Array<uint8> bmp;
		PutText(bmp, "BM");
		PutZeros(bmp, 16);
		PutBytes(bmp, 64, 4, false);
		PutBytes(bmp, 0x100000000 - 32, 4, false);
		PutBytes(bmp, 1, 2, false);
		PutBytes(bmp, 32, 2, false);
		assert_true(Info(bmp).Summary().View() == "BMP, 64x32, 32-bit pixels (alpha)", Info(bmp).Summary().CStr());
		Core::Array<uint8> webp;
		PutText(webp, "RIFF");
		PutZeros(webp, 4);
		PutText(webp, "WEBPVP8X");
		PutZeros(webp, 4);
		PutBytes(webp, 0x10, 1, false);
		PutZeros(webp, 3);
		PutBytes(webp, 511, 3, false);
		PutBytes(webp, 255, 3, false);
		assert_true(Info(webp).Summary().View() == "WebP, 512x256, extended (alpha)", Info(webp).Summary().CStr());
	}

	[test("dds_textures")]
	public static void TestDds() {
		Core::Array<uint8> b;
		PutText(b, "DDS ");
		PutZeros(b, 8);
		PutBytes(b, 2048, 4, false);   // height
		PutBytes(b, 1024, 4, false);   // width
		PutZeros(b, 8);
		PutBytes(b, 12, 4, false);     // mips, at 28
		PutZeros(b, 48);
		PutBytes(b, 0x4, 4, false);    // pixel format flags, at 80: FourCC
		PutText(b, "DX10");
		PutZeros(b, 24);
		PutBytes(b, 0x200, 4, false);  // caps2, at 112: a cube
		PutZeros(b, 12);
		PutBytes(b, 99, 4, false);     // DXGI format, at 128: BC7_UNORM_SRGB
		PutBytes(b, 3, 4, false);
		PutZeros(b, 4);
		PutBytes(b, 2, 4, false);      // array size
		PutZeros(b, 4);
		assert_true(Info(b).Summary().View() == "DDS, 1024x2048, 12 mips, cube, 2 layers, BC7_UNORM_SRGB (sRGB)", Info(b).Summary().CStr());
		Core::Array<uint8> dxt;
		PutText(dxt, "DDS ");
		PutZeros(dxt, 8);
		PutBytes(dxt, 256, 4, false);
		PutBytes(dxt, 256, 4, false);
		PutZeros(dxt, 60);
		PutBytes(dxt, 0x4, 4, false);
		PutText(dxt, "DXT5");
		PutZeros(dxt, 40);
		assert_true(Info(dxt).Summary().View() == "DDS, 256x256, DXT5 (BC3) (alpha)", Info(dxt).Summary().CStr());
	}

	[test("unknown_and_cut")]
	public static void TestUnknown() {
		Core::Array<uint8> text;
		PutText(text, "hello, world");
		Ai::ImageInfo info;
		Core::String problem;
		assert_true(!Ai::ReadImageInfo(text, info, problem) && problem.View().Contains(Core::StringView("not a PNG")), "not an image");
		Core::Array<uint8> cut;
		PutText(cut, "DDS ");
		PutZeros(cut, 20);
		Core::String why;
		assert_true(!Ai::ReadImageInfo(cut, info, why) && why.View().Contains(Core::StringView("cut short")), "a header cut short");
	}
}
