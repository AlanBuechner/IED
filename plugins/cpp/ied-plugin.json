// C/C++ (docs/26 "Language plugins"): the C and C++ languages - extensions, comments, brackets, the keywords Monaco's
// grammars name for control flow, Markdown fence names, header/source pairs, icons and the places compilers print (MSVC's
// "path(line,col)", clang's and gcc's "path:line:col") - and clangd as the language server of C and C++ documents, one
// per workspace. clangd finds each file's flags in the nearest compile_commands.json (or compile_flags.txt) above it or
// in a build/ folder beside one (the Nuke driver writes build/compile_commands.json), and guesses without one. Projects
// with language = "cpp" in a Nuke workspace build through the plugin's Nuke driver (nuke/, Frost before it): its clang
// prints diagnostics in MSVC's form without a code, "file(line,col): error: ...", which the clang-msvc matcher reads.
// Debugging through LLDB: CodeLLDB's adapter (the vscode-lldb extension's adapter/codelldb.exe), which connects back to
// IED's port (transport tcp, docs/25); a launch configuration's type is "lldb", with CodeLLDB's arguments (program,
// args, cwd, env, stopOnEntry).
// Its tools (docs/26 "Language tools"): clangd and CodeLLDB ship with IED inside this plugin's install folder
// (tools/install copies the vendored LLVM's clangd.exe with clang's builtin headers into clangd/, and CodeLLDB's adapter
// and LLDB into codelldb/, docs/21), so C and C++ work with nothing else installed; run from IED's source they are
// vendor/llvm's and vendor/codelldb's. cpp.clangd.path and cpp.lldb.path still name others. A source checkout without
// vendor/codelldb (setup.bat fetches it) installs CodeLLDB into IED's tools folder with one click (its SHA-256 pinned).
// clangd's semantic tokens map onto the syntax colors Visual Assist style: `auto` (a deduced type) reads as a keyword and
// code a preprocessor condition leaves out (clangd's `comment`) gray, like the directives.
{
	"manifestVersion": 1,
	"id": "ied.cpp",
	"name": "C/C++",
	"version": "0.1.0",
	"description": "C and C++ through clangd: diagnostics, completion, navigation, formatting and refactoring; debugging through LLDB (CodeLLDB). Both ship with IED.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"permissions": ["process.spawn", "lsp", "dap", "fs.read"],
	"dependencies": [ { "id": "ied.nuke", "version": "^0.1", "optional": true } ],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/C/C++" },
		"languages": [
			{ "id": "c", "aliases": ["C"], "extensions": [".c", ".h"], "fences": ["c", "h"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
				"controlKeywords": ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "goto", "try", "catch", "throw", "co_await", "co_return", "co_yield"] },
			{ "id": "cpp", "aliases": ["C++"], "extensions": [".cpp", ".cc", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h++", ".inl", ".ipp"], "fences": ["cpp", "c++", "cc", "cxx", "hpp"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
				"controlKeywords": ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "goto", "try", "catch", "throw", "co_await", "co_return", "co_yield"] }
		],
		"headerSourcePairs": [
			{ "extensions": [".h", ".c", ".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx", ".inl"], "searchPaths": ["../include", "../src", "../source"], "follow": true }
		],
		"menus": {
			"tab/title": [
				{ "command": "ied.editor.openCounterpartBeside", "group": "1_navigation", "when": "tabKind == 'doc' && resourceExtname =~ /^\\.(h|c|cpp|cc|cxx|hpp|hh|hxx|inl)$/" }
			]
		},
		"outputLinks": [
			{ "id": "msvc", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s()<>\"'|*?]+?\\.[A-Za-z0-9_+-]+)\\((\\d+)(?:,(\\d+))?\\)", "file": 1, "line": 2, "column": 3 },
			{ "id": "gnu", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		],
		"projectIcons": [
			{ "languageId": "cpp", "label": "++", "color": "--hue-violet", "markers": ["CMakeLists.txt", "meson.build", "premake5.lua", "xmake.lua", "*.vcxproj", "compile_commands.json"] },
			{ "languageId": "c", "label": "C", "color": "--hue-blue" }
		],
		"projectTemplates": [
			{ "id": "console", "title": "Console App", "language": "cpp", "tags": ["Console", "Windows"], "into": ["nuke.toml"], "files": "templates/console-cpp",
				"description": "A C++ program that prints to the console, built by Nuke with the LLVM release for the MSVC ABI.",
				"steps": [{ "label": "nuke init", "run": "\"${config:nuke.command}\" init ${name} --language cpp --ied" }] },
			{ "id": "console-c", "title": "Console App", "language": "c", "tags": ["Console", "Windows"], "into": ["nuke.toml"], "files": "templates/console-c",
				"description": "A C program that prints to the console, built by Nuke with the LLVM release for the MSVC ABI.",
				"steps": [{ "label": "nuke init", "run": "\"${config:nuke.command}\" init ${name} --language cpp --ied" }] },
			{ "id": "library", "title": "Static Library", "language": "cpp", "tags": ["Library", "Windows"], "into": ["nuke.toml"], "files": "templates/library-cpp",
				"description": "A C++ static library (.lib) other projects link by naming it in their depends; its src folder is its include folder.",
				"steps": [{ "label": "nuke init", "run": "\"${config:nuke.command}\" init ${name} --language cpp --kind library --ied" }] }
		],
		"fileIcons": [
			{ "languageId": "c", "extensions": [".c"], "label": "C", "color": "--hue-blue" },
			{ "languageId": "c", "extensions": [".h"], "label": "h", "color": "--hue-violet" },
			{ "languageId": "cpp", "extensions": [".cpp", ".cc", ".cxx", ".c++"], "label": "C++", "color": "--hue-violet" },
			{ "languageId": "cpp", "extensions": [".hpp", ".hh", ".hxx", ".h++", ".inl", ".ipp", ".tpp"], "label": "h", "color": "--hue-violet" },
			{ "fileNames": ["CMakeLists.txt"], "label": "CM", "color": "--hue-green" },
			{ "extensions": [".cmake"], "label": "CM", "color": "--hue-green" },
			{ "fileNames": ["compile_commands.json", "compile_flags.txt", ".clangd", ".clang-format", ".clang-tidy"], "icon": "$(gear)", "color": "--hue-violet" }
		],
		"semanticTokenColors": [
			{
				"languageId": "c",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"class": "--syntax-type",
					"interface": "--syntax-type",
					"enum": "--syntax-type",
					"typeParameter": "--syntax-type",
					"concept": "--syntax-type",
					"type.deduced": "--syntax-keyword",
					"class.deduced": "--syntax-keyword",
					"interface.deduced": "--syntax-keyword",
					"enum.deduced": "--syntax-keyword",
					"typeParameter.deduced": "--syntax-keyword",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"variable": "--syntax-variable",
					"parameter": "--syntax-parameter",
					"property": "--syntax-member",
					"enumMember": "--syntax-constant",
					"macro": "--syntax-macro",
					"modifier": "--syntax-keyword",
					"comment": "--syntax-preprocessor"
				}
			},
			{
				"languageId": "cpp",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"class": "--syntax-type",
					"interface": "--syntax-type",
					"enum": "--syntax-type",
					"typeParameter": "--syntax-type",
					"concept": "--syntax-type",
					"type.deduced": "--syntax-keyword",
					"class.deduced": "--syntax-keyword",
					"interface.deduced": "--syntax-keyword",
					"enum.deduced": "--syntax-keyword",
					"typeParameter.deduced": "--syntax-keyword",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"variable": "--syntax-variable",
					"parameter": "--syntax-parameter",
					"property": "--syntax-member",
					"enumMember": "--syntax-constant",
					"macro": "--syntax-macro",
					"modifier": "--syntax-keyword",
					"comment": "--syntax-preprocessor"
				}
			}
		],
		"lspProfiles": [
			{
				"id": "clangd",
				"label": "clangd",
				"command": "${tool:clangd}",
				"args": ["${config:cpp.clangd.arguments}"],
				"selector": { "languages": ["c", "cpp"] },
				"formatOnAiWrite": "workspaceContains..clang-format || workspaceContains._clang-format",
				"diagnosticsOnAiWrite": true,
				"when": "config.cpp.languageServer && workspaceTrusted"
			}
		],
		"dapProviders": [
			{
				"type": "lldb",
				"label": "LLDB (CodeLLDB)",
				"command": "${tool:codelldb}",
				"args": ["--connect", "${port}"],
				"transport": "tcp",
				"languages": ["c", "cpp", "rust"],
				"when": "workspaceTrusted"
			}
		],
		"tools": [
			{
				"id": "clangd",
				"title": "clangd",
				"kind": "languageServer",
				"when": "(workspaceLanguage.c || workspaceLanguage.cpp) && config.cpp.languageServer",
				"program": "clangd",
				"setting": "cpp.clangd.path",
				"bundled": ["${pluginDir}/clangd/bin/clangd.exe", "${iedHome}/vendor/llvm/bin/clangd.exe"],
				"detect": { "args": ["--version"], "pattern": "clangd version (\\d+\\.\\d+\\.\\d+)" },
				"homepage": "https://clangd.llvm.org/installation"
			},
			{
				"id": "codelldb",
				"title": "CodeLLDB",
				"kind": "debugAdapter",
				"when": "workspaceLanguage.c || workspaceLanguage.cpp || workspaceLanguage.rust",
				"program": "codelldb",
				"setting": "cpp.lldb.path",
				"bundled": ["${pluginDir}/codelldb/adapter/codelldb.exe", "${iedHome}/vendor/codelldb/extension/adapter/codelldb.exe"],
				"install": {
					"version": "1.12.3",
					"bin": "extension/adapter",
					"windows": [
						{ "label": "CodeLLDB from GitHub", "download": "https://github.com/vadimcn/codelldb/releases/download/v${version}/codelldb-win32-x64.vsix", "sha256": "a916e509308dac817732f63ca604a8b93ed29cd16f38a2fa9f0b64ed58e8f51a", "extract": "zip" }
					]
				},
				"homepage": "https://github.com/vadimcn/codelldb"
			}
		],
		"problemMatchers": [
			{
				"id": "clang",
				"source": "clang",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}", "${cwd}"] },
				"patterns": [ { "regexp": "^(.+?):(\\d+):(\\d+): (fatal error|error|warning|note): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 } ],
				"severityMap": { "fatal error": "error", "note": "info" }
			},
			{
				"id": "clang-msvc",
				"source": "clang",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}", "${cwd}"] },
				"patterns": [ { "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\): (fatal error|error|warning|note): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 } ],
				"severityMap": { "fatal error": "error", "note": "info" }
			},
			{
				"id": "msvc",
				"source": "msvc",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}", "${cwd}"] },
				"patterns": [ { "regexp": "^\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*: (fatal error|error|warning) (\\w+\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6 } ],
				"severityMap": { "fatal error": "error" }
			}
		],
		"taskPresets": [
			{
				"id": "cpp.nuke",
				"label": "C/C++ (Nuke)",
				"extends": "nuke",
				"problemMatcher": ["clang", "clang-msvc", "msvc"],
				"debug": {
					"default": "Launch",
					"configurations": {
						"Launch": { "type": "lldb", "request": "launch", "program": "${projectOutput}", "cwd": "${projectRoot}", "preLaunchTask": "build" }
					}
				}
			}
		]
	}
}
