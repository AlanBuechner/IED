// C/C++ (docs/05 "Language plugins"): clangd as the language server of C and C++ documents, one per workspace. clangd
// finds each file's flags in the nearest compile_commands.json (or compile_flags.txt) above it or in a build/ folder
// beside one, and guesses without one. Debugging through LLDB: CodeLLDB's adapter (the vscode-lldb extension's
// adapter/codelldb.exe), which connects back to IED's port (transport tcp, docs/25); a launch configuration's type is
// "lldb", with CodeLLDB's arguments (program, args, cwd, env, stopOnEntry).
// clangd's semantic tokens map onto the syntax colors Visual Assist style: `auto` (a deduced type) reads as a keyword and
// code a preprocessor condition leaves out (clangd's `comment`) gray, like the directives.
{
	"manifestVersion": 1,
	"id": "ied.cpp",
	"name": "C/C++",
	"version": "0.1.0",
	"description": "C and C++ through clangd: diagnostics, completion, navigation, formatting and refactoring; debugging through LLDB (CodeLLDB).",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"permissions": ["process.spawn", "lsp", "dap", "fs.read"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/C/C++" },
		"semanticTokenColors": [
			{
				"languageId": "c",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"class": "--syntax-type",
					"interface": "--syntax-type",
					"enum": "--syntax-type",
					"typeParameter": "--syntax-type",
					"concept": "--syntax-type",
					"type.deduced": "--syntax-keyword",
					"class.deduced": "--syntax-keyword",
					"interface.deduced": "--syntax-keyword",
					"enum.deduced": "--syntax-keyword",
					"typeParameter.deduced": "--syntax-keyword",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"variable": "--syntax-variable",
					"parameter": "--syntax-parameter",
					"property": "--syntax-member",
					"enumMember": "--syntax-constant",
					"macro": "--syntax-macro",
					"modifier": "--syntax-keyword",
					"comment": "--syntax-preprocessor"
				}
			},
			{
				"languageId": "cpp",
				"label": "Visual Assist style",
				"rules": {
					"namespace": "--syntax-namespace",
					"type": "--syntax-type",
					"class": "--syntax-type",
					"interface": "--syntax-type",
					"enum": "--syntax-type",
					"typeParameter": "--syntax-type",
					"concept": "--syntax-type",
					"type.deduced": "--syntax-keyword",
					"class.deduced": "--syntax-keyword",
					"interface.deduced": "--syntax-keyword",
					"enum.deduced": "--syntax-keyword",
					"typeParameter.deduced": "--syntax-keyword",
					"function": "--syntax-function",
					"method": "--syntax-function",
					"variable": "--syntax-variable",
					"parameter": "--syntax-parameter",
					"property": "--syntax-member",
					"enumMember": "--syntax-constant",
					"macro": "--syntax-macro",
					"modifier": "--syntax-keyword",
					"comment": "--syntax-preprocessor"
				}
			}
		],
		"lspProfiles": [
			{
				"id": "clangd",
				"label": "clangd",
				"command": "${config:cpp.clangd.path}",
				"args": ["${config:cpp.clangd.arguments}"],
				"selector": { "languages": ["c", "cpp"] },
				"when": "config.cpp.languageServer && workspaceTrusted"
			}
		],
		"dapProviders": [
			{
				"type": "lldb",
				"label": "LLDB (CodeLLDB)",
				"command": "${config:cpp.lldb.path}",
				"args": ["--connect", "${port}"],
				"transport": "tcp",
				"languages": ["c", "cpp", "rust"],
				"when": "workspaceTrusted"
			}
		]
	}
}
