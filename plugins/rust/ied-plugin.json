// Rust (docs/26 "Language plugins"): the language, its icons and the places rustc prints ("path:line:col", also after
// "-->"), rust-analyzer as the language server of Rust documents (one per workspace; it finds
// the Cargo workspace itself), the rust.cargo task preset for a folder with a Cargo.toml - Build, Run, Test and Clean
// with a Debug / Release profile, a rustc problem matcher over cargo's short messages - and a Launch configuration that
// debugs the binary cargo builds through the ied.cpp plugin's lldb adapter (CodeLLDB, docs/25). In a Nuke workspace a
// project with language = "rust" builds through the cargo driver in nuke/ (docs/26 section 6) and the rust.nuke preset,
// which matches cargo's own diagnostics (`rustc-human`: "error[E0308]: ..." then " --> path:line:col"). For the
// profiler (docs/16): the ied-profiler crate in profiler/ and the cargo preset's Profile task.
// Its tools (docs/26 "Language tools"): rustup, cargo (the toolchain) and rust-analyzer, found on PATH or in
// %USERPROFILE%\.cargo\bin and asked their versions in the workspace's folder, so rustup's proxies answer for the
// toolchain the workspace pins (rust-toolchain.toml's channel, or rust-toolchain); nothing is downloaded while they are
// asked (RUSTUP_AUTO_INSTALL=0). Installed with one click, for the user, the way the Rust project installs them (asked
// first: they write outside IED's tools folder): rustup-init (its SHA-256 pinned) without changing PATH, the pinned
// toolchain by `rustup toolchain install`, rust-analyzer by `rustup component add`. Debugging is the ied.cpp plugin's
// CodeLLDB (adapter type lldb, its codelldb tool), an optional dependency.
{
	"manifestVersion": 1,
	"id": "ied.rust",
	"name": "Rust",
	"version": "0.1.0",
	"description": "Rust through rust-analyzer and cargo: diagnostics, completion, navigation, builds, tests and debugging (CodeLLDB).",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "declarative" },
	"permissions": ["process.spawn", "lsp", "fs.read"],
	"dependencies": [ { "id": "ied.nuke", "version": "^0.1", "optional": true }, { "id": "ied.cpp", "version": "^0.1", "optional": true } ],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Text Editor/Rust" },
		"systemMessageSections": [
			{ "id": "rust", "when": "workspaceLanguage.rust", "text": "Rust crates build with cargo (Cargo.toml); keep Cargo.toml and Cargo.lock as cargo writes them. cargo_metadata gives the workspace's crates and targets." }
		],
		"toolCalls": [
			{
				"name": "cargo_metadata",
				"description": "The Cargo workspace: its crates (packages), their targets and dependencies, as JSON (cargo metadata --no-deps).",
				"class": "read",
				"inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
				"run": ["${tool:cargo}", "metadata", "--format-version", "1", "--no-deps"],
				"output": "json",
				"when": "workspaceContains.Cargo.toml"
			}
		],
		"languages": [
			{ "id": "rust", "aliases": ["Rust"], "extensions": [".rs"], "fences": ["rust", "rs"], "lineComment": "//", "blockComment": ["/*", "*/"], "brackets": [["{", "}"], ["[", "]"], ["(", ")"]] }
		],
		"outputLinks": [
			{ "id": "rustc", "regexp": "(?:^|\\s)((?:[A-Za-z]:)?[^\\s():<>\"'|*?]+?\\.[A-Za-z0-9_+-]+):(\\d+)(?::(\\d+))?", "file": 1, "line": 2, "column": 3 }
		],
		"projectIcons": [
			{ "languageId": "rust", "label": "RS", "color": "--hue-orange", "presets": ["rust.cargo"], "buildSystems": ["cargo"], "markers": ["Cargo.toml"] }
		],
		"fileIcons": [
			{ "languageId": "rust", "extensions": [".rs"], "label": "RS", "color": "--hue-orange" },
			{ "fileNames": ["Cargo.toml"], "icon": "$(package)", "color": "--hue-orange" },
			{ "fileNames": ["Cargo.lock"], "icon": "$(lock)", "color": "--hue-orange" }
		],
		"semanticTokenColors": [
			{
				"languageId": "rust",
				"label": "Visual Assist style",
				"rules": {
					"keyword.controlFlow": "--syntax-control",
					"builtinType": "--syntax-keyword",
					"boolean": "--syntax-keyword",
					"selfKeyword": "--syntax-keyword",
					"selfTypeKeyword": "--syntax-keyword",
					"typeAlias": "--syntax-type",
					"union": "--syntax-type",
					"generic": "--syntax-type",
					"constParameter": "--syntax-parameter",
					"attribute": "--syntax-macro",
					"builtinAttribute": "--syntax-macro",
					"derive": "--syntax-macro",
					"macroBang": "--syntax-macro",
					"escapeSequence": "--syntax-constant",
					"character": "--syntax-string"
				}
			}
		],
		"lspProfiles": [
			{
				"id": "rust-analyzer",
				"label": "rust-analyzer",
				"command": "${tool:rust-analyzer}",
				"selector": { "languages": ["rust"] },
				"when": "config.rust.languageServer && workspaceTrusted"
			}
		],
		"tools": [
			{
				"id": "rustup",
				"title": "rustup",
				"kind": "buildTool",
				"when": "workspaceLanguage.rust",
				"program": "rustup",
				"onPath": true,
				"searchPaths": ["${env:USERPROFILE}/.cargo/bin"],
				"detect": { "args": ["--version"], "pattern": "rustup (\\d+\\.\\d+\\.\\d+)", "env": { "RUSTUP_AUTO_INSTALL": "0" } },
				"install": {
					"version": "1.29.2",
					"windows": [
						{ "label": "rustup-init from static.rust-lang.org", "download": "https://static.rust-lang.org/rustup/archive/${version}/x86_64-pc-windows-msvc/rustup-init.exe", "sha256": "00f139da614dced87d3c3d4121c43eebdac3c1bf8a5ee86b9d80dfd71c8d70fd", "sha256Url": "https://static.rust-lang.org/rustup/archive/${version}/x86_64-pc-windows-msvc/rustup-init.exe.sha256", "extract": "none" },
						{ "label": "rustup-init: rustup and the stable toolchain for your user, in %USERPROFILE%\\.cargo and .rustup (PATH unchanged)", "run": ["${installDir}/rustup-init.exe", "-y", "--no-modify-path", "--profile", "minimal", "--default-toolchain", "stable"], "scope": "user" }
					]
				},
				"homepage": "https://rustup.rs"
			},
			{
				"id": "cargo",
				"title": "Rust toolchain (cargo)",
				"kind": "compiler",
				"when": "workspaceLanguage.rust",
				"program": "cargo",
				"setting": "rust.cargo.path",
				"onPath": true,
				"searchPaths": ["${env:USERPROFILE}/.cargo/bin"],
				"detect": { "args": ["--version"], "pattern": "cargo (\\d+\\.\\d+\\.\\d+\\S*)", "env": { "RUSTUP_AUTO_INSTALL": "0" } },
				"versionFrom": [
					{ "file": "rust-toolchain.toml", "regexp": "^\\s*channel\\s*=\\s*\"([^\"]+)\"", "match": "exact" },
					{ "file": "rust-toolchain", "regexp": "^\\s*channel\\s*=\\s*\"([^\"]+)\"", "match": "exact" },
					{ "file": "rust-toolchain", "regexp": "^\\s*([^\\s#\\[=]+)\\s*$", "match": "exact" }
				],
				"requires": ["rustup"],
				"install": {
					"version": "stable",
					"windows": [
						{ "label": "rustup toolchain install", "run": ["${tool:rustup}", "toolchain", "install", "${version}", "--profile", "minimal"], "scope": "user" }
					]
				},
				"homepage": "https://www.rust-lang.org/tools/install"
			},
			{
				"id": "rust-analyzer",
				"title": "rust-analyzer",
				"kind": "languageServer",
				"when": "workspaceLanguage.rust && config.rust.languageServer",
				"program": "rust-analyzer",
				"setting": "rust.analyzer.path",
				"searchPaths": ["${env:USERPROFILE}/.cargo/bin"],
				"detect": { "args": ["--version"], "pattern": "rust-analyzer (\\S+)", "env": { "RUSTUP_AUTO_INSTALL": "0" } },
				"requires": ["cargo"],
				"install": {
					"windows": [
						{ "label": "rustup component add rust-analyzer", "run": ["${tool:rustup}", "component", "add", "rust-analyzer"], "scope": "user" }
					]
				},
				"homepage": "https://rust-analyzer.github.io/book/rust_analyzer_binary.html"
			}
		],
		"problemMatchers": [
			{
				"id": "rustc",
				"source": "rustc",
				"fileLocation": { "kind": "search", "roots": ["${cwd}"] },
				"patterns": [ { "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)(?:\\[(\\w+)\\])?: (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6 } ]
			},
			{
				"id": "rustc-human",
				"source": "rustc",
				"fileLocation": { "kind": "search", "roots": ["${projectRoot}", "${cwd}"] },
				"patterns": [
					{ "regexp": "^(error|warning)(?:\\[(\\w+)\\])?: (.*)$", "severity": 1, "code": 2, "message": 3 },
					{ "regexp": "^\\s*--> (.+?):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
				]
			}
		],
		"taskPresets": [
			{
				"id": "rust.nuke",
				"label": "Rust (Nuke)",
				"extends": "nuke",
				"problemMatcher": ["rustc-human"],
				"debug": {
					"default": "Launch",
					"configurations": {
						"Launch": { "type": "lldb", "request": "launch", "program": "${projectOutput}", "cwd": "${projectRoot}", "preLaunchTask": "build" }
					}
				}
			},
			{
				"id": "rust.cargo",
				"label": "Cargo",
				"detect": "Cargo.toml",
				"variables": {
					"profile": { "kind": "dropdown", "label": "Profile", "values": ["debug", "release"], "default": "debug", "scope": "solution" }
				},
				"tasks": {
					"build": { "label": "Build", "icon": "$(build)", "slot": "build", "steps": [
						{ "run": ["${tool:cargo}", "build", "--message-format=short"], "when": "profile == 'debug'", "problemMatcher": "rustc" },
						{ "run": ["${tool:cargo}", "build", "--release", "--message-format=short"], "when": "profile == 'release'", "problemMatcher": "rustc" }
					] },
					"run": { "label": "Run", "icon": "$(run)", "slot": "run", "concurrency": "restart", "steps": [
						{ "run": ["${tool:cargo}", "run", "--message-format=short"], "when": "profile == 'debug'", "problemMatcher": "rustc", "output": "run" },
						{ "run": ["${tool:cargo}", "run", "--release", "--message-format=short"], "when": "profile == 'release'", "problemMatcher": "rustc", "output": "run" }
					] },
					"test": { "label": "Test", "icon": "$(beaker)", "slot": "test", "steps": [
						{ "run": ["${tool:cargo}", "test", "--message-format=short"], "problemMatcher": "rustc", "output": "test" }
					] },
					"profile": { "label": "Profile", "icon": "$(pulse)", "slot": "profile", "concurrency": "restart", "tooltip": "Run with the profiler connected (IED_PROFILER); the program records through the ied-profiler crate", "steps": [
						{ "run": ["${tool:cargo}", "run", "--message-format=short"], "when": "profile == 'debug'", "problemMatcher": "rustc", "output": "run", "env": { "IED_PROFILER": "${profiler.connect}" } },
						{ "run": ["${tool:cargo}", "run", "--release", "--message-format=short"], "when": "profile == 'release'", "problemMatcher": "rustc", "output": "run", "env": { "IED_PROFILER": "${profiler.connect}" } }
					] },
					"clean": { "label": "Clean", "slot": "clean", "steps": [ { "run": ["${tool:cargo}", "clean"] } ] }
				},
				"toolbar": ["profile", "|", "run", "build", "test"],
				"debug": {
					"default": "Launch",
					"configurations": {
						"Launch": { "type": "lldb", "request": "launch", "program": "${projectRoot}/target/${profile}/${projectName}.exe", "cwd": "${projectRoot}", "preLaunchTask": "build" }
					}
				}
			}
		]
	}
}
