// The terminal dock (docs/15 "Terminal dock", docs/10 "Terminals"): the server's terminals - shells under a pseudo
// console that outlive every browser - as tabs in the panel under every activity (a slide-up drawer on a phone, with a
// row of the keys a phone keyboard lacks). One window types at a time; the others watch and can take over. Its server
// code (code/) is compiled into the server and runs on the plugin API (docs/26 "Built-ins on the API"): the term.*
// methods and the term: and terms: topics. Terminal profiles (docs/05 "Terminal profiles"): the kinds of terminal New
// Terminal's menu offers - its own PowerShell 7, Windows PowerShell, Command Prompt and Git Bash, and what other plugins
// contribute (the Python plugin's Python) - with terminal.defaultProfile choosing what New Terminal runs.
{
	"manifestVersion": 1,
	"id": "ied.terminal",
	"name": "Terminal",
	"version": "0.1.0",
	"description": "Terminals on the server: the terminal dock, shared by every window and device.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "Terminal::Activate", "ui": "ui/index.js" },
	"permissions": ["terminal", "process.spawn"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Terminal" },
		"bindings": {
			"provides": [
				{
					"name": "terminal.text",
					"version": "1.0.0",
					"kind": "function",
					"description": "A terminal's last lines as plain text, its escape sequences left out: {terminal, lines?} -> {terminal, title, alive, text} (200 lines by default, at most 2000); a chat reads it for an @terminal: mention (docs/04)."
				}
			]
		},
		"terminalProfiles": [
			{ "id": "pwsh", "title": "PowerShell", "icon": "$(terminal-powershell)", "argv": ["pwsh", "-NoLogo"] },
			{ "id": "powershell", "title": "Windows PowerShell", "icon": "$(terminal-powershell)", "argv": ["powershell", "-NoLogo"] },
			{ "id": "cmd", "title": "Command Prompt", "icon": "$(terminal-cmd)", "argv": ["${env:ComSpec}"] },
			{ "id": "gitbash", "title": "Git Bash", "icon": "$(terminal-git-bash)", "argv": ["${env:ProgramFiles}/Git/bin/bash.exe", "--login", "-i"] }
		],
		"panels": [
			{ "id": "ied.terminal.panel", "title": "Terminal", "icon": "$(terminal)", "view": "TerminalPanel" }
		],
		"commands": [
			{ "id": "ied.terminal.new", "title": "New Terminal", "category": "Terminal", "icon": "$(add)" },
			{ "id": "ied.terminal.newWithProfile", "title": "New Terminal with Profile...", "category": "Terminal", "icon": "$(chevron-down)" },
			{ "id": "ied.terminal.selectDefaultProfile", "title": "Select Default Profile...", "category": "Terminal", "icon": "$(settings-gear)" },
			{ "id": "ied.terminal.kill", "title": "Kill Terminal", "category": "Terminal", "icon": "$(trash)" },
			{ "id": "ied.terminal.rename", "title": "Rename Terminal...", "category": "Terminal", "icon": "$(edit)" },
			{ "id": "ied.terminal.show", "title": "Terminal", "category": "View", "icon": "$(terminal)" },
			{ "id": "ied.terminal.openHere", "title": "Open in Terminal", "category": "Solution Explorer", "icon": "$(terminal)" }
		],
		"menus": {
			"menubar/view": [
				{ "command": "ied.terminal.show", "group": "3_panel" }
			],
			"explorer/context": [
				{ "command": "ied.terminal.openHere", "group": "6_terminal", "order": 1, "when": "explorerItemKind == 'solution' || explorerItemKind == 'project' || explorerItemKind == 'folder' || explorerItemKind == 'file'" }
			],
			"terminal/context": [
				{ "command": "ied.terminal.rename", "group": "1_edit" },
				{ "command": "ied.terminal.kill", "group": "2_kill" }
			]
		},
		"keybindings": [
			{ "command": "ied.terminal.new", "key": "ctrl+shift+`" }
		]
	}
}
