include "TerminalText.ch"

namespace Terminal
{
	const char c_Escape = (char)27;
	const char c_Bell = (char)7;

	// Where the escape sequence starting at `at` (an ESC) ends: one past its last byte.
	static int64 SequenceEnd(Core::StringView text, int64 at) {
		const int64 size = text.ByteLength();
		if (at + 1 >= size) return size;
		const int32 kind = text.ByteAt(at + 1);
		if (kind == '[') { // CSI: parameters and intermediates, then a final byte in @..~
			int64 end = at + 2;
			while (end < size && (text.ByteAt(end) < '@' || text.ByteAt(end) > '~')) end += 1;
			return end < size ? end + 1 : size;
		}
		if (kind == ']') { // OSC: until BEL or ESC backslash
			for (int64 end = at + 2; end < size; ++end) {
				if (text.ByteAt(end) == c_Bell) return end + 1;
				if (text.ByteAt(end) == c_Escape && end + 1 < size && text.ByteAt(end + 1) == '\\') return end + 2;
			}
			return size;
		}
		int64 end = at + 1; // ESC, any intermediates (space to '/'), then one final byte: ESC ( B picks a charset
		while (end < size && text.ByteAt(end) >= ' ' && text.ByteAt(end) <= '/') end += 1;
		return end < size ? end + 1 : size;
	}

	Core::String PlainText(Core::StringView text) {
		Core::StringBuilder out;
		int64 at = 0;
		while (at < text.ByteLength()) {
			const int32 c = text.ByteAt(at);
			if (c == c_Escape) at = SequenceEnd(text, at);
			else {
				if (c != '\r' && c != c_Bell) out.AppendByte(c);
				at += 1;
			}
		}
		return out.ToString();
	}

	Core::String LastLines(Core::StringView text, int64 most) {
		int64 end = text.ByteLength();
		while (end > 0 && text.ByteAt(end - 1) == '\n') end -= 1;
		int64 start = end;
		for (int64 lines = 0; start > 0; --start)
			if (text.ByteAt(start - 1) == '\n' && ++lines == most) break;
		return Core::String(text.Substring(start, end - start));
	}

	IED::Result TerminalText(Terminals* terminals, const Serialization::DomNode& args) {
		IED::HostLock guard(*terminals->m_Context);
		Core::StringView termId = args.Member("terminal").AsView();
		int64 lines = args.Member("lines").AsInt();
		if (lines <= 0) lines = c_TextDefaultLines;
		if (lines > c_TextMostLines) lines = c_TextMostLines;
		for (Term* terminal : terminals->m_Terminals) {
			if (terminal->m_TermId.View() != termId) continue;
			IED::JsonWriter json;
			json.BeginObject();
			json.Field("terminal", terminal->m_TermId.View());
			json.Field("title", terminal->m_Title.View());
			json.BoolField("alive", terminal->m_Alive);
			json.Field("text", LastLines(PlainText(terminal->m_Scrollback.View()).View(), lines).View());
			json.EndObject();
			return IED::Answer(json.View());
		}
		return IED::Refusal((Core::String("no terminal ") + termId).View());
	}
}
