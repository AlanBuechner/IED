// The Visual Studio-style IDE (plugins/README.md, docs/05): Solution Explorer over the workspace's files and solution
// model, the Output window over the output sources, server documents in Monaco with the language servers' features
// (docs/24), and the Error List of their diagnostics; builds and debugging follow.
{
	"manifestVersion": 1,
	"id": "ied.editor",
	"name": "Editor",
	"version": "0.1.0",
	"description": "Solution Explorer, Output and documents: the Visual Studio-shaped editor activity.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "ui": "ui/index.js" },
	"permissions": ["fs.read", "fs.write", "fs.watch", "ui.clipboard"],
	"contributes": {
		"activities": [
			{ "id": "ied.editor", "title": "Editor", "icon": "$(code)", "order": 10, "phoneSlot": true }
		],
		"toolWindows": [
			{ "id": "ied.explorer", "title": "Solution Explorer", "icon": "$(list-tree)", "view": "SolutionExplorer", "defaultDock": "left" },
			{ "id": "ied.output", "title": "Output", "icon": "$(output)", "view": "Output", "defaultDock": "bottom" },
			{ "id": "ied.errors", "title": "Error List", "icon": "$(error)", "view": "ErrorList", "defaultDock": "bottom" }
		],
		"statusBarItems": [
			{ "id": "ied.editor.status", "alignment": "right", "priority": 100, "view": "EditorStatus" }
		],
		"commands": [
			{ "id": "ied.explorer.open", "title": "Open", "category": "Solution Explorer", "icon": "$(go-to-file)" },
			{ "id": "ied.explorer.refresh", "title": "Refresh", "category": "Solution Explorer", "icon": "$(refresh)" },
			{ "id": "ied.explorer.collapseAll", "title": "Collapse All", "category": "Solution Explorer", "icon": "$(collapse-all)" },
			{ "id": "ied.explorer.copyPath", "title": "Copy Full Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.copyRelativePath", "title": "Copy Relative Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.newFile", "title": "New File...", "category": "Solution Explorer", "icon": "$(new-file)" },
			{ "id": "ied.explorer.newFolder", "title": "New Folder", "category": "Solution Explorer", "icon": "$(new-folder)" },
			{ "id": "ied.explorer.rename", "title": "Rename", "category": "Solution Explorer", "icon": "$(edit)" },
			{ "id": "ied.explorer.delete", "title": "Delete", "category": "Solution Explorer", "icon": "$(trash)" },
			{ "id": "ied.output.clear", "title": "Clear All", "category": "Output", "icon": "$(clear-all)" },
			{ "id": "ied.output.toggleWrap", "title": "Toggle Word Wrap", "category": "Output", "icon": "$(word-wrap)" },
			{ "id": "ied.editor.save", "title": "Save", "category": "File", "icon": "$(save)" },
			{ "id": "ied.editor.saveAll", "title": "Save All", "category": "File", "icon": "$(save-all)" },
			{ "id": "ied.editor.goTo", "title": "Go To Place", "category": "Editor" }
		],
		"menus": {
			"menubar/file": [
				{ "command": "ied.editor.save", "group": "5_save" },
				{ "command": "ied.editor.saveAll", "group": "5_save", "order": 1 }
			],
			"toolbar/main": [
				{ "command": "ied.editor.save", "group": "1_file" },
				{ "command": "ied.editor.saveAll", "group": "1_file", "order": 1 }
			],
			"explorer/context": [
				{ "command": "ied.explorer.open", "group": "1_open", "when": "explorerItemKind == 'file'" },
				{ "command": "ied.explorer.newFile", "group": "2_new", "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.newFolder", "group": "2_new", "order": 1, "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.rename", "group": "4_edit", "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.delete", "group": "4_edit", "order": 1, "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.copyPath", "group": "5_copy" },
				{ "command": "ied.explorer.copyRelativePath", "group": "5_copy", "order": 1 },
				{ "command": "ied.explorer.refresh", "group": "9_refresh" }
			],
			"output/context": [
				{ "command": "ied.output.clear", "group": "1_clear" },
				{ "command": "ied.output.toggleWrap", "group": "2_view" }
			]
		},
		"keybindings": [
			{ "command": "ied.editor.save", "key": "ctrl+s" },
			{ "command": "ied.explorer.rename", "key": "f2", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.explorer.delete", "key": "delete", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.editor.saveAll", "key": "ctrl+shift+s" },
			{ "command": "shell.showView", "key": "ctrl+alt+l", "args": { "id": "ied.explorer" } },
			{ "command": "shell.showView", "key": "ctrl+alt+o", "args": { "id": "ied.output" } },
			{ "command": "shell.showView", "key": "ctrl+\\ ctrl+e", "args": { "id": "ied.errors" } }
		]
	}
}
