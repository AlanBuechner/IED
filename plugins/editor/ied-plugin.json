// The Visual Studio-style IDE (plugins/README.md, docs/05): Solution Explorer over the workspace's files and solution
// model, the Output window over the output sources, server documents in Monaco with the language servers' features
// (docs/24), and the Error List of their diagnostics; builds and debugging follow.
{
	"manifestVersion": 1,
	"id": "ied.editor",
	"name": "Editor",
	"version": "0.1.0",
	"description": "Solution Explorer, Output and documents: the Visual Studio-shaped editor activity.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "ui": "ui/index.js" },
	"permissions": ["fs.read", "fs.write", "fs.watch", "ui.clipboard"],
	"contributes": {
		"bindings": {
			"provides": [
				{
					"name": "editor.colorize",
					"version": "1",
					"kind": "function",
					"side": "client",
					"description": "Lines of a file colored as the editor colors them: HTML per line (docs/02 \"Client bindings as built\").",
					"params": { "type": "object", "required": ["path", "lines"], "properties": { "path": { "type": "string" }, "lines": { "type": "array", "items": { "type": "string" } } } },
					"result": { "type": "array", "items": { "type": "string" } }
				}
			]
		},
		"activities": [
			{ "id": "ied.editor", "title": "Editor", "icon": "$(code)", "order": 10, "phoneSlot": true }
		],
		"toolWindows": [
			{ "id": "ied.explorer", "title": "Solution Explorer", "icon": "$(list-tree)", "view": "SolutionExplorer", "defaultDock": "left" },
			{ "id": "ied.output", "title": "Output", "icon": "$(output)", "view": "Output", "defaultDock": "bottom" },
			{ "id": "ied.errors", "title": "Error List", "icon": "$(error)", "view": "ErrorList", "defaultDock": "bottom" },
			{ "id": "ied.find", "title": "Find in Files", "icon": "$(search)", "view": "FindInFiles", "defaultDock": "bottom" },
			{ "id": "ied.callStack", "title": "Call Stack", "icon": "$(debug-stackframe)", "view": "CallStack", "defaultDock": "bottom" },
			{ "id": "ied.locals", "title": "Locals", "icon": "$(symbol-variable)", "view": "Locals", "defaultDock": "bottom" },
			{ "id": "ied.watch", "title": "Watch", "icon": "$(eye)", "view": "Watch", "defaultDock": "bottom" },
			{ "id": "ied.threads", "title": "Threads", "icon": "$(list-flat)", "view": "Threads", "defaultDock": "bottom" },
			{ "id": "ied.breakpoints", "title": "Breakpoints", "icon": "$(circle-filled)", "view": "Breakpoints", "defaultDock": "bottom" }
		],
		"statusBarItems": [
			{ "id": "ied.editor.status", "alignment": "right", "priority": 100, "view": "EditorStatus" },
			{ "id": "ied.tasks.status", "alignment": "left", "priority": 50, "view": "TaskStatus", "command": "ied.task.showResult" }
		],
		"toolbarItems": [
			{ "id": "ied.tasks.toolbar", "view": "TaskToolbar", "priority": 100 },
			{ "id": "ied.debug.toolbar", "view": "DebugToolbar", "priority": 90 }
		],
		"commands": [
			{ "id": "ied.explorer.open", "title": "Open", "category": "Solution Explorer", "icon": "$(go-to-file)" },
			{ "id": "ied.explorer.refresh", "title": "Refresh", "category": "Solution Explorer", "icon": "$(refresh)" },
			{ "id": "ied.explorer.collapseAll", "title": "Collapse All", "category": "Solution Explorer", "icon": "$(collapse-all)" },
			{ "id": "ied.explorer.copyPath", "title": "Copy Full Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.copyRelativePath", "title": "Copy Relative Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.newFile", "title": "New File...", "category": "Solution Explorer", "icon": "$(new-file)" },
			{ "id": "ied.explorer.newFolder", "title": "New Folder", "category": "Solution Explorer", "icon": "$(new-folder)" },
			{ "id": "ied.explorer.rename", "title": "Rename", "category": "Solution Explorer", "icon": "$(edit)" },
			{ "id": "ied.explorer.delete", "title": "Delete", "category": "Solution Explorer", "icon": "$(trash)" },
			{ "id": "ied.output.clear", "title": "Clear All", "category": "Output", "icon": "$(clear-all)" },
			{ "id": "ied.output.toggleWrap", "title": "Toggle Word Wrap", "category": "Output", "icon": "$(word-wrap)" },
			{ "id": "ied.editor.save", "title": "Save", "category": "File", "icon": "$(save)" },
			{ "id": "ied.editor.saveAll", "title": "Save All", "category": "File", "icon": "$(save-all)" },
			{ "id": "ied.editor.goTo", "title": "Go To Place", "category": "Editor" },
			{ "id": "ied.find.inFiles", "title": "Find in Files", "category": "Edit", "icon": "$(search)" },
			{ "id": "ied.editor.goToAll", "title": "Go To All", "category": "Edit", "icon": "$(go-to-file)" },
			{ "id": "ied.markdown.preview", "title": "Open Preview", "category": "Markdown", "icon": "$(open-preview)" },
			{ "id": "ied.editor.open", "title": "Open File at a Place", "category": "Editor" },
			{ "id": "ied.task.build", "title": "Build", "category": "Build", "icon": "$(gear)" },
			{ "id": "ied.task.rebuild", "title": "Rebuild", "category": "Build" },
			{ "id": "ied.task.clean", "title": "Clean", "category": "Build" },
			{ "id": "ied.task.cancel", "title": "Cancel", "category": "Build", "icon": "$(debug-stop)" },
			{ "id": "ied.debug.start", "title": "Start Debugging / Continue", "category": "Debug", "icon": "$(debug-start)" },
			{ "id": "ied.debug.stop", "title": "Stop Debugging", "category": "Debug", "icon": "$(debug-stop)", "enablement": "debugState" },
			{ "id": "ied.debug.restart", "title": "Restart", "category": "Debug", "icon": "$(debug-restart)", "enablement": "debugState" },
			{ "id": "ied.debug.pause", "title": "Break All", "category": "Debug", "icon": "$(debug-pause)", "enablement": "debugState == 'running'" },
			{ "id": "ied.debug.stepOver", "title": "Step Over", "category": "Debug", "icon": "$(debug-step-over)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.stepInto", "title": "Step Into", "category": "Debug", "icon": "$(debug-step-into)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.stepOut", "title": "Step Out", "category": "Debug", "icon": "$(debug-step-out)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.toggleBreakpoint", "title": "Toggle Breakpoint", "category": "Debug", "enablement": "activeTabKind == 'doc'" },
			{ "id": "ied.debug.windows", "title": "Breakpoints Window", "category": "Debug", "icon": "$(circle-filled)" },
			{ "id": "ied.task.start", "title": "Start Without Debugging", "category": "Debug", "icon": "$(run)" },
			{ "id": "ied.task.test", "title": "Run All Tests", "category": "Test", "icon": "$(beaker)" },
			{ "id": "ied.task.setStartup", "title": "Set as Startup Project", "category": "Project" },
			{ "id": "ied.task.showResult", "title": "Show Build Output", "category": "Build" },
			{ "id": "ied.output.show", "title": "Show Output", "category": "View", "icon": "$(output)" },
			{ "id": "ied.editor.toggleHeader", "title": "Toggle Header / Code File", "category": "Edit" },
			{ "id": "ied.editor.action", "title": "Editor Action", "category": "Edit" },
			{ "id": "ied.navigate.back", "title": "Navigate Backward", "category": "View", "icon": "$(arrow-left)" },
			{ "id": "ied.navigate.forward", "title": "Navigate Forward", "category": "View", "icon": "$(arrow-right)" }
		],
		"fileOpener": { "command": "ied.editor.open" },
		"menus": {
			"menubar/build": [
				{ "command": "ied.task.build", "group": "1_build" },
				{ "command": "ied.task.rebuild", "group": "1_build", "order": 1 },
				{ "command": "ied.task.clean", "group": "1_build", "order": 2 },
				{ "command": "ied.task.cancel", "group": "2_cancel" }
			],
			"menubar/debug": [
				{ "command": "ied.debug.start", "group": "1_start" },
				{ "command": "ied.task.start", "group": "1_start", "order": 1 },
				{ "command": "ied.debug.pause", "group": "2_run" },
				{ "command": "ied.debug.stop", "group": "2_run", "order": 1 },
				{ "command": "ied.debug.restart", "group": "2_run", "order": 2 },
				{ "command": "ied.debug.stepOver", "group": "3_step" },
				{ "command": "ied.debug.stepInto", "group": "3_step", "order": 1 },
				{ "command": "ied.debug.stepOut", "group": "3_step", "order": 2 },
				{ "command": "ied.debug.toggleBreakpoint", "group": "4_breakpoints" },
				{ "command": "ied.debug.windows", "group": "5_windows" }
			],
			"menubar/test": [
				{ "command": "ied.task.test", "group": "1_run" }
			],
			"menubar/edit": [
				{ "command": "ied.find.inFiles", "group": "3_find" },
				{ "command": "ied.editor.goToAll", "group": "4_go" }
			],
			"menubar/view": [
				{ "command": "ied.navigate.back", "group": "1_navigate" },
				{ "command": "ied.navigate.forward", "group": "1_navigate", "order": 1 }
			],
			"menubar/file": [
				{ "command": "ied.editor.save", "group": "5_save" },
				{ "command": "ied.editor.saveAll", "group": "5_save", "order": 1 }
			],
			"toolbar/main": [
				{ "command": "ied.navigate.back", "group": "0_navigate" },
				{ "command": "ied.navigate.forward", "group": "0_navigate", "order": 1 },
				{ "command": "ied.editor.save", "group": "1_file" },
				{ "command": "ied.editor.saveAll", "group": "1_file", "order": 1 }
			],
			"explorer/context": [
				{ "command": "ied.task.setStartup", "group": "0_startup", "when": "explorerItemKind == 'project'" },
				{ "command": "ied.explorer.open", "group": "1_open", "when": "explorerItemKind == 'file'" },
				{ "command": "ied.markdown.preview", "group": "1_open", "order": 1, "when": "explorerItemKind == 'file' && explorerItemExtension == '.md'" },
				{ "command": "ied.explorer.newFile", "group": "2_new", "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.newFolder", "group": "2_new", "order": 1, "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.rename", "group": "4_edit", "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.delete", "group": "4_edit", "order": 1, "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.copyPath", "group": "5_copy" },
				{ "command": "ied.explorer.copyRelativePath", "group": "5_copy", "order": 1 },
				{ "command": "ied.explorer.refresh", "group": "9_refresh" }
			],
			"output/context": [
				{ "command": "ied.output.clear", "group": "1_clear" },
				{ "command": "ied.output.toggleWrap", "group": "2_view" }
			]
		},
		"keybindings": [
			{ "command": "ied.editor.save", "key": "ctrl+s" },
			{ "command": "ied.explorer.rename", "key": "f2", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.explorer.delete", "key": "delete", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.editor.saveAll", "key": "ctrl+shift+s" },
			{ "command": "ied.find.inFiles", "key": "ctrl+shift+f" },
			{ "command": "ied.task.build", "key": "ctrl+shift+b" },
			{ "command": "ied.debug.start", "key": "f5" },
			{ "command": "ied.debug.stop", "key": "shift+f5", "when": "debugState" },
			{ "command": "ied.debug.restart", "key": "ctrl+shift+f5", "when": "debugState" },
			{ "command": "ied.debug.pause", "key": "ctrl+alt+break", "when": "debugState == 'running'" },
			{ "command": "ied.debug.stepOver", "key": "f10", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.stepInto", "key": "f11", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.stepOut", "key": "shift+f11", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.toggleBreakpoint", "key": "f9", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.debug.windows", "key": "ctrl+alt+b" },
			{ "command": "shell.showView", "key": "ctrl+alt+c", "args": { "id": "ied.callStack" } },
			{ "command": "shell.showView", "key": "ctrl+alt+v ctrl+l", "args": { "id": "ied.locals" } },
			{ "command": "shell.showView", "key": "ctrl+alt+w ctrl+1", "args": { "id": "ied.watch" } },
			{ "command": "shell.showView", "key": "ctrl+alt+h", "args": { "id": "ied.threads" } },
			{ "command": "ied.task.start", "key": "ctrl+f5" },
			{ "command": "ied.task.cancel", "key": "ctrl+break" },
			{ "command": "ied.editor.goToAll", "key": "ctrl+t" },
			{ "command": "ied.editor.goToAll", "key": "ctrl+," },
			{ "command": "ied.markdown.preview", "key": "ctrl+shift+v", "when": "activeTabKind == 'doc' && editorLanguage == 'markdown'" },
			{ "command": "ied.editor.toggleHeader", "key": "ctrl+k ctrl+o", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+c", "args": { "id": "editor.action.addCommentLine" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+u", "args": { "id": "editor.action.removeCommentLine" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+d", "args": { "id": "editor.action.formatDocument" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+f", "args": { "id": "editor.action.formatSelection" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+x", "args": { "id": "editor.action.trimTrailingWhitespace" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+0", "args": { "id": "editor.foldAll" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+j", "args": { "id": "editor.unfoldAll" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.action", "key": "ctrl+k ctrl+l", "args": { "id": "editor.toggleFold" }, "when": "activeTabKind == 'doc'" },
			{ "command": "ied.navigate.back", "key": "ctrl+-" },
			{ "command": "ied.navigate.forward", "key": "ctrl+shift+-" },
			{ "command": "shell.showView", "key": "ctrl+alt+l", "args": { "id": "ied.explorer" } },
			{ "command": "shell.showView", "key": "ctrl+alt+o", "args": { "id": "ied.output" } },
			{ "command": "shell.showView", "key": "ctrl+\\ ctrl+e", "args": { "id": "ied.errors" } }
		]
	}
}
