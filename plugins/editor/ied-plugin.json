// The Visual Studio-style IDE (plugins/README.md, docs/05): Solution Explorer over the workspace's files and solution
// model, the Output window over the output sources, server documents in Monaco with the language servers' features
// (docs/24), and the Error List of their diagnostics; builds and debugging follow.
{
	"manifestVersion": 1,
	"id": "ied.editor",
	"name": "Editor",
	"version": "0.1.0",
	"description": "Solution Explorer, Output and documents: the Visual Studio-shaped editor activity.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "ui": "ui/index.js" },
	"permissions": ["fs.read", "fs.write", "fs.watch", "ui.clipboard", "settings.write"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Text Editor" },
		"bindings": {
			"provides": [
				{
					"name": "editor.colorize",
					"version": "1",
					"kind": "function",
					"side": "client",
					"description": "Lines colored as the editor colors a language (or a file's language): HTML per line (docs/02 \"Client bindings as built\").",
					"params": { "type": "object", "required": ["lines"], "properties": { "path": { "type": "string" }, "languageId": { "type": "string" }, "lines": { "type": "array", "items": { "type": "string" } } } },
					"result": { "type": "array", "items": { "type": "string" } }
				},
				{
					"name": "editor.scrolled",
					"version": "1",
					"kind": "event",
					"side": "client",
					"description": "An editor scrolled: the file and the top line it shows (0-based, with the fraction of it scrolled past), for views that follow it (the Markdown preview).",
					"params": { "type": "object", "required": ["path", "line"], "properties": { "path": { "type": "string" }, "line": { "type": "number" } } }
				}
			]
		},
		"activities": [
			{ "id": "ied.editor", "title": "Editor", "icon": "$(code)", "order": 10, "phoneSlot": true, "newTab": "ied.editor.newFile" }
		],
		"toolWindows": [
			{ "id": "ied.explorer", "title": "Solution Explorer", "icon": "$(list-tree)", "view": "SolutionExplorer", "defaultDock": "left" },
			{ "id": "ied.output", "title": "Output", "icon": "$(output)", "view": "Output", "defaultDock": "right", "defaultSize": 0.4, "autoHide": true, "modes": { "debug": { "dock": "bottom", "group": "output", "size": 0.3, "autoHide": false } } },
			{ "id": "ied.errors", "title": "Error List", "icon": "$(error)", "view": "ErrorList", "defaultDock": "bottom", "autoHide": true, "modes": { "debug": { "dock": "bottom", "group": "output", "autoHide": false } } },
			{ "id": "ied.find", "title": "Find in Files", "icon": "$(search)", "view": "FindInFiles", "defaultDock": "bottom", "autoHide": true },
			{ "id": "ied.callStack", "title": "Call Stack", "icon": "$(debug-stackframe)", "view": "CallStack", "defaultDock": "bottom", "open": false, "modes": { "debug": { "dock": "bottom", "group": "output", "open": true } } },
			{ "id": "ied.locals", "title": "Locals", "icon": "$(symbol-variable)", "view": "Locals", "defaultDock": "bottom", "open": false, "modes": { "debug": { "dock": "bottom", "group": "variables", "open": true } } },
			{ "id": "ied.watch", "title": "Watch", "icon": "$(eye)", "view": "Watch", "defaultDock": "bottom", "open": false, "modes": { "debug": { "dock": "bottom", "group": "variables", "open": true } } },
			{ "id": "ied.threads", "title": "Threads", "icon": "$(list-flat)", "view": "Threads", "defaultDock": "bottom", "open": false, "modes": { "debug": { "dock": "bottom", "group": "variables", "open": true } } },
			{ "id": "ied.breakpoints", "title": "Breakpoints", "icon": "$(circle-filled)", "view": "Breakpoints", "defaultDock": "bottom", "open": false, "modes": { "debug": { "dock": "bottom", "group": "output", "open": true } } },
			{ "id": "ied.diagnosticTools", "title": "Diagnostic Tools", "icon": "$(pulse)", "view": "DiagnosticTools", "defaultDock": "right", "defaultSize": 0.25, "open": false, "modes": { "debug": { "dock": "right", "open": true } } }
		],
		"layoutModes": [
			{ "id": "debug", "title": "Debugging", "when": "debugState" }
		],
		"statusBarItems": [
			{ "id": "ied.editor.status", "alignment": "right", "priority": 100, "view": "EditorStatus" },
			{ "id": "ied.tasks.status", "alignment": "left", "priority": 50, "view": "TaskStatus", "command": "ied.task.showResult" }
		],
		"toolbarItems": [
			{ "id": "ied.tasks.toolbar", "view": "TaskToolbar", "priority": 100 },
			{ "id": "ied.debug.toolbar", "view": "DebugToolbar", "priority": 90 }
		],
		"commands": [
			{ "id": "ied.explorer.open", "title": "Open", "category": "Solution Explorer", "icon": "$(go-to-file)" },
			{ "id": "ied.explorer.refresh", "title": "Refresh", "category": "Solution Explorer", "icon": "$(refresh)" },
			{ "id": "ied.explorer.collapseAll", "title": "Collapse All", "category": "Solution Explorer", "icon": "$(collapse-all)" },
			{ "id": "ied.explorer.copyPath", "title": "Copy Full Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.copyRelativePath", "title": "Copy Relative Path", "category": "Solution Explorer" },
			{ "id": "ied.explorer.newFile", "title": "New File...", "category": "Solution Explorer", "icon": "$(new-file)" },
			{ "id": "ied.explorer.newFolder", "title": "New Folder", "category": "Solution Explorer", "icon": "$(new-folder)" },
			{ "id": "ied.explorer.rename", "title": "Rename", "category": "Solution Explorer", "icon": "$(edit)" },
			{ "id": "ied.explorer.delete", "title": "Delete", "category": "Solution Explorer", "icon": "$(trash)" },
			{ "id": "ied.output.clear", "title": "Clear All", "category": "Output", "icon": "$(clear-all)" },
			{ "id": "ied.output.toggleWrap", "title": "Toggle Word Wrap", "category": "Output", "icon": "$(word-wrap)" },
			{ "id": "ied.editor.newFile", "title": "New File", "category": "File", "icon": "$(new-file)" },
			{ "id": "ied.editor.save", "title": "Save", "category": "File", "icon": "$(save)" },
			{ "id": "ied.editor.saveAll", "title": "Save All", "category": "File", "icon": "$(save-all)" },
			{ "id": "ied.editor.goTo", "title": "Go To Place", "category": "Editor" },
			{ "id": "ied.find.inFiles", "title": "Find in Files", "category": "Edit", "icon": "$(search)" },
			{ "id": "ied.editor.goToAll", "title": "Go To All", "category": "Edit", "icon": "$(go-to-file)" },
			{ "id": "ied.editor.toggleWhitespace", "title": "View White Space", "category": "Edit", "icon": "$(whitespace)" },
			{ "id": "ied.editor.commentSelection", "title": "Comment Selection", "category": "Edit", "icon": "$(comment)" },
			{ "id": "ied.editor.uncommentSelection", "title": "Uncomment Selection", "category": "Edit" },
			{ "id": "ied.editor.toggleLineComment", "title": "Toggle Line Comment", "category": "Edit" },
			{ "id": "ied.editor.toggleBlockComment", "title": "Toggle Block Comment", "category": "Edit" },
			{ "id": "ied.editor.formatDocument", "title": "Format Document", "category": "Edit", "icon": "$(json)" },
			{ "id": "ied.editor.formatSelection", "title": "Format Selection", "category": "Edit" },
			{ "id": "ied.editor.trimTrailingWhitespace", "title": "Delete Trailing White Space", "category": "Edit" },
			{ "id": "ied.editor.duplicate", "title": "Duplicate", "category": "Edit" },
			{ "id": "ied.editor.cutLine", "title": "Cut Line", "category": "Edit" },
			{ "id": "ied.editor.deleteLine", "title": "Delete Line", "category": "Edit" },
			{ "id": "ied.editor.moveLinesUp", "title": "Move Selected Lines Up", "category": "Edit" },
			{ "id": "ied.editor.moveLinesDown", "title": "Move Selected Lines Down", "category": "Edit" },
			{ "id": "ied.editor.insertLineAbove", "title": "Insert Line Above", "category": "Edit" },
			{ "id": "ied.editor.insertLineBelow", "title": "Insert Line Below", "category": "Edit" },
			{ "id": "ied.editor.makeLowercase", "title": "Make Lowercase", "category": "Edit" },
			{ "id": "ied.editor.makeUppercase", "title": "Make Uppercase", "category": "Edit" },
			{ "id": "ied.editor.joinLines", "title": "Join Lines", "category": "Edit" },
			{ "id": "ied.editor.sortLines", "title": "Sort Lines", "category": "Edit" },
			{ "id": "ied.editor.expandSelection", "title": "Expand Selection", "category": "Edit" },
			{ "id": "ied.editor.contractSelection", "title": "Contract Selection", "category": "Edit" },
			{ "id": "ied.editor.insertNextMatchingCaret", "title": "Insert Next Matching Caret", "category": "Edit" },
			{ "id": "ied.editor.insertAllMatchingCarets", "title": "Insert Carets at All Matching", "category": "Edit" },
			{ "id": "ied.editor.insertCaretAbove", "title": "Insert Caret Above", "category": "Edit" },
			{ "id": "ied.editor.insertCaretBelow", "title": "Insert Caret Below", "category": "Edit" },
			{ "id": "ied.editor.boxSelectUp", "title": "Box Select Up", "category": "Edit" },
			{ "id": "ied.editor.boxSelectDown", "title": "Box Select Down", "category": "Edit" },
			{ "id": "ied.editor.boxSelectLeft", "title": "Box Select Left", "category": "Edit" },
			{ "id": "ied.editor.boxSelectRight", "title": "Box Select Right", "category": "Edit" },
			{ "id": "ied.editor.goToBrace", "title": "Go To Brace", "category": "Edit" },
			{ "id": "ied.editor.selectToBrace", "title": "Go To Brace Extend", "category": "Edit" },
			{ "id": "ied.editor.goToLine", "title": "Go To Line", "category": "Edit" },
			{ "id": "ied.editor.find", "title": "Find", "category": "Edit", "icon": "$(search)" },
			{ "id": "ied.editor.replace", "title": "Replace", "category": "Edit", "icon": "$(replace)" },
			{ "id": "ied.editor.findNext", "title": "Find Next", "category": "Edit" },
			{ "id": "ied.editor.findPrevious", "title": "Find Previous", "category": "Edit" },
			{ "id": "ied.editor.findNextSelected", "title": "Find Next Selected", "category": "Edit" },
			{ "id": "ied.editor.completeWord", "title": "Complete Word", "category": "Edit" },
			{ "id": "ied.editor.parameterInfo", "title": "Parameter Info", "category": "Edit" },
			{ "id": "ied.editor.quickInfo", "title": "Quick Info", "category": "Edit" },
			{ "id": "ied.editor.quickActions", "title": "Quick Actions and Refactorings", "category": "Edit", "icon": "$(lightbulb)" },
			{ "id": "ied.editor.rename", "title": "Rename", "category": "Edit" },
			{ "id": "ied.editor.goToDefinition", "title": "Go To Definition", "category": "Edit" },
			{ "id": "ied.editor.peekDefinition", "title": "Peek Definition", "category": "Edit" },
			{ "id": "ied.editor.goToImplementation", "title": "Go To Implementation", "category": "Edit" },
			{ "id": "ied.editor.findAllReferences", "title": "Find All References", "category": "Edit", "icon": "$(references)" },
			{ "id": "ied.editor.toggleOutlining", "title": "Toggle Outlining Expansion", "category": "Edit" },
			{ "id": "ied.editor.toggleAllOutlining", "title": "Toggle All Outlining", "category": "Edit" },
			{ "id": "ied.editor.collapseToDefinitions", "title": "Collapse to Definitions", "category": "Edit" },
			{ "id": "ied.editor.stopOutlining", "title": "Stop Outlining", "category": "Edit" },
			{ "id": "ied.editor.toggleWordWrap", "title": "Word Wrap", "category": "Edit", "icon": "$(word-wrap)" },
			{ "id": "ied.editor.zoomIn", "title": "Zoom In", "category": "Edit", "icon": "$(zoom-in)" },
			{ "id": "ied.editor.zoomOut", "title": "Zoom Out", "category": "Edit", "icon": "$(zoom-out)" },
			{ "id": "ied.editor.zoomReset", "title": "Reset Zoom", "category": "Edit" },
			{ "id": "ied.editor.open", "title": "Open File at a Place", "category": "Editor" },
			{ "id": "ied.task.build", "title": "Build", "category": "Build", "icon": "$(gear)" },
			{ "id": "ied.task.rebuild", "title": "Rebuild", "category": "Build" },
			{ "id": "ied.task.clean", "title": "Clean", "category": "Build" },
			{ "id": "ied.task.cancel", "title": "Cancel", "category": "Build", "icon": "$(debug-stop)" },
			{ "id": "ied.debug.start", "title": "Start Debugging / Continue", "category": "Debug", "icon": "$(debug-start)" },
			{ "id": "ied.debug.stop", "title": "Stop Debugging", "category": "Debug", "icon": "$(debug-stop)", "enablement": "debugState" },
			{ "id": "ied.debug.restart", "title": "Restart", "category": "Debug", "icon": "$(debug-restart)", "enablement": "debugState" },
			{ "id": "ied.debug.pause", "title": "Break All", "category": "Debug", "icon": "$(debug-pause)", "enablement": "debugState == 'running'" },
			{ "id": "ied.debug.stepOver", "title": "Step Over", "category": "Debug", "icon": "$(debug-step-over)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.stepInto", "title": "Step Into", "category": "Debug", "icon": "$(debug-step-into)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.stepOut", "title": "Step Out", "category": "Debug", "icon": "$(debug-step-out)", "enablement": "debugState == 'stopped'" },
			{ "id": "ied.debug.toggleBreakpoint", "title": "Toggle Breakpoint", "category": "Debug", "enablement": "activeTabKind == 'doc'" },
			{ "id": "ied.debug.windows", "title": "Breakpoints Window", "category": "Debug", "icon": "$(circle-filled)" },
			{ "id": "ied.task.start", "title": "Start Without Debugging", "category": "Debug", "icon": "$(run)" },
			{ "id": "ied.task.test", "title": "Run All Tests", "category": "Test", "icon": "$(beaker)" },
			{ "id": "ied.task.setStartup", "title": "Set as Startup Project", "category": "Project" },
			{ "id": "ied.task.showResult", "title": "Show Build Output", "category": "Build" },
			{ "id": "ied.output.show", "title": "Show Output", "category": "View", "icon": "$(output)" },
			{ "id": "ied.editor.toggleHeader", "title": "Toggle Header / Code File", "category": "Edit" },
			{ "id": "ied.editor.openCounterpartBeside", "title": "Open Header / Code File to the Side", "category": "Edit", "icon": "$(go-to-file)" },
			{ "id": "ied.editor.action", "title": "Editor Action", "category": "Edit" },
			{ "id": "ied.navigate.back", "title": "Navigate Backward", "category": "View", "icon": "$(arrow-left)" },
			{ "id": "ied.navigate.forward", "title": "Navigate Forward", "category": "View", "icon": "$(arrow-right)" }
		],
		"fileOpener": { "command": "ied.editor.open" },
		"menus": {
			"menubar/build": [
				{ "command": "ied.task.build", "group": "1_build" },
				{ "command": "ied.task.rebuild", "group": "1_build", "order": 1 },
				{ "command": "ied.task.clean", "group": "1_build", "order": 2 },
				{ "command": "ied.task.cancel", "group": "2_cancel" }
			],
			"menubar/debug": [
				{ "command": "ied.debug.start", "group": "1_start" },
				{ "command": "ied.task.start", "group": "1_start", "order": 1 },
				{ "command": "ied.debug.pause", "group": "2_run" },
				{ "command": "ied.debug.stop", "group": "2_run", "order": 1 },
				{ "command": "ied.debug.restart", "group": "2_run", "order": 2 },
				{ "command": "ied.debug.stepOver", "group": "3_step" },
				{ "command": "ied.debug.stepInto", "group": "3_step", "order": 1 },
				{ "command": "ied.debug.stepOut", "group": "3_step", "order": 2 },
				{ "command": "ied.debug.toggleBreakpoint", "group": "4_breakpoints" },
				{ "command": "ied.debug.windows", "group": "5_windows" }
			],
			"menubar/test": [
				{ "command": "ied.task.test", "group": "1_run" }
			],
			"menubar/edit": [
				{ "command": "ied.find.inFiles", "group": "3_find" },
				{ "command": "ied.editor.goToAll", "group": "4_go" },
				{ "command": "ied.editor.toggleWhitespace", "group": "5_view" }
			],
			"menubar/view": [
				{ "command": "ied.navigate.back", "group": "1_navigate" },
				{ "command": "ied.navigate.forward", "group": "1_navigate", "order": 1 }
			],
			"menubar/file": [
				{ "command": "ied.editor.newFile", "group": "0_new" },
				{ "command": "ied.editor.save", "group": "5_save" },
				{ "command": "ied.editor.saveAll", "group": "5_save", "order": 1 }
			],
			"toolbar/main": [
				{ "command": "ied.navigate.back", "group": "0_navigate" },
				{ "command": "ied.navigate.forward", "group": "0_navigate", "order": 1 },
				{ "command": "ied.editor.save", "group": "1_file" },
				{ "command": "ied.editor.saveAll", "group": "1_file", "order": 1 }
			],
			"explorer/context": [
				{ "command": "ied.task.setStartup", "group": "0_startup", "when": "explorerItemKind == 'project'" },
				{ "command": "ied.explorer.open", "group": "1_open", "when": "explorerItemKind == 'file'" },
				{ "command": "ied.explorer.newFile", "group": "2_new", "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.newFolder", "group": "2_new", "order": 1, "when": "explorerItemKind == 'folder' || explorerItemKind == 'project' || explorerItemKind == 'file'" },
				{ "command": "ied.explorer.rename", "group": "4_edit", "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.delete", "group": "4_edit", "order": 1, "when": "explorerItemKind == 'file' || explorerItemKind == 'folder'" },
				{ "command": "ied.explorer.copyPath", "group": "5_copy" },
				{ "command": "ied.explorer.copyRelativePath", "group": "5_copy", "order": 1 },
				{ "command": "ied.explorer.refresh", "group": "9_refresh" }
			],
			"output/context": [
				{ "command": "ied.output.clear", "group": "1_clear" },
				{ "command": "ied.output.toggleWrap", "group": "2_view" }
			]
		},
		"keybindings": [
			{ "command": "ied.editor.toggleWhitespace", "key": "ctrl+r ctrl+w", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.commentSelection", "key": "ctrl+k ctrl+c", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.uncommentSelection", "key": "ctrl+k ctrl+u", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleLineComment", "key": "ctrl+/", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleBlockComment", "key": "ctrl+shift+/", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.formatDocument", "key": "ctrl+k ctrl+d", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.formatSelection", "key": "ctrl+k ctrl+f", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.trimTrailingWhitespace", "key": "ctrl+k ctrl+x", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.duplicate", "key": "ctrl+d", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.cutLine", "key": "ctrl+l", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.deleteLine", "key": "ctrl+shift+l", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.moveLinesUp", "key": "alt+up", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.moveLinesDown", "key": "alt+down", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertLineAbove", "key": "ctrl+enter", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertLineBelow", "key": "ctrl+shift+enter", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.makeLowercase", "key": "ctrl+u", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.makeUppercase", "key": "ctrl+shift+u", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.joinLines", "key": "shift+alt+l shift+alt+j", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.expandSelection", "key": "shift+alt+=", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.contractSelection", "key": "shift+alt+-", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertNextMatchingCaret", "key": "shift+alt+.", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertAllMatchingCarets", "key": "shift+alt+;", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertCaretAbove", "key": "ctrl+alt+up", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.insertCaretBelow", "key": "ctrl+alt+down", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.boxSelectUp", "key": "shift+alt+up", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.boxSelectDown", "key": "shift+alt+down", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.boxSelectLeft", "key": "shift+alt+left", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.boxSelectRight", "key": "shift+alt+right", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.goToBrace", "key": "ctrl+]", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.selectToBrace", "key": "ctrl+shift+]", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.goToLine", "key": "ctrl+g", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.find", "key": "ctrl+f", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.replace", "key": "ctrl+h", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.findNext", "key": "f3", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.findPrevious", "key": "shift+f3", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.findNextSelected", "key": "ctrl+f3", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.completeWord", "key": "ctrl+space", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.completeWord", "key": "ctrl+j", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.parameterInfo", "key": "ctrl+shift+space", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.quickInfo", "key": "ctrl+k ctrl+i", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.quickActions", "key": "ctrl+.", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.quickActions", "key": "alt+enter", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.rename", "key": "ctrl+r ctrl+r", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.goToDefinition", "key": "f12", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.peekDefinition", "key": "alt+f12", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.goToImplementation", "key": "ctrl+f12", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.findAllReferences", "key": "shift+f12", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleOutlining", "key": "ctrl+m ctrl+m", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleOutlining", "key": "ctrl+k ctrl+l", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleAllOutlining", "key": "ctrl+m ctrl+l", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.collapseToDefinitions", "key": "ctrl+m ctrl+o", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.collapseToDefinitions", "key": "ctrl+k ctrl+0", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.stopOutlining", "key": "ctrl+m ctrl+p", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.stopOutlining", "key": "ctrl+k ctrl+j", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.toggleWordWrap", "key": "ctrl+e ctrl+w", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.zoomIn", "key": "ctrl+shift+.", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.zoomOut", "key": "ctrl+shift+,", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.newFile", "key": "ctrl+n" },
			{ "command": "ied.editor.save", "key": "ctrl+s" },
			{ "command": "ied.explorer.rename", "key": "f2", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.explorer.delete", "key": "delete", "when": "activeTab == 'ied.explorer' && (explorerItemKind == 'file' || explorerItemKind == 'folder') && !inputFocus" },
			{ "command": "ied.editor.saveAll", "key": "ctrl+shift+s" },
			{ "command": "ied.find.inFiles", "key": "ctrl+shift+f" },
			{ "command": "ied.task.build", "key": "ctrl+shift+b" },
			{ "command": "ied.debug.start", "key": "f5" },
			{ "command": "ied.debug.stop", "key": "shift+f5", "when": "debugState" },
			{ "command": "ied.debug.restart", "key": "ctrl+shift+f5", "when": "debugState" },
			{ "command": "ied.debug.pause", "key": "ctrl+alt+break", "when": "debugState == 'running'" },
			{ "command": "ied.debug.stepOver", "key": "f10", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.stepInto", "key": "f11", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.stepOut", "key": "shift+f11", "when": "debugState == 'stopped'" },
			{ "command": "ied.debug.toggleBreakpoint", "key": "f9", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.debug.windows", "key": "ctrl+alt+b" },
			{ "command": "shell.showView", "key": "ctrl+alt+c", "args": { "id": "ied.callStack" } },
			{ "command": "shell.showView", "key": "ctrl+alt+f2", "args": { "id": "ied.diagnosticTools" }, "when": "debugState" },
			{ "command": "shell.showView", "key": "ctrl+alt+v ctrl+l", "args": { "id": "ied.locals" } },
			{ "command": "shell.showView", "key": "ctrl+alt+w ctrl+1", "args": { "id": "ied.watch" } },
			{ "command": "shell.showView", "key": "ctrl+alt+h", "args": { "id": "ied.threads" } },
			{ "command": "ied.task.start", "key": "ctrl+f5" },
			{ "command": "ied.task.cancel", "key": "ctrl+break" },
			{ "command": "ied.editor.goToAll", "key": "ctrl+t" },
			{ "command": "ied.editor.goToAll", "key": "ctrl+," },
			{ "command": "ied.editor.toggleHeader", "key": "ctrl+k ctrl+o", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.editor.openCounterpartBeside", "key": "ctrl+k ctrl+shift+o", "when": "activeTabKind == 'doc'" },
			{ "command": "ied.navigate.back", "key": "ctrl+-" },
			{ "command": "ied.navigate.forward", "key": "ctrl+shift+-" },
			{ "command": "shell.showView", "key": "ctrl+alt+l", "args": { "id": "ied.explorer" } },
			{ "command": "shell.showView", "key": "ctrl+alt+o", "args": { "id": "ied.output" } },
			{ "command": "shell.showView", "key": "ctrl+\\ ctrl+e", "args": { "id": "ied.errors" } }
		]
	}
}
