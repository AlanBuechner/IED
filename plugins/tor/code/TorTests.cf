// torrc: the torrc the plugin writes and the control port's replies it reads, as Tor 0.4.9 writes them.

include "Torrc.ch"

static Core::Array<Core::String> Countries(const char* a, const char* b) {
	Core::Array<Core::String> list;
	if (a) list.Push(Core::String(a));
	if (b) list.Push(Core::String(b));
	return list;
}

[test("server.tor.torrc")]
class TorrcTests {
	[test("ports_cookie_files_and_log")]
	public static void TestPlain() {
		Tor::TorFiles files;
		files.m_State = Core::String("C:/Users/A B/IED/plugins/ied.tor");
		files.m_Geoip = Core::String("C:/IED/vendor/tor/data/geoip");
		Core::String text = Tor::TorrcText(files, Countries(null, null));
		assert_true(text.View().Contains(Core::StringView("SocksPort 127.0.0.1:auto\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("ControlPort 127.0.0.1:auto\nCookieAuthentication 1\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("DataDirectory \"C:/Users/A B/IED/plugins/ied.tor/data\"\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("ControlPortWriteToFile \"C:/Users/A B/IED/plugins/ied.tor/control-port\"\n")), text.CStr());
		assert_true(text.View().Contains(Core::StringView("GeoIPFile \"C:/IED/vendor/tor/data/geoip\"\n")), text.CStr());
		assert_true(!text.View().Contains(Core::StringView("GeoIPv6File")), text.CStr());
		assert_true(!text.View().Contains(Core::StringView("ExitNodes")), text.CStr());
		assert_true(text.View().EndsWith(Core::StringView("Log notice file C:/Users/A B/IED/plugins/ied.tor/tor.log\n")), text.CStr());
	}

	[test("exit_countries_lowercased_strict")]
	public static void TestExits() {
		Tor::TorFiles files;
		files.m_State = Core::String("C:/s");
		Core::String text = Tor::TorrcText(files, Countries("DE", "nl"));
		assert_true(text.View().Contains(Core::StringView("ExitNodes {de},{nl}\nStrictNodes 1\n")), text.CStr());
	}

	[test("a_quote_or_backslash_in_a_path_is_escaped")]
	public static void TestEscapes() {
		Tor::TorFiles files;
		files.m_State = Core::String("C:/a\"b\\c");
		Core::String text = Tor::TorrcText(files, Countries(null, null));
		assert_true(text.View().Contains(Core::StringView("DataDirectory \"C:/a\\\"b\\\\c/data\"\n")), text.CStr());
	}
}

[test("server.tor.replies")]
class TorRepliesTests {
	[test("the_control_ports_file")]
	public static void TestControlPort() {
		assert_eq((int64)55146, (int64)Tor::ControlPortOf(Core::StringView("PORT=127.0.0.1:55146\n")), "port");
		assert_eq((int64)9051, (int64)Tor::ControlPortOf(Core::StringView("PORT=127.0.0.1:9051\r\n")), "port");
		assert_eq((int64)0, (int64)Tor::ControlPortOf(Core::StringView("")), "port");
		assert_eq((int64)0, (int64)Tor::ControlPortOf(Core::StringView("PORT=127.0.0.1:")), "port");
		assert_eq((int64)0, (int64)Tor::ControlPortOf(Core::StringView("UNIX_PORT=/tmp/x")), "port");
	}

	[test("the_socks_listener")]
	public static void TestSocks() {
		assert_eq((int64)55145, (int64)Tor::SocksPortOf(Core::StringView("250-net/listeners/socks=\"127.0.0.1:55145\"")), "port");
		assert_eq((int64)9150, (int64)Tor::SocksPortOf(Core::StringView("250-net/listeners/socks=\"127.0.0.1:9150\" \"[::1]:9150\"")), "port");
		assert_eq((int64)0, (int64)Tor::SocksPortOf(Core::StringView("250-net/listeners/socks=")), "port");
		assert_eq((int64)0, (int64)Tor::SocksPortOf(Core::StringView("250 OK")), "port");
	}

	[test("bootstrap_progress_and_summary")]
	public static void TestBootstrap() {
		int32 progress = -1;
		Core::String summary;
		assert_true(Tor::BootstrapOf(Core::StringView("250-status/bootstrap-phase=NOTICE BOOTSTRAP PROGRESS=100 TAG=done SUMMARY=\"Done\""), progress, summary), "done");
		assert_eq((int64)100, (int64)progress, "progress");
		assert_true(summary.View() == "Done", summary.CStr());
		assert_true(Tor::BootstrapOf(Core::StringView("250-status/bootstrap-phase=NOTICE BOOTSTRAP PROGRESS=45 TAG=requesting_descriptors SUMMARY=\"Asking for relay descriptors\""), progress, summary), "45");
		assert_eq((int64)45, (int64)progress, "progress");
		assert_true(summary.View() == "Asking for relay descriptors", summary.CStr());
		assert_true(!Tor::BootstrapOf(Core::StringView("250 OK"), progress, summary), "no progress");
		assert_true(!Tor::BootstrapOf(Core::StringView("250-x=NOTPROGRESS=5"), progress, summary), "a longer key is not PROGRESS");
	}

	[test("hex_of_the_cookie")]
	public static void TestHex() {
		uint8[4] bytes;
		bytes[0] = (uint8)0;
		bytes[1] = (uint8)15;
		bytes[2] = (uint8)171;
		bytes[3] = (uint8)255;
		Core::String hex = Tor::Hex(&bytes[0], 4);
		assert_true(hex.View() == "000fabff" || hex.View() == "000FABFF", hex.CStr());
	}

	[test("the_logs_warnings_else_its_end")]
	public static void TestLogTail() {
		Core::String quiet = Tor::LogTail(Core::StringView("a [notice] one\nb [notice] two\nc [notice] three\n"), 2);
		assert_true(quiet.View() == "b [notice] two | c [notice] three", quiet.CStr());
		Core::String loud = Tor::LogTail(Core::StringView("a [notice] one\nb [warn] bad\nc [notice] three\nd [err] worse\n"), 3);
		assert_true(loud.View() == "b [warn] bad | d [err] worse", loud.CStr());
		assert_true(Tor::LogTail(Core::StringView(""), 3).IsEmpty(), "empty");
	}
}
