include "TorControl.ch"
include "Torrc.ch"

namespace Tor
{
	static bool ReadCookie(Core::StringView path, Core::String& hex, Core::String& error) {
		Core::String file = Core::String(path);
		FS::File opened = FS::File(file.CStr(), "rb");
		uint8[32] cookie;
		if (!opened.IsOpen() || opened.Read((void*)&cookie[0], c_CookieBytes) != c_CookieBytes) {
			error = Core::String("Tor's cookie file cannot be read: ") + path;
			return false;
		}
		hex = Hex(&cookie[0], c_CookieBytes);
		return true;
	}

	bool TorControl::Open(int32 port, Core::StringView cookieFile, Core::String& error) {
		Close();
		Core::String hex;
		if (!ReadCookie(cookieFile, hex, error)) return false;
		m_Stream = Net::TcpStream::Connect(Net::Address::Loopback(port), c_ControlMs);
		if (!m_Stream.IsOpen()) {
			error = Core::String("Tor's control port does not answer: ") + m_Stream.Error();
			return false;
		}
		Core::Array<Core::String> lines;
		if (!Command((Core::String("AUTHENTICATE ") + hex.View()).View(), lines, error) || !Command(Core::StringView("TAKEOWNERSHIP"), lines, error)) {
			Close();
			return false;
		}
		return true;
	}

	void TorControl::Close() {
		m_Stream.Close();
		m_Received.Clear();
	}

	bool TorControl::ReadLine(Core::String& line, Core::String& error) {
		char[4096] buffer;
		while (true) {
			const int64 newline = m_Received.View().IndexOf('\n', 0);
			if (newline >= 0) {
				Core::StringView text = m_Received.View().Substring(0, newline);
				if (text.EndsWith(Core::StringView("\r"))) text = text.Substring(0, text.ByteLength() - 1);
				line = Core::String(text);
				m_Received = Core::String(m_Received.View().Substring(newline + 1, m_Received.ByteLength() - newline - 1));
				return true;
			}
			const int64 got = m_Stream.Receive((void*)&buffer[0], 4096, c_ControlMs);
			if (got <= 0) {
				error = m_Stream.TimedOut() ? Core::String("Tor's control port did not answer in time") : Core::String("Tor's control port closed");
				Close();
				return false;
			}
			m_Received += Core::StringView(&buffer[0], got);
		}
	}

	// A reply ends at a line whose fourth character is a space ("250 OK"); "250-" lines go before it and a "250+" line
	// starts data that ends with a line of ".".
	bool TorControl::Command(Core::StringView command, Core::Array<Core::String>& lines, Core::String& error) {
		lines.Clear();
		if (!m_Stream.IsOpen()) {
			error = Core::String("Tor's control port is not connected");
			return false;
		}
		if (!m_Stream.SendText((Core::String(command) + "\r\n").View(), c_ControlMs)) {
			error = Core::String("Tor's control port took no command: ") + m_Stream.Error();
			Close();
			return false;
		}
		Core::String line;
		while (ReadLine(line, error)) {
			lines.Push(line);
			if (line.ByteLength() >= 4 && line.View().ByteAt(3) == '+') {
				while (ReadLine(line, error) && line.View() != ".") lines.Push(line);
				continue;
			}
			if (line.ByteLength() >= 4 && line.View().ByteAt(3) != ' ') continue;
			if (line.View().StartsWith(Core::StringView("2"))) return true;
			const int64 space = command.IndexOf(' ', 0);
			error = Core::String("Tor refused ") + (space < 0 ? command : command.Substring(0, space)) + ": " + line.View();
			return false;
		}
		return false;
	}
}
