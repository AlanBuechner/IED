// What the nuke plugin's package fetch decides from text (NukePackages.ch).

include "NukePackages.ch"

static IED::CommandResult Ran(int32 exitCode, const char* output, const char* problem) {
	IED::CommandResult ran;
	ran.m_Started = true;
	ran.m_ExitCode = exitCode;
	ran.m_Output = Core::String(output);
	ran.m_Problem = Core::String(problem);
	return ran;
}

[test("server.nukeplugin.packages")]
class NukePackagesTests {
	[test("uses_packages")]
	public static void TestUsesPackages() {
		assert_true(NukePlugin::UsesPackages(Core::StringView("[workspace]\nname = \"Game\"\n\n[sources]\nclaymore = \"https://x/claymore.git\"\n")), "a [sources] table");
		assert_true(NukePlugin::UsesPackages(Core::StringView("[packages]   # what it uses\r\nWindowing = \"claymore@^0.2\"\r\n")), "a [packages] table, CRLF and a comment");
		assert_true(NukePlugin::UsesPackages(Core::StringView("[workspace]\n[packages.Renderer]\nsource = \"claymore\"\n")), "a table under [packages]");
		assert_true(NukePlugin::UsesPackages(Core::StringView("packages.Windowing = \"claymore@^0.2\"\n[workspace]\n")), "a dotted key before any table");
		assert_true(!NukePlugin::UsesPackages(Core::StringView("[workspace]\npackages-dir = \"deps\"\n[project]\nname = \"Game\"\n")), "packages-dir is no package");
		assert_true(!NukePlugin::UsesPackages(Core::StringView("[package]\ndescription = \"x\"\n[package.dependencies]\nA = { source = \"u\" }\n")), "a package's own manifest uses none by itself");
		assert_true(!NukePlugin::UsesPackages(Core::StringView("[workspace]\nsources = 1\n# [packages]\n")), "a key inside another table, a comment");
	}

	[test("interval")]
	public static void TestInterval() {
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("5")) == 300000, "minutes");
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("0.05")) == 3000, "a part of a minute");
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("0")) == 0, "0 is off");
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("-1")) == 0, "below 0 is off");
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("null")) == 0, "no value is off");
		assert_true(NukePlugin::FetchIntervalMs(Core::StringView("\"5\"")) == 0, "a string is no number");
	}

	[test("command")]
	public static void TestCommand() {
		assert_true(NukePlugin::NukeCommand(Core::StringView("\"nuke\"")) == "nuke", "a name");
		assert_true(NukePlugin::NukeCommand(Core::StringView("\"\\\"C:/IED/bin/nuke.cmd\\\"\"")) == "C:/IED/bin/nuke.cmd", "a path written quoted");
		assert_true(NukePlugin::NukeCommand(Core::StringView("\"\"")) == "nuke", "empty: nuke");
		assert_true(NukePlugin::NukeCommand(Core::StringView("null")) == "nuke", "unset: nuke");
		Core::Array<Core::String> words;
		words.Push(Core::String("status"));
		words.Push(Core::String("--fetch"));
		Core::Array<Core::String> batch = NukePlugin::PackageCommand(Core::StringView("C:/IED/bin/NUKE.CMD"), words);
		assert_true(batch.Count() == 7 && batch[0] == "cmd.exe" && batch[3] == "C:/IED/bin/NUKE.CMD" && batch[6] == "--fetch", "a batch file through cmd.exe");
		Core::Array<Core::String> program = NukePlugin::PackageCommand(Core::StringView("D:/nuke.exe"), words);
		assert_true(program.Count() == 4 && program[0] == "D:/nuke.exe" && program[1] == "package" && program[2] == "status", "a program itself");
	}

	[test("printed_json")]
	public static void TestPrintedJson() {
		Core::String found = NukePlugin::PrintedJson(Core::StringView("nuke: fetching claymore\n{\n  \"packages\": [\n    {\n      \"path\": \"UI\"\n    }\n  ]\n}\nnuke: warning: x\n"));
		assert_true(found == "{\n  \"packages\": [\n    {\n      \"path\": \"UI\"\n    }\n  ]\n}", "the document between the notes, its inner braces indented");
		assert_true(NukePlugin::PrintedJson(Core::StringView("{}\r\n")) == "{}", "one line, CRLF");
		assert_true(NukePlugin::PrintedJson(Core::StringView("{\r\n  \"a\": 1\r\n}\r\n")) == "{\r\n  \"a\": 1\r\n}", "CRLF lines");
		assert_true(NukePlugin::PrintedJson(Core::StringView("nuke: error: no source named 'x'\n")).IsEmpty(), "no document");
		assert_true(NukePlugin::PrintedJson(Core::StringView("{\n  \"cut\": 1\n")).IsEmpty(), "a document cut short");
	}

	[test("actions")]
	public static void TestActions() {
		assert_true(NukePlugin::IsPackageAction(Core::StringView("update")) && NukePlugin::IsPackageAction(Core::StringView("release")), "actions");
		assert_true(!NukePlugin::IsPackageAction(Core::StringView("status")) && !NukePlugin::IsPackageAction(Core::StringView("--help")) && !NukePlugin::IsPackageAction(Core::StringView("")), "not actions");
	}

	[test("failure")]
	public static void TestFailure() {
		assert_true(NukePlugin::FetchFailure(Ran(0, "claymore: developing in packages/claymore\n", "")).IsEmpty(), "it worked");
		assert_true(NukePlugin::FetchFailure(Ran(1, "", "the workspace is not trusted: commands cannot run in it")) == "the workspace is not trusted: commands cannot run in it", "why it did not run");
		Core::String error = NukePlugin::FetchFailure(Ran(1, "resolving\nnuke: error: git fetch in C:/w/packages/claymore: fatal: unable to access\n  'https://x/': Could not resolve host\n", ""));
		assert_true(error == "exit 1: nuke: error: git fetch in C:/w/packages/claymore: fatal: unable to access\n  'https://x/': Could not resolve host", "Nuke's error, from its line to the end");
		assert_true(NukePlugin::FetchFailure(Ran(9009, "'nuke' is not recognized\n", "")) == "exit 9009: 'nuke' is not recognized", "the output when Nuke said nothing");
		assert_true(NukePlugin::FetchFailure(Ran(2, " \n", "")) == "exit 2", "no output");
		Core::StringBuilder longer;
		longer.Append("nuke: error: ");
		for (int64 i = 0; i < 300; ++i) longer.Append("0123456789");
		Core::String bounded = NukePlugin::FetchFailure(Ran(1, longer.ToString().CStr(), ""));
		assert_true(bounded.View().ByteLength() < 2100 && bounded.View().EndsWith(Core::StringView(" [...]")), "a long error is cut");
	}
}
