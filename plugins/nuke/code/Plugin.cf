// The built-in nuke plugin's entry (docs/26 "Built-ins on the API"): its declarative contributions are the manifest's;
// its code fetches each workspace's Nuke packages on a timer, so a develop clone behind its remote turns read-only by
// itself (PackageFetcher.ch, docs/31 section 6); and it runs the Package Manager window's Nuke commands
// (PackageManager.ch, docs/31 section 8).
include "PackageFetcher.ch"
include "PackageManager.ch"

namespace NukePlugin
{
	void Activate(IED::PluginContext& context)
	{
		PackageFetcher* fetcher = new PackageFetcher(&context);
		PackageManager* manager = new PackageManager(&context);
		fetcher->Start();
		manager->Start();
		context.OnDeactivate([fetcher, manager]() {
			fetcher->Stop();
			manager->Stop();
		});
	}
}
