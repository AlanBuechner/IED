// Nuke (docs/06, docs/23, docs/26 section 6): IDE support for the Nuke build system, for every language it builds - the
// `nuke` task preset (Configuration and Platform for the solution; Build, Rebuild, Clean, Run and Test running
// `nuke <verb> <config> <project> -a <arch>`), the command that starts Nuke, and nuke.toml's icon. A language's plugin
// extends the preset as `<language>.nuke` with its compiler's problem matchers and its launch configuration (the C4
// toolchain's plugin: `c4.nuke`); `nuke init --ied` names that preset in each project's file. Its skill (skills/nuke)
// teaches the AI Nuke's commands and manifests. Its code (code/, built in) fetches a workspace's Nuke packages when it
// opens and every nuke.packages.fetchMinutes, so a develop clone that falls behind its remote turns read-only by itself
// (docs/31 section 6); and it runs the Package Manager's Nuke commands for its window (ui/, docs/31 section 8).
{
	"manifestVersion": 1,
	"id": "ied.nuke",
	"name": "Nuke",
	"version": "0.1.0",
	"description": "Builds, runs and tests with the Nuke build system, for every language it builds.",
	"publisher": "IED",
	"ied": { "api": "^1" },
	"runtime": { "kind": "builtin", "entry": "NukePlugin::Activate", "ui": "ui/index.js" },
	"activation": ["onWorkspaceContains:nuke.toml"],
	"permissions": ["process.spawn", "fs.read"],
	"contributes": {
		"settings": { "schema": "settings.schema.json", "page": "Build/Nuke" },
		"skills": ["skills"],
		"bindings": {
			"provides": [
				{ "name": "nuke.packages.refresh", "version": "1", "kind": "function", "description": "Reads workspace wsId's packages again (nuke package status --json; fetch: ask the remotes first) into the topic packages:<wsId>: {wsId, fetch?} -> {queued}." },
				{ "name": "nuke.packages.browse", "version": "1", "kind": "function", "description": "Reads the packages a source offers (nuke package browse <source> --json; offline: from the machine's mirror, no fetch) into packages:<wsId>: {wsId, source, offline?} -> {queued}." },
				{ "name": "nuke.packages.run", "version": "1", "kind": "function", "description": "Runs nuke package <args> in workspace wsId after what is queued there - args[0] update, add, remove, develop, lock, pull, release or source - its output in packages:<wsId>, then reads the status again: {wsId, args} -> {queued}." }
			],
			"consumes": [
				{ "name": "nuke.packages.refresh", "version": "1" },
				{ "name": "nuke.packages.browse", "version": "1" },
				{ "name": "nuke.packages.run", "version": "1" }
			]
		},
		"commands": [
			{ "id": "ied.nuke.packages", "title": "Manage Packages...", "category": "Nuke", "icon": "$(package)" }
		],
		"menus": {
			"menubar/tools": [
				{ "command": "ied.nuke.packages", "group": "2_packages" }
			],
			"explorer/context": [
				{ "command": "ied.nuke.packages", "group": "3_packages", "when": "explorerItemKind == 'solution' || explorerItemKind == 'project' || explorerItemKind == 'deps' || explorerItemKind == 'dep-packages' || explorerItemKind == 'package'" }
			]
		},
		"systemMessageSections": [
			{ "id": "nuke", "when": "workspaceContains.nuke.toml", "text": "This workspace builds with Nuke (nuke.toml manifests). Read the nuke skill before changing a manifest or a build step; nuke_list gives the projects, their kinds and dependencies. Projects under packages/ come from Nuke packages (nuke_packages): a locked package is read-only - to change one, develop its source (nuke_package develop), never edit or copy its files." }
		],
		"toolCalls": [
			{
				"name": "nuke_list",
				"description": "The workspace's Nuke projects: names, kinds, languages, folders and dependencies, as JSON.",
				"class": "read",
				"inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
				"run": ["${config:nuke.command}", "list", "--json"],
				"output": "json",
				"when": "workspaceContains.nuke.toml"
			},
			{
				"name": "nuke_packages",
				"description": "The workspace's Nuke packages (projects from git repositories, docs/31): each versioned package's source, version, commit, projects, folder and whether it is locked (read-only) or developed in a git clone (writable while it is not behind its remote); each clone's branch and how far it is ahead of and behind its remote. fetch: ask the remotes for newer releases and fetch the clones first.",
				"class": "read",
				"inputSchema": { "type": "object", "properties": { "options": { "type": "array", "items": { "enum": ["--fetch"] }, "description": "[\"--fetch\"]: ask the remotes first (network)." } }, "additionalProperties": false },
				"run": ["${config:nuke.command}", "package", "status", "--json", "${args.options}"],
				"output": "json",
				"when": "workspaceContains.nuke.toml"
			},
			{
				"name": "nuke_package",
				"description": "Change the workspace's packages. develop SOURCE: its packages build from a clone in packages/<source>/ to edit together with the program (the lock follows the clone's commits). lock SOURCE: back to read-only installs once the clone's commits are pushed. pull SOURCE: bring a clone up to date (a clone behind its remote is read-only). update [NAME...]: the newest versions the requirements allow. add SOURCE PACKAGE [REQUIREMENT]: use a package (SOURCE a [sources] name or a git URL). remove PACKAGE.",
				"class": "exec",
				"inputSchema": {
					"type": "object",
					"properties": {
						"action": { "enum": ["develop", "lock", "pull", "update", "add", "remove"] },
						"arguments": { "type": "array", "items": { "type": "string" }, "description": "The action's words: a source, a package path, a requirement." }
					},
					"required": ["action"],
					"additionalProperties": false
				},
				"run": ["${config:nuke.command}", "package", "${args.action}", "${args.arguments}"],
				"when": "workspaceContains.nuke.toml"
			},
			{
				"name": "nuke_package_release",
				"description": "Release packages: tag each one's next version at HEAD of its checkout (a develop clone, or this repository of packages) and push the branch and the tags. Refuses uncommitted changes, a checkout behind its remote, and a package using another of its repository with unreleased changes; releases again the dependents a new version would leave behind. Without a part, a first release is 0.1.0 and later ones a patch.",
				"class": "net",
				"approval": "ask",
				"inputSchema": {
					"type": "object",
					"properties": {
						"packages": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Package paths in their repository (Windowing, Renderer/RHI)." },
						"part": { "enum": ["--patch", "--minor", "--major"] },
						"source": { "type": "string", "description": "Which develop clone, when several sources are developed." }
					},
					"required": ["packages"],
					"additionalProperties": false
				},
				"run": ["${config:nuke.command}", "package", "release", "${args.packages}", "${args.part}", "--source=${args.source}"],
				"when": "workspaceContains.nuke.toml"
			}
		],
		"fileIcons": [
			{ "fileNames": ["nuke.toml"], "label": "NK", "color": "--hue-red" }
		],
		"projectSystems": [
			{
				"id": "nuke",
				"label": "Nuke",
				"detect": "nuke.toml",
				"generate": [{ "label": "nuke init --ied", "run": "\"${config:nuke.command}\" init --ied" }],
				"add": [{ "label": "nuke project add", "run": "\"${config:nuke.command}\" project add \"${folder}\" --name \"${name}\" --language \"${language}\" --kind \"${kind}\"" }],
				"remove": [{ "label": "nuke project remove", "run": "\"${config:nuke.command}\" project remove ${projectName}" }],
				"delete": [{ "label": "nuke project remove", "run": "\"${config:nuke.command}\" project remove ${projectName} --deleting" }],
				"move": [{ "label": "nuke project move", "run": "\"${config:nuke.command}\" project move \"${from}\" \"${to}\"" }]
			}
		],
		"taskPresets": [
			{
				"id": "nuke",
				"label": "Nuke",
				"detect": "nuke.toml",
				"variables": {
					"config": { "kind": "dropdown", "label": "Configuration", "values": ["Debug", "Development", "Dist"], "default": "Development", "scope": "solution" },
					"arch": { "kind": "dropdown", "label": "Platform", "values": ["x64"], "default": "x64", "scope": "solution" }
				},
				"tasks": {
					"build": { "label": "Build", "icon": "$(build)", "slot": "build", "steps": [{ "run": "\"${config:nuke.command}\" build ${config} ${projectName} -a ${arch}" }] },
					"rebuild": { "label": "Rebuild", "slot": "rebuild", "steps": [{ "run": "\"${config:nuke.command}\" rebuild ${config} ${projectName} -a ${arch}" }] },
					"clean": { "label": "Clean", "slot": "clean", "steps": [{ "run": "\"${config:nuke.command}\" clean ${config} ${projectName} -a ${arch}" }] },
					"run": { "label": "Run", "icon": "$(run)", "slot": "run", "concurrency": "restart", "steps": [{ "run": "\"${config:nuke.command}\" run ${config} ${projectName} -a ${arch}", "output": "run" }] },
					"test": { "label": "Test", "icon": "$(beaker)", "slot": "test", "steps": [{ "run": "\"${config:nuke.command}\" test ${config} ${projectName} -a ${arch}", "output": "test" }] },
					"profile": { "label": "Profile", "icon": "$(pulse)", "slot": "profile", "concurrency": "restart", "tooltip": "Build and run with the profiler connected (IED_PROFILER)", "steps": [{ "run": "\"${config:nuke.command}\" run ${config} ${projectName} -a ${arch}", "output": "run", "env": { "IED_PROFILER": "${profiler.connect}" } }] }
				},
				"toolbar": ["config", "arch", "|", "run", "build", "test"]
			}
		]
	}
}
