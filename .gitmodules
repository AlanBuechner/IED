	url = https://github.com/AlanBuechner/tracy.git
	shallow = true
[submodule "C4/Frost/Projects/Core/Modules/yaml/yaml-cpp"]
	path = C4/Frost/Projects/Core/Modules/yaml/yaml-cpp
	url = https://github.com/AlanBuechner/yaml-cpp.git
[submodule "third_party/codicons"]
	path = third_party/codicons
