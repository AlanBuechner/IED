// The dialogue plugin's server code (docs/26 section 2): the AI tool dialogue_speakers, which lists who speaks in a
// .dlg file - each line "[Name] text" - with how many lines each has, in order of first appearance.
include "api/plugin.ch"

namespace Dialogue
{
	class Speaker
	{
		public Core::String name;
		public int64 lines;
	}

	// The speaker of a line "[Name] ...", or empty.
	Core::StringView SpeakerOf(Core::StringView line)
	{
		if (line.IsEmpty() || line.ByteAt(0) != '[') return Core::StringView("");
		const int64 close = line.IndexOf(']', 1);
		return close > 1 ? line.Substring(1, close - 1).Trimmed() : Core::StringView("");
	}

	void Count(Core::Array<Speaker>& speakers, Core::StringView name)
	{
		for (Speaker& speaker : speakers)
			if (speaker.name.View() == name) {
				speaker.lines += 1;
				return;
			}
		Speaker first;
		first.name = Core::String(name);
		first.lines = 1;
		speakers.Push(first);
	}

	IED::ToolResult Speakers(const IED::ToolCall& call)
	{
		Core::String text;
		Core::String problem;
		if (!IED::ReadFile(call.workspace, call.args.Member("path").AsView(), text, problem)) return IED::ToolFailure(problem.View());
		Core::Array<Speaker> speakers;
		Core::StringView rest = text.View();
		while (!rest.IsEmpty()) {
			int64 end = rest.IndexOf('\n', 0);
			if (end < 0) end = rest.ByteLength();
			Core::StringView name = SpeakerOf(rest.Substring(0, end).Trimmed());
			if (!name.IsEmpty()) Count(speakers, name);
			rest = end < rest.ByteLength() ? rest.Substring(end + 1, rest.ByteLength() - end - 1) : Core::StringView("");
		}
		Core::StringBuilder out;
		for (const Speaker& speaker : speakers) {
			out.Append(speaker.name.View());
			out.Append(": ");
			out.AppendInt(speaker.lines);
			out.Append(speaker.lines == 1 ? " line\n" : " lines\n");
		}
		return IED::ToolText(speakers.IsEmpty() ? Core::StringView("no one speaks in it") : out.View());
	}

	void Activate(IED::PluginContext& context) {}
}
