# Text is stored with LF and checked out with the platform's line endings.
* text=auto

# Windows scripts keep CRLF (cmd mis-parses labels and goto in LF batch files); POSIX scripts keep LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
bin/nuke text eol=lf
# The e2e fixture's files are compared byte for byte after edits: LF in every checkout.
tests/e2e/fixture/** text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.zip binary
